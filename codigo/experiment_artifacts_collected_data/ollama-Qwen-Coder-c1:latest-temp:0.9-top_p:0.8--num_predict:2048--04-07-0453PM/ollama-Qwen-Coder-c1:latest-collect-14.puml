@startuml "AI-Powered Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Use Cases"

' ACTOR DEFINITION
actor "Individual Customer" as user
actor "Financial Advisor" as advisor

' PACKAGE DEFINITION
package "Authentication & Security" {
    usecase "UC01: Authenticate User" as UC01 <<include>>
    note right of UC01
      **Req. ID:** FR01, NFR06
      **Description:** Allows users to authenticate via 
      username/password or OAuth2 providers, with 
      optional multi-factor authentication.
    end note
    
    usecase "UC02: Manage Account Settings" as UC02 <<extend>>
}

package "Financial Data Management" {
    usecase "UC03: Connect Financial Accounts" as UC03
    note right of UC03
      **Req. ID:** FR02
      **Description:** Securely links external financial accounts 
      using banking APIs to retrieve transaction data.
    end note
    
    usecase "UC04: View Transactions" as UC04 <<include>>
    
    usecase "UC05: Categorize Transactions" as UC05 <<extend>>

    UC03 ..> UC04 : <<include>>
    UC04 ..> UC05 : <<extend>>
}

package "Analysis & Recommendations" {
    usecase "UC06: View Financial Dashboard" as UC06
    note right of UC06
      **Req. ID:** FR04, NFR12
      **Description:** Provides a visual representation 
      of spending patterns and historical financial data.
    end note
    
    usecase "UC07: Receive AI Insights" as UC07 <<include>>
    
    usecase "UC08: Generate Recommendations" as UC08

    UC06 ..> UC04 : <<include>>

    UC07 ..> UC08 : <<extend>>
}

package "Budgeting & Goal Management" {
    usecase "UC09: Set Financial Goals" as UC09
    note right of UC09
      **Req. ID:** FR07, NFR12
      **Description:** Enables users to create and track financial goals.
    end note
    
    usecase "UC10: Monitor Budgets" as UC10 <<include>>
    
    usecase "UC11: Adjust Goals & Budgets" as UC11

    UC09 ..> UC10 : <<include>>

    UC10 ..> UC11 : <<extend>>
}

package "Planning & Forecasting" {
    usecase "UC12: Create Financial Plans" as UC12
    note right of UC12
      **Req. ID:** FR14, NFR07
      **Description:** Allows users to create and manage financial plans 
      for future investments or debt repayment.
    end note
    
    usecase "UC13: Forecast Financial Positions" as UC13

    UC12 ..> UC13 : <<include>>
}

package "Investment & Portfolio Management" {
    usecase "UC14: View Investment Opportunities" as UC14
    note right of UC14
      **Req. ID:** FR11, NFR08
      **Description:** Provides personalized investment suggestions based 
      on user profiles and financial goals.
    end note
    
    usecase "UC15: Manage Portfolio Performance" as UC15

    UC14 ..> UC15 : <<include>>
}

package "Debt Management & Simulation" {
    usecase "UC16: View Debt Summary" as UC16
    note right of UC16
      **Req. ID:** FR12, NFR08
      **Description:** Displays a summary of user's debt and 
      provides repayment simulations.
    end note
    
    usecase "UC17: Repayment Strategies Simulation" as UC17

    UC16 ..> UC17 : <<include>>
}

package "Collaboration & Sharing" {
    usecase "UC18: Share Financial Data" as UC18
    note right of UC18
      **Req. ID:** FR09, NFR12
      **Description:** Allows users to share selected financial data 
      with financial advisors for personalized advice.
    end note
    
    usecase "UC19: Collaborate on Goals" as UC19

    UC18 ..> UC19 : <<include>>
}

package "Notifications & Alerts" {
    usecase "UC20: Set Up Notifications" as UC20
    note right of UC20
      **Req. ID:** FR13, NFR14
      **Description:** Enables users to set up notifications for 
      unusual spending patterns or important financial events.
    end note
    
    usecase "UC21: Receive Alerts" as UC21

    UC20 ..> UC21 : <<include>>
}

package "Reports & Analytics" {
    usecase "UC22: Generate Financial Reports" as UC22
    note right of UC22
      **Req. ID:** FR15, NFR14
      **Description:** Creates periodic financial health reports 
      for users and advisors.
    end note
    
    usecase "UC23: View Advanced Analytics" as UC23

    UC22 ..> UC06 : <<include>>

    UC23 ..> UC22 : <<extend>>
}

package "Crypto Portfolio Tracking & Analysis" {
    usecase "UC24: Connect Crypto Accounts" as UC24
    note right of UC24
      **Req. ID:** FR17, NFR08
      **Description:** Securely links external cryptocurrency accounts 
      and tracks portfolio performance.
    end note
    
    usecase "UC25: View Crypto Portfolio Analysis" as UC25

    UC24 ..> UC25 : <<include>>
}

package "Offline Mode & Compatibility" {
    usecase "UC26: Use Offline Features" as UC26
    note right of UC26
      **Req. ID:** FR18, NFR09
      **Description:** Provides limited functionality 
      when users are offline.
    end note
    
    usecase "UC27: Support Multiple Browsers & Devices" as UC27

    UC26 ..> UC27 : <<include>>
}

' CROSS-PACKAGE RELATIONSHIPS
user --> UC01
user --> UC03
user --> UC04
user --> UC05
user --> UC09
user --> UC10
user --> UC12
user --> UC16
user --> UC18
user --> UC20

advisor --> UC07
advisor --> UC08
advisor --> UC13
advisor --> UC14
advisor --> UC15
advisor --> UC19
advisor --> UC21

bank --> UC03

invest --> UC14

ai --> UC07
ai --> UC08

@enduml