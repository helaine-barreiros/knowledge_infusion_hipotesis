@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Enhanced Personal Financial Management System - Use Cases"
left to right direction

' Define actors
actor "Individual Customer" as user
actor "Financial Advisor" as advisor
actor "Banking System" as bank #999999
actor "Investment System" as investment #999999

' Authentication package
package "Authentication and Security" {
    usecase "UC01: Authenticate User" as UC01
    note right of UC01
        **Req. ID:** FR01, NFR06  
        Allows users to authenticate via username/password 
        or OAuth2 providers with optional multi-factor 
        authentication.
    end note
    
    usecase "UC02: Manage Security Settings" as UC02
}

' Financial Account Management package
package "Financial Account Management" {
    usecase "UC03: Connect Financial Accounts" as UC03
    note right of UC03
        **Req. ID:** FR02  
        Securely links external financial accounts using 
        banking APIs to retrieve transaction data.
    end note
    
    usecase "UC04: View Transactions" as UC04
    usecase "UC05: Categorize Transactions" as UC05
    
    ' Relationships
    UC03 ..> UC04 : <<include>>
    UC04 <.. UC05 : <<extend>>
}

' Analysis and Insights package
package "Analysis and Insights" {
    usecase "UC06: View Financial Dashboard" as UC06
    note right of UC06  
        **Req. ID:** FR03, FR04  
        Displays spending patterns and financial history.
    end note
    
    usecase "UC07: Receive AI-Powered Insights" as UC07
    note right of UC07 
        **Req. ID:** FR05, FR06  
        Receives AI-generated insights and recommendations.
    end note
    
    usecase "UC08: View Basic Reports" as UC08
    usecase "UC09: Perform Advanced Analysis" as UC09
    
    ' Relationships
    UC09 --|> UC08
    UC06 ..> UC07 : <<include>>
}

' Goal Setting and Budgeting package
package "Goal Setting and Budgeting" {
    usecase "UC10: Set Financial Goals" as UC10
    note right of UC10  
        **Req. ID:** FR07  
        Allows users to set financial goals.
    end note
    
    usecase "UC11: Track Goal Progress" as UC11
    usecase "UC12: Create Budgets" as UC12
    note right of UC12
        **Req. ID:** FR08
        Create and manage budgets to control spending.
    end note
    
    usecase "UC13: Monitor Budget Performance" as UC13
    
    ' Relationships
    UC10 ..> UC11 : <<include>>
    UC12 ..> UC13 : <<include>>
}

' Alerts and Notifications package
package "Alerts and Notifications" {
    usecase "UC14: Configure Alerts" as UC14
    note right of UC14
        **Req. ID:** FR09
        Set up alerts for unusual spending patterns.
    end note
    
    usecase "UC15: Receive Financial News" as UC15
    note right of UC15  
        Receives relevant financial news and updates.
    end note
    
    usecase "UC16: Get Spending Pattern Alerts" as UC16
}

' Investment and Planning package
package "Investment and Planning" {
    usecase "UC17: Explore Investment Opportunities" as UC17
    note right of UC17  
        **Req. ID:** FR11  
        Provides personalized investment suggestions.
    end note
    
    usecase "UC18: Simulate Investment Portfolios" as UC18
    usecase "UC19: Forecast Financial Position" as UC19
    note right of UC19
        **Req. ID:** FR10
        Predicts future financial position based on 
        historical data and current behavior.
    end note
    
    usecase "UC20: Manage Debt Repayment Strategies" as UC20
    note right of UC20
        **Req. ID:** FR12
        Creates and simulates debt repayment strategies.
    end note
    
    usecase "UC21: Track Cryptocurrency Portfolio" as UC21
    note right of UC21
        **Req. ID:** FR16
        Track and analyze cryptocurrency investments.
    end note
}

' User Collaboration package
package "User Collaboration" {
    usecase "UC22: Share Data with Advisor" as UC22
    note right of UC22  
        **Req. ID:** FR13  
        Facilitates secure data sharing between users and advisors.
    end note
    
    usecase "UC23: Receive Professional Advice" as UC23
    usecase "UC24: Access Chatbot for Financial Queries" as UC24
    note right of UC24
        **Req. ID:** FR14
        Interact with AI chatbot for financial questions.
    end note
}

' Reports package
package "Reports and Documentation" {
    usecase "UC25: Generate Financial Health Reports" as UC25
    note right of UC25
        **Req. ID:** FR15
        Creates periodic reports on financial health.
    end note
    
    usecase "UC26: Export Financial Data" as UC26
    usecase "UC27: Customize Report Dashboard" as UC27
    note right of UC27
        **Req. ID:** NFR12
        Allows customization of dashboards and reports.
    end note
}

' Actor relationships
user --> UC01
user --> UC02
user --> UC03
user --> UC04
user --> UC05
user --> UC06
user --> UC10
user --> UC11
user --> UC12
user --> UC14
user --> UC17
user --> UC19
user --> UC20
user --> UC21
user --> UC22
user --> UC24
user --> UC25
user --> UC26
user --> UC27

advisor --> UC01
advisor --> UC23
advisor --> UC22
advisor --> UC09
advisor --> UC25

bank --> UC03
investment --> UC17
investment --> UC18
investment --> UC21

' Cross-package relationships
UC06 ..> UC04 : <<include>>
UC22 ..> UC23 : <<include>>
UC14 <.. UC16 : <<extend>>
UC25 ..> UC08 : <<include>>

@enduml