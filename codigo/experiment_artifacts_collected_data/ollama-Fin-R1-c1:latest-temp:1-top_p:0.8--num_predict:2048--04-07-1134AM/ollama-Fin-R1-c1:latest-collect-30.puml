@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Core Use Cases"

actor IndividualCustomer as user
actor FinancialAdvisor as advisor
actor BankingAPI, InvestmentAPI, CreditService, NewsService, AuthService, AIEngine

package Authentication {
    usecase UC01: User Authenticates via Username/Password as uc1
        note right of uc1
            **Req. ID:** FR01  
            **Description:** Enables users to log in using their username and password or OAuth2 providers with optional multi-factor authentication.
        end note
        
    usecase UC02: Manage Account Settings as uc2
}

package FinancialManagement {
    usecase UC03: Connect Bank Accounts via Banking APIs as uc3 
        note right of uc3  
            **Req. ID:** FR02  
            **Description:** Securely links external bank accounts to aggregate transaction data.
        end note
        
    usecase UC04: View Transactions (with categorization) as uc4
        extend uc5 : <<extend>>  // Categorize transactions

    usecase UC05: Create Budgets and Track Progress as uc5  
}

package Analysis {
    usecase UC06: Generate Financial Dashboards as uc6 
    usecase UC07: Receive AI-Driven Insights on Spending Habits as uc7
    
    generalize uc8: View Basic Reports
        specializations:
            - advancedAnalysisUC9 : Advanced Analytics
                <<extend>> from uc8

}

package Planning {
    usecase UC10: Set Financial Goals as uc10  
    usecase UC11: Forecast Future Finances based on Historical Data as uc11 
}
    
package Recommendations {
    usecase UC12: Personalized Investment Suggestions via AI Engine as uc12
        <<extend>> from uc7

    usecase UC13: Debt Management Strategies with Repayment Simulations as uc13  
}

package Collaboration {
    usecase UC14: Share Financial Data with Advisors as uc14 
}
    
' Relationships between packages and actors
user --> UC01 : Authenticate via username/password or OAuth2 providers.
advisor --> advancedAnalysisUC9 : Accesses detailed financial analysis for advisors.

' Include/Extend relationships within packages
uc3 ..> uc5 : <<include>>
uc6 includes uc7  
advancedAnalysisUC9 extends uc8  

@enduml