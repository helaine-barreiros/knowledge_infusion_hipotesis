@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System Use Case Diagram"

actor IndividualCustomer as user #08427B
actor FinancialAdvisor as advisor #08427B
actor BankingSystem as bank #999999
actor InvestmentSystem as invest #999999

package "Authentication & Security" {
    usecase UC1: AuthenticateUser as uc1
        note right of uc1
            **Req. ID:** FR01, NFR06  
            Allows users to authenticate via username/password or OAuth2 providers with optional multi-factor authentication.
        end note
}

package "Account Management & Transactions" {
    usecase UC3: ConnectFinancialAccounts as uc3
        note right of uc3
            **Req. ID:** FR02  
            Securely links external financial accounts using banking APIs to retrieve transaction data.
        end note
    
    usecase UC4: ViewTransactions as uc4
    usecase UC5: CategorizeTransactions as uc5

    uc3 ..> uc4 : <<include>>  -- Transaction data retrieval always includes viewing transactions.

    uc4 ..> uc5 : <<extend>>   -- Viewing categorized transactions is optional based on user preference.
}

package "Financial Analysis & Insights" {
    usecase UC6: ViewFinancialDashboard as uc6
    usecase UC7: ReceiveAISuggestions as uc7

    note right of uc7
        **Req. ID:** FR05, FR14  
        AI provides personalized insights and recommendations.
    end note
    
    usecase UC8: ViewBasicReports as uc8
    usecase UC9: ViewAdvancedAnalytics as uc9  

    uc9 --|> uc8  -- Advanced analytics are a specialized form of basic reports.

    uc6 ..> uc4 : <<include>>  
}

package "Goal Setting & Budgeting" {
    usecase UC10: SetFinancialGoals as uc10
    usecase UC11: TrackProgress as uc11

    note right of uc10
        **Req. ID:** FR07, NFR03  
        Allows users to set and track goals with notifications for progress.
    end note
    
}

package "Recommendations & Planning" {
    usecase UC12: GenerateFinancialPlans as uc12
    usecase UC13: ForecastFuturePositions as uc13

    note right of uc13
        **Req. ID:** FR04, NFR05  
        AI forecasts future financial positions based on historical data.
    end note
    
}

package "Collaboration & Sharing" {
    usecase UC14: ShareDataWithAdvisor as uc14  

    note right of uc14
        **Req. ID:** FR13  
        Users can share selected data with advisors for joint planning.
    end note

}

' Cross-package relationships:
uc6 ..> uc4 : <<include>>  -- Financial dashboard includes transaction details.

user --> UC1, UC3, UC6   -- Individual customer uses authentication, account management, and analysis features.

advisor --> UC9         -- Advisors use advanced financial analytics for recommendations.
bank --> UC3             -- Banking system provides accounts to connect.
invest --> UC7           -- Investment data used in AI suggestions.
ai --> UC7               -- AI engine powers the insights provided by UC7.

@enduml