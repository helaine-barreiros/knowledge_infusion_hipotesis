@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Use Case Diagram"

actor IndividualCustomer as user [users]
actor FinancialAdvisor as advisor [user_tie]

package Authentication {
    usecase UC01: Authenticate User 
        note right of UC01
            **Req. ID:** FR01, NFR06  
            **Description:** Allows users to authenticate via username/password or OAuth2 providers with optional multi-factor authentication.
        end note
}

package FinancialAccountManagement {
    usecase UC03: ConnectFinancialAccounts 
        note right of UC03
            **Req. ID:** FR02  
            **Description:** Securely links external financial accounts using banking APIs to retrieve transaction data.
        end note
    
    usecase UC04: ViewTransactions : <<include>> from UC03  
    usecase UC05: CategorizeTransactions : <<extend>> from UC04  

    uc UC06: GenerateBudget
        note right of UC06
            **Req. ID:** FR12, FR8  
            **Description:** Helps users set and track financial goals.
        end note
    
}

package AnalysisAndRecommendations {
    usecase UC07: ReceiveAIInsights : <<include>> from UC04  
    usecase UC08: ViewFinancialDashboard 
        note right of UC08
            **Req. ID:** FR3, FR5  
            **Description:** Visualizes spending patterns and provides AI-driven financial insights.
        end note
    
}

package Collaboration {
    usecase UC10: ShareDataWithAdvisor : <<extend>> from UC06
        note right of UC10
            **Req. ID:** FR13  
            **Description:** Enables users to share selected data with their advisors for collaborative planning.
        end note
}

' Relationship between packages and actors
user --> UC01 [req]
advisor --> UC07 [opt]
UC06 --> advisor [opt]

@enduml