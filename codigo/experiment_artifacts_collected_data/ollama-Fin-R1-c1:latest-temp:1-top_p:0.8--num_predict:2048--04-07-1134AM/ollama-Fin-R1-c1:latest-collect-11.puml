@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Core Functionalities"

actor IndividualCustomer as user [#08427B]
actor FinancialAdvisor as advisor [#08427B]

package Authentication {
    usecase UC01: Authenticate User
        note right of UC01
            **Req. ID:** FR01, NFR06  
            **Description:** Allows users to authenticate via username/password or OAuth2 providers with optional multi-factor authentication.
        end note
}

package FinancialAccountManagement {
    usecase UC03: Connect Financial Accounts as <<include>>
    usecase UC04: View Transactions [as <<extend>>]
    usecase UC05: Categorize Transactions

    UC03 --> UC04 : <<include>>

    user --> UC03
}

package AnalysisAndInsights {
    usecase UC06: View Financial Dashboard 
    usecase UC07: Receive AI Insights [as <<extend>>]
    
    note right of UC07
        **Req. ID:** FR05, FR14  
        **Description:** Provides personalized financial insights and recommendations using AI.
    end note

    user --> UC06
}

package Planning {
    usecase UC08: Set Financial Goals 
    usecase UC09: Track Progress [as <<extend>>]
    
    UC08 --> UC09 : <<include>>
    advisor --> UC09
}

package Collaboration {
    usecase UC10: Share Data with Advisor  
        note right of UC10
            **Req. ID:** FR13, NFR06  
            **Description:** Enables users to share selected financial data securely.
        end note
}
    
user --> UC10

advisor --> UC09 

bank --> UC04 [as <<extend>>]
invest_api --> UC07 as <<include>>

' Cross-package relationships
UC08 ..> UC06 : <<extend>>
UC03 ..> UC05 : <<extend>>
UC07 ..> UC12 : <<extend>>

'ai_engine' --> 'UC07' [as <<use>>]
ai_engine --> 'UC09'

endpackage

@enduml