@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Use Case Diagram"

actor IndividualCustomer as user [#08427B]
actor FinancialAdvisor as advisor [#08427B]

package Authentication {
    usecase UC01: Authenticate User as uc01
        note right of uc01
            **Req. ID:** FR01, NFR06  
            **Description:** Allows users to authenticate via username/password or OAuth2 providers with optional multi-factor authentication.
        end note
}

package FinancialAccountManagement {
    usecase UC03: Connect Financial Accounts as uc03
        note right of uc03
            **Req. ID:** FR02  
            **Description:** Securely links external financial accounts using banking APIs to retrieve transaction data.
        end note

    usecase UC04: View Transactions as uc04 
    usecase UC05: Categorize Transactions as uc05

    uc03 --> uc04 : <<include>>  
    uc04 ..> uc05 : <<extend>>
}

package AnalysisAndInsights {
    usecase UC06: View Financial Dashboard as uc06
    usecase UC07: Receive AI Insights as uc07

    note right of uc07
        **Req. ID:** FR03, FR04  
        **Description:** Provides visualizations and spending patterns analysis based on aggregated transactions.
    end note  

    uc06 --> uc05 : <<include>>
}

package Planning {
    usecase UC10: Set Financial Goals as uc10
    usecase UC11: Track Progress Towards Goals as uc11

    note right of uc11  
        **Req. ID:** FR07, FR08  
        **Description:** Allows users to create and monitor goals with periodic updates.
    end note  

    uc10 --> uc11 : <<extend>>
}

package Recommendations {
    usecase UC12: Generate Personalized Recommendations as uc12
    usecase UC13: Forecast Financial Positions as uc13

    note right of uc13  
        **Req. ID:** FR06, FR10  
        **Description:** Provides financial recommendations and forecasts using AI.
    end note  

    uc12 ..> uc13 : <<include>>
}

package Collaboration {
    usecase UC14: Share Data with Advisors as uc14
    usecase UC15: Chatbot for Financial Queries as uc15

    note right of uc15  
        **Req. ID:** FR09, FR12, FR13, NFR10  
        **Description:** Offers real-time financial advice and data sharing via chatbot.
    end note  

    user --> uc14 : <<extend>>
}

package AIComponents {
    usecase UC16: Leverage AI Engine for Analysis as uc16
    usecase UC17: Explain Recommendations as uc17

    note right of uc17  
        **Req. ID:** NFR09, FR05  
        **Description:** Ensures the reasoning behind recommendations is transparent and explainable.
    end note  

    uc16 --> ai_engine : <<include>>
}

package ExternalServices {
    usecase UC20: Access Banking APIs as uc20
    usecase UC21: Fetch Investment Data as uc21

    note right of uc21  
        **Req. ID:** FR03, FR04, FR05, FR11  
        **Description:** Retrieves market data and investment portfolio information for analysis.
    end note  

    pfm_system --> banking_api : <<include>>
    pfm_system --> ai_engine : <<extend>>

    bank -- UC20 : <<extend>> 
}

package SystemManagement {
    usecase UC23: Manage User Accounts as uc23
    usecase UC24: Monitor System Performance as uc24

    note right of uc24  
        **Req. ID:** NFR01, NFR02, NFR03, NFR07, NFR08, NFR10, NFR11  
        **Description:** Ensures compliance with financial regulations and maintains system security.
    end note  

    pfm_system --> auth_service : <<include>>
}

' ACTOR-USE CASE RELATIONSHIPS
user --> uc01 
advisor --> uc23 

' CROSS-PACKAGE RELATIONSHIPS

uc04 --> UC21 : <<extend>>  
UC21 --> ai_engine : <<include>>

uc06 --> UC05 : <<extend>>
uc10 --> UC11 : <<extend>>
uc12 --> UC13 : <<extend>>
uc14 --> UC04 : <<extend>>
uc17 --> uc12 : <<extend>>

@enduml