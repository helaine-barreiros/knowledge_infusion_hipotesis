@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Enhanced Personal Finance Management System: Use Case Diagram"

actor IndividualCustomer as user [#08427B]
actor FinancialAdvisor as advisor [#08427B]

package AuthenticationAndSecurity {
    usecase UC01_AuthenticateUser as uc_auth
        note right of uc_auth
            **Req. ID:** FR01, NFR06  
            **Description:** Allow user to authenticate via username/password or OAuth2 providers with optional multi-factor authentication.
        end note

    usecase UC02_ManageAccountSettings as uc_settings
}

package FinancialAccountManagement {
    usecase UC03_ConnectAccounts as uc_connect [#lightblue]
        note right of uc_connect
            **Req. ID:** FR02  
            **Description:** Securely link external financial accounts using banking APIs to retrieve transaction data.
        end note

    usecase UC04_ViewTransactions [view_transactions] 
    usecase UC05_CategorizeTransactions as uc_cat [#lightblue]
    
    UC03_ConnectAccounts --> UC04_ViewTransactions : <<include>>
    UC04_ViewTransactions --> UC05_CategorizeTransactions : <<extend>>

}

package AnalysisAndRecommendations {
    usecase UC06_ViewDashboard [view_dashboard] 
    usecase UC07_ReceiveAIBasedInsights as uc_ai_insight
        note right of uc_ai_insight
            **Req. ID:** FR05, FR14  
            **Description:** Provide AI-powered insights on spending habits and generate personalized recommendations.
        end note

    usecase UC08_ViewBasicReports [view_basic_reports] 
    usecase UC09_ViewAdvancedAnalytics as uc_adv [#lightgreen]
        UC09_ViewAdvancedAnalytics --|> UC08_ViewBasicReports
}

package FinancialGoalSetting {
    usecase UC10_SetFinancialGoals as uc_goals
    usecase UC11_MonitorBudgets [monitor_budget] 
}

package CollaborationAndSharing {
    usecase UC12_ShareDataWithAdvisors as uc_share [#lightblue]
        note right of uc_share
            **Req. ID:** FR13  
            **Description:** Allow users to share selected financial data with advisors.
        end note

    usecase UC13_UseChatbotForQueries [use_chatbot] 
}

package PredictionAndForecasting {
    usecase UC14_ForecastFuturePositions as uc_forecast
    usecase UC15_SuggestInvestmentsBasedOnProfile as uc_inv [#lightgreen]
        note right of uc_inv
            **Req. ID:** FR08, FR12  
            **Description:** Suggest investment opportunities tailored to user profile.
        end note

}

package DebtManagement {
    usecase UC16_ManageDebt [manage_debt] 
    usecase UC17_RepaymentSimulations as uc_sim [#lightblue]
}

' Relationships
user --> uc_auth : Log in/Sign up  
user --> uc_connect : Add accounts  
advisor --> uc_ai_insight : Review recommendations  

uc_connect --> view_transactions : View transaction details  
view_transactions --> uc_cat : Categorize transactions  

UC06_ViewDashboard --> UC04_ViewTransactions : Include recent activity  

FinancialAdvisor -> uc_share : Approve or reject shared data  

uc_inv --> investment_api : Fetch market data for suggestions  

user --|> uc_forecast : Plan future spending/earnings  

UC17_RepaymentSimulations --> ai_engine : Leverage AI models  

UC08_ViewBasicReports -|-- UC06_ViewDashboard  
' Include relationships across packages

@enduml