@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Use Case Diagram"

actor IndividualCustomer as user [#08427B]
actor Advisor as advisor [#08427B]

package Authentication & Security {
    usecase UC1: Authenticate User
        note right of UC1
            **Req. ID:** FR01, NFR06  
            **Description:** Allows users to authenticate via username/password or OAuth2 providers with optional multi-factor authentication.
        end note
}

package Financial Account Management {
    usecase UC3: Connect Financial Accounts as <<include>> in UC2: Manage Financial Accounts
        note right of UC3
            **Req. ID:** FR02  
            **Description:** Securely links external financial accounts using banking APIs to retrieve transaction data.
        end note
        
    usecase UC4: View Transactions :<<extend>> from UC3
    usecase UC5: Categorize Transactions as <<extend>> of UC4
    
    UC3 ..> UC4 : <<include>>
}

package Analysis & Insights {
    usecase UC6: View Financial Dashboard 
        note right of UC6  
            **Req. ID:** FR04, NFR12  
            **Description:** Visualizes spending patterns and financial history.
        end note
        
    usecase UC7: Receive AI Insights :<<extend>> from UC8: Basic Analysis
        note right of UC7 
            **Req. ID:** FR05, FR06  
            **Description:** Provides personalized financial recommendations using advanced analysis techniques.
        end note

    usecase UC9: Advanced Financial Recommendations as <<specialize>> of UC8
}

package Planning & Goal Setting {
    usecase UC10: Set Financial Goals 
        note right of UC10 
            **Req. ID:** FR07  
            **Description:** Allows users to define and track financial objectives.
        end note
        
    usecase UC12: Track Progress as <<extend>> from UC10
}

package Budgeting & Alerts {
    usecase UC13: Create Personalized Budgets 
        note right of UC13 
            **Req. ID:** FR08  
            **Description:** Enables users to create and monitor their budgets.
        end note
        
    usecase UC14: Receive Spending Alerts as <<extend>> from UC13
}

package Investment & Portfolio {
    usecase UC15: Analyze Investments :<<include>> in UC20: Financial Recommendations
        note right of UC15 
            **Req. ID:** FR11  
            **Description:** Suggests investment opportunities based on user profile.
        end note
        
    usecase UC16: Monitor Portfolio Performance as <<extend>> from UC15
    
}

package AI & Reasoning {
    usecase UC8: Basic Analysis
        note right of UC8 
            **Req. ID:** NFR09  
            **Description:** Provides foundational analysis for personalized recommendations.
        end note
        
    usecase UC20: Financial Recommendations as <<generalize>> of UC15, UC7 :<<extend>>
}

package Collaboration & Sharing {
    usecase UC11: Share Data with Advisor 
        note right of UC11  
            **Req. ID:** FR13  
            **Description:** Allows users to share selected financial data securely.
        end note
}

actor BankingSystem as bank [#94B5CD]
actor InvestmentSystem as invest [#A8DADC]
actor AIEngine as ai #007ACC

user --> UC1: Authenticate User :<<extend>>
user --> UC3: Connect Financial Accounts 
advisor --> UC9: Advanced Financial Recommendations  
bank --> UC3: Connect Financial Accounts
ai --> UC20: Financial Recommendations  

@enduml