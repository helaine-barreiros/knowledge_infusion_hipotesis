@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Enhanced Personal Finance Management System - Use Case Diagram"

actor IndividualCustomer as user, #08427B  
actor Advisor as advisor, #08427B  

package "Authentication & Security" {  
    usecase UC01: Authenticate User as uc01  
    note right of uc01  
      **Req. ID:** FR01, NFR06  
      **Description:** Allows users to authenticate via username/password or OAuth2 providers with optional multi-factor authentication.  
    end note  

    usecase UC02: Manage Account Settings as uc02  
}

package "Financial Management" {  
    usecase UC03: Connect Financial Accounts as uc03  
        note right of uc03  
          **Req. ID:** FR02  
          **Description:** Securely links external financial accounts using banking APIs to retrieve transaction data.  
        end note  

    usecase UC04: View Transactions as uc04  
    usecase UC05: Categorize Transactions as uc05  

    uc03 ..> uc04 : <<include>>  -- Base case always includes viewing transactions after connecting accounts.  

    uc04 ..> uc05 : <<extend>>   -- Optional categorization step.  

}

package "Analysis & Recommendations" {  
    usecase UC06: View Financial Dashboard as uc06  
        note right of uc06  
          **Req. ID:** FR03, FR04  
          **Description:** Visualizes spending patterns and financial history for the user.  
        end note  

    usecase UC07: Receive AI Insights as uc07  
        note right of uc07  
          **Req. ID:** FR05  
          **Description:** Provides personalized AI-powered insights on spending habits based on aggregated data.  
        end note  

    usecase UC08: Generate Personalized Recommendations as uc08  
        note right of uc08  
          **Req. ID:** FR06, NFR12  
          **Description:** Generates actionable financial recommendations using AI and historical transactional insights.  
        end note  

}

package "Goal Setting & Monitoring" {  
    usecase UC09: Set Financial Goals as uc09  
        note right of uc09  
          **Req. ID:** FR07, NFR13  
          **Description:** Allows users to establish and track specific financial goals over time.  
        end note  

    usecase UC10: Monitor Progress Towards Goals as uc10  
}

package "Collaboration & Sharing" {  
    usecase UC11: Share Financial Data with Advisor as uc11  
        note right of uc11  
          **Req. ID:** FR13, NFR06  
          **Description:** Enables users to share selected financial data and insights securely with their advisors for joint review.  
        end note  

}

package "Notification & Alerts" {  
    usecase UC12: Receive Financial Alerts as uc12  
        note right of uc12  
          **Req. ID:** FR09, NFR14  
          **Description:** Sends real-time notifications about financial anomalies or missed targets to keep the user informed.  
        end note  

}

package "AI & Reasoning" {  
    usecase UC13: Leverage AI for Advanced Analysis as uc13  
        note right of uc13  
          **Req. ID:** FR05, FR06  
          **Description:** Utilizes the AI engine to perform complex financial analysis and generate recommendations.  
        end note  

}

package "Data & Service Integration" {  
    usecase UC14: Integrate Banking APIs as uc14  
        note right of uc14  
          **Req. ID:** FR02, NFR06  
          **Description:** Connects to external banking systems for secure data retrieval and transactional updates.  
        end note  

}

package "Forecasting & Projections" {  
    usecase UC15: Predict Future Financial Position as uc15  
        note right of uc15  
          **Req. ID:** FR10, NFR12  
          **Description:** Estimates future financial outcomes based on historical data and current trends.  
        end note  

}

package "Investment Recommendations" {  
    usecase UC16: Suggest Investment Opportunities as uc16  
        note right of uc16  
          **Req. ID:** FR11, NFR05  
          **Description:** Recommends investment products tailored to the user's risk profile and financial goals.  
        end note  

}

package "Debt Management" {  
    usecase UC17: Manage Debt with Repayment Plans as uc17  
        note right of uc17  
          **Req. ID:** FR12, NFR05  
          **Description:** Assists users in creating and tracking debt repayment strategies, including simulation tools for different scenarios.  
        end note  

}

package "Report Generation" {  
    usecase UC18: Create Periodic Financial Health Reports as uc18  
        note right of uc18  
          **Req. ID:** FR15, NFR06  
          **Description:** Generates comprehensive reports summarizing financial performance and trends for review by the user or advisor.  
        end note  

}

package "User Interface" {  
    usecase UC19: Use Mobile App as uc19  
        note right of uc19  
          **Req. ID:** NFR05, NFR08  
          **Description:** Allows access to system features via a mobile application compatible with major platforms (iOS/Android).  
        end note  

}

package "Multi-Channel Access" {  
    usecase UC20: Use Web Interface as uc20  
        note right of uc20  
          **Req. ID:** NFR05, NFR14  
          **Description:** Provides a web-based interface for users to manage their finances online without requiring a mobile app.  
        end note  

}

package "Customer Support" {  
    usecase UC21: Engage with Chatbot as uc21  
        note right of uc21  
          **Req. ID:** FR14, NFR06  
          **Description:** Interacts through an AI-driven chatbot for answering financial questions and providing support during onboarding or troubleshooting.  
        end note  

}

package "System Maintenance" {  
    usecase UC22: Perform System Updates as uc22  
        note right of uc22  
          **Req. ID:** NFR03, NFR14  
          **Description:** Ensures the system remains up-to-date with security patches and performance optimizations to maintain stability.  
        end note  

}

' Cross-package relationships
uc06 ..> uc04 : <<include>>  -- Financial Dashboard includes transaction views.

user --> UC01  
user --> UC03  
advisor --> UC09, UC21  
bank --> UC03  
ai --> UC07, UC08  

@enduml