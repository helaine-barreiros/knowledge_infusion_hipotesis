@startuml "C4_UC"

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title "Sistema de Gestão Financeira Pessoal - Casos de Uso"

' Atores
actor "Cliente Individual" as user
actor "Sistema Bancário" as bank #999999
actor "Consultor Financeiro" as advisor #6666FF

' Sistema e casos de uso
rectangle "Sistema de Gestão Financeira Pessoal" {
    usecase "UC01: Visualizar Dados Financeiros" as UC01
    usecase "UC02: Gerenciar Contas" as UC02
    usecase "UC03: Monitorar Transações" as UC03
    usecase "UC04: Estabelecer Orçamento" as UC04
    usecase "UC05: Receber Recomendações Financeiras" as UC05
    
    ' Relacionamentos entre casos de uso
    UC01 ..> UC02 : <<include>>
    UC02 ..> UC03 : <<include>>
    UC01 ..> UC04 : <<include>>
    UC01 ..> UC05 : <<include>>
    
    usecase "UC06: Categorizar Transação" as UC06
    UC06 ..> UC03 : <<extend>>
    usecase "UC07: Exportar Dados Financeiros" as UC07
    UC07 ..> UC01 : <<extend>>
    
    ' Casos de uso exclusivos para o consultor financeiro
    usecase "UC08: Avaliar Portfolio" as UC08
    usecase "UC09: Gerenciar Custos" as UC09
    
    note right of UC08
      **Req. ID:** FR13
      **Descrição:** Permite ao consultor financeiro analisar o 
      portfolio do cliente e identificar oportunidades de 
      otimização.
    end note
    
    note right of UC09
      **Req. ID:** FR02, FR05
      **Descrição:** Permite ao consultor financeiro gerenciar os 
      custos associados às contas do cliente, garantindo a eficiência 
      e reduzindo despesas inúteis.
    end note
    
    UC01 ..> UC08 : <<extend>>
    UC02 ..> UC09 : <<include>>
}

' Relacionamentos ator-caso de uso
user --> UC01
user --> UC04
bank --> UC03
advisor --> UC05
advisor --> UC08

@enduml