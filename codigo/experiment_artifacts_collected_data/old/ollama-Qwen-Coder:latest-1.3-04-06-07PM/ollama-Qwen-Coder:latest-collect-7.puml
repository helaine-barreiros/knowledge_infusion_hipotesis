@startuml "C4_UC_System"

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title "Sistema de Gestão Financeira Pessoal - Casos de Uso"

' Atores
actor "Cliente Individual" as user
actor "Sistema Bancário" as bank #999999
actor "Sistema de Notificações" as notifications #999999
actor "Sistema de Relatórios" as reports #999999
actor "Sistema de Categorização" as categorization #999999

' Sistema e casos de uso
rectangle "Sistema de Gestão Financeira Pessoal" {
    usecase "UC01: Visualizar Transações Financeiras" as UC01
    usecase "UC02: Filtrar Transações Financeiras" as UC02
    usecase "UC03: Categorizar Transação Financeira" as UC03
    usecase "UC04: Buscar Transação Financeira" as UC04
    usecase "UC05: Visualizar Detalhes da Transação Financeira" as UC05
    usecase "UC06: Exportar Transações Financeiras" as UC06
    usecase "UC07: Receber Notificação de Transação" as UC07
    usecase "UC08: Gerar Relatório Financeiro" as UC08
    usecase "UC09: Visualizar Categorização Automática" as UC09
    
    note right of UC01
      **Req. ID:** FR03, FR04
      **Descrição:** Permite ao usuário visualizar todas as transações 
      financeiras de suas contas conectadas, ordenadas 
      cronologicamente.
    end note
    
    note right of UC02
      **Req. ID:** FR03, FR04
      **Descrição:** Permite ao usuário filtrar transações financeiras 
      por data, categoria, valor ou tipo de transação.
    end note
    
    note right of UC03
      **Req. ID:** FR05, FR07
      **Descrição:** Permite ao usuário categorizar manualmente transações 
      financeiras ou receber categorização automática.
    end note
    
    note right of UC04
      **Req. ID:** FR04
      **Descrição:** Permite ao usuário buscar transações financeiras 
      por descrição, categoria ou valor.
    end note
    
    note right of UC05
      **Req. ID:** FR04
      **Descrição:** Permite ao usuário visualizar detalhes de uma 
      transação financeira, incluindo data, valor, categoria, tipo e 
      descrição.
    end note
    
    note right of UC06
      **Req. ID:** FR06
      **Descrição:** Permite ao usuário exportar transações financeiras 
      em formato CSV ou Excel para análise adicional.
    end note
    
    note right of UC07
      **Req. ID:** FR08
      **Descrição:** Permite ao usuário receber notificações sobre novas 
      transações financeiras, através de email ou SMS.
    end note
    
    note right of UC08
      **Req. ID:** FR15
      **Descrição:** Permite ao usuário gerar relatórios financeiros 
      personalizados com informações como renda total, gastos por categoria, 
      investimentos e outras métricas relevantes.
    end note
    
    note right of UC09
      **Req. ID:** FR07
      **Descrição:** Permite ao usuário visualizar categorização automática 
      de transações financeiras para melhorar a organização e análise 
      financeira.
    end note
    
    ' Relacionamentos entre casos de uso
    UC01 ..> UC02 : <<include>>
    UC01 ..> UC03 : <<include>>
    UC01 ..> UC07 : <<include>>
    UC01 ..> UC05 : <<extend>>
    UC01 ..> UC06 : <<extend>>
    UC03 ..> UC05 : <<include>>
    UC08 ..> UC09 : <<include>>
}

' Relacionamentos ator-caso de uso
user --> UC01
user --> UC03
user --> UC04
user --> UC07
user --> UC08
bank --> UC07

@enduml