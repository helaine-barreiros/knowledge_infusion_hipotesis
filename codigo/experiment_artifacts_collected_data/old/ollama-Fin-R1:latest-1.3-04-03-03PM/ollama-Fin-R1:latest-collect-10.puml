@startuml "C4_UC_MainSystem"

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title "Sistema de Gestão Financeira Pessoal - Casos de Uso"

' Atores
actor "Cliente Individual" as user
actor "Assistente Bancário (Financeiro)" as banker #2e8b57
actor "Conselheiro Financeiro" as financial_advisor #ffd700

' Sistema e casos de uso principal
rectangle "Sistema de Gestão Financeira Pessoal" {
    usecase "UC01: Cadastro e Autenticação do Cliente" as UC01
    
    note right of UC01
      **Req. ID:** FR01, NFR06  
      **Descrição:** O usuário deve ser capaz de se cadastrar no sistema com suas informações pessoais 
      e autenticar-se para acessar seus dados financeiros.
    end note
    
    usecase "UC02: Adicionar Contas Bancárias" as UC02
    usecase "UC03: Remover Contas Bancárias" as UC03

    usecase "UC04: Visualizar Resumo Financeiro Mensal" as UC04 
    usecase "UC05: Gerar Relatório Personalizado de Conta" as UC05
    usecase "UC06: Orçamento e Gastos Predeterminados" as UC06
    usecase "UC07: Visualizar Lista de Transações" as UC07
    usecase "UC08: Filtrar Transações" as UC08
    usecase "UC09: Categorizar Transação Manualmente" as UC09
    usecase "UC10: Buscar Transações" as UC10
    usecase "UC11: Visualizar Detalhes da Transação" as UC11
    usecase "UC12: Exportar Transações" as UC12

    usecase "UC13: Receber Categorização Automática" as UC13 
    usecase "UC14: Solicitar Assistência Financeira" as UC14  
    usecase "UC15: Comunicar-se com Conselheiro Financeiro" as UC15  

    ' Relacionamentos entre casos de uso
    UC01 ..> UC02 : <<include>>  
    UC01 --> UC07 : 
      note right of UC07
        Inclui categorização manual (UC09) e automática (UC13).
      end note  
      
    UC04 ..> UC08 : <<extend>>
    UC08 ..> UC05 : <<include>>

    UC14 -->> UC15: Informa ao conselheiro financeiro.

}

' Relacionamentos ator-caso de uso
user --> UC01  
user --> UC02  
user --> UC03  
banker --> UC06  
financial_advisor --> UC14  

@enduml