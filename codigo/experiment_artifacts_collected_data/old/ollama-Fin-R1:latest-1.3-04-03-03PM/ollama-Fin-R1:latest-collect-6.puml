@startuml "C4_UC_Principal"

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title "Sistema de Gestão Financeira Pessoal - Casos de Uso Principais"

' Atores
actor "Cliente Individual" as user #A0C39D
actor "Assistente Virtual (Chatbot)" as chatbot #FF8F1E
actor "Conselheiro Financeiro" as advisor #34A162

' Sistema e casos de Uso
rectangle "Sistema de Gestão Financeira Pessoal" {
    usecase "UC01: Visualizar Resumo Financeiro" as UC01
    
    note right of UC01
      **Req. ID:** FR05, FR15  
      **Descrição:** Exibe um resumo visual (dashboard) dos dados financeiros do usuário, incluindo renda, despesas, investimentos e saldos.
    end note
    
    usecase "UC02: Configurar Alertas Financeiros" as UC02
    usecase "UC03: Gerenciar Contas Bancárias" as UC03
    usecase "UC04: Analisar Excepcionalidades" as UC04  
    usecase "UC05: Criar e Executar Planos de Investimento" as UC05
    usecase "UC06: Realizar Pagamentos" as UC06
    usecase "UC07: Transferir Dinheiro" as UC07
    usecase "UC08: Solicitar Conexões Bancárias Novas" as UC08
    usecase "UC09: Ver Histórico de Conta" as UC09  
    usecase "UC10: Excluir Contas Bancárias" as UC10  

    ' Relacionamentos entre casos de uso
    UC01 ..> UC02 : <<include>>     -- Resumo financeiro depende dos alertas configurados.
    UC01 ..> UC03 : <<extend>>      -- Gerenciamento das contas é um aspecto do resumo.
    UC01 ..> UC04 : <<extend>>      -- Analisar excepcionalidades contribui para o resumo.
    UC02 --. UC07 : <<extend>>     -- Transferir dinheiro pode gerar alertas financeiros.
    
    ' Use case inclusão/extension relações
    UC03 extends UC09 : <<extend>>   -- Excluir contas é um caso especial de ver histórico.
}

' Relacionamentos ator-caso de uso
user --> UC01 
user --> UC03  
user --> UC04 
user --> UC05 
user --> UC06  
user --> UC07
user --> UC08
advisor --> UC09  

' Chatbot relationships (as a use case participant)
chatbot <<participant>> UC01, UC02, UC04

@enduml