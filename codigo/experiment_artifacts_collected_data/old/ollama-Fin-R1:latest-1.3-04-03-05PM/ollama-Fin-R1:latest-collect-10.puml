@startuml "C4_UC_System"

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title "Sistema de Gestão Financeira Pessoal - Casos de Uso Completo"

' Atores
actor "Cliente Individual" as user #E5E602

' Sistema e casos de uso principais
rectangle "Sistema de Gestão Financeira Pessoal" {
    usecase "UC01: Login/Logout" as UC01
    
    note right of UC01
      **Req. ID:** FR01, FR03 (partial)
      **Descrição:** Permite ao usuário autenticar-se no sistema.
    end note
    
    usecase "UC02: Registrar Conta Bancária" as UC02
    usecase "UC03: Adicionar Fonte de Renda" as UC03
    usecase "UC04: Gerenciar Despesas Predeterminadas" as UC04
    usecase "UC05: Realizar Transação" as UC05
    usecase "UC06: Verificar Saldo e Extrato" as UC06
    
    ' Sub-Diagramas para maior detalhamento
    include @startuml "C4_UC_Transactions"
    
    include @startuml "C4_UC_BillPayments"
    
    ' Interações com outros sistemas
    bank #999999 --> UC05 : <<include>>
    externalPaymentProvider #A02B2B --> UC08 : <<include>>
}

' Relacionamentos ator-caso de uso
user --> UC01
user --> UC02
user --> UC03
user --> UC04
user --> UC05
user --> UC06

' System boundary
boundary "Sistema Bancário" as bank #999999
boundary "Fornecedores de Pagamentos Externos" as externalPaymentProvider #A02B2B

@enduml