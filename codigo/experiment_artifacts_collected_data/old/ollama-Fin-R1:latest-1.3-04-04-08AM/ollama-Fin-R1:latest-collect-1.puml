@startuml "C4_UC_PersonalFinance"

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title "Personal Finance Management System - Use Cases"

' Actors
actor "User" as user1 #659CAE
actor "Financial Advisor" as advisor #FFA07A
actor "Banking System" as bank1 #80D3C8

' System and use cases
rectangle "Personal Finance Management System" {
    usecase "UC01: Sign Up/Login" as UC01
    usecase "UC02: Link Bank Accounts" as UC02
    usecase "UC03: Add New Expense/Income" as UC03
    usecase "UC04: View Financial Statements" as UC04
    usecase "UC05: Set Budgets/Categories" as UC05
    usecase "UC06: Share Data with Advisors" as UC06
    usecase "UC07: Generate Reports" as UC07
}

' Relationships between cases of use
UC01 ..> UC02 : <<include>>     ' Sign up requires linking accounts initially

UC02 - UC03 : <<extend>>        ' Linking accounts allows adding expenses or income

UC04 includes UC02, UC03         ' Statements view incorporates linked accounts and transactions

UC05 includes UC03               ' Budget settings rely on added expenses/income

UC06 includes UC02, UC01         ' Sharing requires a logged-in user and linked accounts

UC07 includes UC04, UC05, UC06   ' Reports depend on financial statements, budgets, and shared data

' Actor-use case relationships
user1 --> UC01
advisor --> UC06, UC07
bank1 --> UC02, UC06, UC07      ' Bank systems are involved in linking accounts and report generation
}

@enduml