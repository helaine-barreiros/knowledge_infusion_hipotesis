@startuml "AI-Powered Personal Financial Management System - Use Cases"
left to right direction
title "AI-Powered Personal Financial Management System - Use Cases"

' ACTOR DEFINITION
actor "Individual Customer" as individual_user
actor "Financial Advisor" as financial_advisor

package "Authentication & Security" {
    usecase "UC01: Register User" as UC01
    note right of UC01
      **Req. ID:** FR01, NFR06
      **Description:** Allows users to register with the system using username/password or OAuth2 providers.
    end note
    
    usecase "UC02: Login/Logout User" as UC02
}

package "Financial Account Management" {
    usecase "UC03: Connect Financial Accounts" as UC03
    
    note right of UC03
      **Req. ID:** FR02
      **Description:** Securely links external financial accounts using banking APIs to retrieve transaction data.
    end note
    
    usecase "UC04: View Transactions" as UC04
    usecase "UC05: Categorize Transactions" as UC05
    
    UC03 ..> UC04 : <<include>>
    
    UC04 ..> UC05 : <<extend>>
}

package "Analysis & Insights" {
    usecase "UC06: View Financial Dashboard" as UC06
    note right of UC06
      **Req. ID:** FR04, FR07
      **Description:** Allows users to view a financial dashboard and track their spending patterns over time.
    end note
    
    usecase "UC07: Receive AI Insights" as UC07
    usecase "UC08: View Basic Reports" as UC08
    usecase "UC09: View Advanced Analytics" as UC09
    
    UC09 --|> UC08
    
    UC06 ..> UC04 : <<include>>
}

package "Recommendations & Planning" {
    usecase "UC10: Generate Recommendations" as UC10
    note right of UC10
      **Req. ID:** FR05, FR06, FR13
      **Description:** Provides personalized financial recommendations based on user data and AI analysis.
    end note
    
    usecase "UC11: Set Financial Goals" as UC11
    usecase "UC12: Track Budgets" as UC12
    
    UC11 ..> UC10 : <<include>>
    
    UC12 ..> UC10 : <<extend>>
}

package "Debt Management & Analysis" {
    usecase "UC13: Manage Debt" as UC13
    note right of UC13
      **Req. ID:** FR12, FR09
      **Description:** Offers strategies for debt management and simulations to help users understand repayment plans.
    end note
    
    usecase "UC14: Analyze Credit Score" as UC14
    
    UC13 ..> UC14 : <<include>>
}

package "Investment & Crypto Management" {
    usecase "UC15: Invest in Stocks" as UC15
    note right of UC15
      **Req. ID:** FR10, FR11, FR17
      **Description:** Suggests investment opportunities based on user profiles and provides analysis for stock investments.
    end note
    
    usecase "UC16: Track Crypto Portfolio" as UC16
    
    UC15 ..> UC16 : <<include>>
}

package "News & Alerts" {
    usecase "UC17: Receive Financial News" as UC17
    note right of UC17
      **Req. ID:** FR08, NFR14
      **Description:** Provides users with relevant financial news and market updates.
    end note
    
    usecase "UC18: Set Alerts for Spending Patterns" as UC18
    
    UC17 ..> UC18 : <<include>>
}

package "Miscellaneous Features" {
    usecase "UC19: Chatbot Support" as UC19
    note right of UC19
      **Req. ID:** FR04, NFR13
      **Description:** Offers users access to a chatbot for financial queries and assistance.
    end note
    
    usecase "UC20: Generate Health Reports" as UC20
    
    UC19 ..> UC20 : <<include>>
}

' ACTOR-USE CASE RELATIONSHIPS
individual_user --> UC01
individual_user --> UC03
individual_user --> UC06
individual_user --> UC10
individual_user --> UC15

financial_advisor --> UC14
financial_advisor --> UC20

banking_api ..> UC03 : <<include>>
investment_api ..> UC15 : <<include>>

@enduml