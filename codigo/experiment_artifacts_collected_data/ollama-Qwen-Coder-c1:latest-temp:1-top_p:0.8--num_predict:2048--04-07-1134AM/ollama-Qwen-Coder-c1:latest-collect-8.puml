@startuml "AI-Powered Personal Financial Management System - Use Cases"
left to right direction
title "AI-Powered Personal Financial Management System - Use Cases"

actor "Individual Customer" as user
actor "Financial Advisor" as advisor
actor "Banking APIs" as bank_api #lightblue
actor "Investment APIs" as invest_api #lightblue
actor "Credit Scoring Service" as credit_service #lightgreen
actor "AI Reasoning Engine" as ai_engine #lightgreen

package "Authentication & Security" {
    usecase "UC01: Authenticate User" as UC01 <<include>>
    
    note right of UC01
      **Req. ID:** FR01, NFR06
      **Description:** Allows users to authenticate via 
      username/password or OAuth2 providers, with optional multi-factor authentication.
    end note
    
    usecase "UC02: Manage Account Settings" as UC02 <<extend>>
}

package "Financial Data Management" {
    usecase "UC03: Connect Financial Accounts" as UC03
    usecase "UC04: Retrieve Transactions" as UC04
    usecase "UC05: Categorize Transactions" as UC05
    
    UC03 ..> UC04 : <<include>>
    UC04 ..> UC05 : <<extend>>
}

package "Analysis & Recommendations" {
    usecase "UC06: View Financial Dashboard" as UC06
    usecase "UC07: Receive AI Insights" as UC07
    
    note right of UC07
      **Req. ID:** FR05, FR06, NFR14
      **Description:** Provides AI-powered insights and personalized financial recommendations based on user data.
    end note
    
    usecase "UC08: View Basic Reports" as UC08 <<extend>>
    
    UC07 --|> UC08
}

package "Planning & Budgeting" {
    usecase "UC09: Set Financial Goals" as UC09
    usecase "UC10: Track and Monitor Budgets" as UC10
    
    note right of UC10
      **Req. ID:** FR07, FR08
      **Description:** Allows users to set goals and monitor their budgets with real-time updates.
    end note
}

package "Monitoring & Alerts" {
    usecase "UC11: Receive Financial Alerts" as UC11
    
    note right of UC11
      **Req. ID:** FR09, NFR04
      **Description:** Provides alerts for unusual spending patterns and other important financial events.
    end note
}

package "Forecasting & Prediction" {
    usecase "UC12: Forecast Future Financial Positions" as UC12
    
    note right of UC12
      **Req. ID:** FR10, NFR04
      **Description:** Uses historical data to forecast future financial positions and provide proactive recommendations.
    end note
}

package "Investment & Portfolio Management" {
    usecase "UC13: Suggest Investment Opportunities" as UC13
    
    note right of UC13
      **Req. ID:** FR11, NFR04
      **Description:** Provides tailored investment opportunities based on user preferences and financial data.
    end note
}

package "Debt Management & Simulation" {
    usecase "UC14: Manage Debt Repayment Strategies" as UC14
    
    note right of UC14
      **Req. ID:** FR12, NFR04
      **Description:** Offers debt management strategies and simulates repayment plans.
    end note
}

package "Collaboration & Sharing" {
    usecase "UC15: Share Financial Data with Advisors" as UC15
    
    note right of UC15
      **Req. ID:** FR13, NFR04
      **Description:** Allows users to share selected financial data securely and collaborate with financial advisors.
    end note
}

package "AI-Powered Assistance & Chatbot" {
    usecase "UC16: Provide AI-Assisted Queries" as UC16
    
    note right of UC16
      **Req. ID:** FR14, NFR04
      **Description:** Offers a chatbot for financial queries and assistance.
    end note
}

package "Reporting & Analytics" {
    usecase "UC17: Generate Financial Health Reports" as UC17
    
    note right of UC17
      **Req. ID:** FR15, NFR04
      **Description:** Provides periodic reports to help users assess their financial health and progress.
    end note
}

package "Internationalization & Multi-Currency Support" {
    usecase "UC18: Manage International Financial Accounts" as UC18
    
    note right of UC18
      **Req. ID:** FR08, NFR04
      **Description:** Supports multiple currencies and international financial accounts.
    end note
}

package "AI Explainability & Reasoning Support" {
    usecase "UC19: Provide AI Explanation for Recommendations" as UC19
    
    note right of UC19
      **Req. ID:** NFR08, NFR04
      **Description:** Ensures that AI recommendations are explainable and provide clear reasoning.
    end note
}

package "Offline Mode & Limited Functionality Support" {
    usecase "UC20: Access Offline with Reduced Features" as UC20
    
    note right of UC20
      **Req. ID:** FR13, NFR04
      **Description:** Offers limited functionality in offline mode to ensure usability without internet access.
    end note
}

user --> UC01
user --> UC03
user --> UC06
user --> UC09
user --> UC12
user --> UC15

advisor --> UC07
advisor --> UC14
advisor --> UC18

bank_api --> UC03
invest_api --> UC03
credit_service --> UC03
ai_engine --> UC07

@enduml