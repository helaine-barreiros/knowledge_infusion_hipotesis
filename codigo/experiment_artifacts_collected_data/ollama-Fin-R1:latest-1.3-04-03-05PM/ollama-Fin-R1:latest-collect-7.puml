@startuml "C4_UC_Sistema_Gestao_Financeira"

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title "Sistema de Gestão Financeira Pessoal - Casos de Uso"

' Atores
actor "Cliente Individual" as user #0090fd
actor "Financial Advisor" as advisor #ffd700

' Sistema e casos de uso
rectangle "Sistema de Gestão Financeira Pessoal" {
    usecase "UC01: Autenticar Usuário" as UC01
    
    note right of UC01
      **Req. ID:** NFR06, NFR07, FR13
      **Descrição:** Permite ao usuário iniciar sessão usando 
      credenciais ou autenticação multifator.
    end note
    
    usecase "UC02: Adicionar/Remover Conta" as UC02
    usecase "UC03: Visualizar Lista de Transações" as UC03
    usecase "UC04: Categorizar Transação Manualmente" as UC04
    usecase "UC05: Exportar Dados Financeiros" as UC05
    usecase "UC06: Gerar Relatório Financeiro Periodico" as UC06
    
    note right of UC03
      **Req. ID:** FR03, FR04, FR12, FR14
      **Descrição:** Permite ao usuário ver todas transações 
      financeiras (categorias e valores) de suas contas.
    end note

    usecase "UC07: Compartilhar Dados com Conselheiro Financeiro" as UC07
}

' Relacionamentos entre casos de uso
UC01 ..> UC02 : <<include>>
UC03 ..> UC04 : <<extend>>
UC03 ..> UC05 : <<extend>>
UC06 ..> UC07 : <<include>>

' Relacionamentos ator-caso de uso
user --> UC01
advisor --> UC07

@enduml