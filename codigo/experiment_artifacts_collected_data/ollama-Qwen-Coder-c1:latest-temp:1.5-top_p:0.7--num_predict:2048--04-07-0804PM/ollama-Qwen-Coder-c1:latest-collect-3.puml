@startuml "AI-Powered Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Use Cases"

actor "Individual Customer" as user
actor "Financial Advisor" as advisor
actor "Banking API" as bank #lightblue
actor "Investment API" as invest #lightblue
actor "Credit Scoring Service" as credit_service #lightgreen
actor "News Service" as news_service #orange
actor "Authentication Service" as auth_service #purple
actor "AI Reasoning Engine" as ai_engine #cyan

package "Authentication & Security" {
    usecase "UC01: Authenticate User" as UC01 <<include>>
}

package "Financial Account Management" {
    usecase "UC02: Connect Financial Accounts" as UC02
    usecase "UC03: Retrieve Transactions" as UC03
    
    note right of UC02
      **Req. ID:** FR02, NFR06
      **Description:** Securely links external financial accounts 
      using banking APIs to retrieve transaction data.
    end note
    
    UC01 ..> UC02 : <<include>>
}

package "Analysis & Recommendations" {
    usecase "UC04: View Financial Dashboard" as UC04
    usecase "UC05: Receive AI Insights" as UC05
    usecase "UC06: Generate Recommendations" as UC06
    
    note right of UC05
      **Req. ID:** FR05, FR06, NFR12
      **Description:** Provides personalized financial insights 
      and recommendations based on AI analysis.
    end note

    UC04 ..> UC05 : <<include>>
}

package "Planning & Goal Setting" {
    usecase "UC07: Set Financial Goals" as UC07
    usecase "UC08: Track Budgets" as UC08
    
    note right of UC07
      **Req. ID:** FR03, FR07, NFR12
      **Description:** Allows users to set and track financial 
      goals and budgets.
    end note

    UC04 ..> UC07 : <<include>>
}

package "Collaboration" {
    usecase "UC09: Share Financial Data with Advisors" as UC09
    
    note right of UC09
      **Req. ID:** FR13, NFR12
      **Description:** Facilitates collaboration between users 
      and financial advisors by sharing selected data.
    end note

    UC07 ..> UC09 : <<include>>
}

package "Reporting & Analytics" {
    usecase "UC10: Generate Reports" as UC10
    
    note right of UC10
      **Req. ID:** FR15, NFR12
      **Description:** Generates periodic financial health 
      reports for users.
    end note

    UC04 ..> UC10 : <<include>>
}

package "Advanced Features" {
    usecase "UC11: Suggest Investment Opportunities" as UC11
    usecase "UC12: Forecast Future Positions" as UC12
    
    note right of UC11
      **Req. ID:** FR11, NFR04
      **Description:** Provides investment recommendations and 
      future financial position forecasts based on historical data.
    end note

    UC06 ..> UC11 : <<include>>
}

package "Debt Management" {
    usecase "UC13: Manage Debt Repayment" as UC13
    
    note right of UC13
      **Req. ID:** FR12, NFR04
      **Description:** Offers strategies for debt management and 
      simulations to show repayment scenarios.
    end note

    UC06 ..> UC13 : <<include>>
}

package "Additional Services" {
    usecase "UC14: Receive Financial News Updates" as UC14
    
    note right of UC14
      **Req. ID:** FR17, NFR12
      **Description:** Provides users with relevant financial 
      news and economic indicators.
    end note

    UC03 ..> UC14 : <<include>>
}

user --> UC01
user --> UC02
user --> UC04
advisor --> UC05
bank --> UC02
invest --> UC06
credit_service --> UC07
news_service --> UC14
auth_service --> UC03
ai_engine --> UC08

@enduml