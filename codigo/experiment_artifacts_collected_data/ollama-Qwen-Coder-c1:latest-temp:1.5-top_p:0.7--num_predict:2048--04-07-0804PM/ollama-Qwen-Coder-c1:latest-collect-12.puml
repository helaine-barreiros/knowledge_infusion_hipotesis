user --> UC13
user --> UC14
user --> UC15
user --> UC16
user --> UC17
user --> UC18
user --> UC19
user --> UC20

advisor --> UC07
advisor --> UC16

banking_api --> UC03
investment_api --> UC03
credit_service --> UC03
ai_engine --> UC06
ai_engine --> UC13

@enduml