@startuml "AI-Powered Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Use Cases"

' ACTOR DEFINITION
actor "Individual Customer" as user
actor "Financial Advisor" as advisor

package "Authentication & Security" {
    usecase "UC01: Authenticate User" as UC01
}

package "Account and Data Connection" {
    usecase "UC02: Connect Financial Accounts" as UC02
    usecase "UC03: Retrieve Bank Transactions" as UC03
    
    note right of UC02
      **Req. ID:** FR02, NFR06
      **Description:** Securely links external financial accounts 
      using banking APIs to retrieve transaction data.
    end note

    note right of UC03
      **Req. ID:** FR03
      **Description:** Retrieves transactions from connected bank accounts and categorizes them.
    end note
    
}

package "Visualization & Analysis" {
    usecase "UC04: View Financial Dashboard" as UC04
    usecase "UC05: Analyze Spending Patterns" as UC05

    note right of UC04
      **Req. ID:** FR04, NFR12
      **Description:** Displays a visual representation of financial data and spending habits.
    end note
    
}

package "Insights & Recommendations" {
    usecase "UC06: Receive AI Insights" as UC06

    note right of UC06
      **Req. ID:** FR05, NFR13
      **Description:** Provides personalized financial insights and recommendations based on user data.
    end note
    
}

package "Goal Management & Budgeting" {
    usecase "UC07: Set Financial Goals" as UC07
    usecase "UC08: Monitor Budgets" as UC08

    note right of UC07
      **Req. ID:** FR07, NFR12
      **Description:** Allows users to set and track financial goals.
    end note
    
}

package "Investment & Debt Management" {
    usecase "UC09: Suggest Investment Opportunities" as UC09
    usecase "UC10: Manage Debt Repayment" as UC10

    note right of UC09
      **Req. ID:** FR11, NFR13
      **Description:** Provides investment suggestions and debt management strategies.
    end note
    
}

package "Collaboration & Sharing" {
    usecase "UC11: Share Data with Advisors" as UC11

    note right of UC11
      **Req. ID:** FR12, NFR08
      **Description:** Allows users to share selected financial data with financial advisors.
    end note
    
}

package "AI & Machine Learning" {
    usecase "UC12: AI-Powered Recommendations" as UC12

    note right of UC12
      **Req. ID:** FR06, NFR09
      **Description:** Leverages advanced algorithms to provide personalized financial recommendations.
    end note
    
}

package "Reporting & Analytics" {
    usecase "UC13: Generate Reports" as UC13

    note right of UC13
      **Req. ID:** FR15, NFR07
      **Description:** Creates periodic financial health reports for users and advisors.
    end note
    
}

package "Advanced Features & Customization" {
    usecase "UC14: Customize Dashboards" as UC14

    note right of UC14
      **Req. ID:** FR12, NFR09
      **Description:** Allows customization of dashboards and reports based on user preferences.
    end note
    
}

package "Internationalization & Compatibility" {
    usecase "UC15: Support Multiple Currencies" as UC15

    note right of UC15
      **Req. ID:** NFR08, NFR14
      **Description:** Supports international financial data and multiple currencies.
    end note
    
}

package "Security & Compliance" {
    usecase "UC16: Ensure Data Security" as UC16

    note right of UC16
      **Req. ID:** FR02, NFR07
      **Description:** Ensures secure access to user data and compliance with financial regulations.
    end note
    
}

package "AI-Driven Predictions & Forecasting" {
    usecase "UC17: Forecast Future Financial Positions" as UC17

    note right of UC17
      **Req. ID:** FR09, NFR05
      **Description:** Provides future financial position forecasts based on historical data.
    end note
    
}

package "User Interface & Experience" {
    usecase "UC18: User-Friendly Interface" as UC18

    note right of UC18
      **Req. ID:** FR04, NFR12
      **Description:** Ensures the system is user-friendly and accessible.
    end note
    
}

package "Chatbot & Customer Support" {
    usecase "UC19: Chatbot for Financial Queries" as UC19

    note right of UC19
      **Req. ID:** FR14, NFR07
      **Description:** Provides customer support through a chatbot.
    end note
    
}

package "Offline Mode & Compatibility" {
    usecase "UC20: Offline Mode Support" as UC20

    note right of UC20
      **Req. ID:** FR13, NFR05
      **Description:** Allows the system to operate in offline mode with limited functionality.
    end note
    
}

user --> UC01
user --> UC02
user --> UC04
user --> UC06
user --> UC07
user --> UC08
user --> UC09
user --> UC10
user --> UC11
user --> UC12
user --> UC13
user --> UC14
user --> UC15
user --> UC16
user --> UC17
user --> UC18
user --> UC19
user --> UC20

advisor --> UC09
advisor --> UC10
advisor --> UC11

@enduml