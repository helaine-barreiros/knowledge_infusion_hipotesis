@startuml "AI-Powered Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Use Cases"

actor "Individual Customer" as user
actor "Financial Advisor" as advisor

package "Authentication & Security" {
    usecase "UC01: Authenticate User" as UC01 <<include>>
}

package "Financial Account Management" {
    usecase "UC02: Connect Financial Accounts" as UC02
    usecase "UC03: View Transactions" as UC03
    usecase "UC04: Categorize Transactions" as UC04
    
    UC02 ..> UC03 : <<include>>
    UC03 ..> UC04 : <<extend>>
}

package "Analysis & Insights" {
    usecase "UC05: View Financial Dashboard" as UC05
    usecase "UC06: Receive AI Recommendations" as UC06
    
    note right of UC06
      **Req. ID:** FR05, FR07, NFR14
      **Description:** Provides users with personalized financial recommendations based on their spending habits and goals.
    end note

    usecase "UC07: View Advanced Analytics" as UC07
    
    UC05 ..> UC06 : <<include>>
}

package "Planning & Goal Setting" {
    usecase "UC08: Set Financial Goals" as UC08
    usecase "UC09: Track Progress" as UC09
    
    note right of UC09
      **Req. ID:** FR07, NFR12
      **Description:** Allows users to set and track financial goals with real-time progress updates.
    end note

    UC08 ..> UC09 : <<include>>
}

package "Budgeting & Forecast" {
    usecase "UC10: Create Budgets" as UC10
    usecase "UC11: Monitor Spending" as UC11
    
    note right of UC11
      **Req. ID:** FR08, NFR04
      **Description:** Enables users to create budgets and monitor their spending patterns in real-time.
    end note

    UC10 ..> UC11 : <<include>>
}

package "Debt Management" {
    usecase "UC12: View Debt Summary" as UC12
    usecase "UC13: Repayment Simulation" as UC13
    
    note right of UC13
      **Req. ID:** FR09, NFR05
      **Description:** Provides users with debt management strategies and simulations to help them repay debts efficiently.
    end note

    UC12 ..> UC13 : <<include>>
}

package "Investment & Cryptocurrency" {
    usecase "UC14: Suggest Investment Opportunities" as UC14
    usecase "UC15: Track Portfolio Performance" as UC15
    
    note right of UC15
      **Req. ID:** FR10, NFR09
      **Description:** Recommends investment opportunities based on user profiles and tracks portfolio performance.
    end note

    UC14 ..> UC15 : <<include>>
}

package "Collaboration & Sharing" {
    usecase "UC16: Share Financial Data" as UC16
    
    note right of UC16
      **Req. ID:** FR08, NFR12
      **Description:** Allows users to share selected financial data with financial advisors.
    end note

    UC14 ..> UC15 : <<include>>
}

package "AI Reasoning & Insights" {
    usecase "UC17: Analyze Spending Habits" as UC17
    usecase "UC18: Forecast Future Financial Positions" as UC18
    
    note right of UC18
      **Req. ID:** FR09, NFR13
      **Description:** Uses AI to analyze spending habits and forecast future financial positions based on historical data.
    end note

    UC17 ..> UC18 : <<include>>
}

package "Chatbot & Support" {
    usecase "UC19: Interact with Chatbot" as UC19
    usecase "UC20: Access Financial Resources" as UC20
    
    note right of UC20
      **Req. ID:** FR14, NFR15
      **Description:** Provides users with access to financial resources and assistance through a chatbot.
    end note

    UC19 ..> UC20 : <<include>>
}

package "Reporting & Analytics" {
    usecase "UC21: Generate Reports" as UC21
    
    note right of UC21
      **Req. ID:** FR15, NFR17
      **Description:** Generates periodic financial health reports and analytics.
    end note

    UC08 ..> UC21 : <<include>>
}

package "Offline Mode & Compatibility" {
    usecase "UC22: Access Offline Features" as UC22
    
    note right of UC22
      **Req. ID:** FR13, NFR16
      **Description:** Provides limited functionality when offline and ensures compatibility with major web browsers and mobile devices.
    end note

    UC08 ..> UC22 : <<include>>
}

user --> UC01
user --> UC02
user --> UC05
advisor --> UC09, UC14
bank --> UC03
ai --> UC06, UC17

@enduml