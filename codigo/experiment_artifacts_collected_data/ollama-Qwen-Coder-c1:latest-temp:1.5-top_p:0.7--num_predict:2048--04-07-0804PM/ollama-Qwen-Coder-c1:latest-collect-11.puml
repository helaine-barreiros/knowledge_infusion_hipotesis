@startuml "AI-Powered Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Use Cases"

actor "Individual Customer" as user
actor "Financial Advisor" as advisor

package "Authentication & Security" {
    usecase "UC01: Authenticate User" as UC01 <<include>>
    note right of UC01
      **Req. ID:** FR01, NFR06
      **Description:** Allows users to authenticate via 
      username/password or OAuth2 providers, with 
      optional multi-factor authentication.
    end note
    
    usecase "UC02: Manage Account Settings" as UC02 <<extend>>
}

package "Financial Management & Analysis" {
    usecase "UC03: Connect Financial Accounts" as UC03
    note right of UC03
      **Req. ID:** FR02, NFR14
      **Description:** Securely links external financial accounts 
      using banking APIs to retrieve transaction data.
    end note
    
    usecase "UC04: View Transactions" as UC04 <<include>>
    
    usecase "UC05: Categorize Transactions" as UC05 <<extend>>
    
    UC03 ..> UC04 : <<include>>

    UC04 ..> UC05 : <<extend>>

    usecase "UC06: Analyze Spending Patterns" as UC06
    note right of UC06
      **Req. ID:** FR04, FR17
      **Description:** Visualizes spending patterns and historical financial data.
    end note
    
    usecase "UC07: Generate Insights & Recommendations" as UC07 <<include>>
    
    UC03 ..> UC07 : <<include>>

    usecase "UC08: Set Financial Goals" as UC08
    note right of UC08
      **Req. ID:** FR07, NFR12
      **Description:** Allows users to set and track financial goals.
    end note
    
    usecase "UC09: Monitor Budgets & Forecast Future Positions" as UC09 <<include>>
    
    UC03 ..> UC09 : <<include>>

    usecase "UC10: Generate Financial Health Reports" as UC10
    note right of UC10
      **Req. ID:** FR15, NFR24
      **Description:** Provides periodic financial health reports.
    end note
    
}

package "Investment & Recommendations" {
    usecase "UC11: Suggest Investment Opportunities" as UC11 <<include>>
    
    UC03 ..> UC11 : <<include>>

    usecase "UC12: Forecast Future Investments Based on User Profile" as UC12
    note right of UC12
      **Req. ID:** FR11, NFR19
      **Description:** Provides investment suggestions based on user profile.
    end note
    
}

package "Debt Management & Alerts" {
    usecase "UC13: Manage Debt Repayment Strategies with Simulations" as UC13 <<include>>
    
    UC03 ..> UC13 : <<include>>

    usecase "UC14: Set Up Alerts for Unusual Spending Patterns" as UC14
    note right of UC14
      **Req. ID:** FR09, NFR26
      **Description:** Delivers alerts for unusual spending patterns.
    end note
    
}

package "AI & Advanced Analytics" {
    usecase "UC15: Receive AI-Driven Financial Insights" as UC15 <<include>>
    
    UC03 ..> UC15 : <<include>>

    usecase "UC16: Provide Explainable Recommendations" as UC16
    note right of UC16
      **Req. ID:** NFR09, FR28
      **Description:** Provides explainable financial recommendations with reasoning.
    end note
    
}

package "Collaboration & Sharing" {
    usecase "UC17: Share Selected Financial Data with Advisors" as UC17 <<include>>
    
    advisor --> UC17 : <<extend>>

    usecase "UC18: Provide a Chatbot for Financial Queries" as UC18
    note right of UC18
      **Req. ID:** FR20, NFR30
      **Description:** Offers chatbot support for financial queries.
    end note
    
}

package "Advanced Features & Integration" {
    usecase "UC19: Generate Periodic Financial Health Reports" as UC19 <<include>>
    
    UC06 ..> UC19 : <<extend>>

    usecase "UC20: Offer Multi-Factor Authentication for Enhanced Security" as UC20
    note right of UC20
      **Req. ID:** NFR05, FR32
      **Description:** Supports multi-factor authentication to enhance security.
    end note
    
}

user --> UC01
user --> UC04
user --> UC06
advisor --> UC09
bank --> UC03
ai --> UC17

@enduml