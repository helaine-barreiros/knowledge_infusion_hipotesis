@startuml "C4_UC_PainelFinanceiro"

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title "Sistema de Gestão Financeira Pessoal - Painel Financeiro - Casos de Uso"

' Atores
actor "Cliente Individual" as user
actor "Sistema Bancário" as bank #999999

' Sistema e casos de uso
rectangle "Sistema de Gestão Financeira Pessoal" {
    usecase "UC01: Visualizar Dashboard Inicial" as UC01
    
    note right of UC01
      **Req. ID:** FR05, FR06
      **Descrição:** Permite ao usuário visualizar um painel 
      inicial com uma visão geral de suas finanças, incluindo 
      carteiras de crédito, renda e despesas.
    end note
    
    usecase "UC02: Atualizar Saldo em Tempo Real" as UC02
    usecase "UC03: Visualizar Relatórios Financeiros" as UC03
    usecase "UC04: Customizar Painel de Visualização" as UC04
    usecase "UC05: Receber Alertas sobre Despesas Críticas" as UC05
    usecase "UC06: Exportar Relatórios Financeiros" as UC06
    
    ' Relacionamentos entre casos de uso
    UC01 ..> UC02 : <<include>>
    UC01 ..> UC03 : <<extend>>
    UC01 ..> UC04 : <<include>>
    UC01 ..> UC05 : <<include>>
    UC03 ..> UC06 : <<include>>
}

' Relacionamentos ator-caso de uso
user --> UC01
user --> UC02
bank --> UC05

@enduml