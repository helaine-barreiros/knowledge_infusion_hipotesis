@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Enhanced Personal Financial Management System - Use Cases"

actor IndividualCustomer as user
actor FinancialAdvisor as advisor

package Authentication & Security {
    usecase UC01: Authenticate User as uc_auth
    
    note right of uc_auth
        **Req. ID:** FR01, NFR06  
        **Description:** Allows users to authenticate via username/password or OAuth2 providers with optional multi-factor authentication.
    end note

    usecase UC02: Manage Account Settings 
}

package FinancialAccountManagement {
    usecase UC03: Connect Financial Accounts as uc_connect
    usecase UC04: View Transactions  
    usecase UC05: Categorize Transactions  

    note right of uc_connect
        **Req. ID:** FR02  
        **Description:** Securely links external financial accounts using banking APIs to retrieve transaction data.
    end note

    note left of uc_view_transactions
        **Include Relationship** (UC03 --> UC04): Transaction retrieval and viewing are always part of account management.
    end note

    usecase UC06: Budget Management  
}

package FinancialAnalysis {
    usecase UC07: Receive AI Insights as uc_insights
    usecase UC08: View Basic Reports 
    usecase UC09: View Advanced Analytics  

    note right of uc_insights
        **Req. ID:** FR05, FR16  
        **Description:** Provides personalized financial insights and advanced analytics.
    end note

    note left of uc_view_reports
        **Generalization Relationship** (UC08 --> UC09): Advanced reports are a specialized version of basic reports.
    end note
}

package GoalSetting {
    usecase UC10: Set Financial Goals  
    usecase UC11: Track Progress  

    note right of uc_set_goals
        **Req. ID:** FR07, NFR04  
        **Description:** Allows users to define and track their financial goals.
    end note

}

package Planning {
    usecase UC12: Create Investment Plans as uc_create_plans 
    usecase UC13: Monitor Portfolio Performance  

    note right of uc_create_plans
        **Req. ID:** FR06, FR14  
        **Description:** Generates personalized investment recommendations based on user data.
    end note

}

package Notifications {
    usecase UC14: Receive Financial Alerts as uc_alerts 
    usecase UC15: Send Reminders  

    note right of uc_send_reminders
        **Req. ID:** FR09, NFR03  
        **Description:** Sends alerts for unusual spending and regular reminders.
    end note

}

package Collaboration {
    usecase UC16: Share Data with Advisors as uc_share_data 
    usecase UC17: Receive Advisor Feedback  

    note right of uc_share_data
        **Req. ID:** FR13  
        **Description:** Enables users to share selected financial data securely with advisors.
    end note

}

package AIComponents {
    usecase UC18: Leverage AI Engine for Analysis as uc_ai_analysis 
}

user --> uc_auth
user --> uc_connect
user --> uc_view_transactions
user --> uc_insights
user --> uc_set_goals
advisor --> uc_create_plans
bank --> uc_connect
ai_engine --> uc_ai_analysis

@enduml