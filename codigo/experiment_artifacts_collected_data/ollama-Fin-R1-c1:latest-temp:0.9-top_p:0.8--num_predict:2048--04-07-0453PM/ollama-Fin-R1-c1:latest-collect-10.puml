@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Core Functionalities"
LAYOUT_LEFT_TO_RIGHT()

actor IndividualCustomer as user [#08427B]
actor Advisor as advisor [#08427B]

package Authentication & Security {
    usecase UC01: Authenticate User as uc_auth
        note right of uc_auth
            **Req. ID:** FR01, NFR06  
            **Description:** Allows users to authenticate via username/password or OAuth2 providers with optional multi-factor authentication.
        end note
}

package Financial Account Management {
    usecase UC03: Connect Accounts as uc_connect [#999999]
        note right of uc_connect
            **Req. ID:** FR02  
            **Description:** Securely links external financial accounts using banking APIs to retrieve transaction data.
        end note

    usecase UC04: View Transactions [view_transactions] extends uc_connect
}

package Financial Analysis & Insights {
    usecase UC06: View Dashboard as view_dashboard [#999999]
    usecase UC07: AI-Generated Insights as ai_insights [#999999]

    usecase UC08: Basic Reports [basic_reports] extends view_dashboard
        note right of uc08
            **Description:** Simplified financial reports for users.
        end note

    usecase UC10: Advanced Analytics [advanced_analytics] extends ai_insights
}

package Goal Setting & Budgeting {
    usecase UC12: Set Financial Goals as set_goals [#999999]
    
    usecase UC13: Track Progress as track_progress [track_progress] extends uc12

    usecase UC14: Create Budgets [create_budgets] extends uc_connect
}

package Investment & Savings {
    usecase UC15: View Portfolios as view_portfolios [#999999]
    
    usecase UC16: AI-Driven Recommendations as ai_recommendations [ai_recs] extends ai_insights

    usecase UC17: Set Investment Goals [set_invest_goals] 
}

package Collaboration & Sharing {
    usecase UC20: Share Data with Advisors [share_data_advisors] [#999999]
        note right of uc20
            **Req. ID:** FR13  
            **Description:** Allows users to share selected financial data with their advisors.
        end note

}

package Notifications & Alerts {
    usecase UC24: Set Up Financial Alerts [set_alerts] [#999999]
    
    usecase UC25: Receive Alerts as receive_alerts [receive_alerts] extends set_alerts
}

actor BankingSystem as bank #lightblue
actor InvestmentSystem as invest_system #lightgreen

uc_auth --> user : Authenticate  
user --> uc_connect : Connect Accounts  
bank --> uc_connect : Provide Data  

view_dashboard --> uc4: Transactions  
ai_insights --> uc10: Advanced Analytics  

set_goals --> track_progress: Track Progress  
create_budgets --> view_transactions: Monitor Spending  

view_portfolios --> ai_recommendations: Get Recommendations  

share_data_advisors --> user: Share with Advisors  

user --> set_alerts : Configure Alerts  
receive_alerts --> user: Notifications  

@enduml