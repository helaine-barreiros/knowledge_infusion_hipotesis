@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Use Case Diagram"

actor IndividualCustomer as user [#08427B]
actor Advisor as advisor [#08427B]

package Authentication {
    usecase UC1: Authenticate User
        note right of UC1
            **Req. ID:** FR01, NFR06  
            **Description:** Allows users to log in using username/password or OAuth2 providers with optional multi-factor authentication.
        end note
}

package FinancialAccountManagement {
    usecase UC3: Connect Accounts via Banking APIs as <<include>>
    usecase UC4: View Transactions as <<extend>> of UC3
    usecase UC5: Categorize Transactions

    UC3 ..> UC4 : <<include>>
    UC4 ..> UC5 : <<extend>>
}

package AnalysisAndInsights {
    usecase UC6: Financial Dashboard 
        note right of UC6  
            **Req. ID:** FR02, FR03, FR04  
            **Description:** Aggregates and visualizes financial transactions to show spending patterns.
        end note
    usecase UC7: AI-Driven Insights as <<extend>> of UC6
        note right of UC7 
            **Req. ID:** FR05  
            **Description:** Provides personalized insights using AI on user's transaction data.
        end note

    UC6 ..> UC4 : <<include>>
}

package Planning {
    usecase UC8: Set Financial Goals as <<extend>> of UC3
    usecase UC9: Budget Management and Monitoring as <<extend>> of UC5,UC7
    
    note right of UC8  
        **Req. ID:** FR07  
        **Description:** Users can set financial goals for tracking progress.
    end note

    note right of UC9 
        **Req. ID:** FR03,FR04,FR06  
        **Description:** Manages budgets and generates recommendations based on spending trends.
    end note
}

package Collaboration {
    usecase UC12: Share Financial Data with Advisors as <<extend>> of UC8

    note right of UC12 
        **Req. ID:** FR13  
        **Description:** Allows customers to share selected financial data with their advisors for collaborative planning.
    end note
}

package RecommendationsAndForecasts {
    usecase UC9: Investment Recommendations as <<extend>> of UC7,UC8

    usecase UC10: Future Financial Position Forecasting as <<extend>> of UC6 

    usecase UC11: Debt Management Strategies with Repayment Simulations as <<extend>> of UC4,UC5
}

package AdvancedAnalytics {
    usecase UC9: Advanced AI-Driven Reports and Dashboards

    note right of UC9 
        **Req. ID:** FR08  
        **Description:** Provides advanced financial analysis through dashboards.
    end note
}

user --> UC1 [REQ_ID=FR01,NFR06]
advisor --> UC9 [REQ_ID=FR13]

UC1 ..> UC3 : <<include>>
UC3 ..> UC4 : <<include>>

UC7 ..> UC6 : <<extend>>  
UC8 ..> UC6 : <<extend>>
UC9 ..> UC5,UC7 : <<extend>>
UC10 ..> UC6 : <<extend>>
UC11 ..> UC4,UC5 : <<extend>>
UC12 --> UC3 [REQ_ID=FR13]

@enduml