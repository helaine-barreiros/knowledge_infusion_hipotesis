@startuml
[*] --> Ready

state Ready {
    [*] --> Triage Initiated
}

state "Triage Initiated" as TInitiated {
    [*] --> Waiting for Triage
}

state "Waiting for Triage" as W4Triage {
    [*] --> Triage Completed
}

state "Triage Completed" as TCompleted {
    [*] --> Discharge Initiated
}

state "Discharge Initiated" as DInitiated {
    [*] --> Discharge Completed
}

state "Discharge Completed" as DCompleted {
    [*] --> Finalized
}

[*] --> Finalized
@enduml