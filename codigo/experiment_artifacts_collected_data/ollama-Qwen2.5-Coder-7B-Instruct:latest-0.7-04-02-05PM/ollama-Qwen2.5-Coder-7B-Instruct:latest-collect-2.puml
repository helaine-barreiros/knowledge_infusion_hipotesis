@startuml
[*] --> NewPatient

state NewPatient {
    [*] --> AdmitPatient
    AdmitPatient --> PatientAdmitted
}

state PatientAdmitted {
    [*] --> DischargePatient
    DischargePatient --> PatientDischarged
}

state PatientDischarged {
}

state InpatientWard {
    [*] --> TransferToInpatientWard
    TransferToInpatientWard --> InpatientAdmission
}

[*] --> InpatientWard

@enduml