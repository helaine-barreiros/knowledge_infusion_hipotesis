@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Enhanced Personal Financial Management System - Use Cases"

actor IndividualCustomer as user #08427B
actor FinancialAdvisor as advisor #08427B
actor BankingSystem as bank #lightblue
actor InvestmentSystem as invest #lightblue
actor AIEngine as ai #lightgreen

package "Authentication & Security" {
    usecase UC01: Authenticate User as uc01
        note right of uc01
            **Req. ID:** FR01, NFR06  
            Allows users to authenticate via username/password or OAuth2 providers with optional multi-factor authentication.
        end note
}

package "Financial Account Management" {
    usecase UC03: Connect Financial Accounts as uc03
        note right of uc03
            **Req. ID:** FR02  
            Securely links external financial accounts using banking APIs to retrieve transaction data.
        end note
    
    usecase UC04: View Transactions as uc04
    usecase UC05: Categorize Transactions as uc05

    uc03 ..> uc04 : <<include>>  -- Always includes viewing transactions after connection.

    uc04 ..> uc05 : <<extend>>   -- Optional categorization of transactions.
}

package "Analysis & Insights" {
    usecase UC06: View Financial Dashboard as uc06
    usecase UC07: Receive AI Insights as uc07

    note right of uc07  
        **Req. ID:** FR05, FR13  
        Provides personalized financial insights using advanced reasoning.
    end note
    
    generalization UC09: View Advanced Analytics --|> UC08: View Basic Reports
}

package "Goal Management" {
    usecase UC08: Set Financial Goals as uc08
    usecase UC09: Track Progress Toward Goals as uc09

    uc08 ..> uc09 : <<extend>>  -- Option to track after setting goals.
}

package "Recommendations & Planning" {
    usecase UC10: Generate Budget Recommendations as uc10  
        note right of uc10
            **Req. ID:** FR06, FR07  
            Creates personalized budget plans based on spending habits and financial goals.
        end note

    usecase UC11: Forecast Financial Future as uc11  

    usecase UC12: Suggest Investments Based On Profile as uc12

    generalization UC13: Debt Management --|> UC09
}

package "Collaboration" {
    usecase UC14: Share Data With Advisors as uc14  
        note right of uc14
            **Req. ID:** FR13, NFR06  
            Enables users to share selected financial data with advisors for joint planning.
        end note

    usecase UC15: Chatbot Interactions as uc15  

}

package "System Operations" {
    usecase UC16: Manage System Settings as uc16
    usecase UC17: Data Integrity Checks as uc17  
}

actor user --> uc01
user --> uc03
user --> uc04
advisor --> uc09, uc12

bank --> uc03 : <<include>>
invest --> uc12 : <<extend>>

ai --> uc06, uc07  

@enduml