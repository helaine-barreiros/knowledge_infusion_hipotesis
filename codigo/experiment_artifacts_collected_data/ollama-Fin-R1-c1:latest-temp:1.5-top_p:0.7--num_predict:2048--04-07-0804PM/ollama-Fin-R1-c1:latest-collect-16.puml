@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Use Case Diagram"

actor IndividualCustomer as user #CUSTOMER_COLOR  
actor FinancialAdvisor as advisor #SYSTEM_COLOR  

package Authentication {
    usecase UC01: Authenticate User as uc01
        note right of uc01
            **Req. ID:** FR01, NFR06  
            Allows users to authenticate via username/password or OAuth2 providers with optional multi-factor authentication.
        end note
}

package FinancialAccountManagement {
    usecase UC03: Connect Financial Accounts as uc03  
    usecase UC04: View Transactions as uc04  
    usecase UC05: Categorize Transactions as uc05  

    uc03 ..> uc04 : <<include>>  
    uc04 ..> uc05 : <<extend>>
}

package AnalysisAndInsights {
    usecase UC06: View Financial Dashboard as uc06
    usecase UC07: Receive AI Insights as uc07

    note right of uc07
        **Req. ID:** FR05, NFR12  
        Provides personalized financial recommendations and advanced analysis using the AI engine.
    end note
}

package Planning {
    usecase UC08: Set Financial Goals as uc08  
    usecase UC09: Track Progress Toward Goals as uc09  

    uc08 ..> uc09 : <<extend>>
}

package Collaboration {
    usecase UC10: Share Data with Advisor as uc10
        note right of uc10
            **Req. ID:** FR13  
            Enables users to share selected financial data securely.
        end note
}

' Relationships between packages and actors
user --> uc01 : Log in / Sign up  
advisor --> uc09 : Review goals, receive insights  

' Cross-package relationships (e.g., AI Insights include Transactions)
uc07 ..> uc04 : <<include>>  

@enduml