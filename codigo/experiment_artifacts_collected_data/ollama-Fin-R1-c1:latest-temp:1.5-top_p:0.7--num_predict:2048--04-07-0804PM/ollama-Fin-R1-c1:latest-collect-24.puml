@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Enhanced Personal Financial Management System - Use Cases"

actor IndividualCustomer as user
actor FinancialAdvisor as advisor

package Authentication {
    usecase UC01: Authenticate User
        note right of UC01
            **Req. ID:** FR01, NFR06  
            Allows users to authenticate via username/password or OAuth2 providers with optional multi-factor authentication.
        end note
}

package FinancialAccountManagement {
    usecase UC03: Connect Accounts 
        note right of UC03
            **Req. ID:** FR02  
            Securely links external financial accounts using banking APIs for transaction data retrieval.
        end note

    usecase UC04: View Transactions
    usecase UC05: Categorize Transactions
    
    UC03 ..> UC04 : <<include>>  
    UC04 ..> UC05 : <<extend>>
}

package FinancialAnalysis {
    usecase UC06: Analyze Spending Patterns 
        note right of UC06
            **Req. ID:** FR03, FR04  
            Aggregates and categorizes transactions to visualize spending habits.
        end note

    usecase UC07: Receive AI Insights
        note right of UC07
            **Req. ID:** FR05  
            Provides personalized financial insights using advanced analysis techniques.
        end note
    
    usecase UC08: Set Financial Goals 
        note right of UC08
            **Req. ID:** FR07, NFR12  
            Enables users to define and track short-term/long-term goals with notifications.
        end note

    usecase UC09: Budget Management
        note right of UC09
            **Req. ID:** FR08, FR09  
            Assists in creating budgets and monitoring spending against them, including alerts for overages.
        end note
        
    generalization UC10: AdvancedBudgeting --|> UC09 
}

package InvestmentRecommendations {
    usecase UC11: View Portfolio Performance
        note right of UC11
            **Req. ID:** FR11  
            Fetches and displays investment portfolio data from APIs.
        end note

    usecase UC12: Receive AI-Driven Recommendations
        note right of UC12
            **Req. ID:** FR06, FR14  
            Generates personalized financial recommendations using historical data analysis.
        end note
        
    generalization UC13: PersonalizedAdvice --|> UC12 
}

package DebtManagement {
    usecase UC14: Track Debts & Repayments
        note right of UC14
            **Req. ID:** FR12  
            Simulates repayment scenarios for debts, including credit impact analysis.
        end note

    usecase UC15: Negotiate with Creditors 
}

package Collaboration {
    usecase UC16: Share Data with Advisors
        note right of UC16
            **Req. ID:** FR13  
            Allows users to share specific financial data segments with advisors for joint review.
        end note

    usecase UC17: Chatbot Interaction
        note right of UC17
            **Req. ID:** FR14, NFR08  
            Engages in natural language dialogue about finances, providing quick answers and guidance.
        end note

}

package Reporting {
    usecase UC18: Generate Financial Health Reports 
        note right of UC18
            **Req. ID:** FR15  
            Creates comprehensive reports summarizing financial status over periods.
        end note

    usecase UC19: Custom Dashboards & Visualizations
        note right of UC19
            **Req. ID:** NFR12, NFR03  
            Offers flexible dashboards and charts for in-depth analysis by users or advisors.
        end note
        
}

package SystemOperations {
    usecase UC20: Monitor Uptime & Performance 
        note right of UC20
            **NFRs:** NFR04 (response time), NFR03, NFR15  
            Ensures system stability and rapid recovery from errors.
        end note

    usecase UC21: Scale to Users 
}

actor user --> UC01 : authenticates via username/password or OAuth providers
user --> UC03 : connects accounts
user --> UC06 : views transactions
advisor --> UC09, UC15 

banking_api <<-- UC03  
investment_api <<-- UC07  

UC04 ..> UC21: includes (system scaling)  
UC08 --|> UC18: generalizes to advanced reports

@enduml