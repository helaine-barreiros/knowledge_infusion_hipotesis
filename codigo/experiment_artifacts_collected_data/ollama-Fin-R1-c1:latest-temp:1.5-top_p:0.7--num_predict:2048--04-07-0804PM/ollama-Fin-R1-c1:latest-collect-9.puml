@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Use Case Diagram"

actor IndividualCustomer as user [color CUSTOMER_COLOR]
actor Advisor as advisor [color CUSTOMER_COLOR]

package AuthenticationAndSecurity {
    usecase UC01: AuthenticateUser as uc_auth
        note right of uc_auth 
            **Req. ID:** FR01, NFR06  
            **Description:** User authentication via username/password or OAuth2 providers with optional multi-factor authentication.
        end note

    usecase UC02: ManageAccountSettings [color CUSTOMER_COLOR]
}

package FinancialAccountManagement {
    usecase UC03: ConnectFinancialAccounts as uc_connect [color SYSTEM_COLOR] 
        note right of uc_connect
            **Req. ID:** FR02  
            **Description:** Securely links external financial accounts using banking APIs.
        end note

    usecase UC04: ViewTransactions [color CUSTOMER_COLOR]
    usecase UC05: CategorizeTransactions [color CUSTOMER_COLOR]

    uc_connect ..> uc_view : <<include>>
}

package AnalysisAndInsights {
    usecase UC06: ViewFinancialDashboard as uc_dashboard
    usecase UC07: ReceiveAIInsights [color SYSTEM_COLOR] 
        note right of uc_ai_insight  
            **Req. ID:** FR05, NFR12  
            **Description:** AI-powered financial insights based on user data.
        end note

    usecase UC08: ViewBasicReports as uc_basic_reports
    usecase UC09: ViewAdvancedAnalytics [color SYSTEM_COLOR] 
        uc_advanced_analytics --|> uc_basic_reports : <<generalization>>
}

package Planning {
    usecase UC10: SetFinancialGoals as uc_goals
    usecase UC11: MonitorBudgetsAndSpendingPatterns [color CUSTOMER_COLOR]
    
    note right of uc_budget_monitoring  
            **Req. ID:** FR07, FR08  
            **Description:** Users can create and track budgets.
        end note

}

package Collaboration {
    usecase UC12: ShareDataWithAdvisor as uc_share_data
}

package RiskManagement {
    usecase UC13: ReceiveRiskAssessments [color SYSTEM_COLOR] 
        note right of uc_risk_assessment  
            **Req. ID:** FR09, NFR14  
            **Description:** Real-time alerts for unusual transactions or risks.
        end note
}

package InvestmentRecommendations {
    usecase UC14: ReceiveInvestmentOpportunities as uc_inv_opps [color SYSTEM_COLOR] 
        note right of uc_inv_opps  
            **Req. ID:** FR10, NFR9  
            **Description:** Personalized investment recommendations based on user profile.
        end note
}

package DebtManagement {
    usecase UC15: ManageDebt as uc_debts [color CUSTOMER_COLOR] 
        note right of uc_debts  
            **Req. ID:** FR12, NFR06  
            **Description:** Repayment simulations and strategies.
        end note
}

package AIComponents {
    usecase UC16: LeverageAIEngine as uc_ai_engine [color SYSTEM_COLOR]
    
    usecase UC17: GenerateFinancialForecasts [color SYSTEM_COLOR] 
        note right of uc_forecast  
            **Req. ID:** FR10, NFR9  
            **Description:** Future financial position forecasts.
        end note
}

package ExternalSystems {
    usecase UC18: BankingAPI as bank_api [color EXTERNAL_SYSTEM_COLOR]
    
    usecase UC19: InvestmentAPI as inv_api [color EXTERNAL_SYSTEM_COLOR] 
    usecase UC20: CreditService as credit_service [color EXTERNAL_SYSTEM_COLOR]  
}

package UserInteraction {
    usecase UC21: ChatbotSupport forFinancialQueries as uc_chat_bot
        note right of uc_chat_bot  
            **Req. ID:** FR13, NFR06  
            **Description:** Interactive financial advisor via chat.
        end note

    usecase UC22: GeneratePeriodicReports [color CUSTOMER_COLOR] 
}

' ACTOR-USE CASE RELATIONSHIPS
user --> uc_auth
user --> uc_connect
advisor --> uc_goals
bank_api --> uc_connect : <<extend>>
ai_engine --> uc_ai_insight, uc_forecast

' INCLUDE/EXTEND RELATIONS
uc_view_transactions ..> uc_category : <<extend>>

@enduml