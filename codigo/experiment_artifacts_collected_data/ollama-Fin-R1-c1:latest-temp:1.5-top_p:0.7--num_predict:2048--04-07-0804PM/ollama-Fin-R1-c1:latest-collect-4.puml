@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Core Functionalities"
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

actor IndividualCustomer as user #08427B
actor Advisor as advisor #08427B
actor BankingAPI as bank #999999
actor InvestmentAPI as invest #999999
actor CreditService as credit #999999
actor NewsService as news #999999
actor AuthService as auth #999999
actor AIEngine as ai #1168BD

package "Authentication & Security" {
    usecase UC01: Authenticate User as uc_authenticateUser
        note right of uc_authenticateUser 
            **Req. ID:** FR01, NFR06  
            Allows users to log in via username/password or OAuth2 providers with optional multi-factor authentication.
        end note
}

package "Financial Account Management" {
    usecase UC03: Connect Financial Accounts as uc_connectAccounts
        note right of uc_connectAccounts 
            **Req. ID:** FR02  
            Securely links external financial accounts using banking APIs to retrieve transaction data.
        end note
    
    usecase UC04: View Transactions as uc_viewTransactions
        note right of uc_viewTransactions 
            **Req. ID:** FR03, FR19  
            Displays a list of transactions from connected bank accounts with categorization options.
        end note
        
    usecase UC05: Categorize Transactions as uc_categorizeTransactions <<extend>> uc_viewTransactions
        note right of uc_categorizeTransactions 
            **Description:** Allows further breakdown and labeling of transaction categories.  
        end note
}

package "Financial Visualization" {
    usecase UC12: Generate Financial Dashboard as uc_generateDashboard
        note right of uc_generateDashboard 
            **Req. ID:** FR04, FR09  
            Creates visual representations (e.g., pie charts) to show spending patterns and financial history.
        end note
        
    usecase UC13: Create Budgets as uc_createBudgets <<extend>> uc_viewTransactions
        note right of uc_createBudgets 
            **Description:** Enables users to set up monthly budgets for specific categories.  
        end note
}

package "AI-Driven Insights" {
    usecase UC07: Receive AI Insights as uc_aiInsights
        note right of uc_aiInsights 
            **Req. ID:** FR05, NFR13  
            Provides personalized spending recommendations based on transaction data and user goals.
        end note
        
    usecase UC20: Personalized Financial Recommendations as uc_recommendations <<extend>> uc_aiInsights
        note right of uc_recommendations 
            **Description:** Suggests investment opportunities or debt management strategies.  
        end note
}

package "Goal Management" {
    usecase UC14: Set Financial Goals as uc_setGoals
        note right of uc_setGoals 
            **Req. ID:** FR07, NFR08  
            Allows users to define and track short-term and long-term financial objectives.
        end note
        
    usecase UC15: Track Progress towards Goals <<extend>> uc_setGoals
        note right of uc_trackProgress 
            **Description:** Monitors progress against set goals with real-time updates.  
        end note
}

package "Risk Management" {
    usecase UC08: Forecast Financial Positions as uc_forecastPositions
        note right of uc_forecastPositions 
            **Req. ID:** FR10, NFR04  
            Predicts future financial scenarios based on historical data and current trends.
        end note
        
    usecase UC23: Stress Test Investments <<extend>> uc_forecastPositions
        note right of uc_stressTestInvestments 
            **Description:** Evaluates the impact of market fluctuations or economic downturns.  
        end note
}

package "Collaboration & Sharing" {
    usecase UC16: Share Financial Data with Advisors as uc_shareDataWithAdvisors <<extend>> uc_connectAccounts
        note right of uc_shareDataWithAdvisors 
            **Description:** Facilitates secure sharing of aggregated financial data for professional review.  
        end note
}

package "Notifications & Alerts" {
    usecase UC17: Receive Financial Alerts as uc_receiveAlerts
        note right of uc_receiveAlerts 
            **Req. ID:** FR09, NFR04  
            Sends notifications about unusual spending or missed payments to keep users informed.
        end note
        
    usecase UC25: Custom Alert Settings <<extend>> uc_receiveAlerts
        note right of uc_customSettings 
            **Description:** Allows users to configure alert thresholds and frequencies.  
        end note
}

package "AI Engine" {
    usecase UC18: Leverage AI for Analysis as uc_aiAnalysis
        note right of uc_aiAnalysis 
            **Req. ID:** FR05, NFR13  
            Uses machine learning models to analyze spending patterns and suggest improvements.
        end note
        
    usecase UC26: Generate Explanations <<extend>> uc_aiAnalysis
        note right of uc_generateExplanations 
            **Description:** Provides detailed reasoning behind AI-generated recommendations.  
        end note
}

' Relationships between packages (e.g., include/extend)
uc_authenticateUser --> AuthService as auth

uc_connectAccounts ..> UC12 : <<include>>  ' Financial Dashboard uses transaction data from accounts.
UC04 ..> uc_categorizeTransactions : <<extend>>

uc_generateDashboard --> BankingAPI as bank
uc_aiInsights --> AIEngine as ai

advisor --> UC18, UC26  
bank --> UC03  

' Cross-package relationships (e.g., user flows)
user --> UC01, UC03, UC14 
advisor --> UC15, UC20 

@enduml