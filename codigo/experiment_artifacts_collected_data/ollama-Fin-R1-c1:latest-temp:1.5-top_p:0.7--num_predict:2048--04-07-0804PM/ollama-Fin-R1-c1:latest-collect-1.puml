@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Enhanced Personal Financial Management System - Use Cases"

actor IndividualCustomer as user #CUSTOMER_COLOR
actor FinancialAdvisor as advisor #CUSTOMER_COLOR
actor BankingSystem as bank #EXTERNAL_SYSTEM_COLOR
actor InvestmentSystem as invest #EXTERNAL_SYSTEM_COLOR
actor AIEngine as ai #SYSTEM_COLOR

package Authentication & Security {
    usecase UC01: Authenticate User as uc_authenticateUser
        note right of uc_authenticateUser
            **Req. ID:** FR01, NFR06  
            **Description:** Allows users to authenticate via username/password or OAuth2 providers with optional multi-factor authentication.
        end note
}

package FinancialAccountManagement {
    usecase UC03: Connect Financial Accounts as uc_connectAccounts
        note right of uc_connectAccounts
            **Req. ID:** FR02  
            **Description:** Securely links external financial accounts using banking APIs to retrieve transaction data.
        end note
        
    usecase UC04: View Transactions as uc_viewTransactions
    usecase UC05: Categorize Transactions as uc_categorizeTransactions
    
    uc_connectAccounts ..> uc_viewTransactions : <<include>>
}

package Analysis & Insights {
    usecase UC06: View Financial Dashboard as uc_dashboard
    usecase UC07: Receive AI Insights as uc_aiInsights

    note right of uc_aiInsights
        **Req. ID:** FR05  
        **Description:** Provides personalized financial insights based on spending patterns and historical data.
    end note
    
    usecase UC08: View Basic Reports 
    usecase UC09: View Advanced Analytics 
    
    uc09 --|> uc08 : generalization
}

package Planning {
    usecase UC10: Set Financial Goals as uc_setGoals
        note right of uc_setGoals
            **Req. ID:** FR07  
            **Description:** Enables users to set and track specific financial goals.
        end note
        
    usecase UC11: Create Budgets as uc_createBudgets 
}

package Recommendations {
    usecase UC12: Generate Personalized Recommendations as uc_recommendations

    note right of uc_recommendations
        **Req. ID:** FR06  
        **Description:** Generates tailored financial advice based on user data and AI analysis.
    end note
    
    usecase UC13: Receive Investment Suggestions as uc_investmentSuggestions 
}

package Alerts {
    usecase UC14: Set Spending Limits as uc_setLimits
    usecase UC15: Receive Notifications for Unusual Activity as uc_notifications

    note right of uc_notifications
        **Req. ID:** FR09  
        **Description:** Sends alerts when spending exceeds predefined limits or patterns.
    end note
}

package Forecasting {
    usecase UC16: View Future Financial Projections as uc_projections 
    usecase UC17: Simulate Debt Repayments as uc_simDebtRepays

    note right of uc_projections
        **Req. ID:** FR10  
        **Description:** Predicts future financial positions using historical data.
    end note
}

package Collaboration {
    usecase UC18: Share Financial Data with Advisors as uc_shareData
    
    note right of uc_shareData
        **Req. ID:** FR13  
        **Description:** Allows users to share selected financial information securely with their advisors for collaborative planning.
    end note

    usecase UC19: Access AI-Generated Insights via Chatbot as uc_chatbotAccess
}

package AdvancedAnalytics {
    usecase UC20: Customize Dashboards and Reports as uc_customDashboards 
        note right of uc_customDashboards
            **Req. ID:** FR15  
            **Description:** Provides options to personalize dashboards and generate detailed financial reports.
        end note
        
    usecase UC21: Analyze Historical Transactions in Detail as uc_detailAnalysis

    ' Include relationships here if needed
}

package Cryptocurrency {
    usecase UC22: Track Crypto Portfolios as uc_trackCrypto 
        note right of uc_trackCrypto
            **Req. ID:** FR16  
            **Description:** Monitors and analyzes cryptocurrency holdings for users.
        end note
        
    usecase UC23: Perform Advanced Trading Analysis on Cryptos as uc_cryptoAnalysis

}

' Relationships between packages (cross-package)
uc_dashboard ..> uc_viewTransactions : <<include>>
uc_aiInsights --|> uc_recommendations
uc_setGoals --|> uc_createBudgets : generalization
uc_projections --|> uc_simDebtRepays : generalization
uc_customDashboards --> uc_trackCrypto

' Actor-use case relationships (actors and system)
user --> uc_authenticateUser 
user --> uc_connectAccounts  
user --> uc_dashboard  
advisor --> uc_setGoals  

bank --> uc_connectAccounts  
invest --> uc_investmentSuggestions 

ai --> uc_aiInsights  
advisor --> uc_recommendations
advisor --> uc_chatbotAccess

@enduml