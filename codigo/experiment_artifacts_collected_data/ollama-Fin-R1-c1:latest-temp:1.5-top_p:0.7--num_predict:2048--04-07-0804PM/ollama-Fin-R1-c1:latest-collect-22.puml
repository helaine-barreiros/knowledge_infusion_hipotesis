@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Enhanced Personal Financial Management System - Use Cases"

actor IndividualCustomer as user #08427B  
actor Advisor as advisor #153C9F  

package AuthenticationAndSecurity {
    usecase UC01_AuthenticateUser as uc_auth
        note right of uc_auth
            **Req. ID:** FR01, NFR06  
            **Description:** Allows users to authenticate via username/password or OAuth2 providers with optional multi-factor authentication.
        end note

    usecase UC02_ManageAccountSettings as uc_settings
}

package FinancialAccountManagement {
    usecase UC03_ConnectFinancialAccounts as uc_connect #1589BD  
        note right of uc_connect 
            **Req. ID:** FR02  
            **Description:** Securely links external financial accounts using banking APIs to retrieve transaction data.
        end note

    usecase UC04_ViewTransactions as uc_view_txns
    usecase UC05_CategorizeTransactions as uc_category
    
    uc_connect ..> uc_view_txns : <<include>>
}

package AnalysisAndInsights {
    usecase UC06_ViewFinancialDashboard as uc_dashboard #1D9BF7  
        note right of uc_dashboard 
            **Req. ID:** FR04, FR05  
            **Description:** Displays spending patterns and financial history with AI insights.
        end note

    usecase UC07_ReceiveAIPredictions as uc_ai_predictions
}

package Planning {
    usecase UC08_SetFinancialGoals as uc_goals #3B6C1D  
        note right of uc_goals 
            **Req. ID:** FR07, NFR02  
            **Description:** Helps users set and track financial goals.
        end note

    usecase UC09_BudgetManagement as uc_budget
}

package Collaboration {
    usecase UC10_ShareDataWithAdvisors as uc_share_data #8C5E4A  
        note right of uc_share_data 
            **Req. ID:** FR13, NFR02  
            **Description:** Allows users to share selected financial data with advisors.
        end note
}

package Recommendations {
    usecase UC11_PersonalizedRecommendations as uc_recommend #5F7A9B  
        note right of uc_recommend 
            **Req. ID:** FR06, NFR02  
            **Description:** Generates personalized financial recommendations based on user data.
        end note

    usecase UC12_DebtManagementStrategies as uc_debt_strat
}

package AIComponents {
    usecase UC13_AIReasoningEngine as uc_ai_reason #8E6C7B  
        note right of uc_ai_reason 
            **Req. ID:** FR05, NFR09  
            **Description:** Utilizes advanced financial reasoning and provides explanations for recommendations.
        end note
}

package ExternalServices {
    usecase UC14_BankAPIInteraction as uc_bank_api #C2D6EF  
        note right of uc_bank_api 
            **Req. ID:** FR03, NFR02  
            **Description:** Retrieves banking transactions and account info from secure APIs.
        end note

    usecase UC15_InvestmentAPIInteractions as uc_inv_api
}

user --> uc_auth  
user --> uc_connect  
advisor --> uc_goals  

uc_dashboard ..> uc_view_txns : <<include>>  
uc_ai_predictions ..> uc_recommend : <<extend>>

@enduml