@startuml "AI-Enhanced PFM System - Frontend Components"

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title "AI-Enhanced Personal Finance Management System - Frontend Components"

Person(customer, "Individual Customer", "A person who wants to manage their personal finances")
Person(advisor, "Financial Advisor", "Professional who provides financial advice")

System_Ext(backend_api, "PFM Backend API", "RESTful API providing all backend functionality")

System_Boundary(frontend_system, "Frontend System") {
    Container_Boundary(web_app_boundary, "Web Application") {
        Component(app_shell, "App Shell", "React, TypeScript", "Core application structure, routing, and layout")
        Component(auth_module, "Authentication Module", "React Context, TypeScript", "Manages authentication state and flows")
        Component(dashboard_module, "Dashboard Module", "React, TypeScript", "Main dashboard with financial overview")
        Component(transaction_module, "Transaction Module", "React, TypeScript", "Transaction listing, search, and categorization")
        Component(budget_module, "Budget Module", "React, TypeScript", "Budget creation, tracking, and visualization")
        Component(goal_module, "Goal Module", "React, TypeScript", "Financial goal setting and tracking")
        Component(insight_module, "Insight Module", "React, TypeScript", "AI-powered financial insights and recommendations")
        Component(ui_component_lib, "UI Component Library", "React, Styled Components", "Reusable UI components")
        Component(state_management, "State Management", "Redux Toolkit, RTK Query", "Global state and data fetching")
        Component(api_client, "API Client", "Axios, TypeScript", "API communication layer")
        Component(shared_hooks, "Shared Hooks", "React Hooks, TypeScript", "Custom React hooks for shared functionality")
        Component(shared_utils, "Shared Utilities", "TypeScript", "Common utility functions")
        Component(chart_components, "Chart Components", "D3.js, Chart.js", "Financial data visualization components")
    }
    
    Container_Boundary(mobile_app_boundary, "Mobile Application") {
        Component(mobile_app_shell, "Mobile App Shell", "React Native, TypeScript", "Core mobile application structure")
        Component(mobile_auth_module, "Mobile Auth Module", "React Context, Secure Storage", "Mobile authentication with biometrics")
        Component(mobile_dashboard, "Mobile Dashboard", "React Native, TypeScript", "Mobile optimized financial dashboard")
        Component(mobile_transaction_module, "Mobile Transaction Module", "React Native, TypeScript", "Mobile transaction management")
        Component(mobile_budget_module, "Mobile Budget Module", "React Native, TypeScript", "Mobile budget tracking")
        Component(mobile_goal_module, "Mobile Goal Module", "React Native, TypeScript", "Mobile goal tracking")
        Component(mobile_insight_module, "Mobile Insight Module", "React Native, TypeScript", "Mobile financial insights")
        Component(mobile_ui_components, "Mobile UI Components", "React Native, Styled Components", "Mobile UI component library")
        Component(mobile_state_mgmt, "Mobile State Management", "Redux, Redux Persist", "Mobile state with offline support")
        Component(mobile_api_client, "Mobile API Client", "Axios, TypeScript", "Mobile API communication with offline support")
        Component(mobile_hooks, "Mobile Hooks", "React Native Hooks", "Mobile-specific custom hooks")
        Component(mobile_utils, "Mobile Utilities", "TypeScript", "Mobile utility functions")
        Component(mobile_notification, "Notification Handler", "React Native, Firebase", "Push notification handling")
    }
    
    Container_Boundary(advisor_portal_boundary, "Advisor Portal") {
        Component(advisor_app_shell, "Advisor App Shell", "React, TypeScript", "Core advisor portal structure")
        Component(advisor_auth_module, "Advisor Auth Module", "React Context, TypeScript", "Advisor authentication")
        Component(client_list_module, "Client List Module", "React, TypeScript", "Client management and searching")
        Component(client_detail_module, "Client Detail Module", "React, TypeScript", "Detailed client financial information")
        Component(portfolio_analysis, "Portfolio Analysis Module", "React, TypeScript", "Client portfolio analysis tools")
        Component(recommendation_builder, "Recommendation Builder", "React, TypeScript", "Tools for creating recommendations")
        Component(advisor_ui_components, "Advisor UI Components", "React, Styled Components", "Specialized advisor UI components")
        Component(advisor_state_mgmt, "Advisor State Management", "Redux Toolkit", "Advisor portal state management")
        Component(advisor_api_client, "Advisor API Client", "Axios, TypeScript", "Advisor API communication")
        Component(advisor_shared, "Advisor Shared Utilities", "TypeScript", "Advisor-specific utilities")
        Component(advanced_charts, "Advanced Chart Components", "D3.js, TensorFlow.js", "Advanced financial visualization")
    }
}

' Web App internal relationships
Rel(app_shell, auth_module, "Uses")
Rel(app_shell, dashboard_module, "Renders")
Rel(app_shell, transaction_module, "Renders")
Rel(app_shell, budget_module, "Renders")
Rel(app_shell, goal_module, "Renders")
Rel(app_shell, insight_module, "Renders")

Rel(dashboard_module, ui_component_lib, "Uses")
Rel(dashboard_module, chart_components, "Uses")
Rel(dashboard_module, state_management, "Uses")
Rel(dashboard_module, shared_hooks, "Uses")

Rel(transaction_module, ui_component_lib, "Uses")
Rel(transaction_module, state_management, "Uses")
Rel(transaction_module, shared_hooks, "Uses")

Rel(budget_module, ui_component_lib, "Uses")
Rel(budget_module, chart_components, "Uses")
Rel(budget_module, state_management, "Uses")
Rel(budget_module, shared_hooks, "Uses")

Rel(goal_module, ui_component_lib, "Uses")
Rel(goal_module, chart_components, "Uses")
Rel(goal_module, state_management, "Uses")
Rel(goal_module, shared_hooks, "Uses")

Rel(insight_module, ui_component_lib, "Uses")
Rel(insight_module, chart_components, "Uses")
Rel(insight_module, state_management, "Uses")
Rel(insight_module, shared_hooks, "Uses")

Rel(state_management, api_client, "Uses")
Rel(api_client, backend_api, "Makes API calls to", "JSON/HTTPS")
Rel(shared_hooks, state_management, "Uses")
Rel(shared_hooks, shared_utils, "Uses")

' Mobile App internal relationships
Rel(mobile_app_shell, mobile_auth_module, "Uses")
Rel(mobile_app_shell, mobile_dashboard, "Renders")
Rel(mobile_app_shell, mobile_transaction_module, "Renders")
Rel(mobile_app_shell, mobile_budget_module, "Renders")
Rel(mobile_app_shell, mobile_goal_module, "Renders")
Rel(mobile_app_shell, mobile_insight_module, "Renders")

Rel(mobile_dashboard, mobile_ui_components, "Uses")
Rel(mobile_dashboard, mobile_state_mgmt, "Uses")
Rel(mobile_dashboard, mobile_hooks, "Uses")

Rel(mobile_transaction_module, mobile_ui_components, "Uses")
Rel(mobile_transaction_module, mobile_state_mgmt, "Uses")
Rel(mobile_transaction_module, mobile_hooks, "Uses")

Rel(mobile_budget_module, mobile_ui_components, "Uses")
Rel(mobile_budget_module, mobile_state_mgmt, "Uses")
Rel(mobile_budget_module, mobile_hooks, "Uses")

Rel(mobile_goal_module, mobile_ui_components, "Uses")
Rel(mobile_goal_module, mobile_state_mgmt, "Uses")
Rel(mobile_goal_module, mobile_hooks, "Uses")

Rel(mobile_insight_module, mobile_ui_components, "Uses")
Rel(mobile_insight_module, mobile_state_mgmt, "Uses")
Rel(mobile_insight_module, mobile_hooks, "Uses")

Rel(mobile_state_mgmt, mobile_api_client, "Uses")
Rel(mobile_api_client, backend_api, "Makes API calls to", "JSON/HTTPS")
Rel(mobile_hooks, mobile_state_mgmt, "Uses")
Rel(mobile_hooks, mobile_utils, "Uses")
Rel(mobile_notification, backend_api, "Receives notifications from", "Firebase/APNS")

' Advisor Portal internal relationships
Rel(advisor_app_shell, advisor_auth_module, "Uses")
Rel(advisor_app_shell, client_list_module, "Renders")
Rel(advisor_app_shell, client_detail_module, "Renders")
Rel(advisor_app_shell, portfolio_analysis, "Renders")
Rel(advisor_app_shell, recommendation_builder, "Renders")

Rel(client_list_module, advisor_ui_components, "Uses")
Rel(client_list_module, advisor_state_mgmt, "Uses")
Rel(client_list_module, advisor_shared, "Uses")

Rel(client_detail_module, advisor_ui_components, "Uses")
Rel(client_detail_module, advanced_charts, "Uses")
Rel(client_detail_module, advisor_state_mgmt, "Uses")
Rel(client_detail_module, advisor_shared, "Uses")

Rel(portfolio_analysis, advisor_ui_components, "Uses")
Rel(portfolio_analysis, advanced_charts, "Uses")
Rel(portfolio_analysis, advisor_state_mgmt, "Uses")
Rel(portfolio_analysis, advisor_shared, "Uses")

Rel(recommendation_builder, advisor_ui_components, "Uses")
Rel(recommendation_builder, advanced_charts, "Uses")
Rel(recommendation_builder, advisor_state_mgmt, "Uses")
Rel(recommendation_builder, advisor_shared, "Uses")

Rel(advisor_state_mgmt, advisor_api_client, "Uses")
Rel(advisor_api_client, backend_api, "Makes API calls to", "JSON/HTTPS")

' External relationships
Rel(customer, app_shell, "Uses via web browser")
Rel(customer, mobile_app_shell, "Uses via mobile device")
Rel(advisor, advisor_app_shell, "Uses via web browser")

@enduml