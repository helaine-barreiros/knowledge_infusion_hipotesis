@startuml "AI-Enhanced PFM System - Backend Components"

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title "AI-Enhanced Personal Finance Management System - Backend Components"

Person(customer, "Individual Customer", "A person who wants to manage their personal finances")

System_Boundary(api_client, "Frontend Clients") {
    Container(web_app, "Web Application", "React, TypeScript", "Provides the primary user interface")
    Container(mobile_app, "Mobile Application", "React Native", "Provides mobile functionality")
}

System_Boundary(pfm_backend, "AI-Enhanced PFM Backend System") {
    Container_Boundary(api_gateway_boundary, "API Gateway") {
        Component(route_handler, "Route Handler", "Spring Cloud Gateway", "Routes incoming requests to appropriate microservices")
        Component(auth_filter, "Authentication Filter", "Spring Security", "Validates JWT tokens and enforces authentication")
        Component(rate_limiter, "Rate Limiter", "Spring Cloud Gateway", "Enforces rate limiting policies")
        Component(api_documentation, "API Documentation", "SpringDoc OpenAPI", "Generates and serves API documentation")
    }
    
    Container_Boundary(auth_service_boundary, "Authentication Service") {
        Component(auth_controller, "Auth Controller", "Spring MVC RestController", "Exposes authentication endpoints")
        Component(auth_service, "Auth Service", "Spring Service", "Implements authentication business logic")
        Component(token_provider, "Token Provider", "JJWT Library", "Generates and validates JWT tokens")
        Component(oauth_client, "OAuth Client", "Spring OAuth2 Client", "Integrates with external auth providers")
        Component(password_encoder, "Password Encoder", "BCrypt", "Securely hashes and verifies passwords")
    }
    
    Container_Boundary(user_service_boundary, "User Service") {
        Component(user_controller, "User Controller", "Spring MVC RestController", "Exposes user management endpoints")
        Component(user_service_component, "User Service", "Spring Service", "Implements user management business logic")
        Component(user_repository, "User Repository", "Spring Data JPA", "Provides data access to user entities")
        Component(user_mapper, "User Mapper", "MapStruct", "Maps between DTO and domain entities")
        Component(user_validator, "User Validator", "Bean Validation", "Validates user data")
    }
    
    Container_Boundary(account_service_boundary, "Financial Account Service") {
        Component(account_controller, "Account Controller", "Spring MVC RestController", "Exposes account management endpoints")
        Component(account_service_component, "Account Service", "Spring Service", "Implements account business logic")
        Component(institution_client, "Institution Client", "WebClient", "Communicates with banking APIs")
        Component(account_repository, "Account Repository", "Spring Data MongoDB", "Provides data access to account entities")
        Component(credential_manager, "Credential Manager", "Spring Vault", "Securely manages financial institution credentials")
    }
    
    Container_Boundary(transaction_service_boundary, "Transaction Service") {
        Component(transaction_controller, "Transaction Controller", "Spring MVC RestController", "Exposes transaction endpoints")
        Component(transaction_service_component, "Transaction Service", "Spring Service", "Implements transaction business logic")
        Component(transaction_repository, "Transaction Repository", "Spring Data JPA", "Provides data access to transaction entities")
        Component(categorization_engine, "Categorization Engine", "Spring Service", "Categorizes transactions using rules and ML")
        Component(transaction_event_publisher, "Event Publisher", "Spring Kafka", "Publishes transaction events to Kafka")
    }
    
    Container_Boundary(analytics_service_boundary, "Analytics Service") {
        Component(analytics_controller, "Analytics Controller", "Spring MVC RestController", "Exposes analytics endpoints")
        Component(analytics_service_component, "Analytics Service", "Spring Service", "Implements analytics business logic")
        Component(analytics_repository, "Analytics Repository", "Spring Data JPA", "Provides data access for analytics results")
        Component(spending_analyzer, "Spending Analyzer", "Spring + Apache Spark", "Analyzes spending patterns")
        Component(trend_detector, "Trend Detector", "Spring + Apache Spark", "Identifies financial trends")
        Component(analytics_cache, "Analytics Cache", "Spring Cache + Redis", "Caches frequently accessed analytics results")
    }
    
    Container_Boundary(recommendation_service_boundary, "Recommendation Service") {
        Component(recommendation_controller, "Recommendation Controller", "Flask RestAPI", "Exposes recommendation endpoints")
        Component(recommendation_service_component, "Recommendation Service", "Python Service", "Implements recommendation business logic")
        Component(ml_models, "ML Models", "TensorFlow/PyTorch", "Trained machine learning models for recommendations")
        Component(model_trainer, "Model Trainer", "Python + TensorFlow", "Continuously trains and updates ML models")
        Component(feature_extractor, "Feature Extractor", "Python", "Extracts features for ML models")
    }
    
    ContainerDb(postgres_db, "PostgreSQL Database", "PostgreSQL, TimescaleDB", "Stores user profiles, transactions, goals, and budgets")
    ContainerDb(mongodb, "MongoDB Database", "MongoDB", "Stores account connections, report templates, and ML models metadata")
    ContainerDb(redis, "Redis Cluster", "Redis", "Caching, session data, real-time analytics")
    
    Container(kafka, "Apache Kafka", "Kafka", "Distributed event streaming platform")
}

System_Ext(banking_apis, "Banking APIs", "External banking data providers")
System_Ext(auth_provider, "Authentication Provider", "OAuth 2.0 identity providers")

' Relationships - external
Rel(customer, web_app, "Uses")
Rel(customer, mobile_app, "Uses")

Rel(web_app, route_handler, "Makes API calls to", "JSON/HTTPS")
Rel(mobile_app, route_handler, "Makes API calls to", "JSON/HTTPS")

' API Gateway relationships
Rel(route_handler, auth_filter, "Passes requests through")
Rel(route_handler, rate_limiter, "Applies rate limiting")
Rel(route_handler, auth_controller, "Routes auth requests to")
Rel(route_handler, user_controller, "Routes user requests to")
Rel(route_handler, account_controller, "Routes account requests to")
Rel(route_handler, transaction_controller, "Routes transaction requests to")
Rel(route_handler, analytics_controller, "Routes analytics requests to")
Rel(route_handler, recommendation_controller, "Routes recommendation requests to")

' Auth Service relationships
Rel(auth_controller, auth_service, "Uses")
Rel(auth_service, token_provider, "Uses")
Rel(auth_service, oauth_client, "Uses")
Rel(auth_service, password_encoder, "Uses")
Rel(oauth_client, auth_provider, "Authenticates with", "OAuth2/OIDC")

' User Service relationships
Rel(user_controller, user_service_component, "Uses")
Rel(user_service_component, user_repository, "Uses")
Rel(user_service_component, user_mapper, "Uses")
Rel(user_service_component, user_validator, "Uses")
Rel(user_repository, postgres_db, "Reads from and writes to", "JDBC")

' Account Service relationships
Rel(account_controller, account_service_component, "Uses")
Rel(account_service_component, institution_client, "Uses")
Rel(account_service_component, account_repository, "Uses")
Rel(account_service_component, credential_manager, "Uses")
Rel(institution_client, banking_apis, "Makes API calls to", "OAuth2/REST")
Rel(account_repository, mongodb, "Reads from and writes to", "MongoDB Driver")

' Transaction Service relationships
Rel(transaction_controller, transaction_service_component, "Uses")
Rel(transaction_service_component, transaction_repository, "Uses")
Rel(transaction_service_component, categorization_engine, "Uses")
Rel(transaction_service_component, transaction_event_publisher, "Uses")
Rel(transaction_repository, postgres_db, "Reads from and writes to", "JDBC")
Rel(transaction_event_publisher, kafka, "Publishes events to", "Kafka Protocol")

' Analytics Service relationships
Rel(analytics_controller, analytics_service_component, "Uses")
Rel(analytics_service_component, analytics_repository, "Uses")
Rel(analytics_service_component, spending_analyzer, "Uses")
Rel(analytics_service_component, trend_detector, "Uses")
Rel(analytics_service_component, analytics_cache, "Uses")
Rel(analytics_repository, postgres_db, "Reads from", "JDBC")
Rel(analytics_cache, redis, "Stores cache in", "Redis Protocol")

' Recommendation Service relationships
Rel(recommendation_controller, recommendation_service_component, "Uses")
Rel(recommendation_service_component, ml_models, "Uses")
Rel(recommendation_service_component, feature_extractor, "Uses")
Rel(model_trainer, ml_models, "Updates")
Rel(kafka, model_trainer, "Provides training data to")

@enduml