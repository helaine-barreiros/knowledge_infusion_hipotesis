@startuml
state "Start" as start <<start>>
state "Reservation" as reservation
state "Cancellation" as cancellation
state "Payment" as payment
state "Pricing" as pricing
state "Overbooking" as overbooking
state "VIP/Corporate" as vip
state "NoShow/CheckIn" as noshow
state "Extension" as extension
state "Maintenance Hold" as maintenance
state "Refund" as refund
state "Policy Enforcement" as policyEnforcement

[*] --> start

start --> reservation : Initiate Reservation
reservation --> payment : Make Payment
payment --> [*] : Successful Payment
payment --> refund : Payment Error

reservation --> cancellation : Guest Cancellation
cancellation --> [*] : Process Refund

reservation --> noshow : No Show
noshow --> refund : Process NoShow Refund

reservation --> overbooking : Overbooking Detected
overbooking --> refund : Resolve Overbooking

vip -> reservation : VIP/Corporate Reservation
vip -> payment : Handle VIP Payment

reservation --> extension : Request Extension
extension --> pricing : Calculate Price

reservation --> refund : Issue Refund
refund --> [*] : Refund Processed

reservation --> policyEnforcement : Apply Policies
policyEnforcement --> [*] : Policies Applied

reservation --> maintenance : Maintenance Hold
maintenance --> refund : Handle Reassignment

pricing --> [*] : Dynamic Pricing Applied
extension --> [*] : Extension Processed

policyEnforcement --> manualOverride : Manual Override
manualOverride --> [*] : Override Applied

@enduml