@startuml

[*] --> StartTriage

state StartTriage {
    [*] --> GatherBasicInfo
    GatherBasicInfo --> DetermineChiefComplaint
    DetermineChiefComplaint --> AssessVitalSigns
}

state AssessVitalSigns {
    [*] --> CheckBreathing
    CheckBreathing --> CheckCirculation
    CheckCirculation --> CheckDisability
    CheckDisability --> DeterminePriority
}

DeterminePriority --> Red : Life Threatening
DeterminePriority --> Orange : Very Urgent
DeterminePriority --> Yellow : Urgent
DeterminePriority --> Green : Standard
DeterminePriority --> Blue : Non-Urgent

state DeterminePriority {
    [*] --> EvaluateLifeThreatening
    EvaluateLifeThreatening --> Red : True
    EvaluateLifeThreatening --> EvaluateSevereConditions : False
    
    EvaluateSevereConditions --> Orange : True
    EvaluateSevereConditions --> EvaluateModerateConditions : False

    EvaluateModerateConditions --> Yellow : True
    EvaluateModerateConditions --> EvaluateMinorConditions : False

    EvaluateMinorConditions --> Green : True
    EvaluateMinorConditions --> Blue : False
}

Red --> [*]
Orange --> [*]
Yellow --> [*]
Green --> [*]
Blue --> [*]

@enduml