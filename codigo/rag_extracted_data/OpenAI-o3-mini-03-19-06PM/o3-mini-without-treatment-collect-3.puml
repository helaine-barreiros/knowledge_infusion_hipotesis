@startuml
[*] --> BeginTriage

state BeginTriage {
  [*] --> CollectInformation
  CollectInformation --> AssessSymptoms: Information Collected

  state AssessSymptoms {
    [*] --> LevelOneAssessment
    LevelOneAssessment --> LevelTwoAssessment: Critical Symptoms Identified
    LevelOneAssessment --> AssignPriority: Non-Critical Symptoms Identified
    LevelTwoAssessment --> AssignPriority: Further Evaluation Completed
  }

  AssignPriority --> AllocateResources: Priority Level Assigned
}

AllocateResources --> BeginTreatment: Resources Allocated
BeginTreatment --> [*]
@enduml