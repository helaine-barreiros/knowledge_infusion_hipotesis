@startuml

state PatientTriage {
    [*] --> InitialAssessment

    state InitialAssessment {
        [*] --> CheckVitalSigns
        CheckVitalSigns --> CollectSymptoms
        CollectSymptoms --> DetermineClinicalPriority
    }

    state DetermineClinicalPriority {
        [*] --> Category1: "Life-Threatening"
        DetermineClinicalPriority --> Category1: "Severe symptoms"
        DetermineClinicalPriority --> Category2: "High-Risk"
        DetermineClinicalPriority --> Category3: "Urgent"
        DetermineClinicalPriority --> Category4: "Standard"
        DetermineClinicalPriority --> Category5: "Non-Urgent"
    }

    Category1 --> ImmediateResponse: "Assign immediate care"
    Category2 --> UrgentResponse: "Quick handling required"
    Category3 --> StandardResponse: "Prioritize as urgent"
    Category4 --> NormalResponse: "Routine procedure"
    Category5 --> ScheduledResponse: "Can wait"

    ImmediateResponse --> EndTriage
    UrgentResponse --> EndTriage
    StandardResponse --> EndTriage
    NormalResponse --> EndTriage
    ScheduledResponse --> EndTriage

    EndTriage --> [*]
}

@enduml