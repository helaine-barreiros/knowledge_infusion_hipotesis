@startuml
state "General Reservation Policies" as GRP {
  state "Reservation Types" as RT {
    [*] --> Standard
    [*] --> NonRefundable
    [*] --> VIPCorporate
  }
  
  state "Reservation Validity" as RV {
    [*] --> PendingConfirmation
    PendingConfirmation --> [*] : No action for 1 hour
    
    [*] --> AwaitingPayment
    AwaitingPayment --> [*] : No payment w/in deadline
    
    [*] --> NoShow
    NoShow --> [*] : Checkin missed by 24h
  }
}

state "Cancellation Policies" as CP {
  state "Guest Initiated" as GIC {
    [*] --> TimingGT48h
    [*] --> Timing24_48h
    [*] --> TimingLT24h
    [*] --> NonRefundableBooking
  }
  
  state "Hotel Initiated" as HIC {
    [*] --> Overbooking
    [*] --> MaintenanceHold
    [*] --> PolicyViolation
  }
}

state "Payment Policies" as PP {
  state "Payment Deadlines" as PD {
    [*] --> Standard : 24 hours
    [*] --> NonRefundable : 24 hours
    [*] --> VIPCorporate : 72 hours
  }
  
  state "Payment Failure Handling" as PFH {
    [*] --> FailedPayments
    FailedPayments --> Cancelled : After retries
    [*] --> PaymentErrors
  }
}

state "Dynamic Pricing Policy" as DPP {
  state "Price Adjustment Rules" as PAR {
    [*] --> BasePrice
    BasePrice --> Extensions : Uses dynamic rates
    
    [*] --> Discounts
  }
  
  state "Price Lock Guarantee" as PLG {
    [*] --> Locked
  }
}

state "Overbooking Policies" as OP {
  state "Resolution" as OR {
    [*] --> PrioritizationHierarchy
  }
  
  state "Guest Response" as GR {
    [*] --> ResponseDeadline
    ResponseDeadline --> Cancelled : No response
  }
}

state "VIP/Corporate Policies" as VCP {
  state "Key Exceptions" as KE {
    [*] --> CancellationDeadline
    [*] --> PaymentWindow
    [*] --> NoShowPenalty
    [*] --> Overbooking
  }
  
  state "Dedicated Support" as DS {
    [*] --> ConciergeService
  }
}

state "NoShow & CheckIn Policies" as NC {
  state "NoShow Penalties" as NSP {
    [*] --> StandardGuests
    [*] --> VIPGuests
  }
  
  state "CheckIn Window" as CIW {
    [*] --> CheckInDeadline
    CheckInDeadline --> HeldUntil12PM
  }
}

state "Extension Policies" as EP {
  state "Extension Request Rules" as ERR {
    [*] --> Eligibility
    [*] --> AvailabilityCheck
  }
  
  state "Extension Deadline" as ED {
    [*] --> SubmitBefore24h
  }
}

state "Maintenance Hold Policies" as MHP {
  state "Room Reassignment" as RR {
    [*] --> AutoReassign
  }
  
  state "Refund Eligibility" as RE {
    [*] --> FullRefund
  }
}

state "Refund Processing" as RP {
  state "Refund Timeline" as RT {
    [*] --> CardRefund
    [*] --> BankTransfer
  }
  
  state "Refund Method" as RM {
    [*] --> OriginalPaymentMethod
  }
}

state "Policy Enforcement" as PE {
  [*] --> AutomatedEnforcement
  [*] --> ManualOverride
}

GRP -> CP
CP -> PP
PP -> DPP
DPP -> OP
OP -> VCP
VCP -> NC
NC -> EP
EP -> MHP
MHP -> RP
RP -> PE
@enduml