@startuml
state GeneralReservationPolicies {
  [*] --> ReservationTypes
  state ReservationTypes {
    [*] --> StandardReservation
    StandardReservation --> NonRefundableReservation
    NonRefundableReservation --> VIPCorporateReservation
    VIPCorporateReservation --> [*]
  }
  ReservationTypes -> ReservationValidity : Confirmed

  state ReservationValidity {
    [*] --> PendingConfirmation
    PendingConfirmation --> Expired : No action
    AwaitingPayment --> Expired : 24h/72h elapsed
    NoShow --> Expired : 24h elapsed post-arrival
  }
  ReservationValidity --> [*]
}

state CancellationPolicies {
  [*] --> GuestInitiatedCancellation
  GuestInitiatedCancellation : >48h before checkin\n100% refund
  GuestInitiatedCancellation : 24–48h before checkin\n50% refund
  GuestInitiatedCancellation : <24h before checkin\n0% refund
  GuestInitiatedCancellation : NonRefundable booking\n0% refund
  GuestInitiatedCancellation --> HotelInitiatedCancellation
  HotelInitiatedCancellation : Full refund\nOverbooking
  HotelInitiatedCancellation : Maintenance Hold
  HotelInitiatedCancellation : Policy Violation
  HotelInitiatedCancellation --> [*]
}

state PaymentPolicies {
  [*] --> PaymentDeadlines
  state PaymentDeadlines {
    Standard --> NonRefundable : 24h window
    NonRefundable --> VIPCorporate : 72h window
    VIPCorporate --> [*]
  }
  PaymentDeadlines -> PaymentFailureHandling
  state PaymentFailureHandling {
    [*] --> RetryAttempts
    RetryAttempts : Standard = 2 retries\nVIP = 3 retries\nNonRefundable = 0 retries
    RetryAttempts --> Cancelled : After failures
    Cancelled --> [*]
  }
}

state DynamicPricingPolicy {
  [*] --> PriceAdjustmentRules
  PriceAdjustmentRules : BasePrice, Extension\n10% Peak Surcharge
  PriceAdjustmentRules --> PriceLockGuarantee
  PriceLockGuarantee : Prices locked after payment
  PriceAdjustmentRules --> [*]
}

state OverbookingPolicies {
  [*] --> OverbookingResolution
  OverbookingResolution : Priority Hierarchy\n1. Loyalty Members\n2. Early Bookings\n3. Room Tiers
  OverbookingResolution --> CompensationOptions
  CompensationOptions : Upgrade, Partner Hotel, 20% Refund
  CompensationOptions --> [*]
  OverbookingResolution -> GuestResponseDeadline
  GuestResponseDeadline : 6h response window\nCancel if no reply
  GuestResponseDeadline --> Cancelled
}

state VIPCorporatePolicies {
  [*] --> KeyExceptions
  KeyExceptions : Cancellation, Payment\nNoShow, Overbooking
  KeyExceptions --> DedicatedSupport
  DedicatedSupport : Concierge, Priority Notifications
  DedicatedSupport --> [*]
}

state NoShowCheckInPolicies {
  [*] --> NoShowPenalties
  NoShowPenalties : Standard: Forfeited\nVIP: 25% refund
  NoShowPenalties --> CheckInWindow
  CheckInWindow : Check-in by 2:00 PM\nLate CheckIn until next day noon
  CheckInWindow --> [*]
}

state ExtensionPolicies {
  [*] --> RequestRules
  RequestRules : InUse state\nCheck availability
  RequestRules -> PriceAdjustment
  PriceAdjustment : Dynamic pricing rules apply
  RequestRules --> Deadline
  Deadline : 24h before checkout
  Deadline --> [*]
}

state MaintenanceHoldPolicies {
  [*] --> RoomReassignment
  RoomReassignment : Auto reassign or upgrade
  RoomReassignment --> RefundEligibility
  RefundEligibility : Full refund + 10% discount
  RefundEligibility --> [*]
}

state RefundProcessing {
  [*] --> RefundTimeline
  RefundTimeline : Credit = 3-5 days\nBank = 5-7 days
  RefundTimeline --> RefundMethod
  RefundMethod : Original payment method
  RefundMethod --> [*]
}

state PolicyEnforcement {
  [*] --> AutomatedEnforcement
  AutomatedEnforcement : Auto-cancel, Auto-state
  AutomatedEnforcement --> ManualOverride
  ManualOverride : Exceptional overrides
  ManualOverride --> [*]
}

GeneralReservationPolicies --> CancellationPolicies
CancellationPolicies --> PaymentPolicies
PaymentPolicies --> DynamicPricingPolicy
DynamicPricingPolicy --> OverbookingPolicies
OverbookingPolicies --> VIPCorporatePolicies
VIPCorporatePolicies --> NoShowCheckInPolicies
NoShowCheckInPolicies --> ExtensionPolicies
ExtensionPolicies --> MaintenanceHoldPolicies
MaintenanceHoldPolicies --> RefundProcessing
RefundProcessing --> PolicyEnforcement
PolicyEnforcement --> [*]
@enduml