@startuml
[*] --> Evaluate_Symptoms

Evaluate_Symptoms -> Determine_Urgency : Based on symptoms

state Determine_Urgency {
    [*] --> Immediate
    [*] --> Very_Urgent
    [*] --> Urgent
    [*] --> Standard
    [*] --> Non_Urgent

    Immediate : Life-threatening
    Very_Urgent : Serious condition
    Urgent : Potentially serious
    Standard : Less serious condition
    Non_Urgent : Minor issue
}

Determine_Urgency --> Assign_Priority

state Assign_Priority {
    [*] --> Assign_Immediate : For Immediate
    [*] --> Assign_Very_Urgent : For Very_Urgent
    [*] --> Assign_Urgent : For Urgent
    [*] --> Assign_Standard : For Standard
    [*] --> Assign_Non_Urgent : For Non_Urgent

    Assign_Immediate : Priority 1
    Assign_Very_Urgent : Priority 2
    Assign_Urgent : Priority 3
    Assign_Standard : Priority 4
    Assign_Non_Urgent : Priority 5
}

Assign_Priority --> [*]
@enduml