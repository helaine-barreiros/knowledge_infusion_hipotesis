@startuml
[*] --> ReservationStart

state ReservationStart {
  [*] --> PendingConfirmation : Booking Made
  PendingConfirmation --> AwaitingPayment : Confirmed
  PendingConfirmation --> Expired : No action within 1 hour
  AwaitingPayment --> CancellationPhase : No payment within deadline
  AwaitingPayment --> ActiveReservation : Payment received
}

state ActiveReservation {
  [*] --> InUse : Check-in
  InUse --> NoShow : 24h post arrival, no check-in
  InUse --> ExtensionPhase : Request extension
  ExtensionPhase --> InUse : Extension granted
  InUse --> Completed : Checkout
  Completed --> [*]
}

state CancellationPhase {
  [*] --> GuestInitiatedCancellation : Guest cancels reservation
  [*] --> HotelInitiatedCancellation : Hotel cancels reservation
  GuestInitiatedCancellation --> RefundProcess : Determine refund based on timing
  HotelInitiatedCancellation --> RefundProcess : Issue full refund
  RefundProcess --> Cancelled : Refund processed
  Cancelled --> [*]
}

state ExtensionPhase {
  state ExtensionsEligibility {
    [*] --> CheckAvailability : Extension request made
    CheckAvailability --> PriceAdjustment : Room available
    CheckAvailability --> Denied : Room unavailable
    PriceAdjustment --> Granted : Payment received
    Denied --> [*]
    Granted --> [*]
  }
}

state NoShow {
  [*] --> PenaltyAssessment : No-show
  PenaltyAssessment --> Expired : Apply penalty
  Expired --> [*]
}

state MaintenanceHold {
  [*] --> ReassignRoom : Room under maintenance
  ReassignRoom --> Notification : Notify guest
  ReassignRoom --> RefundProcess : No reassignment possible
  Notification --> [*]
}

state RefundProcess {
  [*] --> ProcessRefund : Initiate refund
  ProcessRefund --> CompletedRefund : Refund completed
  CompletedRefund --> [*]
}

state PaymentProcess {
  [*] --> ProcessPayment : Awaiting payment
  ProcessPayment --> PaymentSuccessful : Payment received
  ProcessPayment --> PaymentFailed : Payment failed, retries exhausted
  PaymentFailed --> CancellationPhase
}

state OverbookingPolicies {
  [*] --> PrioritizationHierarchy : Room overbooked
  PrioritizationHierarchy --> CompensationOptions : Priority applicable
  CompensationOptions --> Resolve : Offer solution
  Resolve --> CancellationPhase : No response
}

state PolicyEnforcement {
  [*] --> AutomatedEnforcement : Triggered by events
  [*] --> ManualOverride : Exceptional cases
  AutomatedEnforcement --> StateTransition : Apply rules
  ManualOverride --> StateTransition : Override

  StateTransition --> [*]
}

state VIPCorporatePolicy {
  [*] --> CustomRules : Apply VIP/Corporate policies
  CustomRules --> SpecializedHandling : Concierge service
  SpecializedHandling --> [*]
}

ReservationStart --> PolicyEnforcement
ReservationStart --> VIPCorporatePolicy
VIPCorporatePolicy --> ActiveReservation
PolicyEnforcement --> ActiveReservation
PolicyEnforcement --> CancellationPhase
@enduml