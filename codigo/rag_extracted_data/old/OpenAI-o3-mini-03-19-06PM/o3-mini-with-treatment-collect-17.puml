@startuml
state "Start" as start <<start>>
state "Reservation Type" as reservationType <<choice>>
state "Reservation Validity Check" as validityCheck <<choice>>
state "Payment" as payment <<fork>>
state "Cancellation" as cancellation
state "Refund Processing" as refundProcessing
state "Dynamic Pricing" as dynamicPricing <<choice>>
state "Overbooking" as overbooking
state "VIP/Corporate Policies" as vipPolicies
state "NoShow Policy" as noshowPolicy
state "Extension Request" as extensionRequest
state "Maintenance Hold" as maintenanceHold
state "Policy Enforcement" as policyEnforcement
state expired <<end>>

[*] --> start : Begin process

start --> reservationType : Define reservation

reservationType --> standard : Std. Reservation
reservationType --> nonRefundable : NonRefundable
reservationType --> vipCorporate : VIP/Corporate

standard --> validityCheck : Payment required in 24h
nonRefundable --> validityCheck : Discount, no cancel/refund
vipCorporate --> validityCheck : Custom rules

validityCheck --> payment : If valid
validityCheck --> expired : Pending confirm >1h

payment --> [*] : Payment successful
payment --> cancellation : Payment failed

cancellation --> refundProcessing : Initiate Guest Cancel
cancellation --> refundProcessing : Initiate Hotel Cancel

cancellation --> expired : No refund (NonRefundable)

refundProcessing --> policyEnforcement : Process refund
refundProcessing --> [*] : No refund

dynamicPricing --> [*] : Lock price on payment
dynamicPricing --> [*] : Adjust price for extensions

overbooking --> vipPolicies : Reassign or compensate
overbooking --> refundProcessing : Full refund for inability

vipPolicies --> [*] : Execute VIP rules

noshowPolicy --> expired : Std guest, no refund
noshowPolicy --> refundProcessing : VIP partial refund

extensionRequest --> dynamicPricing : Validate availability and adjust price
extensionRequest --> [*] : Extension denied

maintenanceHold --> refundProcessing : Reassign or full refund
maintenanceHold --> [*] : Assign new room

policyEnforcement --> [*] : System applies rules
policyEnforcement --> [*] : Manual override where needed

@enduml