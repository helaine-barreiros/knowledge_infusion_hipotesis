@startuml
state start <<start>>
state end <<end>>

[*] --> GeneralReservationPolicies
GeneralReservationPolicies : 1. General Reservation Policies
GeneralReservationPolicies --> ReservationTypes
GeneralReservationPolicies --> ReservationValidity

state ReservationTypes {
  StandardReservation : Requires payment within 24 hours
  NonRefundableReservation : Discounted rate, no refund eligibility
  VIPCorporateReservation : Follows custom rules (see Section 5)
}

state ReservationValidity {
  PendingConfirmation : Expires in 1 hour
  AwaitingPayment : Expires if not paid
  NoShow : Missed check-in by 24 hours
  AwaitingPayment --> Cancelled : by payment deadline
  NoShow --> Expired : 24 hours post arrival
}

[*] --> CancellationPolicies
CancellationPolicies : 2. Cancellation Policies
CancellationPolicies --> GuestInitiatedCancellation
CancellationPolicies --> HotelInitiatedCancellation

state GuestInitiatedCancellation {
  : >48h before; Refund 100%
  : 24-48h before; Refund 50%
  : <24h before; Refund 0%; 
  : NonRefundable; Refund 0%
}

state HotelInitiatedCancellation {
  : Overbooking
  : Maintenance Hold
  : Policy Violation
  HotelInitiatedCancellation --> FullRefund
}

state PaymentPolicies {
  state PaymentDeadlines {
    : Standard; Payment in 24 hours, 2 retries
    : NonRefundable; Payment in 24 hours, 0 retries
    : VIPCorporate; Payment in 72 hours, 3 retries
  }
  
  state PaymentFailureHandling {
    : Retries based on reservation type
    [*] --> Cancelled : After final failure
  }
}

[*] --> DynamicPricingPolicy
DynamicPricingPolicy : 4. Dynamic Pricing Policy
DynamicPricingPolicy --> PriceAdjustmentRules
DynamicPricingPolicy --> PriceLockGuarantee
PriceAdjustmentRules : Base determined by room, season, demand

[*] --> OverbookingPolicies
OverbookingPolicies : 5. Overbooking Policies
OverbookingPolicies --> OverbookingResolution
OverbookingPolicies --> GuestResponseDeadline
OverbookingResolution : Prioritize loyalty, early, higher tier

[*] --> VIPCorporatePolicies
VIPCorporatePolicies : 6. VIP/Corporate Policies
VIPCorporatePolicies --> KeyExceptions
VIPCorporatePolicies --> DedicatedSupport

[*] --> NoShowCheckInPolicies
NoShowCheckInPolicies : 7. NoShow & CheckIn Policies
NoShowCheckInPolicies --> NoShowPenalties
NoShowCheckInPolicies --> CheckInWindow
NoShowPenalties : Standard; forfeits, No refund, VIP; 25% refund

[*] --> ExtensionPolicies
ExtensionPolicies : 8. Extension Policies
ExtensionPolicies --> ExtensionRequestRules
ExtensionPolicies --> ExtensionDeadline
ExtensionRequestRules : Eligibility during InUse state

[*] --> MaintenanceHoldPolicies
MaintenanceHoldPolicies : 9. Maintenance Hold Policies
MaintenanceHoldPolicies --> RoomReassignment
MaintenanceHoldPolicies --> RefundEligibility

[*] --> RefundProcessing
RefundProcessing : 10. Refund Processing
RefundProcessing --> RefundTimeline
RefundProcessing --> RefundMethod

[*] --> PolicyEnforcement
PolicyEnforcement : 11. Policy Enforcement
PolicyEnforcement --> AutomatedEnforcement
PolicyEnforcement --> ManualOverride

ReservationValidity --> PaymentPolicies : Waiting for payment
PaymentPolicies --> ReservationValidity : Payment complete
OverbookingPolicies --> end : Resolved with compensation
VIPCorporatePolicies --> DynamicPricingPolicy : Custom rules
GuestInitiatedCancellation --> RefundProcessing : Refunding
HotelInitiatedCancellation --> RefundProcessing : Refunding
RefundProcessing --> end : Process complete
@enduml