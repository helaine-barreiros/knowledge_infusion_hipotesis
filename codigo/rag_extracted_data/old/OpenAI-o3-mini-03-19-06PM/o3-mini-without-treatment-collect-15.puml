@startuml
[*] --> InitialAssessment

state InitialAssessment {
  [*] --> AssessPatient
  AssessPatient --> DetermineLifeThreats : vital signs
  DetermineLifeThreats --> ImmediateCare : Life threats detected
  DetermineLifeThreats --> DetermineUrgency : No life threats
}

state DetermineUrgency {
  [*] --> Red
  Red --> ImmediateCare : Critical condition
  Red --> Orange : Stable, but urgent

  Orange --> Yellow : Less urgent, can wait
  Orange --> Green : Minor injuries

  Yellow --> ReEvaluate : Monitoring required
  Yellow --> Green : Downgrade urgency

  Green --> RoutineCare : Non-urgent
}

InitialAssessment --> ImmediateCare : Urgent conditions identified
ImmediateCare --> [*]
RoutineCare --> [*]
ReEvaluate --> [*]

@enduml