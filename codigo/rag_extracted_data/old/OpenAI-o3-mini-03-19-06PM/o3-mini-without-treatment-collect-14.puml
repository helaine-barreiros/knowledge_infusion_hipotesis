@startuml
[*] --> Arrival
Arrival -> InitialAssessment : Patient Arrival
InitialAssessment --> ImmediateAttention : Life-threatening symptoms
InitialAssessment --> ClinicalAssessment : No immediate threat
ImmediateAttention --> [*] : Treated

ClinicalAssessment --> Category1 : Critical Conditions
ClinicalAssessment --> Category2 : Major Conditions
ClinicalAssessment --> Category3 : Moderate Conditions
ClinicalAssessment --> Category4 : Minor Injuries/Illness
ClinicalAssessment --> Category5 : Non-Urgent

Category1 --> ImmediateAttention
Category2 --> RapidAssessment
RapidAssessment --> [*] : Treated

Category3 --> StandardAssessment
StandardAssessment --> [*] : Treated

Category4 --> LessUrgentAssessment
LessUrgentAssessment --> [*] : Treated

Category5 --> NonUrgentCare
NonUrgentCare --> [*] : Treated
@enduml