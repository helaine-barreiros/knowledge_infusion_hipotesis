@startuml
state "Reservation" as Reservation {
  [*] --> InitialVerification : New Booking
  InitialVerification --> PendingConfirmation : Confirmed
  PendingConfirmation --> AwaitingPayment : Payment Required
  AwaitingPayment --> ValidReservation : Payment Received
  PendingConfirmation -left-> Expired : >1 hour without action
  AwaitingPayment -up-> Expired : No payment \n(24h standard, 72h VIP)
  [*] --> NoShow : >24h post-arrival
}

state "Cancellation" as Cancellation {
  [*] --> GuestInitiated : Guest Cancels
  GuestInitiated --> RefundProcessing : >48h before checkin
  GuestInitiated --> PartialRefund : 24-48h before checkin
  GuestInitiated --> NoRefund : <24h before checkin or NonRefundable
  GuestInitiated --> PolicyExceptions : Hotel-initiated issues
  
  PolicyExceptions --> RefundProcessing : Overbooking
  PolicyExceptions --> RefundProcessing : Maintenance
  PolicyExceptions --> RefundProcessing : Policy Violation
}

state "Payment" as Payment {
  [*] --> PaymentAttempt : Payment Required
  PaymentAttempt --> PaymentSuccessful : Successful
  PaymentAttempt --> PaymentFailed : Failed
  
  PaymentFailed --> Cancellation : Final attempt failed
  PaymentAttempt --> Retry : Retry Attempt
  PaymentSuccessful --> Reservation | Success
}

state "Pricing" as Pricing {
  [*] --> DynamicPricingUpdate : Base Price Adjustment
  DynamicPricingUpdate --> PriceLock : Payment Received
  
  DynamicPricingUpdate --> EarlyBirdDiscount : >30 days in advance
  DynamicPricingUpdate --> LastMinuteDiscount : <24h before checkin
  PriceLock --> [*]
}

state "Overbooking" as Overbooking {
  [*] --> ResolutionOffer : Guest Notified
  ResolutionOffer --> Compensation : Guest Accepts
  ResolutionOffer --> Cancellation : Guest Declines or No Response
}

state "VIPPolicies" as VIPPolicies {
  [*] --> CustomRules : VIP Booking
  CustomRules --> ConciergeService : Request Assistance
  CustomRules --> PriorityNotifications : Alert Sent
}

state "CheckIn" as CheckIn {
  [*] --> CheckInWindow : Scheduled Arrival
  CheckInWindow --> NoShow : Missed Checkin
  CheckInWindow --> RoomInUse : Checked In
  RoomInUse --> ExtensionRequest : Guest Extends Stay
}

state "Maintenance" as Maintenance {
  [*] --> RoomUnavailability : Maintenance Issue
  RoomUnavailability --> RoomReassignment : Reassign Room
  RoomUnavailability --> RefundIssued : No Equivalent Room Available
}

state "Refund" as Refund {
  [*] --> Processing : Refund Initiated
  Processing --> Timeline : Card \n3-5 days, Bank \n5-7 days
  Processing --> Method : Original \nPayment Method
}

[*] --> Reservation
Reservation --> Cancellation : User Action
Reservation --> Payment : Needs Payment
Reservation --> Pricing : Price Rules
Reservation --> Overbooking : Potential \nOverbooking
VIPPolicies --> Reservation
CheckIn --> Maintenance : Room Issues
Refund --> Reservation
@enduml