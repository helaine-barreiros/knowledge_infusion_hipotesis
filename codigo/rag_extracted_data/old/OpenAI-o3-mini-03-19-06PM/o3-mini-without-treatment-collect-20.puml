@startuml

[*] --> InitialAssessment

state InitialAssessment {
  [*] --> CheckConsciousness
  CheckConsciousness --> Conscious : is conscious
  CheckConsciousness --> Unconscious : is unconscious
  
  state Conscious {
    CheckAirway --> Normal : airway clear
    CheckAirway --> Obstructed : airway not clear
  }
  
  state Unconscious {
    CheckBreathing --> Breathing : breathing present
    CheckBreathing --> NotBreathing : no breathing
  }
  
  state Normal {
    [*] --> CheckCirculation
  }
  
  state Breathing {
    [*] --> CheckCirculation
  }
  
  state CheckCirculation {
    CheckCirculation --> Stable : circulation stable
    CheckCirculation --> Unstable : circulation unstable
  }
  
  Unstable --> EmergencyIntervention
  Obstructed --> EmergencyIntervention
  NotBreathing --> EmergencyIntervention
}

EmergencyIntervention --> End

Stable --> FurtherAssessment
FurtherAssessment --> End

state FurtherAssessment {
  [*] --> PrimarySurvey
  PrimarySurvey --> HistoryTaking
  HistoryTaking --> SecondarySurvey
  SecondarySurvey --> DecisionMaking
}

state DecisionMaking {
  DecisionMaking --> HighPriority : high priority condition
  DecisionMaking --> MediumPriority : medium priority condition
  DecisionMaking --> LowPriority : low priority condition
}

HighPriority --> End
MediumPriority --> End
LowPriority --> End

@enduml