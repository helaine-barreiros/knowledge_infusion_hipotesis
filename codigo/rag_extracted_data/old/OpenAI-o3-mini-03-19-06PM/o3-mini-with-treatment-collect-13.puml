@startuml
state start <<start>>
state ConfirmReservation
state MakePayment
state ReservationExpired
state CheckinNoShow
state CancellationWindow
state CancellationComplete
state PaymentDeadlinePassed
state PaymentRetry
state PaymentFailed
state RefundProcessing
state RefundComplete
state OverbookingResolution
state OverbookingResolved
state PriceAdjustment
state RoomReassignment

[*] --> ConfirmReservation : Start reservation

state "Reservation Type" as ReservationTypeState {
  [*] --> StandardReservation
  StandardReservation : Requires payment within 24 hours
  
  [*] --> NonRefundableReservation
  NonRefundableReservation : No cancellation/refund eligibility
  
  [*] --> VIPCorporateReservation
  VIPCorporateReservation : Custom rules apply
}

ConfirmReservation --> ReservationTypeState : Choose reservation type

state "Reservation Status" as ReservationStatus {
  [*] --> PendingConfirmation
  PendingConfirmation : Reservation not confirmed, expires in 1 hour
  
  [*] --> AwaitingPayment
  AwaitingPayment : Awaiting payment, expires in 24/72 hours
  
  [*] --> NoShow
  NoShow : Checkin missed by 24 hours post-arrival
  
  [*] --> Expired
  Expired : No action taken, reservation expired
  
  [*] --> InUse
  InUse : Reservation currently in use
  
  [*] --> Cancelled
  Cancelled : Reservation has been cancelled
}

ReservationTypeState --> ReservationStatus : Determine reservation status

state "Cancellation Process" as CancellationProcess {
  [*] --> GuestInitiatedCancellation : Guest requests cancellation
  GuestInitiatedCancellation --> CancellationWindow : Evaluate timing for refund
  CancellationWindow --> CancellationComplete : Process refund, cancellation fee
}

ReservationStatus --> CancellationProcess : Initiate cancellation

state "Payment Process" as PaymentProcess {
  [*] --> MakePayment : Initiate payment process
  MakePayment --> PaymentDeadlinePassed : Payment deadline passed
  PaymentDeadlinePassed --> PaymentRetry : Retry payment based on policy
  PaymentRetry --> PaymentFailed : All payment retries failed
  PaymentFailed --> Cancelled
  MakePayment --> RefundProcessing : Payment error, refund required
  RefundProcessing --> RefundComplete : Refund completed
}

ReservationStatus --> PaymentProcess : Initiate payment 

[*] --> CheckinNoShow : Arrive at checkin
ReservationStatus --> CheckinNoShow : Checkin status checked
CheckinNoShow --> Expired : No show penalty applied

[*] --> OverbookingResolution : Resolve overbooking
OverbookingResolution --> OverbookingResolved : Overbooking resolved

[*] --> PriceAdjustment : Request extension
PriceAdjustment --> UpdatedRate : Dynamic pricing applied

state "Maintenance" as Maintenance {
  [*] --> RoomReassignment : Attempt room reassignment
  RoomReassignment --> RefundProcessing : Reassignment failed, process refund
}

[*] --> Maintenance : Room under maintenance

state "VIP/Corporate Handling" as VIPCorporate {
  [*] --> ConciergeService : VIP assistance
}

[*] --> VIPCorporate : VIP policies enforced

state "Policy Enforcement" as PolicyEnforcement {
  [*] --> AutomatedEnforcement : System applies rules automatically
  ManualOverride : Staff can override for exceptions
}

[*] --> PolicyEnforcement : Enforce policies
@enduml