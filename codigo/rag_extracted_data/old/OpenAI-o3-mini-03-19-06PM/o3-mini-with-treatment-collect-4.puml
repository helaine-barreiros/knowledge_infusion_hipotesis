@startuml
state startReservation <<start>>
state choiceReservationType <<choice>>
state choiceCancellationPolicy <<choice>>
state choicePaymentHandling <<choice>>
state choiceDynamicPricing <<choice>>
state choiceOverbookingResolution <<choice>>
state choiceVIPPolicies <<choice>>
state choiceNoShow <<choice>>
state choiceCheckIn <<choice>>
state choiceExtensionRequest <<choice>>
state choiceMaintenanceHold <<choice>>
state choiceRefundProcessing <<choice>>

[*] --> choiceReservationType

// Reservation Policy Flow
choiceReservationType --> standardReservation: Standard
choiceReservationType --> nonRefundableReservation: NonRefundable
choiceReservationType --> vipReservation: VIP/Corporate

standardReservation --> choiceCancellationPolicy
nonRefundableReservation --> choiceCancellationPolicy
vipReservation --> choiceCancellationPolicy

// Cancellation Policy Flow
choiceCancellationPolicy --> guestInitiatedCancellation: Guest-Initiated
choiceCancellationPolicy --> hotelInitiatedCancellation: Hotel-Initiated

guestInitiatedCancellation --> choicePaymentHandling
hotelInitiatedCancellation --> choicePaymentHandling

// Payment Handling Flow
choicePaymentHandling --> paymentSuccess: Payment Success
choicePaymentHandling --> paymentFailure: Payment Failure

paymentSuccess --> choiceDynamicPricing
paymentFailure --> cancelledReservation

// Dynamic Pricing Policy Flow
choiceDynamicPricing --> priceLocked: Payment Received
choiceDynamicPricing --> adjustPrice: Price Adjustment

priceLocked --> choiceCheckIn
adjustPrice --> choiceCheckIn

// CheckIn Policy Flow
choiceCheckIn --> checkedIn: Check-In by 2:00 PM
choiceCheckIn --> noShow: No Show for 24 Hours

checkedIn --> choiceExtensionRequest
noShow --> choiceNoShow

// No Show Handling
choiceNoShow --> noShowPenaltyStandard: Standard Penalty
choiceNoShow --> noShowPenaltyVIP: VIP Penalty

noShowPenaltyStandard --> expiredReservation
noShowPenaltyVIP --> partialRefundVIP

// Extension Request Flow
choiceExtensionRequest --> extensionApproved: Request Approved
choiceExtensionRequest --> extensionDenied: Request Denied

extensionApproved --> choiceDynamicPricing
extensionDenied --> choiceCheckIn

// Maintenance Hold Flow
choiceMaintenanceHold --> reassignedRoom: Room Reassigned
choiceMaintenanceHold --> refundAndDiscount: Full Refund + Discount

reassignedRoom --> choiceCheckIn
refundAndDiscount --> expiredReservation

// Refund Processing Flow
choiceRefundProcessing --> refundCreditDebit: Credit/Debit Refund
choiceRefundProcessing --> refundBankTransfer: Bank Transfer Refund

refundCreditDebit --> expiredReservation
refundBankTransfer --> expiredReservation

// VIP and Overbooking Policies
choiceVIPPolicies --> vipCancellation: VIP Cancellation Rules
choiceVIPPolicies --> vipNoShow: VIP No Show Penalties

choiceOverbookingResolution --> overbookUpgrade: Free Upgrade
choiceOverbookingResolution --> overbookPartnerHotel: Partner Hotel
choiceOverbookingResolution --> compensationPackage: Compensation Package

vipCancellation --> choicePaymentHandling
vipNoShow --> partialRefundVIP

overbookUpgrade --> choiceCheckIn
overbookPartnerHotel --> choiceCheckIn
compensationPackage --> choiceRefundProcessing

expiredReservation --> [*]
@enduml