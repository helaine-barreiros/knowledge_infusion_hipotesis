@startuml "AI-Enhanced Personal Finance Management System - Overview"

left to right direction
skinparam packageStyle rectangle

' Atores principais
actor "Individual Customer" as customer
actor "Financial Advisor" as advisor
actor "External Services" as external
actor "AI Engine" as aiEngine

' Sistema modular
rectangle "AI-Enhanced Personal Finance Management System" {
  package "Integration Module" as integration
  package "Authentication & Security" as auth
  package "Financial Analysis" as analysis
  package "Visualization" as viz
  package "Chatbot" as chatbot
  package "AI & Insights" as insights
  package "Financial Planning" as planning
  package "Monitoring & Reporting" as reporting
  package "Collaboration" as collab
  package "Financial Education" as education
}

' Relações principais
customer -- integration
customer -- auth
customer -- analysis
customer -- viz
customer -- chatbot
customer -- insights
customer -- planning
customer -- reporting
customer -- collab
customer -- education

advisor -- auth
advisor -- viz
advisor -- collab

external -- integration
external -- auth

aiEngine -- analysis
aiEngine -- chatbot
aiEngine -- insights
aiEngine -- planning
aiEngine -- reporting

@enduml