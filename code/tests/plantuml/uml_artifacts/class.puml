@startuml
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam packageFontStyle bold
skinparam packageBorderColor black
skinparam packageBackgroundColor white

package "Stacks" {
  class AttackerStack {
    attackerType : list
    attackDifferential : dictionary
    attackModifier : list
    currentRound : int
    ---
    attack()
    capture()
    applyWounds()
    updateCombatRating()
    updateModifiers()
  }
  
  class DefenderStack {
    defenderType : list
    defenseDifferential : dictionary
    defenseModifier : list
    ---
    retaliate()
    breakOff()
    inactive()
    applyWounds()
    updateCombatRating()
  }
  
  note right of DefenderStack
    Character Combat and Dependencies
    Authors: Sean Harris and Ranger Adams
    Edited By Greg Donaldson
    Reviewed by Justin Hall & E. Thompson
  end note
}

package "Units" {
  class Creatures {
    combatShift : int
    breakOffModifier : int
    bonusDrawModifier : int
    ---
    getSpecial()
  }
  
  class MilitaryUnit {
    type : string
    name : string
    combat : int
    endurance : int
    environType : string
    effectiveCombatRating : int
    wounds : int
    allegiance : string (Rebel or Imperial)
  }
  
  class IrateLocals {
    type : string
    name : string
    combat : int
    endurance : int
    bonusDraws : int
    attackType : string
    effectiveCombatRating : int
    wounds : int
    ---
    getType()
  }
  
  Creatures <|-- IrateLocals
}

class Mission {
  name : string
  type : char
  description : string
  ---
  actionEventCheck()
}

class MissionGroupStack {
  effectiveCombatRating : int
  currentMission : char
  bonusDraws : list
}

class MissionDeck {
  availableMissions : list
  ---
  updateMissionDeck()
}

class Character {
  name : string
  title : string
  combat : int
  endurance : int
  intelligence : int
  leadership : int
  diplomacy : int
  navigation : int
  homePlanet : string
  effectiveCombatRating : int
  wounds : int
  leader : boolean
  detected : boolean
  captured : boolean
  active : boolean
  bonusDraws : list
  allegiance : string (Rebel or Imperial)
}

package "PossessionInfo" {
  class PossessionDeck {
    availablePossessions : list
    ---
    updatePossessionDeck()
  }
  
  class Possession {
    name : string
    type : str
    description : str
    attackModifier : int
    damageModifier : int
    bonusDrawModifier : int
    ---
    removeWounds()
    repairCheck()
  }
  
  class Companion {
    name : string
    combatBonus : int
    intelligenceBonus : int
    diplomacyBonus : int
    navigationBonus : int
    special : list
    ---
    getSpecial()
  }
  
  class Ship {
    name : string
    cannons : int
    shields : int
    maneuver : int
    maxPassengers : int
  }
}

' Relationships
Mission -right-> MissionGroupStack : "Can Effect ▼"
Mission -down-> Creatures : "Can Create ▼"
Mission -down-> MilitaryUnit : "Can Create"
Mission -down-> Character : "Can Create"
MissionDeck <- MissionGroupStack : "◀ Selects"

AttackerStack -down-> Mission : "◀ Assigned"
DefenderStack <-left- "Attacks ►" AttackerStack
AttackerStack -right-> MissionGroupStack
DefenderStack -right-> MissionGroupStack
Character -up-> MissionDeck
Character -up-> MilitaryUnit
Character -right-> Possession : "◀ Assigned"
Possession -right-> Companion
Possession -right-> Ship

MilitaryUnit -right-> Character
IrateLocals -up-> Character
@enduml