@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
  
  rectangle "Client System" {
    usecase "SFR02: Generate Client Dashboards" as SFR02
    usecase "SFR03: Deliver Personalized Recommendations" as SFR03
    
    C --> SFR02
    C --> SFR03
  }
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004
  
  rectangle "Financial Advisor System" {
    usecase "SFR05: Request Predictive Intervention Analyses" as SFR05
    
    FA --> SFR05
  }
}

package "System Administrator" {
  actor SysAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  
  SA --> SAFR001
  
  rectangle "System Admin System" {
    usecase "SFR20: Manage User Feedback" as SFR20
    
    SA --> SFR20
  }
}

package "AI System" {
  actor AI as AIF
  
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Based on Strategies" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  AI --> AIFR001
  AI --> AIFR002
  AI --> AIFR003
  AI --> AIFR004
  AI --> AIFR005
  AI --> AIFR006
  AI --> AIFR007
  AI --> AIFR008
  AI --> AIFR009
  
  rectangle "AI System" {
    usecase "SFR12: Generate Client Dashboards" as SFR12
    usecase "SFR13: Deliver Client Alerts Based on Conditions" as SFR13
    usecase "SFR14: Generate Client Analytics" as SFR14
    usecase "SFR16: Request Predictive Insights from AI Component" as SFR16
    
    AIF --> SFR12
    AIF --> SFR13
    AIF --> SFR14
    AIF --> SFR16
  }
}

package "System Components" {
  usecase "SFR08: Request Contextualized News Insights from AI Component" as SFR08
  
  rectangle "News Processing System" {
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    
    C --> SFR08
    FA --> SFR08
    SA --> SFR08
    AI --> AIFR007
  }
}

package "Feedback System" {
  usecase "CFR11: Send Feedback about Recommendations and Insights" as CFR11
  
  rectangle "User Feedback Management" {
    usecase "SFR20: Manage User Feedback to Improve Outputs" as SFR20
    
    C --> CFR11
    FA --> CFR11
    SA --> CFR11
    AIF --> CFR11
    
    CFR11 --> SFR20
  }
}

@enduml