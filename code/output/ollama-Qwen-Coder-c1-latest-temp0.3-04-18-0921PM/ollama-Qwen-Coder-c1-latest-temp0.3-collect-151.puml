@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR002
}

package SystemAdmin {
  actor "System Administrator" as SAFR003
}

rectangle "User Interface" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  
  CFR001 --> CFR009
  FAFR002 --> CFR009
  SAFR003 --> CFR009
}

package FinancialInsights {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR005: Manage Analysis Parameters" as SAFR005
  
  CFR001 <|-- SAFR005
  FAFR002 --> SAFR005
}

package Alerts {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  
  CFR002 <|-- SFR001
  FAFR002 --> SFR001
}

package Recommendations {
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  
  CFR004 <|-- SFR002
  FAFR002 --> SFR002
}

package PredictiveAnalytics {
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "CFR003: View Financial Predictions" as CFR003
  
  CFR003 <|-- SFR003
}

package InvestmentOpportunities {
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "CFR012: View Investment Opportunities Suitable to My Risk Profile" as CFR012
  
  CFR012 <|-- SFR006
}

package News {
  usecase "SFR008: Request Contextualized News from AI Component" as SFR008
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  
  CFR008 <|-- SFR008
}

package Feedback {
  usecase "CFR11: Send Feedback about System's Recommendations and Insights" as CFR11
  
  CFR004 --> CFR11
  FAFR002 --> CFR11
  SAFR003 --> CFR11
}
@enduml