@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  
  Client --> (CFR001)
  SysAdmin --> (SAFR001)
  FinancialAdvisor --> (FAFR002)
}

rectangle "Client Dashboard Features" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR010: Manage Relationship with Advisors" as CFR010
  
  Client --> (CFR009)
  Client --> (CFR010)
}

rectangle "Financial Insights Features" {
  usecase "SAFR002: View Predictive Analytics" as SAFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  
  System --> (SAFR002)
  Client --> (SFR003)
}

rectangle "Recommendations and Alerts Features" {
  usecase "CFR004: View Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "SAFR001: Configure Analysis Parameters for Clients" as SAFR003
  
  Client --> (CFR004)
  Client --> (CFR005)
  SysAdmin --> (SAFR003)
}

rectangle "Spending Limits and Alerts Features" {
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "SFR005: Request Spending Limit Alerts" as SFR005
  
  System --> (CFR006)
  Client --> (SFR005)
}

rectangle "Investment Opportunities Features" {
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
  
  System --> (CFR007)
  Client --> (SFR006)
}

rectangle "News and Information Features" {
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "SFR013: Generate Client Alerts Based on Conditions" as SFR013
  
  System --> (CFR008)
  Client --> (SFR013)
}

rectangle "Feedback and Improvement Features" {
  usecase "CFR011: Send Feedback about Recommendations" as CFR011
  usecase "AIFR009: Generate Predictive Intervention Insights" as AIFR009
  
  Client --> (CFR011)
  System --> (AIFR009)
}

@enduml