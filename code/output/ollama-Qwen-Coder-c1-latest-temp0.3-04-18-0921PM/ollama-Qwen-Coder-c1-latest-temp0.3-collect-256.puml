@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FAFR

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  User --> CFR001
  SysAdmin --> SAFR001
  FAFR --> FAFR002
  System --> (SFR003)
  System --> (AIFR004)
}

rectangle "Client Dashboard" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  
  User --> CFR009
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "SFR004: Request Personalized Recommendations" as SFR004
  
  Financial Advisor --> (FAFR001)
  System --> (FAFR003)
  System --> (SFR004)
}

rectangle "System Functions" {
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR005: Generate Investment Opportunities for Users" as AIFR005
  
  System --> (SFR002)
  System --> (AIFR005)
}

rectangle "Alerts and Notifications" {
  usecase "SFR013: Request Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR016: Generate Predictive Insights for Financial Guidance" as SFR016
  
  System --> (SFR013)
  System --> (SFR016)
}

rectangle "Feedback Management" {
  usecase "CFR011: Send Feedback about Recommendations and Insights" as CFR011
  
  User --> CFR011
}
@enduml