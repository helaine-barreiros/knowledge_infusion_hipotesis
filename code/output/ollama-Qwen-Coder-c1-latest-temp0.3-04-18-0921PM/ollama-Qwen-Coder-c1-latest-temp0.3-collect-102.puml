@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  
  Client --> CFR001
  Client --> SAFR001
  SysAdmin --> SAFR001
  FAFD --> FAFR002
}

rectangle "Client Dashboard" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  
  Client --> CFR009
}

rectangle "Alerts and Notifications" {
  usecase "SFR013: Generate Client Alerts" as SFR013
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  
  System Admin --> SFR013
  Financial Advisor --> FAFR002
}

rectangle "Recommendations and Insights" {
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  Client --> SFR002
  Financial Advisor --> FAFR004
}

rectangle "Investment Opportunities and News" {
  usecase "CFR010: View Investment Opportunities" as CFR010
  usecase "SFR008: Find Contextualized News Relevant to User's Portfolio" as SFR008
  
  Client --> CFR010
}

rectangle "Client Relationship Management" {
  usecase "CFR012: Manage Relationship with Financial Advisors" as CFR012
  
  Client --> CFR012
}
@enduml