@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  
  Client --> CFR001
  SysAdmin --> SAFR001
  Financial Advisor --> (FAFR002)
}

rectangle "Client Features" {
  usecase "CFR002: View Alerts" as CFR002
  usecase "CFR003: View Predictions" as CFR003
  usecase "CFR004: Receive Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR010: Manage Financial Advisor Relationship" as CFR010
  
  Client --> (CFR002)
  Client --> (CFR003)
  Client --> (CFR004)
  Client --> (CFR005)
  Client --> (CFR006)
  Client --> (CFR010)
}

rectangle "Financial Advisor Features" {
  usecase "FAFR001: Manage Mentoring Sessions" as FAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  
  Financial Advisor --> (FAFR001)
  Financial Advisor --> (FAFR003)
}

rectangle "System Features" {
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  System Admin --> (SAFR001)
  Financial Advisor --> (FAFR003)
  
  Client --> (SFR002)
  FAFD --> (FAFR003)
}

rectangle "AI Features" {
  usecase "AIFR001: Generate Predictions" as AIFR001
  usecase "AIFR004: Generate Investment Opportunities" as AIFR004
  
  System Admin --> (SAFR001)
  
  Client --> (SFR002)
  FAFD --> (FAFR003)
}

rectangle "Feedback Loop" {
  usecase "CFR011: Send Feedback" as CFR011
  usecase "AIFR009: Generate Predictive Insights" as AIFR009
  
  Client --> (CFR011)
  FAFD --> (FAFR003)
}

@enduml