@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client) : as User
:System Admin : as SysAdmin
:Financial Advisor : as FAFR001

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  User --> CFR001
  SysAdmin --> SAFR001
  FAFR003 <|-- (SAFR001)
  
  User --> SFR002 : "View Alerts"
  System Admin --> SFR002 : "Manage Parameters"
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  Financial Advisor --> FAFR003 : "View Predictive Analytics"
  Financial Advisor --> FAFR004 : "Configure Client-Specific Parameters"
}

rectangle "Client Dashboard" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "SFR12: Generate Client Dashboards" as SFR12
  
  User --> CFR009
  System Admin --> SFR12 : "Manage Parameters"
}

rectangle "Investment Opportunities" {
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "SFR06: Request Investment Opportunity Analysis" as SFR06
  
  User --> CFR007
  System Admin --> SFR06 : "Manage Parameters"
}

rectangle "News and Analytics" {
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "SFR10: Request Contextualized News Insights" as SFR10
  
  User --> CFR008
  System Admin --> SFR10 : "Manage Parameters"
}

rectangle "Spending Limits and Alerts" {
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "SFR05: Request Spending Limit Alerts" as SFR05
  
  User --> CFR006
  System Admin --> SFR05 : "Manage Parameters"
}

rectangle "Feedback and Improvement" {
  usecase "CFR11: Send Feedback" as CFR11
  
  User --> CFR11
}
@enduml