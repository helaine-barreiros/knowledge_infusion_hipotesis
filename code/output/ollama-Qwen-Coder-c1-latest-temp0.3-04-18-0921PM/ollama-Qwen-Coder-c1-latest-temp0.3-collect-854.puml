@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR002
  usecase "CFR003: View Financial Predictions" as SAFR005
  usecase "CFR004: Receive Personalized Recommendations" as SAFR016
  usecase "CFR005: Manage Recommendation Preferences" as SAFR008
  usecase "CFR006: View Spending Limit Alerts" as SAFR023
  usecase "CFR007: View Investment Opportunities" as SAFR041
  usecase "CFR008: View News Related to Portfolio" as SAFR059
  usecase "CFR009: Access Personalized Dashboard" as SFR026
  usecase "CFR10: Manage Relationship with Financial Advisors" as SAFR047
  
  CFR001 --> SAFR002
  CFR001 --> SAFR005
  CFR001 --> SAFR016
  CFR001 --> SAFR008
  CFR001 --> SAFR023
  CFR001 --> SAFR041
  CFR001 --> SAFR059
  CFR001 --> SFR026
  CFR001 --> SAFR047
  
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts" as SAFR035
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as SAFR049
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as SAFR012
  
  FAFR001 --> SAFR035
  FAFR001 --> SAFR049
  FAFR001 --> SAFR012
  
}

package "System Administrator" {
  actor SystemAdministrator as SAFR001
  
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR037
  
  SAFR001 --> SAFR037
}

rectangle "AI Component" {
  package "Financial Insights & Predictions" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    
    CFR001 --> AIFR001
    FAFR001 --> AIFR001
    SAFR001 --> AIFR001
  }
  
  package "Personalized Recommendations" {
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    
    CFR001 --> AIFR002
    FAFR001 --> AIFR002
    SAFR001 --> AIFR002
  }
  
  package "Spending Limit Alerts" {
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    
    CFR001 --> AIFR003
    FAFR001 --> AIFR003
    SAFR001 --> AIFR003
  }
  
  package "Investment Opportunities Analysis" {
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    
    CFR001 --> AIFR004
    FAFR001 --> AIFR004
    SAFR001 --> AIFR004
  }
  
  package "Anomaly Transaction Alerts" {
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    
    CFR001 --> AIFR006
    FAFR001 --> AIFR006
    SAFR001 --> AIFR006
  }
  
  package "Contextualized News Insights" {
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    
    CFR001 --> AIFR007
    FAFR001 --> AIFR007
    SAFR001 --> AIFR007
  }
  
  package "Client Predictive Intervention Recommendations" {
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
    
    CFR001 --> AIFR008
    FAFR001 --> AIFR008
    SAFR001 --> AIFR008
  }
  
}

package "System Functions" {
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  
  CFR001 --> SFR002
  FAFR001 --> SFR002
  SAFR001 --> SFR002
  
}

package "User Feedback Management" {
  usecase "CFR11: Send Feedback about System Recommendations and Insights" as AIFR009
  
  CFR001 --> AIFR009
  FAFR001 --> AIFR009
  SAFR001 --> AIFR009
}

@enduml