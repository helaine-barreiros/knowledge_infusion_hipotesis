@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor (FA): as FA

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  
  Client --> (CFR001)
  SysAdmin --> (SAFR001)
}

rectangle "Financial Advisor System" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "SFR003: Deliver Predictive Analytics to Users" as SFR003
  
  FA --> (FAFR001)
}

rectangle "News System" {
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  usecase "AIFR007: Generate Contextualized News Insights by Correlating with User Portfolios" as AIFR007
  
  Client --> (SFR009)
}

rectangle "Alert System" {
  usecase "SFR013: Deliver Client Alerts Based on Predefined Conditions" as SFR013
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition" as AIFR006
  
  Client --> (SFR013)
}

rectangle "Dashboard System" {
  usecase "SFR12: Generate Client Dashboards that Present Financial Information in an Intuitive and Actionable Format" as SFR12
  usecase "AIFR008: Generate Predictive Intervention Recommendations by Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  
  Client --> (SFR12)
}

rectangle "Feedback System" {
  usecase "CFR011: Send Feedback about the System's Recommendations and Insights to Help Improve Future Outputs" as CFR011
  usecase "AIFR009: Generate Predictive Insights that Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009
  
  Client --> (CFR011)
}

@enduml