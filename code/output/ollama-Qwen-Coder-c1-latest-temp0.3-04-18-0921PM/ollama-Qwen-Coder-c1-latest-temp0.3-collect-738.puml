@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR002
}

package SystemAdmin {
  actor "System Administrator" as SAFR003
}

rectangle "User Interface" {
  usecase "CFR009: View Personalized Dashboard" as CFR009
  usecase "SFR12: Generate Client Dashboards" as SFR12
  
  CFR001 --> CFR009
  FAFR002 --> CFR009
}

rectangle "Alerts and Notifications" {
  usecase "SFR03: Deliver Alerts to Users" as SFR03
  usecase "SFR14: Generate Client Analytics" as SFR14
  
  SAFR003 --> SFR03
  FAFR002 --> SFR14
}

rectangle "Financial Insights and Predictions" {
  usecase "AIFR01: Generate Financial Predictions" as AIFR01
  usecase "SFR07: Request Specific Investment Opportunities from AI Component" as SFR07
  
  SAFR003 --> AIFR01
  FAFR002 --> AIFR01
}

rectangle "Personalized Recommendations and Insights" {
  usecase "AIFR02: Generate Personalized Recommendations for Users" as AIFR02
  usecase "SFR04: Request Personalized Recommendations from AI Component" as SFR04
  
  SAFR003 --> AIFR02
  FAFR002 --> AIFR02
}

rectangle "Spending Limits and Alerts" {
  usecase "AIFR03: Generate Spending Limit Alerts for Users" as AIFR03
  usecase "SFR05: Request Spending Limit Alerts from AI Component" as SFR05
  
  SAFR003 --> AIFR03
}

rectangle "Investment Opportunities and Analysis" {
  usecase "AIFR04: Generate Investment Opportunity Analyses for Users" as AIFR04
  usecase "SFR06: Request Investment Opportunity Analysis from AI Component" as SFR06
  
  SAFR003 --> AIFR04
}

rectangle "Anomaly Detection and Fraud Prevention" {
  usecase "AIFR05: Generate Anomaly Transaction Alerts for Users" as AIFR05
  usecase "SFR08: Request Anomaly Transaction Alerts from AI Component" as SFR08
  
  SAFR003 --> AIFR05
}

rectangle "News and Information" {
  usecase "AIFR07: Generate Contextualized News Insights for Users" as AIFR07
  usecase "SFR09: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR09
  
  SAFR003 --> AIFR07
}

rectangle "Predictive Interventions and Planning" {
  usecase "AIFR08: Generate Client Predictive Intervention Recommendations for Users" as AIFR08
  usecase "SFR15: Request Predictive Intervention Analyses from AI Component" as SFR15
  
  SAFR003 --> AIFR08
}

rectangle "Financial Health and Reporting" {
  usecase "AIFR09: Generate Client Predictive Insights for Users" as AIFR09
  usecase "SFR17: Generate Financial Health Reports that Assess Users' Overall Financial Wellbeing" as SFR17
  
  SAFR003 --> AIFR09
}

rectangle "Feedback and Improvement" {
  usecase "CFR11: Send Feedback about System's Recommendations and Insights" as CFR11
  
  CFR001 --> CFR11
  FAFR002 --> CFR11
  SAFR003 --> CFR11
}
@enduml