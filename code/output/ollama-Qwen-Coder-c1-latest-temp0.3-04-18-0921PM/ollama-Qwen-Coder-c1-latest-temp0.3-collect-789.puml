@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (View)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FA --> (Manage)
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase ("SFAFR005") as SFAFR005
  
  SA --> (Configure)
}

package "System" {
  rectangle "System Components" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase ("SFAFR006") as SFAFR006
    usecase ("SFAFR007") as SFAFR007
    usecase ("SFAFR008") as SFAFR008
    usecase "SFR009: Find Contextualized News" as SFR009
    usecase "SFR010: Process Contextualized News" as SFR010
    usecase ("SFAFR011") as SFAFR011
    usecase "SFR012: Generate Client Dashboards" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Conditions" as SFR013
    usecase ("SFAFR014") as SFAFR014
    usecase ("SFAFR015") as SFAFR015
    usecase ("SFAFR016") as SFAFR016
    usecase "SFR017: Generate Financial Health Reports" as SFR017
    usecase "SFR018: Manage Users' Financial Goals" as SFR018
    usecase "SFR019: Maintain Historical Record of Insights" as SFR019
    usecase ("SFAFR020") as SFAFR020
    
    C --> (Deliver)
  }
}

package "AI System" {
  rectangle "AI Components" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase ("AIFR002") as AIFR002
    usecase ("AIFR003") as AIFR003
    usecase ("AIFR004") as AIFR004
    usecase ("AIFR005") as AIFR005
    usecase ("AIFR006") as AIFR006
    usecase ("AIFR007") as AIFR007
    usecase ("AIFR008") as AIFR008
    usecase ("AIFR009") as AIFR009
    
    C --> (Generate)
  }
}

C -> CFR011 : "Send Feedback"
FA -> FAFR005 : "Configure Parameters"
SA -> SAFR002 : "Manage Alerts"

@enduml