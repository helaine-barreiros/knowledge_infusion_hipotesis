@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:User (Client, Financial Advisor, or System Administrator): as User

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFD002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> FAFD002
  User --> (Send Feedback about System Recommendations and Insights) : "CFR011"
}

rectangle "Client Dashboard" {
  usecase "SAFR005: Manage Personalized Recommendations Preferences" as SAFR005
  usecase "SFR017: Generate Financial Health Reports" as SFR017
  
  Client --> SAFR005
  Client --> SFR017
}

rectangle "Investment Opportunities" {
  usecase "CFR003: View Investment Predictions Based on Historical Data and Current Market Trends" as CFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFD004
  
  Client --> CFR003
  Financial Advisor --> (View Investment Opportunities Suitable to My Risk Profile) : "CFR007"
  Financial Advisor --> FAFD004
}

rectangle "Spending Limits and Alerts" {
  usecase "SAFR012: Generate Spending Limit Alerts for Users" as SAFR012
  
  Client --> (View Spending Limit Alerts When Exceed Predefined Thresholds in Specific Expense Categories) : "CFR006"
  Financial Advisor --> SAFR012
}

rectangle "News and Insights" {
  usecase "SFR008: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR008
  
  Client --> (View News Related to My Investment Portfolio) : "CFR008"
  System Admin --> SFR008
}

rectangle "Personal Recommendations and Insights" {
  usecase "SFR012: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance as Defined by Industry Standards Like FINRA Guidelines" as SFR012
  
  Client --> (Receive Personalized Recommendations Aligned with My Financial Profile and Goals) : "CFR004"
  System Admin --> SFR012
}

rectangle "System Operations" {
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR013
  
  SysAdmin --> (Deliver Personalized Recommendations to Users Based on Their Financial Profiles) : "SFR02"
}

@enduml