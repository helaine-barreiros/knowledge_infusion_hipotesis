@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR002
  usecase "CFR003: View Financial Predictions" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations" as SAFR004
  usecase "CFR005: Manage Recommendation Preferences" as SAFR005
  usecase "CFR006: View Spending Limit Alerts" as SAFR006
  usecase "CFR007: View Investment Opportunities" as SAFR007
  usecase "CFR008: View News Related to Portfolio" as SAFR008
  usecase "CFR009: Access Personalized Dashboard" as SAFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as SAFR10
  
  CFR001 --> SAFR002
  CFR001 --> SAFR003
  CFR001 --> SAFR004
  CFR001 --> SAFR005
  CFR001 --> SAFR006
  CFR001 --> SAFR007
  CFR001 --> SAFR008
  CFR001 --> SAFR009
  CFR001 --> SAFR10
  
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts" as SAFR007a
  usecase "FAFR003: View Predictive Analytics for Clients" as SAFR008a
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as SAFR15
  
  FAFR001 --> SAFR007a
  FAFR001 --> SAFR008a
  FAFR001 --> SAFR15
  
}

package System {
  actor "System Administrator" as CFR006
  
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as AIFR001a
  usecase "SFR004: Request Personalized Recommendations from AI Component" as AIFR002a
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as AIFR003a
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as AIFR004a
  usecase "SFR007: Request Specific Investment Opportunities from AI Component that Match User Criteria and ESG Preferences" as AIFR005a
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as AIFR006a
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR13a
  usecase "SFR010: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as AIFR07a
  usecase "SFR011: Request Contextualized News Insights from AI Component to Identify Potential Impacts on Users' Investments" as AIFR08a
  usecase "SFR012: Generate Client Dashboards that Present Financial Information in an Intuitive and Actionable Format" as SFR14a
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as AIFR09a
  usecase "SFR014: Generate Client Analytics That Provide Meaningful Insights into Financial Behavior and Performance" as SFR15a
  usecase "SFR015: Request Predictive Intervention Analyses from AI Component to Identify When Financial Advisors Should Engage with Clients" as AIFR10a
  usecase "SFR016: Request Predictive Insights From the AI Component to Enhance the Value of Financial Guidance Provided to Clients" as AIFR11a
  usecase "SFR017: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR16a
  usecase "SFR018: Manage Users' Financial Goals To Track Progress and Provide Relevant Recommendations" as AIFR12a
  usecase "SFR019: Maintain a Historical Record of Users' Insights to Enable Trend Analysis and Effectiveness Measurement" as SFR17a
  usecase "SFR020: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as AIFR13a
  
  CFR006 --> SFR002
  SAFR004 <|-- SFR002
  SAFR005 <|-- SFR002
  SAFR007 <|-- SFR002
  SAFR008 <|-- SFR002
  
}

package AI {
  actor "AI System" as AIFR01b
  
  usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as SFR005a
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR12b
  
  SAFR003 <|-- SFR005a
  SAFR006 <|-- AIFR12b
  
}

package User {
  actor "User (Client, Financial Advisor, or System Administrator)" as CFR011
  
  usecase "CFR011: Send Feedback about the System's Recommendations and Insights" as SFR020a
  
  SAFR004 <|-- SFR020a
  SAFR005 <|-- SFR020a
  SAFR006 <|-- SFR020a
  SAFR017 <|-- SFR020a
}

@enduml