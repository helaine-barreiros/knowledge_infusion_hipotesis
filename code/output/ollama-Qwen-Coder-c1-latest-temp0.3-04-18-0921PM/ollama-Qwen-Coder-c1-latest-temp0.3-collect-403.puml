@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
    usecase "CFR001: View Financial Insights Dashboard" as CFR001
    usecase "SAFR001: Manage Analysis Parameters" as SAFR001
    
    Client --> (SFR012) : Generate client dashboards that present financial information in an intuitive and actionable format.
    Client --> (CFR009) : Access a personalized dashboard that consolidates my financial information in a single view to efficiently monitor my finances.
    Client --> (SAFR005) : Manage my relationship with Financial Advisors, including permissions for sharing my financial data, to maintain privacy and control over my financial information.
    
    SysAdmin --> SAFR001
}

rectangle "Financial Advisor" {
    usecase "FAFR001: Manage client mentoring sessions based on system-generated insights" as FAFR001
    usecase "FAFR002: View client intervention alerts when the system detects patterns requiring professional attention to proactively assist clients with potential financial issues." as FAFR002
    
    Financial Advisor --> (SFR013) : Generate client alerts based on predefined conditions to ensure timely notification of important financial events.
    Financial Advisor --> (FAFR008) : View predictive intervention analyses from the AI component to identify when financial advisors should engage with clients.
}

rectangle "Client" {
    usecase "CFR002: Receive alerts about anomalous transactions in my accounts." as CFR002
    usecase "SAFR005: Manage personalized recommendations preferences to ensure the system provides insights relevant to my financial objectives and risk tolerance as defined in my KYC (Know Your Customer) profile." as SAFR005
    
    Client --> (SFR016) : Generate client predictive insights that provide forward-looking analysis of financial situations to support more effective financial planning.
}

rectangle "System" {
    usecase "SFR002: Deliver personalized recommendations to users based on their financial profiles to support better financial decision-making." as SFR002
    usecase "SFR003: Request financial predictions from the AI component to provide users with forward-looking financial insights." as SFR003
    
    System --> (AIFR001) : Generate financial predictions for users by analyzing historical transaction data, market trends, and economic indicators.
}

rectangle "AI" {
    usecase "AIFR002: Generate personalized recommendations for users based on their financial profiles, goals, and risk tolerance as defined by industry standards like FINRA guidelines." as AIFR002
    usecase "AIFR003: Generate spending limit alerts for users by identifying unusual deviations from established spending patterns." as AIFR003
    
    AI --> (SFR014) : Generate client analytics that provide meaningful insights into financial behavior and performance.
}

rectangle "System" {
    usecase "SFR007: Request investment opportunity analysis from the AI component to identify suitable investments for users based on their risk profiles." as SFR007
    
    System --> (AIFR004) : Generate investment opportunity analyses for users by evaluating potential investments against their risk profiles, time horizons, and financial goals.
}

rectangle "AI" {
    usecase "AIFR005: Generate investment opportunities for users by identifying financial instruments that align with their investment strategies and Modern Portfolio Theory principles." as AIFR005
    
    AI --> (SFR017) : Generate financial health reports that assess users' overall financial wellbeing according to standard financial ratios and metrics.
}

