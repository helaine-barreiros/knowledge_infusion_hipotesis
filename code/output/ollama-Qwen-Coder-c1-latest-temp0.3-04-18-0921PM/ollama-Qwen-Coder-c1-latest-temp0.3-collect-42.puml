@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Deliver Personalized Recommendations" as SFR003
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> (FAFR002)
  Sys --> (SFR003) : <<ID: SFR004>> "Deliver Personalized Recommendations"
}

rectangle "Client" {
  usecase "CFR002: View Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR012: Access Consolidated Financial Dashboard" as CFR012
  
  Client --> (CFR002)
  Client --> (CFR003)
  Client --> (CFR004)
  Client --> (CFR005)
  Client --> (CFR006)
  Client --> (CFR012)
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  
  FinancialAdvisor --> (FAFR001)
  FinancialAdvisor --> (FAFR003)
}

rectangle "System Components" {
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  Sys --> (SFR002) : <<ID: SFR005>> "Request Spending Limit Alerts"
  Sys --> (AIFR004)
}

rectangle "User Feedback Loop" {
  usecase "CFR11: Send System Recommendations and Insights Feedback" as CFR11
  
  Client --> (CFR11)
  FinancialAdvisor --> (CFR11)
  SysAdmin --> (CFR11)
}
@enduml