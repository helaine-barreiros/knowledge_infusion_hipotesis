@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as SAFR004
  usecase "SAFR005: Manage Personalized Recommendations Preferences" as SAFR005
  
  CFR001 --> (View Alerts about Anomalous Transactions)
  CFR001 --> (View Financial Predictions Based on Historical Data and Market Trends)
  CFR001 --> (Receive Personalized Recommendations Aligned with My Financial Profile and Goals)
  CFR001 --> SAFR005
}

package "Financial Advisor" {
  actor "Financial Advisor" as FAFR002
  
  usecase "FAFR003: View Predictive Analytics About Client's Financial Situations" as SAFR006
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as SAFR015
  
  CFR001 --> FAFR002 : (Manage Client Mentoring Sessions Based on System-Generated Insights)
  
  FAFR002 --> SAFR006
  FAFR002 --> SAFR015
}

package "System" {
  actor "System" as SFR007
  
  usecase "SFR008: Request Financial Predictions from the AI Component" as AIFR001
  usecase "SFR009: Request Personalized Recommendations from the AI Component Based on Each User's Financial Data and Preferences" as AIFR002
  usecase "SFR010: Request Spending Limit Alerts from the AI Component When User Spending Patterns Exceed Defined Thresholds" as AIFR003
  
  CFR001 --> SFR007 : (Deliver Personalized Recommendations to Users Based on Their Financial Profiles)
  
  SAFR002 --> SFR008
  SAFR004 --> SFR009
  SAFR005 --> SFR010
  
  FAFR003 --> AIFR006 : (Generate Anomaly Transaction Alerts for Users by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements)
  
  SFR007 --> AIFR004
}

rectangle "AI System" {
  usecase "AIFR012: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as SAFR013
  
  CFR001 --> (View Spending Limit Alerts When I Exceed Predefined Thresholds in Specific Expense Categories)
  
  FAFR004 --> AIFR015 : (Generate Predictive Intervention Analyses for Users by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement)
}

rectangle "Financial News" {
  usecase "SFR016: Request Contextualized News Insights from the AI Component to Identify Potential Impacts on Users' Investments" as AIFR017
  
  CFR008 --> (View News Related to My Investment Portfolio to Stay Informed About Market Events That Might Affect My Assets)
}

rectangle "User Feedback" {
  usecase "CFR011: Send Feedback about the System's Recommendations and Insights" as SAFR020
}
@enduml