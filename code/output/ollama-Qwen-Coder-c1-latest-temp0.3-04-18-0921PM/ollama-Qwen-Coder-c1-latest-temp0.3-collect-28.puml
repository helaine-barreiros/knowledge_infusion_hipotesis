@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations" as FAFR003
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> FAFR003
  System --> SFR002
}

rectangle "Client Dashboard" {
  usecase "CFR009: Access a Personalized Dashboard That Consolidates My Financial Information in a Single View to Efficiently Monitor My Finances" as CFR009
  
  Client --> CFR009
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR01: Manage Client Mentoring Sessions Based on System-Generated Insights to Provide More Valuable Guidance Aligned with Each Client's Financial Goals" as FAFR001
  usecase "FAFR02: View Client Intervention Alerts When the System Detects Patterns Requiring Professional Attention to Proactively Assist Clients With Potential Financial Issues" as FAFR02
  
  FAFD --> FAFR01
  FAFD --> FAFR02
}

rectangle "System Management and Operations" {
  usecase "SFR003: Request Financial Predictions From the AI Component to Provide Users with Forward-Looking Financial Insights" as SFR003
  usecase "SFR014: Generate Client Analytics That Provide Meaningful Insights Into Financial Behavior and Performance" as SFR014
  
  System --> SFR003
  System --> SFR014
}

rectangle "AI Component Functions" {
  usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance As Defined by Industry Standards Like FINRA Guidelines" as AIFR002
  
  System --> AIFR002
}

rectangle "Feedback Mechanism" {
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as CFR11
  
  Client --> CFR11
}
@enduml