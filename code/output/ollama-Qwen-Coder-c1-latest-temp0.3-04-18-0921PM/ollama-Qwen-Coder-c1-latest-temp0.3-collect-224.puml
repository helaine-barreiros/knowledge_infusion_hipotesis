@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR002
}

package SystemAdmin {
  actor "System Administrator" as SAFR003
}

rectangle "User Interface" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  CFR001 --> (CFR009)
  FAFR002 --> (CFR10)
}

rectangle "Financial Insights and Predictions" {
  usecase "SAFR003: View Financial Predictions" as SAFR003
  usecase "SFR004: Request Financial Predictions from AI Component" as SFR004
  
  CFR001 --> (SAFR003)
}

rectangle "Personalized Recommendations and Alerts" {
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  
  CFR001 --> (CFR002)
}

rectangle "Investment Opportunities and News" {
  usecase "FAFR007: View Investment Opportunities Suitable to Risk Profile" as FAFR007
  usecase "SFR008: Request Contextualized News from AI Component" as SFR008
  
  CFR001 --> (FAFR007)
}

rectangle "System Management and Feedback" {
  usecase "SAFR002: Manage Client Mentoring Sessions" as SAFR002
  usecase "SFR11: Request Contextualized News Insights from AI Component" as SFR11
  
  CFR001 --> (SAFR002)
}

rectangle "AI System Functions" {
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  usecase "SFR13: Request Client Alerts Based on Predefined Conditions" as SFR13
  
  CFR001 --> (AIFR004)
}

rectangle "System Admin Functions" {
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  usecase "SFR20: Manage User Feedback to Continuously Improve Outputs" as SFR20
  
  SAFR003 --> (SAFR001)
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  usecase "SFR15: Request Predictive Intervention Analyses from AI Component" as SFR15
  
  FAFR002 --> (FAFR004)
}

rectangle "User Feedback" {
  usecase "CFR11: Send Feedback about System's Recommendations and Insights" as CFR11
  
  CFR001 --> (CFR11)
}
@enduml