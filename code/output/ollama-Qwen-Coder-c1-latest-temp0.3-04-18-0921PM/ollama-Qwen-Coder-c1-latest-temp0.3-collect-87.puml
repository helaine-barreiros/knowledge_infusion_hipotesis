@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FinancialAdvisor
:User: as User

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  Client --> CFR001
  Client --> FAFR003
  SysAdmin --> SAFR001
  FinancialAdvisor --> FAFR003
}

rectangle "Client Management" {
  usecase "CFR002: View Alerts" as CFR002
  usecase "SAFR005: Manage Recommendations Preferences" as SAFR005
  usecase "SFR019: Maintain Historical Record of Insights" as SFR019
  
  Client --> CFR002
  Client --> SAFR005
}

rectangle "Financial Advisor Management" {
  usecase "FAFR001: Manage Mentoring Sessions" as FAFR001
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FinancialAdvisor --> FAFR001
  FinancialAdvisor --> FAFR004
}

rectangle "System Operations" {
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  
  System --> SFR003
  System --> AIFR002
}

rectangle "Spending Limits and Alerts" {
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
  usecase "SFR005: Request Spending Limit Alerts" as SFR005
  
  Client --> CFR010
  System --> SFR005
}

rectangle "Investment Opportunities and News" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
  
  Client --> CFR007
  System --> SFR006
}

rectangle "News and Analytics" {
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  
  Client --> CFR008
  System --> SFR013
}

rectangle "Health Reports and Goals Management" {
  usecase "CFR017: View Financial Health Reports" as CFR017
  usecase "SFR018: Manage Users' Financial Goals to Track Progress" as SFR018
  
  Client --> CFR017
  System --> SFR018
}

rectangle "Feedback Management" {
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights" as CFR011
  
  User --> CFR011
}
@enduml