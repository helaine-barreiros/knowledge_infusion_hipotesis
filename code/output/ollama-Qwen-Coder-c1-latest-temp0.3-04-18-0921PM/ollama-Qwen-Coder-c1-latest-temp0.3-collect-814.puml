@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR005
  usecase "CFR003: View Financial Predictions Based on Historical Data and Current Market Trends" as SAFR006
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as SAFR007
  usecase "CFR005: Manage Personalized Recommendations Preferences" as SAFR012
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as SAFR013
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile (as Defined Under MiFID II or Equivalent Standards)" as SAFR025
  usecase "CFR008: View News Related to My Investment Portfolio" as SAFR049
  usecase "CFR009: Access a Personalized Dashboard That Consolidates My Financial Information in a Single View" as SAFR136
  
  CFR001 --> SAFR005 : "View Alerts"
  CFR001 --> SAFR006 : "View Predictions"
  CFR001 --> SAFR007 : "Receive Recommendations"
  CFR001 --> SAFR012 : "Manage Preferences"
  CFR001 --> SAFR013 : "View Spending Alerts"
  CFR001 --> SAFR025 : "View Investment Opportunities"
  CFR001 --> SAFR049 : "View News"
  CFR001 --> SAFR136 : "Access Dashboard"
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts When the System Detects Patterns Requiring Professional Attention to Proactively Assist Clients with Potential Financial Issues" as SFR048
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as SAFR127
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments to Customize the System's Behavior According to Different Client Profiles and Regulatory Requirements Such As GDPR or CCPA" as AIFR035
  
  FinancialAdvisor --> SFR048 : "View Alerts"
  FinancialAdvisor --> SAFR127 : "View Predictive Analytics"
  FinancialAdvisor --> AIFR035 : "Configure Parameters"
}

package "System Administrator" {
  actor SystemAdministrator as SAFR009
  
  usecase "SAFR001: Manage Analysis Parameters for the AI System to Ensure the Algorithms Remain Accurate, Relevant, and Compliant with Financial Regulations Such As Basel III for Risk Management" as AIFR024
  usecase "SFR036: Deliver Alerts to Users Through Appropriate Notification Channels to Ensure Timely Awareness of Critical Financial Events" as SFR019
  
  SystemAdministrator --> AIFR024 : "Manage Parameters"
  SystemAdministrator --> SFR019 : "Deliver Alerts"
}

package "System Components" {
  usecase "SFR037: Deliver Personalized Recommendations to Users Based on Their Financial Profiles to Support Better Financial Decision-Making" as SFR018
  usecase "SFR042: Request Financial Predictions from the AI Component to Provide Users With Forward-Looking Financial Insights" as AIFR009
  usecase "SFR043: Request Personalized Recommendations from the AI Component Based on Each User's Financial Data and Preferences" as AIFR018
  usecase "SFR052: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as SFR017
  
  SystemAdministrator --> SFR037 : "Deliver Recommendations"
}

package "AI Component" {
  usecase "AIFR009: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR028
  usecase "AIFR146: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR037
  
  SystemAdministrator --> AIFR028 : "Generate Predictions"
}

rectangle "System Boundary" {
  CFR001
  FAFR001
  SAFR009
  SFR048
  SAFR127
  AIFR035
  
  SystemAdministrator --> (SFR036)
  
  CFR001 --> (SAFR037, SFR042, SFR043, SFR052)
  FAFR001 --> (AIFR009, AIFR146)
}

@enduml