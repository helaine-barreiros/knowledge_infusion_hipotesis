@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR002
  usecase "CFR003: View Financial Predictions" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations" as SAFR004
  usecase "CFR005: Manage Recommendation Preferences" as SAFR005
  usecase "CFR006: View Spending Limit Alerts" as SAFR006
  usecase "CFR007: View Investment Opportunities" as SAFR007
  usecase "CFR008: View News Related to Portfolio" as SAFR008
  usecase "CFR009: Access Personalized Dashboard" as SAFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as SAFR10
  
  CFR001 --> (SAFR002)
  CFR001 --> (SAFR003)
  CFR001 --> (SAFR004)
  CFR001 --> (SAFR005)
  CFR001 --> (SAFR006)
  CFR001 --> (SAFR007)
  CFR001 --> (SAFR008)
  CFR001 --> (SAFR009)
  CFR001 --> (SAFR10)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
  
  usecase "FAFR003: View Predictive Analytics for Clients" as SAFR007
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as SAFR016
  usecase "FAFR005: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  
  FinancialAdvisor --> (SAFR007)
  FinancialAdvisor --> (SAFR014)
  FinancialAdvisor --> (FAFR001)
}

package "System Administrator" {
  actor SysAdmin as SAFR001
  
  usecase "SAFR002: Manage Analysis Parameters for AI System" as SAFR001
  usecase "SFR018: Manage Users' Financial Goals" as SFR018
  
  SysAdmin --> (SAFR001)
  SysAdmin --> (SFR018)
}

package "System" {
  rectangle "AI Component" {
    usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
    usecase "AIFR005: Generate Financial Predictions for Users" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights Correlating with User Portfolios" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations Based on Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009
    
    SysAdmin --> (SAFR001)
  }
  
  rectangle "Notification System" {
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
    usecase "SFR024: Send Feedback About Recommendations and Insights to Improve Future Outputs" as SAFR11
    
    CFR001 --> (SAFR11)
  }
}

@enduml