@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR005: Manage Analysis Parameters Preferences" as SAFR005
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  Client --> (CFR001)
  SysAdmin --> (SAFR005)
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  
  FinancialAdvisor --> (FAFR001)
  FinancialAdvisor --> (FAFR003)
}

rectangle "System Functions" {
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR004: Request Financial Predictions" as SFR004
  usecase "SFR019: Maintain Historical Record of Insights" as SFR019
  
  System --> (SFR002)
  System --> (SFR004)
  System --> (SFR019)
}

rectangle "AI Functions" {
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  
  System --> (AIFR002)
  System --> (AIFR003)
}

rectangle "User Feedback" {
  usecase "CFR011: Send Feedback" as CFR011
  Client --> (CFR011)
}
@enduml