@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Predictive Analytics" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
  
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA

  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004

  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004
  
}

package "System Administrator" {
  actor SystemAdmin as SA

  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001

  SA --> SAFR001
  
}

rectangle "AI Component" {
  
  package "Recommendations and Insights Generation" {
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  }
  
  package "Predictive Analytics and Interventions" {
    usecase "AIFR009: Generate Predictive Insights for Clients" as AIFR009
    usecase "AIFR015: Generate Client Predictive Intervention Recommendations" as AIFR015
  }
  
  package "News and Analytics Processing" {
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "SFR009: Find Contextualized News Relevant to Users' Portfolios" as SFR009
    usecase "SFR10: Process Contextualized News for User Financial Situations" as SFR10
  }
  
}

rectangle "System" {
  
  package "Notification and Alert Management" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  }
  
  package "Dashboard Generation" {
    usecase "SFR12: Generate Client Dashboards" as SFR12
  }

}

rectangle "AI System" {

  package "Financial Predictions and Recommendations" {
    usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  }
  
  package "Spending Limit Alerts" {
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  }

}

rectangle "Contextualized News Processing" {

  package "News Identification and Analysis" {
    usecase "SFR017: Find Contextualized News Relevant to Users' Portfolios" as SFR017
    usecase "AIFR008: Generate Client Predictive Insights for Financial Situations" as AIFR008
  }
  
}

rectangle "User Feedback Management" {
  usecase "CFR11: Send Feedback about System Recommendations and Insights" as CFR11
  
  C --> CFR11
  FA --> CFR11
  SA --> CFR11

}


@enduml