@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004

  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> FAFR002
  Sys --> SFR003
  Sys --> AIFR004
}

rectangle "Client Dashboards and Alerts" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013

  Client --> CFR009
  Sys --> SFR013
}

rectangle "Personalization and Recommendations" {
  usecase "CFR004: Receive Personalized Recommendations Aligned with Financial Profile and Goals" as CFR004
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002

  Client --> CFR004
  Sys --> SFR002
}

rectangle "Spending Limits and Alerts" {
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights" as CFR011
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005

  Client --> CFR011
  Sys --> SFR005
}

rectangle "Investment Opportunities" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006

  Client --> CFR007
  Sys --> SFR006
}

rectangle "News and Analytics" {
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "SFR019: Maintain a Historical Record of Users' Insights to Enable Trend Analysis and Effectiveness Measurement" as SFR019

  Client --> CFR008
  Sys --> SFR019
}

rectangle "Relationship Management" {
  usecase "CFR10: Manage My Relationship with Financial Advisors, Including Permissions for Sharing My Financial Data" as CFR10

  Client --> CFR10
}
@enduml