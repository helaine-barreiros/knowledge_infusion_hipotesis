@startuml

left to right direction

title Use Case Diagram for AI-Powered Financial Insights & Analytics System

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  Client --> (CFR001)
  Client --> (CFR002)
  Client --> (CFR003)
  Client --> (CFR004)
  Client --> (CFR005)
  Client --> (CFR006)
  Client --> (CFR007)
  Client --> (CFR008)
  Client --> (CFR009)
  Client --> (CFR10)
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FinancialAdvisor --> (FAFR001)
  FinancialAdvisor --> (FAFR002)
  FinancialAdvisor --> (FAFR003)
  FinancialAdvisor --> (FAFR004)
}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SystemAdmin --> (SAFR001)
}

package "Notifications & Alerts" {
  rectangle "System" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    
    System --> (SFR001)
    System --> (AIFR006)
  }
}

package "Recommendations & Insights Generation" {
  rectangle "System" {
    usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
    usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
    
    System --> (SFR002)
    System --> (AIFR002)
  }
}

package "Predictive Analytics & Insights Generation" {
  rectangle "System" {
    usecase "SFR016: Request Predictive Insights from the AI Component" as SFR016
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
    
    System --> (SFR016)
    System --> (AIFR009)
  }
}

package "Investment Opportunities & News Generation" {
  rectangle "System" {
    usecase "SFR006: Request Investment Opportunity Analysis from the AI Component" as SFR006
    usecase "SFR017: Generate Financial Health Reports" as SFR017
    
    System --> (SFR006)
    System --> (SFR017)
  }
}

package "User Feedback Management" {
  rectangle "System" {
    usecase "CFR11: Send Feedback about Recommendations and Insights" as CFR11
    usecase "AIFR020: Manage User Feedback to Improve Future Outputs" as AIFR020
    
    System --> (CFR11)
    System --> (AIFR020)
  }
}

@enduml