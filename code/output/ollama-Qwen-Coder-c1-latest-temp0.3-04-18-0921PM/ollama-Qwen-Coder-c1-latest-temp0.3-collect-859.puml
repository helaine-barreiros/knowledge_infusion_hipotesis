@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
  
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA

  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004
  
}

package "System Administrator" {
  actor SystemAdmin as SA

  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SA --> SAFR001
  
}

rectangle "AI Component" {
  
  package "Financial Insights Generation" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    
    C --> (AIFR001)
    C --> (AIFR002)
    
  }
  
  package "Alert Generation" {
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    
    C --> (AIFR003)
    C --> (AIFR006)
    
  }
  
  package "Investment Opportunity Analysis" {
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on Strategies and MPT Principles" as AIFR005
    
    C --> (AIFR004)
    C --> (AIFR005)
    
  }
  
  package "News Insights Generation" {
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "AIFR10: Extract Relevant Information from News for Users' Financial Situations" as AIFR10
    
    C --> (AIFR007)
    C --> (AIFR10)
    
  }
  
  package "Predictive Interventions and Insights Generation" {
    usecase "AIFR08: Generate Predictive Intervention Recommendations" as AIFR08
    usecase "AIFR09: Generate Client Predictive Insights for Forward-Looking Analysis" as AIFR09
    
    C --> (AIFR08)
    C --> (AIFR09)
    
  }
  
}

package "System Functions" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Based on User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  usecase "SFR010: Process Contextualized News for Users" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
  usecase "SFR012: Generate Client Dashboards in an Intuitive Format" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics for Financial Insights and Performance" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
  usecase "SFR016: Request Predictive Insights from AI Component to Enhance Guidance Value" as SFR016
  usecase "SFR017: Generate Financial Health Reports Based on Standard Ratios and Metrics" as SFR017
  usecase "SFR018: Manage Users' Financial Goals for Progress Tracking and Recommendations" as SFR018
  usecase "SFR019: Maintain Historical Record of User Insights for Trend Analysis" as SFR019
  usecase "SFR020: Manage User Feedback to Improve System Outputs" as SFR020
  
}

package "User (Client, Financial Advisor, or System Administrator)" {
  
  C --> (CFR11)
  FA --> (FAFR05)
  SA --> (SAFR06)

}
@enduml