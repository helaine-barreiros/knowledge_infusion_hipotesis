@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFD002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> FAFD002
  System Admin <|-- (SAFR001)
}

rectangle "Client Dashboard Features" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  
  Client --> CFR009
}

rectangle "Alerts and Notifications" {
  usecase "SFR002: Deliver Alerts to Users" as SFR002
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  
  System Admin --> SFR002
  Client <|-- (SFR002)
}

rectangle "Recommendations and Insights" {
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  
  Client --> CFR004
  System Admin <|-- (SFR002)
}

rectangle "Client Management and Relationship" {
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  Client --> CFR10
}

rectangle "Financial Advisor Features" {
  usecase "FAFR003: View Predictive Analytics" as FAFD003
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
  
  Financial Advisor --> FAFD003
}

rectangle "Investment Opportunities and News" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "FAFR012: Generate Client Alerts Based on Predefined Conditions" as FAFD012
  
  Financial Advisor --> CFR007
}

rectangle "Feedback and Improvement" {
  usecase "CFR11: Send Feedback about the System's Recommendations and Insights" as CFR11
  
  User <|-- (CFR11)
}
@enduml