@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001
:AIFR002: as AIFR002

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics about My Clients' Financial Situations" as FAFR003
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFR001 --> (FAFR002)
}

rectangle "Client Dashboard Features" {
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Current Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as CFR004
  usecase "CFR010: Manage Relationship with Financial Advisors, Including Permissions for Sharing My Financial Data" as CFR010
  
  Client --> (SFR02)
  Client --> (AIFR003)
  Client --> (AIFR009)
}

rectangle "Financial Advisor Features" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts When the System Detects Patterns Requiring Professional Attention" as FAFR002
  
  FinancialAdvisor --> (AIFR003)
}

rectangle "System Features" {
  usecase "SFR007: Request Specific Investment Opportunities from the AI Component That Match User Investment Criteria and ESG Preferences" as SFR007
  usecase "SFR10: Find Contextualized News Relevant to Users' Financial Portfolios From Trusted Financial News Sources" as SFR10
  
  System --> (AIFR003)
}

rectangle "Feedback Management" {
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights" as CFR011
  
  Client --> (SFR20)
}
@enduml