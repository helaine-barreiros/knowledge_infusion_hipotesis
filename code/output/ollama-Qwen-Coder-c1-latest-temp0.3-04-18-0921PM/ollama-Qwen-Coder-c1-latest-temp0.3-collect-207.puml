@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  Client --> (View Financial Insights Dashboard)
  Client --> (Receive Alerts on Anomalous Transactions)
  Client --> (View Financial Predictions)
  Client --> (Receive Personalized Recommendations)
  Client --> (Manage Recommendation Preferences)
  Client --> (View Spending Limit Alerts)
  Client --> (View Investment Opportunities)
  Client --> (View News Related to Portfolio)
  Client --> (Access Personalized Dashboard)
  Client --> (Manage Relationship with Financial Advisors)
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FinancialAdvisor --> (Manage Client Mentoring Sessions)
  FinancialAdvisor --> (View Client Intervention Alerts)
  FinancialAdvisor --> (View Predictive Analytics for Clients)
  FinancialAdvisor --> (Configure Analysis Parameters for Specific Segments)
}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SystemAdministrator --> (Manage Analysis Parameters)
}

package "Notifications and Alerts" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  
  Client --> (Deliver Alerts to Users)
  FinancialAdvisor --> (Deliver Alerts to Users)
  SystemAdministrator --> (Deliver Alerts to Users)
}

package "Personalized Recommendations and Insights" {
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  
  Client --> (Deliver Personalized Recommendations)
  FinancialAdvisor --> (Deliver Personalized Recommendations)
}

package "Financial Predictions and Analytics" {
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  
  Client --> (Request Financial Predictions)
}

package "Spending Limit Alerts and Investment Opportunities" {
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
  
  Client --> (Request Spending Limit Alerts)
  
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  
  Client --> (Request Investment Opportunities)
}

package "News and Insights" {
  usecase "SFR008: Request Contextualized News from AI Component" as SFR008
  usecase "AIFR007: Generate Contextualized News Insights for Users" as AIFR007
  
  Client --> (Request Contextualized News)
}

package "Client Dashboards and Analytics" {
  usecase "SFR12: Generate Client Dashboards that Present Financial Information" as SFR12
  usecase "AIFR009: Generate Client Predictive Intervention Recommendations for Users" as AIFR009
  
  Client --> (Generate Client Dashboards)
}

package "System Management and Feedback" {
  usecase "SFR18: Manage Users' Financial Goals to Track Progress" as SFR18
  usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance" as AIFR002
  
  Client --> (Manage Financial Goals)
  
  usecase "CFR11: Send Feedback about System's Recommendations and Insights to Improve Future Outputs" as CFR11
}

@enduml