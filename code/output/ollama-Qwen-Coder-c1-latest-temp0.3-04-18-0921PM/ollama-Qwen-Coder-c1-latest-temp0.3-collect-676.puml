@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> CFR001 : "View"
  C --> CFR002 : "Receive Alerts"
  C --> CFR003 : "Predictions"
  C --> CFR004 : "Recommendations"
  C --> CFR005 : "Manage Preferences"
  C --> CFR006 : "Spending Limits"
  C --> CFR007 : "Investment Opportunities"
  C --> CFR008 : "News"
  C --> CFR009 : "Dashboard"
  C --> CFR10 : "Relationship Management"
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> FAFR001 : "Manage Sessions"
  FA --> FAFR002 : "View Alerts"
  FA --> FAFR003 : "Predictive Analytics"
  FA --> FAFR004 : "Configure Parameters"
}

package "System" {
  actor System as Sys
  
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities from AI Component" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  usecase "SFR010: Process Contextualized News to Extract Information for Users' Financial Situations" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
  usecase "SFR016: Request Predictive Insights From the AI Component to Enhance Value of Financial Guidance Provided to Clients" as SFR016
  usecase "SFR017: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR017
  usecase "SFR018: Manage Users' Financial Goals Tracking Progress and Providing Relevant Recommendations" as SFR018
  usecase "SFR019: Maintain Historical Record of Users' Insights for Trend Analysis and Effectiveness Measurement" as SFR019
  usecase "SFR020: Manage User Feedback to Continuously Improve Accuracy and Relevance of Financial Insights" as SFR020
  
  Sys --> SFR001 : "Deliver Alerts"
  Sys --> SFR002 : "Deliver Recommendations"
  Sys --> SFR003 : "Request Predictions"
  Sys --> SFR004 : "Request Personalized Recommendations"
  Sys --> SFR005 : "Request Spending Limits"
  Sys --> SFR006 : "Request Investment Opportunities"
  Sys --> SFR007 : "Request Specific Investments"
  Sys --> SFR008 : "Request Anomaly Alerts"
  Sys --> SFR009 : "Find News Relevant to Portfolios"
  Sys --> SFR010 : "Process News for Users"
  Sys --> SFR011 : "Request Contextualized Insights"
  Sys --> SFR012 : "Generate Dashboards"
  Sys --> SFR013 : "Generate Alerts Based on Conditions"
  Sys --> SFR014 : "Generate Analytics Providing Insights"
  Sys --> SFR015 : "Request Predictive Interventions"
  Sys --> SFR016 : "Request Enhancing Financial Guidance"
  Sys --> SFR017 : "Generate Financial Health Reports"
  Sys --> SFR018 : "Manage Financial Goals and Recommendations"
  Sys --> SFR019 : "Maintain Historical Record of Insights"
  Sys --> SFR020 : "Manage User Feedback for Improvement"
}

package "AI System" {
  actor AI as A
  
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Based on Strategies and MPT Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  A --> AIFR001 : "Generate Predictions"
  A --> AIFR002 : "Generate Recommendations"
  A --> AIFR003 : "Generate Spending Limits"
  A --> AIFR004 : "Generate Investment Opportunities"
  A --> AIFR005 : "Generate Investments Based on Strategies and MPT Principles"
  A --> AIFR006 : "Generate Anomaly Alerts"
  A --> AIFR007 : "Generate News Insights"
  A --> AIFR008 : "Generate Predictive Interventions"
  A --> AIFR009 : "Generate Predictive Insights"
}

rectangle System {
  C
  FA
  Sys
  A
  
  usecase "CFR11: Send Feedback" as CFR11
  
  C --> CFR11 : "Send Feedback"
  FA --> CFR11 : "Send Feedback"
  Sys --> CFR11 : "Send Feedback"
}

@enduml