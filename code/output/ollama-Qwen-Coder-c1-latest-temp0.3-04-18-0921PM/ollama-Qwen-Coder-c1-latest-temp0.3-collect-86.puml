@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FAFR

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics about My Clients' Financial Situations" as FAFR003
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002
  usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
  
  User --> CFR001
  SysAdmin --> SAFR001
  FAFR --> FAFR003
  SFR002 <|-- (AIFR001)
}

rectangle "Client Dashboards" {
  usecase "CFR009: Access a Personalized Dashboard that Consolidates My Financial Information in a Single View to Efficiently Monitor My Finances" as CFR009
  
  User --> CFR009
}

rectangle "Financial Predictions and Recommendations" {
  usecase "SFR003: Request Financial Predictions from the AI Component to Provide Users with Forward-Looking Financial Insights" as SFR003
  usecase "AIFR004: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance as Defined by Industry Standards like FINRA Guidelines" as AIFR004
  
  User --> (SFR003)
  SysAdmin --> SAFR001
}

rectangle "Spending Limits and Alerts" {
  usecase "CFR006: View Spending Limit Alerts When I Exceed Predefined Thresholds in Specific Expense Categories to Maintain Better Control Over My Budget" as CFR006
  
  User --> CFR006
}

rectangle "Investment Opportunities" {
  usecase "SFR005: Request Investment Opportunity Analysis from the AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles" as SFR005
  usecase "AIFR004: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance as Defined by Industry Standards like FINRA Guidelines" as AIFR004
  
  User --> (SFR005)
}

rectangle "News and Insights" {
  usecase "CFR008: View News Related to My Investment Portfolio to Stay Informed About Market Events That Might Affect My Assets" as CFR008
  usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
  
  User --> (CFR008)
}

rectangle "Client Relationship Management" {
  usecase "CFR10: Manage My Relationship with Financial Advisors, Including Permissions for Sharing My Financial Data, to Maintain Privacy and Control Over My Financial Information" as CFR10
  usecase "FAFR04: Configure Analysis Parameters for Specific Client Segments to Customize the System's Behavior According to Different Client Profiles and Regulatory Requirements Such as GDPR or CCPA" as FAFR04
  
  User --> (CFR10)
}

rectangle "Feedback Management" {
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as CFR11
  
  User --> CFR11
}
@enduml