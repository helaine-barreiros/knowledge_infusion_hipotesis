@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
  
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  
  SA --> SAFR001
}

rectangle "AI Component" {
  package "Financial Insights & Predictions" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    
    CFR003 <|-- AIFR001
    FAFR003 <|-- AIFR001
    SFR002 <|-- AIFR001
  }
  
  package "Personalized Recommendations & Insights" {
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    
    CFR004 <|-- AIFR002
    FAFR003 <|-- AIFR002
    SFR001 <|-- AIFR002
  }
  
  package "Spending Limit Alerts & Transaction Analysis" {
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    
    CFR006 <|-- AIFR003
    SFR005 <|-- AIFR003
  }
  
  package "Investment Opportunities & News Insights" {
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    
    CFR007 <|-- AIFR004
    FAFR007 <|-- AIFR004
  }
  
  package "Anomaly Detection & Predictive Interventions" {
    usecase "AIFR005: Generate Investment Opportunities Based on Modern Portfolio Theory Principles" as AIFR005
    
    CFR010 <|-- AIFR005
    FAFR002 <|-- AIFR005
  }
  
  package "Fraud Detection & News Correlation" {
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    
    CFR008 <|-- AIFR006
    SFR007 <|-- AIFR006
  }
  
  package "Contextualized News Insights & Predictive Interventions" {
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    
    CFR011 <|-- AIFR007
    FAFR002 <|-- AIFR007
  }
  
  package "Predictive Intervention Recommendations & Insights" {
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
    
    CFR10 <|-- AIFR008
    FAFR002 <|-- AIFR008
  }
  
  package "Financial Health Reports & Goal Management" {
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
    
    CFR17 <|-- AIFR009
    SFR018 <|-- AIFR009
  }
}

package "System" {
  actor System
  
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities from AI Component Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  usecase "SFR10: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR10
  usecase "SFR11: Request Contextualized News Insights from AI Component" as SFR11
  usecase "SFR12: Generate Client Dashboards in an Intuitive and Actionable Format" as SFR12
  usecase "SFR13: Generate Client Alerts Based on Predefined Conditions" as SFR13
  usecase "SFR14: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR14
  usecase "SFR15: Request Predictive Intervention Analyses from AI Component" as SFR15
  usecase "SFR16: Request Predictive Insights From the AI Component to Enhance Value of Financial Guidance Provided to Clients" as SFR16
  usecase "SFR17: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR17
  usecase "SFR18: Manage Users' Financial Goals Tracking Progress and Providing Relevant Recommendations" as SFR18
  usecase "SFR19: Maintain Historical Record of Users' Insights for Trend Analysis and Effectiveness Measurement" as SFR19
  usecase "SFR20: Manage User Feedback to Continuously Improve Quality and Relevance of Financial Insights" as SFR20
  
  System --> CFR004 : (Deliver)
  System --> FAFR003 : (Deliver)
  System --> SAFR001 : (Manage)
  
  System --> AIFR001
  System --> AIFR002
  System --> AIFR003
  System --> AIFR004
  System --> AIFR005
  System --> AIFR006
  System --> AIFR007
  System --> AIFR008
  System --> AIFR009
  
  C --> SFR12 : (View)
  FA --> SFR14 : (View)
  SA --> SAFR001 : (Manage)
  
  CFR11 <|-- SFR007
}

@enduml