@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFD002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004

  Client --> CFR001
  Client --> FAFD002
  SysAdmin --> SAFR001
}

rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFD001
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFD003

  Financial Advisor --> FAFD001
  Financial Advisor --> FAFD002
}

rectangle "Client Relationship Management Interface" {
  usecase "CFR010: Manage My Relationship with Financial Advisors, Including Permissions for Sharing My Financial Data" as CFR010
  
  Client --> CFR010

  rectangle "Financial Advisor Dashboard" {
    usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFD004
    usecase "SFR002: Request Personalized Recommendations from AI Component Based on Each User's Financial Data and Preferences" as SFR002

    Financial Advisor --> FAFD004
  }
}

rectangle "Notification Interface" {
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR013
  
  System Admin --> SFR013

  rectangle "User Dashboard Interface" {
    usecase "CFR009: Access a Personalized Dashboard That Consolidates My Financial Information in a Single View to Efficiently Monitor My Finances" as CFR009
    usecase "SFR12: Generate Client Dashboards that Present Financial Information in an Intuitive and Actionable Format" as SFR12

    User --> CFR009
  }
}

rectangle "News Interface" {
  usecase "CFR008: View News Related to My Investment Portfolio to Stay Informed About Market Events That Might Affect My Assets" as CFR008
  usecase "SFR007: Request Contextualized News Insights from the AI Component to Identify Potential Impacts on Users' Investments" as SFR007

  User --> CFR008
}

rectangle "Feedback Interface" {
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as CFR11
  
  Client --> CFR11
}
@enduml