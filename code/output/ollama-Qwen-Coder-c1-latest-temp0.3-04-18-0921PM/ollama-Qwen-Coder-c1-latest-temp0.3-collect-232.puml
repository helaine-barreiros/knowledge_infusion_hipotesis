@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "AIFR009: Generate Contextualized News Insights" as AIFR009
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> FAFR003
}

rectangle "Client Dashboard Features" {
  usecase "CFR002: View Alerts" as CFR002
  usecase "CFR006: Manage Spending Limits" as CFR006
  
  Client --> CFR002
  Client --> CFR006
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR001: Manage Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  
  FinancialAdvisor --> FAFR001
  FinancialAdvisor --> FAFR002
}

rectangle "System Functions" {
  usecase "SFR003: Request Predictive Analytics" as SFR003
  usecase "SFR004: Request Personalized Recommendations" as SFR004
  
  System Admin --> SAFR001
  Client --> SFR003
  FinancialAdvisor --> SFR002
}

rectangle "AI Functions" {
  usecase "AIFR001: Generate Predictive Analytics" as AIFR001
  usecase "AIFR004: Request Personalized Recommendations" as AIFR004
  
  System Admin --> SAFR001
  Client --> SFR003
  FinancialAdvisor --> SFR002
}

rectangle "User Feedback" {
  usecase "CFR011: Send Feedback" as CFR011
  
  Client --> CFR011
  FinancialAdvisor --> CFR011
  System Admin --> SAFR001
}
@enduml