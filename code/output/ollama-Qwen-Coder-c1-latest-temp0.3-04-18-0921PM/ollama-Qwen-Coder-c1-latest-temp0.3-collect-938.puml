@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "SFR013: Generate Client Alerts" as SFR013

  Client --> (SAFR001)
  Client --> (FAFR002)
  Client --> (CFR001)
  Client --> (CFR009)
  SysAdmin --> (SAFR001)

  FAFD --> (FAFR002)
  FAFD --> (FAFR003)
  FAFD --> (SFR015)
  
  System --> (AIFR006) : "Generate Anomaly Transaction Alerts"
  System --> (AIFR007) : "Generate Contextualized News Insights"
  System --> (AIFR008) : "Generate Client Predictive Intervention Recommendations"
  System --> (SFR012) : "Generate Financial Health Reports"

  SysAdmin -> (SAFR004)
}

rectangle "Client" {
  usecase "CFR002: View Alerts" as CFR002
  usecase "CFR003: View Predictions" as CFR003
  usecase "CFR004: Receive Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News" as CFR008

  Client --> (CFR002)
  Client --> (CFR003)
  Client --> (CFR004)
  Client --> (CFR005)
  Client --> (CFR006)
  Client --> (CFR007)
  Client --> (CFR008)

}

rectangle "Financial Advisor" {
  usecase "FAFR01: Manage Mentoring Sessions" as FAFR01
  usecase "FAFR03: View Predictive Analytics" as FAFR03

  FinancialAdvisor --> (FAFR01)
  FinancialAdvisor --> (FAFR02)
  FinancialAdvisor --> (FAFR03)

}

rectangle "System Components" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002

  System --> (AIFR001)
  System --> (AIFR002)

}

@enduml