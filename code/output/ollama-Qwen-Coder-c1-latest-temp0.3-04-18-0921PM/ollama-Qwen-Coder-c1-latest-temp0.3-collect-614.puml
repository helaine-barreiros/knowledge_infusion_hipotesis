@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
}

package "System Administrator" {
  actor SysAdmin as SAFR003
}

rectangle "User Interface" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "SAFR017: Generate Financial Health Reports" as SAFR017
  
  CFR001 --> (View Alerts)
  CFR002 --> (Manage Client Sessions)
  SysAdmin --> (Manage Analysis Parameters)
}

rectangle "Alerts & Notifications" {
  usecase "SFR003: Deliver Alerts to Users" as SFR003
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  
  CFR002 --> (View Intervention Alerts)
}

rectangle "Personalized Recommendations & Insights" {
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  
  CFR001 --> (View Financial Predictions)
  FAFR002 --> (View Predictive Analytics)
}

rectangle "Spending Limits & Investment Opportunities" {
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
  
  CFR001 --> (View Spending Limits)
}

rectangle "News & Information" {
  usecase "SFR008: Request Contextualized News from AI Component" as SFR008
  usecase "AIFR007: Generate Contextualized News Insights for Users" as AIFR007
  
  CFR001 --> (View Investment Opportunities)
}

rectangle "AI System Functions" {
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition" as AIFR006
  
  FAFR002 --> (View Predictive Insights)
}

rectangle "Feedback & Improvement" {
  usecase "CFR11: Send Feedback about System's Recommendations and Insights" as CFR11
}
@enduml