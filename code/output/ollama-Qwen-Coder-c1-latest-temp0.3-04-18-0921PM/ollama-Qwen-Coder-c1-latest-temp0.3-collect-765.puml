@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  Client --> CFR001
  Client --> SAFR001
  Client --> FAFR003
  SysAdmin --> SAFR001
  FinancialAdvisor --> FAFR003
}

rectangle "Client Dashboard Features" {
  usecase "CFR002: View Alerts" as CFR002
  usecase "SFR009: Request Contextualized News Insights" as SFR009
  
  Client --> CFR002
  Client --> SFR009
}

rectangle "Financial Advisor Features" {
  usecase "FAFR01: Manage Client Mentoring Sessions" as FAFR01
  usecase "FAFR02: View Client Intervention Alerts" as FAFR02
  
  FinancialAdvisor --> FAFR01
  FinancialAdvisor --> FAFR02
}

rectangle "System Features" {
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  
  SystemAdmin --> SAFR001
  Client --> SFR003
}

rectangle "AI Features" {
  usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  
  Client --> SFR004
}

rectangle "User Feedback Features" {
  usecase "CFR11: Send Feedback about System's Recommendations and Insights" as CFR11
  
  Client --> CFR11
}
@enduml