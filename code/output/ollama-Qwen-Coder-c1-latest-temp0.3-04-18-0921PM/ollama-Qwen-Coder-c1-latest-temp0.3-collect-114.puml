@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations" as SFR002
  usecase "CFR005: Manage Recommendation Preferences" as CFR010
  
  Client --> SAFR003 : "View Alerts"
  Client --> SFR002 : "Receive Recommendations"
  Client --> CFR010 : "Manage Preferences"
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  usecase "FAFR002: View Intervention Alerts" as SAFR004
  usecase "FAFR003: View Predictive Analytics" as SFR006
  
  FinancialAdvisor --> SAFR004 : "View Alerts"
  FinancialAdvisor --> SFR006 : "View Analytics"
}

package "System Administrator" {
  actor SystemAdmin as SAFR001
  usecase "SAFR002: Manage Analysis Parameters" as SAFR005
  
  SystemAdmin --> SAFR005 : "Manage Parameters"
}

package "System" {
  rectangle "Financial Insights Dashboard" {
    usecase "SFR012: Generate Client Dashboards" as SFR012
  }
  
  rectangle "Personalized Recommendations" {
    usecase "SFR004: Request Personalized Recommendations from AI" as AIFR002
  }
  
  rectangle "Spending Limit Alerts" {
    usecase "SFR005: Request Spending Limit Alerts from AI" as AIFR003
  }
  
  rectangle "Investment Opportunities Analysis" {
    usecase "SFR006: Request Investment Opportunity Analysis from AI" as AIFR004
  }
  
  rectangle "Anomaly Transaction Alerts" {
    usecase "SFR008: Request Anomaly Transaction Alerts from AI" as AIFR006
  }
  
  rectangle "Contextualized News Insights" {
    usecase "SFR017: Generate Client Analytics" as SFR014
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as AIFR007
  }
  
  rectangle "Predictive Intervention Recommendations" {
    usecase "SFR015: Request Predictive Intervention Analyses from AI" as AIFR008
  }
}

package "AI System" {
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  
  rectangle "Personalized Recommendations Generation" {
    usecase "AIFR002: Generate Personalized Recommendations Based on User Data and Preferences" as AIFR002
  }
  
  rectangle "Spending Limit Alerts Generation" {
    usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Patterns" as AIFR003
  }
  
  rectangle "Investment Opportunity Analysis Generation" {
    usecase "AIFR004: Evaluate Potential Investments Against User Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  }
  
  rectangle "Anomaly Transaction Alerts Generation" {
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
  }
  
  rectangle "Contextualized News Insights Generation" {
    usecase "AIFR007: Correlate Financial News With Specific User Portfolios to Identify Relevant Impacts" as AIFR007
  }
  
  rectangle "Predictive Intervention Recommendations Generation" {
    usecase "AIFR012: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  }
}

package "User Feedback Management" {
  actor UserFeedbackSender as CFR011
  
  usecase "CFR011: Send Feedback about System's Recommendations and Insights" as SFR020
  
  UserFeedbackSender --> SFR020 : "Send Feedback"
}
@enduml