@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
  
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SA --> SAFR001
}

rectangle "System" {
  
  package "Alerts and Notifications" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    
    C --> SFR001 : "Receive"
    FA --> SFR001 : "Receive"
    SA --> SFR001 : "Manage"
  }
  
  package "Recommendations and Insights" {
    usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
    usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
    
    C --> SFR002 : "Receive"
    FA --> SFR002 : "Receive"
    SA --> SFR002 : "Manage"
  }
  
  package "Predictive Analytics and Insights" {
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
    
    C --> SFR003 : "Request"
    FA --> SFR003 : "Request"
  }
  
  package "Recommendations and Insights Generation" {
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
    
    C --> SFR004 : "Request"
  }
  
  package "Spending Limit Alerts" {
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
    
    C --> SFR005 : "Request"
  }
  
  package "Investment Opportunity Analysis and Insights" {
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
    
    C --> SFR006 : "Request"
  }
  
  package "Investment Opportunities Matching User Criteria and ESG Preferences" {
    usecase "SFR007: Request Specific Investment Opportunities from AI Component that Match User Investment Criteria and ESG Preferences" as SFR007
    usecase "AIFR005: Generate Investment Opportunities for Users by Identifying Financial Instruments That Align with Their Investment Strategies and Modern Portfolio Theory Principles" as AIFR005
    
    C --> SFR007 : "Request"
  }
  
  package "Anomaly Transaction Alerts" {
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
    
    C --> SFR008 : "Request"
  }
  
  package "Contextualized News Insights and Analysis" {
    usecase "SFR009: Request Contextualized News from AI Component to Find Relevant Information for Users' Financial Situations" as SFR009
    usecase "AIFR007: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    
    C --> SFR009 : "Request"
  }
  
  package "Client Predictive Insights and Analytics" {
    usecase "SFR14: Generate Client Analytics that Provide Meaningful Insights into Financial Behavior and Performance" as SFR14
    usecase "AIFR009: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009
    
    C --> SFR14 : "Request"
  }
  
  package "Financial Health Reports and Recommendations" {
    usecase "SFR17: Generate Financial Health Reports that Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR17
    usecase "AIFR012: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    
    C --> SFR17 : "Request"
  }
  
  package "User Feedback Management and Improvement" {
    usecase "SFR20: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR20
    usecase "CFR11: Send Feedback about System's Recommendations and Insights to Help Improve Future Outputs" as CFR11
    
    C --> SFR20 : "Provide"
  }
}
@enduml