@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
}

package "System Administrator" {
  actor SysAdmin as SAFR003
}

rectangle "System" {
  usecase "CFR004: View Predictive Analytics" as SFR003
  usecase "SFR015: Request Predictive Intervention Analyses" as AIFR008
  
  CFR002 --> FAFR003 : (FAFR002)
}

rectangle "Client Dashboard" {
  usecase "CFR009: Access Personalized Dashboard" as SFR012
  usecase "SFR017: Generate Financial Health Reports" as AIFR009
  
  CFR001 --> SFR012 : (CFR004)
}

rectangle "Alerts and Notifications" {
  usecase "SFR013: Request Client Alerts" as SAFR005
  usecase "SFR016: Generate Predictive Insights" as AIFR016
  
  CFR002 --> SFR013 : (FAFR004)
}

rectangle "Recommendations and Personalization" {
  usecase "CFR008: View News Related to Portfolio" as SAFR007
  usecase "SFR002: Deliver Personalized Recommendations" as AIFR002
  
  CFR001 --> SFR002 : (CFR005)
}

rectangle "Investment Opportunities and Management" {
  usecase "CFR003: View Financial Predictions" as SAFR006
  usecase "SFR004: Request Personalized Recommendations from AI Component" as AIFR018
  
  CFR002 --> SFR004 : (FAFR005)
}

rectangle "Spending Limits and Alerts" {
  usecase "CFR006: View Spending Limit Alerts" as SAFR009
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as AIFR013
  
  CFR002 --> SFR005 : (FAFR004)
}

rectangle "Feedback and Improvement" {
  usecase "CFR11: Send Feedback about Recommendations" as SAFR019
}
@enduml