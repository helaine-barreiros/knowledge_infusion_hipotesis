@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  Client --> CFR001
  Client --> SAFR001
  SystemAdmin --> SAFR001
  FinancialAdvisor --> FAFR002
  FinancialAdvisor --> SFR003
  FinancialAdvisor --> AIFR009
}

rectangle "Client" {
  usecase "CFR002: View Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Goals" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds" as CFR006
  
  Client --> CFR002
  Client --> CFR003
  Client --> CFR004
  Client --> CFR005
  Client --> CFR006
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
  
  FinancialAdvisor --> FAFR001
  FinancialAdvisor --> FAFR003
}

rectangle "System Features" {
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002
  usecase "SFR004: Request Personalized Recommendations from the AI Component Based on Each User's Financial Data and Preferences" as SFR004
  usecase "SFR005: Request Spending Limit Alerts From the AI Component When User Spending Patterns Exceed Defined Thresholds" as SFR005
  
  System --> SFR002
  System --> SFR004
  System --> SFR005
}

rectangle "Investment Opportunities and News" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  
  Client --> CFR007
  Client --> CFR008
}

rectangle "User Feedback and Management" {
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights" as CFR11
  
  User --> CFR11
}
@enduml