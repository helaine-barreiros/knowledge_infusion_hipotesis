@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR002
  
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
}

package System {
  actor "System Administrator" as SAFR001
  
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  usecase "SFR10: Process Contextualized News for User's Financial Situations" as SFR10
  usecase "SFR11: Request Contextualized News Insights from AI Component" as SFR11
  usecase "SFR12: Generate Client Dashboards in an Intuitive Format" as SFR12
  usecase "SFR13: Generate Client Alerts Based on Predefined Conditions" as SFR13
  usecase "SFR14: Generate Client Analytics Providing Meaningful Insights" as SFR14
  usecase "SFR15: Request Predictive Intervention Analyses from AI Component" as SFR15
  usecase "SFR16: Request Predictive Insights from AI Component to Enhance Financial Guidance" as SFR16
  usecase "SFR17: Generate Financial Health Reports Assessing Users' Wellbeing" as SFR17
  usecase "SFR18: Manage User Goals Tracking Progress and Providing Recommendations" as SFR18
  usecase "SFR19: Maintain Historical Record of Insights for Trend Analysis" as SFR19
  usecase "SFR20: Manage User Feedback to Improve System Outputs" as SFR20
  
  SAFR001 --> (Manage analysis parameters)
}

package AI {
  actor "AI System" as AIFR001
    
  usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Matching User Strategies and Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts Compliant with FinCEN Requirements" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News and User Portfolios" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations Identifying Potential Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations" as AIFR009
  
  SFR012 --> (Generate client dashboards)
}

package User {
  actor "User" as CFR011
    
  usecase "Send Feedback about System's Recommendations and Insights" as CFR011
}

CFR001 --> (View Financial Insights Dashboard)
CFR001 --> (Receive Alerts About Anomalous Transactions)
CFR003 --> (View Financial Predictions Based on Historical Data and Market Trends)
CFR004 --> (Receive Personalized Recommendations Aligned with My Financial Profile and Goals)
CFR005 --> (Manage Personalized Recommendations Preferences)
CFR006 --> (View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories)
CFR007 --> (View Investment Opportunities Suitable to My Risk Profile)
CFR008 --> (View News Related to My Investment Portfolio)
CFR009 --> (Access Personalized Dashboard Consolidating Financial Information)
CFR10 --> (Manage Relationship with Financial Advisors)

FAFR002 --> FAFR003
FAFR002 --> FAFR004

SFR002 --> SFR005
SFR002 --> SFR006
SFR002 --> SFR007
SFR002 --> SFR018
SFR003 --> AIFR009
SFR004 --> AIFR002

AIFR003 --> (Generate spending limit alerts)
AIFR004 --> (Identify suitable investments for users based on their risk profiles and financial goals)

CFR11 --> CFR011

@enduml