@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as SAFR004
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as SAFR005
  usecase "CFR006: Manage Personalized Recommendations Preferences" as SAFR012
  usecase "CFR007: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as SAFR008
  
  CFR001 --> SAFR003
  CFR001 --> SAFR004
  CFR001 --> SAFR005
  CFR001 --> SAFR012
  CFR001 --> SAFR008
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations" as SAFR006
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as SAFR020
  
  FinancialAdvisor --> SAFR006
  FinancialAdvisor --> SAFR020
}

package "System Administrator" {
  actor SystemAdmin as SAFR001
  
  usecase "SAFR007: Manage Analysis Parameters for the AI System to Ensure Compliance with Financial Regulations" as SAFR009
  
  SystemAdmin --> SAFR009
}

rectangle "AI Component" {
  usecase "AIFR002: Generate Personalized Recommendations Based on My Financial Profiles, Goals, and Risk Tolerance" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as AIFR004
  
  SAFR012 --> (AIFR002)
}

rectangle "System" {
  usecase "SFR007: Request Investment Opportunity Analysis From the AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles" as SFR006
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions To Ensure Timely Notification of Important Financial Events" as SFR024
  
  SAFR012 --> (AIFR004)
}

rectangle "Notifications" {
  usecase "SFR008: Deliver Personalized Recommendations to Users Based On Their Financial Profiles" as SFR035
  usecase "SFR017: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According To Standard Financial Ratios and Metrics" as SFR046
  
  SAFR012 --> (AIFR002)
}

rectangle "News Processing" {
  usecase "SFR019: Request Contextualized News Insights From the AI Component to Identify Potential Impacts on Users' Investments" as SFR057
  usecase "SFR034: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as SFR068
  
  SAFR012 --> (AIFR007)
}

rectangle "Feedback Management" {
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights to Help Improve Future Outputs" as CFR039
}
@enduml