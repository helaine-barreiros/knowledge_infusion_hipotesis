@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001
:User: as User

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  
  Client --> CFR001
  Client --> (SFR009)
  Client --> (AIFR007)
  
  SysAdmin --> SAFR001
  
  FinancialAdvisor --> FAFR002
  FinancialAdvisor --> (FAFR003)
  FinancialAdvisor --> (FAFR004)
}

rectangle "User Interface" {
  usecase "CFR002: View Alerts about Anomalous Transactions" as CFR002
  usecase "SAFR005: Manage Personalized Recommendations Preferences" as SAFR005
  
  Client --> CFR002
  User --> (FAFR001)
  
  FinancialAdvisor --> SAFR005
}

rectangle "System Functions" {
  usecase "SFR003: Deliver Personalized Recommendations to Users" as SFR003
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  
  User --> (SFR003)
  
  FinancialAdvisor --> (FAFR015)
}

rectangle "Spending Limits and Alerts" {
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
  
  Client --> CFR006
}

rectangle "Investment Opportunities and Recommendations" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  
  Client --> CFR007
}

rectangle "News and Analytics" {
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  
  Client --> CFR008
}

rectangle "Client Relationship Management" {
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  User --> (FAFR005)
}
@enduml