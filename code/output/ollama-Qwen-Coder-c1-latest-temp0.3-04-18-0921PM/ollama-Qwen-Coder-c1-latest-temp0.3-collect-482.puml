@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Deliver Personalized Recommendations" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> FAFR002
  System --> (SFR003)
  System --> (AIFR004)
}

rectangle "Client Dashboard" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  
  Client --> CFR009
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR01: Manage Client Mentoring Sessions" as FAFR01
  usecase "FAFR03: View Predictive Analytics" as FAFR03
  usecase "SFR015: Request Predictive Intervention Analyses" as SFR015
  
  Financial Advisor --> (FAFR01)
  Financial Advisor --> (FAFR03)
  System --> (SFR015)
}

rectangle "System Operations" {
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  System --> (SFR002)
  System --> (AIFR009)
}

rectangle "Alerts and Notifications" {
  usecase "SFR013: Deliver Client Alerts" as SFR013
  usecase "SAFR007: Request Spending Limit Alerts" as SAFR007
  
  System --> (SFR013)
  System --> (SAFR007)
}

rectangle "News and Information" {
  usecase "CFR008: View News Related to Investment Portfolio" as CFR008
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  
  Client --> (CFR008)
  System --> (AIFR007)
}

rectangle "User Feedback" {
  usecase "CFR11: Send Feedback about Recommendations and Insights" as CFR11
  
  User -> (CFR11)
}
@enduml