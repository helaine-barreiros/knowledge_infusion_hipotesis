@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR005: Manage Recommendations Preferences" as SAFR005
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  Client --> (View Alerts)
  Client --> (Manage Relationship with Advisors)
  
  SysAdmin --> (Manage Analysis Parameters)
  
  FAFD --> (Mentoring Sessions Management)
  FAFD --> (Client Intervention Alerts)
}

rectangle "Notifications and Recommendations" {
  usecase "SFR013: Generate Client Alerts" as SFR013
  usecase "SFR020: Manage User Feedback" as SFR020
  
  Client --> (Receive Personalized Recommendations)
  
  SysAdmin --> (Process Contextualized News)
}

rectangle "Financial Predictions and Insights" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "SFR003: Request Financial Predictions" as SFR003
  
  Client --> (View Predictive Analytics)
  
  SysAdmin --> (Request Predictive Insights from AI)
}

rectangle "Spending Limits and Alerts" {
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "SFR005: Request Spending Limit Alerts" as SFR005
  
  Client --> (View Spending Limit Alerts)
}

rectangle "Investment Opportunities and Recommendations" {
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
  
  Client --> (View Investment Opportunities)
  
  SysAdmin --> (Request Specific Investment Opportunities from AI)
}

rectangle "News and Insights" {
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  usecase "SFR019: Maintain Historical Record of Insights" as SFR019
  
  Client --> (View Relevant Financial News)
}

rectangle "AI System Functions" {
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR005: Generate Investment Opportunities for Users" as AIFR005
  
  Client --> (Receive AI-Generated Insights)
  
  SysAdmin --> (Request Predictive Intervention Analyses from AI)
}

rectangle "User Feedback and Improvement" {
  usecase "CFR11: Send Feedback about Recommendations" as CFR11
}
@enduml