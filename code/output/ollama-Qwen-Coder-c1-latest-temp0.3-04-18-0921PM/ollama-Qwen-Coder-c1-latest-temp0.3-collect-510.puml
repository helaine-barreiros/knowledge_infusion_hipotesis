@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor (FA): as FA
:AIFR001: as AIFR001
:SFR020: as SFR020

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR005: Manage Analysis Parameters Preferences" as SAFR005
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  Client --> (CFR001)
  SysAdmin --> (SAFR005)
  FA --> (FAFR004)
}

rectangle "Client Dashboard Features" {
  usecase "CFR002: View Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Current Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as CFR004
  usecase "CFR010: Manage Relationship with Financial Advisors, Including Permissions for Sharing My Financial Data" as CFR010
  
  Client --> (CFR002)
  Client --> (CFR003)
  Client --> (CFR004)
  Client --> (CFR010)
}

rectangle "Financial Advisor Features" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts When the System Detects Patterns Requiring Professional Attention" as FAFR002
  
  FA --> (FAFR001)
  FA --> (FAFR002)
}

rectangle "System Features" {
  usecase "SFR001: Deliver Alerts to Users Through Appropriate Notification Channels" as SFR001
  usecase "SFR003: Request Financial Predictions from the AI Component" as SFR003
  
  System --> (SFR001)
  System --> (SFR003)
}

rectangle "AI Features" {
  usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance" as AIFR002
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
  
  System --> (AIFR002)
  System --> (AIFR006)
}

rectangle "User Feedback Feature" {
  usecase "CFR11: Send Feedback about the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as CFR11
  
  Client --> (CFR11)
  FA --> (CFR11)
  SysAdmin --> (CFR11)
}

@enduml