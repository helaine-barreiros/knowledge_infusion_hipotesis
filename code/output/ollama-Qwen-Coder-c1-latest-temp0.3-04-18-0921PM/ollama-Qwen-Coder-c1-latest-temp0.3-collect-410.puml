@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001
:User: as User

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  usecase "SFR013: Generate Client Alerts" as SFR013
  
  Client --> CFR001 : View Financial Insights Dashboard
  Client --> SAFR005 : Manage Personalized Recommendations Preferences
  Client --> FAFR002 : View Client Intervention Alerts
  Client --> AIFR006 : Receive Anomaly Transaction Alerts
  Client --> SFR013 : Receive Alerts
  
  SysAdmin --> SAFR001 : Manage Analysis Parameters
  SysAdmin --> SFR019 : Maintain Historical Record of Insights
  
  FAFR001 --> FAFR002 : View Client Intervention Alerts
  FAFR001 --> AIFR004 : Generate Investment Opportunity Analyses for Clients
  FAFR001 --> SFR016 : Provide Predictive Insights to Advisors

  User --> CFR011 : Send Feedback about System Recommendations and Insights
  
}

@enduml