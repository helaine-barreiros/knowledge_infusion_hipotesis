@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR002
}

package SystemAdmin {
  actor "System Administrator" as SAFR003
}

rectangle "AI Component" {
  usecase "AIFR001: Generate financial predictions" as AIFR001
  usecase "AIFR002: Generate personalized recommendations" as AIFR002
  usecase "AIFR003: Generate spending limit alerts" as AIFR003
  usecase "AIFR004: Generate investment opportunity analyses" as AIFR004
  usecase "AIFR005: Generate investment opportunities based on Modern Portfolio Theory principles" as AIFR005
  usecase "AIFR006: Generate anomaly transaction alerts" as AIFR006
  usecase "AIFR007: Generate contextualized news insights" as AIFR007
  usecase "AIFR008: Generate client predictive intervention recommendations" as AIFR008
  usecase "AIFR009: Generate client predictive insights" as AIFR009

  CFR001 --> (AIFR002)
  FAFR002 --> (AIFR004)
  SAFR003 --> (SAFR001)

  CFR001 --> (SFR007)
  FAFR002 --> (SFR008)
  SAFR003 --> (SFR009)

  CFR001 --> (AIFR006)
  FAFR002 --> (AIFR005)
}

rectangle "System" {
  usecase "SFR001: Deliver alerts to users through appropriate notification channels" as SFR001
  usecase "SFR002: Deliver personalized recommendations based on financial profiles" as SFR002
  usecase "SFR003: Request financial predictions from AI component" as SFR003
  usecase "SFR004: Request personalized recommendations from AI component" as SFR004
  usecase "SFR005: Request spending limit alerts from AI component" as SFR005
  usecase "SFR006: Request investment opportunity analysis from AI component" as SFR006
  usecase "SFR007: Request specific investment opportunities based on user criteria and ESG preferences" as SFR007
  usecase "SFR008: Request anomaly transaction alerts from AI component" as SFR008
  usecase "SFR009: Find contextualized news relevant to users' financial portfolios" as SFR009
  usecase "SFR10: Process contextualized news for user's financial situations" as SFR10
  usecase "SFR11: Request contextualized news insights from AI component" as SFR11
  usecase "SFR12: Generate client dashboards in an intuitive format" as SFR12
  usecase "SFR13: Generate client alerts based on predefined conditions" as SFR13
  usecase "SFR14: Generate client analytics for financial insights and performance" as SFR14
  usecase "SFR15: Request predictive intervention analyses from AI component" as SFR15
  usecase "SFR16: Request predictive insights from AI component to enhance guidance value" as SFR16
  usecase "SFR17: Generate financial health reports based on standard ratios and metrics" as SFR17
  usecase "SFR18: Manage users' financial goals for tracking progress and recommendations" as SFR18
  usecase "SFR19: Maintain historical record of user insights for trend analysis" as SFR19
  usecase "SFR20: Manage user feedback to improve system accuracy and relevance" as SFR20

  CFR001 --> (AIFR003)
  FAFR002 --> (AIFR008)
  SAFR003 --> (SAFR004)

  CFR001 --> (SFR006)
  FAFR002 --> (SFR005)
}

rectangle "User Interface" {
  usecase "CFR011: Send feedback about system's recommendations and insights" as CFR011

  CFR001 --> (CFR011)
  FAFR002 --> (CFR011)
  SAFR003 --> (CFR011)

  CFR001 --> (SFR20)
}

@enduml