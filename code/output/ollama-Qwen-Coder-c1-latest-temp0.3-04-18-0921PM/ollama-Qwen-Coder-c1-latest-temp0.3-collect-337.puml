@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations" as SFR002
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR010
  
  Client --> (SAFR003)
  Client --> (SFR002)
  Client --> (CFR010)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  usecase "FAFR002: View Intervention Alerts" as SAFR004
  usecase "FAFR003: View Predictive Analytics" as SFR006
  
  FinancialAdvisor --> (SAFR004)
  FinancialAdvisor --> (SFR006)
}

package "System Administrator" {
  actor SystemAdministrator as SAFR001
  
  usecase "SAFR005: Manage Analysis Parameters for AI System" as SAFR001
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as SFR023
  
  SystemAdministrator --> (SAFR001)
  SystemAdministrator --> (SFR023)
}

package "System Components" {
  rectangle "Alerts Management" {
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as AIFR003
    usecase "AIFR006: Generate Anomaly Transaction Alerts for Users" as SAFR008
    
    System --> (AIFR003)
    System --> (SAFR008)
  }
  
  rectangle "Recommendations Management" {
    usecase "SFR002: Request Personalized Recommendations from AI Component" as AIFR002
    usecase "SFR016: Generate Predictive Insights for Financial Guidance" as SFR016
    
    System --> (AIFR002)
    System --> (SFR016)
  }
  
  rectangle "Investment Management" {
    usecase "SFR007: Request Investment Opportunity Analysis from AI Component" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities for Users Based on Risk Profiles" as SFR013
    
    System --> (AIFR004)
    System --> (SFR013)
  }
  
  rectangle "News Management" {
    usecase "SFR009: Request Contextualized News from AI Component" as AIFR007
    usecase "SFR012: Generate Client Dashboards with Financial Information" as SFR012
    
    System --> (AIFR007)
    System --> (SFR012)
  }
  
  rectangle "Predictive Analytics Management" {
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as AIFR008
    usecase "SFR019: Maintain Historical Record of Users' Insights" as SFR019
    
    System --> (AIFR008)
    System --> (SFR019)
  }
}

package "AI System" {
  rectangle "Prediction Generation" {
    usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
    usecase "AIFR007: Generate Contextualized News Insights Based on User Portfolios" as AIFR009
    
    System --> (AIFR001)
    System --> (AIFR009)
  }
  
  rectangle "Recommendation Generation" {
    usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR001
    
    System --> (AIFR002)
    System --> (AIFR008)
  }
  
  rectangle "Investment Analysis Generation" {
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users Based on Risk Profiles and Time Horizons" as AIFR004
    usecase "AIFR015: Identify Financial Instruments Aligning with User Strategies and Modern Portfolio Theory Principles" as AIFR005
    
    System --> (AIFR004)
    System --> (AIFR015)
  }
  
  rectangle "Anomaly Detection Generation" {
    usecase "AIFR006: Generate Anomaly Transaction Alerts for Users in Compliance with FinCEN Requirements" as AIFR006
    
    System --> (AIFR006)
  }
}

rectangle "User Feedback Management" {
  usecase "CFR11: Send Feedback about Recommendations and Insights to Improve Future Outputs" as SFR020
  
  Client, FinancialAdvisor, SystemAdministrator --> (SFR020)
}
@enduml