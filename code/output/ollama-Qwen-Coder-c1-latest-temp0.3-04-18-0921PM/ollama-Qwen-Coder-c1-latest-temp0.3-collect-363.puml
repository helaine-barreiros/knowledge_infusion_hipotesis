@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
  
  rectangle "Client System" {
    usecase "SFR02: Generate Client Dashboards" as SFR02
    usecase "SFR03: Generate Personalized Recommendations" as SFR03
    usecase "SFR04: Request Financial Predictions" as SFR04
    usecase "SFR05: Request Spending Limit Alerts" as SFR05
    usecase "SFR06: Request Investment Opportunity Analysis" as SFR06
    usecase "SFR07: Request Specific Investment Opportunities" as SFR07
    usecase "SFR08: Request Anomaly Transaction Alerts" as SFR08
    usecase "SFR09: Find Contextualized News Relevant to Portfolio" as SFR09
    usecase "SFR10: Process Contextualized News for Users" as SFR10
    usecase "SFR11: Request Contextualized News Insights" as SFR11
    
    C --> SFR02
    C --> SFR03
    C --> SFR04
    C --> SFR05
    C --> SFR06
    C --> SFR07
    C --> SFR08
    C --> SFR09
    C --> SFR10
    C --> SFR11
    
    usecase "SFR20: Manage User Feedback" as SFR20
    C --> SFR20
  }
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004
  
  rectangle "Financial Advisor System" {
    usecase "SFR15: Request Predictive Intervention Analyses" as SFR15
    usecase "SFR16: Request Predictive Insights from AI Component" as SFR16
    
    FA --> SFR15
    FA --> SFR16
  }
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters for the AI System" as SAFR001
  
  SA --> SAFR001
  
  rectangle "System Admin System" {
    usecase "SFR20: Manage User Feedback" as SFR20
    SA --> SFR20
  }
}

package "AI System" {
  actor AI as AIF
  
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Aligning with User Strategies and MPT Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights Correlating with User Portfolios" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations Identifying Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations Supporting More Effective Planning" as AIFR009
  
  rectangle "AI System Components" {
    usecase "SFR12: Request Predictive Analytics from AI Component" as SFR12
    usecase "SFR13: Generate Client Alerts Based on Predefined Conditions" as SFR13
    usecase "SFR14: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR14
    
    AIF --> SFR12
    AIF --> SFR13
    AIF --> SFR14
  }
}

@enduml