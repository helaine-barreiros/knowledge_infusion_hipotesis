@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts About Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Current Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as CFR004
  usecase "CFR005: Manage Personalized Recommendations Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as CFR006
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "CFR009: Access a Personalized Dashboard That Consolidates Financial Information in a Single View" as CFR009
  usecase "CFR010: Manage Relationship with Financial Advisors, Including Permissions for Sharing Data" as CFR010
  
  C --> (View)
}

package "Financial Advisor" {
  actor FA as FFA
  
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts When Patterns Require Professional Attention" as FAFR002
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments Based on Different Profiles and Regulatory Requirements" as FAFR004
  
  FA --> (Manage)
}

package "System Administrator" {
  actor SA as SAA
  
  usecase "SAFR001: Manage Analysis Parameters for the AI System to Ensure Compliance with Financial Regulations" as SAFR001
  usecase "SFAFR002: Send Feedback About Recommendations and Insights" as SFAFR002
  
  SA --> (Manage)
}

package "System" {
  rectangle "Financial Insights & Predictions" {
    usecase "SFR003: Request Financial Predictions from the AI Component" as SFR003
    usecase "SFR014: Generate Client Analytics That Provide Meaningful Insights into Financial Behavior and Performance" as SFR014
  }
  
  rectangle "Personalized Recommendations & Alerts" {
    usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002
    usecase "SFR008: Request Anomaly Transaction Alerts from the AI Component by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as SFR008
  }
  
  rectangle "Spending Limits & Investment Opportunities" {
    usecase "SFR005: Request Spending Limit Alerts From the AI Component When User Spending Patterns Exceed Defined Thresholds" as SFR005
    usecase "SFR016: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as SFR016
  }
  
  rectangle "News & Dashboards" {
    usecase "SFR009: Request Contextualized News Relevant to Users' Financial Portfolios from Trusted Financial News Sources" as SFR009
    usecase "SFR12: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as SFR12
  }
  
  rectangle "Predictive Intervention & Reporting" {
    usecase "SFR15: Request Predictive Intervention Analyses From the AI Component to Identify When Financial Advisors Should Engage with Clients" as SFR15
    usecase "SFR017: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR017
  }
  
  rectangle "Feedback Management & Historical Record" {
    usecase "SFR20: Manage User Feedback To Continuously Improve the Quality and Relevance of Financial Insights" as SFR20
    usecase "SFR019: Maintain a Historical Record Of Users' Insights to Enable Trend Analysis and Effectiveness Measurement" as SFR019
  }
  
  rectangle "AI System Functions" {
    usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance As Defined By Industry Standards Like FINRA Guidelines" as AIFR002
  }
  
  rectangle "Spending Limit Alerts & Investment Opportunities Analysis" {
    usecase "AIFR003: Generate Spending Limit Alerts For Users by Identifying Unusual Deviations From Established Spending Patterns" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users By Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  }
  
  rectangle "Investment Opportunities & ESG Preferences" {
    usecase "AIFR005: Generate Investment Opportunities For Users by Identifying Financial Instruments That Align With Their Investment Strategies and Modern Portfolio Theory Principles" as AIFR005
    usecase "SFR17: Request Specific Investment Opportunities From the AI Component that Match User Investment Criteria and ESG Preferences" as SFR17
  }
  
  rectangle "Anomaly Transaction Alerts & Contextualized News Insights" {
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
    usecase "SFR18: Request Predictive Intervention Analyses From the AI Component to Identify When Financial Advisors Should Engage With Clients" as SFR18
  }
  
  rectangle "Client Predictive Insights & Recommendations" {
    usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
    usecase "SFR19: Request Predictive Intervention Analyses From the AI Component to Identify When Financial Advisors Should Engage With Clients" as SFR19
  }
  
  rectangle "Client Dashboards & Alerts Generation" {
    usecase "AIFR008: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR008
    usecase "SFR21: Request Contextualized News Insights From the AI Component to Identify Potential Impacts on Users' Investments" as SFR21
  }
  
  rectangle "Client Predictive Intervention Recommendations & Reporting" {
    usecase "AIFR009: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR009
    usecase "SFR23: Request Contextualized News Insights From the AI Component to Identify Relevant Impacts on Users' Investments" as SFR23
  }
}
@enduml