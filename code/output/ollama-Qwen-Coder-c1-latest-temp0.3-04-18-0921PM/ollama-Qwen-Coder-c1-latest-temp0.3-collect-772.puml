@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

' Actors
actor Client as CFR001
actor FinancialAdvisor as FAFR002
actor SysAdmin as SAFR003
actor User as CFR011

' Packages and Systems
package "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR005: Manage Recommendation Preferences" as SAFR005
}

package "Financial Advisor" {
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Clients" as FAFR004
}

package "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
}

rectangle System {
  package "Financial Insights" {
    usecase "SFR012: Generate Client Dashboards" as SFR012
    usecase "SFR014: Generate Client Analytics" as SFR014
    usecase "SFR017: Generate Financial Health Reports" as SFR017
  }
  
  package "Recommendations & Insights" {
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR004: Request Predictive Analytics from AI" as SFR004
    usecase "SFR016: Generate Client Predictive Insights" as SFR016
  }
  
  package "Alerts & Notifications" {
    usecase "SFR003: Deliver Alerts to Users" as SFR003
    usecase "AIFR008: Generate Anomaly Transaction Alerts" as AIFR008
    usecase "SFR015: Request Predictive Intervention Analyses from AI" as SFR015
  }
  
  package "Investment Opportunities & News" {
    usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities from AI" as SFR007
    usecase "AIFR012: Generate Contextualized News Insights" as AIFR012
  }
  
  package "User Feedback & Management" {
    usecase "CFR011: Send System Recommendations Feedback" as CFR011
    usecase "SFR019: Maintain Historical Record of Users' Insights" as SFR019
    usecase "SFR20: Manage User Feedback to Improve Outputs" as SFR20
  }
}

CFR001 --> (View Financial Insights Dashboard)
SAFR005 --> (Manage Recommendation Preferences)

FAFR002 --> (View Client Intervention Alerts)
FAFR003 --> (View Predictive Analytics)
FAFR004 --> (Configure Analysis Parameters for Clients)

SFR012 --> (Generate Client Dashboards)
SFR014 --> (Generate Client Analytics)
SFR017 --> (Generate Financial Health Reports)

SFR002 --> (Deliver Personalized Recommendations)
SFR004 --> (Request Predictive Analytics from AI)
SFR016 --> (Generate Client Predictive Insights)

SFR003 --> (Deliver Alerts to Users)
AIFR008 --> (Generate Anomaly Transaction Alerts)
SFR015 --> (Request Predictive Intervention Analyses from AI)

SFR006 --> (Request Investment Opportunity Analysis from AI)
SFR007 --> (Request Specific Investment Opportunities from AI)
AIFR012 --> (Generate Contextualized News Insights)

CFR011 --> (Send System Recommendations Feedback)
SFR019 --> (Maintain Historical Record of Users' Insights)
SFR20 --> (Manage User Feedback to Improve Outputs)
@enduml