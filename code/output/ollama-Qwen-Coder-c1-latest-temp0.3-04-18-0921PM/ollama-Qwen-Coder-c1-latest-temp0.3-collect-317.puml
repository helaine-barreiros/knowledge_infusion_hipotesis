@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> FAFR003
  Client --> SFR002 : "Receive Recommendations"
  System Admin --> SFR002 : "Manage Parameters"
}

rectangle "Client Dashboard" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  
  
  Client --> CFR009
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR001: Manage Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "SFR015: Request Predictive Interventions" as SFR015
  
  
  Financial Advisor --> FAFR001
  Financial Advisor --> FAFR002 : "Receive Alerts"
}

rectangle "System Functions" {
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "SFR004: Request Personalized Recommendations" as SFR004
  usecase "SFR005: Request Spending Limit Alerts" as SFR005
  
  
  System Admin --> SFR003 : "Manage Parameters"
}

rectangle "AI Functions" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  
  System Admin --> AIFR001 : "Manage Parameters"
}

rectangle "News and Alerts Functions" {
  usecase "SFR008: Request Contextualized News Insights" as SFR008
  usecase "AIFR007: Generate Client Predictive Insights" as AIFR007
  
  
  System Admin --> SFR008 : "Manage Parameters"
}

rectangle "Feedback Functions" {
  usecase "CFR11: Send Feedback" as CFR11
  
  
  Client --> CFR11
  Financial Advisor --> CFR11
  SysAdmin --> CFR11
}
@enduml