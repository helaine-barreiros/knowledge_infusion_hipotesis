@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Deliver Personalized Recommendations" as SFR003
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> FAFR002
}

rectangle "Client Dashboard Features" {
  usecase "CFR002: View Alerts About Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Current Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as CFR004
  usecase "CFR005: Manage Personalized Recommendations Preferences to Ensure the System Provides Insights Relevant to My Financial Objectives and Risk Tolerance" as CFR005
  usecase "SFR12: Generate Client Dashboards that Present Financial Information in an Intuitive and Actionable Format" as SFR12
  
  Client --> CFR002
  Client --> CFR003
  Client --> CFR004
  Client --> CFR005
}

rectangle "Financial Advisor Features" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights to Provide More Valuable Guidance Aligned with Each Client's Financial Goals" as FAFR001
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as FAFR003
  
  FAFD --> FAFR001
  FAFD --> FAFR003
}

rectangle "System Features" {
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles to Support Better Financial Decision-Making" as SFR002
  usecase "SFR004: Request Financial Predictions from the AI Component to Provide Users with Forward-Looking Financial Insights" as SFR004
  usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
  
  Sys --> SFR002
  Sys --> SFR004
}

rectangle "User Feedback Management" {
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as CFR011
  
  Client --> CFR011
}
@enduml