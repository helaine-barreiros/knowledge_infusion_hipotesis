@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SysAdmin as SA
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SA --> (SAFR001)
}

rectangle System {
  package "Notifications" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    
    C --> (SFR001)
    FA --> (SFR001)
    SA --> (SFR001)
  }
  
  package "Recommendations" {
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
    
    C --> (SFR002)
    FA --> (SFR002)
    SA --> (AIFR002)
  }
  
  package "Predictions and Insights" {
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR016: Request Predictive Insights from the AI Component to Enhance Value of Guidance Provided to Clients" as SFR016
    usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Data, Market Trends, and Economic Indicators" as AIFR001
    
    C --> (SFR003)
    FA --> (SFR016)
    SA --> (AIFR001)
  }
  
  package "Spending Limits" {
    usecase "SFR005: Request Spending Limit Alerts from AI Component When User Spending Patterns Exceed Defined Thresholds" as SFR005
    usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations From Established Spending Patterns" as AIFR003
    
    C --> (SFR005)
    FA --> (SFR005)
    SA --> (AIFR003)
  }
  
  package "Investment Opportunities" {
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles" as SFR006
    usecase "SFR015: Generate Predictive Intervention Analyses From the AI Component to Identify When Financial Advisors Should Engage With Clients" as SFR015
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
    
    C --> (SFR006)
    FA --> (SFR015)
    SA --> (AIFR004)
  }
  
  package "Anomaly Detection" {
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component to Detect Potentially Fraudulent Activities in Accordance With AML Regulations" as SFR008
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities In Compliance with FinCEN Requirements" as AIFR006
    
    C --> (SFR008)
    FA --> (SFR008)
    SA --> (AIFR006)
  }
  
  package "News and Insights" {
    usecase "SFR012: Generate Client Dashboards that Present Financial Information in an Intuitive and Actionable Format" as SFR012
    usecase "SFR009: Request Contextualized News from Trusted Financial News Sources to Identify Relevant Impacts on Users' Investments" as SFR009
    usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
    
    C --> (SFR12)
    FA --> (SFR009)
    SA --> (AIFR007)
  }
  
  package "Health Reports and Goals Management" {
    usecase "SFR014: Generate Client Analytics that Provide Meaningful Insights Into Financial Behavior and Performance" as SFR014
    usecase "SFR020: Manage Users' Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR020
    
    C --> (SFR014)
    FA --> (SFR020)
    SA --> (SFR020)
  }
}

package "AI System" {
  usecase "AIFR005: Generate Investment Opportunities for Users by Identifying Financial Instruments That Align with Their Investment Strategies and Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR017: Generate Financial Health Reports that Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as AIFR017
  
  C --> (AIFR005)
  FA --> (AIFR005)
  SA --> (AIFR005)
  
  C --> (AIFR017)
  FA --> (AIFR017)
  SA --> (AIFR017)
}

package "Feedback" {
  usecase "CFR11: Send Feedback about System's Recommendations and Insights to Improve Future Outputs" as CFR11
  
  C --> (CFR11)
}
@enduml