@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
}

package "System Administrator" {
  actor SysAdmin as SAFR001
}

rectangle "System" {
  usecase "CFR003: View Financial Predictions" as SFR004
  usecase "CFR005: Manage Recommendations Preferences" as CFR005
  usecase "SFR020: Manage User Feedback" as AIFR019
  
  rectangle "Financial Insights Dashboard" {
    usecase "CFR001: View Financial Insights Dashboard" as CFR001
    usecase "CFR006: View Spending Limit Alerts" as SFR005
    usecase "SFR12: Generate Client Dashboards" as AIFR017
  }
  
  rectangle "Alerts and Notifications" {
    usecase "SFR08: Request Anomaly Transaction Alerts" as SFR08
    usecase "SFR13: Generate Client Alerts" as AIFR016
    usecase "SFR21: Send Feedback about Recommendations" as CFR011
  }
  
  rectangle "Recommendations and Insights" {
    usecase "CFR004: Receive Personalized Recommendations" as SFR02
    usecase "FAFR003: View Predictive Analytics" as AIFR016
    usecase "SFR09: Request Contextualized News Insights" as SFR07
  }
  
  rectangle "Investment Opportunities and Analysis" {
    usecase "CFR008: View Investment Opportunities" as FAFR003
    usecase "FAFR004: Configure Analysis Parameters for Client Segments" as SAFR002
    usecase "SFR15: Request Predictive Intervention Analyses" as AIFR009
  }
  
  rectangle "Mentoring and Support" {
    usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  }
}

CFR001 --> SFR04
SFR02 <|-- CFR004
SAFR005 <|-- CFR005
AIFR019 <|-- CFR011

FAFR003 --> AIFR006
FAFR007 --> SFR09
FAFR008 --> AIFR007

SFR04 --> SFR21
CFR005 --> AIFR019
AIFR016 <|-- FAFR003
AIFR016 <|-- SAFR002
FAFR008 --> AIFR007

@enduml