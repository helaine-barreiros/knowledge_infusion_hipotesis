@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> CFR001 : "View"
  C --> CFR002 : "Receive Alerts"
  C --> CFR003 : "Predictions"
  C --> CFR004 : "Recommendations"
  C --> CFR005 : "Manage Preferences"
  C --> CFR006 : "Spending Limits"
  C --> CFR007 : "Opportunities"
  C --> CFR008 : "News"
  C --> CFR009 : "Dashboard"
  C --> CFR10 : "Relationships"
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> FAFR001 : "Manage Sessions"
  FA --> FAFR002 : "Receive Alerts"
  FA --> FAFR003 : "Predictive Analytics"
  FA --> FAFR004 : "Configure Parameters"
}

package "System" {
  actor System as Sys
  
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities from AI Component" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  usecase "SFR010: Process Contextualized News for Users" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics for Financial Behavior and Performance" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
  usecase "SFR016: Request Predictive Insights from AI Component to Enhance Guidance" as SFR016
  usecase "SFR017: Generate Financial Health Reports for Users" as SFR017
  usecase "SFR018: Manage Users' Financial Goals and Track Progress" as SFR018
  usecase "SFR019: Maintain Historical Record of Insights for Trend Analysis" as SFR019
  usecase "SFR020: Manage User Feedback to Improve System Outputs" as SFR020
  
  Sys --> SFR001 : "Deliver Alerts"
  Sys --> SFR002 : "Recommendations"
  Sys --> SFR003 : "Predictions"
  Sys --> SFR004 : "Personalized Recommendations"
  Sys --> SFR005 : "Spending Limits"
  Sys --> SFR006 : "Investment Opportunities"
  Sys --> SFR007 : "Specific Investments"
  Sys --> SFR008 : "Anomaly Alerts"
  Sys --> SFR009 : "Find News"
  Sys --> SFR010 : "Process News"
  Sys --> SFR011 : "News Insights"
  Sys --> SFR012 : "Dashboards"
  Sys --> SFR013 : "Client Alerts"
  Sys --> SFR014 : "Analytics"
  Sys --> SFR015 : "Predictive Interventions"
  Sys --> SFR016 : "Enhanced Guidance"
  Sys --> SFR017 : "Financial Health Reports"
  Sys --> SFR018 : "Manage Goals"
  Sys --> SFR019 : "Historical Record"
  Sys --> SFR020 : "User Feedback"
}

package "AI System" {
  actor AI as AIF
  
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Based on User Strategies and MPT Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Pattern Recognition" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights for Users' Portfolios" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations Based on Patterns" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights to Support Forward-Looking Analysis" as AIFR009
  
  AI --> AIFR001 : "Predictions"
  AI --> AIFR002 : "Recommendations"
  AI --> AIFR003 : "Spending Limits"
  AI --> AIFR004 : "Opportunities"
  AI --> AIFR005 : "Investment Opportunities"
  AI --> AIFR006 : "Anomaly Alerts"
  AI --> AIFR007 : "News Insights"
  AI --> AIFR008 : "Predictive Interventions"
  AI --> AIFR009 : "Predictive Insights"
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters for the AI System" as SAFR001
  usecase "CFR11: Send Feedback to Improve Recommendations and Insights" as CFR11
  
  SA --> SAFR001 : "Manage Parameters"
  SA --> CFR11 : "Send Feedback"
}

@enduml