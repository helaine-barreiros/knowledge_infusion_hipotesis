@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Get Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Receive Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access Financial News" as CFR008
  usecase "CFR009: View Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> CFR001 : "View"
  C --> CFR002 : "Receive Alerts on Anomalous Transactions"
  C --> CFR003 : "View Predictions"
  C --> CFR004 : "Get Recommendations"
  C --> CFR005 : "Manage Preferences"
  C --> CFR006 : "Receive Spending Limit Alerts"
  C --> CFR007 : "View Opportunities"
  C --> CFR008 : "Access News"
  C --> CFR009 : "View Dashboard"
  C --> CFR10 : "Manage Relationship with Advisors"
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> FAFR001 : "Manage Sessions"
  FA --> FAFR002 : "View Alerts"
  FA --> FAFR003 : "View Analytics"
  FA --> FAFR004 : "Configure Parameters"
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR020: Manage User Feedback" as SFR020
  
  SA --> SAFR001 : "Manage"
  SA --> SFR020 : "Manage Feedback"
}

package "System" {
  rectangle SystemBoundary {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities from AI Component" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
    usecase "SFR010: Process Contextualized News for Users" as SFR010
    usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
    usecase "SFR012: Generate Client Dashboards" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
    usecase "SFR014: Generate Client Analytics" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
    usecase "SFR016: Request Predictive Insights from AI Component" as SFR016
    usecase "SFR017: Generate Financial Health Reports" as SFR017
    usecase "SFR018: Manage Users' Financial Goals" as SFR018
    usecase "SFR019: Maintain Historical Record of Insights" as SFR019
    
    C --> SFR001 : "Receive Alerts"
    FA --> SFR002 : "Deliver Recommendations"
    C --> SFR003 : "Request Predictions"
    C --> SFR004 : "Request Recommendations"
    C --> SFR005 : "Request Spending Limit Alerts"
    C --> SFR006 : "Request Investment Opportunities"
    C --> SFR007 : "Request Specific Opportunities"
    C --> SFR008 : "Request Anomaly Transaction Alerts"
    C --> SFR009 : "Access News"
    FA --> SFR010 : "Process News for Advisor Insights"
    C --> SFR011 : "Receive Contextualized Insights"
    SA --> SFR020 : "Manage Feedback"
  }
}

package "AI System" {
  rectangle AIBoundary {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on Strategies" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
    
    C --> AIFR001 : "Generate Predictions"
    FA --> AIFR002 : "Provide Recommendations"
    C --> AIFR003 : "Identify Spending Limit Alerts"
    C --> AIFR004 : "Evaluate Investment Opportunities"
    C --> AIFR005 : "Select Investments Based on Strategies"
    C --> AIFR006 : "Detect Anomalies"
    C --> AIFR007 : "Correlate News Insights"
    FA --> AIFR008 : "Provide Predictive Recommendations"
    C --> AIFR009 : "Generate Forward-Looking Analysis"
  }
}

package "User" {
  actor User as U
  
  usecase "CFR11: Send Feedback about System's Recommendations and Insights" as CFR11
  
  U --> CFR11 : "Send Feedback"
}
@enduml