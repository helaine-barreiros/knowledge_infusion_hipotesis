@startuml
left to right direction

title Use Case Diagram for AI-Powered Financial Insights & Advisory System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> (View Financial Insights Dashboard)
  C --> (Receive Anomaly Transaction Alerts)
  C --> (View Financial Predictions)
  C --> (Receive Personalized Recommendations)
  C --> (Manage Recommendation Preferences)
  C --> (View Spending Limit Alerts)
  C --> (View Investment Opportunities)
  C --> (View Financial News)
  C --> (Access Personalized Dashboard)
  C --> (Manage Relationship with Advisors)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FA --> (Manage Client Mentoring Sessions)
  FA --> (View Client Intervention Alerts)
  FA --> (View Predictive Analytics for Clients)
  FA --> (Configure Analysis Parameters for Specific Client Segments)
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFAFR002: Send Feedback about Recommendations and Insights" as SFAFR002
  
  SA --> (Manage Analysis Parameters)
  SA --> (Send Feedback about Recommendations and Insights)
}

package "System Components" {
  rectangle "AI System" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Financial Opportunities Based on Modern Portfolio Theory" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights for Forward-Looking Analysis" as AIFR009
    
    SystemAdmin --> (Manage Analysis Parameters)
  }
  
  rectangle "Notification Channel" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
    
    C --> (Deliver Alerts to Users)
  }
  
  rectangle "Recommendation Engine" {
    usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
    usecase "AIFR004: Generate Investment Opportunity Analyses Based on User Preferences and Risk Tolerance" as AIFR004
    
    C --> (Deliver Personalized Recommendations)
  }
  
  rectangle "Prediction Engine" {
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "AIFR001: Generate Financial Predictions Based on Historical Data and Market Trends" as AIFR001
    
    C --> (Request Financial Predictions)
  }
  
  rectangle "Recommendation Engine" {
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    usecase "AIFR002: Generate Personalized Recommendations Based on User Profiles and Goals" as AIFR002
    
    C --> (Request Personalized Recommendations)
  }
  
  rectangle "Spending Limit Alert Engine" {
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "AIFR003: Generate Spending Limit Alerts Based on User Spending Patterns and Thresholds" as AIFR003
    
    C --> (Request Spending Limit Alerts)
  }
  
  rectangle "Investment Opportunity Engine" {
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "AIFR004: Generate Investment Opportunities Based on User Risk Profiles and Financial Goals" as AIFR004
    
    C --> (Request Investment Opportunities)
  }
  
  rectangle "News Engine" {
    usecase "SFR007: Request Contextualized News Insights from AI Component" as SFR007
    usecase "AIFR007: Generate Contextualized News Insights Based on User Portfolios and ESG Preferences" as AIFR007
    
    C --> (Request Contextualized News)
  }
  
  rectangle "Predictive Intervention Engine" {
    usecase "SFR15: Request Predictive Intervention Analyses from AI Component" as SFR15
    usecase "AIFR08: Generate Client Predictive Intervention Recommendations Based on User Financial Data and Patterns" as AIFR08
    
    FA --> (Request Predictive Intervention)
  }
  
  rectangle "Predictive Insights Engine" {
    usecase "SFR16: Request Predictive Insights from AI Component" as SFR16
    usecase "AIFR09: Generate Client Predictive Insights for Forward-Looking Analysis Based on User Financial Data and Goals" as AIFR09
    
    FA --> (Request Predictive Insights)
  }
  
  rectangle "Financial Health Report Engine" {
    usecase "SFR17: Request Financial Health Reports from AI Component" as SFR17
    usecase "AIFR05: Generate Financial Opportunities Based on Modern Portfolio Theory Principles and User Goals" as AIFR05
    
    FA --> (Request Financial Health Reports)
  }
  
  rectangle "Feedback Engine" {
    usecase "SFR20: Manage Users' Feedback to Improve Recommendations" as SFR20
    usecase "AIFR10: Generate Client Predictive Insights for Forward-Looking Analysis Based on User Financial Data and Goals" as AIFR10
    
    C --> (Manage Feedback)
  }
}

@enduml