@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Analysis Parameters" as SAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "SFR004: Request Financial Predictions" as SFR004
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  
  Client --> CFR001 : "View"
  SysAdmin --> SAFR002 : "Manage"
  FAFD --> FAFR003 : "View"
}

rectangle "Client Notifications & Alerts" {
  usecase "SFR005: Request Spending Limit Alerts" as SFR005
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  
  Client --> SFR005 : "View"
}

rectangle "Investment Opportunities & Recommendations" {
  usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  Client --> SFR006 : "View"
}

rectangle "Financial Advisors & Mentoring" {
  usecase "FAFR001: Manage Client Sessions" as FAFR001
  usecase "SFR007: Request Predictive Intervention Analyses" as SFR007
  
  Financial Advisor --> FAFR001 : "Manage"
}

rectangle "News & Information" {
  usecase "SFR008: Find Contextualized News" as SFR008
  usecase "AIFR005: Generate Contextualized Insights" as AIFR005
  
  Client --> SFR008 : "View"
}

rectangle "User Feedback & Improvement" {
  usecase "CFR11: Send Feedback" as CFR11
  
  Client --> CFR11 : "Provide"
  Financial Advisor --> CFR11 : "Provide"
  System Admin --> CFR11 : "Provide"
}
@enduml