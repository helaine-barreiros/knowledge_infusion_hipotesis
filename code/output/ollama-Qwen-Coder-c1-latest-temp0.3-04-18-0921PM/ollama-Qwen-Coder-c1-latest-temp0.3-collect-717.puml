@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> CFR001 : "View"
  C --> CFR002 : "Receive Alerts"
  C --> CFR003 : "Predictions"
  C --> CFR004 : "Recommendations"
  C --> CFR005 : "Manage Preferences"
  C --> CFR006 : "Spending Limits"
  C --> CFR007 : "Investment Opportunities"
  C --> CFR008 : "News"
  C --> CFR009 : "Dashboard"
  C --> CFR10 : "Relationship Management"
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> FAFR001 : "Manage Sessions"
  FA --> FAFR002 : "View Alerts"
  FA --> FAFR003 : "Predictive Analytics"
  FA --> FAFR004 : "Configure Parameters"
}

package "System" {
  actor System as Sys
  
  usecase "SFR001: Deliver Alerts" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
  usecase "SFR005: Request Spending Limit Alerts" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to User's Portfolio" as SFR009
  usecase "SFR010: Process Contextualized News for Users' Financial Situations" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI" as SFR011
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics Providing Meaningful Insights" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI" as SFR015
  usecase "SFR016: Request Predictive Insights From the AI Component to Enhance Financial Guidance" as SFR016
  usecase "SFR017: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing" as SFR017
  usecase "SFR018: Manage Users' Financial Goals Tracking Progress and Providing Relevant Recommendations" as SFR018
  usecase "SFR019: Maintain Historical Record of Users' Insights for Trend Analysis" as SFR019
  usecase "SFR020: Manage User Feedback to Continuously Improve System Outputs" as SFR020
  
  Sys --> SFR001 : "Deliver Alerts"
  Sys --> SFR002 : "Deliver Recommendations"
  Sys --> SFR003 : "Request Predictions"
  Sys --> SFR004 : "Request AI Recommendations"
  Sys --> SFR005 : "Request Spending Limit Alerts"
  Sys --> SFR006 : "Request Investment Opportunity Analysis"
  Sys --> SFR007 : "Request Specific Opportunities"
  Sys --> SFR008 : "Request Anomaly Transaction Alerts"
  Sys --> SFR009 : "Find Contextualized News"
  Sys --> SFR010 : "Process News for Users"
  Sys --> SFR011 : "Request News Insights from AI"
  Sys --> SFR012 : "Generate Dashboards"
  Sys --> SFR013 : "Generate Alerts Based on Conditions"
  Sys --> SFR014 : "Generate Client Analytics"
  Sys --> SFR015 : "Request Predictive Intervention Analyses"
  Sys --> SFR016 : "Request Predictive Insights for Guidance"
  Sys --> SFR017 : "Generate Financial Health Reports"
  Sys --> SFR018 : "Manage Users' Goals and Recommendations"
  Sys --> SFR019 : "Maintain Historical Record of Insights"
  Sys --> SFR020 : "Manage User Feedback for Improvement"
}

package "AI System" {
  actor AI as A
  
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations Based on Industry Standards" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Aligning with User Strategies and Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News with User Portfolios" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Potential Difficulties or Opportunities" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations" as AIFR009
  
  AI --> AIFR001 : "Generate Predictions"
  AI --> AIFR002 : "Generate Recommendations Based on Standards"
  AI --> AIFR003 : "Generate Spending Limit Alerts"
  AI --> AIFR004 : "Generate Investment Analysis"
  AI --> AIFR005 : "Generate Investment Opportunities"
  AI --> AIFR006 : "Generate Anomaly Transaction Alerts"
  AI --> AIFR007 : "Generate News Insights"
  AI --> AIFR008 : "Generate Intervention Recommendations"
  AI --> AIFR009 : "Generate Predictive Insights"
}

package "User" {
  actor User as U
  
  usecase "CFR11: Send Feedback to Improve System Outputs" as CFR11
  U --> CFR11 : "Send Feedback"
}
@enduml