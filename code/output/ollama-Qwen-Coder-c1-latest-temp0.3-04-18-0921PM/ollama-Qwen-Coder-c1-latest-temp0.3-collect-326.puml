@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SystemAdmin as SA
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SA --> (SAFR001)
}

package "System" {
  rectangle "AI Component" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
    
    C --> (SFR012)
    FA --> (SFR016)
  }
  
  rectangle "Notification Service" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
  }
  
  rectangle "Recommendation Engine" {
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    
    C --> (AIFR002)
    FA --> (AIFR002)
  }
  
  rectangle "Prediction Service" {
    usecase "SFR003: Request Financial Predictions" as SFR003
    usecase "SFR014: Generate Client Analytics" as SFR014
    
    C --> (AIFR001)
  }
  
  rectangle "Recommendation Service" {
    usecase "SFR004: Request Personalized Recommendations" as SFR004
    usecase "SFR020: Manage User Feedback" as SFR020
    
    C --> (AIFR002)
    FA --> (AIFR002)
  }
  
  rectangle "Spending Limit Service" {
    usecase "SFR005: Request Spending Limit Alerts" as SFR005
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    
    C --> (AIFR003)
  }
  
  rectangle "Investment Opportunity Service" {
    usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
    usecase "SFR11: Generate Specific Investment Opportunities Matching User Criteria and ESG Preferences" as SFR11
    
    C --> (AIFR004)
  }
  
  rectangle "Anomaly Transaction Service" {
    usecase "SFR008: Request Anomaly Transaction Alerts" as SFR008
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    
    C --> (AIFR006)
  }
  
  rectangle "News Service" {
    usecase "SFR009: Request Contextualized News Insights" as SFR009
    usecase "SFR12: Generate Client Alerts Based on Predefined Conditions" as SFR12
    
    C --> (AIFR007)
  }
  
  rectangle "Predictive Intervention Service" {
    usecase "SFR15: Request Predictive Intervention Analyses" as SFR15
    usecase "AIFR008: Generate Client Predictive Insights" as AIFR008
    
    FA --> (AIFR009)
  }
  
  rectangle "Health Report Service" {
    usecase "SFR17: Generate Financial Health Reports" as SFR17
  }
}

package "User Feedback Management" {
  usecase "CFR11: Send Feedback about System's Recommendations and Insights" as CFR11
  
  C --> (AIFR002)
  FA --> (AIFR002)
  SA --> (SFR20)
}
@enduml