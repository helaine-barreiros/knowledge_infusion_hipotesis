@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FinancialAdvisor
:User: as User

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
  
  User --> CFR001 : "View Financial Insights Dashboard"
  User --> SAFR001 : "Manage Analysis Parameters"
  Client --> FAFR002 : "View Client Intervention Alerts"
  SysAdmin --> SAFR001 : "Manage Analysis Parameters"
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  
  FinancialAdvisor --> FAFR001 : "Manage Client Mentoring Sessions"
  FinancialAdvisor --> FAFR003 : "View Predictive Analytics"
}

rectangle "System Components" {
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  System --> SFR002 : "Deliver Personalized Recommendations"
  System --> AIFR002 : "Generate Personalized Recommendations"
}

rectangle "Notifications & Alerts" {
  usecase "SFR013: Generate Client Alerts" as SFR013
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  
  System --> SFR013 : "Generate Client Alerts"
  System --> AIFR006 : "Generate Anomaly Transaction Alerts"
}

rectangle "News & Insights" {
  usecase "SFR008: Find Contextualized News" as SFR008
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  
  System --> SFR008 : "Find Contextualized News"
  System --> AIFR007 : "Generate Contextualized News Insights"
}

rectangle "Dashboards & Reports" {
  usecase "SFR12: Generate Client Dashboards" as SFR12
  usecase "AIFR017: Generate Financial Health Reports" as AIFR017
  
  System --> SFR12 : "Generate Client Dashboards"
  System --> AIFR017 : "Generate Financial Health Reports"
}

rectangle "Feedback & Improvement" {
  usecase "CFR011: Send Feedback about Recommendations and Insights" as CFR011
  usecase "AIFR020: Generate User Feedback Management" as AIFR020
  
  System --> CFR011 : "Send Feedback about Recommendations and Insights"
  System --> AIFR020 : "Generate User Feedback Management"
}

@enduml