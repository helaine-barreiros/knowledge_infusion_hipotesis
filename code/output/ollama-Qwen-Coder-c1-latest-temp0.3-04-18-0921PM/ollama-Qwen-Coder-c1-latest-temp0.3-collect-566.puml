@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (View)
}

package "Financial Advisors" {
  actor Advisor as A
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  A --> (Manage)
}

package "System Administrator" {
  actor SysAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR020: Manage User Feedback" as SFR020
  
  SA --> (Manage)
}

rectangle System {
  package "System Functions" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities from AI Component" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
    usecase "SFR010: Process Contextualized News for Users" as SFR010
    usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
    usecase "SFR012: Generate Client Dashboards" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
    usecase "SFR014: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
    usecase "SFR016: Request Predictive Insights from AI Component to Enhance Value of Guidance Provided to Clients" as SFR016
    usecase "SFR017: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing" as SFR017
    usecase "SFR018: Manage Users' Financial Goals Tracking Progress and Providing Relevant Recommendations" as SFR018
    usecase "SFR019: Maintain Historical Record of Users' Insights for Trend Analysis and Effectiveness Measurement" as SFR019
    
  }
  
  package "AI Functions" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations Based on Industry Standards" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Patterns" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users Based on Their Risk Profiles and Goals" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Aligning with User Strategies and Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News with Specific User Portfolios" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Planning" as AIFR009
    
  }
  
}

C --> (SFR012)
A --> (SFR016)
SA --> (SFR017)

@enduml