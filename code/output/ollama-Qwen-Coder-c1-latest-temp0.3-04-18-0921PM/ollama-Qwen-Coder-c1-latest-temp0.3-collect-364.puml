@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FAFR

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics about My Clients' Financial Situations" as FAFR003
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002
  usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
  
  User --> CFR001
  SysAdmin --> SAFR001
  FAFR --> FAFR003
  SFR002 <|-- (SFR004)
  SFR002 <|-- (AIFR002)
}

rectangle "Client" {
  usecase "CFR002: Receive Alerts about Anomalous Transactions in My Accounts" as CFR002
  usecase "CFR003: View Financial Predictions Based on My Historical Data and Current Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as CFR004
  usecase "CFR005: Manage My Personalized Recommendations Preferences to Ensure the System Provides Insights Relevant to My Financial Objectives and Risk Tolerance As Defined in My KYC (Know Your Customer) Profile" as CFR005
  usecase "CFR006: View Spending Limit Alerts When I Exceed Predefined Thresholds in Specific Expense Categories to Maintain Better Control Over My Budget" as CFR006
  
  User --> CFR002
  User --> CFR003
  User --> CFR004
  User --> CFR005
  User --> CFR006
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights to Provide More Valuable Guidance Aligned with Each Client's Financial Goals" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts When the System Detects Patterns Requiring Professional Attention to Proactively Assist Clients With Potential Financial Issues" as FAFR002
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments to Customize the System's Behavior According to Different Client Profiles and Regulatory Requirements Such As GDPR or CCPA" as FAFR004
  
  User --> FAFR001
  User --> FAFR002
  User --> FAFR004
}

rectangle "System" {
  usecase "SFR003: Request Financial Predictions from the AI Component to Provide Users With Forward-Looking Financial Insights" as SFR003
  usecase "SFR005: Request Spending Limit Alerts From the AI Component When User Spending Patterns Exceed Defined Thresholds" as SFR005
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  
  System Admin --> SAFR001
  User --> SFR003
  User --> SFR005
  FAFR --> (FAFR002)
}

rectangle "Client Dashboard" {
  usecase "SFR012: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as SFR012
  
  User --> SFR012
}

rectangle "News & Insights" {
  usecase "CFR008: View News Related to My Investment Portfolio to Stay Informed About Market Events that Might Affect My Assets" as CFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios from Trusted Financial News Sources" as SFR009
  
  User --> CFR008
  User --> SFR009
}

rectangle "Feedback Mechanism" {
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as CFR11
  
  User --> CFR11
}
@enduml