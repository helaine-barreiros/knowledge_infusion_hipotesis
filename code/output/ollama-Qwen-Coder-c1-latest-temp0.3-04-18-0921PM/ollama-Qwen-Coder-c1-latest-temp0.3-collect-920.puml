@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations" as SFR002
  usecase "CFR005: Manage Recommendation Preferences" as CFR010
  
  Client --> SAFR003 : "View Alerts"
  Client --> SFR002 : "Receive Recommendations"
  Client --> CFR010 : "Manage Preferences"
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as SAFR005
  
  FinancialAdvisor --> SFR006 : "View Investment Opportunities"
  FinancialAdvisor --> SFR007 : "Configure Recommendations Based on Client Profiles"
}

package "System Administrator" {
  actor SystemAdministrator as SAFR001
  usecase "SAFR002: Manage Analysis Parameters for the AI System" as SAFR004
  
  SystemAdministrator --> SAFR004 : "Manage Parameters"
}

rectangle "AI Component" {
  usecase "AIFR003: Generate Spending Limit Alerts" as SFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as SFR008
  
  SAFR004 --> AIFR002 : "Generate Recommendations"
}

rectangle "System" {
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR017: Generate Financial Health Reports" as SAFR018
  
  System --> SFR012 : "Generate Dashboards"
}

rectangle "News Component" {
  usecase "AIFR007: Generate Contextualized News Insights" as SFR014
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SAFR006
  
  System --> AIFR007 : "Request News"
}

rectangle "User Interface Component" {
  usecase "CFR011: Send Feedback about the System's Recommendations and Insights" as SFR020
}
@enduml