@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: Access Investment Opportunities" as CFR007
  usecase "CFR008: Receive News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (SAFR005) : "Manage Preferences"
  C --> (SFR020) : "Send Feedback"
}

package System {
  actor "System Admin" as SysAdmin
  actor "Financial Advisor" as FAFR
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  SysAdmin --> SAFR001
  FAFR --> (SAFR005) : "Manage Preferences"
  FAFR --> (SFR020) : "Send Feedback"
}

rectangle System {
  usecase "SFR001: Deliver Alerts" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
  usecase "SFR005: Request Spending Limit Alerts" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Matching Criteria" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Portfolio" as SFR009
  usecase "SFR010: Process Contextualized News for Users" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI" as SFR011
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics Providing Insights" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI" as SFR015
  usecase "SFR016: Request Predictive Insights From AI" as SFR016
  usecase "SFR017: Generate Financial Health Reports Assessing Wellbeing" as SFR017
  usecase "SFR018: Manage Users' Financial Goals Tracking Progress" as SFR018
  usecase "SFR019: Maintain Historical Record of User Insights for Trend Analysis" as SFR019
  
  C --> (SFR020) : "Send Feedback"
}

rectangle AI {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations Based on Profiles and Goals" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  usecase "AIFR005: Identify Financial Instruments Aligning with User Strategies and MPT Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights Correlating with User Portfolios" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations Identifying Patterns" as AIFR008
  usecase "AIFR009: Provide Forward-Looking Analysis of Financial Situations to Support Planning" as AIFR009
  
  C --> (SFR020) : "Send Feedback"
}

@enduml