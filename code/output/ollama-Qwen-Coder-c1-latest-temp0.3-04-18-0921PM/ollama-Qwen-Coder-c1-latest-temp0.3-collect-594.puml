@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as SAFR004
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as SAFR005
  usecase "SAFR001: Manage Analysis Parameters for the AI System to Ensure Compliance with Financial Regulations" as SFR020
  
  CFR001 --> (View Alerts about Anomalous Transactions)
  CFR001 --> (View Financial Predictions Based on Historical Data and Market Trends)
  CFR001 --> (Receive Personalized Recommendations Aligned with My Financial Profile and Goals)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
  
  usecase "FAFR003: View Predictive Analytics About Client's Financial Situations to Provide Data-Driven Recommendations During Consultations" as SAFR014
  usecase "FAFR005: Configure Analysis Parameters for Specific Client Segments Based on Different Profiles and Regulatory Requirements" as SFR021
  
  FAFR002 --> (View Predictive Analytics About Client's Financial Situations to Provide Data-Driven Recommendations During Consultations)
  FAFR002 --> (Configure Analysis Parameters for Specific Client Segments Based on Different Profiles and Regulatory Requirements)
}

package "System" {
  actor System as SFR
  
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SAFR002
  usecase "SFR014: Generate Client Analytics That Provide Meaningful Insights into Financial Behavior and Performance" as SAFR006
  
  SFR --> (Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events)
  SFR --> (Generate Client Analytics That Provide Meaningful Insights into Financial Behavior and Performance)
}

package "AI System" {
  actor AISystem as AIFR
  
  usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as SAFR023
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users Based on Their Risk Profiles, Time Horizons, and Financial Goals" as SAFR017
  
  AISystem --> (Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators)
  AISystem --> (Generate Investment Opportunity Analyses for Users Based on Their Risk Profiles, Time Horizons, and Financial Goals)
}

package "User Feedback" {
  actor User as CFR011
  
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights to Help Improve Future Outputs" as SAFR024
  
  CFR011 --> (Send Feedback About the System's Recommendations and Insights to Help Improve Future Outputs)
}

@enduml