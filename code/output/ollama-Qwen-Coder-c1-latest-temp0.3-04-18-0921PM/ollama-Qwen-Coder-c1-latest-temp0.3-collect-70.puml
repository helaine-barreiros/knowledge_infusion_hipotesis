@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR002
}

package SystemAdministrator {
  actor "System Administrator" as SAFR003
}

rectangle "User Interface" {
  usecase "CFR009: View Personalized Dashboard" as CFR009
  usecase "SAFR005: Manage Analysis Parameters Preferences" as SAFR012
  
  CFR001 --> CFR009 : "View Financial Insights"
  FAFR002 --> SAFR012 : "Manage Client Recommendations Preferences"
}

rectangle "Alerts and Notifications" {
  usecase "SFR003: Deliver Alerts to Users" as SFR003
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  
  CFR001 --> CFR006 : "View Spending Limits"
  FAFR002 --> SAFR015 : "Predictive Intervention Analysis for Advisors"
}

rectangle "Financial Insights and Predictions" {
  usecase "SFR007: Request Contextualized News Insights from AI Component" as SFR007
  usecase "AIFR009: Generate Client Predictive Intervention Recommendations" as AIFR014
  
  CFR001 --> SAFR020 : "Manage User Feedback"
}

rectangle "Investment Opportunities and Analysis" {
  usecase "CFR003: View Financial Predictions Based on Historical Data" as CFR007
  usecase "FAFR006: Configure Analysis Parameters for Client Segments" as FAFR12
  
  CFR001 --> SAFR019 : "Maintain Historical Record of Insights"
}

rectangle "Client Mentoring and Recommendations" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR03
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR007
  
  CFR001 --> SAFR018 : "Manage Financial Goals"
}

rectangle "System Operations and Management" {
  usecase "SFR014: Request Client Analytics from AI Component" as SFR014
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition" as AIFR023
  
  SAFR003 --> SAFR019 : "Maintain Historical Record of Insights"
}

@enduml