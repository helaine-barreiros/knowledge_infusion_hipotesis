@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
  
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004
  
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  
  SA --> SAFR001
  
}

rectangle "AI Components" {
  
  rectangle "Financial Insights Engine" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on Strategies" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
    
  }
  
}

rectangle "System Functions" {
  
  rectangle "Notification System" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
  }

  rectangle "Recommendation Engine" {
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  }
  
  rectangle "Prediction Requester" {
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR014: Generate Client Analytics" as SFR014
  }

  rectangle "Recommendation Requester" {
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  }
  
  rectangle "Spending Limit Alert Requester" {
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  }

  rectangle "Investment Opportunity Analysis Requester" {
    usecase "SFR006: Request Investment Opportunity Analyses from AI Component" as SFR006
    usecase "SFR012: Generate Client Dashboards" as SFR012
  }
  
  rectangle "Specific Investment Opportunities Requester" {
    usecase "SFR007: Request Specific Investment Opportunities Based on Criteria and ESG Preferences from AI Component" as SFR007
  }

  rectangle "Anomaly Transaction Alert Requester" {
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  }
  
  rectangle "News Requester" {
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
    usecase "SFR10: Process Contextualized News to Extract Relevant Information for User's Financial Situation" as SFR10
  }

  rectangle "News Insights Requester" {
    usecase "SFR11: Request Contextualized News Insights from AI Component" as SFR11
  }
  
  rectangle "Predictive Intervention Analysis Requester" {
    usecase "SFR015: Request Predictive Intervention Analyses from the AI Component to Identify When Financial Advisors Should Engage with Clients" as SFR015
  }

  rectangle "Client Predictive Insights Requester" {
    usecase "SFR016: Request Client Predictive Insights that Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as SFR016
  }
  
}

rectangle "System Management" {
  
  rectangle "User Feedback Manager" {
    usecase "CFR11: Send Feedback about System's Recommendations and Insights" as CFR11
    
    C --> CFR11
    FA --> CFR11
    SA --> CFR11
  }

  rectangle "Historical Record Manager" {
    usecase "SFR019: Maintain a Historical Record of Users' Insights to Enable Trend Analysis and Effectiveness Measurement" as SFR019
    
    C --> SFR019
    FA --> SFR019
    SA --> SFR019
  }
  
}

@enduml