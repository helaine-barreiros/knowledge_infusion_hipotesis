@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client) as User
:System Admin as SysAdmin
:Financial Advisor as FAFR

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  User --> CFR001
  SysAdmin --> SAFR001
  FAFR --> FAFR002
}

rectangle "Client Dashboard" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  User --> CFR009
  System Admin --> SFR012
}

rectangle "Alerts and Notifications" {
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  
  User --> SFR003
  System Admin --> AIFR006
}

rectangle "Personalized Recommendations and Insights" {
  usecase "SFR002: Request Personalized Recommendations" as SFR002
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  
  User --> SFR002
  System Admin --> AIFR001
}

rectangle "Financial Health and Goals Management" {
  usecase "SFR18: Manage Users' Financial Goals" as SFR18
  
  User --> SFR18
  SysAdmin --> SFR18
}

rectangle "Feedback and Improvement" {
  usecase "CFR011: Send Feedback about System Recommendations" as CFR011
  
  User --> CFR011
}
@enduml