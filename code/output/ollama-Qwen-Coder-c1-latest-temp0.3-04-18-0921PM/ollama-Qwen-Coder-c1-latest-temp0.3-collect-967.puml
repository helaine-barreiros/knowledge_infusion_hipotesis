@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure analysis parameters for specific client segments" as FAFR004
  usecase "SFR002: Deliver personalized recommendations to users based on their financial profiles" as SFR002
  usecase "AIFR002: Generate personalized recommendations for users" as AIFR002
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> FAFR004
  Client -> (SFR002)
  System Admin -> (SAFR001)
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage client mentoring sessions based on system-generated insights" as FAFR001
  usecase "FAFR003: View predictive analytics about my clients' financial situations" as FAFR003
  
  Financial Advisor --> (FAFR001)
  Financial Advisor -> (FAFR003)
}

rectangle "Client Relationship Management" {
  usecase "CFR010: Manage relationship with Financial Advisors, including permissions for sharing data" as CFR010
  Client --> (CFR010)
}
@enduml