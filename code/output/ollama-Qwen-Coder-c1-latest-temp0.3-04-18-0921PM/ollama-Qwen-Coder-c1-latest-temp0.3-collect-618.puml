@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR005: Manage Analysis Parameters Preferences" as SAFR005
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  Client --> (CFR001)
  SysAdmin --> (SAFR005)
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "SFR016: Generate Predictive Insights" as SFR016
  
  FinancialAdvisor --> (FAFR001)
}

rectangle "System Notifications and Recommendations" {
  usecase "SFR003: Deliver Personalized Recommendations" as SFR003
  usecase "SFR008: Request Anomaly Transaction Alerts" as SFR008
  
  System --> (SFR003)
  System --> (SFR008)
}

rectangle "Investment Opportunities and News" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR010: Request Contextualized News Insights" as SFR010
  
  Client --> (CFR007)
  FinancialAdvisor --> (FAFR002)
}

rectangle "User Feedback and Management" {
  usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
  usecase "SFR019: Maintain Historical Record of Users' Insights" as SFR019
  
  System --> (AIFR008)
}

rectangle "Client Alerts and Interventions" {
  usecase "SAFR002: Manage Client Intervention Alerts" as SAFR002
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  
  System --> (SAFR002)
}

rectangle "System Analytics and Health Reports" {
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  usecase "SFR017: Generate Financial Health Reports" as SFR017
  
  System --> (AIFR009)
}

rectangle "User Management and Relationship Maintenance" {
  usecase "CFR010: Manage My Relationship with Financial Advisors" as CFR010
  usecase "SFR020: Manage User Feedback to Continuously Improve the Quality of Financial Insights" as SFR020
  
  System --> (CFR010)
}

rectangle "AI Component Functions" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  System --> (AIFR001)
}

rectangle "User Interaction and Feedback Loop" {
  usecase "CFR011: Send Feedback about the System's Recommendations and Insights" as CFR011
  
  Client --> (CFR011)
}
@enduml