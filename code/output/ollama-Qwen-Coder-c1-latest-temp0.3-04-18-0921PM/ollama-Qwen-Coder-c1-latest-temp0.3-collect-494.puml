@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations" as SFR002
  usecase "CFR005: Manage Recommendation Preferences" as CFR010
  usecase "CFR006: View Spending Limit Alerts" as SFR005
  
  Client --> SAFR003 : "View Alerts"
  Client --> SFR002 : "Receive Recommendations"
  Client --> CFR010 : "Manage Preferences"
  Client --> SFR005 : "Spending Limits"
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR003: View Predictive Analytics for Clients" as SAFR004
  usecase "FAFR002: Manage Client Mentoring Sessions" as AIFR008
  usecase "FAFR005: Configure Analysis Parameters for Specific Segments" as SFR016
  
  FinancialAdvisor --> SAFR003 : "View Analytics"
  FinancialAdvisor --> FAFR002 : "Mentor Clients"
  FinancialAdvisor --> SAFR004 : "Predictive Insights"
  FinancialAdvisor --> SFR016 : "Configure Parameters"
}

package "System" {
  actor System as Sys
  
  usecase "SFR003: Request Financial Predictions from AI Component" as AIFR001
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR004
  usecase "SFR017: Generate Financial Health Reports" as SAFR006
  
  Sys --> AIFR001 : "Request Predictions"
  Sys --> SFR004 : "Deliver Recommendations"
  Sys --> SAFR006 : "Generate Reports"
}

package "AI System" {
  actor AI as AIFR002
  
  usecase "AIFR003: Generate Spending Limit Alerts for Users" as SAFR005
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as SFR016
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR009
  
  AI --> SAFR003 : "Spending Alerts"
  AI --> SFR016 : "Investment Opportunities"
  AI --> AIFR007 : "News Insights"
}

package "User (Client, Financial Advisor, or System Administrator)" {
  actor User as CFR011
  
  usecase "CFR011: Send Feedback about Recommendations and Insights" as SFR020
  
  User --> SFR020 : "Send Feedback"
}
@enduml