@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFD002
  usecase "SFR003: Deliver Personalized Recommendations" as SFR003
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  Client --> CFR001 : "View Financial Insights Dashboard"
  Client --> SAFR001 : "Manage Analysis Parameters"
  SysAdmin --> SAFR001 : "Manage Analysis Parameters"
  
  FAFD --> FAFD002 : "View Client Intervention Alerts"
  FAFD --> SFR003 : "Deliver Personalized Recommendations"
  System Admin --> AIFR002 : "Generate Personalized Recommendations"
}

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR005: Manage Recommendation Preferences" as SAFR005
  
  Client --> CFR001 : "View Financial Insights Dashboard"
  Client --> SAFR005 : "Manage Recommendation Preferences"
}

rectangle "Financial Advisor" {
  usecase "FAFR002: View Client Intervention Alerts" as FAFD002
  usecase "FAFR003: View Predictive Analytics" as FAFD003
  
  Financial Advisor --> FAFD002 : "View Client Intervention Alerts"
  Financial Advisor --> FAFD003 : "View Predictive Analytics"
}

rectangle "System" {
  usecase "SFR014: Generate Client Analytics" as SFR014
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  System Admin --> SFR014 : "Generate Client Analytics"
  Financial Advisor --> AIFR009 : "Generate Client Predictive Insights"
}

rectangle "User (Client, Financial Advisor, or System Administrator)" {
  usecase "CFR11: Send Feedback" as CFR11
  
  User --> CFR11 : "Send Feedback"
}
@enduml