@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
  usecase "CFR002: View Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  CFR001 --> CFR002 : "View Alerts about Anomalous Transactions"
  CFR001 --> CFR003 : "View Financial Predictions"
  CFR001 --> CFR004 : "Receive Personalized Recommendations"
  CFR001 --> CFR005 : "Manage Recommendation Preferences"
  CFR001 --> CFR006 : "View Spending Limit Alerts"
  CFR001 --> CFR007 : "View Investment Opportunities Suitable to My Risk Profile"
  CFR001 --> CFR008 : "View News Related to My Investment Portfolio"
  CFR001 --> CFR009 : "Access Personalized Dashboard"
  CFR001 --> CFR10 : "Manage Relationship with Financial Advisors"
}

package System {
  actor "System" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities from AI Component Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  usecase "SFR10: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR10
  usecase "SFR11: Request Contextualized News Insights from AI Component Identifying Potential Impacts on Users' Investments" as SFR11
  usecase "SFR12: Generate Client Dashboards Presenting Financial Information in an Intuitive and Actionable Format" as SFR12
  usecase "SFR13: Generate Client Alerts Based on Predefined Conditions Ensuring Timely Notification of Important Financial Events" as SFR13
  usecase "SFR14: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR14
  usecase "SFR15: Request Predictive Intervention Analyses from AI Component Identifying When Financial Advisors Should Engage with Clients" as SFR15
  usecase "SFR16: Request Predictive Insights From AI Component Enhancing the Value of Financial Guidance Provided to Clients" as SFR16
  usecase "SFR17: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR17
  usecase "SFR18: Manage Users' Financial Goals Tracking Progress Providing Relevant Recommendations" as SFR18
  usecase "SFR19: Maintain a Historical Record of Users' Insights Enabling Trend Analysis and Effectiveness Measurement" as SFR19
  usecase "SFR20: Manage User Feedback Continuously Improving the Quality Relevance of Financial Insights" as SFR20
  
  CFR001 --> SFR003 : "Request Financial Predictions"
  CFR004 --> SFR004 : "Receive Personalized Recommendations"
  CFR006 --> SFR005 : "Request Spending Limit Alerts"
  CFR007 --> SFR006 : "Request Investment Opportunity Analysis"
  CFR010 --> SFR008 : "Manage Relationship with Financial Advisors"
}

package Advisor {
  actor "Financial Advisor" as FAFR002
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations Providing Data-Driven Recommendations During Consultations" as FAFR003
  
  CFR001 --> FAFR002 : "View Alerts about Anomalous Transactions"
  CFR004 --> FAFR002 : "Receive Personalized Recommendations"
}

package AI {
  actor "AI System" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News with Specific User Portfolios Identifying Relevant Impacts on Users' Investments" as AIFR007
  
  CFR001 --> AIFR002 : "Receive Personalized Recommendations"
}

package SystemAdmin {
  actor "System Administrator" as SAFR001
  usecase "SAFR001: Manage Analysis Parameters for the AI System Ensuring Algorithms Remain Accurate Relevant and Compliant with Financial Regulations Such As Basel III for Risk Management" as SAFR001
  
  CFR005 --> SAFR001 : "Manage Recommendation Preferences"
}

rectangle "System Components" {
  SFR002
  SFR003
  SFR004
  SFR005
  SFR006
  SFR007
  SFR008
  SFR009
  SFR10
  SFR11
  SFR12
  SFR13
  SFR14
  SFR15
  SFR16
  SFR17
  SFR18
  SFR19
  SFR20
  
  FAFR003
  AIFR007
  
  SAFR001
}

@enduml