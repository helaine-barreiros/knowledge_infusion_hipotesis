@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
  
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SA --> SAFR001
}

rectangle "System Components" {
  
  package "AI Component" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on Modern Portfolio Theory" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
    
    C --> (AIFR001)
    C --> (AIFR002)
    C --> (AIFR003)
    C --> (AIFR004)
    C --> (AIFR005)
    C --> (AIFR006)
    C --> (AIFR007)
    C --> (AIFR008)
    C --> (AIFR009)

    FA --> (AIFR001)
    FA --> (AIFR002)
    FA --> (AIFR003)
    FA --> (AIFR004)
    FA --> (AIFR005)
    FA --> (AIFR006)
    FA --> (AIFR007)
    FA --> (AIFR008)
    FA --> (AIFR009)

  }
  
  package "Notification Component" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    
    C --> (SFR001)
    
    FA --> (SFR001)
    
    SA --> (SFR001)
  }

  package "Recommendation Component" {
    usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
    
    C --> (SFR002)

    FA --> (SFR002)
    
    SA --> (SFR002)
  }

  package "Prediction Component" {
    usecase "SFR003: Request Financial Predictions from AI" as SFR003
    usecase "SFR014: Generate Client Analytics" as SFR014
    
    C --> (SFR003)

    FA --> (SFR003)
    
    SA --> (SFR003)
  }

  package "Recommendation Request Component" {
    usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
    
    C --> (SFR004)

    FA --> (SFR004)
    
    SA --> (SFR004)
  }

  package "Spending Limit Component" {
    usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
    
    C --> (SFR005)

    FA --> (SFR005)
    
    SA --> (SFR005)
  }

  package "Investment Opportunity Component" {
    usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
    usecase "SFR012: Generate Client Dashboards" as SFR012
    
    C --> (SFR006)

    FA --> (SFR006)
    
    SA --> (SFR006)
  }

  package "News Component" {
    usecase "SFR007: Request Specific Investment Opportunities from AI" as SFR007
    usecase "SFR008: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR008
    usecase "SFR10: Process Contextualized News for Users" as SFR10
    
    C --> (SFR007)

    FA --> (SFR007)
    
    SA --> (SFR007)
  }

  package "Predictive Intervention Component" {
    usecase "SFR009: Request Predictive Intervention Analyses from AI" as SFR009
    
    C --> (SFR009)

    FA --> (SFR009)
    
    SA --> (SFR009)
  }

  package "Predictive Insights Component" {
    usecase "SFR16: Request Predictive Insights from AI to Enhance Financial Guidance" as SFR16
    
    C --> (SFR16)

    FA --> (SFR16)
    
    SA --> (SFR16)
  }

}

package "Feedback Component" {
  usecase "CFR11: Send Feedback about Recommendations and Insights" as CFR11
  
  C --> CFR11
}
@enduml