@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as SAFR004
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as SAFR005
  usecase "CFR006: Manage Personalized Recommendations Preferences to Ensure Insights Relevant to My Financial Objectives and Risk Tolerance" as SAFR012
  usecase "CFR007: View Spending Limit Alerts When Exceed Predefined Thresholds in Specific Expense Categories" as SAFR009
  
  CFR001 --> SAFR003 : "Receive"
  CFR001 --> SAFR004 : "View"
  CFR001 --> SAFR005 : "Get Recommendations"
  CFR001 --> SAFR012 : "Manage Preferences"
  CFR001 --> SAFR009 : "Monitor Spending Limits"
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as SAFR006
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments to Customize the System's Behavior According to Different Client Profiles and Regulatory Requirements Such As GDPR or CCPA" as SAFR015
  
  FinancialAdvisor --> SAFR003 : "Provide Recommendations"
  FinancialAdvisor --> SAFR006 : "View Analytics"
  FinancialAdvisor --> SAFR015 : "Customize Parameters"
}

package "System Administrator" {
  actor SystemAdmin as SAFR002
  
  usecase "SAFR007: Manage Analysis Parameters for the AI System to Ensure the Algorithms Remain Accurate, Relevant, and Compliant with Financial Regulations Such As Basel III for Risk Management" as SAFR013
  usecase "SFR019: Maintain a Historical Record of Users' Insights to Enable Trend Analysis and Effectiveness Measurement" as SFR019
  
  SystemAdmin --> SAFR013 : "Manage Parameters"
  SystemAdmin --> SFR019 : "Maintain Records"
}

package "System Components" {
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles to Support Better Financial Decision-Making" as AIFR002
  usecase "SFR003: Request Financial Predictions from the AI Component to Provide Users With Forward-Looking Financial Insights" as AIFR001
  
  SFR002 --> AIFR002 : "Generate Recommendations"
  SFR003 --> AIFR001 : "Provide Predictions"
}

package "Notifications and Alerts" {
  usecase "SFR008: Request Anomaly Transaction Alerts from the AI Component to Detect Potentially Fraudulent Activities in Accordance with AML Regulations" as SAFR006
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR014
  
  SAFR006 --> SFR013 : "Detect Anomalies"
}

package "News and Insights" {
  usecase "SFR009: Request Contextualized News Relevant to Users' Financial Portfolios from Trusted Financial News Sources" as AIFR007
  usecase "SFR016: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as SAFR009
  
  SFR009 --> AIFR007 : "Provide News"
  SAFR009 --> SAFR009 : "Generate Insights"
}

package "Dashboard and Reporting" {
  usecase "SFR12: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as SFR015
  usecase "SFR17: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SAFR014
  
  SFR12 --> SFR015 : "Generate Dashboards"
  SAFR17 --> SAFR014 : "Assess Wellness"
}

package "Feedback Management" {
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as SFR020
  
  CFR11 --> SFR020 : "Provide Feedback"
}
@enduml