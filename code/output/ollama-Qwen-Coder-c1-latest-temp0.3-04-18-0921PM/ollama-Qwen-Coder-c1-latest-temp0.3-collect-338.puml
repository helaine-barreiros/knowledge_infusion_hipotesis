@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Financial Insights Dashboard" as CFR002
  usecase "SAFR003: Manage Analysis Parameters" as SAFR003
  usecase "FAFR004: Configure analysis parameters for specific client segments" as FAFR004
  
  CFR001 --> (CFR002)
  CFR001 --> (SAFR003)
  CFR001 --> (FAFR004)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR005
  
  usecase "FAFR006: View client intervention alerts" as FAFR006
  usecase "FAFR007: View predictive analytics about my clients' financial situations" as FAFR007
  usecase "AIFR012: Generate contextualized news insights by correlating financial news with specific user portfolios to identify relevant impacts" as AIFR012
  
  FinancialAdvisor --> (FAFR006)
  FinancialAdvisor --> (FAFR007)
  FinancialAdvisor --> (AIFR012)
}

package "System Administrator" {
  actor SystemAdministrator as SAFR004
  usecase "SAFR005: Manage analysis parameters for the AI system to ensure the algorithms remain accurate, relevant, and compliant with financial regulations such as Basel III for risk management." as SAFR005
  
  SAFR004 --> (SAFR005)
}

package "System" {
  usecase "SFR012: Generate client dashboards that present financial information in an intuitive and actionable format." as SFR012
  usecase "SFR013: Generate client alerts based on predefined conditions to ensure timely notification of important financial events." as SFR013
  
  System --> (SFR012)
  System --> (SFR013)
}

package "AI" {
  usecase "AIFR009: Generate client predictive intervention recommendations by identifying patterns that indicate potential financial difficulties or opportunities requiring advisor engagement." as AIFR009
  usecase "AIFR016: Generate client predictive insights that provide forward-looking analysis of financial situations to support more effective financial planning." as AIFR016
  
  AI --> (AIFR009)
  AI --> (AIFR016)
}

rectangle "System" {
  usecase "SFR020: Manage user feedback to continuously improve the quality and relevance of financial insights." as SFR020
  usecase "CFR011: Send feedback about the system's recommendations and insights to help improve the accuracy and relevance of future outputs." as CFR011
  
  System --> (SFR020)
  System --> (CFR011)
}

@enduml