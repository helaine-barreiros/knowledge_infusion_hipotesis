@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (View)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (Manage)
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFAFR002: Send Feedback to AI" as SFAFR002
  
  SA --> (Manage)
}

package "System" {
  rectangle "AI System" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
    
    C --> (Generate)
  }
  
  rectangle "Notification System" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    usecase "SFAFR002: Send Feedback to AI" as SFAFR002
    
    FA --> (Deliver)
    
    SA --> (Send)
  }
  
  rectangle "Recommendation System" {
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    
    C --> (Deliver)
    
    FA --> (Generate)
  }
  
  rectangle "Prediction System" {
    usecase "SFR003: Request Financial Predictions from AI" as SFR003
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    
    C --> (Request)
    
    FA --> (Generate)
  }
  
  rectangle "Recommendation System" {
    usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    
    C --> (Request)
    
    FA --> (Generate)
  }
  
  rectangle "Spending Limit System" {
    usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    
    C --> (Request)
    
    FA --> (Generate)
  }
  
  rectangle "Investment Opportunity System" {
    usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    
    C --> (Request)
    
    FA --> (Generate)
  }
  
  rectangle "ESG System" {
    usecase "SFR007: Request Specific Investment Opportunities from AI" as SFR007
    usecase "AIFR005: Generate Investment Opportunities for Users" as AIFR005
    
    C --> (Request)
    
    FA --> (Generate)
  }
  
  rectangle "Anomaly Detection System" {
    usecase "SFR008: Request Anomaly Transaction Alerts from AI" as SFR008
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    
    C --> (Request)
    
    FA --> (Generate)
  }
  
  rectangle "News System" {
    usecase "SFR009: Request Contextualized News Insights from AI" as SFR009
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    
    C --> (Request)
    
    FA --> (Generate)
  }
  
  rectangle "Intervention System" {
    usecase "SFR15: Request Predictive Intervention Analyses from AI" as SFR15
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
    
    FA --> (Request)
    
    SA --> (Generate)
  }
  
  rectangle "Insight System" {
    usecase "SFR16: Request Predictive Insights from AI" as SFR16
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
    
    FA --> (Request)
    
    SA --> (Generate)
  }
  
  rectangle "Health Report System" {
    usecase "SFR17: Generate Financial Health Reports" as SFR17
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    
    C --> (Generate)
    
    FA --> (Generate)
  }
  
  rectangle "Goal Management System" {
    usecase "SFR18: Manage Users' Financial Goals" as SFR18
    usecase "AIFR02: Generate Personalized Recommendations for Users" as AIFR02
    
    C --> (Manage)
    
    FA --> (Generate)
  }
  
  rectangle "Feedback System" {
    usecase "SFR20: Manage User Feedback to Improve AI Outputs" as SFR20
    usecase "AIFR01: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR01
    
    C --> (Manage)
    
    FA --> (Generate)
  }
}

C --> SA : Manage
FA --> SA : Manage

@enduml