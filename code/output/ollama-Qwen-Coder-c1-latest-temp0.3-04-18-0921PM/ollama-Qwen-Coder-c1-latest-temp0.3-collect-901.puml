@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR003: View Financial Predictions" as SAFR004
  usecase "CFR004: Receive Personalized Recommendations" as SAFR005
  usecase "CFR006: Manage Recommendation Preferences" as SAFR012
  usecase "CFR007: View Investment Opportunities" as SAFR008
  usecase "CFR008: View News Related to Portfolio" as SAFR009
  usecase "CFR009: Access Personalized Dashboard" as SFR012
  
  CFR001 --> (SAFR003)
  CFR001 --> (SAFR004)
  CFR001 --> (SAFR005)
  CFR001 --> (SAFR012)
  CFR001 --> (SAFR008)
  CFR001 --> (SAFR009)
  CFR001 --> (SFR012)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts" as SAFR006
  usecase "FAFR003: View Predictive Analytics for Clients" as SAFR007
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as SAFR015
  
  FinancialAdvisor --> (SAFR002)
  FinancialAdvisor --> (SAFR003)
  FinancialAdvisor --> (SAFR015)
}

package "System Administrator" {
  actor SystemAdministrator as SAFR001
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR020: Manage User Feedback" as SFR020
  
  SystemAdministrator --> (SAFR001)
  SystemAdministrator --> (SFR020)
}

package "System" {
  rectangle "AI Component" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on Strategies and MPT Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
    
    CFR011 --> (SAFR020)
  }
  
  rectangle "Notification Component" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
  }
}

@enduml