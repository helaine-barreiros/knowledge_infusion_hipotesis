@startuml
left to right direction

title Use Case Diagram for AI-Powered Financial Insights & Advisory System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> (View Financial Insights Dashboard)
  C --> (Receive Anomaly Transaction Alerts)
  C --> (View Financial Predictions)
  C --> (Receive Personalized Recommendations)
  C --> (Manage Recommendation Preferences)
  C --> (View Spending Limit Alerts)
  C --> (View Investment Opportunities)
  C --> (View Financial News)
  C --> (Access Personalized Dashboard)
  C --> (Manage Relationship with Advisors)
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FA --> (Manage Client Mentoring Sessions)
  FA --> (View Client Intervention Alerts)
  FA --> (View Predictive Analytics)
  FA --> (Configure Analysis Parameters for Specific Segments)
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFAFR002: Send Feedback to AI" as SFAFR002
  
  SA --> (Manage Analysis Parameters)
}

package "System Components" {
  rectangle "AI System" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on Modern Portfolio Theory" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
    
    SAFR001 --> (Generate Financial Predictions)
    SAFR001 --> (Generate Personalized Recommendations)
    SAFR001 --> (Generate Spending Limit Alerts)
    SAFR001 --> (Generate Investment Opportunity Analyses)
    SAFR001 --> (Generate Investment Opportunities Based on Modern Portfolio Theory)
    SAFR001 --> (Generate Anomaly Transaction Alerts)
    SAFR001 --> (Generate Contextualized News Insights)
    SAFR001 --> (Generate Predictive Intervention Recommendations)
    SAFR001 --> (Generate Client Predictive Insights)
  }
  
  rectangle "Notification System" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    usecase "SFR020: Manage User Feedback" as SFR020
    
    SAFR001 --> (Deliver Alerts to Users)
    SAFR020 --> (Manage User Feedback)
  }
  
  rectangle "Dashboard System" {
    usecase "SFR12: Generate Client Dashboards" as SFR12
    usecase "SFR13: Generate Client Alerts Based on Predefined Conditions" as SFR13
    
    SAFR001 --> (Generate Client Dashboards)
    SAFR001 --> (Generate Client Alerts Based on Predefined Conditions)
  }
  
  rectangle "Analytics System" {
    usecase "SFR14: Generate Client Analytics" as SFR14
    usecase "SFR15: Request Predictive Intervention Analyses from AI Component" as SFR15
    
    SAFR001 --> (Generate Client Analytics)
    SAFR001 --> (Request Predictive Intervention Analyses from AI Component)
  }
  
  rectangle "News System" {
    usecase "SFR09: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR09
    usecase "SFR10: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR10
    
    SAFR001 --> (Find Contextualized News Relevant to Users' Financial Portfolios)
    SAFR001 --> (Process Contextualized News to Extract Relevant Information for Users' Financial Situations)
  }
}

@enduml