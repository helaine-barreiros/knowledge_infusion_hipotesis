@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
  usecase "CFR002: View Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  CFR001 --> (View Alerts)
  CFR001 --> (View Financial Predictions)
  CFR001 --> (Receive Personalized Recommendations)
  CFR001 --> (Manage Recommendation Preferences)
  CFR001 --> (View Spending Limit Alerts)
  CFR001 --> (View Investment Opportunities)
  CFR001 --> (View News Related to Portfolio)
  CFR001 --> (Access Personalized Dashboard)
  CFR001 --> (Manage Relationship with Financial Advisors)

}

package SystemAdministrator {
  actor "System Administrator" as SAFR001
  usecase "SAFR002: Manage Analysis Parameters" as SAFR002
  
  SAFR001 --> (Manage Analysis Parameters)
  
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FAFR001 --> (Manage Client Mentoring Sessions)
  FAFR001 --> (View Predictive Analytics)
  FAFR001 --> (Configure Analysis Parameters for Client Segments)

}

package System {
  rectangle "System" {
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities from AI Component Matching User Criteria and ESG Preferences" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
    usecase "SFR10: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR10
    usecase "SFR11: Request Contextualized News Insights from AI Component Identifying Potential Impacts on Users' Investments" as SFR11
    usecase "SFR12: Generate Client Dashboards Presenting Financial Information in an Intuitive and Actionable Format" as SFR12
    usecase "SFR13: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR13
    usecase "SFR14: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR14
    usecase "SFR15: Request Predictive Intervention Analyses from AI Component Identifying When Financial Advisors Should Engage with Clients" as SFR15
    usecase "SFR16: Request Predictive Insights From the AI Component Enhancing the Value of Financial Guidance Provided to Clients" as SFR16
    usecase "SFR17: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR17
    usecase "SFR18: Manage Users' Financial Goals Tracking Progress and Providing Relevant Recommendations" as SFR18
    usecase "SFR19: Maintain a Historical Record of Users' Insights Enabling Trend Analysis and Effectiveness Measurement" as SFR19
    usecase "SFR20: Manage User Feedback Continuously Improving the Quality and Relevance of Financial Insights" as SFR20
    
  }
}

package AI {
  rectangle "AI System" {
    usecase "AIFR003: Generate Spending Limit Alerts for Users Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses For Users Evaluating Potential Investments Against Their Risk Profiles Time Horizons and Financial Goals" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities for Users Identifying Financial Instruments That Align with Their Investment Strategies and Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance With FinCEN Requirements" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News with Specific User Portfolios Identifying Relevant Impacts" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009
    
  }
}

package User {
  actor "User (Client, Financial Advisor or System Administrator)" as CFR11
  usecase "CFR12: Send Feedback About the System's Recommendations and Insights" as CFR12
  
  CFR11 --> (Send Feedback About the System's Recommendations and Insights)
  
}

@enduml