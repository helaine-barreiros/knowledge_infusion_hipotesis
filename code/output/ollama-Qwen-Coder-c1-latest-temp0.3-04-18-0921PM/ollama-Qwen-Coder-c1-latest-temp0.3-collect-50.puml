@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  Client --> CFR001
  Client --> SAFR001
  Client --> FAFR003
  Client --> SFR002
  Client --> AIFR002

  SysAdmin --> SAFR001

  Financial Advisor --> FAFR001
  Financial Advisor --> FAFR003
  Financial Advisor --> SFR002
  Financial Advisor --> AIFR002
  
}

rectangle "Client" {
    usecase "CFR002: View Alerts About Anomalous Transactions" as CFR002
    usecase "CFR006: View Spending Limit Alerts" as CFR006
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
    
    Client --> CFR002
    Client --> CFR006
    Client --> SFR013
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  Financial Advisor --> FAFR001
  Financial Advisor --> FAFR004
}

rectangle "System Functions" {
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
    usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
    
    System Admin --> SAFR001

    Financial Advisor --> FAFR001
    Financial Advisor --> FAFR004
    
}

rectangle "User Feedback" {
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights" as CFR011
  
  Client --> CFR011
  Financial Advisor --> CFR011
  SysAdmin --> SAFR001
}
@enduml