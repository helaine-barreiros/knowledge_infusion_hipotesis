@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

' Define actors
actor Client as C
actor FinancialAdvisor as FA
actor SysAdmin as SA

' Group use cases by actor or subsystem
rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Clients" as FAFR002
  usecase "FAFR003: View Predictive Analytics about Client Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
}

' Group system-level functionality
package System {
  rectangle "Notifications" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
  }
  
  rectangle "Recommendations" {
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  }

  rectangle "Predictions and Insights" {
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities from AI Component Matching User Criteria and ESG Preferences" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  }

  rectangle "Dashboards and Reports" {
    usecase "SFR012: Generate Client Dashboards in an Intuitive Format" as SFR012
    usecase "SFR017: Generate Financial Health Reports Based on Standard Ratios" as SFR017
  }

  rectangle "Intervention and Insights" {
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
    usecase "SFR016: Request Predictive Insights from AI Component to Enhance Financial Guidance" as SFR016
  }

  rectangle "News and Analytics" {
    usecase "SFR009: Find Contextualized News Relevant to Users' Portfolios" as SFR009
    usecase "SFR010: Process Contextualized News for User Situations" as SFR010
    usecase "SFR014: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR014
  }

  rectangle "Feedback Management" {
    usecase "CFR11: Send Feedback about Recommendations and Insights to Improve Future Outputs" as CFR11
  }
}

' Relationships between actors and use cases
C --> (CFR001)
C --> (CFR002)
C --> (CFR003)
C --> (CFR004)
C --> (CFR005)
C --> (CFR006)
C --> (CFR007)
C --> (CFR008)
C --> (CFR009)
C --> (CFR10)

FA --> (FAFR001)
FA --> (FAFR002)
FA --> (FAFR003)
FA --> (FAFR004)

SA --> (SAFR001)

' Relationships between system-level functionality and use cases
SFR001 <|-- (CFR002)
SFR002 <|-- (CFR004)
SFR003 <|-- (CFR009)
SFR005 <|-- (CFR006)
SFR007 <|-- (CFR008)
SFR10 --> (AIFR007)

@enduml