@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> CFR001 : "View"
  C --> CFR002 : "Receive Alerts on Anomalous Transactions"
  C --> CFR003 : "View Predictions"
  C --> CFR004 : "Receive Recommendations"
  C --> CFR005 : "Manage Preferences"
  C --> CFR006 : "View Spending Limits"
  C --> CFR007 : "View Opportunities"
  C --> CFR008 : "View News"
  C --> CFR009 : "Access Dashboard"
  C --> CFR10 : "Manage Relationship with Advisors"
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> FAFR001 : "Manage Sessions"
  FA --> FAFR002 : "View Alerts"
  FA --> FAFR003 : "View Analytics"
  FA --> FAFR004 : "Configure Parameters"
}

package "System" {
  actor System as Sys
  
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities from AI" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Portfolios" as SFR009
  usecase "SFR010: Process Contextualized News for Users" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI" as SFR011
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics for Financial Behavior and Performance" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI" as SFR015
  usecase "SFR016: Request Predictive Insights from AI to Enhance Guidance Value" as SFR016
  usecase "SFR017: Generate Financial Health Reports" as SFR017
  usecase "SFR018: Manage Users' Financial Goals and Track Progress" as SFR018
  usecase "SFR019: Maintain Historical Record of Insights for Trend Analysis" as SFR019
  usecase "SFR020: Manage User Feedback to Improve System Outputs" as SFR020
  
  Sys --> SFR001 : "Deliver Alerts"
  Sys --> SFR002 : "Deliver Recommendations"
  Sys --> SFR003 : "Request Predictions from AI"
  Sys --> SFR004 : "Request Personalized Recommendations from AI"
  Sys --> SFR005 : "Request Spending Limit Alerts from AI"
  Sys --> SFR006 : "Request Investment Opportunity Analysis from AI"
  Sys --> SFR007 : "Request Specific Opportunities from AI"
  Sys --> SFR008 : "Request Anomaly Transaction Alerts from AI"
  Sys --> SFR009 : "Find Contextualized News"
  Sys --> SFR010 : "Process News for Users"
  Sys --> SFR011 : "Request News Insights from AI"
  Sys --> SFR012 : "Generate Dashboards"
  Sys --> SFR013 : "Generate Alerts Based on Conditions"
  Sys --> SFR014 : "Generate Analytics"
  Sys --> SFR015 : "Request Predictive Intervention Analyses from AI"
  Sys --> SFR016 : "Request Predictive Insights to Enhance Guidance Value"
  Sys --> SFR017 : "Generate Financial Health Reports"
  Sys --> SFR018 : "Manage Goals and Track Progress"
  Sys --> SFR019 : "Maintain Historical Record of Insights"
  Sys --> SFR020 : "Manage User Feedback to Improve Outputs"
}

package "AI System" {
  actor AI as AIF
  
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations Based on Profiles and Goals" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Patterns" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users Based on Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Aligning with User Strategies and Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Planning" as AIFR009
  
  Sys --> AIF : "Request Predictions"
  Sys --> AIF : "Request Recommendations"
  Sys --> AIF : "Request Spending Limit Alerts"
  Sys --> AIF : "Request Investment Opportunity Analyses"
  Sys --> AIF : "Request Specific Opportunities"
  Sys --> AIF : "Request Anomaly Transaction Alerts"
  Sys --> AIF : "Find Contextualized News Insights"
  Sys --> AIF : "Generate Predictive Intervention Recommendations"
  Sys --> AIF : "Generate Predictive Insights to Enhance Guidance Value"
  
  AIF --> SFR012 : "Provide Dashboards"
  AIF --> SFR013 : "Deliver Alerts Based on Conditions"
  AIF --> SFR014 : "Provide Analytics for Behavior and Performance"
  AIF --> Sys : "Generate Predictions"
  AIF --> Sys : "Generate Recommendations"
  AIF --> Sys : "Identify Spending Limit Violations"
  AIF --> Sys : "Analyze Investment Opportunities"
  AIF --> Sys : "Detect Anomalies in Transactions"
  AIF --> Sys : "Correlate News with Portfolios"
}

rectangle System {
  usecase "CFR11: Send Feedback to Improve Outputs" as CFR11
  
  C --> CFR11
  FA --> CFR11
  SysAdmin --> CFR11
}
@enduml