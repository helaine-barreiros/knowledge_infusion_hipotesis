@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
  
  usecase "FAFR003: View Predictive Analytics about My Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FinancialAdvisor --> (FAFR002)
  FinancialAdvisor --> FAFR003
  FinancialAdvisor --> FAFR004
}

package "System Administrator" {
  actor SystemAdmin as SAFR001
  
  usecase "SAFR001: Manage Analysis Parameters for the AI System" as SAFR001
  
  SystemAdmin --> (SAFR001)
}

package "Financial Insights and Recommendations" {
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance" as AIFR002
  
  CFR001 --> (SFR002)
  FAFR002 --> SFR002
  SAFR001 --> SAFR001
}

package "Spending Limits and Alerts" {
  usecase "SFR005: Request Spending Limit Alerts from the AI Component When User Spending Patterns Exceed Defined Thresholds" as SFR005
  
  CFR006 --> (SFR005)
}

package "Investment Opportunities" {
  usecase "SFR006: Request Investment Opportunity Analysis from the AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles" as SFR006
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  
  CFR007 --> (SFR006)
}

package "News and Information" {
  usecase "SFR010: Request Contextualized News Insights from the AI Component to Identify Potential Impacts on Users' Investments" as SFR010
  usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
  
  CFR008 --> (SFR010)
}

package "System Operations and Maintenance" {
  usecase "SFR020: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR020
  usecase "AIFR009: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR009
  
  CFR011 --> (SFR020)
}

package "System Alerts and Notifications" {
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR013
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
  
  CFR002 --> (SFR013)
}

package "System Analytics and Reporting" {
  usecase "SFR014: Generate Client Analytics That Provide Meaningful Insights into Financial Behavior and Performance" as SFR014
  usecase "AIFR008: Generate Predictive Insights from the AI Component to Enhance the Value of Financial Guidance Provided to Clients" as AIFR008
  
  CFR009 --> (SFR014)
}

package "AI System Components" {
  usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
  usecase "AIFR005: Generate Investment Opportunities for Users by Identifying Financial Instruments That Align with Their Investment Strategies and Modern Portfolio Theory Principles" as AIFR005
  
  CFR012 --> (SFR014)
}

rectangle "System Boundary" {
  SFR003
  SFR007
  SFR011
  SFR015
  SFR016
  SAFR001
}
@enduml