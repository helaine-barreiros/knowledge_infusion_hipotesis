@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor (FA): as FA
:User: as User

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "SFR013: Request Client Alerts" as SFR013
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FA --> FAFR004
  User --> (Send Feedback) : CFR011
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR001: Manage Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  
  FA --> (Manage Clients) : SAFR004
}

rectangle "System Functions" {
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "SFR017: Generate Financial Health Reports" as SFR017
  
  System --> (Process Data) : AIFR002, SAFR004
}

rectangle "Client Functions" {
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  
  Client --> (Manage Recommendations) : CFR005
  Client --> (View Alerts) : SAFR013, SFR017
}

rectangle "Investment Functions" {
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  FA --> (View Insights) : FAFR003, SAFR017
}

rectangle "News Functions" {
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  
  Client --> (View News) : SAFR013, FAFR008
}

rectangle "Dashboard Functions" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "SFR12: Generate Client Dashboards" as SFR12
  
  User --> (Access Dashboard) : SAFR013, FAFR008
}

rectangle "Relationship Management Functions" {
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  User --> (Manage Relationships) : SAFR013, FAFR004
}
@enduml