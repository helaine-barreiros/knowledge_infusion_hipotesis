@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR002
  usecase "CFR003: View Financial Predictions" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations" as SAFR004
  usecase "CFR005: Manage Recommendation Preferences" as SAFR005
  usecase "CFR006: View Spending Limit Alerts" as SAFR006
  usecase "CFR007: View Investment Opportunities" as SAFR007
  usecase "CFR008: View News Related to Portfolio" as SAFR008
  usecase "CFR009: Access Personalized Dashboard" as SAFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as SAFR10
  
  CFR001 --> SAFR002 : "View Alerts"
  CFR001 --> SAFR003 : "View Predictions"
  CFR001 --> SAFR004 : "Receive Recommendations"
  CFR001 --> SAFR005 : "Manage Preferences"
  CFR001 --> SAFR006 : "View Spending Alerts"
  CFR001 --> SAFR007 : "View Investment Opportunities"
  CFR001 --> SAFR008 : "View News"
  CFR001 --> SAFR009 : "Access Dashboard"
  CFR001 --> SAFR10 : "Manage Advisors"
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts" as SAFR007
  usecase "FAFR003: View Predictive Analytics for Clients" as SAFR008
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as SAFR015
  
  FAFR001 --> SAFR002 : "View Alerts"
  FAFR001 --> SAFR003 : "View Analytics"
  FAFR001 --> SAFR004 : "Configure Parameters"
}

package System {
  actor "System" as SFR001
  
  usecase "SFR002: Deliver Personalized Recommendations" as AIFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as AIFR001
  usecase "SFR004: Request Personalized Recommendations from AI Component" as AIFR002
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as AIFR003
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as AIFR004
  usecase "SFR007: Request Specific Investment Opportunities from AI Component Matching User Criteria and ESG Preferences" as AIFR005
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as AIFR006
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as AIFR017
  usecase "SFR010: Process Contextualized News to Extract Information for User's Financial Situation" as AIFR018
  usecase "SFR011: Request Contextualized News Insights from AI Component Identifying Potential Impacts on Users' Investments" as AIFR023
  usecase "SFR012: Generate Client Dashboards Presenting Financial Information in an Intuitive and Actionable Format" as AIFR024
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions Ensuring Timely Notification of Important Financial Events" as AIFR025
  usecase "SFR014: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as AIFR026
  usecase "SFR015: Request Predictive Intervention Analyses from AI Component Identifying When Advisors Should Engage with Clients" as AIFR030
  usecase "SFR016: Request Predictive Insights from AI Component Enhancing the Value of Financial Guidance Provided to Clients" as AIFR029
  usecase "SFR017: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as AIFR034
  usecase "SFR018: Manage Users' Financial Goals Tracking Progress Providing Relevant Recommendations" as AIFR027
  usecase "SFR019: Maintain a Historical Record of Users' Insights Enabling Trend Analysis and Effectiveness Measurement" as AIFR028
  usecase "SFR020: Manage User Feedback Continuously Improving the Quality and Relevance of Financial Insights" as AIFR035
  
  SFR001 --> SAFR007 : "Deliver Alerts"
  SFR001 --> SAFR008 : "Deliver Recommendations"
  SFR001 --> SAFR015 : "Request Predictive Analytics"
}

package AI {
  actor "AI System" as AIFR001
  
  usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles Goals and Risk Tolerance as Defined by Industry Standards Like FINRA Guidelines" as SAFR004
  usecase "AIFR003: Generate Spending Limit Alerts for Users Identifying Unusual Deviations from Established Spending Patterns" as SAFR012
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users Evaluating Potential Investments Against Their Risk Profiles Time Horizons and Financial Goals" as SAFR016
  usecase "AIFR005: Generate Investment Opportunities for Users Identifying Financial Instruments That Align with Their Investment Strategies and Modern Portfolio Theory Principles" as SAFR024
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance With FinCEN Requirements" as SAFR018
  usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News with Specific User Portfolios Identifying Relevant Impacts" as SAFR026
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as SAFR014
  usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as SAFR025
  
  AIFR001 --> SAFR004 : "Generate Recommendations"
  AIFR001 --> SAFR012 : "Generate Alerts"
  AIFR001 --> SAFR016 : "Analyze Investments"
  AIFR001 --> SAFR024 : "Identify Opportunities"
  AIFR001 --> SAFR018 : "Detect Fraud"
  AIFR001 --> SAFR026 : "Provide Insights"
  AIFR001 --> SAFR014 : "Recommend Interventions"
  AIFR001 --> SAFR025 : "Predict Financial Situations"

rectangle System {
    SFR001
}
@enduml