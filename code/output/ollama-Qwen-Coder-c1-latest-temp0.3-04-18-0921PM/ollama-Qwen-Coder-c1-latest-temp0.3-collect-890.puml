@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFR001

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics about My Clients' Financial Situations" as FAFR003
  
  Client --> (CFR001)
  SysAdmin --> (SAFR001)
  FAFR001 --> (FAFR003)
}

rectangle "Client Dashboard Features" {
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR109: Access Personalized Dashboard" as CFR109
  
  Client --> (CFR002)
  Client --> (CFR006)
  Client --> (CFR109)
}

rectangle "Financial Predictions and Recommendations" {
  usecase "CFR003: View Financial Predictions Based on Historical Data" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile" as CFR004
  
  Client --> (CFR003)
  Client --> (CFR004)
}

rectangle "Financial Advisor Features" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts When the System Detects Patterns Requiring Professional Attention" as FAFR002
  
  FinancialAdvisor --> (FAFR001)
  FinancialAdvisor --> (FAFR002)
}

rectangle "System Features" {
  usecase "SFR001: Deliver Alerts to Users Through Appropriate Notification Channels" as SFR001
  usecase "SFR003: Request Financial Predictions from the AI Component" as SFR003
  
  System --> (SFR001)
  System --> (SFR003)
}

rectangle "AI Features" {
  usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance As Defined By Industry Standards Like FINRA Guidelines" as AIFR002
  
  System --> (AIFR001)
  System --> (AIFR002)
}

rectangle "User Feedback" {
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as CFR11
  
  Client <|-- (CFR11)
  FinancialAdvisor <|-- (CFR11)
  SysAdmin <|-- (CFR11)
}

@enduml