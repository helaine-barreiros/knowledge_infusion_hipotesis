@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure analysis parameters for specific client segments" as FAFR004
  usecase "SFR002: Deliver personalized recommendations to users based on their financial profiles" as SFR002
  usecase "AIFR001: Generate financial predictions for users by analyzing historical transaction data, market trends, and economic indicators" as AIFR001
  usecase "SFR013: Generate client alerts based on predefined conditions to ensure timely notification of important financial events" as SFR013
  usecase "AIFR002: Generate personalized recommendations for users based on their financial profiles, goals, and risk tolerance as defined by industry standards like FINRA guidelines" as AIFR002
  usecase "SFR014: Generate client analytics that provide meaningful insights into financial behavior and performance" as SFR014
  usecase "AIFR003: Generate spending limit alerts for users by identifying unusual deviations from established spending patterns" as AIFR003
  usecase "SFR020: Manage user feedback to continuously improve the quality and relevance of financial insights" as SFR020
  usecase "AIFR004: Generate investment opportunity analyses for users by evaluating potential investments against their risk profiles, time horizons, and financial goals" as AIFR004
  usecase "SFR13: Request specific investment opportunities from the AI component that match user investment criteria and ESG (Environmental, Social, and Governance) preferences." as SFR13
  usecase "AIFR05: Generate investment opportunities for users by identifying financial instruments that align with their investment strategies and Modern Portfolio Theory principles" as AIFR05
  usecase "SFR08: Find contextualized news relevant to users' financial portfolios from trusted financial news sources." as SFR08
  usecase "AIFR06: Generate anomaly transaction alerts by employing pattern recognition to detect potentially fraudulent activities in compliance with FinCEN requirements" as AIFR06
  usecase "SFR17: Generate financial health reports that assess users' overall financial wellbeing according to standard financial ratios and metrics." as SFR17
  usecase "AIFR07: Generate contextualized news insights by correlating financial news with specific user portfolios to identify relevant impacts" as AIFR07
  usecase "SFR18: Manage users' financial goals to track progress and provide relevant recommendations." as SFR18
  usecase "AIFR09: Generate client predictive intervention recommendations by identifying patterns that indicate potential financial difficulties or opportunities requiring advisor engagement." as AIFR09
  usecase "SFR23: Request predictive insights from the AI component to enhance the value of financial guidance provided to clients." as SFR23

  Client --> CFR001
  Client --> SAFR001
  Client --> FAFR004
  SysAdmin --> SAFR001
  Financial Advisor --> AIFR09
}

@enduml