@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor (FA): as FA
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Analysis Parameters" as SAFR001
  usecase "SFR003: Deliver Alerts to Users" as SFR003
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FA --> FAFR002
}

rectangle "Client Dashboard Features" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "SFR013: Generate Client Alerts" as SFR013
  
  Client --> CFR009
  SysAdmin --> SFR013
}

rectangle "Financial Advisor Features" {
  usecase "FAFR02: View Intervention Alerts" as FAFR02
  usecase "SFR016: Generate Predictive Insights" as SFR016
  
  FA --> FAFR02
  SysAdmin --> SFR016
}

rectangle "System Features" {
  usecase "SFR004: Request Personalized Recommendations" as SFR004
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  
  System Admin --> SAFR002
  FA --> FAFR015
}

rectangle "AI Features" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  System --> SFR003
}

rectangle "Feedback Mechanism" {
  usecase "CFR011: Send Feedback" as CFR011
  
  Client --> CFR011
  FA --> CFR011
  SysAdmin --> CFR011
}
@enduml