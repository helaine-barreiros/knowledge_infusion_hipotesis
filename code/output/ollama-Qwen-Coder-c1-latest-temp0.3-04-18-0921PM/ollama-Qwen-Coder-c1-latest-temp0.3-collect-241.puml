@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  usecase "CFR011: Send Feedback about System Recommendations and Insights" as CFR011

  Client --> (SAFR001)
  Client --> (FAFR002)
  Client --> (SFR003)
  Client --> (AIFR004)
  Client --> (CFR011)

  SysAdmin --> SAFR001
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "SFR004: Request Personalized Recommendations from AI Component Based on Each User's Financial Data and Preferences" as SFR004
  usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance As Defined by Industry Standards Like FINRA Guidelines" as AIFR002

  FAFD --> (FAFR001)
  FAFD --> (SFR004)
  FAFD --> (AIFR002)
}

rectangle "System Components" {
  usecase "SFR005: Request Spending Limit Alerts from AI Component When User Spending Patterns Exceed Defined Thresholds" as SFR005
  usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations From Established Spending Patterns" as AIFR003

  Sys --> (SFR005)
  Sys --> (AIFR003)

  usecase "SFR006: Request Investment Opportunity Analysis from AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles" as SFR006
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004

  Sys --> (SFR006)
  Sys --> (AIFR004)

  usecase "SFR007: Request Specific Investment Opportunities from AI Component That Match User Investment Criteria and ESG Preferences" as SFR007
  usecase "AIFR005: Generate Investment Opportunities for Users by Identifying Financial Instruments that Align with Their Investment Strategies and Modern Portfolio Theory Principles" as AIFR005

  Sys --> (SFR007)
  Sys --> (AIFR005)

  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component to Detect Potentially Fraudulent Activities in Accordance with AML Regulations" as SFR008
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance With FinCEN Requirements" as AIFR006

  Sys --> (SFR008)
  Sys --> (AIFR006)

  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios from Trusted Financial News Sources" as SFR009
  usecase "SFR010: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR010

  Sys --> (SFR009)
  Sys --> (SFR010)

  usecase "SFR11: Request Contextualized News Insights from AI Component to Identify Potential Impacts on Users' Investments" as SFR11
  usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007

  Sys --> (SFR11)
  Sys --> (AIFR007)

  usecase "SFR12: Request Predictive Intervention Analyses from AI Component to Identify When Financial Advisors Should Engage with Clients" as SFR12
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008

  Sys --> (SFR12)
  Sys --> (AIFR008)

  usecase "SFR13: Request Predictive Insights from AI Component to Enhance the Value of Financial Guidance Provided to Clients" as SFR13
  usecase "AIFR009: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009

  Sys --> (SFR13)
  Sys --> (AIFR009)

  usecase "SFR14: Request Financial Health Reports from AI Component that Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR14
  usecase "AIFR10: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as AIFR10

  Sys --> (SFR14)
  Sys --> (AIFR10)

  usecase "SFR15: Manage Users' Financial Goals to Track Progress and Provide Relevant Recommendations" as SFR15
  usecase "AIFR11: Generate Client Analytics That Provide Meaningful Insights into Financial Behavior and Performance" as AIFR11

  Sys --> (SFR15)
  Sys --> (AIFR11)

  usecase "SFR16: Request Predictive Insights from AI Component to Enhance the Value of Financial Guidance Provided to Clients" as SFR16
  usecase "AIFR09: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR09

  Sys --> (SFR16)
  Sys --> (AIFR09)

  usecase "SFR17: Manage Users' Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR17
  usecase "AIFR12: Generate Client Analytics That Provide Meaningful Insights into Financial Behavior and Performance" as AIFR12

  Sys --> (SFR17)
  Sys --> (AIFR12)

}

@enduml