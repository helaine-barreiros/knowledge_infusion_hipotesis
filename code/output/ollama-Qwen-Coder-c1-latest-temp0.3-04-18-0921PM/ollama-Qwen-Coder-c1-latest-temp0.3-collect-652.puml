@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  Client --> (SFR012) : Generate client dashboards that present financial information in an intuitive and actionable format.
  Client --> (SFR013) : Generate client alerts based on predefined conditions to ensure timely notification of important financial events.
  Client --> (AIFR009) : Generate contextualized news insights by correlating financial news with specific user portfolios to identify relevant impacts.
  
  SysAdmin --> SAFR001
  SysAdmin --> (SFR020) : Manage user feedback to continuously improve the quality and relevance of financial insights.
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage client mentoring sessions based on system-generated insights" as FAFD001
  usecase "FAFR003: View predictive analytics about my clients' financial situations to provide data-driven recommendations during consultations" as FAFD003
  
  Financial Advisor --> (SFR016) : Request predictive insights from the AI component to enhance the value of financial guidance provided to clients.
}

rectangle "Client" {
  usecase "CFR002: View alerts about anomalous transactions in my accounts" as CFR002
  usecase "CFR003: View financial predictions based on my historical data and current market trends" as CFR003
  usecase "CFR010: Manage my relationship with Financial Advisors, including permissions for sharing my financial data, to maintain privacy and control over my financial information." as CFR010
  
  Client --> (SFR008) : Request anomaly transaction alerts from the AI component to detect potentially fraudulent activities in accordance with AML regulations.
}

rectangle "System" {
  usecase "SAFR002: Manage client mentoring sessions based on system-generated insights" as SAFR002
  usecase "FAFR004: Configure analysis parameters for specific client segments to customize the system's behavior according to different client profiles and regulatory requirements such as GDPR or CCPA." as FAFD004
  
  System Admin --> (SAFR001)
  Financial Advisor --> SAFR002
}

rectangle "Client" {
  usecase "CFR005: Manage my personalized recommendations preferences to ensure the system provides insights relevant to my financial objectives and risk tolerance." as CFR005
  usecase "FAFR004: Configure analysis parameters for specific client segments to customize the system's behavior according to different client profiles and regulatory requirements such as GDPR or CCPA." as FAFD004
  
  Client --> (SFR018) : Manage users' financial goals to track progress and provide relevant recommendations.
}

rectangle "System" {
  usecase "FAFR002: View predictive analytics about my clients' financial situations to provide data-driven recommendations during consultations." as FAFD003
  usecase "AIFR001: Generate financial predictions for users by analyzing historical transaction data, market trends, and economic indicators" as AIFR001
  
  Financial Advisor --> (SFR016) : Request predictive insights from the AI component to enhance the value of financial guidance provided to clients.
}

rectangle "Client" {
  usecase "CFR004: Receive personalized recommendations aligned with my financial profile and goals to optimize my financial strategies and investment portfolio." as CFR004
  usecase "AIFR002: Generate personalized recommendations for users based on their financial profiles, goals, and risk tolerance as defined by industry standards like FINRA guidelines" as AIFR002
  
  Client --> (SFR013) : Generate client alerts based on predefined conditions to ensure timely notification of important financial events.
}

rectangle "System" {
  usecase "AIFR004: Generate spending limit alerts for users by identifying unusual deviations from established spending patterns." as AIFR004
  usecase "CFR006: View spending limit alerts when I exceed predefined thresholds in specific expense categories to maintain better control over my budget." as CFR006
  
  Client --> (SFR015) : Generate financial health reports that assess users' overall financial wellbeing according to standard financial ratios and metrics.
}

rectangle "Financial Advisor" {
  usecase "FAFR002: View predictive analytics about my clients' financial situations to provide data-driven recommendations during consultations." as FAFD003
  usecase "AIFR004: Generate spending limit alerts for users by identifying unusual deviations from established spending patterns." as AIFR004
  
  Financial Advisor --> (SFR016) : Request predictive insights from the AI component to enhance the value of financial guidance provided to clients.
}

rectangle "Client" {
  usecase "CFR007: View investment opportunities suitable to my risk profile (as defined under MiFID II or equivalent standards) to diversify my portfolio and maximize returns." as CFR007
  usecase "AIFR006: Generate investment opportunity analyses for users by evaluating potential investments against their risk profiles, time horizons, and financial goals." as AIFR006
  
  Client --> (SFR014) : Generate client analytics that provide meaningful insights into financial behavior and performance.
}

rectangle "System" {
  usecase "AIFR007: Generate investment opportunities for users by identifying financial instruments that align with their investment strategies and Modern Portfolio Theory principles." as AIFR005
  usecase "CFR011: Send feedback about the system's recommendations and insights to help improve the accuracy and relevance of future outputs" as CFR011
  
  Client --> (SFR20) : Manage user feedback to continuously improve the quality and relevance of financial insights.
}

@enduml