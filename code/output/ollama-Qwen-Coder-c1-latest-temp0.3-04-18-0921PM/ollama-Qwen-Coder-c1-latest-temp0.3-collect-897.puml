@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FAFR

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics about My Clients' Financial Situations" as FAFR003
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002
  
  User --> CFR001
  SysAdmin --> SAFR001
  FAFR --> (FAFR003)
}

rectangle "Client Dashboards and Alerts" {
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
  usecase "SFR020: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR020
  
  User --> (CFR010)
}

rectangle "Investment Opportunities and News" {
  usecase "FAFR007: View Investment Opportunities Suitable to My Risk Profile" as FAFR007
  usecase "SFR008: Find Contextualized News Relevant to Users' Financial Portfolios from Trusted Financial News Sources" as SFR008
  
  User --> (FAFR007)
}

rectangle "Predictive Insights and Recommendations" {
  usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance" as AIFR002
  usecase "SFR16: Request Predictive Insights from the AI Component to Enhance the Value of Financial Guidance Provided to Clients" as SFR16
  
  User --> (AIFR002)
}

rectangle "Spending Limits and Alerts" {
  usecase "CFR006: View Spending Limit Alerts When I Exceed Predefined Thresholds in Specific Expense Categories" as CFR006
  usecase "SFR005: Request Spending Limit Alerts from the AI Component when User Spending Patterns Exceed Defined Thresholds" as SFR005
  
  User --> (CFR006)
}

rectangle "Financial Health and Goals Management" {
  usecase "AIFR017: Generate Financial Health Reports that Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as AIFR017
  usecase "SFR18: Manage Users' Financial Goals to Track Progress and Provide Relevant Recommendations" as SFR18
  
  User --> (AIFR017)
}

rectangle "AI System Components" {
  usecase "AIFR009: Generate Client Predictive Intervention Recommendations by Identifying Patterns that Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR009
  usecase "SFR021: Request Predictive Insights from the AI Component to Enhance the Value of Financial Guidance Provided to Clients" as SFR021
  
  User --> (AIFR009)
}

rectangle "Feedback and Continuous Improvement" {
  usecase "CFR011: Send Feedback about the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as CFR011
}
@enduml