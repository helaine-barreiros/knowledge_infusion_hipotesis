@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR001
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as SAFR002
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as SAFR003
  usecase "CFR005: Manage Personalized Recommendations Preferences to Ensure Relevance" as SAFR004
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as SAFR005
  usecase "View Investment Opportunities Suitable to My Risk Profile" as SAFR006
  usecase "View News Related to My Investment Portfolio" as SAFR007
  usecase "Access a Personalized Dashboard That Consolidates Financial Information in a Single View" as SAFR008
  usecase "Manage Relationship with Financial Advisors, Including Permissions for Sharing Data" as SAFR009
  
  CFR001 --> SAFR001
  CFR001 --> SAFR002
  CFR001 --> SAFR003
  CFR001 --> SAFR004
  CFR001 --> SAFR005
  CFR001 --> SAFR006
  CFR001 --> SAFR007
  CFR001 --> SAFR008
  CFR001 --> SAFR009
  
  rectangle "Client System" {
    usecase "SFR020: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR020
    
    CFR001 --> SFR020
  }
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts When Patterns Require Professional Attention" as SAFR006
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as SAFR007
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments Based on Different Profiles and Regulatory Requirements" as SAFR018
  
  FAFR001 --> SAFR006
  FAFR001 --> SAFR007
  FAFR001 --> SAFR018
  
  rectangle "Financial Advisor System" {
    usecase "SFR020: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR020
    
    FAFR001 --> SFR020
  }
}

package "System Administrator" {
  actor SysAdmin as SAFR001
  
  usecase "SAFR001: Manage Analysis Parameters for AI System to Ensure Compliance with Regulatory Requirements" as SAFR009
  
  SysAdmin --> SAFR009
  
  rectangle "System Admin System" {
    usecase "SFR020: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR020
    
    SysAdmin --> SFR020
  }
}

package "AI System" {
  actor AI as AIFR001
  
  usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as SAFR005
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users Based on Their Risk Profiles, Time Horizons, and Financial Goals" as SAFR016
  
  AI --> SAFR005
  AI --> SAFR016
  
  rectangle "AI System Components" {
    usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance" as AIFR002
    
    AI --> AIFR002
  }
}
@enduml