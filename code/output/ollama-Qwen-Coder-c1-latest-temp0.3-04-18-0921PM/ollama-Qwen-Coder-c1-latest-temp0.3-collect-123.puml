@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

' Actors
actor Client as CFR001
actor FinancialAdvisor as FAFR002
actor SysAdmin as SAFR003
actor User as CFR011

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001_1
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002_1
  usecase "CFR003: View Financial Predictions" as CFR003_1
  usecase "CFR004: Receive Personalized Recommendations" as CFR004_1
  usecase "CFR005: Manage Recommendation Preferences" as CFR005_1
  usecase "CFR006: View Spending Limit Alerts" as CFR006_1
  usecase "CFR007: View Investment Opportunities" as CFR007_1
  usecase "CFR008: View Financial News" as CFR008_1
  usecase "CFR009: Access Personalized Dashboard" as CFR009_1
  usecase "CFR10: Manage Relationship with Advisors" as CFR10_1

  CFR001 --> CFR001_1
  CFR002 --> CFR002_1
  CFR003 --> CFR003_1
  CFR004 --> CFR004_1
  CFR005 --> CFR005_1
  CFR006 --> CFR006_1
  CFR007 --> CFR007_1
  CFR008 --> CFR008_1
  CFR009 --> CFR009_1
  CFR10 --> CFR10_1

}

rectangle "Financial Advisor" {
  usecase "FAFR002: Manage Client Mentoring Sessions" as FAFR002_1
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003_1
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004_1

  FinancialAdvisor --> FAFR002_1
  FinancialAdvisor --> FAFR003_1
  FinancialAdvisor --> FAFR004_1
}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001_1

  SysAdmin --> SAFR001_1
}

' Relationships between actors and use cases
User <|-- CFR001
User <|-- FinancialAdvisor
User <|-- SysAdmin

@enduml