@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR002
  usecase "CFR003: View Financial Predictions" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations" as SAFR004
  usecase "CFR005: Manage Recommendation Preferences" as SAFR005
  usecase "CFR006: View Spending Limit Alerts" as SAFR006
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as SAFR007
  usecase "CFR008: View News Related to My Investment Portfolio" as SAFR008
  usecase "CFR009: Access Personalized Dashboard" as SAFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as SAFR10
  
  CFR001 --> (SAFR002)
  CFR001 --> (SAFR003)
  CFR001 --> (SAFR004)
  CFR001 --> (SAFR005)
  CFR001 --> (SAFR006)
  CFR001 --> (SAFR007)
  CFR001 --> (SAFR008)
  CFR001 --> (SAFR009)
  CFR001 --> (SAFR10)
}

package "Financial Advisors" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts" as SAFR007
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as SAFR008
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as SAFR012
  
  FAFR001 --> (SAFR007)
  FAFR001 --> (SAFR008)
  FAFR001 --> (SAFR012)
}

package "System Administrator" {
  actor SystemAdmin as SAFR001
  
  usecase "SAFR001: Manage Analysis Parameters for the AI System" as SAFR001
  usecase "SFR018: Manage Users' Financial Goals to Track Progress and Provide Relevant Recommendations" as SFR018
  
  SAFR001 --> (SAFR001)
  SAFR001 --> (SFR018)
}

package "System Components" {
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from the AI Component" as AIFR001
  usecase "SFR004: Request Personalized Recommendations from the AI Component Based on Each User's Financial Data and Preferences" as AIFR002
  usecase "SFR005: Request Spending Limit Alerts from the AI Component When User Spending Patterns Exceed Defined Thresholds" as AIFR003
  usecase "SFR006: Request Investment Opportunity Analysis From the AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles" as AIFR004
  usecase "SFR007: Request Specific Investment Opportunities from the AI Component That Match User Investment Criteria and ESG Preferences" as AIFR005
  usecase "SFR008: Request Anomaly Transaction Alerts From the AI Component to Detect Potentially Fraudulent Activities in Accordance with AML Regulations" as AIFR006
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios from Trusted Financial News Sources" as SFR013
  usecase "SFR010: Process Contextualized News To Extract Relevant Information for Users' Financial Situations" as AIFR007
  usecase "SFR011: Request Contextualized News Insights From the AI Component to Identify Potential Impacts on Users' Investments" as AIFR008
  usecase "SFR012: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as SFR014
  usecase "SFR013: Generate Client Alerts Based On Predefined Conditions to Ensure Timely Notification of Important Financial Events" as AIFR009
  usecase "SFR014: Generate Client Analytics That Provide Meaningful Insights Into Financial Behavior and Performance" as SFR015
  usecase "SFR015: Request Predictive Intervention Analyses From the AI Component to Identify When Financial Advisors Should Engage With Clients" as AIFR010
  usecase "SFR016: Request Predictive Insights From the AI Component To Enhance the Value of Financial Guidance Provided to Clients" as AIFR011
  usecase "SFR017: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR024
  usecase "SFR019: Maintain a Historical Record of Users' Insights To Enable Trend Analysis and Effectiveness Measurement" as AIFR013
  
  SAFR001 --> (AIFR001)
  SAFR001 --> (AIFR002)
  SAFR001 --> (AIFR003)
  SAFR001 --> (AIFR004)
  SAFR001 --> (AIFR005)
  SAFR001 --> (AIFR006)
  SAFR001 --> (SFR012)
  SAFR001 --> (SFR013)
  SAFR001 --> (SFR014)
  SAFR001 --> (SFR015)
  SAFR001 --> (AIFR010)
  SAFR001 --> (AIFR011)
}

package "AI System" {
  usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance as Defined by Industry Standards Like FINRA Guidelines" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts for Users By Identifying Unusual Deviations From Established Spending Patterns" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses For Users By Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities for Users by Identifying Financial Instruments That Align with Their Investment Strategies and Modern Portfolio Theory Principles" as AIFR005
  
  SAFR001 --> (AIFR002)
  SAFR001 --> (AIFR003)
  SAFR001 --> (AIFR004)
  SAFR001 --> (AIFR005)
}

package "Feedback Management" {
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights to Help Improve Future Outputs" as SFR023
  
  CFR001 --> (SFR023)
  FAFR001 --> (SFR023)
  SAFR001 --> (SFR023)
}

@enduml