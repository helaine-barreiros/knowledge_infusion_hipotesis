@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
}

package "System Administrator" {
  actor SysAdmin as SAFR003
}

rectangle "User Interface" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "SFR12: Generate Client Dashboards" as SFR12
  
  CFR001 --> (CFR009)
  FAFR002 --> (CFR009)
  SAFR003 --> (CFR009)
}

rectangle "Alerts and Notifications" {
  usecase "SFR08: Request Anomaly Transaction Alerts" as SFR08
  usecase "SFR14: Generate Client Analytics" as SFR14
  
  CFR001 --> (SFR08)
  FAFR002 --> (SFR08)
  SAFR003 --> (SFR08)
  
  CFR001 --> (SFR14)
}

rectangle "Recommendations and Insights" {
  usecase "CFR005: Manage Personalized Recommendations Preferences" as CFR005
  usecase "AIFR02: Generate Personalized Recommendations" as AIFR02
  
  CFR001 --> (CFR005)
  FAFR002 --> (AIFR02)
  SAFR003 --> (AIFR02)
}

rectangle "Spending Limits and Budgeting" {
  usecase "SFR04: Request Spending Limit Alerts" as SFR04
  
  CFR001 --> (SFR04)
}

rectangle "Investment Opportunities" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "AIFR05: Generate Investment Opportunity Analyses" as AIFR05
  
  CFR001 --> (CFR007)
  FAFR002 --> (AIFR05)
}

rectangle "Financial Predictions and Insights" {
  usecase "SFR03: Request Financial Predictions from AI Component" as SFR03
  usecase "AIFR01: Generate Financial Predictions for Users" as AIFR01
  
  CFR001 --> (SFR03)
  FAFR002 --> (SFR03)
  SAFR003 --> (SFR03)
  
  CFR001 --> (AIFR01)
}

rectangle "News and Information" {
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "SFR09: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR09
  
  CFR001 --> (CFR008)
}

rectangle "Client Management and Relationship" {
  usecase "FAFR04: Configure Analysis Parameters for Specific Client Segments" as FAFR04
  usecase "SFR23: Manage Users' Financial Goals to Track Progress and Provide Relevant Recommendations" as SFR23
  
  CFR001 --> (FAFR04)
}

rectangle "System Operations" {
  usecase "AIFR06: Generate Anomaly Transaction Alerts by Employing Pattern Recognition" as AIFR06
  usecase "SFR07: Request Investment Opportunity Analysis from AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles, Time Horizons, and Financial Goals" as SFR07
  
  CFR001 --> (AIFR06)
  FAFR002 --> (AIFR06)
  
  SAFR003 --> (SFR07)
}

rectangle "AI System Functions" {
  usecase "AIFR08: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR08
  usecase "AIFR09: Generate Client Predictive Insights that Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR09
  
  CFR001 --> (AIFR08)
  FAFR002 --> (AIFR08)
  
  SAFR003 --> (AIFR09)
}

rectangle "Feedback and Improvement" {
  usecase "CFR11: Send Feedback about the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as CFR11
  
  CFR001 --> (CFR11)
  FAFR002 --> (CFR11)
}

@enduml