@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> CFR001 : "View"
  C --> CFR002 : "Receive Alerts on Anomalous Transactions"
  C --> CFR003 : "View Predictions"
  C --> CFR004 : "Receive Recommendations"
  C --> CFR005 : "Manage Preferences"
  C --> CFR006 : "View Spending Limits"
  C --> CFR007 : "View Investment Opportunities"
  C --> CFR008 : "View News"
  C --> CFR009 : "Access Dashboard"
  C --> CFR10 : "Manage Advisors"
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> FAFR001 : "Manage Sessions"
  FA --> FAFR002 : "View Alerts on Anomalous Transactions"
  FA --> FAFR003 : "View Predictive Analytics"
  FA --> FAFR004 : "Configure Parameters for Segments"
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFAFR002: Send Feedback to AI" as SFAFR002
  
  SA --> SAFR001 : "Manage"
  SA --> SFAFR002 : "Send Feedback"
}

package "System Components" {
  rectangle SystemComponents {
    usecase "SFR001: Deliver Alerts" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions from AI" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities from AI" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from AI" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
    usecase "SFR010: Process Contextualized News for Users" as SFR010
    usecase "SFR011: Request Contextualized News Insights from AI" as SFR011
    usecase "SFR012: Generate Client Dashboards" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
    usecase "SFR014: Generate Client Analytics for Meaningful Insights into Financial Behavior and Performance" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses from AI" as SFR015
    usecase "SFR016: Request Predictive Insights from AI to Enhance Value of Guidance Provided to Clients" as SFR016
    usecase "SFR017: Generate Financial Health Reports Based on Standard Ratios and Metrics" as SFR017
    usecase "SFR018: Manage Users' Financial Goals for Tracking Progress and Recommendations" as SFR018
    usecase "SFR019: Maintain Historical Record of User Insights for Trend Analysis" as SFR019
    usecase "SFR020: Manage User Feedback to Improve Accuracy and Relevance of Outputs" as SFR020
    
    C --> (SFR003) : "Request Predictions"
    C --> (SFR004) : "Request Recommendations"
    C --> (SFR005) : "Request Spending Limits Alerts"
    C --> (SFR006) : "Request Investment Opportunities Analysis"
    C --> (SFR012) : "Generate Dashboards"
    
    FA --> (SFR003)
    FA --> (SFR004)
    FA --> (SFR005)
    FA --> (SFR006)
    FA --> (SFR012)
    
    SA --> (SAFR001) : "Manage Parameters"
  }
}

@enduml