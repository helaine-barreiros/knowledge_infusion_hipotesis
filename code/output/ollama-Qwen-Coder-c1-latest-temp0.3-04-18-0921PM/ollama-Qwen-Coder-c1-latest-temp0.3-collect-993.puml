@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FAdvisor

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  
  User --> CFR001
  SysAdmin --> SAFR001
  FAdvisor --> (FAFR001)
  
  User --> SFR002 : "Receive Alerts"
  User --> SFR002 : "View Predictive Analytics"
  User --> AIFR002
  
  FAdvisor --> FAFR001
  FAdvisor --> (SFR003) : "View Client Intervention Alerts"
  
  System Admin -> SAFR001 : "Manage Analysis Parameters for AI System"
}

rectangle "Client" {
  usecase "CFR002: View Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as CFR004
  usecase "CFR005: Manage Personalized Recommendations Preferences to Ensure Insights Relevant to My Financial Objectives and Risk Tolerance" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as CFR006
  
  User --> (CFR002)
  User --> (CFR003)
  User --> (CFR004)
  User --> (CFR005)
  User --> (CFR006)
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR002
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as FAFR003
  
  FAdvisor --> (FAFR001)
  FAdvisor --> (FAFR003)
}

rectangle "System Functions" {
  usecase "SFR003: Deliver Personalized Recommendations Based on Financial Profiles to Support Better Decision-Making" as SFR002
  usecase "AIFR004: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as AIFR004
  
  System Admin --> SAFR001 : "Manage Analysis Parameters"
  
  User -> (SFR003)
  FAdvisor -> (FAFR002)
}

rectangle "AI Functions" {
  usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
  usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as AIFR004
  
  User --> (AIFR001)
  FAdvisor --> (AIFR004)
}

rectangle "User Feedback" {
  usecase "CFR11: Send Feedback About System's Recommendations and Insights to Improve Future Outputs" as CFR11
  user --> (CFR11) : "Provide Feedback"
}
@enduml