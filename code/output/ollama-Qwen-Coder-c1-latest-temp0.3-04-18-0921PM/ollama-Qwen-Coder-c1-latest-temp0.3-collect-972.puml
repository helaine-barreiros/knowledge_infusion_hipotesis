@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
}

package FinancialAdvisor {
  actor "Financial Advisor (FA)" as FAFR002
}

package SystemAdmin {
  actor "System Administrator (SA)" as SAFR003
}

rectangle "User Interface" {
  usecase "CFR009: View Personalized Dashboard" as CFR014
  usecase "SFR017: Generate Financial Health Reports" as SFR026
  
  CFR001 --> (View Alerts)
  FAFR002 --> (Manage Client Sessions)
  SAFR003 --> (Manage Analysis Parameters)
}

rectangle "Alerts and Notifications" {
  usecase "SFR001: Deliver Alerts" as SFR027
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR045
  
  CFR001 --> (View Spending Limit Alerts)
  FAFR002 --> (Manage Client Intervention Alerts)
}

rectangle "Recommendations and Insights" {
  usecase "SFR002: Deliver Personalized Recommendations" as SFR038
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR046
  
  CFR001 --> (View Financial Predictions)
  FAFR002 --> (View Predictive Analytics)
}

rectangle "Investment and News" {
  usecase "SFR007: Request Investment Opportunity Analysis" as SFR053
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR061
  
  CFR001 --> (View Suitable Investments)
  FAFR002 --> (Configure Client Segments)
}

rectangle "System Management" {
  usecase "SFR003: Request Financial Predictions" as SFR054
  usecase "AIFR001: Generate Financial Predictions" as AIFR062
  
  SAFR003 --> (Manage Analysis Parameters)
}

rectangle "Feedback and Support" {
  usecase "CFR011: Send Feedback" as CFR078
  
  CFR001 --> (Send Feedback)
  FAFR002 --> (Provide Guidance)
  SAFR003 --> (Support System Operations)
}
@enduml