@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR011: Generate Client Dashboards" as SFR012
  
  SA --> (SAFR001)
}

package "System" {
  rectangle SystemBoundary {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities from AI Component" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Portfolios" as SFR009
    usecase "SFR10: Process Contextualized News for Users" as SFR010
    usecase "SFR11: Request Contextualized News Insights from AI Component" as SFR011
    usecase "SFR12: Generate Client Alerts Based on Predefined Conditions" as SFR013
    usecase "SFR14: Generate Client Analytics for Users" as SFR014
    usecase "SFR15: Request Predictive Intervention Analyses from AI Component" as SFR015
    usecase "SFR16: Request Predictive Insights from AI Component" as SFR016
    usecase "SFR17: Generate Financial Health Reports for Users" as SFR017
    usecase "SFR18: Manage Users' Financial Goals and Track Progress" as SFR018
    usecase "SFR19: Maintain Historical Record of Insights for Trend Analysis" as SFR019
    usecase "SFR20: Manage User Feedback to Improve System Outputs" as SFR020
    
    C --> (SFR001)
    FA --> (SFR003)
    SA --> (SAFR005)
  }
}

package "AI Component" {
  rectangle AIBoundary {
    usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on User Strategies and MPT Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts in Compliance with FinCEN Requirements" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights for Users' Portfolios" as AIFR007
    usecase "AIFR008: Generate Predictive Intervention Recommendations Based on User Data" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights to Support Forward-Looking Analysis" as AIFR009
    
    SFR003 --> (AIFR001)
    SFR004 --> (AIFR002)
    SFR005 --> (AIFR003)
    SFR006 --> (AIFR004)
    SFR007 --> (AIFR005)
    SFR008 --> (AIFR006)
    SFR12 --> (AIFR007)
    SFR13 --> (AIFR009)
  }
}

C --> SystemBoundary
FA --> SystemBoundary
SA --> SystemBoundary

@enduml