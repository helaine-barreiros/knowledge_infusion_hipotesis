@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FAFR001

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Deliver Personalized Recommendations to Users" as SFR003
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  
  User --> CFR001
  SysAdmin --> SAFR001
  FAFR001 --> FAFR002
}

rectangle "Client Dashboard" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "SFR12: Generate Client Dashboards" as SFR12
  
  User --> CFR009
  SysAdmin --> SFR12
}

rectangle "Client Alerts" {
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  
  User --> CFR006
  SysAdmin --> SFR013
}

rectangle "Investment Opportunities and News" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "SFR008: Request Contextualized News from AI Component" as SFR008
  
  User --> CFR007
  SysAdmin --> SFR008
}

rectangle "Client Management and Feedback" {
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  usecase "SFR20: Manage Users' Financial Goals to Track Progress and Provide Relevant Recommendations" as SFR20
  
  User --> CFR10
  SysAdmin --> SFR20
}

rectangle "AI System Functions" {
  usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  
  SysAdmin --> (SFR16)
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
  
  SysAdmin --> (SFR15)
}

rectangle "System Functions" {
  usecase "SAFR001: Manage Analysis Parameters for the AI System" as SAFR001
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
  
  SysAdmin --> (SFR08)
}

rectangle "Feedback Management" {
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights" as CFR11
  usecase "AIFR09: Generate Client Predictive Insights that Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR09
  
  SysAdmin --> (SFR20)
}
@enduml