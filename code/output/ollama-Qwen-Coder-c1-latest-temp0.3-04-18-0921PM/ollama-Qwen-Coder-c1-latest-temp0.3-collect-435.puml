@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System: as Sys
:Financial Advisor: as FAdvisor
:System Administrator: as SA

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  usecase "CFR011: Send Feedback about System Recommendations and Insights" as CFR011
  
  Client --> (SA)
  FAdvisor --> (SFR003)
  SysAdmin --> SAFR001
}

rectangle "Client Dashboard" {
  usecase "CFR002: View Alerts About Anomalous Transactions" as CFR002
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as CFR006
  
  Client --> (SA)
}

rectangle "Financial Predictions and Recommendations" {
  usecase "CFR003: View Financial Predictions Based on Historical Data and Current Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals to Optimize My Financial Strategies and Investment Portfolio" as CFR004
  
  Client --> (SA)
}

rectangle "Investment Opportunities and News" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile (as Defined Under MiFID II or Equivalent Standards) to Diversify My Portfolio and Maximize Returns" as CFR007
  usecase "CFR008: View News Related to My Investment Portfolio to Stay Informed About Market Events That Might Affect My Assets" as CFR008
  
  Client --> (SA)
}

rectangle "Client Relationship Management" {
  usecase "CFR10: Manage My Relationship with Financial Advisors, Including Permissions for Sharing My Financial Data, to Maintain Privacy and Control Over My Financial Information" as CFR10
  FAdvisor --> (SFR020)
  
  Client --> (SA)
}

rectangle "System Functions" {
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios from Trusted Financial News Sources" as SFR009
  
  System --> (AIFR007)
}
@enduml