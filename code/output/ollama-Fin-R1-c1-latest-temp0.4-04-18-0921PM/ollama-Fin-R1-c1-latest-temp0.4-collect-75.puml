@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sa
actor FinancialAdvisor as fa

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Spent Limit Alerts for Budget Control" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access Portfolio-Related News" as CFR008
  usecase "CFR009: Consolidated Financial Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10

  c1 --> CFR001 : View financial data in a comprehensive format.
  c1 --> CFR002 : Receive alerts for unusual transactions per FATF regulations.
  c1 --> CFR003 : See future predictions based on history and trends.
  c1 --> CFR004 : Get personalized finance advice tailored to goals.
  c1 --> CFR005 : Adjust personalization settings in KYC profile.
  c1 --> CFR006 : Get alerts when spending exceeds limits per category.
  c1 --> CFR007 : Find investment options aligned with risk tolerance (MiFID II).
  c1 --> CFR008 : Stay informed about market events affecting investments.
  c1 --> CFR009 : Access all financial info in one place for efficiency.
  c1 --> CFR10 : Control sharing of data with advisors for privacy and control.

}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  sa --> SAFR001 : Adjust parameters to ensure accuracy, relevance & compliance (Basel III).
  
}
  
rectangle "Financial Advisor" {
  usecase "FAFR001: Schedule Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: Review Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters per Segment" as FAFR004

  fa --> FAFR001 : Plan sessions using system-generated data.
  fa --> FAFR002 : Act on alerts from the system to help clients.
  fa --> FAFR003 : Use predictive insights in client discussions.
  fa --> FAFR004 : Customize settings for different client groups.

}

rectangle "System" {
  usecase "SFR001: Deliver Alerts Through Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI" as SFR003
  usecase "SFR004: Request Personalized Recs Based on Profiles" as SFR004
  usecase "SFR005: Spent Limit Alerts for Users" as SFR005
  usecase "SFR006: Investment Opportunity Analysis" as SFR006
  usecase "SFR007: Specific Investment Opportunities Matching Criteria and ESG" as SFR007
  usecase "SFR008: Anomaly Transaction Alerts for AML Compliance" as SFR008
  usecase "SFR009: Contextualized News Relevant to Portfolios" as SFR009
  usecase "SFR010: Client Dashboards Generation" as SFR010
  usecase "SFR011: Process Contextualized News for Users" as SFR011
  usecase "SFR012: Generate Predictive Intervention Analyses" as SFR012
  usecase "SFR013: Client Analytics Generation" as SFR013
  usecase "SFR014: Historical Record Management for Insights" as SFR014
  usecase "SFR015: Request Predictive Interventions from AI" as SFR015
  usecase "SFR016: Enhance Value of Financial Guidance with AI" as SFR016
  usecase "SFR017: Generate Financial Health Reports" as SFR017
  usecase "SFR018: Manage Users' Financial Goals Tracking" as SFR018
  usecase "SFR019: Maintain Historical Record of Insights for Trend Analysis" as SFR019
  usecase "SFR020: Handle User Feedback to Improve System" as SFR020

}

rectangle "AI Component" {
  usecase "AIFR001: Generate Financial Predictions via Data & Trends" as AIFR001
  usecase "AIFR002: Personalized Recs Based on Profiles and Risk Tolerance" as AIFR002
  usecase "AIFR003: Spent Limit Alerts by Identifying Unusual Spending Patterns" as AIFR003
  usecase "AIFR004: Investment Opportunity Analysis Aligning with Risk Profiles" as AIFR004
  usecase "AIFR005: Identify Financial Instruments Based on Portfolio Strategies & MPT" as AIFR005
  usecase "AIFR006: Anomaly Transaction Alerts via Pattern Recognition for Fraud Detection" as AIFR006
  usecase "AIFR007: Contextualized News Insights Correlated with Portfolios" as AIFR007
  usecase "AIFR008: Predictive Intervention Recs to Engage Advisors at Right Times" as AIFR008
  usecase "AIFR009: Forward-Looking Analysis for Effective Financial Planning" as AIFR009

}

@enduml