@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sa
actor FinancialAdvisor as fa
system :System: as sys

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with Financial Profile and Goals" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile and ESG Criteria" as CFR007
  usecase "CFR008: Access News Related to Financial Portfolio" as CFR008
  usecase "CFR009: Manage Relationship with Financial Advisors, Including Sharing Data" as CFR009
  
  c1 --> CFR001 : "View"
  c1 --> CFR002 : "Receive Alerts for Anomalous Transactions"
  c1 --> CFR003 : "View Predictions Based on Historical and Market Trends"
  c1 --> CFR004 : "Receive Personalized Recommendations"
  c1 --> CFR005 : "Manage Preferences"
  c1 --> CFR006 : "View Spending Limit Alerts"
  c1 --> CFR007 : "View Investment Opportunities"
  c1 --> CFR008 : "Access News Related to Portfolio"
  c1 --> CFR009 : "Manage Relationship with Advisors, Share Data"
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  fa --> FAFR001 : "Manage Mentoring Sessions"
  fa --> FAFR002 : "View Intervention Alerts"
  fa --> FAFR003 : "View Predictive Analytics"
  fa --> FAFR004 : "Configure Analysis Parameters for Segments"
}

rectangle "System Administrator" {
  usecase "SAFR001: Manage AI System's Analysis Parameters to Ensure Accuracy and Compliance with Financial Regulations (Basel III)" as SAFR001
  sa --> SAFR001 : "Manage Analysis Parameters"
}

system sys <|-- CFR002 : "Deliver Alerts via Notification Channels"
sys sys <|-- AIFR006 : "Generate Anomaly Transaction Alerts Based on Pattern Recognition"

CFR004 <|-- AIFR005 : "Request Personalized Recommendations from AI"
AIFR008 <|-- FAFR002 : "Identify Patterns for Proactive Client Engagement"

rectangle "AI System" {
  usecase "AIFR001: Generate Financial Predictions Based on Historical Data and Market Trends" as AIFR001
  usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Patterns" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses Based on Risk Profiles and Financial Goals" as AIFR004
  usecase "AIFR005: Generate Personalized Recommendations Aligned with Client's Financial Profile" as AIFR005
  usecase "AIFR006: Detect Anomalous Transactions Using Pattern Recognition for Fraud Detection" as AIFR006
  usecase "AIFR007: Correlate News to User Portfolios for Relevant Insights" as AIFR007

  sys --> AIFR001 : "Request Predictions"
  sys --> AIFR003 : "Request Spending Limit Alerts"
  sys --> AIFR004 : "Request Investment Opportunities"
  sys --> AIFR005 : "Request Recommendations"
}

@enduml