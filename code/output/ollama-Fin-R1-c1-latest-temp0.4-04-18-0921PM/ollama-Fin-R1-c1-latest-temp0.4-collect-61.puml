@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sas
actor FinancialAdvisor as faa
system "System" as sys

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile (MiFID II)" as CFR007
  usecase "CFR008: Receive News Related to Investment Portfolio" as CFR008
  usecase "CFR009: Consolidated Personalized Dashboard for Financial Monitoring" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors, Including Data Sharing Permissions" as CFR10

}

rectangle "System Administrator Interface" {
  usecase "SAFR001: Manage Analysis Parameters to Ensure Accuracy and Compliance" as SAFR001
}

rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Proactive Assistance to Clients" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
}

rectangle "System Core Components" {
  usecase "SFR001: Deliver Alerts Through Notification Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts When Exceeding Thresholds" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis Based on Risk Profiles" as SFR006
  usecase "SFR007: Find Specific Investment Opportunities Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts for AML Compliance" as SFR008
  usecase "SFR009: Extract Contextualized News Relevant to Users' Portfolios" as SFR009
  usecase "SFR010: Generate Client Dashboards in Intuitive Format" as SFR010
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
}

rectangle "AI System Components" {
  usecase "AIFR001: Generate Financial Predictions by Analyzing Historical Data and Market Trends" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations Based on Financial Profiles" as AIFR002
  usecase "AIFR003: Identify Spending Limit Alerts for Unusual Patterns" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities Against Risk Profiles and Strategies" as AIFR004
  usecase "AIFR005: Find Financial Instruments Aligning with Investment Goals" as AIFR005
  usecase "AIFR006: Detect Anomalous Transactions Using Pattern Recognition for Fraud Detection" as AIFR006
  usecase "AIFR007: Correlate News to User Portfolios for Relevant Insights" as AIFR007
}

useclient c1 --> CFR001 : "View Financial Insights Dashboard"
c1 --> CFR002 : "Receive Alerts for Anomalous Transactions"
c1 --> CFR003 : "View Financial Predictions Based on Historical Data and Market Trends"
c1 --> CFR004 : "Personalized Recommendations Aligned with Financial Profile"
c1 --> CFR005 : "Manage Preferences for Personalized Recommendations"
c1 --> CFR006 : "View Spending Limit Alerts When Exceeding Thresholds"
c1 --> CFR007 : "Access Investment Opportunities Based on Risk Profile (MiFID II)"
c1 --> CFR008 : "Receive News Related to Investment Portfolio"
c1 --> CFR009 : "Consolidated Personalized Dashboard for Financial Monitoring"
c1 --> CFR10 : "Manage Relationship with Financial Advisors, Including Data Sharing Permissions"

sas --> SAFR001 : "Manage Analysis Parameters to Ensure Accuracy and Compliance"

faa --> FAFR001 : "Manage Client Mentoring Sessions Based on System-Generated Insights"
faa --> FAFR002 : "View Intervention Alerts for Proactive Assistance to Clients"
faa --> FAFR003 : "View Predictive Analytics About Clients' Financial Situations"

sysAdmin --> sys
financialAdvisor --> sys

@enduml