@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage User Permissions and Data Sharing" as SAFR002
  
  Client --> CFR001 : "View"
  
  SysAdmin -> (SFR019) : "Manage Historical Record of Users' Insights"
}

rectangle "Financial Advisor" {
  actor FAFR001
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  
  SysAdmin -> (SFR013) : "Generate Client Alerts"
  
}

rectangle "System Administrator" {
  actor SAFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  SysAdmin -> (SFR020) : "Manage User Feedback"
}

rectangle "Client" {
  actor Client
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Investment Portfolio" as CFR008
  usecase "CFR009: View Consolidated Financial Information in a Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors Including Data Sharing Permissions" as CFR10
  
}

rectangle "System" {
  actor SysAdmin, FAFR004, SAFR002

  SysAdmin -> (SFR017) : "Generate Financial Health Reports"
  
  SysAdmin --> SAFR002
  SysAdmin --> FAFR004
}
@enduml