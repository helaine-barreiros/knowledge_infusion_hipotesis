@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Investment Portfolio" as CFR008
  usecase "CFR009: Manage Relationship with Financial Advisors, Including Data Sharing Permissions" as CFR009
}

rectangle "Financial Advisor (FAFR)" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
}

rectangle "System Administrator (SAFR)" {
  usecase "SAFR001: Manage Analysis Parameters for AI System Compliance with Basel III and Other Regulations" as SAFR001
}

rectangle "System (SFR)" {
  usecase "SFR002: Deliver Personalized Recommendations Based on Financial Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts When Exceeding Thresholds" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis Based on Risk Profiles" as SFR006
  usecase "SFR007: Find Specific Investment Opportunities Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts for AML Compliance" as SFR008
  usecase "SFR009: Process Contextualized News from Financial Sources" as SFR009
  usecase "SFR010: Generate Client Dashboards with Intuitive Financial Information" as SFR010
  usecase "SFR013: Manage Users' Financial Goals for Progress Tracking and Recommendations" as SFR013
}

rectangle "AI System (AIFR)" {
  usecase "AIFR002: Generate Personalized Recommendations Based on User Profiles, Goals, Risk Tolerance" as AIFR002
  usecase "AIFR004: Identify Investment Opportunities Aligning with User Strategies and MPT Principles" as AIFR004
}

rectangle "User (Client)" {
  actor Client as c1
  client --> CFR001 : View Financial Insights Dashboard\n(c1)
  
  client --> CFR002 : Receive Alerts on Anomalous Transactions\n(c1)
  
  client --> CFR003 : View Financial Predictions Based on Historical Data and Market Trends\n(c1)
  
  client --> CFR004 : Receive Personalized Recommendations Aligned with Financial Profile\n(c1)
  
  client --> CFR005 : Manage Preferences for Personalized Recommendations\n(c1)
  
  client --> CFR006 : View Spending Limit Alerts When Exceeding Thresholds\n(c1)
  
  client --> CFR007 : View Investment Opportunities Based on Risk Profile\n(c1)
  
  client --> CFR008 : Access News Related to Investment Portfolio\n(c1)
  
  client --> CFR009 : Manage Relationship with Financial Advisors, Including Data Sharing Permissions\n(c1)
}

rectangle "Financial Advisor" {
  actor FAFR as fad
  fad --> FAFR001 : Manage Client Mentoring Sessions Based on System-Generated Insights\n(fad)
  
  fad --> FAFR002 : View Client Intervention Alerts for Proactive Assistance\n(fad)
  
  fad --> FAFR003 : View Predictive Analytics About Clients' Financial Situations\n(fad)
}

