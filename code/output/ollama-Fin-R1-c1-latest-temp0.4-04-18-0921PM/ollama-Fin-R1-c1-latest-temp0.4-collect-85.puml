  usecase SFR008: Request Anomaly Transaction Alerts for AML Compliance\n(SFR008)
  
  usecase SFR009: Process Contextualized News from Financial Sources\n(SFR009)
  
  usecase SFR010: Generate Client Dashboards with Intuitive Financial Information\n(SFR010)
  
  usecase SFR013: Manage Users' Financial Goals for Progress Tracking and Recommendations\n(SFR013)
}

rectangle "AI System" {
  usecase AIFR002: Generate Personalized Recommendations Based on User Profiles, Goals, Risk Tolerance\n(AIFR002)
  
