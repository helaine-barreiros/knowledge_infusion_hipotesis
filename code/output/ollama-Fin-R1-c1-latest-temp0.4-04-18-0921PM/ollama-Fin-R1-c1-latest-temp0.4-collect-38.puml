@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as C1
actor SysAdmin as SA
actor FinancialAdvisor as FA

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003

  C1 --> CFR001 : "View Financial Insights Dashboard"
  SA --> SAFR001 : "Manage Analysis Parameters"
  FA --> FAFR003 : "View Predictive Analytics"

  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  C1 --> CFR002 : "Receive Alerts about Anomalous Transactions"

  usecase "CFR004: Personalized Recommendations Based on Financial Profile" as CFR004
  C1 --> CFR004 : "Personalized Recommendations"

  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  C1 --> CFR005 : "Manage Preference Settings for Recommendations"

  usecase "CFR006: View Spending Limit Alerts" as CFR006
  C1 --> CFR006 : "View Spent Limit Exceedance Alerts"

  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  C1 --> CFR007 : "Access Suitable Investments for My Portfolio"

  usecase "CFR008: View News Related to Financial Portfolio" as CFR008
  C1 --> CFR008 : "View Relevant Market News"

  usecase "CFR009: Consolidated Personalized Dashboard" as CFR009
  C1 --> CFR009 : "Consolidate My Finances in a Single View"

  usecase "SAFR002: Manage Client Mentoring Sessions Based on Insights" as SAFR002
  FA --> SAFR002 : "Manage Client Mentorship"

  usecase "FAFR001: View Client Intervention Alerts" as FAFR001
  FA --> FAFR001 : "View Interventions Required for Clients"

  usecase "SFR004: Request Personalized Recommendations from System" as SFR004
  Sys --> SFR004 : "Request User-Specific Recommendations"
  
  usecase "AIFR002: Generate Personalized Recommendations Based on Data and Preferences" as AIFR002
  AI --> AIFR002 : "Generate Personalized Recommendations"

  usecase "CFR011: Send Feedback to Improve System Outputs" as CFR011
  C1, FA, SA --> CFR011 : "Provide Feedback"
}

@enduml