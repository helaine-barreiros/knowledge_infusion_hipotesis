@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Anomaly Alerts Thresholds" as SAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "SAFR001: Monitor System Parameters for Compliance" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "CFR006: Receive Spending Limit Alerts" as CFR006
  usecase "SAFR003: Customize Analysis Parameters for Segments" as SAFR003
  usecase "SFR018: Track Financial Goals Progress" as SFR018

  Client --> CFR001 : View financial data dashboard  
  Client --> CFR002 : Receive transaction alerts (FATF compliant)  
  Client --> CFR003 : Get future predictions based on history and trends  
  Client --> CFR004 : Personalized investment advice tailored to profile  
  Client --> CFR005 : Adjust personalization settings for recommendations  
  SysAdmin --> SAFR001 : Manage system parameters (Basel III)  
  FAFR002: Financial Advisor --> FAFR002 : View client alerts when needed  
  FinancialAdvisor --> FAFR003 : Monitor client-specific alerts  
  Client --> CFR006 : Get spending limit warnings on budget overages  
  SysAdmin --> SAFR003 : Set segment-specific analysis rules (GDPR, CCPA)  
  System --> SFR018 : Track and report goal progress  

}
@enduml