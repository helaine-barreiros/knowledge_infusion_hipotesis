@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Receive Alerts on Anomalous Transactions" as SAFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds" as CFR006
  usecase "CFR007: View Investment Opportunities Suitable to Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Investment Portfolio" as CFR008
  usecase "CFR009: Manage Relationship with Financial Advisors Including Data Sharing Permissions" as CFR009
  usecase "SAFR003: Deliver Alerts Through Notification Channels" as SAFR003
  usecase "SFR012: Generate Client Dashboards for Intuitive Monitoring" as SFR012

  package Professional {
    actor User as u
    user --> CFR001 : "View Financial Insights Dashboard"
    user --> SAFR002 : lient --> SAFR003 : "Receive Alerts on Anomalous Transactions"
    user --> CFR004 : "Receive Personalized Recommendations Aligned with Financial Profile"
    user --> CFR005 : "Manage Preferences for Personalized Recommendations"
    user --> CFR006 : "View Spending Limit Alerts When Exceeding Predefined Thresholds"
    user --> CFR007 : "View Investment Opportunities Suitable to Risk Profile"
    user --> CFR008 : "Access News Related to Investment Portfolio"
    user --> CFR009 : "Manage Relationship with Financial Advisors Including Data Sharing Permissions"

  }

  package Admin {
    actor SysAdmin as sa
    sysadmin --> SAFR001 : "Manage Analysis Parameters for AI System Compliance"
  }

  package Advisor {
    actor FAFR001: FinancialAdvisor as faa
    faa --> FAFR002 : "View Client Intervention Alerts Based on System Insights"
    faa --> FAFR003 : "View Predictive Analytics About Clients' Situations for Consultations"
  }

  package AI {
    actor AIFR001: AIsystem as aif
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Identify Investment Opportunities Based on Risk Profile" as AIFR004

  }

}

@enduml