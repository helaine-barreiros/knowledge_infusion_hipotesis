@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage User Preferences (Client)" as SAFR002
  usecase "SFR009: Request Contextualized News from AI Component" as SFR009
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  
  Client --> CFR001 : View financial data and insights.
  
  // Financial Advisor interactions with the system
  FAFR002 -> SAFR002 : Manage client intervention alerts (view).
  FAFR003 -> AIFR008: Generate predictive intervention recommendations for clients.
  FAFR004 -> SFR015: Request predictive intervention analyses from AI component.

  // System Administrator interactions
  SysAdmin --> SAFR002 : Manage analysis parameters (client preferences).
  
  // Client feedback loop
  CFR011 -->> AIFR009 : Send user feedback to improve recommendations.
}

@enduml