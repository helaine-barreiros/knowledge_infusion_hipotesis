@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Anomaly Detection Parameters" as SAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Portfolio" as CFR008
  usecase "CFR009: View Consolidated Financial Dashboard" as CFR010
  usecase "CFR010: Manage Relationship with Advisors" as CFR010

  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "SFR015: Request Predictive Interventions from AI" as SFR015

  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Identify Investment Opportunities Based on Risk Profile" as AIFR004
  usecase "AIFR005: Generate Investment Opportunity Analysis" as AIFR005
  usecase "AIFR006: Detect Anomaly Transactions" as AIFR006
  usecase "AIFR007: Correlate News with Portfolios" as AIFR007
  usecase "AIFR008: Recommend Predictive Interventions for Advisors" as AIFR008

  usecase "CFR011: Send Feedback to System" as CFR011
  
  
  actor Client as cClient
  actor FinancialAdvisor as fAdvisor
  actor SysAdmin as sAdmin
}

sAdmin --> SAFR002 : Configure system parameters for anomaly detection.
cClient --> CFR001, CFR003, CFR004, CFR005, CFR006, CFR007, CFR008, CFR009, CFR010
fAdvisor --> FAFR002, FAFR003, SFR015

cClient -> AIFR001 : Request financial predictions.
cClient -> AIFR004 : Request investment opportunities based on risk profile.

sAdmin -> SAFR001 : Manage analysis parameters for compliance with regulations like Basel III and FATF.

fAdvisor --> FAFR003, FAFR002

CFR010 <|-- (cClient) : Client manages relationships.
FAFR004 <|-- fAdvisor : Advisor views predictive analytics based on system-generated insights.

AIFR007 -> SFR009 : AI generates contextualized news for clients' portfolios.

SFR008, AIFR006 --> CFR010 : System and AI generate spending limit alerts.
CFR005 <|-- cClient : Client manages preferences.

AIFR002, AIFR004 --> SFR003: AI generates personalized recommendations for clients based on their profiles and goals.

SFR015 -> AIFR008 : System requests predictive interventions from the AI component.
AIFR008 <|-- fAdvisor : AI recommends when advisors should engage with clients.

CFR011 --> SFR020: Client provides feedback to improve system outputs.

@enduml