@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor FinancialAdvisor as fa1
actor SysAdmin as sa1
system "System" as sys

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Access Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Receive Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities Suitable to Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidate Financial Information in a Single Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10

  c1 --> CFR001 : "View financial data"
  c1 --> CFR002 : "Receive alerts about anomalous transactions"
  c1 --> CFR003 : "Get future predictions"
  c1 --> CFR004 : "Access personalized recommendations"
  c1 --> CFR005 : "Adjust preferences for recommendations"
  c1 --> CFR006 : "Get spending limit alerts when exceeding thresholds"
  c1 --> CFR007 : "Find investment opportunities matching risk profile"
  c1 --> CFR008 : "Stay informed about market events affecting portfolio"
  c1 --> CFR009 : "Monitor finances from one place"
  c1 --> CFR10 : "Control data sharing with advisors"

}

rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: Review Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Segment" as FAFR004

  fa1 --> FAFR001 : "Plan mentoring sessions"
  fa1 --> FAFR002 : "Respond to alerts"
  fa1 --> FAFR003 : "Analyze client data"
  fa1 --> FAFR004 : "Set segment-specific parameters"

}

rectangle "System Administrator Interface" {
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001

  sa1 --> SAFR001 : "Adjust system settings to ensure accuracy and compliance"
}

rectangle "AI Component" {
  usecase "AIFR001: Generate Financial Predictions Based on Data and Trends" as AIFR001
  usecase "AIFR002: Create Personalized Recommendations Aligning with Profiles" as AIFR002
  usecase "AIFR003: Issue Spending Limit Alerts for Unusual Activity" as AIFR003
  usecase "AIFR004: Identify Investment Opportunities Matching Risk Tolerance" as AIFR004
  usecase "AIFR005: Suggest Investments Based on Portfolio Theory and Goals" as AIFR005
  usecase "AIFR006: Detect Anomalous Transactions Using Pattern Recognition" as AIFR006
  usecase "AIFR007: Correlate News with Client Portfolios for Relevance" as AIFR007
  usecase "AIFR008: Recommend Interventions Based on Predictive Analysis" as AIFR008
  usecase "AIFR009: Provide Forward-Looking Insights into Financial Situations" as AIFR009

}

rectangle "System Functions" {
  usecase "SFR001: Deliver Alerts Through Appropriate Channels" as SFR001
  usecase "SFR002: Personalize Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Monitor Spending Limits via AI Alerts" as SFR005
  usecase "SFR006: Analyze Investment Opportunities for Users" as SFR006
  usecase "SFR007: Find Specific Investments Matching Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Detect Anomalous Transactions in Compliance with AML Rules" as SFR008
  usecase "SFR009: Extract Relevant News for Portfolios from AI Insights" as SFR009
  usecase "SFR010: Generate Client Dashboards" as SFR010
  usecase "SFR011: Create Contextualized News Summaries" as SFR011
  usecase "SFR012: Perform Trend Analysis on Historical Insights" as SFR012
  usecase "SFR013: Track User Progress Against Financial Goals" as SFR013
  usecase "SFR014: Manage Feedback to Improve System Accuracy" as SFR014

}

rectangle "Client-Specific Use Cases" {
  c1 --> AIFR002 : "Receive personalized recommendations"
  c1 --> CFR005 : "Adjust preferences for recommendations"

  usecase "CFR011: Send Feedback to Improve System Outputs" as CFR011
}
@enduml