@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR004: Personalized Recommendations Based on Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidated Financial Dashboard" as CFR009
  usecase "CFR010: Manage Relationship with Advisors" as CFR010

  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013

  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  usecase "AIFR004: Identify Investment Opportunities Aligning with Risk Profiles" as AIFR004
}

actor Client as client {
  --> CFR001 : View Financial Insights Dashboard
  --> CFR002 : Receive Alerts on Anomalous Transactions
  --> CFR003 : View Predictive Analytics for Clients (FAFR003)
  --> CFR004 : Personalized Recommendations Based on Financial Profile
  --> CFR005 : Manage Preferences for Personalized Recommendations
  --> CFR006 : View Spending Limit Alerts
  --> CFR007 : Access Investment Opportunities Based on Risk Profile
  --> CFR008 : Receive News Related to Portfolio
  --> CFR009 : Consolidated Financial Dashboard
}

actor SystemAdministrator as sysAdmin {
  --> SAFR001 : Manage Analysis Parameters for AI System (SAFR001)
}

actor FinancialAdvisor as advisor {
  --> FAFR003: View Predictive Analytics for Clients (FAFR003)
  --> FAFR002: Manage Client Mentoring Sessions Based on Insights
  --> FAFR004: View Intervention Alerts When System Detects Patterns
}

actor SFR as system {
  --> SFR001 : Deliver Alerts Through Notification Channels
  --> SFR003 : Request Financial Predictions from AI Component (SFR003)
  --> SFR002 : Deliver Personalized Recommendations to Users via Client Interface (Client)
  --> SFR004 : Request Personalized Recommendations Based on User Data and Preferences (SFR004)
}

actor AIFR as ai {
  --> AIFR001: Generate Financial Predictions Using Historical Data, Market Trends
  --> AIFR002: Generate Personalized Recommendations for Users (AIFR002)
  --> AIFR003: Generate Spending Limit Alerts Based on Unusual Patterns
}

actor ClientUser as clientUser {
  -- No direct use cases here. All user interactions are handled through the 'Client' actor.
}
@enduml