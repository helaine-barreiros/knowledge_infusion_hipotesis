@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sas
actor FinancialAdvisor as faa
system "System" as sys

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Data and Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with Profile" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Portfolio" as CFR008
  usecase "CFR009: View Consolidated Financial Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors, Including Data Sharing Permissions" as CFR10

}

rectangle "System Administrator Interface" {
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
}
  
rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts from System" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
}

rectangle "System Core" {
  
  usecase "SFR001: Deliver Alerts Through Notification Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AI" as SFR004
  usecase "SFR005: Request Spending Limit Alerts From AI" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Matching Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts From AI for Fraud Detection" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Portfolio" as SFR009
  usecase "SFR010: Generate Client Dashboards with Financial Information" as SFR010
  usecase "SFR011: Process Contextualized News for User Insights" as SFR011
  usecase "SFR012: Request Predictive Intervention Analyses from AI" as SFR012
  usecase "SFR013: Generate Client Analytics Based on Financial Data" as SFR013
  usecase "SFR014: Manage Historical Record of Insights for Trend Analysis" as SFR014
}

rectangle "AI Component" {
  
  usecase "AIFR001: Generate Financial Predictions by Analyzing Data and Trends" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations Based on Profiles and Goals" as AIFR002
  usecase "AIFR003: Identify Spending Limit Alerts for Users" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities Against Risk Profiles" as AIFR004
  usecase "AIFR005: Generate Investment Opportunity Lists Based on Strategies and MPT Principles" as AIFR005
  usecase "AIFR006: Detect Anomalous Transactions Using Pattern Recognition for Fraud Detection" as AIFR006
  usecase "AIFR007: Correlate Financial News with Portfolios to Extract Relevant Insights" as AIFR007
}

sas --> SAFR001

c1 --> CFR001 : "View Financial Insights Dashboard"
c1 --> CFR002 : "Receive Alerts on Anomalous Transactions"
c1 --> CFR003 : "View Financial Predictions Based on Data and Trends"
c1 --> CFR004 : "Receive Personalized Recommendations Aligned with Profile"
c1 --> CFR005 : "Manage Recommendation Preferences"
c1 --> CFR006 : "View Spending Limit Alerts When Exceeding Thresholds"
c1 --> CFR007 : "Access Investment Opportunities Based on Risk Profile"
c1 --> CFR008 : "Receive News Related to Portfolio"
c1 --> CFR009 : "View Consolidated Financial Dashboard"
c1 --> CFR10 : "Manage Relationship with Advisors, Including Data Sharing Permissions"

faa --> FAFR001
faa --> FAFR002
faa --> FAFR003

sas <|-- SFR001
sas <|-- SFR002
sas <|-- SFR003
sas <|-- SFR004
sas <|-- SFR005
sas <|-- SFR006
sas <|-- SFR007
sas <|-- SFR008
sas <|-- SFR009
sas <|-- SFR010
sas <|-- SFR011
sas <|-- SFR012
sas <|-- SFR013
sas <|-- SFR014

sys --> AIFR001
sys --> AIFR002
sys --> AIFR003
sys --> AIFR004
sys --> AIFR005
sys --> AIFR006
sys --> AIFR007
@enduml