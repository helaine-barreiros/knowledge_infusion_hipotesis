@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as client1
actor FinancialAdvisor as fa1
actor SysAdmin as sysadmin1
system "System" as system1

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as cfr001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as cfr002
  usecase "CFR003: View Financial Predictions Based on Data and Trends" as cfr003
  usecase "CFR004: Personalized Recommendations Aligned with Goals" as cfr004
  usecase "CFR005: Manage Recommendation Preferences" as cfr005
  usecase "CFR006: View Spending Limit Alerts" as cfr006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as cfr007
  usecase "CFR008: Receive News Related to Portfolio" as cfr008
  usecase "CFR009: Personalized Dashboard for Financial Monitoring" as cfr009
  usecase "CFR10: Manage Relationship with Advisors Including Data Sharing Permissions" as cfr10

  client1 --> cfr001 : View dashboard
  client1 --> cfr002 : Receive alerts on transactions
  client1 --> cfr003 : View financial predictions
  client1 --> cfr004 : Get personalized recommendations
  client1 --> cfr005 : Manage preferences for recommendations
  client1 --> cfr006 : View spending limit alerts
  client1 --> cfr007 : Access investment opportunities
  client1 --> cfr008 : Receive portfolio-related news
  client1 --> cfr009 : Personalized dashboard access
  client1 --> cfr10 : Manage relationship with advisors

}

rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as fafr001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Guidance" as fafr002
  usecase "FAFR003: Review Predictive Analytics to Inform Consultations" as fafr003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as fafr004

  fa1 --> fafr001 : Manage mentoring sessions
  fa1 --> fafr002 : View intervention alerts
  fa1 --> fafr003 : Review predictive analytics
  fa1 --> fafr004 : Configure analysis parameters by segment
}

rectangle "System Administrator Interface" {
  usecase "SAFR001: Manage Analysis Parameters for AI System Compliance" as safr001

  sysadmin1 --> safr001 : Manage system compliance
}

system1 <|-- cfr001 : Delivers insights via client interface
system1 <|-- cfr002 : Sends alerts to clients
system1 <|-- cfr003 : Provides predictions
system1 <|-- cfr004 : Generates recommendations
system1 <|-- cfr005 : Manages preferences for recommendations
system1 <|-- cfr006 : Issues spending limit alerts
system1 <|-- cfr007 : Identifies investment opportunities
system1 <|-- cfr008 : Fetches portfolio-related news
system1 <|-- cfr009 : Generates consolidated dashboards

system1 <|-- fafr001 : Supports advisor mentoring sessions
system1 <|-- fafr002 : Triggers alerts for advisors
system1 <|-- fafr003 : Analyzes client data proactively
system1 <|-- fafr004 : Customizes system parameters

system1 <|-- safr001 : Ensures compliance with regulations
@enduml