@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR002: Deliver Personalized Recommendations Based on Profiles" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  
  Client --> CFR001 : "View Financial Insights Dashboard"
  
  SysAdmin --> SAFR001 : "Manage Analysis Parameters"
  SystemAdmin -> (SFR004) : "Request Personalized Recommendations from AI Component"
  
  usecase "CFR003: View Financial Predictions" as CFR003
  AIFR001 --(SFR003): "Provide Historical Data and Market Trends for Prediction"
  Client --> CFR003 : "View Financial Predictions Based on Historical Data & Current Trends"
  
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  AIFR002 --(SFR005): "Request AI Component for User-Specific Recommendations"
  Client --> CFR004 : "Receive Personalized Financial Strategies and Portfolio Optimizations"
  
  usecase "CFR006: Manage Recommendation Preferences" as CFR006
  Client --> (AIFR002) <|-- (SFR019): "Adjust AI Component Based on KYC Profile Changes"
  
  usecase "SAFR003: Deliver Alerts for Exceeding Spending Limits" as SAFR003
  AIFR004 --(SFR005): "Identify Thresholds and Notify System When Spent"
  Client --> SAFR003 : "View Limit Alerts Based on Predefined Categories"
  
  usecase "CFR012: Generate Personalized Dashboards" as CFR012
  AIFR007 --(SFR009): "Extract News Relevant to User's Portfolio"
  Client --> CFR012 : "Access Consolidated Financial Information in Single View"
  
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  Client --> (AIFR002) <|-- (SFR019): "Adjust AI Component Based on KYC Profile Changes"
  
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  AIFR008 --(SFR005): "Request AI Component to Analyze Client Financial Situations"
  Advisor --> FAFR003 : "View Data-Driven Recommendations During Consultations"
  
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  AIFR006 --(SFR015): "Identify Patterns Requiring Professional Attention"
  Advisor --> FAFR002 : "Proactively Assist Clients with Financial Issues"
  
  usecase "FAFR004: Configure Analysis Parameters" as FAFR004
  SysAdmin --> (AIFR003) <|-- (SFR16): "Set AI Component Behavior for Specific Client Segments"
  
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  AIFR005 --(SFR008): "Detect Unusual Activity in Compliance with AML Rules"
  Client --> SAFR003 : "View Transactional Anomaly Alerts"
  
  usecase "CFR014: Generate Financial Health Reports" as CFR014
  AIFR009 --(SFR020): "Assess Users' Financial Wellbeing Using Standard Metrics"
  Client --> CFR014 : "Review Comprehensive Analysis of Financial Performance"
  
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  AIFR005 --(SFR06): "Identify Investments Matching User's Risk Tolerance and ESG Preferences"
  Client --> CFR007 : "Diversify Portfolio with Suitable Assets"
  
  usecase "CFR013: Generate Alerts Based on Predefined Conditions" as CFR013
  AIFR005 --(SFR08): "Request AI Component to Notify Users of Critical Financial Events"
  Client --> SAFR006 : "View Spending Limit Exceedance Alerts"
  
  usecase "CFR009: Access Consolidated Dashboard" as CFR009
  AIFR007 --(SFR014): "Produce Intuitive and Actionable Financial Information"
  Client --> CFR009 : "Monitor Finances Efficiently in a Single View"
  
  usecase "CFR015: Manage Relationship with Advisors" as CFR015
  SystemAdmin -> (AIFR003) <|-- (SFR21): "Share Data Between Users and Financial Advisors Securely"
}

@enduml