@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  Client --> CFR001 : "View Financial Insights Dashboard"
  SysAdmin --> SAFR001 : "Manage Analysis Parameters"
  
  rectangle "Client Interface" {
    actor User as U
    usercase "CFR002: View Alerts for Anomalous Transactions" as CFR002
    usecase "CFR003: View Financial Predictions" as CFR003
    usecase "CFR004: Receive Personalized Recommendations" as CFR004
    usecase "CFR005: Manage Recommendation Preferences" as CFR005
    usecase "CFR006: Monitor Spending Limit Alerts" as CFR006
    usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
    usecase "CFR008: Access News Related to Portfolio" as CFR008
    usecase "CFR009: Consolidate Financial Information in a Dashboard" as CFR009
    usecase "CFR10: Manage Relationship with Advisors" as CFR10
    
    U --> CFR002 : "View Alerts for Anomalous Transactions"
    U --> CFR003 : "View Financial Predictions"
    U --> CFR004 : "Receive Personalized Recommendations"
    U --> CFR005 : "Manage Recommendation Preferences"
    U --> CFR006 : "Monitor Spending Limit Alerts"
    U --> CFR007 : "View Investment Opportunities Based on Risk Profile"
    U --> CFR008 : "Access News Related to Portfolio"
    U --> CFR009 : "Consolidate Financial Information in a Dashboard"
    U --> CFR10 : "Manage Relationship with Advisors"
  }
  
  rectangle "Financial Advisor Interface" {
    actor FAFR as FA
    usecase "FAFR002: View Client Intervention Alerts" as FAFR002
    usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
    usecase "FAFR004: Configure Analysis Parameters by Segment" as FAFR004
    
    FA --> FAFR002 : "View Client Intervention Alerts"
    FA --> FAFR003 : "View Predictive Analytics for Clients"
    FA --> FAFR004 : "Configure Analysis Parameters by Segment"
  }
  
  rectangle "System Administrator Interface" {
    actor SysAdmin as SA
    usecase "SAFR001: Manage Analysis Parameters" as SAFR001
    
    SA --> SAFR001 : "Manage Analysis Parameters"
  }

}

@enduml