@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  Client --> CFR001 : View Financial Insights Dashboard  
  SysAdmin -> SAFR001 : Manage System-wide Analysis Parameters  
  Advisor --> (CFR002, CFR003) : Receive Alerts and Predictions
  Advisor --> FAFR004 : Configure Segments
  
  Client <|-- (SFR007: Request Investment Opportunities)
  Client <|-- (AIFR005: Generate Investment Opportunities)
  
  SysAdmin -> SAFR001 : Manage System-wide Analysis Parameters  
}

Client as User
Advisor as Financial_Advisor
SysAdmin as System_Administrator

@enduml