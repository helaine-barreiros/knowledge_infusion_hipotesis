@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: Access Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Get Personalized Recommendations Aligned with My Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on My Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to My Investment Portfolio" as CFR008
  usecase "CFR009: Use a Consolidated Personalized Dashboard for Financial Monitoring" as CFR009
  usecase "CFR010: Manage Relationship with Financial Advisors Including Data Sharing Permissions" as CFR010

  // System Administrator Use Cases
  usecase "SAFR001: Manage Analysis Parameters to Ensure Accuracy and Compliance" as SAFR001
  
  // Financial Advisor Use Cases
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: Review Predictive Analytics About Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Specific Client Segments" as FAFR004

  // System Functionalities (SFR)
  usecase "SFR001: Deliver Alerts Through Appropriate Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Financial Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts When Exceeding Thresholds" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis Based on Risk Profile" as SFR006
  usecase "SFR007: Find Specific Investment Opportunities Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts for Fraud Detection" as SFR008
  usecase "SFR009: Extract Contextualized News Relevant to Portfolio from Financial Sources" as SFR009
  usecase "SFR010: Process Contextualized News Insights" as SFR010
  usecase "SFR011: Request AI-Generated Client Dashboards" as SFR011
  usecase "SFR012: Generate Client Alerts Based on Predefined Conditions" as SFR012
  usecase "SFR013: Provide Client Analytics for Financial Behavior and Performance" as SFR013
  usecase "SFR014: Request Predictive Intervention Analyses From AI Component" as SFR014
  usecase "SFR015: Enhance Value of Financial Guidance via Predictive Insights" as SFR015
  usecase "SFR016: Generate Financial Health Reports Based on Standard Metrics" as SFR016
  usecase "SFR017: Track Users' Financial Goals and Progress" as SFR017
  usecase "SFR018: Maintain Historical Record of Insights for Trend Analysis" as SFR018
  usecase "SFR019: Manage User Feedback to Improve System Quality" as SFR019

  // AI Functionalities (AIFR)
  usecase "AIFR001: Generate Financial Predictions by Analyzing Historical Data and Market Trends" as AIFR001
  usecase "AIFR002: Create Personalized Recommendations Based on User Profiles, Goals, Risk Tolerance" as AIFR002
  usecase "AIFR003: Identify Spending Limit Alerts for Unusual Deviations in Spending Patterns" as AIFR003
  usecase "AIFR004: Evaluate Investment Opportunities Against User's Risk Profiles and Financial Goals" as AIFR004
  usecase "AIFR005: Select Financial Instruments Aligning with Investment Strategies and Portfolio Theory" as AIFR005
  usecase "AIFR006: Detect Anomalous Transactions Using Pattern Recognition for Fraud Prevention" as AIFR006
  usecase "AIFR007: Correlate News With User Portfolios to Identify Relevant Financial Impacts" as AIFR007
  usecase "AIFR008: Recommend Proactive Actions Based on Predictive Analysis of Client Data" as AIFR008
  usecase "AIFR009: Offer Forward-Looking Analysis for Effective Financial Planning" as AIFR009

  // Actors (Users, Advisors, System Admin)
  actor "Client" as Client
  actor "Financial Advisor" as FAdvisor
  actor "System Administrator" as SysAdmin
  
  Client --> CFR001 : View Financial Insights Dashboard
  Client --> CFR002 : Receive Alerts on Anomalous Transactions
  Client --> CFR003 : Access Predictive Analytics Based on Historical Data and Market Trends
  Client --> CFR004 : Get Personalized Recommendations Aligned with My Profile
  Client --> CFR005 : Manage Preferences for Recs
  Client --> CFR006 : View Spending Limit Alerts When Exceeding Thresholds
  Client --> CFR007 : Access Investment Opportunities Based on Risk Profile
  Client --> CFR008 : Receive News Related to Portfolio
  Client --> CFR009 : Use Consolidated Dashboard for Monitoring
  Client --> CFR010 : Manage Relationship with Advisors, Including Data Sharing

  SysAdmin --> SAFR001 : Manage Analysis Parameters for AI System Compliance
  
  FAdvisor --> FAFR001 : Manage Mentoring Sessions Based on Insights
  FAdvisor --> FAFR002 : View Client Intervention Alerts
  FAdvisor --> FAFR003 : Review Predictive Analytics About Clients' Situations
  FAdvisor --> FAFR004 : Configure Analysis Parameters by Segments

  // System Functionalities (SFR)
  SysAdmin --> SFR019 : Manage User Feedback for Improvements
  Client --> SFR002 : Get Personalized Recommendations
  Client --> SFR003 : Request Financial Predictions from AI Component
  Client --> SFR004 : Request Recs From AI Component Based on Profile
  SysAdmin --> SFR016 : Enhance Value of Guidance via Insights

  // AI Functionalities (AIFR)
  AIFR002 <|-- SAFR001 : Generate Personalized Recs for Admin to Configure
  Client --> AIFR003 : Get Spending Limit Alerts
  FAdvisor --> AIFR008 : Receive Proactive Recommendations Based on Predictive Analysis

  // Feedback Loop (CFR011)
  client --|> CFR011 : Send Feedback to Improve System Outputs
}

@enduml