@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Data Sources Integration" as SAFR002
  
  Client --> CFR001 : "View Financial Insights"
  
  SysAdmin -> (System) : "Manage System Parameters"
}

rectangle "Client" {
  actor "User" as User
  user "CFR003: View Historical Transactions" as CFR003
  user "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Preferences" as CFR005
  
  User --> (User) : "View Alerts"
  
  SysAdmin -> (System) : "Manage System Parameters"
}

rectangle "Financial Advisor" {
  actor "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  user "SAFR003: Configure Analysis Parameters for Segments" as SAFR003
  
  SysAdmin -> (System) : "Manage System Parameters"
}

rectangle "System Administrator" {
  actor "SysAdmin" as SysAdmin
  usecase "CFR011: Send Feedback" as CFR011
  usecase "SAFR004: Configure Analysis for Compliance" as SAFR004
  
  SysAdmin -> (User) : "Manage User Permissions"
}

rectangle "AI Component" {
  actor "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "SAFR005: Request Spending Limit Alerts" as SAFR005
  
  SysAdmin -> (System) : "Manage System Parameters"
}

rectangle "News Component" {
  actor "AIFR007: Generate Contextualized News Insights" as AIFR007
  usecase "SFR013: Request Client Alerts" as SFR013
  
  SysAdmin -> (System) : "Manage System Parameters"
}

@enduml