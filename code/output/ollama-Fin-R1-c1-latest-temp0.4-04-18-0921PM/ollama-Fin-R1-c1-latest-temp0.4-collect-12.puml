@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics about Client's Finances" as FAFR003
  usecase "SFR012: Generate Client Dashboards" as SFR012

  client --> CFR001 : "Client wants to view financial data in a consolidated format."
  
  SysAdmin -> SAFR001 : "System Administrator manages analysis parameters for AI system."

  FAFR003 <|-- (CFR001) : "Financial Advisor or Client can access predictive analytics through the dashboard."
  
  SFR012 <|-- CFR001 : "System generates dashboards based on user requests."
}

rectangle "Client" {
  actor "User" as U
  usecase "CFR002: View Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Manage Relationship with Advisors" as CFR009

  U --> CFR001 : "User requests financial insights dashboard."
  
  SysAdmin -> SAFR001 : "System Administrator updates analysis parameters."

  FAFR003 <|-- (CFR002, CFR004) : "Financial Advisor or Client can view predictive analytics and recommendations through the system."
}

rectangle "Advisor" {
  actor "FAFR001: Financial Advisor" as FA
  usecase "FAFR001: Manage Mentorship Sessions Based on System Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002

  U --> FAFR003 : "Financial Advisor uses predictive analytics to guide clients."
  
  FA -> FAFR001 : "Advisors manage client interactions using system-generated insights."

}

rectangle "System Components" {
  usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002

  SysAdmin -> SAFR001 : "System Administrator configures analysis parameters."

  U --> CFR003, CFR005, CFR006, CFR007, CFR008, CFR009: "User requests specific services."
  
  AIFR002 <|-- SFR004 : "AI system provides recommendations to the system for delivery."

}

@enduml