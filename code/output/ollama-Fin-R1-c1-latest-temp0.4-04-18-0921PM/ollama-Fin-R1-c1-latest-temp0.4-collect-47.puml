@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "SFR014: Generate Client Analytics" as SFR014
  usecase "AIFR007: Generate Contextualized News Insights for Users" as AIFR007

  actor "Client" as C
  actor "Financial Advisor (FA)" as FADV
  actor "System Administrator (SA)" as SAADM
  
  Client --> CFR001 : View Financial Health Dashboard
  Client --> SAFR001 : Manage Analysis Parameters  
  Client --> AIFR002 : Receive Personalized Recommendations  
  Client --> SFR014 : Generate Analytics for Monitoring  
  Client --> FAFR003 : Review Predictive Insights  

  SAADM --> CFR005: Configure Recommendation Preferences
  SAADM --> SAFR001: Set Analysis Parameters

  FA --> AIFR008: Request Intervention Recommendations 
  FA --> SFR014: Generate Client Analytics  
  FA --> FAFR003: Review Predictive Insights  

  C <|-- (CFR002) : Receive Alerts
  C <|-- (SFR013) : Manage Notifications

}

@enduml