@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Security Settings" as SAFR002
  usecase "FAFR005: Schedule Mentoring Sessions" as FAFR005

  Client --> CFR001 : "View"
  
  SysAdmin --> SAFR002 : "Manage System Parameters"

  FinancialAdvisor --> FAFR005 : "Schedule"

}

rectangle "AI Component" {
  usecase "AIFR001: Generate Predictions" as AIFR001
  usecase "AIFR003: Send Spending Alerts" as AIFR003

  Client --> AIFR001 : "Request"
  
}

rectangle "Contextual News Component" {
  usecase "SFR019: Generate Financial Health Reports" as SFR019
  usecase "AIFR007: Provide Contextualized News Insights" as AIFR007

  Client --> SFR019 : "Request"
  
}

rectangle "User Feedback Management Component" {
  usecase "CFR011: Send User Feedback" as CFR011
}
@enduml