  usecase "SFR009: Extract Contextualized News for Users' Portfolios" as SFR009
  usecase "SFR010: Generate Client Dashboards Intuitively" as SFR010
  usecase "SFR011: Notify Clients of Predefined Conditions via Alerts" as SFR011
  usecase "SFR012: Analyze Financial Health Using Standard Metrics" as SFR012
  usecase "SFR013: Track User Progress Towards Financial Goals" as SFR013
  usecase "SFR014: Maintain Historical Record of Insights for Trend Analysis" as SFR014
  usecase "SFR015: Request AI Predictive Intervention Analyses for Advisors" as SFR015
}

rectangle "AI System (AIFR)" {
