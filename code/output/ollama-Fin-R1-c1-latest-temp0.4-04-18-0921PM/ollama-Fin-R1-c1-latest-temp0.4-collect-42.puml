  usecase "AIFR005: Identify Financial Instruments Aligning with Modern Portfolio Theory" as AIFR005
  usecase "AIFR006: Flag Potential Fraudulent Transactions Using Pattern Recognition" as AIFR006
  usecase "AIFR007: Correlate News to User Portfolios for Relevant Insights" as AIFR007
  usecase "AIFR008: Recommend Intervention When Patterns Indicate Financial Distress or Opportunity" as AIFR008
}

