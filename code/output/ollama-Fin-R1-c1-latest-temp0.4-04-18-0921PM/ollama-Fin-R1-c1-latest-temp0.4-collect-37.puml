@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sa
actor FinancialAdvisor as fa
system "System" as sys

package Professional {
  rectangle "Professional Actors" {
    client --> CFR001 : View financial insights dashboard  
    client --> CFR002 : Receive alerts for anomalous transactions  
    client --> CFR003 : View financial predictions based on data and trends  
    client --> CFR004 : Get personalized recommendations aligned with profile  
    client --> CFR005 : Manage preferences for recommendations  
    client --> CFR006 : View spending limit alerts when exceeding thresholds  
    client --> CFR007 : Access investment opportunities suitable to risk profile  
    client --> CFR008 : Receive news related to portfolio  
    client --> CFR009 : Use a consolidated financial information dashboard  
    client --> CFR10: Manage relationship with Financial Advisors  

  }
}

package SystemAdmin {
  rectangle "System Admin Actors" { 
    sysadmin --> SAFR001 : Manage analysis parameters for AI system
  }  
} 

package Advisor {
  rectangle "Financial Advisor Actors" {
    fa --> FAFR001: Manage client mentoring sessions based on insights  
    fa --> FAFR002: View client intervention alerts when patterns detected  
    fa --> FAFR003: View predictive analytics about clients' financial situations  
    fa --> FAFR004: Configure analysis parameters for specific segments
  }
}

package System {
  rectangle "System Components" { 
    sys --> SFR001 : Deliver alerts to users through appropriate channels  
    sys --> SFR002 : Provide personalized recommendations based on profiles  
    sys --> SFR003 : Request financial predictions from AI component  
    sys --> SFR004: Request personalized recommendations from AI component  
    sys --> SFR005: Request spending limit alerts when thresholds exceeded  
    sys --> SFR006: Request investment opportunity analysis for users  
    sys --> SFR007: Find specific investments matching user criteria and ESG preferences  
    sys --> SFR008: Detect anomaly transactions in compliance with AML regulations  
    sys --> SFR009: Extract contextualized news relevant to portfolio from sources  
    sys --> SFR010: Generate client dashboards for financial information  
    sys --> SFR013: Manage user feedback to improve system
  }
}

package AI {
  rectangle "AI Components" { 
    ai --> AIFR001 : Generate financial predictions using data and trends  
    ai --> AIFR002 : Create personalized recommendations based on profiles  
    ai --> AIFR003: Issue spending limit alerts for unusual deviations  
    ai --> AIFR004: Identify investment opportunities aligned with risk profile  
    ai --> AIFR005: Select financial instruments that match strategies and MPT principles  
    ai --> AIFR006: Recognize potential fraud through pattern recognition in transactions  
    ai --> AIFR007: Correlate news to portfolio for relevant insights  
    ai --> AIFR008: Recommend actions based on predictive analysis of client needs
  }
}

package Feedback {
  rectangle "User Feedback" { 
    user --> CFR11 : Send feedback about system outputs and recommendations
  }  
}  

