@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client as Client
:System as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Personalized Recommendations Based on Profile" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Receive Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities Aligned to Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidated Personalized Dashboard" as CFR009
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010

  SysAdmin --> SAFR001 : Configure system parameters for compliance and accuracy.

  Client --> CFR001, CFR002, CFR003, CFR004, CFR005, CFR006, CFR007, CFR008, CFR009, CFR010
}

rectangle "System Admin" {
  SysAdmin as SysAdmin

  SysAdmin --> SAFR001 : Manage system settings and parameters.
}
  
rectangle "Financial Advisor (FAFR)" {
  FAFR001: View Client Mentoring Sessions Based on Insights
  FAFR002: View Intervention Alerts for Clients
  FAFR003: View Predictive Analytics about Clients' Financial Situations
  FAFR004: Configure Analysis Parameters for Specific Segments

  Sys --> (FAFR001, FAFR002, FAFR003) : Deliver insights and alerts to advisors.
}

rectangle "System Components" {
  usecase "SFR001: Send Alerts Through Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Based on ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts for AML Compliance" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Portfolio" as SFR009
  usecase "SFR010: Generate Client Dashboards" as SFR010
  usecase "SFR011: Extract News Insights for Users" as SFR011
  usecase "SFR012: Process Contextualized News" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics for Financial Behavior and Performance" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI" as SFR015
  usecase "SFR016: Enhance Value of Financial Guidance via Predictive Insights" as SFR016
  usecase "SFR017: Generate Financial Health Reports Based on Standard Metrics" as SFR017
  usecase "SFR018: Manage Users' Financial Goals for Progress Tracking" as SFR018
  usecase "SFR019: Maintain Historical Record of Insights for Trend Analysis" as SFR019
  usecase "SFR020: Process User Feedback to Improve System Quality" as SFR020

  Sys --> (SFR001, SFR002, ..., SFR020) : Execute system functionalities.
}

rectangle "AI Components" {
  AIFR001: Generate Financial Predictions
  AIFR002: Generate Personalized Recommendations Based on Profile and Risk Tolerance
  AIFR003: Generate Spending Limit Alerts for Unusual Patterns
  AIFR004: Analyze Investment Opportunities Against Risk Profiles
  AIFR005: Identify Financial Instruments Aligning with Investment Strategies (MPT)
  AIFR006: Detect Anomalies in Transactions Per FinCEN Rules
  AIFR007: Correlate News to User Portfolios for Relevance
  AIFR008: Recommend Interventions Based on Financial Patterns
  AIFR009: Provide Forward-Looking Analysis of Financial Situations

  Sys --> (AIFR001, ..., AIFR009) : Request AI-generated outputs.
}

SysAdmin <|-- SAFR001 : System Admin can configure analysis parameters.

Client --> CFR002 : Receive alerts about anomalous transactions.

CFR004 --(User Preferences): Manage personalized recommendations based on profile and goals.

SFR003 --(AI) : Request financial predictions from AI.

SFR005 --(AI) : Request spending limit alerts when thresholds are exceeded by user.

SFR018 --> User: Track progress towards personal finance goals.

CFR010 --> SysAdmin: Manage sharing of data with advisors, ensuring privacy and control.
  
@enduml