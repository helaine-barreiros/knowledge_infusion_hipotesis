@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts Exceeding Predefined Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Portfolio" as CFR008
  usecase "CFR009: View Consolidated Financial Information in a Single Dashboard" as CFR010
  usecase "CFR010: Manage Relationship with Financial Advisors, Including Data Sharing Permissions" as SAFR002

  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Specific Client Segments" as FAFR004

  usecase "SFR001: Deliver Alerts Through Notification Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Financial Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as AIFR001
  usecase "SFR004: Request Personalized Recommendations From AI Component" as AIFR002
  usecase "SFR005: Request Spending Limit Alerts Based on User Activity" as AIFR003
  usecase "SFR006: Identify Investment Opportunities for Users by Risk Profile" as AIFR004
  usecase "SFR007: Find Specific Investment Opportunities Matching User Criteria and ESG Preferences" as AIFR005
  usecase "SFR008: Detect Anomalous Transactions in Compliance with Regulations" as AIFR006
  usecase "SFR009: Extract Relevant News for Users' Portfolios from Financial Sources" as AIFR007
  usecase "SFR010: Generate Client Dashboards Intuitively" as SFR012
  usecase "SFR011: Process Contextualized News to Inform User Decisions" as AIFR008
  usecase "SFR013: Provide Financial Health Reports Based on Ratios and Metrics" as AIFR009
  usecase "SFR014: Track Users' Progress Towards Financial Goals" as SFR015
  usecase "SFR016: Maintain Historical Record of Insights for Trend Analysis" as SFR017
  usecase "SFR018: Manage User Feedback to Improve System Quality" as AIFR020

  usecase "AIFR001: Generate Financial Predictions Based on Data and Trends" as AIFR001
  usecase "AIFR002: Create Personalized Recommendations for Users" as AIFR002
  usecase "AIFR003: Issue Spending Limit Alerts When Exceeding Thresholds" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities Against Risk Profiles and Goals" as AIFR004

  actor Client as c1
  actor SystemAdmin as sa2
  actor FinancialAdvisor as faa3

  Client --> CFR001 : View dashboard (CFR001)
  Client --> CFR006 : Exceed spending limits (CFR006)
  Client --> CFR007 : Access investment opportunities (CFR007)
  Client --> CFR008 : Receive portfolio news (CFR008)
  Client --> SAFR002 : Manage relationship with advisors, share data (SAFR010)

  SystemAdmin --> SAFR001 : Configure analysis parameters (SAFR001)
  
  FinancialAdvisor --> FAFR001: Mentor clients using insights
  FinancialAdvisor --> FAFR002: View client alerts for proactive help
  FinancialAdvisor --> FAFR003: Analyze predictive analytics on clients

  System --> SFR001 : Send system-generated alerts (SFR001)
  System --> SFR002 : Provide personalized recommendations via AI (AIFR002)
  System --> AIFR001 : Request financial predictions from AI
  System --> AIFR003: Generate spending limit alerts for users

  Client <|-- CFR005: Manage preferences (CFR005)

  FinancialAdvisor <|-- FAFR004: Configure analysis parameters by segment (FAFR004)
  
  SFR012 <|-- AIFR009: Generate client dashboards
}

@enduml