@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as client
actor SysAdmin as sysadmin
actor FinancialAdvisor as financialadvisor
system "System" as system
package Professional {
  actor Chef as chef
}
rectangle "System Boundary" {
  
  usecase "CFR001: View Financial Insights Dashboard" as cfr001
  usecase "SAFR001: Manage Analysis Parameters" as safr001
  
  client --> cfr001 : "View financial data"
  sysadmin --> safr001 : "Manage parameters"

}

package Client {
  actor UserClient as userclient

  usecase "CFR002: View Alerts for Anomalous Transactions" as cfr002
  usecase "CFR003: View Financial Predictions" as cfr003
  usecase "CFR004: Receive Personalized Recommendations" as cfr004
  usecase "CFR005: Manage Recommendation Preferences" as cfr005
  usecase "CFR006: View Spending Limit Alerts" as cfr006
  usecase "CFR007: View Investment Opportunities" as cfr007
  usecase "CFR008: Access News Related to Portfolio" as cfr008
  usecase "CFR009: Manage Personalized Dashboard" as cfr009
  usecase "CFR10: Manage Relationship with Financial Advisors" as cfr10

}

package Professional {
  
  actor SysAdmin as sysadmin
  
  usecase "SAFR002: Intervene in Client Sessions Based on System Insights" as safr002
  usecase "FAFR003: View Predictive Analytics for Clients" as fafra003

}

package FinancialAdvisor {
  
  actor financialadvisor

  usecase "FAFR001: Manage Client Mentoring Sessions" as fafa001
  usecase "FAFR002: View Intervention Alerts" as fafa002
  usecase "FAFR004: Configure Analysis Parameters for Segments" as fafa004

}

system --> cfr001 : "Deliver financial insights"
system --> safr001 : "Manage analysis parameters"

client <|-- userclient

client --> cfr002
client --> cfr003
client --> cfr004
client --> cfr005
client --> cfr006
client --> cfr007
client --> cfr008
client --> cfr009
client --> cfr10

sysadmin <|-- safr002 : "Intervene in client sessions"
sysadmin <|-- safra003 : "View predictive analytics"

financialadvisor <|-- fafa001 : "Manage mentoring"
financialadvisor <|-- fafa002 : "View alerts"
financialadvisor <|-- fafa004 : "Configure parameters"

@enduml