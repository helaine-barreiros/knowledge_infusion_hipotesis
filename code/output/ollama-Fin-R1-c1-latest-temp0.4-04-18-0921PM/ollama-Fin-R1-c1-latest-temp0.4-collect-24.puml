@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor FinancialAdvisor as fa1
actor SysAdmin as sa1
system "System" as sys

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Personalized Recommendations Based on Profile" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Spending Limit Alerts for Budget Control" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access Portfolio-Related News" as CFR008
  usecase "CFR009: Personalized Dashboard for Financial Monitoring" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10

  Client -> (CFR001) : c1.viewDashboard()
  Client -> (CFR002) : c1.receiveAlerts()
  Client -> (CFR003) : c1.viewPredictions()
  Client -> (CFR004) : c1.getRecommendations()
  Client -> (CFR005) : c1.managePreferences()
  Client -> (CFR006) : c1.receiveSpendingAlerts()
  Client -> (CFR007) : c1.viewInvestmentOpportunities()
  Client -> (CFR008) : c1.accessNews()
  Client -> (CFR009) : c1.useDashboard()
  Client -> (CFR10) : c1.manageAdvisors()

}

rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Clients" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004

  FinancialAdvisor -> (FAFR001) : fa1.manageMentoring()
  FinancialAdvisor -> (FAFR002) : fa1.viewInterventionAlerts()
  FinancialAdvisor -> (FAFR003) : fa1.viewAnalytics()
  FinancialAdvisor -> (FAFR004) : fa1.configureParams()

}

rectangle "System Administrator Interface" {
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001

  SysAdmin -> (SAFR001) : sa1.manageParameters()
}

system sys {

  include ClientInterface
  include FinancialAdvisorInterface
  include SystemAdministratorInterface
  
  // Relationships between system components and use cases
  sys --> CFR001: implements
  sys --> CFR002: implements
  sys --> CFR003: implements
  sys --> CFR004: implements
  sys --> CFR005: implements
  sys --> CFR006: implements
  sys --> CFR007: implements
  sys --> CFR008: implements
  sys --> CFR009: implements
  sys --> CFR10: implements

  sys --> FAFR001: implements
  sys --> FAFR002: implements
  sys --> FAFR003: implements
  sys --> FAFR004: implements

  sys --> SAFR001: implements
  
}

@enduml