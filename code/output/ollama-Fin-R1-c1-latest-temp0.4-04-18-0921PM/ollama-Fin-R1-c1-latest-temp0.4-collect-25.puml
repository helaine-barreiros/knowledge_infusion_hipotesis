@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as client
actor SysAdmin as sysadmin
actor FinancialAdvisor as advisor
actor AIFR001:AISystem as ai
system :System

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as cfr001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as cfr002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Trends" as cfr003
  usecase "CFR004: Personalized Recommendations Aligned with Financial Goals" as cfr004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as cfr005
  usecase "CFR006: View Spending Limit Alerts Based on Predefined Thresholds" as cfr006
  usecase "CFR007: Access Investment Opportunities Suitable to Risk Profile" as cfr007
  usecase "CFR008: Receive News Related to Portfolio" as cfr008
  usecase "CFR009: View Consolidated Financial Dashboard" as cfr009
  usecase "CFR10: Manage Relationship with Advisors, Including Data Sharing Permissions" as cfr10

  client --> cfr001 : Request financial insights dashboard
  client --> cfr002 : Receive alerts for anomalous transactions
  client --> cfr003 : View predictions based on data and trends
  client --> cfr004 : Get personalized recommendations aligned with goals
  client --> cfr005 : Manage recommendation preferences
  client --> cfr006 : View spending limit alerts
  client --> cfr007 : Access investment opportunities suitable to risk profile
  client --> cfr008 : Receive portfolio-related news
  client --> cfr009 : Consolidate financial info in a single view
  client --> cfr10 : Manage relationship with advisors

}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters for AI System" as safr001
  
  sysadmin --> safr001 : Configure parameters to ensure accuracy and compliance
}
  
rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as fafr001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as fafr002
  usecase "FAFR003: Review Predictive Analytics About Clients' Financial Situations" as fafr003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as fafr004

  advisor --> fafr001 : Schedule mentoring sessions using insights
  advisor --> fafr002 : Review intervention alerts for proactive client support
  advisor --> fafr003 : Analyze predictive analytics during consultations
  advisor --> fafr004 : Customize analysis parameters by segment

}

rectangle "System" {
  usecase "SFR001: Deliver Alerts Through Notification Channels" as sfr001
  usecase "SFR002: Provide Personalized Recommendations Based on Profiles" as sfr002
  usecase "SFR003: Request Financial Predictions from AI Component" as sfr003
  usecase "SFR004: Request Personalized Recommendations From AI Component" as sfr004
  usecase "SFR005: Request Spending Limit Alerts Based on Thresholds" as sfr005
  usecase "SFR006: Request Investment Opportunity Analysis for Users" as sfr006
  usecase "SFR007: Find Specific Investment Opportunities Matching Criteria and ESG Preferences" as sfr007
  usecase "SFR008: Detect Anomalous Transactions in Compliance with AML Regulations" as sfr008
  usecase "SFR009: Extract Relevant News for Users' Portfolios" as sfr009
  usecase "SFR010: Process Contextualized News to Identify Portfolio Impacts" as sfr010
  usecase "SFR011: Generate Client Dashboards in Intuitive Formats" as sfr12
  usecase "SFR013: Issue Predefined Alerts Based on Conditions" as sfr13
  usecase "SFR014: Provide Financial Analytics for Users' Insights" as sfr14
  usecase "SFR015: Request Predictive Intervention Analyses From AI Component" as sfr15
  usecase "SFR016: Enhance Client Guidance Through Data-Driven Recommendations" as sfr16
  usecase "SFR017: Assess Users' Financial Health Using Standard Metrics" as sfr17
  usecase "SFR018: Track Progress Towards Financial Goals" as sfr18
  usecase "SFR019: Maintain Historical Record of Insights for Trend Analysis" as sfr19
  usecase "SFR020: Manage User Feedback to Improve System Quality and Relevance" as sfr20

}

rectangle "AI System (AIFR)" {
  usecase "AIFR001: Generate Financial Predictions Based on Historical Data, Market Trends, Economic Indicators" as aifr001
  usecase "AIFR002: Provide Personalized Recommendations Aligned with User Profiles and Risk Tolerance" as aifr002
  usecase "AIFR003: Identify Spending Limit Alerts Based on Unusual Patterns in Data" as aifr003
  usecase "AIFR004: Evaluate Investment Opportunities Against User's Risk Profile, Time Horizons and Financial Goals" as aifr004
  usecase "AIFR005: Discover Investment Instruments That Align With Client’s Strategies and Modern Portfolio Theory Principles" as aifr005
  usecase "AIFR006: Detect Anomalous Transactions Using Pattern Recognition in Compliance with FinCEN Rules" as aifr006
  usecase "AIFR007: Correlate Financial News With User Portfolios to Identify Relevant Impacts" as aifr007
  usecase "AIFR008: Recommend Proactive Actions Based on Predicted Client Needs or Opportunities for Advisors" as aifr008
  usecase "AIFR009: Offer Forward-Looking Analysis of Financial Situations to Support Effective Planning" as aifr009

}

client --> sfr12 : View consolidated financial dashboard (SFR012)
advisor --> fafr004 <|-- safr001 : Extends parameter configuration
sysadmin --> safr001 : Configures parameters for compliance and accuracy (SAFR001)

@enduml