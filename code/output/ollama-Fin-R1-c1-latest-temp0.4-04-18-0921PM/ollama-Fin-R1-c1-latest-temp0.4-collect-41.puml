@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor FinancialAdvisor as fa
actor SysAdmin as sa
system :System: as sys

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Receive Relevant News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidated Personalized Dashboard for Financial Monitoring" as CFR009
  usecase "CFR10: Manage Relationship with Advisors, Including Data Sharing Permissions" as CFR10

  c1 --> CFR001 : View dashboard
  c1 --> CFR002 : Receive alerts on transactions
  c1 --> CFR003 : View predictions based on data and trends
  c1 --> CFR004 : Get personalized recommendations
  c1 --> CFR005 : Manage recommendation preferences
  c1 --> CFR006 : View spending limit alerts
  c1 --> CFR007 : Access investment opportunities
  c1 --> CFR008 : Receive portfolio-related news
  c1 --> CFR009 : Consolidated dashboard access
  c1 --> CFR10 : Manage advisor relationships

}

rectangle "FinancialAdvisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004

  fa --> FAFR001 : Manage mentoring sessions
  fa --> FAFR002 : View intervention alerts for clients
  fa --> FAFR003 : Review predictive analytics on client data
  fa --> FAFR004 : Customize analysis parameters per segment

}

rectangle "SysAdmin" {
  usecase "SAFR001: Manage Analysis Parameters to Ensure Algorithm Accuracy and Compliance" as SAFR001

  sa --> SAFR001 : Manage system settings for accuracy, compliance
}

system <|-- CFR001 : Delivers financial insights via client dashboard (SFR012)
system <|-- CFR002 : Sends alerts through appropriate channels (SFR013)
system <|-- CFR004 : Generates personalized recommendations based on user data and preferences (AIFR002, SFR004)
system <|-- CFR005 : Manages client preference settings for recommendations (AIFR002)
system <|-- CFR006 : Triggers spending limit alerts when thresholds are exceeded (SFR013)
system <|-- CFR007 : Recommends investment opportunities aligned with risk profiles (AIFR004, SFR008)
system <|-- CFR008 : Provides relevant news to clients (SFR009)
system <|-- CFR009 : Consolidates financial data into a single view for easy monitoring (SFR012)
system <|-- CFR10 : Manages client-advisor relationships, including sharing permissions (AIFR005)

system --> FAFR003 : Delivers predictive analytics to advisors
system --> SAFR001 : Ensures compliance and accuracy of analysis parameters

@enduml