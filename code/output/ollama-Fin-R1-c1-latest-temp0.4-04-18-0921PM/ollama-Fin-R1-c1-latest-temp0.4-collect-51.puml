@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sA
actor FinancialAdvisor as fA
system "System" as sys

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access Portfolio News" as CFR008
  usecase "CFR009: Consolidated Financial Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10

  c1 --> CFR001 : View financial insights.
  c1 --> CFR002 : Receive transaction alerts.
  c1 --> CFR003 : Get predictions.
  c1 --> CFR004 : Personalized recs based on profile.
  c1 --> CFR005 : Adjust recommendation preferences.
  c1 --> CFR006 : Alerts for spending limits exceeded.
  c1 --> CFR007 : View investment opportunities.
  c1 --> CFR008 : Access portfolio news.
  c1 --> CFR009 : Consolidated dashboard view.
  c1 --> CFR10 : Manage advisor relationships.

}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001

  sA --> SAFR001 : Configure system parameters for accuracy and compliance.
}

rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004

  fA --> FAFR001 : Schedule and manage mentoring.
  fA --> FAFR002 : Review alerts for proactive client support.
  fA --> FAFR003 : Analyze clients' financial situations with data-driven insights.
  fA --> FAFR004 : Customize system settings per client segment.

}

rectangle "System" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "SFR004: Request Personalized Recs from AI" as SFR004
  usecase "SFR005: Spending Limit Alerts" as SFR005
  usecase "SFR006: Investment Opportunity Analysis" as SFR006
  usecase "SFR007: Specific Investment Opportunities Based on Criteria" as SFR007
  usecase "SFR008: Anomaly Transaction Alerts" as SFR008
  usecase "SFR009: Contextualized News for Portfolios" as SFR009
  usecase "SFR010: Client Dashboards Generation" as SFR010
  usecase "SFR011: Process Contextualized News Insights" as SFR011
  usecase "SFR012: Generate Financial Health Reports" as SFR012
  usecase "SFR013: Manage User Feedback for Improvements" as SFR013

  sys --> CFR001 : Provide financial insights.
  sys --> CFR002 : Trigger transaction alerts.
  sys --> CFR003 : Offer predictions.
  sys --> CFR004 : Deliver personalized recs.
  sys --> CFR005 : Handle preference management.
  sys --> CFR006 : Alert for spending limits.
  sys --> CFR007 : Present investment opportunities.
  sys --> CFR008 : Share portfolio news.
  sys --> CFR009 : Consolidate dashboard info.
  sys --> CFR10 : Manage advisor interactions.

}

rectangle "AI System" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Personalized Recommendations Based on Profile" as AIFR002
  usecase "AIFR003: Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Align Recommendations with MPT Principles" as AIFR005
  usecase "AIFR006: Anomaly Transaction Detection" as AIFR006
  usecase "AIFR007: Contextualized News Insights" as AIFR007
  usecase "AIFR008: Predictive Intervention Recs for Advisors" as AIFR008
  usecase "AIFR009: Client-Specific Predictive Analysis" as AIFR009

  sys --> AIFR001 : Provide future financial insights.
  sys --> AIFR002 : Offer personalized advice based on user data.
  sys --> AIFR003 : Warn of excessive spending patterns.
  sys --> AIFR004 : Suggest investments matching risk profiles.
  sys --> AIFR005 : Ensure recommendations align with portfolio theory.
  sys --> AIFR006 : Detect suspicious transactions for compliance.
  sys --> AIFR007 : Correlate news to user portfolios.
  sys --> AIFR008 : Recommend actions when advisors should engage clients.
  sys --> AIFR009 : Forecast financial outcomes based on client data.

}

@enduml