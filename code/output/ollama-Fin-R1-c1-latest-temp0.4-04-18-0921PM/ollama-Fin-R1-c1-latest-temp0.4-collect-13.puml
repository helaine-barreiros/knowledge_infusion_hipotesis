@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  usecase "AIFR009: Generate Client Predictive Intervention Recommendations" as AIFR009

  client --> CFR001 : "View Financial Insights Dashboard"
  
  SysAdmin -> SAFR001 : "Manage Analysis Parameters"

  FAFR003 <|-- (CFR002) : "Client Intervention Alerts"
  SFR002 <|-- AIFR004 : "Generate Investment Opportunity Analyses"
  AIFR009 <|-- SysAdmin : "Identify Patterns for Advisor Engagement"
}

actor client as Client
actor sysadmin as SystemAdministrator

@enduml