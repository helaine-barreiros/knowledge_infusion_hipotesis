@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Personalized Recommendations Alignment" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Spending Limit Alerts Management" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access Portfolio-Related News" as CFR008
  usecase "CFR009: Consolidated Financial Dashboard Management" as CFR010
  usecase "CFR011: Send Feedback to Improve System Outputs" as CFR011

  Client --> CFR001 : View financial data in a comprehensive format.
  Client --> CFR002 : Receive alerts about anomalous transactions for fraud detection.
  Client --> CFR003 : Get financial predictions based on historical and market trends.
  Client --> CFR004 : Align recommendations with personal goals and risk tolerance.
  Client --> CFR005 : Adjust preferences in personalized recommendations system.
  Client --> CFR006 : Monitor spending limits via alerts for budget control.
  Client --> CFR007 : Explore investment opportunities matching your profile.
  Client --> CFR008 : Stay informed about market news affecting investments.
  Client --> CFR010 : Manage a single view of all financial information.
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Schedule Mentorship Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Clients" as FAFR002
  usecase "FAFR003: Review Predictive Analytics of Client Situations" as FAFR003

  FinancialAdvisor --> FAFR001 : Schedule sessions using system-generated insights.
  FinancialAdvisor --> FAFR002 : Act on client alerts detected by the system.
}

rectangle "System Administrator (SysAdmin)" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  SysAdmin --> SAFR001 : Configure and adjust parameters for AI accuracy.

  SysAdmin --> SFAF004 : Set analysis parameters specific to client segments.
}

rectangle "System (S)" {
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "SFR004: Request Personalized Recommendations" as SFR004
  usecase "SFR005: Send Spending Limit Alerts" as SFR005
  usecase "SFR006: Find Investment Opportunities Based on Risk Profile" as SFR006
  usecase "SFR007: Request Specific Investments Matching Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Generate Anomaly Transaction Alerts" as SFR008
  usecase "SFR012: Create Client Dashboards" as SFR012

  SysAdmin --> SAFR001 : Manage analysis parameters for system compliance.
}

rectangle "AI System (AIF)" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR003: Send Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Find Investment Opportunities Based on Risk Profile" as AIFR004

  SysAdmin --> SAFR001 : Configure AI parameters for accuracy.
}

rectangle "Feedback Loop (F)" {
  usecase "CFR011: Send Feedback to Improve System Outputs" as CFR011
}
@enduml