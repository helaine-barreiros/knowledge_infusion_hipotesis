@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor FinancialAdvisor as fa
actor SysAdmin as sa
system "System" as sys

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001  
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002  
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Spending Limit Alerts" as CFR006  
  usecase "CFR007: View Investment Opportunities" as CFR007  
  usecase "CFR008: Access News Related to Portfolio" as CFR008  
  usecase "CFR009: Consolidated Financial Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10

}

rectangle "System Management & Alerts" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001  
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "SFR004: Request AI Recommendations" as SFR004  
  usecase "SFR005: Request Spending Limit Alerts" as SFR005 
  usecase "SFR006: Request Investment Opportunities" as SFR006  
  usecase "SFR007: Request Specific Investments" as SFR007
  usecase "SFR008: Anomaly Transaction Alerts" as SFR008
  usecase "SFR009: Contextualized News Requests" as SFR009  
}

rectangle "AI Components" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001 
  usecase "AIFR002: Personalized Recommendations" as AIFR002
  usecase "AIFR003: Spending Limit Alerts" as AIFR003  
  usecase "AIFR004: Investment Opportunity Analysis" as AIFR004 
  usecase "AIFR005: Specific Investments" as AIFR005
  usecase "AIFR006: Anomaly Transaction Alerts" as AIFR006  
  usecase "AIFR007: Contextualized News Insights" as AIFR007 
}

rectangle "Advisors & Admins" {
  actor SysAdmin
  actor FinancialAdvisor

  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001  
  usecase "FAFR002: View Intervention Alerts" as FAFR002 
  usecase "FAFR003: Predictive Analytics for Clients" as FAFR003
}

c1 --> CFR001 : "View Financial Insights Dashboard"
c1 --> CFR002 : "Receive Anomalous Transaction Alerts"
c1 --> CFR003 : "View Financial Predictions"
c1 --> CFR004 : "Personalized Recommendations"
c1 --> CFR005 : "Manage Recommendation Preferences"
c1 --> CFR006 : "Spending Limit Alerts"
c1 --> CFR007 : "Investment Opportunities"
c1 --> CFR008 : "News Related to Portfolio"
c1 --> CFR009 : "Consolidated Financial Dashboard"
c1 --> CFR10  : "Manage Relationship with Advisors"

sa --> SAFR001 : "Manage Analysis Parameters"

fa --> FAFR002 : "View Intervention Alerts" 
fa --> AIFR006 : "Anomaly Transaction Alerts" 

sysAdmin --> sys
client --> sys

@enduml