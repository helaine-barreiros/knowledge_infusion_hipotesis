@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sas
actor FinancialAdvisor as faa
system :System: as sys

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Data and Trends" as CFR003
  usecase "CFR004: Personalized Recommendations Aligned with Profile" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts for Budget Control" as CFR006
  usecase "CFR007: Access Investment Opportunities Suitable to Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidated Financial Dashboard for Efficiency" as CFR010
  usecase "CFR011: Send Feedback on System Outputs" as CFR011

}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: Access Predictive Analytics About Clients' Situations" as FAFR003
}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters to Ensure Accuracy and Compliance" as SAFR001
}
  
system --> CFR001 : c1
system --> CFR002 : c1
system --> CFR003 : c1
system --> CFR004 : c1
system --> CFR005 : c1
system --> CFR006 : c1
system --> CFR007 : c1
system --> CFR008 : c1
system --> CFR009 : c1
sas --> SAFR001

faa --> FAFR001
faa --> FAFR002
faa --> FAFR003

@enduml