@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Alert Preferences" as SAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: Access Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Manage Relationship with Advisors" as CFR009

  SysAdmin --> SAFR001 : Configure Analysis Parameters  
}

rectangle "Client" {
  actor Client as c
  client --> CFR001 : View Dashboard  
  client --> CFR002 : Receive Alerts (FATF)  
  client --> CFR003 : Predictions Based on Data and Trends  
  client --> CFR004 : Personalized Recommendations  
  client --> CFR005 : Manage Preferences for Recos  
  client --> CFR006 : Spending Limit Alerts  
  client --> CFR007 : Investment Opportunities (Risk Profile)  
  client --> CFR008 : Portfolio News  
  client --> CFR009 : Relationship with Advisors  

}

rectangle "Financial Advisor" {
  actor FinancialAdvisor as f
  financialadvisor --> FAFR001 : Manage Client Mentoring Sessions  
  financialadvisor --> FAFR002 : View Intervention Alerts (System)  
  financialadvisor --> FAFR003 : Predictive Analytics for Clients  
  financialadvisor --> FAFR004 : Configure Analysis Params by Segment  

}

rectangle "System Administrator" {
  actor SysAdmin as s
  sysadmin --> SAFR001 : Manage AI System Parameters (Regulations)  
}

package "AI Components" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Personalized Recommendations" as AIFR002
  usecase "AIFR003: Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Investment Opportunities Alignment" as AIFR005  
  usecase "AIFR006: Anomaly Transaction Alerts (AML)" as AIFR006  
  usecase "AIFR007: Contextualized News Insights" as AIFR007
}

rectangle "System Functions" {
  usecase "SFR001: Deliver User Notifications" as SFR001
  usecase "SFR002: Personalize Recos Based on Profiles" as SFR002  
  usecase "SFR003: Request Financial Predictions from AI" as SFR003  
  usecase "SFR004: Request Recos from AI" as SFR004
  usecase "SFR005: Spending Limit Alerts (AI)" as SFR005  
  usecase "SFR006: Investment Opportunity Analysis (AI)" as SFR006  
  usecase "SFR007: Specific Investment Opportunities" as SFR007
}

client --> AIFR001 : Historical Data, Market Trends  
financialadvisor --> AIFR002 : Client Profiles and Goals  

SysAdmin <|-- SAFR001 : Reg Compliance (Basel III)  

CFR004 <|-- AIFR002 : Personalized Recos Based on KYC

client --> SFR005 : Exceed Spending Thresholds  
SFR005 --> AIFR003 : Alert User  

financialadvisor --> FAFR001 : Share Data (Client)  
SysAdmin <|-- SAFR004 : Segment Analysis Params  

CFR009 <|-- SFR002 : Manage Sharing Permissions

client --> AIFR007 : Portfolio News Context
AIFR007 --> SFR008 : Extract Relevant Info for User  

financialadvisor --> FAFR003 : Proactive Client Guidance  
SFR006 --> AIFR004 : Evaluate Against Risk Profile  

client --> CFR011 : Feedback to System

@enduml