@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFR002 <|-- (FAFR001)
  
  Client -> SFR003 : "Request"
  SystemAdmin -> SAFR001 : "Manage Parameters"
  FinancialAdvisor -> FAFR002 : "View Alerts"
}

rectangle "Client Dashboard" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  
  Client --> CFR009
}

rectangle "Spending Limits and Alerts" {
  usecase "SAFR005: Request Spending Limit Alerts from AI Component" as SAFR005
  usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
  
  SysAdmin -> SAFR005 : "Manage Parameters"
}

rectangle "Investment Opportunities and Recommendations" {
  usecase "SAFR006: Request Investment Opportunity Analysis from AI Component" as SAFR006
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  
  SysAdmin -> SAFR006 : "Manage Parameters"
}

rectangle "News and Analytics" {
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "SFR012: Generate Client Dashboards that Present Financial Information in an Intuitive Format" as SFR012
  
  SysAdmin -> SAFR012 : "Manage Parameters"
}

rectangle "Feedback Management" {
  usecase "CFR011: Send Feedback about System Recommendations and Insights" as CFR011
  
  Client --> CFR011
}
@enduml