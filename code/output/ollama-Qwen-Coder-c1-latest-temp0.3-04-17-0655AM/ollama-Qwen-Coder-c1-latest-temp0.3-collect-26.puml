@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FinancialAdvisor
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics about My Clients' Financial Situations" as FAFR003
  usecase "SFR020: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR020
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FinancialAdvisor --> FAFR003
}

rectangle "Client Dashboard Features" {
  usecase "CFR009: Access a Personalized Dashboard that Consolidates My Financial Information in a Single View to Efficiently Monitor My Finances" as CFR009
  
  Client --> CFR009
}

rectangle "Alerts and Notifications" {
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR013
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
  
  Client --> SFR013
  SysAdmin --> SAFR001
}

rectangle "Personalized Recommendations and Insights" {
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals to Optimize My Financial Strategies and Investment Portfolio" as CFR004
  usecase "FAFR002: View Client Intervention Alerts When the System Detects Patterns Requiring Professional Attention to Proactively Assist Clients With Potential Financial Issues" as FAFR002
  
  Client --> CFR004
  FinancialAdvisor --> FAFR002
}

rectangle "Spending Limits and Investment Opportunities" {
  usecase "CFR010: Manage My Relationship with Financial Advisors, Including Permissions for Sharing My Financial Data, to Maintain Privacy and Control Over My Financial Information" as CFR010
  usecase "FAFR007: View Predictive Insights from the AI Component to Enhance the Value of Financial Guidance Provided to Clients" as FAFR007
  
  Client --> CFR010
  FinancialAdvisor --> FAFR007
}

rectangle "News and Market Updates" {
  usecase "CFR008: View News Related to My Investment Portfolio to Stay Informed About Market Events That Might Affect My Assets" as CFR008
  
  Client --> CFR008
}
@enduml