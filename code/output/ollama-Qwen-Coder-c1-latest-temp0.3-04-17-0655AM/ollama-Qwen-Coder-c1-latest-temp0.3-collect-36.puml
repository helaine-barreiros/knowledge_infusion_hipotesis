@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (SAFR002)
  C --> (FAFR003)
  C --> (SFR014)
  
  C --> CFR001 : "View"
  C --> CFR002 : "Receive Alerts"
  C --> CFR003 : "Predictions"
  C --> CFR004 : "Recommendations"
  C --> CFR005 : "Manage Preferences"
  C --> CFR006 : "Spending Limits"
  C --> CFR007 : "Investment Opportunities"
  C --> CFR008 : "News"
  C --> CFR009 : "Dashboard"
  C --> CFR10 : "Relationship Management"
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (SAFR001)
  
  FA --> FAFR001 : "Manage Sessions"
  FA --> FAFR002 : "View Alerts"
  FA --> FAFR003 : "Predictive Analytics"
  FA --> FAFR004 : "Configure Parameters"
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR020: Manage User Feedback" as SFR020
  
  SA --> (AIFR003)
  
  SA --> SAFR001 : "Manage Params"
  SA --> SFR020 : "Feedback Management"
}

package "System Components" {
  usecase "SFR001: Deliver Alerts" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
  usecase "SFR005: Request Spending Limit Alerts" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  usecase "SFR010: Process Contextualized News for Users" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI" as SFR011
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI" as SFR015
  usecase "SFR016: Request Predictive Insights from AI to Enhance the Value of Financial Guidance Provided to Clients" as SFR016
  usecase "SFR017: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR017
  usecase "SFR018: Manage Users' Financial Goals Tracking Progress and Providing Relevant Recommendations" as SFR018
  usecase "SFR019: Maintain a Historical Record of Users' Insights for Trend Analysis and Effectiveness Measurement" as SFR019
  
  SFR020 --> (AIFR003)
  
  SFR001 --> SAFR002 : "Deliver Alerts"
  SFR002 --> FAFR004 : "Recommendations"
  SFR003 --> AIFR009 : "Predictions"
  SFR004 --> (AIFR005)
  SFR005 --> SAFR016 : "Spending Limits"
  SFR006 --> FAFR007 : "Investment Opportunities"
  SFR007 --> AIFR008 : "Specific Investments"
  SFR008 --> (AIFR009)
  SFR009 --> SAFR015 : "News Insights"
  SFR010 --> FAFR003 : "Process News"
  SFR011 --> AIFR012 : "Contextualized Insights"
  SFR012 --> (AIFR014)
  SFR013 --> SAFR018 : "Client Alerts"
  SFR014 --> FAFR006 : "Analytics"
  SFR015 --> AIFR017 : "Predictive Interventions"
  SFR016 --> (AIFR019)
  SFR017 --> SAFR020 : "Financial Health Reports"
  SFR018 --> FAFR004 : "Goal Management"
  SFR019 --> AIFR013 : "Historical Insights"
}

package "AI System" {
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations Based on User Profiles and Goals" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Based on User Strategies and Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News With Specific User Portfolios Identifying Relevant Impacts" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009
  
  SFR020 --> (AIFR013)
  
  AIFR001 --> SAFR002 : "Predictions"
  AIFR002 --> FAFR004 : "Recommendations"
  AIFR003 --> SAFR016 : "Spending Limits"
  AIFR004 --> (FAFR007)
  AIFR005 --> FAFR008 : "Investment Opportunities"
  AIFR006 --> SFR020 : "Anomaly Alerts"
  AIFR007 --> SAFR015 : "News Insights"
  AIFR008 --> (FAFR019)
  AIFR009 --> FAFR014 : "Predictive Insights"
}

@enduml