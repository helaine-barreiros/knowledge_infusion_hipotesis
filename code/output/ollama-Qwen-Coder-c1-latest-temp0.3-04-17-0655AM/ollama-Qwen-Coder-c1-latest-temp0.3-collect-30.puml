@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SystemAdmin as SA
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SA --> (SAFR001)
}

rectangle "AI Component" {
  package "Financial Insights & Predictions" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "SFR003: Request Financial Predictions from AI" as SFR003
    
    C --> (SFR003)
  }
  
  package "Personalized Recommendations" {
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
    
    C --> (SFR004)
  }
  
  package "Spending Limit Alerts" {
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
    
    C --> (SFR005)
  }
  
  package "Investment Opportunities Analysis" {
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "SFR007: Request Investment Opportunities from AI" as SFR007
    
    C --> (SFR007)
  }
  
  package "News and Insights" {
    usecase "AIFR005: Generate Contextualized News Insights" as AIFR005
    usecase "SFR013: Request Client Alerts Based on Predefined Conditions" as SFR013
    
    C --> (SFR013)
  }
  
  package "Predictive Interventions and Analytics" {
    usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
    
    FA --> (SFR15)
  }
  
  package "Financial Health Reports and Goals Management" {
    usecase "AIFR017: Generate Financial Health Reports" as AIFR017
    usecase "SFR018: Manage Users' Financial Goals" as SFR018
    
    C --> (SFR018)
  }
}

package "System" {
  actor System as Sys
  
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  usecase "SFR017: Generate Client Dashboards" as SFR017
  usecase "SFR019: Maintain Historical Record of User Insights" as SFR019
  
  Sys --> (C)
}

package "User Feedback Management" {
  actor UserFeedbackManager as UFM
  usecase "CFR11: Send Feedback about System Recommendations and Insights" as CFR11
  
  C --> (UFCM)
}
@enduml