@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor (FA): as FA

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
  usecase "SFR005: Request Spending Limit Alerts" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to User's Portfolio" as SFR009
  usecase "SFR12: Generate Client Dashboards" as SFR12
  usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003

  Client --> CFR001 : "View Financial Insights Dashboard"
  Client --> SAFR001 : "Manage Analysis Parameters"
  Client --> SFR002 : "Receive Personalized Recommendations"
  Client --> SFR004 : "Get Personalized Recommendations from AI"
  Client --> SFR005 : "Get Spending Limit Alerts"
  Client --> SFR006 : "View Investment Opportunities Suitable to My Risk Profile"
  Client --> SFR007 : "Find News Relevant to My Investment Portfolio"
  Client --> AIFR003 : "Receive Spending Limit Alerts"

  SysAdmin --> SAFR001 : "Manage Analysis Parameters for the AI System"

  FA --> FAFR002 : "View Client Intervention Alerts"
  FA --> FAFR004 : "Configure Analysis Parameters for Specific Client Segments"
  FA --> SFR003 : "Request Financial Predictions from AI"
  FA --> AIFR016 : "Generate Predictive Insights"

  rectangle "Client" {
    usecase "CFR002: View Alerts About Anomalous Transactions" as CFR002
    usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as CFR004
    usecase "CFR005: Manage Personalized Recommendations Preferences" as CFR005
    usecase "CFR010: Manage Relationship With Financial Advisors" as CFR010

    Client --> CFR002 : "View Alerts About Anomalous Transactions"
    Client --> CFR004 : "Receive Personalized Recommendations Aligned with My Financial Profile and Goals"
    Client --> CFR005 : "Manage Personalized Recommendations Preferences"
    Client --> CFR010 : "Manage Relationship With Financial Advisors"
  }

  rectangle "Financial Advisor" {
    usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
    usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004

    FA --> FAFR001 : "Manage Client Mentoring Sessions Based on System-Generated Insights"
  }

  rectangle "System" {
    usecase "SFR008: Request Anomaly Transaction Alerts from AI" as SFR008
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition" as AIFR006

    System Admin --> SAFR001 : "Manage Analysis Parameters for the AI System"
  }

  rectangle "User (Client, Financial Advisor, or System Administrator)" {
    usecase "CFR011: Send Feedback About Recommendations and Insights to Improve Future Outputs" as CFR011

    Client --> CFR011
    FA --> CFR011
    SysAdmin --> CFR011
  }
}

@enduml