@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR010)
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  SA --> (SAFR001)
}

rectangle "AI Component" {
  package "Financial Insights" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    
    CFR003 <|-- (AIFR001) : Provides financial predictions
    FAFR003 <|-- (AIFR001) : Provides predictive analytics about clients' situations
  }
  
  package "Personalized Recommendations" {
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    
    CFR004 <|-- (AIFR002) : Generates personalized recommendations for users
    FAFR001 <|-- (AIFR002) : Provides financial predictions to generate recommendations
  }
  
  package "Spending Limit Alerts" {
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    
    CFR006 <|-- (AIFR003) : Generates spending limit alerts for users
  }
  
  package "Investment Opportunities" {
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on Strategies and Modern Portfolio Theory" as AIFR005
    
    CFR007 <|-- (AIFR004) : Generates investment opportunities for users based on their risk profiles
  }
  
  package "Anomaly Transaction Alerts" {
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    
    CFR002 <|-- (AIFR006) : Detects potentially fraudulent activities in user transactions
  }
  
  package "Contextualized News Insights" {
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    
    CFR008 <|-- (AIFR007) : Correlates financial news with users' portfolios
  }
  
  package "Predictive Intervention Recommendations" {
    usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
    
    FAFR002 <|-- (AIFR008) : Identifies patterns for potential financial difficulties or opportunities
  }
  
  package "Predictive Insights" {
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
    
    FAFR003 <|-- (AIFR009) : Provides predictive insights to support planning
  }
}

package "System Functionality" {
  usecase "SFR001: Deliver Alerts Through Appropriate Notification Channels" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations Based on Financial Profiles" as SFR002
  
  CFR004 <|-- (SFR002) : Delivers personalized recommendations to users based on their profiles and preferences
}

package "User Feedback Management" {
  usecase "CFR11: Send Feedback about System's Recommendations and Insights" as CFR11
  
  C --> (CFR11)
  FA --> (CFR11)
  SA --> (CFR11)
  
  SFR020 <|-- (CFR11) : Manages user feedback to continuously improve outputs
}

@enduml