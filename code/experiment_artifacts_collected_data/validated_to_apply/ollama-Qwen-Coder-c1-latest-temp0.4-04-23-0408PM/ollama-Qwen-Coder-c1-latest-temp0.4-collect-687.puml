@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  CFR001 --> (View Alerts)
  CFR001 --> (View Financial Predictions)
  CFR001 --> (Receive Personalized Recommendations)
  CFR001 --> (Manage Recommendation Preferences)
  CFR001 --> (View Spending Limit Alerts)
  CFR001 --> (View Investment Opportunities)
  CFR001 --> (View News Related to Portfolio)
  CFR001 --> (Access Personalized Dashboard)
  CFR001 --> (Manage Relationship with Financial Advisors)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FinancialAdvisor --> (View Client Intervention Alerts)
  FinancialAdvisor --> (View Predictive Analytics)
  FinancialAdvisor --> (Configure Analysis Parameters for Specific Segments)
}

package "System Administrator" {
  actor SystemAdmin as SAFR001
  
  usecase "SAFR002: Manage Analysis Parameters" as SAFR002
  SAFR001 --> (Manage Analysis Parameters)
}

rectangle "AI Component" {
  package "Financial Insights & Predictions" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "SFR003: Request Financial Predictions from AI" as SFR003
    
    CFR002 <|-- (Generate Financial Predictions)
  }
  
  package "Personalized Recommendations" {
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
    
    CFR003 <|-- (Generate Personalized Recommendations)
  }
  
  package "Spending Limit Alerts" {
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
    
    CFR004 <|-- (Generate Spending Limit Alerts)
  }
  
  package "Investment Opportunities" {
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
    
    CFR005 <|-- (Generate Investment Opportunities)
  }
  
  package "Anomaly Transaction Alerts" {
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "SFR008: Request Anomaly Transaction Alerts from AI" as SFR008
    
    CFR006 <|-- (Generate Anomaly Transaction Alerts)
  }
  
  package "Contextualized News Insights" {
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "SFR010: Request Contextualized News from AI" as SFR010
    
    CFR008 <|-- (Generate Contextualized News)
  }
  
  package "Client Predictive Intervention Recommendations" {
    usecase "AIFR009: Generate Client Predictive Intervention Recommendations" as AIFR009
    usecase "SFR015: Request Predictive Intervention Analyses from AI" as SFR015
    
    FAFR002 <|-- (Generate Client Predictive Intervention Recommendations)
  }
  
  package "Client Predictive Insights" {
    usecase "AIFR010: Generate Client Predictive Insights" as AIFR010
    usecase "SFR016: Request Predictive Insights from AI" as SFR016
    
    FAFR003 <|-- (Generate Client Predictive Insights)
  }
  
  package "Financial Health Reports" {
    usecase "AIFR017: Generate Financial Health Reports" as AIFR017
    usecase "SFR028: Request Financial Health Reports from AI" as SFR028
    
    SAFR003 <|-- (Generate Financial Health Reports)
  }
}

package "System" {
  usecase "SFR009: Find Contextualized News Relevant to User's Portfolio" as SFR009
  usecase "SFR10: Process Contextualized News for Users' Situations" as SFR10
  
  CFR007 <|-- (Find Contextualized News)
}

package "User Feedback Management" {
  usecase "CFR11: Send Feedback about System's Recommendations and Insights" as CFR11
}
@enduml