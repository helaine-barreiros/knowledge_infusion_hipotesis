@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
}

package "System Administrator" {
  actor SysAdmin as SAFR003
}

rectangle "User Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  CFR001 --> (View Financial Insights Dashboard)
  FAFR002 --> (Manage Client Mentoring Sessions)
}

rectangle "Alerts and Notifications" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SAFR003: Manage Analysis Parameters for Specific Clients" as SAFR004
  
  CFR002 --> (View Client Intervention Alerts)
}

rectangle "Personalized Recommendations and Insights" {
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR004
  
  CFR001 --> (View Financial Predictions)
  FAFR002 --> (View Predictive Insights)
}

rectangle "Spending Limits and Alerts" {
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
  
  CFR001 --> (View Spending Limit Alerts)
}

rectangle "Investment Opportunities and Analysis" {
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  
  CFR001 --> (View Investment Opportunities)
}

rectangle "News and Information" {
  usecase "SFR008: Request Contextualized News Insights from AI Component" as SFR008
  usecase "AIFR007: Generate Client Predictive Intervention Recommendations by Identifying Patterns that Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  
  CFR001 --> (View News Related to Investment Portfolio)
}

rectangle "User Management and Feedback" {
  usecase "SFR20: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR20
  usecase "CFR011: Send Feedback about System's Recommendations and Insights" as CFR011
  
  CFR001 --> (Send Feedback)
}

@enduml