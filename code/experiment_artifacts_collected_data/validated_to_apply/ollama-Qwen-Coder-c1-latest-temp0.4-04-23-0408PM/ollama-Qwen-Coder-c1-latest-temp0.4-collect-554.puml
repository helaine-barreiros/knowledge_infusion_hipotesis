@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SysAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  SA --> (SAFR001)
}

rectangle "AI System" {
  package "Financial Insights Generation" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  }
  
  package "Investment Analysis" {
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on Strategies and MPT Principles" as AIFR005
  }
  
  package "Anomaly Detection" {
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  }
  
  package "News Insights Generation" {
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  }
  
  package "Predictive Interventions" {
    usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
  }
  
  package "Client Analytics and Reporting" {
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
    usecase "SFR017: Generate Financial Health Reports" as SFR017
  }
}

package "System Functions" {
  package "Notification Management" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
  }

  package "Recommendation Generation and Delivery" {
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  }
  
  package "Financial Prediction Requesting" {
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  }

  package "Recommendation Requesting" {
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  }
  
  package "Spending Limit Alert Requesting" {
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  }

  package "Investment Opportunity Analysis Requesting" {
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  }
  
  package "Specific Investment Opportunities Requesting" {
    usecase "SFR007: Request Specific Investment Opportunities Matching User Criteria and ESG Preferences" as SFR007
  }

  package "Anomaly Transaction Alert Requesting" {
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  }
  
  package "Contextualized News Retrieval" {
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  }

  package "News Processing for Insights Extraction" {
    usecase "SFR010: Process Contextualized News to Extract Relevance Information for Users' Financial Situations" as SFR010
  }
  
  package "Contextualized News Insight Requesting" {
    usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
  }

  package "Client Dashboard Generation" {
    usecase "SFR012: Generate Client Dashboards Presenting Financial Information in an Intuitive and Actionable Format" as SFR012
  }
  
  package "Client Alert Generation Based on Conditions" {
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR013
  }

  package "Client Analytics and Insights Requesting" {
    usecase "SFR014: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR014
  }
  
  package "Predictive Intervention Analysis Requesting" {
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component to Identify When Financial Advisors Should Engage with Clients" as SFR015
  }

  package "Client Predictive Insights Generation" {
    usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009
  }
  
  package "User Goal Management and Progress Tracking" {
    usecase "SFR018: Manage Users' Financial Goals to Track Progress and Provide Relevant Recommendations" as SFR018
  }

  package "Historical Insights Record Maintenance" {
    usecase "SFR019: Maintain a Historical Record of Users' Insights to Enable Trend Analysis and Effectiveness Measurement" as SFR019
  }
  
  package "User Feedback Management for Improvement" {
    usecase "CFR11: Send Feedback About System's Recommendations and Insights" as CFR11
    C --> (CFR11)
  }

}

@enduml