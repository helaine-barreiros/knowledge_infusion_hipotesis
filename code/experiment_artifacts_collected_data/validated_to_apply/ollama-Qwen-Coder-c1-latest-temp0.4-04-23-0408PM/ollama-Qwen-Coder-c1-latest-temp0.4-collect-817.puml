@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FinancialAdvisor

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "AIFR009: Generate Contextualized News Insights" as AIFR009
  
  User --> CFR001 : "View Dashboard"
  User --> FAFR002 : "Receive Alerts"
  SysAdmin --> SAFR001 : "Manage Parameters"
}

rectangle "Financial Advisor System" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "SFR004: Request Personalized Recommendations" as SFR004
  
  FinancialAdvisor --> FAFR001 : "Manage Sessions"
  FinancialAdvisor --> FAFR003 : "View Analytics"
  FinancialAdvisor --> SFR004 : "Receive Recommendations"
}

rectangle "Feedback System" {
  usecase "CFR011: Send Feedback" as CFR011
  
  User --> CFR011 : "Provide Input"
}
@enduml