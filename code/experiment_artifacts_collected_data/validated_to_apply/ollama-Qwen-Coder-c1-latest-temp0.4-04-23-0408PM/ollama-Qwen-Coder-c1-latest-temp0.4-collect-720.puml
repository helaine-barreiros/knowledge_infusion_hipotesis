@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as Client
:Financial Advisor: as FAdvisor
:System Administrator: as SysAdmin

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  
  Client --> (CFR001)
  FAdvisor --> (FAFR002)
  SysAdmin --> (SAFR001)

  rectangle "Client Dashboards and Alerts" {
    usecase "SFR012: Generate Client Dashboards that present Financial Information in an Intuitive Format" as SFR012
    usecase "SFR013: Generate Client Alerts based on Predefined Conditions" as SFR013
    
    Client --> (SFR012)
    FAdvisor --> (SFR012)
    SysAdmin --> (SFR012)

    Client --> (SFR013)
    FAdvisor --> (SFR013)
  }

  rectangle "Personalized Recommendations and Insights" {
    usecase "CFR004: Receive Personalized Recommendations Aligned with Financial Profile and Goals" as CFR004
    usecase "SAFR002: Manage Analysis Parameters for Specific Client Segments" as SAFR002
    
    Client --> (SFR015)
    FAdvisor --> (FAFR003)
    SysAdmin --> (SAFR002)

    Client --> (CFR004)
  }

  rectangle "Investment Opportunities and News" {
    usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
    usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
    
    Client --> (SFR10)
  }

  rectangle "System Management and Feedback" {
    usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance" as AIFR002
    usecase "CFR011: Send Feedback about the System's Recommendations and Insights to Help Improve Future Outputs" as CFR011
    
    Client --> (AIFR002)
    FAdvisor --> (AIFR004)
  }
}

@enduml