@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> FAFR003
  System --> (SFR002)
  System --> (AIFR002)
}

rectangle "Client Dashboard" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  
  Client --> CFR009
}

rectangle "Alerts and Notifications" {
  usecase "SFR013: Generate Client Alerts" as SFR013
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  
  System --> (SFR013)
  System --> (AIFR006)
}

rectangle "Investment Opportunities and Recommendations" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "FAFR002: Manage Client Mentoring Sessions Based on Insights" as FAFR002
  
  Client --> CFR007
  Financial Advisor --> (FAFR002)
}

rectangle "News and Information" {
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "SFR010: Process Contextualized News for Users' Financial Situations" as SFR010
  
  Client --> CFR008
  System --> (SFR010)
}

rectangle "Feedback and Improvement" {
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights" as CFR011
  
  Client --> CFR011
}
@enduml