@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations" as SAFR005
  usecase "CFR006: Manage Recommendation Preferences" as SAFR018
  usecase "CFR007: View Spending Limit Alerts" as SFR005
  
  CFR001 --> (SAFR003)
  CFR001 --> (SAFR004)
  CFR001 --> (SAFR006)
  CFR001 --> (SFR005)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
  
  usecase "FAFR003: View Predictive Analytics about Client's Financial Situations" as SAFR014
  usecase "FAFR006: Configure Analysis Parameters for Specific Client Segments" as AIFR004
  
  FinancialAdvisor --> (SAFR002)
  FinancialAdvisor --> (AIFR003)
}

package "System Administrator" {
  actor SystemAdministrator as SAFR019
  usecase "SAFR007: Manage Analysis Parameters for the AI System" as AIFR001
  
  SAFR019 --> (SAFR007)
}

rectangle "AI Component" {
  usecase "AIFR002: Generate Personalized Recommendations" as SFR004
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR005
  usecase "AIFR006: Generate Investment Opportunity Analyses" as AIFR010
}

rectangle "News Component" {
  usecase "SFR008: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR027
  usecase "SFR009: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as AIFR013
  
  CFR001 --> (AIFR014)
}

rectangle "Dashboard Component" {
  usecase "SFR12: Generate Client Dashboards that Present Financial Information in an Intuitive and Actionable Format" as SFR017
}

package "System" {
  usecase "SFR03: Deliver Alerts to Users Through Appropriate Notification Channels" as AIFR006
  
  CFR001 --> (AIFR006)
  
  FinancialAdvisor --> (AIFR008)
  
  SystemAdministrator --> (SAFR027)
}

rectangle "Feedback Component" {
  usecase "CFR11: Send Feedback about the System's Recommendations and Insights" as AIFR029
  
  CFR001 --> (AIFR029)
}

@enduml