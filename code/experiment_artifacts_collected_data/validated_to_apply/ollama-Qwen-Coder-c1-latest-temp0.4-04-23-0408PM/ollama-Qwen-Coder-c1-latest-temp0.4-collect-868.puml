@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor (FA): as FA
:User: as User

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Analysis Parameters" as SAFR001
  usecase "SFR003: Deliver Alerts to Users" as SFR003
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FA --> FAFR002
  User --> (Sends Feedback) : CFR011
}

rectangle "Client Functions" {
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  
  Client --> (Sends Feedback) : CFR011
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  
  FA --> (Sends Feedback) : CFR011
}

rectangle "System Functions" {
  usecase "SFR004: Deliver Personalized Recommendations to Users" as SFR004
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  
  System --> (Sends Feedback) : CFR011
}

@enduml