@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Current Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as CFR004
  usecase "CFR005: Manage Personalized Recommendations Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as CFR006
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "CFR009: Access a Personalized Dashboard that Consolidates Financial Information in a Single View" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
  
  rectangle "System" {
    usecase "SFR001: Deliver Alerts to Users Through Appropriate Notification Channels" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations Based on Financial Profiles" as SFR002
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities Matching User Criteria and ESG Preferences" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
    usecase "SFR010: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR010
    usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
    usecase "SFR012: Generate Client Dashboards Presenting Financial Information in an Intuitive and Actionable Format" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
    usecase "SFR014: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
    usecase "SFR016: Request Predictive Insights From the AI Component to Enhance Value of Financial Guidance Provided to Clients" as SFR016
    usecase "SFR017: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR017
    usecase "SFR018: Manage Users' Financial Goals Tracking Progress and Providing Relevant Recommendations" as SFR018
    usecase "SFR019: Maintain a Historical Record of Users' Insights for Trend Analysis and Effectiveness Measurement" as SFR019
    usecase "SFR020: Manage User Feedback to Continuously Improve Quality and Relevance of Financial Insights" as SFR020
    
    C --> SFR001
    C --> SFR002
    C --> SFR003
    C --> SFR004
    C --> SFR005
    C --> SFR006
    C --> SFR007
    C --> SFR008
    C --> SFR009
    C --> SFR010
    C --> SFR011
    C --> SFR012
    C --> SFR013
    C --> SFR014
    C --> SFR015
    C --> SFR016
    C --> SFR017
    C --> SFR018
    C --> SFR019
    C --> SFR020
    
    rectangle "Financial Advisor" {
      actor FinancialAdvisor as FA
      
      usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
      usecase "FAFR002: View Client Intervention Alerts When Patterns Require Professional Attention" as FAFR002
      usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as FAFR003
      usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments Based on Different Profiles and Regulatory Requirements" as FAFR004
      
      FA --> FAFR001
      FA --> FAFR002
      FA --> FAFR003
      FA --> FAFR004
    }
    
    rectangle "AI System" {
      actor AI as A
      
      usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
      usecase "AIFR002: Generate Personalized Recommendations Based on Financial Profiles, Goals, and Risk Tolerance" as AIFR002
      usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
      usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
      usecase "AIFR005: Generate Investment Opportunities Matching User Strategies Based on Modern Portfolio Theory Principles" as AIFR005
      usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
      usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News With Specific User Portfolios" as AIFR007
      usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
      usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Planning" as AIFR009
      
      FA --> AIFR001
      FA --> AIFR002
      FA --> AIFR003
      FA --> AIFR004
      FA --> AIFR005
      FA --> AIFR006
      FA --> AIFR007
      FA --> AIFR008
      FA --> AIFR009
      
    }
  }

}

@enduml