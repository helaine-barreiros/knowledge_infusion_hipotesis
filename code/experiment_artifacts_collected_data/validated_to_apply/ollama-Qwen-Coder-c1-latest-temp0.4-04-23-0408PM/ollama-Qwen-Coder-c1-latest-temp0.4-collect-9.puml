@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "CFR011: Send Feedback" as CFR011
  
  Client --> (SAFR001)
  Client --> (SFR003) : "Request Predictions"
  Client --> (AIFR004) : "Generate Investment Opportunities"
  
  SysAdmin --> SAFR001
  FAFD --> (FAFR002)
}

rectangle "Client" {
  usecase "CFR002: View Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as CFR004
  
  Client --> (CFR002)
  Client --> (CFR003) : "Request Predictions"
  Client --> (CFR004)
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations" as FAFR003
  
  FAFD --> (FAFR001)
  FAFD --> (FAFR003) : "View Predictive Insights"
}

rectangle "System Components" {
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002
  usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
  
  Sys --> (SFR002)
  Sys --> (AIFR001) : "Generate Predictions"
}

Client --> CFR011
SysAdmin --> SAFR001
FAFD --> FAFR002

@enduml