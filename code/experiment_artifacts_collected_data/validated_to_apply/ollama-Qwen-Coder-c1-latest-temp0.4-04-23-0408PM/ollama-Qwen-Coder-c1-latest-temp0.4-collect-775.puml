@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations" as SAFR005
  usecase "CFR006: Manage Recommendation Preferences" as CFR010
  
  CFR001 --> (View Financial Insights Dashboard)
  CFR001 --> SAFR003
  CFR001 --> SAFR004
  CFR001 --> CFR010
}

package "Financial Advisor" {
  actor "Financial Advisor" as FAFR002
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as SAFR007
  usecase "FAFR003: View Predictive Analytics for Clients" as SAFR009
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as SAFR015
  
  Financial Advisor --> (View Client Intervention Alerts)
  Financial Advisor --> SAFR007
  Financial Advisor --> SAFR003
  Financial Advisor --> SAFR004
}

package System {
  actor "System" as SFR002
  
  usecase "SFR001: Deliver Alerts to Users" as AIFR006
  usecase "SFR007: Generate Investment Opportunity Analysis for Clients" as AIFR005
  usecase "SFR019: Maintain Historical Record of User Insights" as SAFR023
  
  System --> (Generate Client Dashboards)
  System --> SFR001
  System --> AIFR007
  System --> SAFR019
}

package AI {
  actor "AI System" as AIFR001
  
  usecase "AIFR002: Generate Personalized Recommendations for Users" as SAFR004
  usecase "AIFR003: Generate Spending Limit Alerts for Users" as SAFR016
  usecase "AIFR008: Generate Anomaly Transaction Alerts" as AIFR009
  
  AI System --> (Generate Predictive Insights)
  AI System --> SAFR002
  AI System --> SAFR003
  AI System --> AIFR006
}

rectangle "User Interface" {
  usecase "CFR011: Send Feedback about Recommendations and Insights" as CFR011
  
  Client --> (Send Feedback)
  Financial Advisor --> (Send Feedback)
  System Administrator --> (Send Feedback)
  
  UserInterface --> CFR011
}
@enduml