@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  
  Client --> (CFR001)
  SysAdmin --> (SAFR001)
  Financial Advisor --> (FAFR002)
}

rectangle "Client Dashboard Features" {
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  
  Client --> (CFR003)
  Client --> (CFR004)
  Client --> (CFR005)
}

rectangle "Spending Management Features" {
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  
  Client --> (CFR006)
  System Admin <|-- (SAFR001) : manages parameters for alerts generation
}

rectangle "Investment Management Features" {
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  Client --> (CFR007)
  Financial Advisor --> (FAFR002) : receives alerts for intervention
}

rectangle "News and Information Features" {
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  
  Client --> (CFR008)
}

rectangle "Client Relationship Management Features" {
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  usecase "AIFR020: Generate User Feedback Reports" as AIFR020
  
  Client --> (CFR10)
}

rectangle "System Notifications and Recommendations" {
  usecase "SFR003: Deliver Personalized Recommendations" as SFR003
  usecase "SFR004: Request Financial Predictions from AI" as SFR004
  usecase "AIFR02: Generate Personalized Recommendations for Users" as AIFR02
  
  Client --> (SFR003)
  System Admin <|-- (SAFR001) : manages parameters and alerts generation
}

rectangle "AI Functions" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  
  System Admin <|-- (SAFR001) : manages parameters and alerts generation
}

rectangle "User Feedback Management Features" {
  usecase "CFR11: Send Feedback about Recommendations" as CFR11
  usecase "AIFR020: Generate User Feedback Reports" as AIFR020
  
  Client --> (CFR11)
}
@enduml