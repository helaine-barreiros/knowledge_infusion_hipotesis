@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001 
  usecase "SAFR005: Manage Recommendations Preferences" as SAFR005
  usecase "SFR009: Request Contextualized News" as SFR009
  
  C --> (CFR001)
  C --> (SAFR005)
  C --> (SFR009)
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA

  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (AIFR004)
}

package "System Administrators" {
  actor SysAdmin as SA

  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR020: Request User Feedback" as SFR020
  
  SA --> (SAFR001)
  SA --> (SFR020)
}

package "System Components" {
  rectangle System {
    usecase "SFR001: Deliver Alerts" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
    usecase "SFR005: Request Spending Limit Alerts" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities Matching Criteria and ESG Preferences" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts" as SFR008
    usecase "SFR10: Process Contextualized News to Extract Relevant Information" as SFR10
    usecase "SFR12: Generate Client Dashboards" as SFR12
    usecase "SFR13: Generate Client Alerts Based on Predefined Conditions" as SFR13
    usecase "SFR14: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR14
    usecase "SFR15: Request Predictive Intervention Analyses from AI" as SFR15
    usecase "SFR16: Request Predictive Insights from AI to Enhance the Value of Financial Guidance Provided to Clients" as SFR16
    usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
  }
}

@enduml