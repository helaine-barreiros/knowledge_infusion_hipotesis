@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR002
  
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
}

package System {
  actor "System Administrator" as SAFR001
  
  rectangle "AI Component" {
    usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities for Users" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News With Specific User Portfolios to Identify Relevant Impacts" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights that Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009
  }
  
  rectangle "System Component" {
    usecase "SFR001: Deliver Alerts to Users Through Appropriate Notification Channels to Ensure Timely Awareness of Critical Financial Events" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles to Support Better Financial Decision-Making" as SFR002
    usecase "SFR003: Request Financial Predictions from the AI Component to Provide Users With Forward-Looking Financial Insights" as SFR003
    usecase "SFR004: Request Personalized Recommendations From the AI Component Based on Each User's Financial Data and Preferences" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from the AI Component When User Spending Patterns Exceed Defined Thresholds" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis From the AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities from the AI Component That Match User Investment Criteria and ESG (Environmental, Social, and Governance) Preferences" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts From the AI Component to Detect Potentially Fraudulent Activities in Accordance with AML (Anti-Money Laundering) Regulations" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios from Trusted Financial News Sources" as SFR009
    usecase "SFR010: Process Contextualized News To Extract Relevant Information for Users' Financial Situations" as SFR010
    usecase "SFR011: Request Contextualized News Insights From the AI Component to Identify Potential Impacts on Users' Investments" as SFR011
    usecase "SFR012: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as SFR012
    usecase "SFR013: Generate Client Alerts Based On Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR013
    usecase "SFR014: Generate Client Analytics That Provide Meaningful Insights Into Financial Behavior and Performance" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses From the AI Component to Identify When Financial Advisors Should Engage With Clients" as SFR015
    usecase "SFR016: Request Predictive Insights From the AI Component To Enhance the Value of Financial Guidance Provided to Clients" as SFR016
    usecase "SFR017: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR017
    usecase "SFR018: Manage Users' Financial Goals To Track Progress and Provide Relevant Recommendations" as SFR018
    usecase "SFR019: Maintain a Historical Record of Users' Insights to Enable Trend Analysis and Effectiveness Measurement" as SFR019
    usecase "SFR020: Manage User Feedback To Continuously Improve the Quality and Relevance of Financial Insights" as SFR020
    
  }
}

rectangle "System Boundaries" {
  Client --> CFR001 : "View Financial Insights Dashboard"
  Client --> CFR002 : "Receive Alerts About Anomalous Transactions"
  Client --> CFR003 : "View Financial Predictions Based on Historical Data and Current Market Trends"
  Client --> CFR004 : "Receive Personalized Recommendations Aligned with My Financial Profile and Goals"
  Client --> CFR005 : "Manage Personalized Recommendations Preferences to Ensure Insights Relevant to My Financial Objectives and Risk Tolerance as Defined in My KYC (Know Your Customer) Profile"
  Client --> CFR006 : "View Spending Limit Alerts When I Exceed Predefined Thresholds in Specific Expense Categories"
  Client --> CFR007 : "View Investment Opportunities Suitable to My Risk Profile (as Defined Under MiFID II or Equivalent Standards)"
  Client --> CFR008 : "View News Related to My Investment Portfolio"
  Client --> CFR009 : "Access a Personalized Dashboard That Consolidates My Financial Information in a Single View"
  Client --> CFR010 : "Manage Relationship with Financial Advisors, Including Permissions for Sharing My Financial Data"
  
  FAFR002 --> FAFR003
  FAFR002 --> FAFR004
  
  SAFR001 --> AIFR001
  SAFR001 --> AIFR002
  SAFR001 --> AIFR003
  SAFR001 --> AIFR004
  SAFR001 --> AIFR005
  SAFR001 --> AIFR006
  SAFR001 --> AIFR007
  SAFR001 --> AIFR008
  SAFR001 --> AIFR009
  
  SFR002 <|-- (SFR003)
  SFR004 <|-- (AIFR002)
  SFR005 <|-- (AIFR003)
  SFR006 <|-- (AIFR004)
  SFR007 <|-- (AIFR005)
  SFR008 <|-- (AIFR006)
  SFR011 <|-- (SFR009)
  SFR012 <|-- (SAFR001)
  
}

@enduml