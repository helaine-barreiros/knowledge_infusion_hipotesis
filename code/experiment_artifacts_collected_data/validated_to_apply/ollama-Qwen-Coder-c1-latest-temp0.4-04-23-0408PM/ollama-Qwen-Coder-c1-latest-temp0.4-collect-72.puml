@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> FAFR002
  System --> (SFR003)
  System --> (AIFR004)
}

rectangle "Client Dashboard" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  
  Client --> CFR009
}

rectangle "Financial Advisor Features" {
  usecase "FAFR01: Manage Client Mentoring Sessions" as FAFR01
  usecase "FAFR03: View Predictive Analytics" as FAFR03
  usecase "SFR004: Request Personalized Recommendations" as SFR004
  
  Financial Advisor --> (FAFR01)
  Financial Advisor --> (FAFR03)
  System --> (SFR004)
}

rectangle "System Notifications & Alerts" {
  usecase "SAFR002: Manage Analysis Parameters" as SAFR002
  usecase "SFR005: Request Spending Limit Alerts" as SFR005
  usecase "AIFR003: Generate Anomaly Transaction Alerts" as AIFR003
  
  System --> (SAFR002)
  System --> (SFR005)
  System --> (AIFR003)
}

rectangle "User Feedback" {
  usecase "CFR11: Send User Feedback" as CFR11
  
  Client --> (CFR11)
  Financial Advisor --> (CFR11)
  SysAdmin --> (CFR11)
}
@enduml