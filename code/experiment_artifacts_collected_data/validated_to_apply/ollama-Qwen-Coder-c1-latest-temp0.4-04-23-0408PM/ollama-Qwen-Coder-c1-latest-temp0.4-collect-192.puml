@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts" as SAFR003
  usecase "CFR003: View Financial Predictions" as SAFR004
  usecase "CFR004: Receive Personalized Recommendations" as SAFR005
  usecase "CFR006: Manage Recommendation Preferences" as SAFR019
  usecase "CFR007: View Spending Limit Alerts" as SAFR008
  usecase "CFR008: Access Investment Opportunities" as SAFR006
  usecase "CFR009: View News Related to Portfolio" as SAFR10
  usecase "CFR10: Manage Relationship with Financial Advisors" as SAFR024
  
  CFR001 --> SAFR003 : "Receive Alerts"
  CFR001 --> SAFR004 : "View Predictions"
  CFR001 --> SAFR005 : "Get Recommendations"
  CFR001 --> SAFR019 : "Manage Preferences"
  CFR001 --> SAFR008 : "Spending Limits"
  CFR001 --> SAFR006 : "Investment Opportunities"
  CFR001 --> SAFR10 : "View News"
  CFR001 --> SAFR024 : "Manage Advisors"
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts" as SAFR009
  usecase "FAFR003: View Predictive Analytics" as SAFR016
  usecase "FAFR004: Configure Analysis Parameters for Clients" as SAFR015
  
  FAFR001 --> SAFR002 : "Intervention Alerts"
  FAFR001 --> SAFR003 : "Predictive Analytics"
  FAFR001 --> SAFR004 : "Configure Parameters"
}

package "System Administrator" {
  actor SystemAdministrator as SAFR001
  
  usecase "SAFR002: Manage Analysis Parameters" as SAFR001
  usecase "SFR018: Manage Users' Financial Goals" as SFR018
  
  SAFR001 --> SAFR001 : "Manage Params"
  SAFR001 --> SFR018 : "Manage Goals"
}

package "System Components" {
  rectangle System {
    usecase "SFR002: Deliver Personalized Recommendations" as AIFR002
    usecase "SFR003: Request Financial Predictions" as AIFR001
    usecase "SFR004: Request Personalized Recommendations" as AIFR004
    usecase "SFR005: Request Spending Limit Alerts" as AIFR003
    usecase "SFR006: Request Investment Opportunity Analysis" as AIFR007
    usecase "SFR008: Request Anomaly Transaction Alerts" as AIFR006
    usecase "SFR10: Find Contextualized News" as AIFR009
    usecase "SFR12: Generate Client Dashboards" as SFR017
    usecase "SFR13: Request Predictive Intervention Analyses" as SAFR015
    
    System --> AIFR002 : "Deliver Recommendations"
    System --> AIFR001 : "Predictions"
    System --> AIFR004 : "Recommendations"
    System --> AIFR003 : "Spending Alerts"
    System --> AIFR007 : "Investment Analysis"
    System --> AIFR006 : "Anomaly Alerts"
    System --> AIFR009 : "News Insights"
    System --> SFR012 : "Dashboards"
    System --> SAFR015 : "Predictive Interventions"
  }
}

@enduml