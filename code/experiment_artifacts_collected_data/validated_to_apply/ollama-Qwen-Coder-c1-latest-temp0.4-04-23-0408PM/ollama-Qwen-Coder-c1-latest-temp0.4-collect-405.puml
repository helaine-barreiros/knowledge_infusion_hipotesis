@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFD002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  usecase "CFR011: Send Feedback about System Recommendations and Insights" as CFR011
  
  User --> CFR001 : "View Financial Insights Dashboard"
  User --> FAFD002 : "Receive Alerts About Anomalous Transactions"
  SysAdmin --> SAFR001
  FAFD --> FAFD002
}

rectangle "Client" {
  usecase "CFR002: View Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Current Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as CFR004
  usecase "CFR005: Manage Personalized Recommendations Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts When I Exceed Predefined Thresholds in Specific Expense Categories" as CFR006
  
  User --> CFR002 : "Receive Alerts About Anomalous Transactions"
  User --> CFR003 : "View Financial Predictions Based on Historical Data and Current Market Trends"
  User --> CFR004 : "Receive Personalized Recommendations Aligned with My Financial Profile and Goals"
  User --> CFR005 : "Manage Personalized Recommendations Preferences"
  User --> CFR006 : "View Spending Limit Alerts When I Exceed Predefined Thresholds in Specific Expense Categories"
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFD001
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as FAFD003
  usecase "SFR004: Request Personalized Recommendations from AI Component Based on Each User's Financial Data and Preferences" as SFR004
  
  FAFD --> FAFD001 : "Manage Client Mentoring Sessions"
  FAFD --> FAFD003
}

rectangle "System Components" {
  usecase "SFR002: Request Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002
  usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
  
  System Admin --> SAFR001 : "Manage Analysis Parameters"
  User --> SFR003 : "Request Financial Predictions from AI Component"
  FAFD --> SFR004
  User --> SFR002 : "Request Personalized Recommendations to Users Based on Their Financial Profiles"
  AIFR001 --> AIFR004 : "Generate Investment Opportunity Analyses for Users"
}

@enduml