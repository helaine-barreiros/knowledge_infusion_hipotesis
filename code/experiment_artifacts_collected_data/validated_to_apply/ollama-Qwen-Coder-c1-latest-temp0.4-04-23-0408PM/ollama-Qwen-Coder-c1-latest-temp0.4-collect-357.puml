@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as c
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts About Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as CFR004
  usecase "CFR005: Manage Personalized Recommendations Preferences to Ensure Relevance" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as CFR006
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "CFR009: Access a Personalized Dashboard That Consolidates Financial Information in a Single View" as CFR009
  usecase "CFR010: Manage Relationship with Financial Advisors, Including Permissions for Sharing Data" as CFR010
  
  c --> CFR001
  c --> CFR002
  c --> CFR003
  c --> CFR004
  c --> CFR005
  c --> CFR006
  c --> CFR007
  c --> CFR008
  c --> CFR009
  c --> CFR010
  
  rectangle "Client System" {
    usecase "SFR02: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR02
    usecase "SFR03: Request Financial Predictions from the AI Component for Forward-Looking Insights" as SFR03
    usecase "SFR04: Request Personalized Recommendations from the AI Component Based on Each User's Data and Preferences" as SFR04
    usecase "SFR05: Request Spending Limit Alerts from the AI Component When User Spending Patterns Exceed Defined Thresholds" as SFR05
    usecase "SFR06: Request Investment Opportunity Analysis from the AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles" as SFR06
    usecase "SFR07: Request Specific Investment Opportunities from the AI Component Matching User Criteria and ESG Preferences" as SFR07
    usecase "SFR08: Request Anomaly Transaction Alerts From the AI Component to Detect Potentially Fraudulent Activities in Accordance with AML Regulations" as SFR08
    usecase "SFR09: Find Contextualized News Relevant to Users' Financial Portfolios from Trusted Financial News Sources" as SFR09
    usecase "SFR10: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR10
    usecase "SFR11: Request Contextualized News Insights From the AI Component to Identify Potential Impacts on Users' Investments" as SFR11
    usecase "SFR12: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as SFR12
    usecase "SFR13: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR13
    usecase "SFR14: Generate Client Analytics that Provide Meaningful Insights into Financial Behavior and Performance" as SFR14
    usecase "SFR15: Request Predictive Intervention Analyses From the AI Component to Identify When Advisors Should Engage with Clients" as SFR15
    usecase "SFR16: Request Predictive Insights from the AI Component to Enhance Financial Guidance Provided to Clients" as SFR16
    usecase "SFR17: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Ratios and Metrics" as SFR17
    usecase "SFR18: Manage Users' Financial Goals To Track Progress and Provide Relevant Recommendations" as SFR18
    usecase "SFR19: Maintain a Historical Record of Users' Insights to Enable Trend Analysis and Effectiveness Measurement" as SFR19
    usecase "SFR20: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR20
    
    c --> SFR02
    c --> SFR03
    c --> SFR04
    c --> SFR05
    c --> SFR06
    c --> SFR07
    c --> SFR08
    c --> SFR09
    c --> SFR10
    c --> SFR11
    c --> SFR12
    c --> SFR13
    c --> SFR14
    c --> SFR15
    c --> SFR16
    c --> SFR17
    c --> SFR18
    c --> SFR19
    c --> SFR20
    
    usecase "CFR011: Send Feedback About the System's Recommendations and Insights" as CFR011
    
    c --> CFR011
  }
}

package "Financial Advisor" {
  actor FinancialAdvisor as fa
  
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts When the System Detects Patterns Requiring Professional Attention" as FAFR002
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments To Customize the System's Behavior According to Different Profiles and Regulatory Requirements" as FAFR004
  
  fa --> FAFR001
  fa --> FAFR002
  fa --> FAFR003
  fa --> FAFR004
  
  rectangle "Financial Advisor System" {
    usecase "SFR15: Request Predictive Intervention Analyses From the AI Component to Identify When Advisors Should Engage with Clients" as SFR15
    
    fa --> SFR15
  }
}

package "System Administrator" {
  actor SysAdmin
  
  usecase "SAFR001: Manage Analysis Parameters for the AI System To Ensure Compliance and Accuracy" as SAFR001
  
  SysAdmin --> SAFR001
  
  rectangle "System Admin System" {
    usecase "SFR20: Manage User Feedback to Continuously Improve Insights" as SFR20
    
    SysAdmin --> SFR20
  }
}

package "AI System" {
  actor AI
  
  usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Data and Market Trends" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations Based on User Profiles, Goals, and Risk Tolerance" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Patterns" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses Based on User Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Aligning with Users' Strategies and Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News with User Portfolios" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns Indicating Potential Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support Planning" as AIFR009
  
  AI --> AIFR001
  AI --> AIFR002
  AI --> AIFR003
  AI --> AIFR004
  AI --> AIFR005
  AI --> AIFR006
  AI --> AIFR007
  AI --> AIFR008
  AI --> AIFR009
  
  rectangle "AI System" {
    usecase "SFR13: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR13
    
    AI --> SFR13
  }
}
@enduml