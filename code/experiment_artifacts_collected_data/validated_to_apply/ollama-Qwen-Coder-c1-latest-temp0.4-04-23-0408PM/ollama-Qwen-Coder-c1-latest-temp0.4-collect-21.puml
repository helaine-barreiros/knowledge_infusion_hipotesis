@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR005: Manage Recommendations Preferences" as SAFR005
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  Client --> (View Alerts)
  Client --> (Manage Relationship with Advisors)
  
  rectangle "Client Functions" {
    CFR001 : "CFR002: View Alerts"
    CFR003
    CFR004
    SAFR005
    SFR019
    CFR011
  }
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts"
  
  FinancialAdvisor --> (View Predictive Analytics)
  FinancialAdvisor --> (Configure Analysis Parameters for Clients)
}

rectangle "System Functions" {
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "SFR004: Request Personalized Recommendations"
  usecase "SFR015: Generate Intervention Analyses"
  
  SystemAdmin --> (Manage Analysis Parameters)
}

rectangle "AI Functions" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "SFR016": Generate Insights
  
  SystemAdmin --> (Manage Analysis Parameters)
}

@enduml