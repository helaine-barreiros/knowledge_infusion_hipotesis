@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor (FA): as FA

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
  usecase "SFR017: Generate Financial Health Reports" as SFR017
  
  Client --> CFR001 : "View"
  Client --> SAFR005 : "Manage Preferences"
  Client --> SFR002 : "Get Recommendations"
  Client --> SFR003 : "Request Predictions"
  Client --> SFR004 : "Get AI Recommendations"
  Client --> CFR011 : "Send Feedback"

  SysAdmin --> SAFR001 : "Manage Parameters"
  
  FA --> FAFR002 : "View Alerts"
  FA --> FAFR003 : "View Predictive Analytics"
  FA --> FAFR004 : "Configure Client Segments"
}

rectangle "Client Dashboard" {
  usecase "CFR010: Manage Relationship with Advisors" as CFR010
  usecase "CFR012: View Investment Opportunities Suitable to My Risk Profile" as CFR012
  
  Client --> CFR010 : "Manage Advisor Permissions"
  Client --> CFR012 : "View Investments"
}

rectangle "Financial Insights Dashboard" {
  usecase "SFR019: Maintain Historical Record of User Insights" as SFR019
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  
  Client --> CFR008 : "View News"
}

rectangle "Notifications and Alerts" {
  usecase "SFR007: Request Contextualized News Insights from AI" as SFR007
  usecase "SFR13: Generate Client Alerts Based on Predefined Conditions" as SFR13
  
  Client --> SFR007 : "Get News Insights"
}

rectangle "Predictive Analytics and Recommendations" {
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  usecase "SFR016: Request Predictive Insights from AI" as SFR016
  
  Client --> AIFR002 : "Get Recommendations"
}

@enduml