@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client) as User
:System Admin as SysAdmin
:Financial Advisor as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  rectangle "Client Functions" {
    User --> CFR001
    User --> (View Alerts)
    User --> (View Predictions)
    User --> (Receive Recommendations)
    User --> (Manage Preferences)
    User --> (Spending Limit Alerts)
    User --> (Investment Opportunities)
    User --> (News Related to Portfolio)
    User --> (Personalized Dashboard)
  }

  rectangle "Financial Advisor Functions" {
    FAFD --> SAFR001
    FAFD --> (Manage Client Sessions)
    FAFD --> (View Intervention Alerts)
    FAFD --> (Predictive Analytics)
    FAFD --> (Configure Analysis Parameters for Segments)
  }
  
  rectangle "System Functions" {
    SysAdmin --> SAFR001
    System --> CFR002 : "Deliver Alerts"
    System --> CFR003 : "Deliver Personalized Recommendations"
    System --> SFR004 : "Request Financial Predictions"
    System --> SFR005 : "Request Personalized Recommendations"
    System --> SFR006 : "Request Spending Limit Alerts"
    System --> SFR007 : "Request Investment Opportunity Analysis"
    System --> SFR008 : "Request Specific Investment Opportunities"
    System --> SFR009 : "Request Anomaly Transaction Alerts"
    System --> SFR10 : "Find Contextualized News Relevant to Portfolio"
    System --> SFR11 : "Process Contextualized News for Users"
    System --> SFR12 : "Generate Client Dashboards"
    System --> SFR13 : "Generate Client Alerts Based on Conditions"
    System --> SFR14 : "Generate Client Analytics"
    System --> SFR15 : "Request Predictive Intervention Analyses"
    System --> SFR16 : "Request Predictive Insights"
    System --> SFR17 : "Generate Financial Health Reports"
    System --> SFR18 : "Manage Users' Financial Goals"
  }
  
}

User <|-- SysAdmin
FAFD <|-- SysAdmin

@enduml