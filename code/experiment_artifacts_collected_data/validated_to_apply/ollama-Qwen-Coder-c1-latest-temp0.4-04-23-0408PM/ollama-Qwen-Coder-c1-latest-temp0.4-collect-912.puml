@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FAFR

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure analysis parameters for specific client segments" as FAFR004
  
  User --> (CFR002) : View Alerts about anomalous transactions in accounts
  User --> (CFR003) : View financial predictions based on historical data and current market trends
  User --> (CFR004) : Receive personalized recommendations aligned with financial profile and goals
  User --> (SAFR005: Manage personalized recommendation preferences) as SAFR005
  User --> (CFR006) : View spending limit alerts when exceeding predefined thresholds in specific expense categories
  User --> (FAFR011) : View investment opportunities suitable to risk profile
  User --> (CFR008) : View news related to financial portfolio
  User --> (SAFR009: Access a personalized dashboard that consolidates my financial information) as SAFR009
  User --> (FAFR012) : Manage relationship with Financial Advisors
  
  SysAdmin --> SAFR004
  FAFR --> (FAFR001: Manage client mentoring sessions based on system-generated insights)
  FAFR --> (SAFR003: View predictive analytics about clients' financial situations)
  
  User <|-- (CFR002) : Receive alerts for anomalous transactions in accounts
  User <|-- (SFR007: Request specific investment opportunities from AI component that match user criteria and ESG preferences)
  FAFR --> (FAFR013) : View predictive insights to enhance financial guidance
  
}

@enduml