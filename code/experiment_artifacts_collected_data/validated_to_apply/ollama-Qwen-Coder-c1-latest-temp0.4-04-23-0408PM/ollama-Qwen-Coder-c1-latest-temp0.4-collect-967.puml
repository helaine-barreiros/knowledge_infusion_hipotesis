@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Administrator: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFD002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  
  User --> CFR001
  SysAdmin --> SAFR001
  FAFD --> FAFD002
}

rectangle "Client Dashboard Features" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "SFR12: Generate Client Dashboards" as SFR12
  
  User --> CFR009
  SysAdmin --> SFR12
}

rectangle "Client Alerts and Notifications" {
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  
  User --> CFR006
  SysAdmin --> SFR013
}

rectangle "Financial Recommendations and Insights" {
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "SFR02: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR02
  
  User --> CFR004
  SysAdmin --> SFR02
}

rectangle "Investment Opportunities and News" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "SFR16: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations" as SFR16
  
  User --> CFR007
  SysAdmin --> SFR16
}

rectangle "Client Relationship Management" {
  usecase "CFR10: Manage My Relationship with Financial Advisors" as CFR10
  usecase "SFR24: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as SFR24
  
  User --> CFR10
  SysAdmin --> SFR24
}

rectangle "Feedback and Improvement" {
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights" as CFR11
  usecase "SFR25: Manage Users' Financial Goals to Track Progress and Provide Relevant Recommendations" as SFR25
  
  User --> CFR11
  SysAdmin --> SFR25
}

@enduml