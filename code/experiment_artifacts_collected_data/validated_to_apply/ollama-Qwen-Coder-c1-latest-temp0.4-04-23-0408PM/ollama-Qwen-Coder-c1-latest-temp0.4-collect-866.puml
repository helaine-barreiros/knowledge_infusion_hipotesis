@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations" as SFR002
  usecase "CFR005: Manage Recommendation Preferences" as CFR011
  
  CFR001 --> SAFR003 : "View Alerts"
  CFR001 --> SFR002 : "Receive Recommendations"
  CFR001 --> CFR011 : "Send Feedback"
}

package FinancialAdvisor {
  actor "Financial Advisor (FA)" as FAFR001
  
  usecase "FAFR003: View Predictive Analytics" as SAFR004
  usecase "FAFR005: Configure Analysis Parameters for Client Segments" as AIFR004
  usecase "FAFR006: Manage Client Mentoring Sessions Based on Insights" as FAFR002
  
  FA --> SAFR003 : "View Predictive Analytics"
  FA --> SFR005 : "Configure Analysis Parameters"
  FA --> FAFR006 : "Manage Mentorship Sessions"
}

package System {
  rectangle "System" {
    usecase "SFR012: Generate Client Dashboards" as AIFR008
    usecase "SFR013: Generate Client Alerts Based on Conditions" as SAFR005
    usecase "SFR014: Generate Client Analytics" as SFR016
    usecase "SFR020: Manage User Feedback" as AIFR009
    
    actor "System Administrator (SA)" as SAFR001
    
    SA --> SAFR005 : "Manage Alerts"
    SA --> SAFR007 : "Generate News Insights"
  }
}

@enduml