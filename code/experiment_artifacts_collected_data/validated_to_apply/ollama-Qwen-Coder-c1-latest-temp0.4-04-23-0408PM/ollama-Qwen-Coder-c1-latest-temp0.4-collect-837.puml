@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFD002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  
  User --> CFR001
  SysAdmin --> SAFR001
  FAFD --> FAFD002
}

rectangle "Client Dashboard" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  user --> CFR009
}

rectangle "Financial Advisor Module" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFD001
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFD003
  usecase "SFR004: Request Personalized Recommendations from AI Component Based on Each User's Financial Data and Preferences" as SFR004
  
  FAFD --> FAFD001
  FAFD --> FAFD002
}

rectangle "Alerts Module" {
  usecase "SFR005: Request Spending Limit Alerts from AI Component When User Spending Patterns Exceed Defined Thresholds" as SFR005
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments to Customize the System's Behavior According to Different Client Profiles and Regulatory Requirements Such As GDPR or CCPA" as FAFD004
  
  SysAdmin --> SAFR001
}

rectangle "Investment Module" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile (As Defined Under MiFID II Or Equivalent Standards)" as CFR007
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component To Identify Suitable Investments for Users Based on Their Risk Profiles" as SFR006
  
  SysAdmin --> SAFR001
}

rectangle "News Module" {
  usecase "CFR008: View News Related to My Investment Portfolio To Stay Informed About Market Events That Might Affect My Assets" as CFR008
  usecase "SFR007: Request Specific Investment Opportunities From AI Component That Match User Investment Criteria And ESG (Environmental, Social, and Governance) Preferences" as SFR007
  
  SysAdmin --> SAFR001
}

rectangle "Feedback Module" {
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as CFR11
  
  User --> CFR11
}
@enduml