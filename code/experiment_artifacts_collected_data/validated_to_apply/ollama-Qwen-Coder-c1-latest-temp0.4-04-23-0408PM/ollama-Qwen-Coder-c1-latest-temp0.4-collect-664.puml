@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR002
}

package SystemAdministrator {
  actor "System Administrator" as SAFR003
}

rectangle "User Interface" {
  usecase "View Financial Insights Dashboard" as CFR001
  usecase "Receive Alerts for Anomalous Transactions" as CFR002
  usecase "View Financial Predictions" as CFR003
  usecase "Get Personalized Recommendations" as CFR004
  usecase "Manage Recommendation Preferences" as CFR005
  usecase "View Spending Limit Alerts" as CFR006
  usecase "View Investment Opportunities" as CFR007
  usecase "View News Related to Portfolio" as CFR008
  usecase "Access Personalized Dashboard" as CFR009
  usecase "Manage Relationship with Financial Advisors" as CFR010
}

rectangle "System Functions" {
  usecase "Deliver Alerts through Notification Channels" as SFR001
  usecase "Provide Personalized Recommendations Based on Profiles" as SFR002
  usecase "Request Financial Predictions from AI Component" as SFR003
  usecase "Request Personalized Recommendations from AI Component" as SFR004
  usecase "Request Spending Limit Alerts from AI Component" as SFR005
  usecase "Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "Request Specific Investment Opportunities from AI Component" as SFR007
  usecase "Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "Find Contextualized News Relevant to User's Portfolio" as SFR009
  usecase "Process Contextualized News for Users' Financial Situations" as SFR010
  usecase "Request Contextualized News Insights from AI Component" as SFR011
  usecase "Generate Client Dashboards in Intuitive Format" as SFR012
  usecase "Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "Generate Client Analytics for Financial Behavior and Performance" as SFR014
  usecase "Request Predictive Intervention Analyses from AI Component" as SFR015
  usecase "Request Predictive Insights from AI Component to Enhance Financial Guidance" as SFR016
  usecase "Generate Financial Health Reports Based on Ratios and Metrics" as SFR017
  usecase "Manage Users' Financial Goals for Progress Tracking" as SFR018
  usecase "Maintain Historical Record of User Insights for Trend Analysis" as SFR019
  usecase "Manage User Feedback to Improve System Outputs" as CFR011
}

rectangle "AI Functions" {
  usecase "Generate Financial Predictions by Analyzing Data and Trends" as AIFR001
  usecase "Provide Personalized Recommendations Based on Profiles, Goals, and Risk Tolerance" as AIFR002
  usecase "Identify Spending Limit Alerts for Unusual Deviations from Established Patterns" as AIFR003
  usecase "Analyze Potential Investments Against User's Risk Profile and Financial Goals" as AIFR004
  usecase "Generate Investment Opportunities That Align with Strategies and Modern Portfolio Theory Principles" as AIFR005
  usecase "Detect Potentially Fraudulent Activities by Employing Pattern Recognition" as AIFR006
  usecase "Correlate Financial News with User's Portfolios to Identify Relevant Impacts" as AIFR007
  usecase "Identify Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  usecase "Provide Forward-Looking Analysis of Financial Situations for Effective Planning" as AIFR009
}

CFR001 --> CFR001 : View Financial Insights Dashboard
CFR002 --> CFR002 : Receive Alerts for Anomalous Transactions
CFR003 --> CFR003 : View Financial Predictions
CFR004 --> CFR004 : Get Personalized Recommendations
CFR005 --> CFR005 : Manage Recommendation Preferences
CFR006 --> CFR006 : View Spending Limit Alerts
CFR007 --> CFR007 : View Investment Opportunities
CFR008 --> CFR008 : View News Related to Portfolio
CFR009 --> CFR009 : Access Personalized Dashboard
CFR010 --> CFR010 : Manage Relationship with Financial Advisors

FAFR002 --> FAFR002 : Manage Client Mentoring Sessions Based on System-Generated Insights
FAFR003 --> FAFR003 : View Predictive Analytics About Clients' Financial Situations for Data-Driven Recommendations
FAFR004 --> FAFR004 : Configure Analysis Parameters for Specific Client Segments

SAFR003 --> SAFR001 : Manage Analysis Parameters to Ensure Compliance with Regulations and Accuracy of Algorithms

SFR002 <|-- CFR004 : Provide Personalized Recommendations Based on Profiles
SFR006 <|-- FAFR007 : Request Investment Opportunity Analysis from AI Component for Specific User Criteria and ESG Preferences
SFR013 --> SFR019 : Maintain Historical Record of User Insights

AIFR002 <|-- CFR004 : Provide Personalized Recommendations Based on Profiles, Goals, and Risk Tolerance
AIFR006 <|-- SAFR008 : Detect Potentially Fraudulent Activities by Employing Pattern Recognition in Compliance with FinCEN Requirements
AIFR017 --> SFR017 : Generate Financial Health Reports Based on Ratios and Metrics

@enduml