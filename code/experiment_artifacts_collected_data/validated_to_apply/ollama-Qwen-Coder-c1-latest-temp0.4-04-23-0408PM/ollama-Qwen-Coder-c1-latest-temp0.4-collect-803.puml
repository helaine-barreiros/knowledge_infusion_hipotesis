@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:User: as User

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics about My Clients' Financial Situations" as FAFR003
  
  Client --> (CFR001)
  SysAdmin --> (SAFR001)
  FAFD --> (FAFR003)
}

rectangle "Client Dashboard Features" {
  usecase "CFR002: Receive Alerts about Anomalous Transactions in My Accounts" as CFR002
  usecase "CFR006: View Spending Limit Alerts When I Exceed Predefined Thresholds in Specific Expense Categories" as CFR006
  
  Client --> (CFR002)
  Client --> (CFR006)
}

rectangle "Financial Recommendations & Insights" {
  usecase "SAFR005: Manage Personalized Recommendations Preferences" as SAFR005
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  
  Client --> (SAFR005)
  Financial Advisor --> (FAFR001)
}

rectangle "Investment Opportunities & News" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  
  Client --> (CFR007)
  Client --> (CFR008)
}

rectangle "System Functions & Alerts" {
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
  
  System Admin --> (SFR013)
  System Admin --> (AIFR006)
}

rectangle "User Feedback & Management" {
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as CFR11
  
  User --> (CFR11)
}
@enduml