  CFR001 --> (SFR003)
  CFR001 --> (SFR004)
  CFR001 --> (SFR005)
  CFR001 --> (SFR006)
  CFR001 --> (SFR007)
  CFR001 --> (SFR008)
  CFR001 --> (SFR009)
  CFR001 --> (SFR012)
  CFR001 --> (SFR013)
  CFR001 --> (SFR014)

  FAFR002 --> (FAFR006)
  FAFR002 --> (AIFR005)
  FAFR002 --> (AIFR007)
  FAFR002 --> (AIFR008)
  FAFR002 --> (SFR013)

  SAFR003 --> (SAFR006)
  SAFR003 --> (FAFR004)
  SAFR003 --> (AIFR005)
