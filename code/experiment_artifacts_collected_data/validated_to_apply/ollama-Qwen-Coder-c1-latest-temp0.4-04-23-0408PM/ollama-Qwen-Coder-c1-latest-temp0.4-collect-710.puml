@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFD002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> FAFD002
  System Admin -> SFR003 : <<SFR>>
  Financial Advisor -> AIFR004 : <<AIFR>>

}

rectangle "Client Dashboard" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  
  Client --> CFR009
}

rectangle "Financial Recommendations and Insights" {
  usecase "SAFR005: Manage Recommendation Preferences" as SAFR005
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFD001
  usecase "SFR002: Request Personalized Recommendations" as SFR002
  
  Client --> SAFR005
  Financial Advisor --> FAFD001
  System Admin -> SFR002 : <<SFR>>
}

rectangle "Spending Limits and Alerts" {
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  
  Client --> CFR006
}

rectangle "Investment Opportunities" {
  usecase "CFR007: View Investment Opportunities" as CFR007
  
  Client --> CFR007
}

rectangle "News and Analytics" {
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "SFR14: Generate Client Analytics" as SFR14
  
  Client --> CFR008
  System Admin -> SFR14 : <<SFR>>
}

rectangle "Feedback and Support" {
  usecase "CFR11: Send Feedback about Recommendations" as CFR11

  Client --> CFR11
}
@enduml