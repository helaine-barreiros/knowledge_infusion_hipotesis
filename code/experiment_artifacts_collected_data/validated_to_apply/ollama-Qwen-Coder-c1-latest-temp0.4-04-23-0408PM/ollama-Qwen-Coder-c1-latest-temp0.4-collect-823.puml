@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR009: Generate Contextualized News Insights" as AIFR009
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> FAFR002
  System --> SFR003
  System --> AIFR009
}

rectangle "Client Interface" {
  usecase "CFR002: View Alerts About Anomalous Transactions" as CFR002
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
  
  Client --> CFR002
  Client --> CFR004
  Client --> CFR010
}

rectangle "Financial Advisor Interface" {
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR005: Configure Analysis Parameters for Specific Client Segments" as FAFR005
  
  FinancialAdvisor --> FAFR003
  FinancialAdvisor --> FAFR005
}

rectangle "System Interface" {
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "SFR014: Generate Client Analytics" as SFR014
  
  System --> SFR012
  System --> SFR014
}

rectangle "Feedback Interface" {
  usecase "CFR011: Send Feedback About Recommendations and Insights" as CFR011
  
  User -> (Client, Financial Advisor, or SysAdmin) : CFR011
}
@enduml