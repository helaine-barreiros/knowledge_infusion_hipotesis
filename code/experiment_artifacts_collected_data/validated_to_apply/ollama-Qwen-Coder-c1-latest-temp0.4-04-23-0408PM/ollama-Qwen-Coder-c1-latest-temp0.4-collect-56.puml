@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive FATF Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access Financial News" as CFR008
  usecase "CFR009: View Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SA --> SAFR001
}

rectangle "System" {
  package "Alerts & Notifications" {
    usecase "SFR001: Deliver Alerts" as SFR001
    
    C --> (SFR001)
    FA --> (SFR001)
    SA --> (SFR001)
  }
  
  package "Recommendations" {
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    
    C --> (SFR002)
    FA --> (SFR002)
    SA --> (SFR002)
    
    (SFR002) <|-- (AIFR002)
  }
  
  package "Predictions" {
    usecase "SFR003: Request Financial Predictions" as SFR003
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    
    C --> (SFR003)
    FA --> (SFR003)
    SA --> (SFR003)
    
    (SFR003) <|-- (AIFR001)
  }
  
  package "Spending Limits" {
    usecase "SFR005: Request Spending Limit Alerts" as SFR005
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    
    C --> (SFR005)
    FA --> (SFR005)
    
    (SFR005) <|-- (AIFR003)
  }
  
  package "Investment Opportunities" {
    usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
    usecase "SFR012: Generate Client Dashboards" as SFR012
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    
    C --> (SFR006)
    FA --> (SFR006)
    
    (SFR006) <|-- (AIFR004)
  }
  
  package "News & Insights" {
    usecase "SFR007: Request Contextualized News" as SFR007
    usecase "SFR10: Generate Client Predictive Insights" as SFR10
    usecase "AIFR005: Generate Investment Opportunities for Users" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    
    C --> (SFR007)
    FA --> (SFR010)
    
    (SFR007) <|-- (AIFR005)
    (SFR010) <|-- (AIFR009)
  }
  
  package "Intervention" {
    usecase "SFR008: Request Predictive Intervention Analyses" as SFR008
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    
    FA --> (SFR008)
    
    (SFR008) <|-- (AIFR007)
  }
  
  package "Health & Goals" {
    usecase "SFR17: Generate Financial Health Reports" as SFR17
    usecase "SFR18: Manage Users' Financial Goals" as SFR18
    
    C --> (SFR17)
    FA --> (SFR18)
    
  }
  
  package "Feedback & Improvement" {
    usecase "CFR11: Send Feedback" as CFR11
    usecase "AIFR009: Generate Client Predictive Intervention Recommendations" as AIFR009
    
    C --> (CFR11)
    FA --> (SFR18)  ' Assuming feedback helps in managing financial goals
  
    (CFR11) <|-- (AIFR009)
  }
}

@enduml