@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as SAFR004
  usecase "CFR005: Manage Personalized Recommendations Preferences" as SAFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as SAFR006
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile (MiFID II or Equivalent Standards)" as SAFR007
  usecase "CFR008: View News Related to My Investment Portfolio" as SAFR008
  usecase "CFR009: Access a Personalized Dashboard That Consolidates My Financial Information in a Single View" as SAFR012
  
  CFR001 --> SAFR002 : "View Alerts"
  CFR001 --> SAFR003 : "View Predictions"
  CFR001 --> SAFR004 : "Receive Recommendations"
  CFR001 --> SAFR005 : "Manage Preferences"
  CFR001 --> SAFR006 : "View Spending Alerts"
  CFR001 --> SAFR007 : "View Investment Opportunities"
  CFR001 --> SAFR008 : "View News"
  CFR001 --> SAFR012 : "Access Dashboard"
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR001
  
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations" as SAFR007
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as SAFR020
  
  FAFR001 --> SAFR007 : "View Predictive Insights"
  FAFR001 --> SAFR020 : "Configure Parameters"
}

package System {
  actor "System Administrator" as SAFR001
  actor "User (Client, Financial Advisor, or System Administrator)" as CFR011
  
  usecase "SFR001: Deliver Alerts to Users Through Appropriate Notification Channels" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SAFR004
  usecase "SFR003: Request Financial Predictions from the AI Component" as AIFR001
  usecase "SFR005: Request Spending Limit Alerts From the AI Component" as AIFR003
  usecase "SFR006: Request Investment Opportunity Analysis From the AI Component" as AIFR004
  usecase "SFR007: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as SAFR12
  
  CFR011 --> SFR001 : "Send Feedback"
}
@enduml