@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
}

package "System Administrator" {
  actor SysAdmin as SAFR003
}

rectangle "User Interface (UI)" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001_UI
  usecase "SAFR005: Manage Analysis Parameters Preferences" as SAFR005_UI
  
  CFR001 --> CFR001_UI : "View"
  FAFR002 --> SAFR005_UI : "Manage"
}

rectangle "Notification System (NS)" {
  usecase "SFR001: Deliver Alerts" as SFR001_NS
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  
  CFR001 --> SFR001_NS : "Receive"
  FAFR002 --> SFR001_NS : "View"
}

rectangle "Recommendation System (RS)" {
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002_RS
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  CFR001 --> SFR002_RS : "Receive"
  FAFR002 --> SFR002_RS : "View"
}

rectangle "Prediction System (PS)" {
  usecase "SFR003: Request Financial Predictions" as SFR003_PS
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  
  CFR001 --> SFR003_PS : "Request"
}

rectangle "Investment System (IS)" {
  usecase "SFR006: Request Investment Opportunity Analysis" as SFR006_IS
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  CFR001 --> SFR006_IS : "Request"
}

rectangle "News System (NS)" {
  usecase "SFR008: Request Contextualized News" as SFR008_NS
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  
  CFR001 --> SFR008_NS : "Request"
}

rectangle "Dashboard System (DS)" {
  usecase "SFR12: Generate Client Dashboards" as SFR12_DS
  usecase "AIFR09: Generate Financial Health Reports" as AIFR09
  
  CFR001 --> SFR12_DS : "View"
}

rectangle "Feedback System (FS)" {
  usecase "CFR011: Send Feedback" as CFR011_FS
  usecase "SFR020: Manage User Feedback" as SFR020
  
  CFR001 --> CFR011_FS : "Send"
}

rectangle "Financial Insights System (FIS)" {
  usecase "SAFR003: Manage Analysis Parameters" as SAFR003_FIS
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  SysAdmin --> SAFR003_FIS : "Manage"
}

rectangle "Mentoring System (MS)" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001_MS
  usecase "SFR026: Request Predictive Intervention Analyses" as SFR026
  
  FAFR002 --> FAFR001_MS : "Manage"
}

rectangle "Intervention System (IS)" {
  usecase "FAFR003: View Client Intervention Alerts" as FAFR003_IS
  usecase "SFR027: Request Predictive Insights" as SFR027
  
  FAFR002 --> FAFR003_IS : "View"
}

rectangle "Analytics System (AS)" {
  usecase "FAFR005: View Predictive Analytics About Client Financial Situations" as FAFR005_AS
  usecase "SFR14: Generate Client Analytics" as SFR14
  
  FAFR002 --> FAFR005_AS : "View"
}

rectangle "Advisory System (AS)" {
  usecase "FAFR006: View Investment Opportunities Suitable to Risk Profile" as FAFR006_AS
  usecase "SFR17: Generate Financial Health Reports" as SFR17
  
  FAFR002 --> FAFR006_AS : "View"
}

rectangle "News Processing System (NPS)" {
  usecase "AIFR08: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as AIFR08
  usecase "SFR15: Request Predictive Insights from the AI Component" as SFR15
  
  CFR001 --> AIFR08 : "Process"
}

rectangle "Investment Opportunity Analysis System (IOAS)" {
  usecase "AIFR09: Generate Client Predictive Intervention Recommendations Based on Identified Patterns" as AIFR09
  usecase "SFR26: Request Predictive Insights from the AI Component" as SFR26
  
  FAFR002 --> AIFR09 : "Generate"
}

rectangle "AI System (AIS)" {
  usecase "AIFR10: Enhance Financial Guidance Provided to Clients Based on Predictive Insights Generated by AIS" as AIFR10
  usecase "SFR27: Request Predictive Insights from the AI Component" as SFR27
  
  FAFR002 --> AIFR10 : "Enhance"
}

@enduml