@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FAdvisor

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  User --> CFR001
  SysAdmin --> SAFR001
}

rectangle "Client Dashboards & Alerts" {
  usecase "CFR002: View Alerts for Anomalous Transactions" as CFR002
  usecase "SFR003: Deliver Alerts to Users" as SFR003
  
  User --> CFR002
  System Admin --> SAFR001
}

rectangle "Predictive Analytics & Recommendations" {
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "SFR004: Deliver Personalized Recommendations to Users" as SFR004
  
  User --> CFR003
  System Admin --> SAFR001
}

rectangle "Personalization & Preferences Management" {
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "SFR020: Manage User Feedback to Improve Insights" as SFR020
  
  User --> CFR005
  System Admin --> SAFR001
}

rectangle "Spending Limits & Investment Opportunities" {
  usecase "CFR006: View Spending Limit Alerts" as CFR006
