@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR012) : "View Alerts"
}

package FinancialAdvisor {
  actor "Financial Advisor" as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package System {
  actor "System Administrator" as SA
  rectangle "AI Component" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on Modern Portfolio Theory" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
    
    SA --> (SFR012)
  }
  
  rectangle "User Interface" {
    usecase "SFR014: Generate Client Analytics" as SFR014
    useusecase "SFR017: Generate Financial Health Reports" as SFR017
    usecase "SFR018: Manage Users' Financial Goals" as SFR018
    
    C --> (SFR012)
  }
  
  rectangle "Notification System" {
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
    SA --> (SFR013)
    
    FA --> (SFR013)
    
    C --> (SFR013)
  }
  
  rectangle "Dashboard System" {
    usecase "SFR012: Generate Client Dashboards" as SFR012
    
    C --> (SFR012)
  }

  SA <|-- (AIFR001)
  SA <|-- (AIFR002)
  SA <|-- (AIFR003)
  SA <|-- (AIFR004)
  SA <|-- (AIFR005)
  SA <|-- (AIFR006)
  SA <|-- (AIFR007)
  SA <|-- (AIFR008)
  SA <|-- (AIFR009)

  C --> (SFR012) : "View Alerts"
}

rectangle "System" {
  usecase "SFR001: Deliver Alerts to Users Through Appropriate Notification Channels" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations Based on User Financial Profiles" as SFR002
  useusecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  useusecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  useusecase "SFR010: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR010
  usecase "SFR011: Process Contextualized News to Extract Relevant Information for User's Financial Situations" as SFR011
  usecase "SFR012: Request Predictive Insights from AI Component" as SFR016
  
  C --> (SFR003)
  FA --> (SFR004)
  
  SA --> (SFR005)
  SA --> (SFR008)

  C --> (SFR009) : "View News"
}

C --> (CFR11) : "Send Feedback"

FA --> (AIFR003) : "Generate Alerts for Anomaly Detection"

@enduml