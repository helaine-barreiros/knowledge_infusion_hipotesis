@startuml
left to right direction

title Use Case Diagram for AI-Powered Financial Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
  
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA

  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Clients" as FAFR004
  
  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004

}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SA --> SAFR001
}

rectangle "AI Components" {
  package "Alerts" {
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
    
    C --> SFR005 : "Receive"
  }
  
  package "Recommendations" {
    usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
    usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
    
    C --> SFR002 : "Receive"
  }
  
  package "Predictive Analytics" {
    usecase "SFR016: Request Predictive Insights from AI Component" as SFR016
    usecase "AIFR009: Generate Client Predictive Insights for Users" as AIFR009
    
    C --> SFR016 : "Receive"
  }
  
  package "News and Analytics" {
    usecase "SFR008: Request Contextualized News from AI Component" as SFR008
    usecase "AIFR007: Generate Contextualized News Insights for Users" as AIFR007
    
    C --> SFR008 : "Receive"
  }
  
}

package "System Operations" {
  usecase "SFR013: Request Client Alerts from AI Component" as SFR013
  usecase "AIFR006: Generate Anomaly Transaction Alerts for Users" as AIFR006
  
  C --> SFR013 : "Receive"
}

package "User Feedback Management" {
  usecase "CFR11: Send Feedback about Recommendations and Insights" as CFR11

  C --> CFR11
}
@enduml