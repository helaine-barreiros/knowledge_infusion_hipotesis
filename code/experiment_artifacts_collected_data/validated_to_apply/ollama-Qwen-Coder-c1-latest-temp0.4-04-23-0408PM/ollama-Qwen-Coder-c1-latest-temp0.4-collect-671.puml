@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> CFR001 : "View"
  C --> CFR002 : "Receive Alerts on Anomalous Transactions"
  C --> CFR003 : "View Predictions"
  C --> CFR004 : "Receive Recommendations"
  C --> CFR005 : "Manage Preferences"
  C --> CFR006 : "View Spending Limits"
  C --> CFR007 : "View Opportunities"
  C --> CFR008 : "View News"
  C --> CFR012 : "Send Feedback" 
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters per Client Segment" as FAFR004
  
  FA --> FAFR001 : "Manage Sessions"
  FA --> FAFR002 : "View Alerts"
  FA --> FAFR003 : "View Analytics"
  FA --> FAFR004 : "Configure Parameters"
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR020: Manage User Feedback" as SFR020

  SA --> SAFR001 : "Manage"
}

package "System Components" {
  rectangle "System" {
    usecase "SFR001: Deliver Alerts" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
    usecase "SFR005: Request Spending Limit Alerts" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
    usecase "SFR007: Request Specific Opportunities Matching Criteria and ESG Preferences" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Portfolio" as SFR009
    usecase "SFR10: Process Contextualized News for Users" as SFR10
    usecase "SFR11: Request Insights from AI Component" as SFR11
    usecase "SFR12: Generate Client Dashboards" as SFR12
    usecase "SFR13: Generate Client Alerts Based on Conditions" as SFR13
    usecase "SFR14: Generate Analytics for Users" as SFR14
    usecase "SFR15: Request Predictive Intervention Analyses from AI" as SFR15
    usecase "SFR16: Request Predictive Insights from AI Component" as SFR16
    usecase "SFR17: Generate Financial Health Reports" as SFR17
    usecase "SFR18: Manage Users' Financial Goals" as SFR18
    usecase "SFR19: Maintain Historical Record of Insights" as SFR19
  
    C --> SFR002 : "Receive Recommendations"
    FA --> SFR003 : "Request Predictions"
    SA --> SFR004 : "Manage Parameters"
  }
}

package "AI System Components" {
  rectangle "AI System" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations Based on Profiles and Goals" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
    usecase "AIFR005: Identify Financial Instruments Aligning with Strategies and MPT Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition" as AIFR006
    usecase "AIFR007: Correlate News Insights to User Portfolios for Relevance Identification" as AIFR007
    usecase "AIFR008: Identify Patterns Indicating Potential Financial Difficulties or Opportunities" as AIFR008
    usecase "AIFR009: Provide Forward-Looking Analysis of Situations for Effective Planning" as AIFR009
    
  }
}

@enduml