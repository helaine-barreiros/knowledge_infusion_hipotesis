@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics about My Clients' Financial Situations" as FAFR003
  
  Client --> (CFR001)
  SysAdmin --> (SAFR001)
  FAFD --> (FAFR003)
}

rectangle "Financial Advisor Module" {
  usecase "FAFR002: View Client Intervention Alerts When the System Detects Patterns Requiring Professional Attention to Proactively Assist Clients with Potential Financial Issues" as FAFR002
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments To Customize the System's Behavior According to Different Client Profiles and Regulatory Requirements Such As GDPR or CCPA" as FAFR004
  
  FAFD --> (FAFR002)
  FAFD --> (FAFR004)
}

rectangle "Client Management Module" {
  usecase "CFR010: Manage My Relationship With Financial Advisors Including Permissions for Sharing My Financial Data To Maintain Privacy and Control Over My Financial Information" as CFR010
  
  Client --> (CFR010)
}

rectangle "System Functionality Module" {
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles To Support Better Financial Decision-Making" as SFR002
  usecase "SFR003: Request Financial Predictions From the AI Component To Provide Users With Forward-Looking Financial Insights" as SFR003
  
  System Admin --> (SAFR001)
  Client --> (CFR001 : "View Alerts About Anomalous Transactions In My Accounts According to Regulations Set By The FATF")
}

rectangle "AI Functionality Module" {
  usecase "AIFR002: Generate Personalized Recommendations For Users Based On Their Financial Profiles, Goals, and Risk Tolerance As Defined by Industry Standards Like FINRA Guidelines" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts For Users By Identifying Unusual Deviations From Established Spending Patterns" as AIFR003
  
  System Admin --> (SAFR001)
}

rectangle "News and Insights Module" {
  usecase "SFR008: Request Contextualized News To Extract Relevant Information for Users' Financial Situations" as SFR008
  usecase "AIFR007: Generate Client Predictive Intervention Recommendations By Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR007
  
  System Admin --> (SAFR001)
}

rectangle "Feedback Module" {
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as CFR011
  
  Client --> (CFR011)
}
@enduml