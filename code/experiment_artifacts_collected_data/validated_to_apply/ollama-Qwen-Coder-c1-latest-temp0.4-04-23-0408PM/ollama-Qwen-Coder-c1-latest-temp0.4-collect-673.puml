@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Deliver Personalized Recommendations" as SFR003
  
  Client --> CFR001 : "View Financial Insights Dashboard"
  SysAdmin --> SAFR001 : "Manage Analysis Parameters"
  Client --> FAFR002 : "Receive Alerts about Anomalous Transactions"
  System --> CFR001 : "Deliver Personalized Recommendations to Users"
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  
  FinancialAdvisor --> FAFR001 : "Manage Client Mentoring Sessions"
  System --> FAFR003 : "Deliver Predictive Analytics to Advisors"
}

rectangle "Client Relationship Management" {
  usecase "CFR010: Manage Relationships with Financial Advisors" as CFR010
  
  Client --> CFR010 : "Manage Relationships with Financial Advisors"
}
@enduml