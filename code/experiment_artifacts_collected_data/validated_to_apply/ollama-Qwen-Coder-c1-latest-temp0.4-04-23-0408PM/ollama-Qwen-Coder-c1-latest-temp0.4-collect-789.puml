@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FA

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI" as SFR003
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  
  User --> CFR001
  SysAdmin --> SAFR001
  FA --> FAFR002
  System Admin --> (SFR003)
  System Admin --> (AIFR001)
}

rectangle "Client Dashboard" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  
  User --> CFR009
}

rectangle "Investment Insights" {
  usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  
  User --> (SFR006)
  System Admin --> (AIFR004)
}

rectangle "News and Alerts" {
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  
  User --> (CFR008)
  System Admin --> (SFR013)
}

rectangle "Spending Limits and Recommendations" {
  usecase "SAFR005: Manage Spending Limit Preferences for Users" as SAFR005
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  
  User --> (SAFR005)
  System Admin --> (AIFR002)
}

rectangle "Financial Health and Goals" {
  usecase "SFR17: Generate Financial Health Reports" as SFR17
  usecase "SFR18: Manage Users' Financial Goals to Track Progress" as SFR18
  
  User --> (SFR17)
  System Admin --> (SFR18)
}

rectangle "Feedback and Improvement" {
  usecase "CFR011: Send Feedback About Recommendations" as CFR011
  usecase "AIFR020: Manage User Feedback to Improve Accuracy of Outputs" as AIFR020
  
  User --> (CFR011)
  System Admin --> (AIFR020)
}

@enduml