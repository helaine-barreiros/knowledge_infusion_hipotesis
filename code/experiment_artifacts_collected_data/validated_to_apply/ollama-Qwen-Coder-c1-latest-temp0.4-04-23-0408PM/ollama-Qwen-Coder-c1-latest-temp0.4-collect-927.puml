@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as Client
:User (Financial Advisor): as FAdvisor
:System Administrator: as SysAdmin
:AI System: as AIFR001
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR005: Manage Analysis Parameters Preferences" as SAFR005
  usecase "FAFR012: Configure Client Segments for Analysis" as FAFR004
  
  Client --> (CFR001)
  SysAdmin --> (SAFR005)
}

rectangle "Financial Advisor System" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  
  FAdvisor --> (FAFR001)
  FAdvisor --> (FAFR002)
  FAdvisor --> (FAFR003)
}

rectangle "Client Relationship Management System" {
  usecase "CFR010: Manage Relationships with Financial Advisors" as CFR010
  usecase "SAFR005: Manage Analysis Parameters Preferences" as SAFR005
  
  Client --> (CFR010)
  SysAdmin --> (SAFR005)
}

rectangle "AI System Components" {
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities" as AIFR004
  
  Sys --> (AIFR001)
}

rectangle "Notification System" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR013: Generate Client Analytics" as SFR013
  
  Sys --> (SFR001)
  Sys --> (SFR013)
}

rectangle "News System" {
  usecase "SFR009: Request Contextualized News Insights" as SFR009
  usecase "AIFR007: Generate Client Predictive Insights" as AIFR009
  
  Sys --> (SFR009)
  Sys --> (AIFR009)
}

rectangle "Dashboard System" {
  usecase "CFR012: View Personalized Dashboard" as CFR012
  usecase "AIFR017: Generate Financial Health Reports" as AIFR017
  
  Client --> (CFR012)
  Sys --> (AIFR017)
}

rectangle "Feedback System" {
  usecase "CFR011: Send Feedback about Recommendations and Insights" as CFR011
  usecase "SFR020: Manage User Feedback" as SFR020
  
  Client --> (CFR011)
  Sys --> (SFR020)
}
@enduml