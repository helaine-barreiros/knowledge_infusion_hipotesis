@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (View Financial Insights Dashboard)
  C --> (Receive Anomalous Transaction Alerts)
  C --> (View Financial Predictions)
  C --> (Receive Personalized Recommendations)
  C --> (Manage Recommendation Preferences)
  C --> (View Spending Limit Alerts)
  C --> (View Investment Opportunities)
  C --> (View News Related to Portfolio)
  C --> (Access Personalized Dashboard)
  C --> (Manage Relationship with Financial Advisors)
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Clients" as FAFR004
  
  FA --> (Manage Client Mentoring Sessions)
  FA --> (View Client Intervention Alerts)
  FA --> (View Predictive Analytics)
  FA --> (Configure Analysis Parameters for Specific Clients)
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR020: Manage User Feedback" as SFR020
  
  SA --> (Manage Analysis Parameters)
  SA --> (Manage User Feedback)
}

package "System Components" {
  rectangle System {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities from AI Component" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
    usecase "SFR010: Process Contextualized News for Users" as SFR010
    usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
    usecase "SFR012: Generate Client Dashboards" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
    usecase "SFR014: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
    usecase "SFR016: Request Predictive Insights From the AI Component to Enhance Value of Financial Guidance Provided to Clients" as SFR016
    usecase "SFR017: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Metrics and Ratios" as SFR017
    usecase "SFR018: Manage Users' Financial Goals Tracking Progress and Providing Relevant Recommendations" as SFR018
    usecase "SFR019: Maintain Historical Record of Users' Insights for Trend Analysis and Effectiveness Measurement" as SFR019
    
    System --> (Deliver Alerts to Users)
    System --> (Deliver Personalized Recommendations)
    System --> (Request Financial Predictions from AI Component)
    System --> (Request Personalized Recommendations From the AI Component Based on Each User's Financial Data and Preferences)
    System --> (Request Spending Limit Alerts from AI Component When User Spending Patterns Exceed Defined Thresholds)
    System --> (Request Investment Opportunity Analysis from AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles)
    System --> (Request Specific Investment Opportunities From the AI Component That Match User Investment Criteria and ESG Preferences)
    System --> (Request Anomaly Transaction Alerts From the AI Component to Detect Potentially Fraudulent Activities in Accordance With AML Regulations)
    System --> (Find Contextualized News Relevant To Users' Financial Portfolios from Trusted Sources)
    System --> (Process Contextualized News for Users)
    System --> (Request Contextualized News Insights From the AI Component to Identify Potential Impacts On Users' Investments)
    System --> (Generate Client Dashboards That Present Financial Information In an Intuitive and Actionable Format)
    System --> (Generate Client Alerts Based on Predefined Conditions To Ensure Timely Notification of Important Financial Events)
    System --> (Generate Client Analytics Providing Meaningful Insights Into Financial Behavior And Performance)
    System --> (Request Predictive Intervention Analyses From the AI Component to Identify When Financial Advisors Should Engage With Clients)
    System --> (Request Predictive Insights From the AI Component to Enhance The Value Of Financial Guidance Provided To Clients)
    System --> (Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According To Standard Metrics And Ratios)
    System --> (Manage Users' Financial Goals Tracking Progress and Providing Relevant Recommendations)
    System --> (Maintain Historical Record of Users' Insights For Trend Analysis and Effectiveness Measurement)
  }
}

package "AI Components" {
  rectangle AI {
    usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Data, Trends, and Indicators" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations Based on Industry Standards like FINRA Guidelines" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Patterns" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users Evaluating Potential Investments Against Risk Profiles, Time Horizons, and Goals" as AIFR004
    usecase "AIFR005: Identify Financial Instruments Aligning With User Strategies and Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News With User Portfolios" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations Identifying Patterns Indicating Potential Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Provide Forward-Looking Analysis of Financial Situations to Support Effective Planning" as AIFR009
    
    AI --> (Generate Financial Predictions for Users by Analyzing Data, Trends, and Indicators)
    AI --> (Generate Personalized Recommendations Based on Industry Standards like FINRA Guidelines)
    AI --> (Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Patterns)
    AI --> (Generate Investment Opportunity Analyses for Users Evaluating Potential Investments Against Risk Profiles, Time Horizons, and Goals)
    AI --> (Identify Financial Instruments Aligning With User Strategies and Modern Portfolio Theory Principles)
    AI --> (Generate Anomaly Transaction Alerts Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements)
    AI --> (Generate Contextualized News Insights Correlating Financial News With User Portfolios)
    AI --> (Generate Client Predictive Intervention Recommendations Identifying Patterns Indicating Potential Difficulties or Opportunities Requiring Advisor Engagement)
    AI --> (Provide Forward-Looking Analysis of Financial Situations to Support Effective Planning)
  }
}

package "User" {
  actor User as U
  
  usecase "CFR11: Send Feedback About System's Recommendations and Insights" as CFR11
  U --> (Send Feedback About System's Recommendations and Insights)
}
@enduml