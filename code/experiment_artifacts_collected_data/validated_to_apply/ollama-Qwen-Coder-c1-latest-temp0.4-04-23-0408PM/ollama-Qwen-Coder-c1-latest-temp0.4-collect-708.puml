@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFR

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure analysis parameters for specific client segments" as FAFR004
  usecase "SFR012: Generate client dashboards that present financial information in an intuitive and actionable format" as SFR012
  usecase "AIFR009: Generate contextualized news insights by correlating financial news with specific user portfolios to identify relevant impacts" as AIFR007

  Client --> CFR001
  SysAdmin --> SAFR001
  FAFR --> FAFR004
  Client --> SFR012
  System Admin --> SAFR001
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR001: Manage client mentoring sessions based on system-generated insights to provide more valuable guidance aligned with each client's financial goals" as FAFR001
  usecase "FAFR002: View client intervention alerts when the system detects patterns requiring professional attention to proactively assist clients with potential financial issues" as FAFR002
  usecase "FAFR003: View predictive analytics about my clients' financial situations to provide data-driven recommendations during consultations" as FAFR003

  Financial Advisor --> FAFR001
  Financial Advisor --> FAFR002
  Financial Advisor --> FAFR003
}

rectangle "System Functions" {
  usecase "SFR007: Request specific investment opportunities from the AI component that match user investment criteria and ESG (Environmental, Social, and Governance) preferences" as SFR007
  usecase "SFR14: Generate client analytics that provide meaningful insights into financial behavior and performance" as SFR014

  System Admin --> SAFR001
  Client --> SFR012
}

rectangle "Client Functions" {
  usecase "CFR002: Receive alerts about anomalous transactions in my accounts to quickly identify potential fraud or unusual spending patterns according to regulations set by the Financial Action Task Force (FATF)" as CFR002
  usecase "CFR003: View financial predictions based on my historical data and current market trends to make more informed financial decisions and plan for future expenses" as CFR003
  usecase "CFR004: Receive personalized recommendations aligned with my financial profile and goals to optimize my financial strategies and investment portfolio" as CFR004
  usecase "CFR005: Manage my personalized recommendations preferences to ensure the system provides insights relevant to my financial objectives and risk tolerance as defined in my KYC (Know Your Customer) profile" as CFR005
  usecase "CFR006: View spending limit alerts when I exceed predefined thresholds in specific expense categories to maintain better control over my budget" as CFR006
  usecase "CFR007: View investment opportunities suitable to my risk profile (as defined under MiFID II or equivalent standards) to diversify my portfolio and maximize returns" as CFR007
  usecase "CFR008: View news related to my investment portfolio to stay informed about market events that might affect my assets" as CFR008
  usecase "CFR009: Access a personalized dashboard that consolidates my financial information in a single view to efficiently monitor my finances" as CFR009
  usecase "CFR10: Manage my relationship with Financial Advisors, including permissions for sharing my financial data, to maintain privacy and control over my financial information" as CFR10

  Client --> CFR002
  Client --> CFR003
  Client --> CFR004
  Client --> CFR005
  Client --> CFR006
  Client --> CFR007
  Client --> CFR008
  Client --> CFR009
  Client --> CFR10
}

rectangle "System Admin Functions" {
  usecase "SFR020: Manage user feedback to continuously improve the quality and relevance of financial insights" as SFR020

  System Admin --> SAFR001
  System Admin --> SFR020
}
@enduml