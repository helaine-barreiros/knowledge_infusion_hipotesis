@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
  
  rectangle "System" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions from AI" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities from AI" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from AI" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Portfolio" as SFR009
    usecase "SFR010: Process Contextualized News for Users" as SFR010
    usecase "SFR011: Request Contextualized News Insights from AI" as SFR011
    usecase "SFR012: Generate Client Dashboards" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Conditions" as SFR013
    usecase "SFR014: Generate Client Analytics for Insights" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses from AI" as SFR015
    usecase "SFR016: Request Predictive Insights from AI" as SFR016
    usecase "SFR017: Generate Financial Health Reports" as SFR017
    usecase "SFR018: Manage Users' Financial Goals" as SFR018
    usecase "SFR019: Maintain Historical Record of Insights" as SFR019
    usecase "SFR020: Manage User Feedback for Improvement" as SFR020
    
    C --> SFR001 : (Alerts)
    C --> SFR002 : (Recommendations)
    C --> SFR003 : (Predictions)
    C --> SFR004 : (Personalized Recommendations)
    C --> SFR005 : (Spending Limit Alerts)
    C --> SFR006 : (Investment Opportunities)
    C --> SFR007 : (Specific Investment Opportunities)
    C --> SFR008 : (Anomaly Transaction Alerts)
    C --> SFR009 : (News)
    C --> SFR010 : (Processed News)
    C --> SFR011 : (Contextualized Insights)
    C --> SFR012 : (Dashboards)
    C --> SFR013 : (Client Alerts)
    C --> SFR014 : (Analytics)
    C --> SFR015 : (Predictive Interventions)
    C --> SFR016 : (Insights)
    C --> SFR017 : (Financial Health Reports)
    C --> SFR018 : (Goals Management)
    C --> SFR019 : (Historical Record Maintenance)
    C --> SFR020 : (Feedback Processing)
  }
}

package "System Administrator" {
  actor SysAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  usecase "CFR11: Send Feedback about Recommendations and Insights to Improve Future Outputs" as CFR11
  
  SA --> SAFR001
  SA --> CFR11
}

package "Financial Advisor" {
  actor FAF as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts When Patterns Require Professional Attention" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments Based on Regulatory Requirements" as FAFR004
  
  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004
  
  rectangle "System" {
    usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
    usecase "SFR016: Request Predictive Insights from AI" as SFR016
    
    FA --> SFR005 : (Spending Limits)
    FA --> SFR016 : (Insights for Consultations)
  }
}

package "AI System" {
  actor AIF as AI
  
  usecase "AIFR001: Generate Financial Predictions Based on Historical Data and Market Trends" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Profiles, Goals, and Risk Tolerance" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Patterns" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users Based on Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities by Identifying Instruments Aligning with User Strategies and Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News With Specific User Portfolios to Identify Relevant Impacts" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations Based on Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Planning" as AIFR009
  
  AI --> AIFR001 : (Predictions)
  AI --> AIFR002 : (Recommendations)
  AI --> AIFR003 : (Spending Limits)
  AI --> AIFR004 : (Investment Opportunities)
  AI --> AIFR005 : (Specific Investments)
  AI --> AIFR006 : (Anomaly Alerts)
  AI --> AIFR007 : (News Insights)
  AI --> AIFR008 : (Predictive Interventions)
  AI --> AIFR009 : (Insights for Planning)
}

@enduml