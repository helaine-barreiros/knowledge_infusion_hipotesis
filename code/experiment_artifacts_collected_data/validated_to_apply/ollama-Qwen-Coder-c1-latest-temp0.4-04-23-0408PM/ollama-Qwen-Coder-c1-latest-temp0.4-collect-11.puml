@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FAFR002

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  
  User --> (CFR001)
  SysAdmin --> (SAFR001)
  Financial Advisor --> (FAFR003)
}

rectangle "Client Dashboard Features" {
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  
  User --> (CFR002)
  User --> (CFR003)
  User --> (CFR004)
  User --> (CFR005)
}

rectangle "Spending Limits and Alerts" {
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  
  User --> (CFR006)
}

rectangle "Investment Opportunities and News" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "CFR008: View Financial News Related to My Portfolio" as CFR008
  
  User --> (CFR007)
  User --> (CFR008)
}

rectangle "Financial Health and Goals Management" {
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
  usecase "SFR018: Manage Users' Financial Goals" as SFR018
  
  User --> (CFR010)
  SysAdmin --> (SFR018)
}

rectangle "Feedback and Improvement" {
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  usecase "AIFR012: Generate Contextualized News Insights" as AIFR012
  
  User --> (AIFR009)
  User --> (AIFR012)
}

@enduml