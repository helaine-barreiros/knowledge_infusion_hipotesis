@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
  
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA

  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004

}

package "System Administrator" {
  actor SysAdmin as SA

  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  
  SA --> SAFR001

}

rectangle "AI Components" {
  
  package "AI Recommendations" {
    usecase "AIFR002: Generate Personalized Recommendations Based on Profiles and Goals" as AIFR002
  }
  
  package "Spending Limit Alerts" {
    usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
  }

  package "Investment Opportunities Analysis" {
    usecase "AIFR004: Evaluate Potential Investments Against Risk Profiles and Goals" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on User Strategies and MPT Principles" as AIFR005
  }

  package "Anomaly Transaction Alerts" {
    usecase "AIFR006: Detect Potentially Fraudulent Activities" as AIFR006
  }
  
  package "Contextualized News Insights" {
    usecase "AIFR007: Correlate Financial News with User Portfolios" as AIFR007
  }

  package "Predictive Intervention Recommendations" {
    usecase "AIFR008: Identify Patterns Indicating Potential Financial Difficulties or Opportunities for Advisor Engagement" as AIFR008
  }
  
  package "Client Predictive Insights" {
    usecase "AIFR009: Provide Forward-Looking Analysis of Client Situations" as AIFR009
  }

}

package "System Operations" {
  actor System as Sys

  usecase "SFR001: Deliver Alerts to Users Through Appropriate Notification Channels" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations Based on Financial Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component Based on User Data and Preferences" as SFR004
  usecase "SFR005: Request Spending Limit Alerts From AI Component When Spending Patterns Exceed Defined Thresholds" as SFR005
  
  Sys --> SFR001
  Sys --> SFR002
  Sys --> SFR003
  Sys --> SFR004
  Sys --> SFR005

}

package "System Management" {
  
  usecase "SFR006: Request Investment Opportunity Analysis From AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles" as SFR006
  
  Sys --> SFR006

}

rectangle "User Feedback Loop" {

  usecase "CFR11: Send Feedback About System Recommendations and Insights" as CFR11

  C --> CFR11
  FA --> CFR11
  SA --> CFR11

}
@enduml