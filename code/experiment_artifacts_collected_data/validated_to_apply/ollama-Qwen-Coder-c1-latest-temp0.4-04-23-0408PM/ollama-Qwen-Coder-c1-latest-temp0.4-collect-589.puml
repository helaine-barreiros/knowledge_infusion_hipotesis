@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations" as SFR002
  usecase "CFR005: Manage Preferences for Recommendations" as CFR010
  
  Client --> (SAFR003)
  Client --> (SFR002)
  Client --> (CFR010)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  usecase "FAFR002: View Intervention Alerts" as SAFR004
  usecase "FAFR003: View Predictive Analytics" as SFR006
  
  FinancialAdvisor --> (SAFR004)
  FinancialAdvisor --> (SFR006)
}

package "System Administrator" {
  actor SystemAdmin as SAFR001
  
  usecase "SAFR002: Manage Analysis Parameters" as SAFR001
}

rectangle "AI Component" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  rectangle "Alerts Generation" {
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    
    SAFR004 --> (AIFR003)
  }
  
  rectangle "Recommendations Generation" {
    usecase "AIFR005: Generate Investment Opportunity Analyses" as AIFR005
    usecase "AIFR012: Generate Contextualized News Insights" as AIFR012
    
    FAFR003 --> (AIFR005)
  }
  
  rectangle "Predictive Interventions" {
    usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
    usecase "AIFR016: Enhance Financial Guidance Insights" as AIFR016
    
    FAFR002 --> (AIFR008)
  }
}

rectangle "System Functions" {
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  
  SAFR001 --> (AIFR002)
}

rectangle "User Interface & Feedback" {
  usecase "CFR009: Access Consolidated Dashboard" as CFR009
  usecase "SFR007: Generate Client Dashboards" as SFR012
  
  CFR001 --> (SAFR003)
  SAFR004 --> (AIFR006)
  
  rectangle "Feedback Loop" {
    actor User as CFR011
    
    usecase "CFR011: Send Feedback about Recommendations and Insights" as AIFR020
    
    User --> (SFR020)
  }
}

@enduml