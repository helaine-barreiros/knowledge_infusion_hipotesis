@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (SAFR002)
  C --> (SFR003)
  C --> (AIFR004)
  
  C -> (CFR001) : "View"
  C -> (CFR002) : "Receive Alerts"
  C -> (CFR003) : "Predictions"
  C -> (CFR004) : "Recommendations"
  C -> (CFR005) : "Manage Preferences"
  C -> (CFR006) : "Spending Limits"
  C -> (CFR007) : "Investment Opportunities"
  C -> (CFR008) : "News"
  C -> (CFR009) : "Dashboard"
  C --> (SFR11)
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FA --> (SAFR001)
  
  FA -> (FAFR001) : "Manage Sessions"
  FA -> (FAFR002) : "View Alerts"
  FA -> (FAFR003) : "Predictive Analytics"
  FA -> (FAFR004) : "Configure Parameters"
}

package "System" {
  actor System as Sys
  
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Matching Criteria and Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Portfolios" as SFR009
  usecase "SFR010: Process Contextualized News for Users" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI" as SFR011
  usecase "SFR012: Generate Client Dashboards in an Intuitive Format" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics for Insights into Financial Behavior and Performance" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI" as SFR015
  usecase "SFR016: Request Predictive Insights from AI to Enhance Guidance Value" as SFR016
  usecase "SFR017: Generate Financial Health Reports Assessing Users' Wellbeing" as SFR017
  usecase "SFR018: Manage Users' Financial Goals for Progress Tracking and Recommendations" as SFR018
  usecase "SFR019: Maintain Historical Record of Insights for Trend Analysis" as SFR019
  usecase "SFR020: Manage User Feedback to Improve Accuracy and Relevance" as SFR020
  
  Sys --> (CFR011)
  
  Sys -> (SAFR003) : "Request Predictions"
  Sys -> (AIFR004) : "Generate Recommendations"
  Sys -> (SFR005) : "Spending Limits Alerts"
  Sys -> (FAFR002) : "Client Intervention Alerts"
  
  Sys --> (CFR10)
}

package "AI System" {
  actor AI as A
  
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations Based on Profiles and Goals" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts for Unusual Deviations" as AIFR003
  usecase "AIFR004: Analyze Potential Investments Against Risk Tolerance, Time Horizons, and Financial Goals" as AIFR004
  usecase "AIFR005: Identify Investment Opportunities Matching Strategies and Modern Portfolio Theory" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Pattern Recognition for Compliance" as AIFR006
  usecase "AIFR007: Correlate Financial News with User Portfolios to Identify Relevant Impacts" as AIFR007
  usecase "AIFR008: Recommend Predictive Intervention Actions Based on Client Patterns" as AIFR008
  usecase "AIFR009: Provide Forward-Looking Financial Insights for Planning" as AIFR009
  
  Sys --> (SFR12)
  
  Sys -> (A) : "Request Predictions"
  Sys -> (A) : "Generate Recommendations"
  Sys -> (A) : "Spending Limits Alerts"
  Sys -> (FAFR003) : "Predictive Analytics"
}

@enduml