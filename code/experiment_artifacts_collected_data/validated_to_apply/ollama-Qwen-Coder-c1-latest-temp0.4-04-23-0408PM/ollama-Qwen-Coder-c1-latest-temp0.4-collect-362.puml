@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR019: Maintain Historical Record of Insights" as SFR019
  usecase "SFR20: Manage User Feedback" as SFR20
  
  SA --> (SAFR001)
  SA --> (SFR019)
  SA --> (SFR20)
}

package "System Components" {
  rectangle SystemComponents {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on ESG Criteria" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
    
    rectangle "Notification Channels" {
      usecase "SFR13: Deliver Alerts to Users" as SFR13
    }
    
    rectangle "Recommendation Engine" {
      usecase "SFR2: Deliver Personalized Recommendations" as SFR2
    }
    
    rectangle "Prediction Component" {
      usecase "SFR03: Request Financial Predictions from AI" as SFR03
      usecase "SFR14: Generate Client Analytics" as SFR14
    }
    
    rectangle "Recommendation Generation" {
      usecase "SFR04: Request Personalized Recommendations from AI" as SFR04
    }
    
    rectangle "Spending Limit Alerts" {
      usecase "SFR05: Request Spending Limit Alerts from AI" as SFR05
    }
    
    rectangle "Investment Opportunity Analysis" {
      usecase "SFR06: Request Investment Opportunity Analysis from AI" as SFR06
      usecase "SFR12: Generate Client Dashboards" as SFR12
    }
    
    rectangle "News Processing" {
      usecase "SFR07: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR07
      usecase "SFR08: Process Contextualized News Insights for Users" as SFR08
      usecase "SFR11: Request Contextualized News Insights from AI" as SFR11
    }
    
    rectangle "Predictive Intervention Analysis" {
      usecase "SFR15: Generate Predictive Intervention Analyses" as SFR15
    }
  }
}

@enduml