@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FinancialAdvisor

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004

  User --> CFR001 : "View Financial Insights Dashboard"
  User --> SFR002 : "Receive Personalized Recommendations"
  SysAdmin --> SAFR001
  FinancialAdvisor --> FAFR001
  FinancialAdvisor --> FAFR003
}

rectangle "Client" {
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR004: View Personalized Recommendations Aligned with My Goals" as CFR004
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010

  User --> CFR002 : "Receive Alerts about Anomalous Transactions"
  User --> CFR004 : "View Personalized Recommendations Aligned with My Goals"
  User --> CFR010 : "Manage Relationship with Financial Advisors"
}

rectangle "Financial Advisor" {
  usecase "FAFR003: View Client Intervention Alerts" as FAFR002
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004

  User --> FAFR002 : "View Client Intervention Alerts"
}

rectangle "System Components" {
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006

  User --> SFR013 : "Generate Client Alerts"
}

rectangle "AI System" {
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Generate Financial Health Reports" as AIFR005

  User --> AIFR004 : "Generate Investment Opportunities"
}

rectangle "News Processing" {
  usecase "SFR10: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR10
  usecase "AIFR07: Generate Client Predictive Insights" as AIFR09

  User --> SFR10 : "Find Contextualized News"
}

rectangle "Feedback Management" {
  usecase "CFR011: Send Feedback about System's Recommendations and Insights" as CFR011

  User --> CFR011
}
@enduml