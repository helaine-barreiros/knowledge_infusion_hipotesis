@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  Client --> (View Financial Insights Dashboard)
  Client --> (Receive Anomalous Transaction Alerts)
  Client --> (View Financial Predictions)
  Client --> (Receive Personalized Recommendations)
  Client --> (Manage Recommendation Preferences)
  Client --> (View Spending Limit Alerts)
  Client --> (View Investment Opportunities)
  Client --> (View News Related to Portfolio)
  Client --> (Access Personalized Dashboard)
  Client --> (Manage Relationship with Financial Advisors)
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FinancialAdvisor --> (Manage Client Mentoring Sessions)
  FinancialAdvisor --> (View Client Intervention Alerts)
  FinancialAdvisor --> (View Predictive Analytics about Clients' Financial Situations)
  FinancialAdvisor --> (Configure Analysis Parameters for Specific Client Segments)
}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SystemAdmin --> (Manage Analysis Parameters)
}

package "AI Component" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities for Users" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  System --> (Generate Financial Predictions)
  System --> (Generate Personalized Recommendations)
  System --> (Generate Spending Limit Alerts)
  System --> (Generate Investment Opportunity Analyses)
  System --> (Generate Investment Opportunities for Users)
  System --> (Generate Anomaly Transaction Alerts)
  System --> (Generate Contextualized News Insights)
  System --> (Generate Client Predictive Intervention Recommendations)
  System --> (Generate Client Predictive Insights)
}

package "System" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities from AI Component Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  usecase "SFR010: Process Contextualized News to Extract Relevance Information for Users' Financial Situations" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
  usecase "SFR012: Generate Client Dashboards in an Intuitive and Actionable Format" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
  usecase "SFR016: Request Predictive Insights From the AI Component to Enhance Value of Financial Guidance Provided to Clients" as SFR016
  usecase "SFR017: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Metrics" as SFR017
  usecase "SFR018: Manage Users' Financial Goals Tracking Progress and Providing Relevant Recommendations" as SFR018
  usecase "SFR019: Maintain a Historical Record of Users' Insights for Trend Analysis and Effectiveness Measurement" as SFR019
  usecase "SFR020: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR020
  
  System --> (Deliver Alerts to Users)
  System --> (Deliver Personalized Recommendations)
  System --> (Request Financial Predictions from AI Component)
  System --> (Request Personalized Recommendations From AI Component Based on Each User's Data and Preferences)
  System --> (Request Spending Limit Alerts From AI Component When Spending Patterns Exceed Defined Thresholds)
  System --> (Request Investment Opportunity Analysis From AI Component To Identify Suitable Investments For Users Based On Their Risk Profiles)
  System --> (Request Specific Investment Opportunities from the AI Component Matching User Criteria and ESG Preferences)
  System --> (Request Anomaly Transaction Alerts From AI Component to Detect Potentially Fraudulent Activities In Compliance With FinCEN Requirements)
  System --> (Find Contextualized News Relevant To Users' Financial Portfolios)
  System --> (Process Contextualized News To Extract Relevance Information For Users' Financial Situations)
  System --> (Request Contextualized News Insights From AI Component to Identify Potential Impacts On Users' Investments)
  System --> (Generate Client Dashboards in an Intuitive and Actionable Format)
  System --> (Generate Client Alerts Based on Predefined Conditions To Ensure Timely Notification of Important Financial Events)
  System --> (Generate Client Analytics Providing Meaningful Insights Into Financial Behavior And Performance)
  System --> (Request Predictive Intervention Analyses From AI Component to Identify When Financial Advisors Should Engage With Clients)
  System --> (Request Predictive Insights From the AI Component To Enhance The Value Of Financial Guidance Provided To Clients)
  System --> (Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According To Standard Metrics)
  System --> (Manage Users' Financial Goals Tracking Progress and Providing Relevant Recommendations)
  System --> (Maintain a Historical Record of Users' Insights for Trend Analysis And Effectiveness Measurement)
  System --> (Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights)
}

rectangle "User" {
  usecase "CFR11: Send Feedback About System's Recommendations and Insights" as CFR11
  
  User --> (Send Feedback About System's Recommendations and Insights)
}
@enduml