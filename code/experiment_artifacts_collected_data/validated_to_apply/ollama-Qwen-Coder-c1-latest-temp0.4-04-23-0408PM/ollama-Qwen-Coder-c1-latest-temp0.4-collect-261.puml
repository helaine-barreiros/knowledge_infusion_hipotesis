@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (SAFR005)
  C --> (SFR020)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA

  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (SAFR005)
}

package "System Administrator" {
  actor SystemAdmin as SA

  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
}

rectangle "AI Component" {
  package "Financial Insights" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
  }
  
  package "Recommendations" {
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  }

  package "Spending Limits" {
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  }
  
  package "Investment Opportunities" {
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Identify Suitable Investments Based on Risk Profiles" as AIFR005
  }

  package "Anomaly Detection" {
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  }
  
  package "Contextual News" {
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  }

  package "Predictive Interventions" {
    usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
  }
  
  package "Insights and Analytics" {
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
    usecase "SFR17: Generate Financial Health Reports" as SFR17
  }

  rectangle "System Functions" {
    usecase "SFR02: Deliver Personalized Recommendations to Users" as SFR02
    usecase "SFR03: Request Financial Predictions from AI Component" as SFR03
    usecase "SFR04: Request Personalized Recommendations from AI Component" as SFR04
    usecase "SFR05: Request Spending Limit Alerts from AI Component" as SFR05
    usecase "SFR06: Request Investment Opportunity Analysis from AI Component" as SFR06
    usecase "SFR07: Request Specific Investment Opportunities Based on User Criteria and ESG Preferences" as SFR07
    usecase "SFR08: Request Anomaly Transaction Alerts from AI Component" as SFR08
    usecase "SFR09: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR09
    usecase "SFR10: Process Contextualized News for User Information Extraction" as SFR10
    usecase "SFR11: Request Contextualized News Insights from AI Component" as SFR11
    usecase "SFR12: Generate Client Dashboards in an Intuitive Format" as SFR12
    usecase "SFR13: Generate Client Alerts Based on Predefined Conditions" as SFR13
    usecase "SFR14: Generate Client Analytics for Financial Insights and Performance" as SFR14
    usecase "SFR15: Request Predictive Intervention Analyses from AI Component" as SFR15
    usecase "SFR16: Request Predictive Insights to Enhance Financial Guidance" as SFR16
  }
}

package "User (Client, Financial Advisor, or System Administrator)" {
  actor User as U
  
  usecase "CFR011: Send Feedback about Recommendations and Insights" as CFR011

  U --> (SAFR005)
  U --> (SFR20)
}
@enduml