@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as c
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: View Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  c --> CFR001 : "View"
  c --> CFR002 : "Receive Alerts"
  c --> CFR003 : "Predictions"
  c --> CFR004 : "Recommendations"
  c --> CFR005 : "Manage Preferences"
  c --> CFR006 : "Spending Limits"
  c --> CFR007 : "Investment Opportunities"
  c --> CFR008 : "News"
  c --> CFR009 : "Dashboard"
  c --> CFR10 : "Relationship Management"
}

package "Financial Advisors" {
  actor FinancialAdvisor as fa
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  fa --> FAFR001 : "Manage Sessions"
  fa --> FAFR002 : "View Alerts"
  fa --> FAFR003 : "Predictive Analytics"
  fa --> FAFR004 : "Configure Parameters"
}

package "System" {
  actor System as s
  
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities from AI Component" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  usecase "SFR010: Process Contextualized News for User's Portfolio Insights" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics for Financial Behavior and Performance Insights" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
  usecase "SFR016: Request Predictive Insights from AI Component to Enhance Financial Guidance" as SFR016
  usecase "SFR017: Generate Financial Health Reports Based on Standard Ratios and Metrics" as SFR017
  usecase "SFR018: Manage Users' Financial Goals for Progress Tracking and Recommendations" as SFR018
  usecase "SFR019: Maintain Historical Record of User Insights for Trend Analysis" as SFR019
  usecase "SFR020: Manage User Feedback to Improve System Outputs" as SFR020
  
  s --> SFR001 : "Deliver Alerts"
  s --> SFR002 : "Personalized Recommendations"
  s --> SFR003 : "Request Predictions"
  s --> SFR004 : "Request Personalized Recommendations"
  s --> SFR005 : "Spending Limit Alerts"
  s --> SFR006 : "Investment Opportunity Analysis"
  s --> SFR007 : "Specific Investment Opportunities"
  s --> SFR008 : "Anomaly Transaction Alerts"
  s --> SFR009 : "Find News Relevant to Portfolios"
  s --> SFR010 : "Process News Insights"
  s --> SFR011 : "Request Contextualized News Insights"
  s --> SFR012 : "Generate Dashboards"
  s --> SFR013 : "Client Alerts Based on Conditions"
  s --> SFR014 : "Financial Behavior Analytics"
  s --> SFR015 : "Predictive Intervention Analyses"
  s --> SFR016 : "Enhanced Financial Guidance Insights"
  s --> SFR017 : "Generate Health Reports"
  s --> SFR018 : "Manage Goals and Recommendations"
  s --> SFR019 : "Maintain Historical Records"
  s --> SFR020 : "User Feedback Management"
}

package "AI System" {
  actor AI as a
  
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations Based on User Profiles and Goals" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Patterns" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users Based on Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Aligning with User Strategies and Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Planning" as AIFR009
  
  a --> AIFR001 : "Generate Predictions"
  a --> AIFR002 : "Personalized Recommendations"
  a --> AIFR003 : "Spending Limit Alerts"
  a --> AIFR004 : "Investment Opportunity Analysis"
  a --> AIFR005 : "Specific Investment Opportunities"
  a --> AIFR006 : "Anomaly Transaction Alerts"
  a --> AIFR007 : "Contextualized News Insights"
  a --> AIFR008 : "Predictive Intervention Recommendations"
  a --> AIFR009 : "Client Predictive Insights"
}

package "System Administrator" {
  actor SystemAdmin as sa
  
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  
  sa --> SAFR001 : "Manage Parameters"
}
@enduml