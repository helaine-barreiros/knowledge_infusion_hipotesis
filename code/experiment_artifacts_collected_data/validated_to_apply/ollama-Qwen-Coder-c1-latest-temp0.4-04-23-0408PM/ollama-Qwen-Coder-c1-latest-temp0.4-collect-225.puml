@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client) : as User
:System Admin: as SysAdmin
:Financial Advisor: as FAFR001

package "Clients" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  User --> CFR001 : "View"
  User --> CFR002 : "Receive Alerts"
  User --> CFR003 : "Predictions"
  User --> CFR004 : "Recommendations"
  User --> CFR005 : "Manage Preferences"
  User --> CFR006 : "Spending Limits"
  User --> CFR007 : "Investment Opportunities"
  User --> CFR008 : "News"
  User --> CFR009 : "Dashboard"
  User --> CFR10 : "Relationship Management"
}

package "Financial Advisors" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  Financial Advisor --> FAFR001 : "Manage Sessions"
  Financial Advisor --> FAFR002 : "Receive Alerts"
  Financial Advisor --> FAFR003 : "Predictive Analytics"
  Financial Advisor --> FAFR004 : "Configure Parameters"
}

package "System" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  usecase "SFR010: Process Contextualized News for User's Financial Situation" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
  usecase "SFR012: Generate Client Dashboards in Intuitive Format" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics for Financial Insights" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
  usecase "SFR016: Request Predictive Insights to Enhance Financial Guidance" as SFR016
  usecase "SFR017: Generate Financial Health Reports Based on Ratios and Metrics" as SFR017
  usecase "SFR018: Manage Users' Financial Goals for Tracking Progress" as SFR018
  usecase "SFR019: Maintain Historical Record of Insights for Trend Analysis" as SFR019
  usecase "SFR020: Manage User Feedback to Improve Outputs" as SFR020
  
  System Admin --> SFR003 : "Request Predictions"
  System Admin --> SFR004 : "Request Recommendations"
  System Admin --> SFR005 : "Request Spending Limit Alerts"
  System Admin --> SFR006 : "Request Investment Opportunities"
  System Admin --> SFR012 : "Generate Dashboards"
  
  Financial Advisor --> SFR003
  Financial Advisor --> SFR004
  
  User --> SFR001
  User --> SFR002
}

package "AI" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations Based on Profiles and Goals" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses Matching Risk Tolerance, Time Horizons, and Goals" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Aligning with Strategies and Modern Portfolio Theory" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Pattern Recognition for Compliance" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights Correlating with User Portfolios" as AIFR007
  usecase "AIFR008: Generate Predictive Intervention Recommendations Identifying Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations for Planning" as AIFR009
  
  System Admin --> AIFR001 : "Generate Predictions"
  
  FAFR004 <|-- (FAFR003)
}

rectangle "System Boundary" {
  User
  SysAdmin
  Financial Advisor
}
@enduml