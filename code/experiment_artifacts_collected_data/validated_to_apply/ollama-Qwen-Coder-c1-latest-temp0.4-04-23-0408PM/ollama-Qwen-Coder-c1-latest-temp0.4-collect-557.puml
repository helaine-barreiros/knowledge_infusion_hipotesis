@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
    usecase "CFR001: View Financial Insights Dashboard" as CFR001
    usecase "SAFR001: Manage Analysis Parameters" as SAFR001
    usecase "FAFR002: View Client Intervention Alerts" as FAFR002
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
}

rectangle "Client Dashboard" {
    Client --> CFR001
    SysAdmin --> SAFR001
    FAFD --> FAFR002
    System --> SFR003 : <<SFR003>>
    System --> AIFR004 : <<AIFR004>>
}

rectangle "Client Management" {
    Client --> CFR005 : Manage Recommendations Preferences
    SysAdmin --> SAFR001 : Configure Analysis Parameters for Specific Client Segments
    FAFD --> SFR020 : Manage User Feedback
}

rectangle "Notifications and Alerts" {
    System --> SFR013 : Generate Client Alerts Based on Predefined Conditions
    System --> SFR008 : Request Anomaly Transaction Alerts from AI Component
    System --> SFR005 : Request Spending Limit Alerts from AI Component
}

rectangle "Financial Insights and Recommendations" {
    System --> SFR022 : Deliver Personalized Recommendations to Users Based on Their Financial Profiles
    FAFD --> AIFR009 : Generate Client Predictive Intervention Recommendations for Advisors
    FAFD --> AIFR10 : Generate Client Predictive Insights for Enhanced Planning
}

rectangle "News and Analysis" {
    System --> SFR007 : Request Contextualized News from AI Component
    System --> SFR014 : Generate Client Analytics that Provide Meaningful Insights into Financial Behavior and Performance
}

Client --> CFR011 : Send Feedback about Recommendations

@enduml