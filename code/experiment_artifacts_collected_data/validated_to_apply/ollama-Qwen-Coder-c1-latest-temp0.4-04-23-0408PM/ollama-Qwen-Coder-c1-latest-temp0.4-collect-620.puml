@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FinancialAdvisor --> FAFR001
  System --> SFR001
}

rectangle "Client Functions" {
  usecase "CFR002: View Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Investments" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  
  Client --> CFR002
  Client --> CFR003
  Client --> CFR004
  Client --> CFR005
  Client --> CFR006
  Client --> CFR007
  Client --> CFR008
  Client --> CFR009
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  
  FinancialAdvisor --> FAFR002
  FinancialAdvisor --> FAFR003
}

rectangle "System Functions" {
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities from AI Component Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR010: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR010
  usecase "SFR012: Generate Client Dashboards Presenting Financial Information in an Intuitive and Actionable Format" as SFR012
  
  System --> SFR002
  System --> SFR003
  System --> SFR004
  System --> SFR005
  System --> SFR006
  System --> SFR007
  System --> SFR010
  System --> SFR012
  
}

rectangle "AI Functions" {
  usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
  usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities for Users by Identifying Financial Instruments That Align with Their Investment Strategies and Modern Portfolio Theory Principles" as AIFR005
  
  System --> AIFR001
  System --> AIFR003
  System --> AIFR004
  System --> AIFR005
  
}

rectangle "User Feedback" {
  usecase "CFR11: Send Feedback about Recommendations and Insights" as CFR11
  
  Client --> CFR11
  FinancialAdvisor --> CFR11
  SysAdmin --> CFR11
}
@enduml