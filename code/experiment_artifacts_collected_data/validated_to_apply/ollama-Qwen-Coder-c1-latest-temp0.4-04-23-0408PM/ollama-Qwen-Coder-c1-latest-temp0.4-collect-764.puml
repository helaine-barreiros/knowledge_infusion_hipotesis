@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
  
}

package FinancialAdvisor {
  actor "Financial Advisor" as FA

  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004

  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004
  
}

package System {
  actor "System Administrator" as SA

  usecase "SAFR001: Manage Analysis Parameters" as SAFR001

  SA --> SAFR001
  
}

rectangle "AI Component" {
    rectangle "AIFR001: Generate Financial Predictions" as AIFR001
    rectangle "AIFR002: Generate Personalized Recommendations" as AIFR002
    rectangle "AIFR003: Generate Spending Limit Alerts" as AIFR003
    rectangle "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    rectangle "AIFR005: Generate Investment Opportunities" as AIFR005
    rectangle "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    rectangle "AIFR007: Generate Contextualized News Insights" as AIFR007
    rectangle "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
    rectangle "AIFR009: Generate Client Predictive Insights" as AIFR009

  }

rectangle "Notification System" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    
    C --> SFR001
    FA --> SFR001
    SA --> SFR001
  
}

rectangle "Recommendation Engine" {
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002

  C --> SFR002
  FA --> SFR002
  
}

rectangle "Prediction System" {
  rectangle "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR001: Generate Financial Predictions" as AIFR001

  C --> SFR003
  FA --> SFR003
  
}

rectangle "Recommendation System" {
  rectangle "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002

  C --> SFR004
  FA --> SFR004
  
}

rectangle "Spending Limit System" {
  rectangle "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003

  C --> SFR005
  
}

rectangle "Investment Opportunity System" {
  rectangle "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004

  C --> SFR006
  
}

rectangle "ESG System" {
  rectangle "SFR007: Request Specific Investment Opportunities from AI Component that Match User Criteria and ESG Preferences" as SFR007
  usecase "AIFR005: Generate Investment Opportunities for Users by Identifying Financial Instruments That Align with Their Investment Strategies and Modern Portfolio Theory Principles" as AIFR005

  C --> SFR007
  
}

rectangle "Anomaly Detection System" {
  rectangle "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006

  C --> SFR008
  
}

rectangle "News System" {
  rectangle "SFR009: Request Contextualized News Insights from AI Component" as SFR009
  usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007

  C --> SFR009
  
}

rectangle "Predictive Intervention System" {
  rectangle "SFR15: Request Predictive Intervention Analyses from AI Component" as SFR15
  usecase "AIFR08: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008

  C --> SFR15
  
}

rectangle "Predictive Insights System" {
  rectangle "SFR16: Request Predictive Insights from AI Component" as SFR16
  usecase "AIFR09: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009

  C --> SFR16
  
}

rectangle "Health Report System" {
  rectangle "SFR17: Request Financial Health Reports from AI Component" as SFR17
  usecase "AIFR10: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics"

  C --> SFR17
  
}

rectangle "Goal Management System" {
  rectangle "SFR18: Manage Users' Financial Goals to Track Progress and Provide Relevant Recommendations" as SFR18
  usecase "AIFR10: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics"

  C --> SFR18
  
}

rectangle "Feedback System" {
  rectangle "SFR20: Request User Feedback from AI Component" as SFR20
  usecase "AIFR10: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics"

  C --> SFR20
  
}

@enduml