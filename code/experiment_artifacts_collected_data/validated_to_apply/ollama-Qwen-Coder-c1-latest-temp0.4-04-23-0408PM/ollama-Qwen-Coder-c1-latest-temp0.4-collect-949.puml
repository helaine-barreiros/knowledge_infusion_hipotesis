@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> (SAFR005)
  C --> (SFR020)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004
  
  FA --> (SFR015)
  FA --> (AIFR009)
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
}

package "System" {
  rectangle "AI-Powered Insights Engine" {
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities from AI" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from AI" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Portfolios" as SFR009
    usecase "SFR10: Process Contextualized News for Users" as SFR10
    usecase "SFR11: Request Contextualized News Insights from AI" as SFR11
    usecase "SFR12: Generate Client Dashboards" as SFR12
    usecase "SFR13: Generate Client Alerts Based on Predefined Conditions" as SFR13
    usecase "SFR14: Generate Client Analytics for Financial Behavior and Performance" as SFR14
    usecase "SFR15: Request Predictive Intervention Analyses from AI" as SFR15
    usecase "SFR16: Request Predictive Insights from AI to Enhance Financial Guidance" as SFR16
    usecase "SFR17: Generate Financial Health Reports for Users" as SFR17
    usecase "SFR18: Manage User Financial Goals and Track Progress" as SFR18
    usecase "SFR19: Maintain Historical Record of Insights" as SFR19
  
  }
  
  rectangle "AI System" {
    usecase "AIFR002: Generate Personalized Recommendations Based on Industry Standards" as AIFR002
    usecase "AIFR003: Identify Unusual Deviations from Spending Patterns" as AIFR003
    usecase "AIFR004: Evaluate Potential Investments Against Client Risk Profiles and Goals" as AIFR004
    usecase "AIFR005: Align Financial Instruments with Investment Strategies and Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR006: Employ Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
    usecase "AIFR007: Correlate Financial News with User Portfolios for Relevant Insights" as AIFR007
    usecase "AIFR008: Identify Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Provide Forward-Looking Analysis of Financial Situations for Effective Planning" as AIFR009
  
  }
  
}

package "User (Client, Financial Advisor, System Administrator)" {
  actor User as U
  
  usecase "CFR11: Send Feedback to Improve Recommendations and Insights" as CFR11
}
@enduml