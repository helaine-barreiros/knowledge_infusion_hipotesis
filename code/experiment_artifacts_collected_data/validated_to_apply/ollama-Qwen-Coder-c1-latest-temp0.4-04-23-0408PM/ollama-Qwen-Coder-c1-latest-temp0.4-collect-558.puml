@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Deliver Personalized Recommendations" as SFR003
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> (FAFR002)
  System --> (SFR003)
}

rectangle "Client Features" {
  usecase "CFR002: View Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Current Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as CFR004
  usecase "CFR005: Manage Personalized Recommendations Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as CFR006
  
  Client --> (CFR002)
  Client --> (CFR003)
  Client --> (CFR004)
  Client --> (CFR005)
  Client --> (CFR006)
}

rectangle "Financial Advisor Features" {
  usecase "FAFR01: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR01
  usecase "FAFR03: View Predictive Analytics About My Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as FAFR03
  
  FAFD --> (FAFR01)
  FAFD --> (FAFR03)
}

rectangle "System Features" {
  usecase "SFR002: Deliver Personalized Recommendations Based on Users' Financial Profiles to Support Better Financial Decision-Making" as SFR002
  usecase "SFR004: Request Financial Predictions from the AI Component to Provide Users with Forward-Looking Financial Insights" as SFR004
  
  System --> (SFR002)
  System --> (SFR004)
}

rectangle "AI Features" {
  usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
  usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
  
  System --> (AIFR001)
  System --> (AIFR003)
}

rectangle "User Feedback" {
  usecase "CFR11: Send Feedback about the System's Recommendations and Insights to Help Improve Future Outputs" as CFR11
  Client --> (CFR11)
}
@enduml