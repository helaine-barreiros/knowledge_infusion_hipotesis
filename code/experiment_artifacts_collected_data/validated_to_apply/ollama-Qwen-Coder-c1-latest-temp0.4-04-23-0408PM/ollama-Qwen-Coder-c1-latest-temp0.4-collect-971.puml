@startuml
left to right direction

title Use Case Diagram for AI-Powered Financial Insights System

package Client {
  actor "Client" as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (View)
}

package SystemAdmin {
  actor "System Administrator" as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR020: Manage User Feedback" as SFR020
  
  SA --> (Manage)
}

package FinancialAdvisor {
  actor "Financial Advisor" as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (Manage)
}

package System {
  rectangle "System" {
    usecase "SFR012: Generate Dashboards" as SFR012
    usecase "SFR013: Deliver Alerts" as SFR013
    usecase "SFR014: Request Financial Predictions" as SFR014
    usecase "SFR015: Request Recommendations from AI" as SFR015
    usecase "SFR016: Request Spending Limit Alerts" as SFR016
    usecase "SFR017: Request Investment Opportunity Analysis" as SFR017
    usecase "SFR018: Request Contextualized News Insights" as SFR018
    usecase "SFR021: Generate Client Analytics" as SFR021
    
    (View) --> (Generate)
  }
}

package AI {
  rectangle "AI System" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Identify Suitable Investments" as AIFR005
    usecase "AIFR006: Detect Anomaly Transactions" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "AIFR008: Provide Predictive Intervention Recommendations" as AIFR008
    usecase "AIFR009: Provide Forward-Looking Analysis" as AIFR009
    
    (Generate) --> (Deliver)
  }
}

C -> CFR001 : View Financial Insights Dashboard
C -> CFR002 : Receive Alerts on Anomalous Transactions
C -> CFR003 : View Financial Predictions
C -> CFR004 : Receive Personalized Recommendations
C -> CFR005 : Manage Recommendation Preferences
C -> CFR006 : View Spending Limit Alerts
C -> CFR007 : View Investment Opportunities
C -> CFR008 : View Financial News
C -> CFR009 : Access Personalized Dashboard
C -> CFR10 : Manage Relationship with Financial Advisors

SA -> SAFR001 : Manage Analysis Parameters
SA -> SFR020 : Manage User Feedback

FA -> FAFR001 : Manage Client Mentoring Sessions
FA -> FAFR002 : View Intervention Alerts
FA -> FAFR003 : View Predictive Analytics
FA -> FAFR004 : Configure Analysis Parameters for Client Segments

SFR012 --> (Generate Dashboards)
SFR013 --> (Deliver Alerts)
SFR014 --> AIFR001 : Request Financial Predictions
SFR015 --> AIFR002 : Request Recommendations from AI
SFR016 --> AIFR003 : Request Spending Limit Alerts
SFR017 --> AIFR004 : Request Investment Opportunity Analysis
SFR018 --> AIFR007 : Request Contextualized News Insights

AIFR001 --> SFR012 : Generate Financial Predictions
AIFR002 --> SFR015 : Deliver Recommendations from AI
AIFR003 --> (Generate Spending Limit Alerts)
AIFR004 --> AIFR006 : Request Investment Opportunity Analyses
AIFR007 --> (Deliver Contextualized News Insights)

@enduml