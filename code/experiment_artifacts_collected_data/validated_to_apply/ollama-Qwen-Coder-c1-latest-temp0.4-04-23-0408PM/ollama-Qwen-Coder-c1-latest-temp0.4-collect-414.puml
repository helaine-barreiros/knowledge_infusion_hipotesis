@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR004
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as SAFR005
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as SAFR006
  usecase "CFR005: Manage Personalized Recommendations Preferences" as SAFR007
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as SAFR012
  usecase "CFR008: View News Related to My Investment Portfolio" as SAFR014
  usecase "CFR009: Access a Personalized Dashboard That Consolidates Financial Information in a Single View" as SAFR015
  
  CFR001 --> (SAFR002)
  CFR001 --> (SAFR003)
  CFR001 --> (SAFR004)
  CFR001 --> (SAFR006)
  CFR001 --> (SAFR007)
  CFR001 --> (SAFR012)
  CFR001 --> (SAFR014)
  CFR001 --> (SAFR015)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as SAFR008
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments to Customize the System's Behavior According to Different Client Profiles and Regulatory Requirements Such as GDPR or CCPA" as SAFR12
  
  FinancialAdvisor --> (SAFR003)
  FinancialAdvisor --> (SAFR008)
}

package "System Administrator" {
  actor SysAdmin as SAFR001
  
  usecase "SAFR009: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SAFR016
  
  SysAdmin --> (SAFR009)
}

package "System Components" {
  rectangle System {
    usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance As Defined by Industry Standards Like FINRA Guidelines" as AIFR002
    usecase "AIFR004: Generate Spending Limit Alerts for Users By Identifying Unusual Deviations from Established Spending Patterns" as SAFR17
  
    System --> (SAFR12)
  }
}

package "Feedback Mechanism" {
  actor User as CFR011
  
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as SAFR18
  
  User --> (SAFR18)
}
@enduml