@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FAdvisor

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  
  User --> (CFR001)
  SysAdmin --> (SAFR001)
}

rectangle "Financial Advisor System" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  
  FinancialAdvisor --> (FAFR001)
  FinancialAdvisor --> (FAFR002)
  FinancialAdvisor --> (FAFR003)
}

rectangle "Client Relationship Management System" {
  usecase "CFR005: Manage Personalized Recommendations Preferences" as CFR005
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
  
  User --> (CFR005)
  User --> (CFR010)
}

rectangle "Notification System" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  
  User --> (SFR001)
}

rectangle "Personalized Recommendations System" {
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance" as AIFR002
  
  User --> (SFR002)
}

rectangle "Financial Predictions System" {
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
  
  User --> (SFR003)
}

rectangle "Spending Limit Alerts System" {
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations From Established Spending Patterns" as AIFR003
  
  User --> (SFR005)
}

rectangle "Investment Opportunity Analysis System" {
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  
  User --> (SFR006)
}

rectangle "Investment Opportunities System" {
  usecase "SFR015: Request Specific Investment Opportunities from AI Component That Match User Investment Criteria and ESG Preferences" as SFR015
  usecase "AIFR005: Generate Investment Opportunities for Users by Identifying Financial Instruments That Align With Their Investment Strategies and Modern Portfolio Theory Principles" as AIFR005
  
  User --> (SFR015)
}

rectangle "Anomaly Transaction Alerts System" {
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance With FinCEN Requirements" as AIFR006
  
  User --> (SFR008)
}

rectangle "Contextualized News System" {
  usecase "SFR017: Request Contextualized News Insights from AI Component" as SFR017
  usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News With Specific User Portfolios to Identify Relevant Impacts" as AIFR007
  
  User --> (SFR017)
}

rectangle "Client Predictive Intervention Recommendations System" {
  usecase "SFR015: Request Client Predictive Intervention Recommendations from AI Component" as SFR015
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  
  User --> (SFR015)
}

rectangle "Client Predictive Insights System" {
  usecase "SFR016: Request Client Predictive Insights from AI Component" as SFR016
  usecase "AIFR009: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009
  
  User --> (SFR016)
}

rectangle "Financial Health Reports System" {
  usecase "SFR023: Request Financial Health Reports from AI Component" as SFR023
  usecase "AIFR017: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as AIFR017
  
  User --> (SFR023)
}

rectangle "User Feedback System" {
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights" as CFR11
  
  User --> (CFR11)
}
@enduml