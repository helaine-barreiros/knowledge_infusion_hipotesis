@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure analysis parameters for specific client segments" as FAFR004
  usecase "SFR002: Deliver personalized recommendations to users based on their financial profiles" as SFR002
  usecase "AIFR001: Generate financial predictions for users by analyzing historical transaction data, market trends, and economic indicators" as AIFR001
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> FAFR004
  Sys --> SFR002
  Sys --> AIFR001
}

rectangle "Client Dashboard Features" {
  usecase "CFR009: Access a personalized dashboard that consolidates my financial information in a single view to efficiently monitor my finances." as CFR009
  
  Client --> CFR009
}

rectangle "Alert Management" {
  usecase "SFR013: Generate client alerts based on predefined conditions to ensure timely notification of important financial events." as SFR013
  usecase "AIFR006: Generate anomaly transaction alerts by employing pattern recognition to detect potentially fraudulent activities in compliance with FinCEN requirements." as AIFR006
  
  Client --> SFR013
  SysAdmin --> SAFR001
  FAFD --> FAFR004
}

rectangle "Recommendation Management" {
  usecase "CFR002: Receive alerts about anomalous transactions in my accounts to quickly identify potential fraud or unusual spending patterns according to regulations set by the Financial Action Task Force (FATF)." as CFR002
  usecase "FAFR001: Manage client mentoring sessions based on system-generated insights to provide more valuable guidance aligned with each client's financial goals." as FAFR001
  
  Client --> CFR002
}

rectangle "Investment Management" {
  usecase "CFR007: View investment opportunities suitable to my risk profile (as defined under MiFID II or equivalent standards) to diversify my portfolio and maximize returns." as CFR007
  usecase "FAFR014: Generate client predictive insights that provide forward-looking analysis of financial situations to support more effective financial planning." as FAFR014
  
  Client --> CFR007
}

rectangle "News Management" {
  usecase "CFR008: View news related to my investment portfolio to stay informed about market events that might affect my assets." as CFR008
  
  Client --> CFR008
}

package "Client Relationship Management (CRM)" {
  rectangle "Financial Advisor Functions" {
    usecase "FAFR013: Generate predictive intervention analyses from the AI component to identify when financial advisors should engage with clients." as FAFR013
    
    Financial Advisor --> FAFR013
  }
}

package "System Management" {
  rectangle "Alert Delivery Mechanisms" {
    usecase "SFR008: Find contextualized news relevant to users' financial portfolios from trusted financial news sources." as SFR008
  
    System Admin --> SAFR001
    Financial Advisor --> FAFR004
  }
}

package "AI Functions" {
  rectangle "Prediction and Recommendation Generation" {
    usecase "AIFR002: Generate personalized recommendations for users based on their financial profiles, goals, and risk tolerance as defined by industry standards like FINRA guidelines." as AIFR002
  
    System --> SFR002
  }
}

package "User Feedback Management" {
  rectangle "Feedback Collection" {
    usecase "CFR11: Send feedback about the system's recommendations and insights to help improve the accuracy and relevance of future outputs." as CFR11
    
    Client --> CFR11
  }
}
@enduml