@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as c
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as CFR004
  usecase "CFR005: Manage Personalized Recommendations Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as CFR006
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "CFR009: Access a Personalized Dashboard That Consolidates Financial Information in a Single View" as CFR009
  usecase "CFR010: Manage Relationship with Financial Advisors, Including Permissions for Sharing Data" as CFR010
  
  c --> (CFR001)
  c --> (CFR002)
  c --> (CFR003)
  c --> (CFR004)
  c --> (CFR005)
  c --> (CFR006)
  c --> (CFR007)
  c --> (CFR008)
  c --> (CFR009)
  c --> (CFR010)
}

package "Financial Advisor" {
  actor FinancialAdvisor as fa
  
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts When Patterns Require Professional Attention" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  fa --> (FAFR001)
  fa --> (FAFR002)
  fa --> (FAFR003)
  fa --> (FAFR004)
}

package "System Administrator" {
  actor SystemAdmin as sa
  
  usecase "SAFR001: Manage Analysis Parameters for the AI System" as SAFR001
  usecase "SFR020: Manage User Feedback to Continuously Improve Insights and Recommendations" as SFR020

  sa --> (SAFR001)
  sa --> (SFR020)
}

package "System Components" {
  rectangle System {
    usecase "SFR001: Deliver Alerts Through Appropriate Notification Channels" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations Based on Financial Profiles" as SFR002
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities Matching User Criteria and ESG Preferences" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
    usecase "SFR010: Process Contextualized News to Extract Relevant Information for Users' Situations" as SFR010
    usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
    usecase "SFR012: Generate Client Dashboards in an Intuitive and Actionable Format" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions for Timely Notification of Important Financial Events" as SFR013
    usecase "SFR014: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component for Identifying When Advisors Should Engage with Clients" as SFR015
    usecase "SFR016: Request Predictive Insights From the AI Component to Enhance Financial Guidance Provided to Clients" as SFR016
    usecase "SFR017: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Ratios and Metrics" as SFR017
    usecase "SFR018: Manage User Goals for Tracking Progress and Providing Relevant Recommendations" as SFR018
    usecase "SFR019: Maintain a Historical Record of Users' Insights for Trend Analysis and Effectiveness Measurement" as SFR019
    
    SystemAdmin --> (SAFR001)
    SystemAdmin --> (SFR020)

    FinancialAdvisor --> (FAFR001)
    FinancialAdvisor --> (FAFR002)
    FinancialAdvisor --> (FAFR003)
    FinancialAdvisor --> (FAFR004)

    Client --> (CFR001)
    Client --> (CFR002)
    Client --> (CFR003)
    Client --> (CFR004)
    Client --> (CFR005)
    Client --> (CFR006)
    Client --> (CFR007)
    Client --> (CFR008)
    Client --> (CFR009)
    Client --> (CFR010)

    SystemAdmin <|-- SAFR001
  }
}

package "AI Components" {
  rectangle AI {
    usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Data and Market Trends" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations Based on User Profiles, Goals, and Risk Tolerance" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Patterns" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users Based on Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
    usecase "AIFR005: Identify Suitable Investments Aligning with User Strategies and Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance With FinCEN Requirements" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Provide Forward-Looking Analysis of Financial Situations to Support More Effective Planning and Decision-Making" as AIFR009

    System --> (SFR001)
    System --> (SFR002)
    System --> (SFR003)
    System --> (SFR004)
    System --> (SFR005)
    System --> (SFR006)
    System --> (SFR007)
    System --> (SFR008)
    System --> (SFR009)
    System --> (SFR010)
    System --> (SFR011)
    System --> (SFR012)
    System --> (SFR013)
    System --> (SFR014)
    System --> (SFR015)
    System --> (SFR016)
    System --> (SFR017)
    System --> (SFR018)
    System --> (SFR019)

    FinancialAdvisor --> (FAFR003)
    FinancialAdvisor --> (AIFR004)
    
    Client --> (CFR002)
    Client --> (CFR006)
  }
}

@enduml