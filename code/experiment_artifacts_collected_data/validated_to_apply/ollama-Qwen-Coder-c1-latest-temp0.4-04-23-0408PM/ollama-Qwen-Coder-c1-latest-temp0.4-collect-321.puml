@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006

  rectangle "Dashboard Views" {
    usecase "CFR009: Access Personalized Dashboard" as CFR009
    usecase "SAFR001: Manage Analysis Parameters" as SAFR002
    Client --> CFR009
    SysAdmin --> SAFR002
  }

  rectangle "Alerts and Notifications" {
    usecase "SFR003: Deliver Alerts to Users" as SFR003
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR007
    Client --> SFR003
  }

  rectangle "Recommendations and Insights" {
    usecase "CFR004: Receive Personalized Recommendations" as CFR004
    usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR004
    Client --> CFR004
    SysAdmin --> SAFR001

    rectangle "Recommendation Preferences Management" {
      usecase "CFR005: Manage Recommendation Preferences" as CFR005
      Client --> CFR005
    }

  }

  rectangle "Spending Limits and Budgeting" {
    usecase "CFR012: View Spending Limit Alerts" as CFR012
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR008
    Client --> CFR012

    rectangle "Investment Opportunities" {
      usecase "CFR014: View Investment Opportunities Suitable to My Risk Profile" as CFR014
      usecase "AIFR005: Generate Investment Opportunity Analyses for Users" as AIFR009
      Client --> CFR014

    }

  }

  rectangle "Financial Predictions and Insights" {
    usecase "CFR013: View Financial Predictions Based on My Historical Data and Current Market Trends" as CFR013
    usecase "AIFR002: Generate Personalized Recommendations for Users based on their financial profiles, goals, and risk tolerance" as AIFR010
    Client --> CFR013

  }

  rectangle "News and Information" {
    usecase "CFR015: View News Related to My Investment Portfolio" as CFR015
    usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR011
    Client --> CFR015

  }

}

Client -> (CFR009)
SysAdmin -> SAFR002
FAFR001 -> FAFR002
AIFR006 <|-- SFR003
SFR004 <|-- AIFR002
AIFR008 <|-- CFR012
AIFR009 <|-- CFR014
AIFR010 <|-- CFR013
AIFR011 <|-- CFR015

@enduml