@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  SA --> (SAFR001)
}

rectangle "System" {
  package "Financial Insights" {
    usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    usecase "SFR017: Generate Financial Health Reports" as SFR017
    
    C --> (SFR002)
    SA --> (SFR003)
    FA --> (SFR004)
    C --> (SFR017)
  }
  
  package "Alerts and Notifications" {
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
    
    C --> (SFR005)
    FA --> (SFR006)
    C --> (SFR013)
  }
  
  package "News and Insights" {
    usecase "SFR008: Request Contextualized News from AI Component" as SFR008
    usecase "SFR009: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR009
    
    C --> (SFR008)
    FA --> (SFR009)
  }
  
  package "Predictive Analytics and Intervention" {
    usecase "SFR15: Request Predictive Intervention Analyses from AI Component" as SFR15
    usecase "SFR16: Request Predictive Insights from AI Component to Enhance the Value of Financial Guidance Provided to Clients" as SFR16
    
    FA --> (SFR15)
    FA --> (SFR16)
  }
  
  package "User Management and Feedback" {
    usecase "AIFR012: Generate Client Dashboards that Present Financial Information in an Intuitive and Actionable Format" as AIFR012
    usecase "CFR11: Send Feedback about System's Recommendations and Insights to Help Improve Accuracy and Relevance of Future Outputs" as CFR11
    
    C --> (AIFR012)
    C --> (CFR11)
  }
}

@enduml