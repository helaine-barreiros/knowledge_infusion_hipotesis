@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFD002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004

  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> FAFD002
}

rectangle "Client Dashboard Features" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "SAFR005: Manage Recommendations Preferences" as SAFR005
  usecase "AIFR017: Generate Financial Health Reports" as AIFR017

  Client --> CFR009
  SysAdmin --> SAFR005
}

rectangle "Financial Alerts and Notifications" {
  usecase "SFR013: Request Client Alerts Based on Predefined Conditions" as SFR013
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006

  Client --> SFR013
}

rectangle "Financial Recommendations and Insights" {
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFD001

  Client --> CFR004
  Financial Advisor --> FAFD001
}

rectangle "Spending Limits and Investment Opportunities" {
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds in Specific Expense Categories" as CFR006
  usecase "FAFR007: Configure Analysis Parameters for Specific Client Segments to Customize System Behavior According to Different Profiles" as FAFD003

  Client --> CFR006
}

rectangle "Investment Opportunities and News" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile (as Defined Under MiFID II or Equivalent Standards)" as CFR007
  usecase "FAFR012: Request Contextualized News Insights from AI Component to Identify Potential Impacts on Users' Investments" as FAFD012

  Client --> CFR007
}

rectangle "User Feedback and Continuous Improvement" {
  usecase "CFR11: Send Feedback About System's Recommendations and Insights" as CFR11

  User -> (Client, Financial Advisor, or SysAdmin) : CFR11
}
@enduml