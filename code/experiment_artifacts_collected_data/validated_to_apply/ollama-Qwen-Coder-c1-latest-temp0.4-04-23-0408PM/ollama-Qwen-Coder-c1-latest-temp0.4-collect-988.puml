@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FinancialAdvisor
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  usecase "CFR011: Send Feedback about System Recommendations and Insights" as CFR011

  Client --> CFR001
  Client --> FAFR002
  SysAdmin --> SAFR001
}

rectangle "Financial Advisor Module" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003

  FinancialAdvisor --> FAFR001
  FinancialAdvisor --> FAFR002
}

rectangle "System Notification Module" {
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006

  System --> FAFR002
}

rectangle "System Recommendation Module" {
  usecase "SFR007: Request Specific Investment Opportunities from AI Component That Match User Investment Criteria and ESG Preferences" as SFR007
  usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001

  System --> FAFR002
}

rectangle "System News Module" {
  usecase "SFR008: Request Contextualized News Relevant to Users' Financial Portfolios from Trusted Financial News Sources" as SFR008
  usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007

  System --> FAFR002
}

rectangle "System Analytics Module" {
  usecase "SFR14: Generate Client Analytics That Provide Meaningful Insights into Financial Behavior and Performance" as SFR14
  usecase "AIFR09: Generate Client Predictive Insights that Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR09

  System --> FAFR02
}

rectangle "System Reporting Module" {
  usecase "SFR17: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR17

  System --> FAFR02
}

@enduml