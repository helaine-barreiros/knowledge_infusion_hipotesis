@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFD001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  
  rectangle "Client Use Cases" {
    Client --> CFR001 : "View Financial Insights Dashboard"
    Client --> SAFR005 : "Manage personalized recommendations preferences"
    Client --> SFR009 : "Access a personalized dashboard that consolidates my financial information in a single view"
    Client --> FAFD002 : "Receive alerts about anomalous transactions in my accounts"
  }
  
  rectangle "Financial Advisor Use Cases" {
    FinancialAdvisor --> SAFR001 : "Manage Analysis Parameters for the AI system"
    FinancialAdvisor --> AIFR004 : "Generate investment opportunity analyses for users by evaluating potential investments against their risk profiles, time horizons, and financial goals."
    FinancialAdvisor --> FAFD002 : "View client intervention alerts when the system detects patterns requiring professional attention to proactively assist clients with potential financial issues"
  }
  
  rectangle "System Use Cases" {
    SystemAdmin --> SAFR001 : "Manage Analysis Parameters for the AI system"
    
    Sys --> SFR003 : "Request Financial Predictions from the AI component"
    Sys --> AIFR002 : "Generate Personalized Recommendations for Users based on their financial profiles, goals, and risk tolerance as defined by industry standards like FINRA guidelines."
    Sys --> SAFR005 : "Manage personalized recommendations preferences"
    
    Sys --> SFR004 : "Request Personalized Recommendations from the AI component based on each user's financial data and preferences"
    Sys --> AIFR003 : "Generate Spending Limit Alerts for Users by Identifying Unusual Deviations From Established Spending Patterns."
    
    Sys --> SFR016 : "Request Predictive Insights from the AI Component to Enhance the Value of Financial Guidance Provided to Clients."
    Sys --> FAFD002 : "View Client Intervention Alerts When the System Detects Patterns Requiring Professional Attention to Proactively Assist Clients With Potential Financial Issues"
    
    Sys --> SFR13 : "Generate Client Analytics That Provide Meaningful Insights Into Financial Behavior and Performance."
    Sys --> AIFR004 : "Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, And Financial Goals."
  }
  
  rectangle "Feedback Mechanism" {
    usecase "CFR11: Send Feedback About System's Recommendations and Insights" as CFR11
    
    Client --> CFR11 : "Send feedback about the system's recommendations and insights"
    FinancialAdvisor --> CFR11 : "Send feedback about the system's recommendations and insights"
    SysAdmin --> CFR11 : "Send feedback about the system's recommendations and insights"
  }
}

@enduml