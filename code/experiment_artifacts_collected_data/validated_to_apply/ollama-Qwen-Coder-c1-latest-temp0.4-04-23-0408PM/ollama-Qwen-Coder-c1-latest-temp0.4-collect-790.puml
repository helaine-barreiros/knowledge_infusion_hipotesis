@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive FATF Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: Receive Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SysAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  SA --> (SAFR001)
}

rectangle "AI System" {
  package "Recommendations and Insights Generation" {
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  }
  
  package "Predictive Insights and Intervention Recommendations" {
    usecase "AIFR008: Generate Predictive Interventions" as AIFR008
    usecase "AIFR016: Generate Client Predictive Insights" as AIFR016
  }
  
  package "Data Analysis and Reporting" {
    usecase "SFR020: Manage User Feedback" as SFR020
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "SFR13: Generate Client Alerts Based on Predefined Conditions" as SFR13
  }
}

package "Notifications and Dashboards" {
  usecase "SFR012: Generate Financial Health Reports" as SFR012
  usecase "AIFR017: Generate Predictive Analytics for User Behavior" as AIFR017
  usecase "SFR19: Maintain Historical Record of Insights" as SFR19
}

package "AI Component Requests" {
  usecase "SFR03: Request Financial Predictions from AI" as SFR03
  usecase "SFR04: Request Personalized Recommendations from AI" as SFR04
  usecase "SFR05: Request Spending Limit Alerts from AI" as SFR05
  usecase "SFR06: Request Investment Opportunity Analysis from AI" as SFR06
  usecase "AIFR013: Generate Client Predictive Insights for Advisors" as AIFR013
}

package "System Functions" {
  usecase "SFR07: Request Specific Investment Opportunities Matching User Criteria and ESG Preferences" as SFR07
  usecase "SFR08: Request Anomaly Transaction Alerts from AI" as SFR08
  usecase "AIFR019: Generate Client Predictive Intervention Recommendations for Advisors" as AIFR019
}

package "User Feedback and Improvement" {
  usecase "CFR11: Send System Feedback" as CFR11
  
  C --> (CFR11)
  FA --> (CFR11)
  SA --> (CFR11)
}
@enduml