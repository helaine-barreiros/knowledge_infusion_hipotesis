@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
  
  usecase "CFR11: Send Feedback" as CFR11
  
  C --> (System) : CFR11
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  
  FA --> (System) : FAFR001
  FA --> (System) : FAFR002
  FA --> (System) : FAFR003
  
  usecase "FAFR04: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (System) : FAFR004
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SA --> (System) : SAFR001
}

rectangle "AI Component" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Based on Strategies and MPT Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  usecase "AIFR008: Generate Predictive Intervention Recommendations for Clients" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  (System) --> AIFR001 : Request Financial Predictions
  (System) --> AIFR002 : Request Personalized Recommendations
  (System) --> AIFR003 : Request Spending Limit Alerts
  (System) --> AIFR004 : Request Investment Opportunity Analyses
  (System) --> AIFR005 : Request Matching Investment Opportunities with User Criteria and ESG Preferences
  (System) --> AIFR006 : Request Anomaly Transaction Alerts
  (System) --> AIFR007 : Request Contextualized News Insights
  (System) --> AIFR008 : Request Predictive Intervention Recommendations for Clients
  (System) --> AIFR009 : Request Client Predictive Insights
  
}

rectangle "Notification System" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  
  (System) --> SFR001 : Request Alerts Delivery
}

package "User Interface" {
  usecase "SFR12: Generate Client Dashboards" as SFR12
  usecase "SFR13: Generate Client Alerts Based on Conditions" as SFR13
  usecase "SFR14: Generate Client Analytics for Insights" as SFR14
  
  (System) --> SFR12 : Request Dashboard Generation
  (System) --> SFR13 : Request Alert Generation
  (System) --> SFR14 : Request Analytics Generation
}

package "Predictive Interventions" {
  usecase "SFR15: Request Predictive Intervention Analyses for Clients" as SFR15
  usecase "SFR16: Generate Client Predictive Insights to Enhance Guidance" as SFR16
  
  (System) --> SFR15 : Request Predictive Interventions
  (System) --> SFR16 : Request Predictive Insights for Enhancement
}

package "Financial Health Reports" {
  usecase "SFR17: Generate Financial Health Reports Based on Ratios and Metrics" as SFR17
  
  (System) --> SFR17 : Request Financial Health Report Generation
}

package "Goal Management" {
  usecase "SFR18: Manage Users' Financial Goals to Track Progress" as SFR18
  
  (System) --> SFR18 : Request Goal Tracking and Recommendations
}

package "Historical Record Maintenance" {
  usecase "SFR19: Maintain Historical Records of Insights for Trend Analysis" as SFR19
  
  (System) --> SFR19 : Request Historical Record Management
}

package "User Feedback Handling" {
  usecase "SFR20: Manage User Feedback to Improve System Outputs" as SFR20
  
  (System) --> SFR20 : Request Feedback Management
}
@enduml