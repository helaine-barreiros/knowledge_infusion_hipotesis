@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAdvisor
:User: as User

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR005: Manage Analysis Parameters Preferences" as SAFR005
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  
  Client --> CFR001
  SysAdmin --> SAFR005
  FAdvisor --> FAFR004
  User --> (SFR002)
}

rectangle "Client Dashboard Features" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  
  Client --> CFR009
}

rectangle "Alerts and Notifications" {
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  
  Client --> (SAFR001)
  SysAdmin --> (SAFR001)
  User --> (SFR008)
}

rectangle "Financial Predictions and Recommendations" {
  usecase "CFR003: View Financial Predictions Based on Historical Data" as CFR003
  usecase "FAFR002: View Client Intervention Alerts When System Detects Patterns Requiring Professional Attention" as FAFR002
  
  Client --> (SFR014)
  SysAdmin --> (SAFR001)
  User --> (FAFR002)
}

rectangle "Investment Opportunities and News" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "SFR008: Request Contextualized News Relevant to Users' Financial Portfolios from Trusted Financial News Sources" as SFR013
  
  Client --> (FAFR006)
  SysAdmin --> (SAFR001)
  User --> (SFR013)
}

rectangle "Client Relationship Management" {
  usecase "CFR10: Manage My Relationship with Financial Advisors Including Permissions for Sharing My Financial Data" as CFR10
  
  Client --> (FAFR010)
}

@enduml