@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor (FA): as FA
:User: as User

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  
  Client --> (CFR001)
  SysAdmin --> (SAFR001, CFR005)
  FA --> (FAFR002, FAFR003, SAFR004)
  User --> (SFR009, SFR018, AIFR007)
}

rectangle "Financial Insights" {
  usecase "CFR002: View Alerts for Anomalous Transactions" as CFR002
  usecase "SAFR003: Request Predictive Analytics" as SAFR003
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  
  Client --> (CFR002)
}

rectangle "Personalized Recommendations" {
  usecase "SAFR004: Configure Analysis Parameters for Specific Segments" as SAFR004
  usecase "AIFR005: Generate Investment Opportunities Based on Risk Profiles" as AIFR005
  
  Client --> (CFR003, CFR019)
}

rectangle "Spending Limits and Budget Control" {
  usecase "SAFR002: Request Spending Limit Alerts" as SAFR002
  usecase "AIFR004: Generate Spending Limit Alerts for Users" as AIFR004
  
  Client --> (CFR006)
}

rectangle "Investment Opportunities and Diversification" {
  usecase "FAFR007: View Investment Opportunities Suitable to Risk Profile" as FAFR007
  usecase "AIFR002: Generate Personalized Recommendations for Users Based on Financial Profiles, Goals, and Risk Tolerance" as AIFR002
  
  Client --> (CFR007)
}

rectangle "News and Market Updates" {
  usecase "FAFR008: View News Related to Investment Portfolio" as FAFR008
  usecase "AIFR010: Generate Contextualized News Insights for Users' Financial Situations" as AIFR010
  
  Client --> (CFR008)
}

rectangle "Client Relationship Management" {
  usecase "SAFR005: Manage Personalized Recommendations Preferences" as SAFR005
  usecase "FAFR009: Configure Analysis Parameters for Specific Segments Based on Regulatory Requirements" as FAFR009
  
  Client --> (CFR10)
}

rectangle "Feedback and Continuous Improvement" {
  usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
  usecase "SAFR002: Request Predictive Insights from AI Component to Enhance Financial Guidance" as SAFR006
  
  Client --> (CFR11)
}

@enduml