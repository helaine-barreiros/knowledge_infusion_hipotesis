@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003 
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as SAFR004
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as SAFR005
  usecase "CFR006: Manage Personalized Recommendations Preferences to Ensure Insights Relevant to My Financial Objectives and Risk Tolerance" as CFR012
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as SAFR008 
  usecase "CFR009: Access a Consolidated Dashboard of Personalized Financial Information in One Place" as SFR012
  
  CFR001 --> SAFR003
  CFR001 --> SAFR004
  CFR001 --> SAFR005
  CFR001 --> CFR012
  CFR001 --> SAFR008 
  CFR001 --> SFR012
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations" as AIFR009
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments to Customize the System's Behavior According to Different Client Profiles and Regulatory Requirements Such As GDPR or CCPA" as SAFR018
  
  FAFR001 --> AIFR009
  FAFR001 --> SAFR018
}

package "System Administrator" {
  actor SysAdmin as SAFR001
  
  usecase "SAFR002: Manage Analysis Parameters for the AI System to Ensure Algorithms Remain Accurate, Relevant, and Compliant with Financial Regulations Such As Basel III for Risk Management" as SAFR006
  usecase "SFR003: Deliver Personalized Recommendations to Users Based on Their Financial Profiles to Support Better Financial Decision-Making" as SFR014
  
  SysAdmin --> SAFR006
  SysAdmin --> SFR014
}

package "System" {
  rectangle System {
    usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles to Support Better Financial Decision-Making" as AIFR002 
    usecase "SFR003: Request Financial Predictions from the AI Component to Provide Users with Forward-Looking Financial Insights" as SFR017
    usecase "SFR004: Request Personalized Recommendations from the AI Component Based on Each User's Financial Data and Preferences" as AIFR002 
    usecase "SFR005: Request Spending Limit Alerts From the AI Component When User Spending Patterns Exceed Defined Thresholds" as AIFR003
    usecase "SFR006: Request Investment Opportunity Analysis from the AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles" as AIFR004 
    usecase "SFR007: Request Specific Investment Opportunities From the AI Component That Match User Investment Criteria and ESG (Environmental, Social, and Governance) Preferences" as AIFR015
    usecase "SFR008: Request Anomaly Transaction Alerts from the AI Component to Detect Potentially Fraudulent Activities in Accordance with AML Regulations" as AIFR006 
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios From Trusted Financial News Sources" as SFR12
    usecase "SFR010: Process Contextualized News To Extract Relevant Information for Users' Financial Situations" as AIFR07 
    usecase "SFR013: Request Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR02
    usecase "SFR014: Generate Client Analytics That Provide Meaningful Insights Into Financial Behavior and Performance" as AIFR09 
    usecase "AIFR015: Request Predictive Intervention Analyses from the AI Component to Identify When Financial Advisors Should Engage With Clients" as SFR02
    usecase "SFR016: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as AIFR08 
  }
}

package "AI System" {
  rectangle AI {
    usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as SAFR02
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users Based on Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR16 
  }
}

package "User (Client, Financial Advisor, or System Administrator)" {
  actor User as CFR011
  
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as SFR20
  user --> SFR20
}
@enduml