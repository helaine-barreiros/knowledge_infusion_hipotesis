@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  usecase "CFR011: Send Feedback about System Recommendations and Insights" as CFR011
  
  Client --> (SAFR001)
  Client --> (FAFR002)
  Client --> (SFR003)
  Client --> (AIFR004)
  
  SysAdmin --> SAFR001
  FinancialAdvisor --> FAFR002
}

rectangle "Client" {
  usecase "CFR002: View Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Current Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as CFR004
  usecase "SAFR005: Manage Personalized Recommendations Preferences" as SAFR005
  
  Client --> (CFR002)
  Client --> (CFR003)
  Client --> (CFR004)
  Client --> (SAFR005)
}

rectangle "Financial Advisor" {
  usecase "FAFR01: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR01
  usecase "FAFR02: View Predictive Analytics About Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as FAFR03
  
  FinancialAdvisor --> (FAFR01)
  FinancialAdvisor --> (FAFR03)
}

rectangle "System Components" {
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios from Trusted Financial News Sources" as SFR009
  usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
  
  System --> (SFR009)
  System --> (AIFR007)
}

@enduml