@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (SAFR002)
  C --> (SFR013)
  C --> (AIFR007)
  
  C -> (CFR001) : "View"
  C -> (CFR002) : "Receive Alerts"
  C -> (CFR003) : "Predictions"
  C -> (CFR004) : "Recommendations"
  C -> (CFR005) : "Manage Preferences"
  C -> (CFR006) : "Spending Limits"
  C -> (CFR007) : "Investment Opportunities"
  C -> (CFR008) : "News"
  C -> (CFR009) : "Dashboard"
  C --(CFR11): "Send Feedback"
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (SFR016)
  
  FA -> (FAFR001) : "Manage Sessions"
  FA -> (FAFR002) : "View Alerts"
  FA -> (FAFR003) : "Predictive Analytics"
  FA --(FAFR04): "Configure Parameters"
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR020": "Manage User Feedback"
  
  SA --> (AIFR003)
  
  SA -> (SAFR001) : "Manage Parameters"
  SA --(SFR20): "Feedback Management"
}

package "System" {
  rectangle System as Sys
  
  usecase "SFR001: Deliver Alerts" as SFR001
  usecase "SFR002": "Deliver Personalized Recommendations"
  usecase "SFR003": "Request Financial Predictions"
  usecase "SFR004": "Request Personalized Recommendations"
  usecase "SFR005": "Request Spending Limit Alerts"
  usecase "SFR006": "Request Investment Opportunity Analysis"
  usecase "SFR007": "Request Specific Investment Opportunities"
  usecase "SFR008": "Request Anomaly Transaction Alerts"
  usecase "SFR009": "Find Contextualized News Relevant to Portfolio"
  usecase "SFR010": "Process Contextualized News"
  usecase "SFR011": "Request Contextualized News Insights"
  usecase "SFR012": "Generate Client Dashboards"
  usecase "SFR013": "Generate Client Alerts Based on Conditions"
  usecase "SFR014": "Generate Client Analytics"
  usecase "SFR015": "Request Predictive Intervention Analyses"
  usecase "SFR016": "Enhance Financial Guidance Value"
  usecase "SFR017": "Generate Financial Health Reports"
  usecase "SFR018": "Manage Users' Financial Goals"
  usecase "SFR019": "Maintain Historical Record of Insights"
  usecase "SFR020": "Manage User Feedback"

  Sys --> (AIFR003)
  
  Sys -> (SFR001) : "Deliver Alerts"
  Sys -> (SFR002) : "Personalized Recommendations"
  Sys -> (SFR003) : "Financial Predictions"
  Sys -> (SFR004) : "Recommendations"
  Sys -> (SFR005) : "Spending Limit Alerts"
  Sys -> (SFR006) : "Investment Opportunity Analysis"
  Sys -> (SFR007) : "Specific Investment Opportunities"
  Sys -> (SFR008) : "Anomaly Transaction Alerts"
  Sys -> (SFR009) : "Contextualized News Relevant to Portfolio"
  Sys -> (SFR010) : "Process Contextualized News"
  Sys -> (SFR011) : "News Insights from AI Component"
  Sys -> (SFR012) : "Client Dashboards"
  Sys -> (SFR013) : "Alerts Based on Conditions"
  Sys -> (SFR014) : "Analytics for Financial Behavior"
  Sys -> (SFR015) : "Predictive Intervention Analyses"
  Sys --> (AIFR006)
  Sys --(SFR20): "Feedback Management"
}

@enduml