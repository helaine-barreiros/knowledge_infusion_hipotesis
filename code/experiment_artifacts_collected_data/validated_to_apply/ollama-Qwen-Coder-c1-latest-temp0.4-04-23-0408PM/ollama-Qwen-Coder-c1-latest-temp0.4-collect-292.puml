@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
}

package "System Administrator" {
  actor SysAdmin as SAFR003
}

rectangle "System" {
  usecase "CFR004: View Personalized Recommendations" as SFR001
  usecase "SAFR005: Manage Analysis Parameters Preferences" as CFR008
  usecase "FAFR002: View Client Intervention Alerts" as SAFR007
  
  CFR001 --> (CFR004)
  FAFR002 --> (FAFR002)
  SysAdmin --> (SAFR005)
}

rectangle "Alerts & Notifications" {
  usecase "SFR003: Deliver Alerts to Users" as SFR003
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as SAFR012
  
  CFR001 --> (SFR003)
  FAFR002 --> (SAFR012)
}

rectangle "Predictive Analytics & Insights" {
  usecase "FAFR004: View Predictive Analytics About Clients' Financial Situations" as SAFR015
  usecase "AIFR009: Generate Client Predictive Intervention Recommendations" as AIFR008
  
  CFR001 --> (FAFR004)
  FAFR002 --> (SAFR015)
}

rectangle "News & Information" {
  usecase "CFR008: View News Related to Investment Portfolio" as SFR009
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  
  CFR001 --> (SFR009)
}

rectangle "Dashboards & Management" {
  usecase "CFR002: View Alerts About Anomalous Transactions" as SAFR008
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  
  CFR001 --> (SAFR008)
}

rectangle "Investment Opportunities & Recommendations" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as SAFR016
  usecase "AIFR004: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance" as AIFR002
  
  CFR001 --> (CFR007)
}

rectangle "Feedback & Improvement" {
  actor User as CFR011
  usecase "SFR020: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR020
  
  CFR011 --> (SFR020)
}
@enduml