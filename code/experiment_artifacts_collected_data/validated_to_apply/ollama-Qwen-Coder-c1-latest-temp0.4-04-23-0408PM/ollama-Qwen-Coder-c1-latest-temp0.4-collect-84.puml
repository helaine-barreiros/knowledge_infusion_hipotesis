@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  SA --> (SAFR001)
}

rectangle "AI Component" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Based on Modern Portfolio Theory" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  C --> (SFR012)
  FA --> (SFR016)
  SA --> (SAFR001)
  
  SFR003 <|-- (AIFR004)
  SFR005 <|-- (AIFR003)
  SFR007 <|-- (AIFR008)
  SFR009 <|-- (AIFR001)
  
  C --> (SFR020)
}

rectangle "System" {
  usecase "SFR001: Deliver Alerts to Users Through Appropriate Notification Channels" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations Based on Financial Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts From AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis From AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Based on User Preferences and ESG Criteria" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios From Trusted Sources" as SFR009
  usecase "SFR10: Process Contextualized News To Extract Relevant Information for Users' Financial Situations" as SFR010
  usecase "SFR11: Request Contextualized News Insights from AI Component to Identify Potential Impacts on User Investments" as SFR011
  usecase "SFR12: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as SFR012
  usecase "SFR13: Generate Client Alerts Based On Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR013
  usecase "SFR14: Generate Client Analytics That Provide Meaningful Insights Into Financial Behavior and Performance" as SFR014
  usecase "SFR15: Request Predictive Intervention Analyses From AI Component to Identify When Financial Advisors Should Engage With Clients" as SFR015
  usecase "SFR16: Request Predictive Insights from AI Component To Enhance the Value of Financial Guidance Provided to Clients" as SFR016
  usecase "SFR17: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR017
  usecase "SFR18: Manage User Feedback To Continuously Improve the Quality and Relevance of Financial Insights" as SFR020
  
  C --> (SFR003)
  FA --> (SFR006)
  SA --> (SAFR001)
  
  SFR005 <|-- (AIFR003)
  SFR007 <|-- (AIFR004)
  SFR009 <|-- (AIFR008)
  SFR12 <|-- (SFR002)
}

C --> (CFR11)
FA --> (FAFR01)
SA --> (SFR013)

@enduml