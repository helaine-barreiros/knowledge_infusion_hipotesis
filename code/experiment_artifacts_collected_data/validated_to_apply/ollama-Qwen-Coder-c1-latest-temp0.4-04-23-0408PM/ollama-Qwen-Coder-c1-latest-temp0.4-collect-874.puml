@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to My Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  Client --> (SFR02) : "View Alerts"
  Client --> (SFR04) : "Receive Recommendations"
  Client --> (SFR03) : "Request Predictions"
  Client --> (SFR05) : "Manage Preferences"
  Client --> (SFR06) : "Check Spending Limits"
  Client --> (SFR07) : "View Investment Opportunities"
  Client --> (SFR10) : "Access News and Insights"
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FinancialAdvisor --> (SFR16) : "Enhance Guidance"
  FinancialAdvisor --> (AIFR009) : "Generate Predictive Insights"
  FinancialAdvisor --> (FAFR002) : "View Alerts"
}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters for the AI System" as SAFR001
  usecase "SFR18": "Manage Users' Financial Goals" : : 
  usecase "SFR19": "Maintain Historical Record of Insights"
  
  SystemAdmin --> (AIFR002) : "Generate Recommendations"
  SystemAdmin --> (SAFR001) : "Configure Parameters"
}

rectangle "System" {
  usecase "SFR01: Deliver Alerts to Users Through Appropriate Notification Channels" as SFR01
  usecase "SFR03: Request Financial Predictions from the AI Component" as SFR03
  usecase "SFR04: Request Personalized Recommendations from the AI Component" as SFR04
  usecase "SFR05: Request Spending Limit Alerts from the AI Component" as SFR05
  usecase "SFR06: Request Investment Opportunity Analysis from the AI Component" as SFR06
  usecase "SFR07: Request Specific Investment Opportunities from the AI Component Matching User Criteria and ESG Preferences" as SFR07
  usecase "SFR08: Request Anomaly Transaction Alerts from the AI Component to Detect Potentially Fraudulent Activities in Accordance with AML Regulations" as SFR08
  usecase "SFR09: Find Contextualized News Relevant to Users' Financial Portfolios From Trusted Financial News Sources" as SFR09
  usecase "SFR10: Process Contextualized News To Extract Relevant Information for Users' Financial Situations" as SFR10
  usecase "SFR11: Request Contextualized News Insights from the AI Component to Identify Potential Impacts on Users' Investments" as SFR11
  usecase "SFR12": Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format : :
  usecase "SFR13": Generate Client Alerts Based On Predefined Conditions To Ensure Timely Notification of Important Financial Events : :
  usecase "SFR14": Generate Client Analytics That Provide Meaningful Insights Into Financial Behavior And Performance : :
  usecase "SFR15: Request Predictive Intervention Analyses from the AI Component to Identify When Financial Advisors Should Engage with Clients" as SFR15
  usecase "SFR17": Generate Financial Health Reports that Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics : :
  
  System --> (AIFR006) : "Generate Alerts"
  System --> (AIFR002) : "Provide Recommendations"
  System --> (AIFR017) : "Assess Health Reports"
}

rectangle "AI System" {
  usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
  usecase "AIFR02: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance As Defined By Industry Standards Like FINRA Guidelines" as AIFR002
  usecase "AIFR03: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
  usecase "AIFR04: Generate Investment Opportunity Analyses for Users By Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  usecase "AIFR05: Generate Investment Opportunities for Users by Identifying Financial Instruments That Align With Their Investment Strategies and Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR06: Generate Anomaly Transaction Alerts By Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
  usecase "AIFR07: Generate Contextualized News Insights by Correlating Financial News With Specific User Portfolios To Identify Relevant Impacts" as AIFR007
  usecase "AIFR08: Generate Client Predictive Intervention Recommendations By Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  
  AI --> (SFR16) : "Enhance Guidance"
  AI --> (FAFR002) : "Generate Alerts"
}

rectangle "User Feedback Loop" {
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights to Help Improve Future Outputs" as CFR11
  
  Client --> (SFR20) : "Provide Feedback"
  FinancialAdvisor --> (AIFR09) : "Improve Predictive Insights"
  SystemAdmin --> (SAFR001) : "Adjust Parameters Based on Feedback"
}

@enduml