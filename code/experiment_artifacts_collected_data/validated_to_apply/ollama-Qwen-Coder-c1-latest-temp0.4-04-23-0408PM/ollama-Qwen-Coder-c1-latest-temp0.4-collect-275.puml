@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004

  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> FAFR002
  Sys --> (SFR003)
  Sys --> (AIFR004)

}

rectangle "Client Features" {
  usecase "CFR002: View Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10

  Client --> (CFR002)
  Client --> (CFR003)
  Client --> (CFR004)
  Client --> (CFR005)
  Client --> (CFR006)
  Client --> (CFR007)
  Client --> (CFR008)
  Client --> (CFR009)
  Client --> (CFR10)

}

rectangle "Financial Advisor Features" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003

  FinancialAdvisor --> (FAFR001)
  FinancialAdvisor --> (FAFR002)
  FinancialAdvisor --> (FAFR003)

}

rectangle "System Features" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
  usecase "SFR006: Request Spending Limit Alerts from AI" as SFR006
  usecase "SFR007: Request Investment Opportunity Analysis from AI" as SFR007
  usecase "SFR10: Process Contextualized News to Extract Information for Users" as SFR10

  System --> (SFR001)
  System --> (SFR002)
  System --> (SFR003)
  System --> (SFR004)
  System --> (SFR005)
  System --> (SFR006)
  System --> (SFR007)
  System --> (SFR10)

}

rectangle "AI Features" {
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003

  System --> (AIFR001)
  System --> (AIFR002)
  System --> (AIFR004)
  System --> (AIFR005)
  System --> (AIFR006)

}

rectangle "User Feedback" {
  usecase "CFR11: Send Feedback about Recommendations and Insights" as CFR11

  Client --> (CFR11)
  FinancialAdvisor --> (CFR11)
  SysAdmin --> (CFR11)

}
@enduml