  Sys --> SFR014 : "Generate Analytics"
  Sys --> SFR015 : "Request Predictive Interventions"
  Sys --> SFR016 : "Request Insights"
  Sys --> SFR017 : "Generate Reports"
  Sys --> SFR018 : "Manage Goals"
  Sys --> SFR019 : "Maintain Record"
  Sys --> SFR020 : "Manage Feedback"
