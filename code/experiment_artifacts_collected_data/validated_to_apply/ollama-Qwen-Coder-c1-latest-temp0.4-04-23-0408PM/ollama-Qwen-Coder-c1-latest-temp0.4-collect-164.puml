@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  usecase "CFR011: Send Feedback about System Recommendations and Insights" as CFR011
  
  Client --> (SAFR001)
  Client --> (FAFR002)
  Client --> (SFR003)
  Client --> (AIFR001)
  Client --> (CFR011)

  SysAdmin --> SAFR001
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  
  FinancialAdvisor --> (FAFR001)
  FinancialAdvisor --> (SFR004)
  FinancialAdvisor --> (AIFR002)
}

rectangle "System Components" {
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
  
  System --> (SFR005)
  System --> (AIFR003)

  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  
  System --> (SFR006)
  System --> (AIFR004)

  usecase "SFR007: Request Specific Investment Opportunities from AI Component That Match User Investment Criteria and ESG Preferences" as SFR007
  usecase "AIFR005: Generate Investment Opportunities for Users by Identifying Financial Instruments that Align with Their Investment Strategies and Modern Portfolio Theory Principles" as AIFR005
  
  System --> (SFR007)
  System --> (AIFR005)

  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component to Detect Potentially Fraudulent Activities in Accordance with FinCEN Requirements" as SFR008
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance With FinCEN Requirements" as AIFR006
  
  System --> (SFR008)
  System --> (AIFR006)

  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios from Trusted Financial News Sources" as SFR009
  usecase "SFR10: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR10
  
  System --> (SFR009)
  System --> (SFR10)

  usecase "SFR11: Request Contextualized News Insights from AI Component to Identify Potential Impacts on Users' Investments" as SFR11
  usecase "AIFR07: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR07
  
  System --> (SFR11)
  System --> (AIFR07)

  usecase "SFR12: Request Client Predictive Intervention Recommendations from AI Component to Identify Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as SFR12
  usecase "AIFR08: Generate Client Predictive Intervention Recommendations by Identifying Patterns that Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR08
  
  System --> (SFR12)
  System --> (AIFR08)

  usecase "SFR13: Request Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as SFR13
  usecase "AIFR09: Generate Client Predictive Insights that Provide Forward-looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR09
  
  System --> (SFR13)
  System --> (AIFR09)

  usecase "SFR14: Request Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR14
  usecase "SFR15: Manage Users' Financial Goals to Track Progress and Provide Relevant Recommendations" as SFR15
  
  System --> (SFR14)
  System --> (SFR15)

  usecase "SFR16: Maintain a Historical Record of Users' Insights to Enable Trend Analysis and Effectiveness Measurement" as SFR16
  usecase "SFR17: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR17
  
  System --> (SFR16)
  System --> (SFR17)

}
@enduml