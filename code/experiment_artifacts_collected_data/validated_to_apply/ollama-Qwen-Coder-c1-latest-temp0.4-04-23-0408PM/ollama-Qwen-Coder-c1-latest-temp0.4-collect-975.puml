@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts" as SAFR004
  usecase "CFR003: View Financial Predictions" as SAFR005
  usecase "CFR004: Receive Personalized Recommendations" as SAFR006
  usecase "CFR005: Manage Recommendation Preferences" as SAFR007
  usecase "CFR006: View Spending Limit Alerts" as SAFR012
  usecase "CFR007: View Investment Opportunities" as SAFR013
  usecase "CFR008: View Financial News" as SAFR014
  usecase "CFR009: Access Personalized Dashboard" as SAFR015
  
  CFR001 --> (SAFR002)
  CFR001 --> (SAFR003)
  CFR001 --> (SAFR004)
  CFR001 --> (SAFR005)
  CFR001 --> (SAFR006)
  CFR001 --> (SAFR007)
  CFR001 --> (SAFR012)
  CFR001 --> (SAFR013)
  CFR001 --> (SAFR014)
  CFR001 --> (SAFR015)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts" as SAFR008
  usecase "FAFR003: View Predictive Analytics" as SAFR009
  usecase "FAFR004: Configure Analysis Parameters for Specific Clients" as SAFR10
  
  FinancialAdvisor --> (SAFR002)
  FinancialAdvisor --> (SAFR003)
  FinancialAdvisor --> (SAFR004)
}

package "System Administrator" {
  actor SystemAdmin as SAFR001
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "CFR11: Send Feedback" as AIFR008
  
  SystemAdmin --> (SAFR001)
  SystemAdmin --> (AIFR008)
}

package "System Components" {
  rectangle "AI Component" {
    usecase "AIFR001: Generate Financial Predictions" as SFR003
    usecase "AIFR002: Generate Personalized Recommendations" as SFR004
    usecase "AIFR003: Generate Spending Limit Alerts" as SFR005
    usecase "AIFR004: Generate Investment Opportunity Analyses" as SFR006
    usecase "AIFR005: Generate Investment Opportunities for Users" as AIFR007
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as SAFR018
    usecase "AIFR007: Generate Contextualized News Insights" as SFR023
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR009
    usecase "AIFR009: Generate Client Predictive Insights" as SAFR16
    
    SystemAdmin --> (SFR003)
    SystemAdmin --> (SFR004)
    SystemAdmin --> (SFR005)
    SystemAdmin --> (SFR006)
    SystemAdmin --> (AIFR007)
    SystemAdmin --> (SAFR018)
    SystemAdmin --> (SFR023)
    SystemAdmin --> (AIFR009)
  }
}

@enduml