@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Deliver Personalized Recommendations to Users" as SFR003
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFR001 --> (FAFR002)
}

rectangle "Financial Advisor Interface" {
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FinancialAdvisor --> (FAFR002)
  FinancialAdvisor --> (FAFR003)
  FinancialAdvisor --> (FAFR004)
}

rectangle "Client Interface" {
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
  usecase "SFR017: Generate Financial Health Reports for Users" as SFR017
  
  Client --> (SAFR001)
  Client --> (FAFR002)
  Client --> (CFR010)
  Client --> (SFR017)
}

rectangle "System Interface" {
  usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  System --> (SAFR001)
  System --> (FAFR003)
  System --> (AIFR002)
  System --> (AIFR004)
  System --> (SFR012)
}

rectangle "Alerts and Notifications" {
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  
  System --> (AIFR006)
  System --> (SFR013)
}

rectangle "News and Insights" {
  usecase "SFR009: Request Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  usecase "AIFR007: Generate Client Predictive Intervention Recommendations Based on Patterns Detected by AI Component" as AIFR007
  
  System --> (SFR009)
  System --> (AIFR007)
}

rectangle "Feedback and Improvement" {
  usecase "CFR11: Send Feedback about the System's Recommendations and Insights to Help Improve Future Outputs" as CFR11
  
  Client --> (SAFR001)
  FinancialAdvisor --> (FAFR002)
  SysAdmin --> (SFR003)
}

@enduml