@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR002
  
  usecase "FAFR003: View Predictive Analytics about My Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FinancialAdvisor --> (FAFR002) : manages mentoring sessions and alerts
}

package System {
  actor "System" as SFR001

  rectangle "AI Component" {
    usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities for Users by Identifying Financial Instruments Aligning with Their Strategies and Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009
    
  }

  rectangle "User Interface" {
    usecase "SFR12: Generate Client Dashboards Presenting Financial Information in an Intuitive and Actionable Format" as SFR12
    usecase "SFR13: Generate Client Alerts Based on Predefined Conditions Ensuring Timely Notification of Important Financial Events" as SFR13
  }

  rectangle "Recommendation Engine" {
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
    usecase "SFR20: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR20
    
  }

  rectangle "Alert System" {
    usecase "AIFR003: Generate Spending Limit Alerts for Users Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
    usecase "SFR14: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR14
    
  }

  rectangle "Predictive Analysis Engine" {
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "SFR16: Request Predictive Insights from the AI Component to Enhance the Value of Financial Guidance Provided to Clients" as SFR16
    
  }

  rectangle "News Integration Engine" {
    usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
    usecase "SFR29: Find and Extract Relevent Information from Trusted Financial News Sources for Users' Financial Situations" as SFR15
    
  }

}

CFR001 --> (User Interface) : views financial insights dashboard, alerts, predictions, recommendations, personalized preferences management, spending limit alerts
FAFR002 --> (FinancialAdvisor) : manages mentoring sessions and client intervention alerts

SFR001 --> (AI Component)
SFR001 --> (Recommendation Engine)
SFR001 --> (Alert System)
SFR001 --> (Predictive Analysis Engine)
SFR001 --> (News Integration Engine)

@enduml