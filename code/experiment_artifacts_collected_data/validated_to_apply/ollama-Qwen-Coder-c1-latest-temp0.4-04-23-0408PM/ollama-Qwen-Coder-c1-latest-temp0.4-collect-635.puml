@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR003: View Financial Predictions" as SAFR004
  usecase "CFR004: Receive Personalized Recommendations" as SAFR005
  usecase "CFR006: Manage Recommendation Preferences" as SAFR007
  usecase "CFR010: View Spending Limit Alerts" as SAFR008
  
  CFR001 --> SAFR003
  CFR001 --> SAFR004
  CFR001 --> SAFR005
  CFR001 --> SAFR007
  CFR001 --> SAFR008
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
  
  usecase "FAFR003: View Predictive Analytics about Client Situations" as SAFR009
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as SAFR010
  
  FinancialAdvisor --> SAFR003
  FinancialAdvisor --> SAFR010
}

package "System Administrator" {
  actor SystemAdmin as SAFR002
  
  usecase "SAFR006: Manage Analysis Parameters for the AI System" as SAFR001
  
  SystemAdmin --> SAFR001
}

rectangle "AI Component" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities for Users" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  
  SAFR001 --> AIFR001
  SAFR002 --> AIFR002
  SAFR003 --> AIFR003
  SAFR004 --> AIFR004
  SAFR005 --> AIFR005
  SAFR006 --> AIFR006
  SAFR010 --> AIFR007
  
}

rectangle "System" {
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  SAFR002 --> SFR003
  SAFR004 --> SFR005
  SAFR007 --> SFR009
  SAFR010 --> SFR016
  
}

rectangle "News Component" {
  usecase "SFR008: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR008
  usecase "SFR009: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR013
  
  SAFR002 --> SFR008
}

rectangle "Feedback Component" {
  usecase "CFR011: Send Feedback about System's Recommendations and Insights" as CFR011
  
  CFR001 --> CFR011
}
@enduml