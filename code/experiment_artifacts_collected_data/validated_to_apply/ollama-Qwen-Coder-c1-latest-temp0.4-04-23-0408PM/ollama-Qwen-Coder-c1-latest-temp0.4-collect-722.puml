@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR005: Manage Analysis Parameters Preferences" as SAFR005
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  
  Client --> (CFR001)
}

rectangle "Client Dashboard" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "SAFR005: Manage Analysis Parameters Preferences" as SAFR005

  Client --> (CFR009)
}

rectangle "Financial Insights" {
  usecase "SFR012: Generate Financial Health Reports" as SFR017
  
  Client --> (SFR017)
}

rectangle "Investment Opportunities" {
  usecase "SAFR003: View Predictive Analytics About My Clients' Financial Situations" as SAFR003
  usecase "FAFR007: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  System --> (SFR016)
}

rectangle "Spending Limits" {
  usecase "SAFR005: Manage Analysis Parameters Preferences" as SAFR005
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002

  System --> (SFR005)
}

rectangle "News and Analytics" {
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "SAFR017: Generate Client Predictive Insights" as SAFR019
  
  System --> (SFR013)
}

rectangle "Client Relationships" {
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR010

  Client --> (CFR010)
}

rectangle "System Functions" {
  usecase "SAFR002: Deliver Alerts to Users Through Appropriate Notification Channels" as SAFR009
  usecase "SFR003: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR004
  
  System --> (SAFR018)
}

rectangle "AI Functions" {
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  usecase "SFR003: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR004
  
  System --> (SAFR018)
}

rectangle "Feedback Management" {
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights" as CFR011

  Client --> (CFR011)
}
@enduml