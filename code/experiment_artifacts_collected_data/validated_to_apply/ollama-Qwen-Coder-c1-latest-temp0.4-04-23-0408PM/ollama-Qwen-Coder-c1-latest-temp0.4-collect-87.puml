@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFD002
  usecase "SFR003: Deliver Personalized Recommendations" as SFR003
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  Client --> CFR001 : "View Financial Insights Dashboard"
  Client --> FAFD002 : "Receive Alerts for Anomalous Transactions"
  SysAdmin --> SAFR001
  FAFD --> FAFD002
}

rectangle "Financial Advisor" {
  usecase "FAFR003: View Predictive Analytics" as FAFD003
  usecase "FAFR04: Configure Analysis Parameters for Client Segments" as FAFD004
  
  FinancialAdvisor --> FAFD002 : "View Intervention Alerts"
  FinancialAdvisor --> FAFD003 : "View Predictive Analytics"
  FinancialAdvisor --> FAFD004
}

rectangle "Client Dashboard" {
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
  
  Client --> CFR010
}
@enduml