@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR004
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as SAFR005
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as SAFR006
  usecase "CFR005: Manage Personalized Recommendations Preferences" as SAFR012
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as SAFR013
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as SAFR014
  usecase "CFR008: View News Related to My Investment Portfolio" as SAFR015
  usecase "CFR009: Access a Personalized Dashboard That Consolidates Financial Information in a Single View" as SAFR016
  usecase "CFR010: Manage Relationship with Financial Advisors, Including Permissions for Sharing Data" as SAFR024
  
  CFR001 --> SAFR004
  CFR001 --> SAFR005
  CFR001 --> SAFR006
  CFR001 --> SAFR012
  CFR001 --> SAFR013
  CFR001 --> SAFR014
  CFR001 --> SAFR015
  CFR001 --> SAFR016
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
  
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations" as SAFR017
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as SAFR018
  usecase "FAFR005: Manage Client Mentoring Sessions Based on System-Generated Insights" as AIFR023
  
  FAFR002 --> SAFR017
  FAFR002 --> SAFR018
  FAFR002 --> AIFR023
}

package "System Administrator" {
  actor SystemAdministrator as SAFR009
  
  usecase "SAFR001: Manage Analysis Parameters for the AI System" as SAFR019
  usecase "CFR011: Send Feedback About Recommendations and Insights" as AIFR024
  
  SAFR009 --> SAFR019
  SAFR009 --> AIFR024
}

package "System" {
  rectangle SystemBoundary {
    usecase "SFR003: Request Financial Predictions from the AI Component" as SFR003
    usecase "SFR005: Request Spending Limit Alerts from the AI Component" as SFR005
    usecase "SFR012: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as AIFR026
    
    SAFR009 --> SFR003
    SAFR009 --> SFR005
  }
}

@enduml