@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFD002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  
  rectangle "Client Features" {
    Client --> CFR001 : "View Dashboard"
    Client --> SAFR005 : "Manage Preferences"
    Client --> SFR009 : "Request News Insights"
    Client --> FAFD002 : "Receive Alerts"
    Client --> AIFR004 : "Generate Recommendations"
  }
  
  rectangle "Financial Advisor Features" {
    FinancialAdvisor --> SAFR001 : "Manage Parameters"
    FinancialAdvisor --> FAFR003 : "View Predictive Analytics"
    FinancialAdvisor --> SFR009 : "Request News Insights"
    FinancialAdvisor --> AIFR004 : "Generate Recommendations"
  }
  
  rectangle "System Admin Features" {
    SystemAdmin --> SAFR001 : "Manage Parameters"
    SystemAdmin --> SFR003 : "Request Predictions"
    SystemAdmin --> AIFR002 : "Generate Predictive Insights"
  }

}

@enduml