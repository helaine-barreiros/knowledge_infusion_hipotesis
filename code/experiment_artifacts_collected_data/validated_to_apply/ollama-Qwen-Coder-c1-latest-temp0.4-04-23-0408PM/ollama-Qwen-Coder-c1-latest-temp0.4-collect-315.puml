@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
}

package "System Administrator" {
  actor SysAdmin as SAFR003
}

rectangle "User Interface" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  CFR001 --> (CFR002)
  CFR002 --> (FAFR003)
}

rectangle "Financial Insights and Predictions" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR004
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  
  CFR001 --> (SFR003)
  FAFR002 --> (FAFR003)
}

rectangle "Alerts and Notifications" {
  usecase "SAFR005: Deliver Alerts to Users" as SAFR006
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  
  CFR001 --> (SFR009)
}

rectangle "Personalized Recommendations and Insights" {
  usecase "SAFR002: Manage Client Mentoring Sessions" as SAFR007
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  CFR001 --> (SFR004)
}

rectangle "Investment Opportunities and News" {
  usecase "SAFR003: View Predictive Analytics" as SAFR008
  usecase "AIFR005: Generate Investment Opportunity Analyses" as AIFR005
  
  CFR001 --> (SFR006)
}

rectangle "System Management and Feedback" {
  usecase "SAFR007: Manage Analysis Parameters for Specific Client Segments" as SAFR009
  usecase "AIFR004: Generate Spending Limit Alerts" as AIFR003
  
  CFR001 --> (SFR020)
}

rectangle "AI System Operations" {
  usecase "SAFR008: Request Contextualized News Insights from AI Component" as SAFR010
  usecase "AIFR007: Generate Client Predictive Intervention Recommendations" as AIFR008
  
  CFR001 --> (SFR024)
}

rectangle "Historical Record and Feedback Management" {
  usecase "SAFR009: Maintain a Historical Record of Users' Insights" as SAFR013
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  CFR001 --> (SFR025)
}

rectangle "System Alerts and Recommendations" {
  usecase "SAFR006: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SAFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns that Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR010
  
  CFR002 --> (SFR036)
}

rectangle "System Analytics and Reports" {
  usecase "SAFR017: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SAFR018
  usecase "AIFR009: Generate Client Predictive Insights that Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR012
  
  CFR002 --> (SFR043)
}

rectangle "System Management and Feedback" {
  usecase "SAFR007: Manage Analysis Parameters for Specific Client Segments" as SAFR019
  usecase "AIFR008: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Spending Patterns" as AIFR024
  
  CFR003 --> (SFR056)
}

rectangle "AI System Operations" {
  usecase "SAFR010: Request Contextualized News Insights From AI Component to Identify Potential Impacts on Users' Investments" as SAFR027
  usecase "AIFR010: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR038
  
  CFR003 --> (SFR065)
}

rectangle "Historical Record and Feedback Management" {
  usecase "SAFR012: Maintain a Historical Record of Users' Insights to Enable Trend Analysis and Effectiveness Measurement" as SAFR029
  usecase "AIFR011: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations To Support More Effective Financial Planning" as AIFR046
  
  CFR003 --> (SFR078)
}

@enduml