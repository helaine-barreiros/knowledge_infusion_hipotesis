@startuml
left to right direction

title Use Case Diagram for AI-Powered Finance Solution

package "Clients" {
  actor Client as CFR001
  usecase "CFR002: View Alerts about Anomalous Transactions" as CFR002 
  usecase "CFR003: View Financial Predictions" as CFR003 
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007 
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10

  CFR001 --> (View Alerts about Anomalous Transactions)
  CFR001 --> (View Financial Predictions)
  CFR001 --> (Receive Personalized Recommendations)
  CFR001 --> (Manage Recommendation Preferences)
  CFR001 --> (View Spending Limit Alerts)
  CFR001 --> (View Investment Opportunities)
  CFR001 --> (View News Related to Portfolio)
  CFR001 --> (Access Personalized Dashboard)
  CFR001 --> (Manage Relationship with Financial Advisors)

}

package "Financial Advisors" {
  actor FinancialAdvisor as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002 
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004

  FAFR001 --> (View Client Intervention Alerts)
  FAFR001 --> (View Predictive Analytics about Clients' Financial Situations)
  FAFR001 --> (Configure Analysis Parameters for Specific Client Segments)

}

package "System Administrator" {
  actor SystemAdmin as SAFR001
  usecase "SAFR002: Manage Analysis Parameters" as SAFR002

  SAFR001 --> (Manage Analysis Parameters)
  
}

rectangle "AI System" {
    package "Alerts & Notifications"{
        usecase "SFR001: Deliver Alerts to Users" as SFR001
        usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006

        SAFR002 --> (Deliver Alerts to Users)
    }

    package "Recommendations & Insights"{
        usecase "SFR002: Deliver Personalized Recommendations" as SFR002
        usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001 
        usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003

        SAFR002 --> (Deliver Personalized Recommendations)
    }

    package "Investment & Portfolio Management"{
        usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
        usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004

        SAFR002 --> (Request Investment Opportunity Analysis from AI Component)
    }

    package "News & Analytics"{
        usecase "SFR013: Request Client Alerts Based on Predefined Conditions" as SFR013
        usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007

        SAFR002 --> (Request Client Alerts Based on Predefined Conditions)
    }

}

package "System Components"{
  usecase "SFR11: Send Feedback about System's Recommendations and Insights" as SFR11
  CFR11 --> (Send Feedback about System's Recommendations and Insights)

}
@enduml