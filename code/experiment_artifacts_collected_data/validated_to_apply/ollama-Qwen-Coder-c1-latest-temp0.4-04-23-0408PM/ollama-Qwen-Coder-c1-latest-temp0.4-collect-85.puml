@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FinancialAdvisor --> FAFR002
}

rectangle "Client Dashboard Features" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR010: Manage Relationship with Advisors" as CFR010
  
  Client --> CFR009
  Client --> CFR010
}

rectangle "Client Alerts and Notifications" {
  usecase "SFR003: Deliver Alerts to Users" as SFR003
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  
  SystemAdmin --> SAFR001
  Client --> SFR003
  FinancialAdvisor --> FAFR002
}

rectangle "Personalized Recommendations and Insights" {
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  
  SystemAdmin --> SAFR001
  Client --> SFR002
}

rectangle "Financial Predictions and Analytics" {
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "CFR008: View News Related to Investment Portfolio" as CFR008
  
  SystemAdmin --> SAFR001
  Client --> SFR003
}

rectangle "Investment Opportunities and Analysis" {
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  
  SystemAdmin --> SAFR001
  Client --> SFR006
}

rectangle "Spending Limit Alerts and Management" {
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as CFR006
  
  SystemAdmin --> SAFR001
  Client --> SFR005
}

rectangle "Feedback and Continuous Improvement" {
  usecase "AIFR009: Generate Contextualized News Insights by Correlating Financial News with User Portfolios" as AIFR009
  usecase "CFR11: Send Feedback about System's Recommendations and Insights to Help Improve Future Outputs" as CFR11
  
  Client --> AIFR009
  Client --> CFR11
}

@enduml