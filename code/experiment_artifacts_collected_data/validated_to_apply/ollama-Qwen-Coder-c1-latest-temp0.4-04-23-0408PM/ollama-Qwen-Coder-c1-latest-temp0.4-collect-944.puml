@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR010)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SystemAdmin as SA
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SA --> (SAFR001)
}

rectangle "AI Component" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  useusecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Based on ESG Criteria" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  SFR001 --> (AIFR006)
  SFR002 --> (AIFR002)
  SFR003 --> (AIFR001)
  SFR004 --> (AIFR002)
  SFR005 --> (AIFR003)
  SFR006 --> (AIFR004)
  SFR007 --> (AIFR005)
  SFR011 --> (AIFR007)
  SFR012 --> (AIFR012) ' Generate Client Dashboards
  SFR013 --> (AIFR013) ' Generate Client Alerts Based on Predefined Conditions
  SFR014 --> (AIFR014) ' Generate Client Analytics That Provide Meaningful Insights into Financial Behavior and Performance
  
}

rectangle "System" {
  usecase "SFR008: Request Predictive Intervention Analyses from AI Component" as SFR008
  usecase "SFR009: Request Predictive Insights From the AI Component" as SFR009
  usecase "SFR17: Generate Financial Health Reports Based on Standard Financial Ratios and Metrics" as SFR17
  
  SFR015 --> (AIFR008)
  SFR016 --> (AIFR009)
  C --> (SFR012) ' Request Client Dashboards
  FA --> (SFR013) ' Request Client Alerts Based on Predefined Conditions
  SA --> (SFR014) ' Generate Client Analytics That Provide Meaningful Insights into Financial Behavior and Performance
  
}

rectangle "Notifications" {
  usecase "SFR028: Send Feedback About System Recommendations and Insights to Improve Future Outputs" as SFR028

  C --> (SFR028)
}
@enduml