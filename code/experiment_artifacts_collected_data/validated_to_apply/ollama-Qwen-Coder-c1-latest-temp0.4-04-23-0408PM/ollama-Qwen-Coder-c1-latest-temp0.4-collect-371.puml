@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FinancialAdvisor

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFR002 <|-- (FAFR004)
  
  rectangle "Client Dashboard Features" {
    usecase "CFR009: Access Personalized Dashboard" as CFR009
    usecase "SFR017: Generate Financial Health Reports" as SFR017
    
    Client --> CFR009
    SysAdmin --> SFR017
  }
  
  rectangle "Client Alerts and Notifications" {
    usecase "CFR002: View Anomalous Transactions" as CFR002
    usecase "SFR005: Request Spending Limit Alerts" as SFR005
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    
    Client --> CFR002
    SysAdmin --> SFR005
  }
  
  rectangle "Financial Recommendations and Opportunities" {
    usecase "CFR004: Receive Personalized Recommendations" as CFR004
    usecase "SFR018: Manage Users' Financial Goals" as SFR018
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    
    Client --> CFR004
  }
  
  rectangle "Investment and News Features" {
    usecase "CFR007: View Investment Opportunities" as CFR007
    usecase "SFR016: Request Predictive Insights" as SFR016
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    
    Client --> CFR007
  }
  
  rectangle "System Management and Feedback" {
    usecase "SFR20: Manage User Feedback" as SFR20
    usecase "CFR11: Send System Feedback" as CFR11
    
    SysAdmin --> SFR20
    Client --> CFR11
  }
}

@enduml