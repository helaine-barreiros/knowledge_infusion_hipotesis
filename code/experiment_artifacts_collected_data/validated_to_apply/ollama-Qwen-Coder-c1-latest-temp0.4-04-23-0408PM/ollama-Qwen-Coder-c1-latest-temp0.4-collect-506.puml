@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

' Define actors
actor Client as C
actor FinancialAdvisor as FA
actor SysAdmin as SA
actor User as U

' Group use cases by actor or subsystem
rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Segment" as FAFR004
}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
}

' Group system functionalities
package System {
  rectangle "User Interface" {
    usecase "SFR012: Generate Client Dashboards" as SFR012
  }
  
  rectangle "Notification Management" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
  }

  rectangle "Recommendation Engine" {
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  }
  
  rectangle "Prediction and Analytics" {
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR014: Generate Client Analytics" as SFR014
    usecase "AIFR009: Generate Client Predictive Insights for Users" as AIFR009
  }
  
  rectangle "Alert Generation" {
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
    usecase "AIFR006: Generate Anomaly Transaction Alerts for Users" as AIFR006
  }
  
  rectangle "Investment Opportunities" {
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "SFR015: Request Predictive Intervention Analyses from the AI Component" as SFR015
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  }
  
  rectangle "News and Insights" {
    usecase "SFR007: Request Contextualized News from the AI Component" as SFR007
    usecase "AIFR007: Generate Contextualized News Insights for Users" as AIFR007
  }
  
  rectangle "Feedback Management" {
    usecase "SFR12: Manage User Feedback to Improve Outputs" as SFR12
    usecase "CFR11: Send Feedback about System Recommendations and Insights" as CFR11
  }

}

' Relationships between actors and use cases
C --> (CFR001)
C --> (CFR002)
C --> (CFR003)
C --> (CFR004)
C --> (CFR005)
C --> (CFR006)
C --> (CFR007)
C --> (CFR008)
C --> (CFR009)
C --> (CFR10)

FA --> (FAFR001)
FA --> (FAFR002)
FA --> (FAFR003)
FA --> (FAFR004)

SA --> (SAFR001)

U --> (SFR012)
U --> (SFR001)
U --> (SFR002)
U --> (AIFR002)
U --> (SFR005)
U --> (AIFR006)
U --> (SFR007)
U --> (AIFR004)

@enduml