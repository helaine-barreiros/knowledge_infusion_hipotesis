@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
}

package "System Administrator" {
  actor SysAdmin as SAFR003
}

rectangle "User Interface" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "SFR12: Generate Client Dashboards" as SFR12
  
  CFR001 --> CFR009 : "View"
  FAFR002 --> CFR009 : "Manage"
  SAFR003 --> CFR009 : "Manage"
}

rectangle "Alerts and Notifications" {
  usecase "SFR08: Request Anomaly Transaction Alerts" as SFR08
  usecase "SFR14: Generate Client Analytics" as SFR14
  
  CFR001 --> SFR08 : "Receive alerts for"
  FAFR002 --> SFR08 : "Monitor clients' transactions"
  SAFR003 --> SFR08 : "Manage alerts"
}

rectangle "Recommendations and Insights" {
  usecase "SFR02: Deliver Personalized Recommendations" as SFR02
  usecase "AIFR01: Generate Financial Predictions" as AIFR01
  
  CFR001 --> SFR02 : "Receive"
  FAFR002 --> AIFR01 : "Use for recommendations"
  SAFR003 --> AIFR01 : "Manage parameters"
}

rectangle "Investment Opportunities and News" {
  usecase "SFR06: Request Investment Opportunity Analysis" as SFR06
  usecase "AIFR04: Generate Investment Opportunity Analyses" as AIFR04
  
  CFR001 --> SFR06 : "View"
  FAFR002 --> AIFR04 : "Use for client guidance"
  SAFR003 --> AIFR04 : "Manage parameters"
  
  usecase "SFR09: Find Contextualized News" as SFR09
  usecase "AIFR07: Generate Contextualized News Insights" as AIFR07
  
  CFR001 --> SFR09 : "View news for"
  FAFR002 --> SFR09 : "Use with client portfolios"
  SAFR003 --> SFR09 : "Manage parameters"
}

rectangle "Spending Limits and Goals" {
  usecase "SFR05: Request Spending Limit Alerts" as SFR05
  usecase "AIFR02: Generate Personalized Recommendations for Users" as AIFR02
  
  CFR001 --> SFR05 : "Receive alerts when"
  FAFR002 --> AIFR02 : "Use with client profiles and goals"
  SAFR003 --> AIFR02 : "Manage parameters"
  
  usecase "CFR018: Manage Financial Goals" as CFR018
  usecase "SFR19: Maintain Historical Record of Users' Insights" as SFR19
  
  CFR001 --> CFR018 : "Set and track"
  FAFR002 --> CFR018 : "Use for client guidance"
  SAFR003 --> CFR018 : "Manage goals"
}

rectangle "Feedback Management" {
  usecase "CFR11: Send Feedback about Recommendations" as CFR11
  
  CFR001 --> CFR11
  FAFR002 --> CFR11
  SAFR003 --> CFR11
}
@enduml