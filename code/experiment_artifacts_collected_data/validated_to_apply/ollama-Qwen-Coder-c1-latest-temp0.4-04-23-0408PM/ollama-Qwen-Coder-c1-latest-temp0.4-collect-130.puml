@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR005: Manage Analysis Parameters Preferences" as SAFR005
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  Client --> (CFR001)
  SysAdmin --> (SAFR005)
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "SFR013: Generate Client Alerts" as SFR013
  
  FinancialAdvisor --> (FAFR001)
  SysAdmin --> (SAFR005) : <<Manage Analysis Parameters>>
}

rectangle "System Components" {
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "SFR014: Generate Client Analytics" as SFR014
  
  System --> (AIFR002)
  System --> (SFR013)
}

rectangle "Client Interactions" {
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  
  Client --> (CFR002)
  Client --> (CFR006)
}

rectangle "Investment Insights" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
  
  Client --> (CFR007)
  SystemAdmin --> (SAFR004) : <<Configure Analysis Parameters for Specific Client Segments>>
}

rectangle "News and Information" {
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "SFR016: Request Contextualized News Insights from AI Component" as SFR016
  
  Client --> (CFR008)
}

rectangle "User Feedback" {
  usecase "CFR11: Send Feedback about the System's Recommendations and Insights" as CFR11
  SysAdmin --> (SFR20) : <<Manage User Feedback>>
  
  Client --> (CFR11)
}
@enduml