@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFD001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002

  Client --> CFR001 : "View Financial Insights Dashboard"
  Client --> SAFR001 : "Manage Analysis Parameters"
  SysAdmin --> SAFR001 : "Manage Analysis Parameters"
  FAFD --> FAFD001 : "Manage Client Mentoring Sessions"

  rectangle "Client Functions" {
    usecase "CFR002: View Alerts for Anomalous Transactions" as CFR002
    usecase "CFR003: View Financial Predictions" as CFR003
    usecase "CFR004: Receive Personalized Recommendations" as CFR004
    usecase "CFR005: Manage Recommendation Preferences" as CFR005
    usecase "CFR006: View Spending Limit Alerts" as CFR006
    usecase "CFR007: View Investment Opportunities" as CFR007
    usecase "CFR008: View News Related to Portfolio" as CFR008
    usecase "CFR009: Access Personalized Dashboard" as CFR009
    usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10

    Client --> CFR002 : "View Alerts for Anomalous Transactions"
    Client --> CFR003 : "View Financial Predictions"
    Client --> CFR004 : "Receive Personalized Recommendations"
    Client --> CFR005 : "Manage Recommendation Preferences"
    Client --> CFR006 : "View Spending Limit Alerts"
    Client --> CFR007 : "View Investment Opportunities"
    Client --> CFR008 : "View News Related to Portfolio"
    Client --> CFR009 : "Access Personalized Dashboard"
    Client --> CFR10 : "Manage Relationship with Financial Advisors"

    rectangle "Financial Advisor Functions" {
      usecase "FAFR002: View Intervention Alerts for Clients" as FAFD002
      usecase "FAFR003: View Predictive Analytics about Clients' Situations" as FAFD003
      usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFD004

      Financial Advisor --> FAFD002 : "View Intervention Alerts for Clients"
      Financial Advisor --> FAFD003 : "View Predictive Analytics about Clients' Situations"
      Financial Advisor --> FAFD004 : "Configure Analysis Parameters for Client Segments"

      rectangle "System Functions" {
        usecase "SFR001: Deliver Alerts to Users" as SFR001
        usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
        usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
        usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
        usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
        usecase "SFR007: Request Specific Investment Opportunities from AI Component Matching User Criteria and ESG Preferences" as SFR007
        usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
        usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
        usecase "SFR10: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR10
        usecase "SFR12: Generate Client Dashboards Presenting Financial Information in an Intuitive and Actionable Format" as SFR12

        System Admin --> SAFR001 : "Manage Analysis Parameters"
        FAFD --> FAFD004 : "Configure Analysis Parameters for Specific Client Segments"

        rectangle "AI Functions" {
          usecase "AIFR001: Generate Financial Predictions" as AIFR001
          usecase "AIFR002: Generate Personalized Recommendations Based on User Profiles, Goals and Risk Tolerance" as AIFR002
          usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
          usecase "AIFR004: Generate Investment Opportunity Analyses for Users Evaluating Potential Investments Against Their Risk Profiles, Time Horizons and Financial Goals" as AIFR004
          usecase "AIFR005: Generate Investment Opportunities Matching User Strategies and Modern Portfolio Theory Principles" as AIFR005
          usecase "AIFR006: Generate Anomaly Transaction Alerts Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
          usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News With Specific User Portfolios Identifying Relevant Impacts" as AIFR007
          usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
          usecase "AIFR016: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009

          System Admin --> SAFR001 : "Manage Analysis Parameters"
        }
      }

    rectangle "User Feedback Management" {
      usecase "CFR11: Send Feedback About Recommendations and Insights" as CFR11
      Client --> CFR11 : "Send Feedback About Recommendations and Insights"
    }
  }
}
@enduml