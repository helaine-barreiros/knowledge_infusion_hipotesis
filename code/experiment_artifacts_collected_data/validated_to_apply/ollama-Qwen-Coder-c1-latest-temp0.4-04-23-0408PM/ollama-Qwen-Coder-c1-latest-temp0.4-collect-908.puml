@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FAFR

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Deliver Personalized Recommendations" as SFR003
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002

  User --> CFR001
  SysAdmin --> SAFR001
  FAFR --> (FAFR002)
  
  :System: <|-- (SFR003)
}

rectangle "Client Dashboard" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  
  User --> CFR009
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "SFR015: Request Predictive Intervention Analyses" as SFR015
  
  Financial Advisor --> (FAFR001)
  Financial Advisor --> (FAFR003)
  Financial Advisor --> (SFR015)
}

rectangle "System Functions" {
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR004: Generate Spending Limit Alerts" as AIFR004
  
  :System: --> (SFR002)
  :System: --> (AIFR004)

  rectangle "Notifications" {
    usecase "SFR013: Deliver Client Alerts" as SFR013
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    
    :System: --> (SFR013)
    :System: --> (AIFR006)

  }

  rectangle "Predictive Insights" {
    usecase "SFR014: Deliver Client Analytics" as SFR014
    usecase "AIFR009: Generate Predictive Insights" as AIFR009
    
    :System: --> (SFR014)
    :System: --> (AIFR009)

  }

}

rectangle "AI Functions" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  
  :System: --> (AIFR001)
  :System: --> (AIFR004)

}

rectangle "News and Insights" {
  usecase "SFR008: Request Contextualized News" as SFR008
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  
  :System: --> (SFR008)
  :System: --> (AIFR007)

}

rectangle "Investment Opportunities" {
  usecase "CFR012: View Investment Opportunities" as CFR012
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  User --> (CFR012)
  Financial Advisor --> (FAFR004)

}

rectangle "Feedback and Improvement" {
  usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
  usecase "SFR020: Manage User Feedback" as SFR020
  
  :System: --> (AIFR008)
  :System: --> (SFR020)

}
@enduml