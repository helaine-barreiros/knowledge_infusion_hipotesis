@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
}

package "System Administrator" {
  actor SysAdmin as SAFR003
}

rectangle "System" {
  usecase "SFR012: Generate client dashboards" as SFR012
  usecase "SFR014: Generate client analytics" as SFR014
  usecase "SFR015: Request predictive intervention analyses from the AI component" as SFR015
  usecase "SFR016: Request predictive insights from the AI component" as SFR016
  usecase "SFR017: Generate financial health reports" as SFR017

  rectangle "Financial Insights & Recommendations" {
    usecase "CFR002: Receive alerts about anomalous transactions" as CFR002
    usecase "SAFR005: Manage analysis parameters for the AI system" as SAFR005
    usecase "FAFR001: Manage client mentoring sessions based on system-generated insights" as FAFR001
  }

  rectangle "Predictive Analytics & Recommendations" {
    usecase "CFR003: View financial predictions" as CFR003
    usecase "SAFR006: Request investment opportunity analysis from the AI component" as SAFR006
    usecase "FAFR002: View client intervention alerts when system detects patterns requiring professional attention" as FAFR002
  }

  rectangle "Personalized Recommendations & Preferences Management" {
    usecase "CFR004: Receive personalized recommendations aligned with financial profile and goals" as CFR004
    usecase "SAFR018: Manage users' financial goals to track progress and provide relevant recommendations" as SAFR018
    usecase "FAFR003: View predictive analytics about clients' financial situations for data-driven recommendations during consultations" as FAFR003
  }

  rectangle "Spending Limits & Alerts Management" {
    usecase "CFR006: View spending limit alerts when exceeding predefined thresholds in specific expense categories" as CFR006
    usecase "SAFR015: Request predictive intervention analyses from the AI component to identify when financial advisors should engage with clients" as SAFR015
  }

  rectangle "Investment Opportunities & News Management" {
    usecase "CFR007: View investment opportunities suitable for risk profile" as CFR007
    usecase "SAFR009: Request contextualized news relevant to users' financial portfolios from trusted financial news sources" as SAFR009
  }

  rectangle "Notifications & Feedback Management" {
    usecase "SFR013: Generate client alerts based on predefined conditions" as SFR013
    usecase "CFR011: Send feedback about the system's recommendations and insights to help improve future outputs" as CFR011
  }
}

Client --> (SAFR005)
FinancialAdvisor --> (FAFR002)
SysAdmin --> (SFR014)

rectangle "AI System" {
  usecase "AIFR003: Generate spending limit alerts for users by identifying unusual deviations from established spending patterns" as AIFR003
  usecase "AIFR006: Generate anomaly transaction alerts by employing pattern recognition to detect potentially fraudulent activities in compliance with FinCEN requirements" as AIFR006

  rectangle "Recommendations & Insights Generation" {
    usecase "AIFR002: Generate personalized recommendations for users based on their financial profiles, goals, and risk tolerance as defined by industry standards like FINRA guidelines" as AIFR002
    usecase "AIFR014: Enhance the value of financial guidance provided to clients through predictive insights from the AI component" as AIFR016
  }

  rectangle "Investment Opportunity Analysis & News Correlation" {
    usecase "AIFR007: Generate contextualized news insights by correlating financial news with specific user portfolios to identify relevant impacts" as AIFR007
    usecase "AIFR012: Request contextualized news from the AI component for users' financial situations" as AIFR018
  }

  rectangle "Predictive Intervention & Reporting" {
    usecase "AIFR004: Generate investment opportunity analyses for users by evaluating potential investments against their risk profiles, time horizons, and financial goals" as AIFR004
    usecase "AIFR015: Generate client predictive intervention recommendations based on patterns that indicate potential financial difficulties or opportunities requiring advisor engagement" as AIFR019
  }
}

SFR012 --> (CFR008)
SFR013 --> (SAFR017)

@enduml