@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FinancialAdvisor
:User: as User

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006

  Client --> CFR001
  Client --> FAFR002
  SysAdmin --> SAFR001
}

rectangle "Financial Advisor Interface" {
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004

  FinancialAdvisor --> FAFR002
  FinancialAdvisor --> FAFR003
  FinancialAdvisor --> FAFR004
}

rectangle "User Interface" {
  usecase "CFR011: Send Feedback about System Recommendations and Insights" as CFR011
  
  User --> CFR011
}
@enduml