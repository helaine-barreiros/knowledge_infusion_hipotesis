@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FAFR

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  User --> CFR001
  SysAdmin --> SAFR001
  FAFR --> (FAFR003)
}

rectangle "Financial Advisor Dashboard" {
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
  
  FinancialAdvisor --> (FAFR002)
}

rectangle "Client Management Dashboard" {
  usecase "CFR010: Manage Relationship with Advisors" as CFR010
  usecase "AIFR020: Generate Client Feedback Insights" as AIFR020

  User --> (CFR010)
  
  ' Financial Advisor can also manage client relationships but it's not directly related to the primary user flow.
}

rectangle "System Notifications & Recommendations" {
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  
  System --> (SFR003)
  System --> (SFR002)

}

rectangle "Investment Opportunities & News" {
  usecase "CFR017: View Investment Opportunities Suitable to My Risk Profile" as CFR017
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  User --> (CFR017)
  
}

rectangle "User Feedback & Improvement" {
  usecase "AIFR020: Generate Client Feedback Insights" as AIFR020
  usecase "SFR020: Manage User Feedback to Improve Recommendations" as SFR020
  
  System --> (AIFR020)
}

@enduml