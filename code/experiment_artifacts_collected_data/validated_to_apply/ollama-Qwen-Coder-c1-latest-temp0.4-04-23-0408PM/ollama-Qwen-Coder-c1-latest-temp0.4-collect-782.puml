@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FAFR

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Deliver Personalized Recommendations to Users" as SFR003
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  
  User --> CFR001
  SysAdmin --> SAFR001
  FAFR --> FAFR002
  System Admin --> SFR003
  Financial Advisor --> AIFR002
}

rectangle "Client Dashboard" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  
  User --> CFR009
}

rectangle "Investment Opportunities" {
  usecase "CFR017: View Investment Opportunities Suitable to My Risk Profile" as CFR017
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
  
  User --> CFR017
  Financial Advisor --> FAFR003
}

rectangle "Spending Limits and Alerts" {
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as CFR006
  usecase "SFR005: Request Spending Limit Alerts from the AI Component" as SFR005
  
  User --> CFR006
  System Admin --> SFR005
}

rectangle "News and Analytics" {
  usecase "CFR018: View News Related to My Investment Portfolio" as CFR018
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios from Trusted Financial News Sources" as SFR009
  
  User --> CFR018
  System Admin --> SFR009
}

rectangle "Feedback and Management" {
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights" as CFR11
  
  User --> CFR11
}
@enduml