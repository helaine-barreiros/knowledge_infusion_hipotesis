@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "SFR007: Request Investment Opportunity Analysis" as SFR007
  
  Client --> CFR001 : "View Financial Insights Dashboard"
  SysAdmin --> SAFR001 : "Manage Analysis Parameters"
  FAFD --> FAFR003 : "View Predictive Analytics"
}

rectangle "Client Interface" {
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
  
  Client --> CFR002 : "Receive Alerts for Anomalous Transactions"
  Client --> CFR006 : "View Spending Limit Alerts"
  Client --> CFR010 : "Manage Relationship with Financial Advisors"
}

rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  
  FAFD --> FAFR001 : "Manage Client Mentoring Sessions"
  FAFD --> FAFR002 : "View Client Intervention Alerts"
}

rectangle "Notifications and Recommendations" {
  usecase "SFR003: Deliver Personalized Recommendations" as SFR003
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  
  System Admin --> SAFR002 : "Manage Analysis Parameters"
  Client --> CFR004 : "Receive Personalized Recommendations"
}

rectangle "News and Portfolio Insights" {
  usecase "CFR008: View News Related to Investment Portfolio" as CFR008
  usecase "SFR017: Generate Financial Health Reports" as SFR017
  
  Client --> CFR008 : "View News Related to Investment Portfolio"
  System Admin --> SAFR019 : "Maintain Historical Record of Users' Insights"
}

rectangle "Feedback and Improvement" {
  usecase "CFR11: Send Feedback about Recommendations" as CFR11
  
  Client --> CFR11 : "Send Feedback about Recommendations"
}
@enduml