@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAdvisor

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "AIFR009: Generate Contextualized News Insights" as AIFR009

  Client --> CFR001
  SysAdmin --> SAFR001
  FAdvisor --> (FAFR002)
  System Admin -> SFR003 : <<SFR>>
  Financial Advisor -> AIFR009 : <<AIFR>>

}

rectangle "Financial Insights" {
  usecase "CFR002: View Alerts About Anomalous Transactions" as CFR002
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "SFR004: Request Personalized Recommendations" as SFR004

  Client --> (CFR002)
  Financial Advisor --> (FAFR001)
  System Admin -> SFR004 : <<SFR>>

}

rectangle "Spending Limits and Alerts" {
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "SAFR002: Request Spending Limit Alerts from AI" as SAFR002

  Client --> (CFR006)
  System Admin -> SAFR002 : <<SFR>>

}

rectangle "Investment Opportunities and Recommendations" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "FAFR003: View Predictive Analytics About Client Financial Situations" as FAFR003
  usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006

  Client --> (CFR007)
  Financial Advisor --> (FAFR003)
  System Admin -> SFR006 : <<SFR>>

}

rectangle "News and Updates" {
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios" as AIFR007

  Client --> (CFR008)
  System Admin -> AIFR007 : <<SFR>>

}

rectangle "Personalization and Preferences" {
  usecase "CFR004: Receive Personalized Recommendations Aligned With My Financial Profile And Goals" as CFR004
  usecase "FAFR002: Configure Analysis Parameters for Specific Client Segments" as FAFR004

  Client --> (CFR004)
  Financial Advisor --> (FAFR004)

}

rectangle "Relationship Management" {
  usecase "CFR10: Manage My Relationship With Financial Advisors, Including Permissions For Sharing My Financial Data" as CFR10
  usecase "AIFR002: Generate Personalized Recommendations Based on Each User's Financial Data and Preferences" as AIFR002

  Client --> (CFR10)
  System Admin -> AIFR002 : <<SFR>>

}

rectangle "Feedback Management" {
  usecase "CFR11: Send Feedback About the System's Recommendations And Insights to Help Improve Future Outputs" as CFR11
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008

  Client --> (CFR11)
  System Admin -> AIFR008 : <<SFR>>

}

@enduml