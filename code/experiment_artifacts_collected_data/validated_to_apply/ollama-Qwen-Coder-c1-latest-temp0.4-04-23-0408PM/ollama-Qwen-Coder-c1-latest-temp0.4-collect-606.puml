@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001
:AIFR002: as AIFR002

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR002
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  
  rectangle "Client Functions" {
    Client --> CFR001 : "View Dashboard"
    Client --> SAFR001 : "Manage Analysis Parameters"
    Client --> SFR001 : "Receive Alerts"
    Client --> AIFR002 : "Get Recommendations"
  }

  rectangle "Financial Advisor Functions" {
    FinancialAdvisor --> FAFR002 : "Manage Sessions"
    FinancialAdvisor --> SAFR001 : "Configure Analysis Parameters"
    FinancialAdvisor --> SFR001 : "Receive Alerts"
    FinancialAdvisor --> AIFR002 : "Get Recommendations"
  }

  rectangle "System Functions" {
    SystemAdmin --> SAFR001 : "Manage Analysis Parameters"
    SystemAdmin --> SFR001 : "Deliver Alerts"
    
    Client <|-- (CFR009) --> FAFR001
    FinancialAdvisor --> AIFR002 : "Get Recommendations for Clients"
  }
}

@enduml