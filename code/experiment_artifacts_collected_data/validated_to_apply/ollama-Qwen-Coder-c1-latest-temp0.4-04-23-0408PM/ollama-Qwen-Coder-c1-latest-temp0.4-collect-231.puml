@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts About Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as CFR004
  usecase "CFR005: Manage Personalized Recommendations Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as CFR006
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "CFR009: Access a Personalized Dashboard That Consolidates Financial Information in a Single View" as CFR009
  usecase "CFR010: Manage Relationship with Financial Advisors, Including Permissions for Sharing Data" as CFR010
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR010
  
  usecase "CFR011: Send Feedback About System's Recommendations and Insights" as CFR011
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA

  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts When Patterns Require Professional Attention" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments Based on Different Profiles and Regulatory Requirements" as FAFR004
  
  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004

  usecase "CFR011: Send Feedback About System's Recommendations and Insights" as CFR011
}

package "System Administrator" {
  actor SysAdmin
  
  usecase "SAFR001: Manage Analysis Parameters for the AI System to Ensure Accuracy, Relevance, and Compliance with Financial Regulations" as SAFR001

  SysAdmin --> SAFR001

  usecase "CFR011: Send Feedback About System's Recommendations and Insights" as CFR011
}

package "System Components" {
  rectangle "SFR (System Functions)" {
    usecase "SFR001: Deliver Alerts to Users Through Appropriate Notification Channels" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002
    usecase "SFR003: Request Financial Predictions from the AI Component" as SFR003
    usecase "SFR004: Request Personalized Recommendations from the AI Component Based on Each User's Data and Preferences" as SFR004
    usecase "SFR005: Request Spending Limit Alerts From the AI Component When Spending Patterns Exceed Defined Thresholds" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from the AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities From the AI Component That Match User Criteria and ESG Preferences" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from the AI Component to Detect Potentially Fraudulent Activities in Accordance with AML Regulations" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios From Trusted Sources" as SFR009
    usecase "SFR010: Process Contextualized News To Extract Relevant Information for Users' Situations" as SFR010
    usecase "SFR011: Request Contextualized News Insights from the AI Component to Identify Potential Impacts on Users' Investments" as SFR011
    usecase "SFR012: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as SFR012
    usecase "SFR013: Generate Client Alerts Based On Predefined Conditions to Ensure Timely Notification of Important Events" as SFR013
    usecase "SFR014: Generate Client Analytics That Provide Meaningful Insights Into Financial Behavior and Performance" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses From the AI Component to Identify When Advisors Should Engage With Clients" as SFR015
    usecase "SFR016: Request Predictive Insights From the AI Component to Enhance Financial Guidance Provided to Clients" as SFR016
    usecase "SFR017: Generate Financial Health Reports That Assess Users' Overall Wellbeing According To Standard Ratios and Metrics" as SFR017
    usecase "SFR018: Manage Users' Financial Goals to Track Progress and Provide Relevant Recommendations" as SFR018
    usecase "SFR019: Maintain a Historical Record of Users' Insights to Enable Trend Analysis and Effectiveness Measurement" as SFR019
    usecase "SFR020: Manage User Feedback To Continuously Improve the Quality and Relevance Of Financial Insights" as SFR020
  }

  rectangle "AIFR (AI Functions)" {
    usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Data, Market Trends, and Economic Indicators" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations Based on User Profiles, Goals, and Risk Tolerance As Defined By Industry Standards" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations From Established Patterns" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses For Users By Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities for Users by Identifying Instruments That Align With Their Strategies and Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts By Employing Pattern Recognition To Detect Potentially Fraudulent Activities In Compliance With FinCEN Requirements" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations By Identifying Patterns That Indicate Potential Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights that Provide Forward-Looking Analysis of Financial Situations to Support More Effective Planning" as AIFR009
  }
}

@enduml