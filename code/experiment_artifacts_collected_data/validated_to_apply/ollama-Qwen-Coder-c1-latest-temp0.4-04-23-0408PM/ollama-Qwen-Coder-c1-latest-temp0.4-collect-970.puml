@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics about My Clients' Financial Situations" as FAFR003
  
  Client --> (CFR001)
  SysAdmin --> (SAFR001)
  FAFD --> (FAFR003)
}

rectangle "Client Dashboard" {
  usecase "SFR012: Generate Client Dashboards that Present Financial Information in an Intuitive and Actionable Format" as SFR012
  usecase "CFR009: Access a Personalized Dashboard That Consolidates My Financial Information in a Single View to Efficiently Monitor My Finances" as CFR009
  
  Client --> (SFR012)
  Client --> (CFR009)
}

rectangle "Client Alerts and Recommendations" {
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR013
  usecase "SAFR005: Request Spending Limit Alerts from the AI Component When User Spending Patterns Exceed Defined Thresholds" as SAFR005
  
  Client --> (SFR013)
  SysAdmin --> (SAFR005)
}

rectangle "Financial Predictions and Recommendations" {
  usecase "SFR003: Request Financial Predictions from the AI Component to Provide Users with Forward-Looking Financial Insights" as SFR003
  usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
  
  Client --> (SFR003)
  SysAdmin --> (SAFR005)
}

rectangle "Investment Opportunities" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile (as Defined Under MiFID II or Equivalent Standards) to Diversify My Portfolio and Maximize Returns" as CFR007
  usecase "SFR016: Request Predictive Insights from the AI Component to Enhance the Value of Financial Guidance Provided to Clients" as SFR016
  
  Client --> (CFR007)
  SysAdmin --> (SAFR005)
}

rectangle "News and Analytics" {
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios from Trusted Financial News Sources" as SFR009
  usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
  
  Client --> (SFR009)
}

rectangle "Feedback and Improvement" {
  usecase "CFR11: Send Feedback about the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as CFR11
  
  SysAdmin --> (SAFR020)
  FAFD --> (FAFR15)
}

@enduml