@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as Client
:User (Financial Advisor): as FinancialAdvisor
:System Administrator: as SysAdmin
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001

  rectangle "Client Use Cases" {
    Client --> CFR001 : "View Dashboard"
    Client --> SAFR001 : "Manage Parameters"
    Client --> FAFR002 : "Receive Alerts"
    Client --> SFR003 : "Request Predictions"
    Client --> AIFR001 : "Generate Predictions"
  }

  rectangle "Financial Advisor Use Cases" {
    FinancialAdvisor --> SAFR001 : "Manage Parameters"
    FinancialAdvisor --> FAFR002 : "Receive Alerts"
    FinancialAdvisor --> SFR003 : "Request Predictions"
    FinancialAdvisor --> AIFR004 : "Generate Recommendations"
  }

  rectangle "System Administrator Use Cases" {
    SysAdmin --> SAFR001 : "Manage Parameters"
    SysAdmin --> SFR002 : "Deliver Personalized Recommendations"
  }
}

rectangle "Notifications and Alerts" {
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003

  Sys --> (Client) : "Spending Limits"
}

rectangle "Investment Opportunities and Recommendations" {
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004

  Sys --> (Client) : "Investment Opportunities"
}

rectangle "News and Insights" {
  usecase "SFR013: Request Contextualized News from AI Component" as SFR013
  usecase "AIFR007: Generate Contextualized News Insights for Users" as AIFR007

  Sys --> (Client) : "News"
}

rectangle "Feedback and Improvement" {
  usecase "CFR011: Send Feedback about System's Recommendations and Insights" as CFR011
  Client --> CFR011 : "Provide Feedback"

}
@enduml