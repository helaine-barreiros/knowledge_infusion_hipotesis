@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10

  Client --> (View)
}

package "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004

  FinancialAdvisor --> (Manage)
}

package "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SystemAdministrator --> (Configure)
}

package "System" {
  rectangle "Notification Channel" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    usecase "SFR002: Generate Client Dashboards" as SFR002
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities from AI Component Matching Criteria and Preferences" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
    usecase "SFR010: Process Contextualized News for Users" as SFR010
    usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
    usecase "SFR012: Generate Client Alerts Based on Predefined Conditions" as SFR012
    usecase "SFR013: Manage Users' Financial Goals to Track Progress and Provide Recommendations" as SFR018
  }

  rectangle "Financial Insights Generation" {
    usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations Based on Profiles and Goals" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Patterns" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users Based on Risk Profiles and Goals" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities by Identifying Financial Instruments That Align with Strategies and Modern Portfolio Theory Principles" as AIFR005
  }

  rectangle "AI Components" {
    usecase "SFR016: Request Predictive Insights from AI Component to Enhance Value of Guidance Provided to Clients" as SFR016
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Planning" as AIFR009
  }

  rectangle "Reporting and Feedback Management" {
    usecase "SFR17: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Ratios and Metrics" as SFR17
    usecase "CFR11: Send Feedback About System's Recommendations and Insights" as CFR11
  }

  rectangle "Data Management" {
    usecase "SFR020: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR020
    usecase "SFR019: Maintain a Historical Record of Users' Insights for Trend Analysis and Effectiveness Measurement" as SFR019
  }
}

Client --> (CFR001)
Client --> (CFR003)
Client --> (CFR004)
Client --> (CFR006)
Client --> (CFR007)
Client --> (SFR020)

FinancialAdvisor --> (FAFR001)
FinancialAdvisor --> (AIFR008)
FinancialAdvisor --> (AIFR009)

SystemAdministrator --> (SAFR001)

@enduml