@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR005
  usecase "CFR003: View Financial Predictions" as SAFR007
  usecase "CFR004: Receive Personalized Recommendations" as SAFR016
  usecase "CFR005: Manage Recommendation Preferences" as SAFR020
  usecase "CFR006: View Spending Limit Alerts" as SAFR037
  usecase "CFR007: View Investment Opportunities Suitable to Risk Profile" as SAFR041
  usecase "CFR008: View News Related to Investment Portfolio" as SAFR052
  usecase "CFR009: Access Personalized Dashboard" as SFR012
  usecase "CFR10: Manage Relationship with Financial Advisors" as AIFR036
  
  CFR001 --> (SAFR005)
  CFR001 --> (SAFR007)
  CFR001 --> (SAFR016)
  CFR001 --> (SAFR020)
  CFR001 --> (SAFR037)
  CFR001 --> (SAFR041)
  CFR001 --> (SAFR052)
  CFR001 --> (SFR012)
  CFR001 --> (AIFR036)
}

package "Financial Advisors" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts" as SAFR045
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as AIFR009
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR012
  
  FAFR001 --> (SAFR045)
  FAFR001 --> (AIFR009)
  FAFR001 --> (FAFR012)
}

package "System Administrator" {
  actor SystemAdmin as SAFR001
  
  usecase "SAFR001: Manage Analysis Parameters for the AI system" as SAFR038
  usecase "SFR019: Maintain a Historical Record of Users' Insights" as SFR019
  
  SAFR001 --> (SAFR038)
  SAFR001 --> (SFR019)
}

package "System Components" {
  rectangle SystemComponents {
    usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on User Strategies and Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News with User Portfolios" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR016

    SAFR038 --> (AIFR001)
    SFR012 --> (AIFR002)
    SAFR045 --> (AIFR003)
    SAFR041 --> (AIFR004)
    FAFR012 --> (AIFR005)
    SAFR089 --> (AIFR006)
    SAFR070 --> (AIFR007)
    SAFR030 --> (AIFR008)
    SFR040 --> (AIFR016)

  }
}

package "Feedback" {
  actor User as CFR011
  
  usecase "CFR011: Send Feedback about System's Recommendations and Insights" as AIFR039
  
  CFR011 --> (AIFR039)
}
@enduml