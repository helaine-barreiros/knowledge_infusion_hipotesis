@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive FATF Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR010: Manage Relationship with Advisors" as CFR010
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR010
  
  rectangle "System" {
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
    usecase "SFR005: Request Spending Limit Alerts" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Portfolios" as SFR009
    usecase "SFR010: Process Contextualized News for Users" as SFR010
    usecase "SFR011: Request Contextualized News Insights from AI" as SFR011
    usecase "SFR012: Generate Client Dashboards" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Conditions" as SFR013
    usecase "SFR014: Generate Client Analytics" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses from AI" as SFR015
    usecase "SFR016: Request Predictive Insights from AI" as SFR016
    usecase "SFR017: Generate Financial Health Reports" as SFR017
    usecase "SFR018: Manage Users' Financial Goals" as SFR018
    usecase "SFR019: Maintain Historical Record of Insights" as SFR019
    usecase "SFR020: Manage User Feedback for Improvement" as SFR020
    
    C --> SFR002
    C --> SFR003
    C --> SFR004
    C --> SFR005
    C --> SFR006
    C --> SFR007
    C --> SFR008
    C --> SFR009
    C --> SFR010
    C --> SFR011
    C --> SFR012
    C --> SFR013
    C --> SFR014
    C --> SFR015
    C --> SFR016
    C --> SFR017
    C --> SFR018
    C --> SFR019
    C --> SFR020
    
    rectangle "AI" {
      usecase "AIFR001: Generate Financial Predictions" as AIFR001
      usecase "AIFR002: Generate Personalized Recommendations Based on Profiles and Goals" as AIFR002
      usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations" as AIFR003
      usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
      usecase "AIFR005: Generate Investment Opportunities Based on User Strategies and Modern Portfolio Theory" as AIFR005
      usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition in Compliance with FinCEN Requirements" as AIFR006
      usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News With User Portfolios to Identify Relevant Impacts" as AIFR007
      usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns Indicating Potential Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
      usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Planning" as AIFR009
      
      SFR004 --> AIFR002
      SFR006 --> AIFR003
      SFR007 --> AIFR005
      SFR008 --> AIFR006
      SFR011 --> AIFR007
      SFR014 --> AIFR009
      
    }
  }
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004
  
  rectangle "System" {
    usecase "SFR015: Request Predictive Intervention Analyses from AI for Advisors" as SFR015
    
    FA --> SFR015
    
    rectangle "AI" {
      usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns Indicating Potential Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
      
      SFR015 --> AIFR008
    }
  }
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters for the AI System" as SAFR001
  
  SA --> SAFR001
  
  rectangle "System" {
    rectangle "AI" {
      usecase "AIFR001: Generate Financial Predictions Based on Historical Data, Market Trends, and Economic Indicators" as AIFR001
      
      SFR003 --> AIFR001
    }
  }
}

package "User (Client, Financial Advisor, or System Administrator)" {
  actor User as U
  
  usecase "CFR011: Send Feedback about Recommendations and Insights to Improve Future Outputs" as CFR011
  
  U --> CFR011
  
  rectangle "System" {
    usecase "SFR20: Manage User Feedback for Improvement" as SFR20
    
    U --> SFR20
  }
}

@enduml