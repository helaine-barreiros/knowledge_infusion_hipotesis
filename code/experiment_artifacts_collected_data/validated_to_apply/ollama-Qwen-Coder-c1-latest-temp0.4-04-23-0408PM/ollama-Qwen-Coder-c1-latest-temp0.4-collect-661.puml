@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR002
  
  usecase "FAFR003: View Predictive Analytics" as SAFR004
  usecase "FAFR005: Configure Analysis Parameters for Specific Client Segments" as SAFR016
}

package System {
  actor "System Administrator" as CFR007

  rectangle "AI Component" {
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR003
    usecase "AIFR004: Generate Spending Limit Alerts" as AIFR016
    usecase "AIFR005: Generate Investment Opportunity Analyses" as AIFR017
  }
  
  rectangle "Notification System" {
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR023
  }

  rectangle "News Processing System" {
    usecase "SFR016: Generate Client Predictive Insights" as SFR047
  }
  
  rectangle "Dashboard Generation System" {
    usecase "AIFR019: Generate Contextualized News Insights for Users' Portfolios" as AIFR253
  }

  rectangle "User Feedback Management System" {
    usecase "CFR011: Send Feedback about Recommendations and Insights to Improve Future Outputs" as CFR067
  }
}

rectangle "System" {
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios from Trusted Sources" as SFR248
  
  rectangle "Client Interaction System" {
    usecase "CFR015: Manage Relationship with Financial Advisors, including Permissions for Sharing Data" as CFR073
    usecase "SFR019: Maintain a Historical Record of Users' Insights to Enable Trend Analysis and Effectiveness Measurement" as SFR246
  }
  
  rectangle "User Dashboard System" {
    usecase "AIFR125: Generate Client Dashboards that Present Financial Information in an Intuitive Format" as AIFR309
  }

  rectangle "Predictive Intervention Analysis System" {
    usecase "SFR017: Request Predictive Intervention Analyses from AI Component to Identify When Advisors Should Engage with Clients" as SFR245
  }
}

rectangle "Financial Insights and Recommendations System" {
  usecase "AIFR039: Generate Financial Health Reports Assessing Users' Overall Wellbeing According to Standard Ratios and Metrics" as AIFR187
  
  rectangle "Predictive Analytics and Intervention System" {
    usecase "SFR025: Request Predictive Insights from AI Component to Enhance Value of Financial Guidance Provided to Clients" as SFR349
    usecase "AIFR036: Generate Client Predictive Interventions Recommendations by Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR175
  }
}

CFR001 --> (View Financial Insights Dashboard)
CFR002 --> (Receive Alerts about Anomalous Transactions in Accounts)
CFR003 --> (View Financial Predictions Based on Historical Data and Current Market Trends)
CFR004 --> (Receive Personalized Recommendations Aligned with My Financial Profile and Goals)
CFR005 --> (Manage Personalized Recommendations Preferences to Ensure Relevance)
CFR006 --> (View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories)
CFR007 --> (View Investment Opportunities Suitable to My Risk Profile)
CFR008 --> (View News Related to My Investment Portfolio)
CFR009 --> (Access a Personalized Dashboard That Consolidates Financial Information)
CFR010 --> (Manage Relationship with Financial Advisors, Including Permissions for Sharing Data)

FAFR002 --> SAFR004
FAFR005 --> SAFR016

SFR008 <|-- SFR23
SFR016 <|-- AIFR07
AIFR009 <|-- AIFR019
CFR011 --> CFR067

@enduml