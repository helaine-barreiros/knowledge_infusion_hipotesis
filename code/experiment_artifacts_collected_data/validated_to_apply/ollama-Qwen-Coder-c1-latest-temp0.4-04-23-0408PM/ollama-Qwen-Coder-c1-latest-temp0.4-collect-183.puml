@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SystemAdmin as SA
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  
  SA --> (SAFR001)
}

rectangle "AI Component" {
  package "Financial Insights Generation" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  }
  
  package "Investment Opportunities Generation" {
    usecase "AIFR005: Identify Suitable Investments Based on Risk Profile and Modern Portfolio Theory" as AIFR005
  }
  
  package "Anomaly Detection" {
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  }
  
  package "News Insights Generation" {
    usecase "AIFR007: Correlate Financial News with User Portfolios" as AIFR007
  }
}

rectangle "System Component" {
  package "Alerts Management" {
    usecase "SFR001: Deliver Alerts to Users Through Appropriate Notification Channels" as SFR001
  }
  
  package "Recommendations Generation" {
    usecase "SFR002: Deliver Personalized Recommendations Based on Financial Profiles" as SFR002
  }
  
  package "Predictive Analytics Request" {
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  }
  
  package "Recommendations Request" {
    usecase "SFR004: Request Personalized Recommendations from AI Component Based on User Data and Preferences" as SFR004
  }
  
  package "Spending Limit Alerts Request" {
    usecase "SFR005: Request Spending Limit Alerts From AI Component When Spending Patterns Exceed Defined Thresholds" as SFR005
  }
  
  package "Investment Opportunity Analysis Request" {
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component Based on User Risk Profiles and Criteria" as SFR006
  }
  
  package "Specific Investment Opportunities Request" {
    usecase "SFR007: Request Specific Investment Opportunities Matching User Preferences and ESG Standards" as SFR007
  }
  
  package "Anomaly Transaction Alerts Request" {
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component to Detect Potentially Fraudulent Activities in Compliance with AML Regulations" as SFR008
  }
  
  package "Contextualized News Retrieval" {
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios From Trusted Sources" as SFR009
  }
  
  package "News Processing and Insights Extraction" {
    usecase "SFR010: Process Contextualized News to Extract Relevance for User Situations" as SFR010
  }
  
  package "Contextualized News Insights Request" {
    usecase "SFR011: Request Contextualized News Insights from AI Component to Identify Potential Impacts on Users' Investments" as SFR011
  }
  
  package "Client Dashboards Generation" {
    usecase "SFR012: Generate Client Dashboards Presenting Financial Information in an Intuitive and Actionable Format" as SFR012
  }
  
  package "Client Alerts Generation" {
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR013
  }
  
  package "Client Analytics Request" {
    usecase "SFR014: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR014
  }
  
  package "Predictive Intervention Analyses Request" {
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component to Identify When Advisors Should Engage with Clients" as SFR015
  }
  
  package "Predictive Insights Request" {
    usecase "SFR016: Request Predictive Insights From the AI Component To Enhance Value of Financial Guidance Provided to Clients" as SFR016
  }
  
  package "Financial Health Reports Generation" {
    usecase "SFR017: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Ratios and Metrics" as SFR017
  }
  
  package "User Goals Management" {
    usecase "SFR018: Manage User Feedback To Continuously Improve Quality of Recommendations and Insights" as SFR019
  }
}

rectangle "System" {
  rectangle "Client Interface" {
    C --> (CFR001)
    C --> (CFR002)
    C --> (CFR003)
    C --> (CFR004)
    C --> (CFR005)
    C --> (CFR006)
    C --> (CFR007)
    C --> (CFR008)
    C --> (CFR009)
    C --> (CFR10)
  }
  
  rectangle "Financial Advisor Interface" {
    FA --> (FAFR001)
    FA --> (FAFR002)
    FA --> (FAFR003)
    FA --> (FAFR004)
  }
  
  rectangle "System Administrator Interface" {
    SA --> (SAFR001)
  }
}

rectangle "AI System" {
  AIFR001 <|-- SFR003
  AIFR002 <|-- SFR004
  AIFR003 <|-- SFR005
  AIFR004 <|-- SFR006
  AIFR005 <|-- SFR007
  AIFR006 <|-- SFR008
  AIFR007 <|-- SFR009
  AIFR008 <|-- SFR013
  AIFR009 <|-- SFR014
  
  SFR002 --> (AIFR002)
  
  SFR015 --> (AIFR008)
  SFR016 --> (AIFR009)
}

@enduml