@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System: as Sys

rectangle "System" {
  usecase "CFR012: Generate Client Dashboards" as CFR012
  usecase "SFR013: Request Client Alerts" as SFR013
  usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
  
  User --> CFR012
  SysAdmin --> SAFR001
}

rectangle "Client Interactions" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  
  User --> CFR001
  User --> CFR002
  User --> CFR003
  User --> CFR004
  User --> CFR005
  User --> CFR006
  User --> CFR007
  User --> CFR008
  User --> CFR009
  
  System <|-- (CFR012)
}

rectangle "Financial Advisor Interactions" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Clients" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  
  FinancialAdvisor --> FAFR001
  FinancialAdvisor --> FAFR002
  FinancialAdvisor --> FAFR003
  
  System <|-- (FAFR001)
}

rectangle "System Administrator Interactions" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SysAdmin --> SAFR001
  
  System <|-- (SAFR001)
}

package "Feedback Mechanism" {
  usecase "CFR11: Send Feedback" as CFR11
  User --> CFR11
}
@enduml