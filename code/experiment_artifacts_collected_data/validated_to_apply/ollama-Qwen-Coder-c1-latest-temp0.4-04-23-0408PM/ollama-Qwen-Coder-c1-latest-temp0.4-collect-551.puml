@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Get Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Receive Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrators" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  SA --> (SAFR001)
}

rectangle "AI Components" {
    package "Financial Insights & Predictions" {
        usecase "AIFR001: Generate Financial Predictions" as AIFR001
        usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
        
        CFR003 --> (AIFR001)
        SAFR001 --> (AIFR001)
    }
    
    package "Personalized Recommendations & Alerts" {
        usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
        usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
        
        CFR004 --> (AIFR002)
        SAFR001 --> (SFR002)
    }
    
    package "Spending Limits & Alerts" {
        usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
        usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
        
        CFR006 --> (AIFR003)
    }
    
    package "Investment Opportunities & Insights" {
        usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
        usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
        
        CFR007 --> (AIFR004)
    }
    
    package "Anomaly Detection & News Insights" {
        usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
        usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition" as AIFR006
        
        CFR002 --> (AIFR006)
    }
    
    package "Contextualized News & Insights" {
        usecase "SFR013: Request Contextualized News for Users' Financial Situations from AI Component" as SFR013
        usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
        
        CFR008 --> (AIFR007)
    }
    
    package "Predictive Interventions & Insights" {
        usecase "SFR15: Request Predictive Intervention Analyses from AI Component" as SFR15
        usecase "AIFR009: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR009
        
        FAFR002 --> (AIFR009)
    }
    
    package "Financial Health & Analytics" {
        usecase "SFR14: Generate Client Analytics that Provide Meaningful Insights into Financial Behavior and Performance" as SFR14
        usecase "AIFR005: Generate Investment Opportunities for Users by Identifying Financial Instruments That Align with Their Investment Strategies and Modern Portfolio Theory Principles" as AIFR005
        
        CFR007 --> (AIFR005)
    }
    
}

package "System Operations & Management" {
  usecase "SFR12: Generate Client Dashboards that Present Financial Information in an Intuitive and Actionable Format" as SFR12
  usecase "SFR09: Request Contextualized News Insights from the AI Component to Identify Potential Impacts on Users' Investments" as SFR09
  
  CFR003 --> (SFR12)
}

package "Feedback Management" {
    usecase "CFR11: Send Feedback about System Recommendations and Insights" as CFR11
    
    C --> (CFR11)
}
@enduml