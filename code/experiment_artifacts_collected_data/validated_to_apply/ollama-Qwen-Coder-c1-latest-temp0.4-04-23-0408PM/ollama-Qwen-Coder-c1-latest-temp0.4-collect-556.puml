@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations" as SFR002
  usecase "CFR005: Manage Preferences for Recommendations" as CFR010
  
  Client --> (View Financial Insights Dashboard) : CFR001
  Client --> SAFR003
  Client --> SFR002
  Client --> CFR010
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR002: View Intervention Alerts" as SAFR004
  usecase "FAFR003: View Predictive Analytics" as SFR006
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as SAFR015
  
  FinancialAdvisor --> (Manage Client Mentoring Sessions) : FAFR001
  FinancialAdvisor --> SAFR004
  FinancialAdvisor --> SFR003
  FinancialAdvisor --> SAFR015
}

package "System Administrator" {
  actor SystemAdmin as SAFR001
  
  usecase "SAFR002: Manage Analysis Parameters for AI System" as SAFR001
  
  SystemAdmin --> (Manage Analysis Parameters) : SAFR001
}

rectangle "Notification & Alerts" {
  package "System" {
    actor System
    
    usecase "SFR003: Deliver Financial Predictions" as SFR003
    usecase "SFR004: Deliver Personalized Recommendations" as SFR002
    usecase "SFR005: Request Spending Limit Alerts" as SAFR017
    usecase "SFR006: Request Investment Opportunity Analysis" as AIFR003
    
    System --> (Deliver Financial Predictions) : SFR003
    System --> (Deliver Personalized Recommendations) : SFR002
    System --> SAFR017
  }
  
  package "AI Component" {
    actor AIComponent
    
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR006
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR007
    
    AIComponent --> (Generate Financial Predictions) : AIFR001
    AIComponent --> (Generate Spending Limit Alerts) : AIFR003
    AIComponent --> (Generate Investment Opportunity Analyses) : AIFR004
  }
}

package "News & Insights" {
  package "System" {
    usecase "SFR007: Request Contextualized News Insights" as SFR012
    
    System --> SFR012
  }

  package "AI Component" {
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR008
    
    AIComponent --> (Generate Contextualized News Insights) : AIFR007
  }
}

package "Predictive Interventions & Analytics" {
  package "System" {
    usecase "SFR015: Request Predictive Intervention Analyses" as SFR016

    System --> SFR016
  }

  package "AI Component" {
    usecase "AIFR008: Generate Client Predictive Interventions Recommendations" as AIFR009
    
    AIComponent --> (Generate Client Predictive Intervention Recommendations) : AIFR008
  }
}

package "User Feedback & System Improvement" {
  package "System" {
    usecase "SFR11: Request User Feedback" as SFR24

    System --> SFR24
  }

  package "AI Component" {
    usecase "AIFR10: Process and Improve Recommendations Based on Feedback" as AIFR25
    
    AIComponent --> (Process and Improve Recommendations) : AIFR25
  }
}

@enduml