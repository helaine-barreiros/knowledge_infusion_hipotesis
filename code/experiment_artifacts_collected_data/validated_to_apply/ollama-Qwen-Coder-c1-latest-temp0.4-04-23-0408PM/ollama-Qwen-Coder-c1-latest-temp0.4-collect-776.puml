@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SA --> SAFR001
}

rectangle "System Components" {
  package "User Interface" {
    usecase "SFR012: Generate Client Dashboards" as SFR012
  }
  
  package "Notification System" {
    usecase "SFR003: Deliver Alerts to Users" as SFR003
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  }
  
  package "Recommendation Engine" {
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  }
  
  package "Prediction and Analysis System" {
    usecase "SFR004: Request Financial Predictions from AI Component" as SFR004
    usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
    usecase "SFR006: Request Spending Limit Alerts from AI Component" as SFR006
    usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
    usecase "SFR007: Request Investment Opportunity Analysis from AI Component" as SFR007
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
    usecase "SFR15: Request Predictive Intervention Analyses from AI Component" as SFR15
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns" as AIFR008
  }
  
  package "News and Insights System" {
    usecase "SFR009: Request Contextualized News from AI Component" as SFR009
    usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
  }
  
  package "Feedback System" {
    usecase "CFR11: Send Feedback about Recommendations and Insights" as CFR11
    
    C --> CFR11
    FA --> CFR11
    SA --> CFR11
  }
}

@enduml