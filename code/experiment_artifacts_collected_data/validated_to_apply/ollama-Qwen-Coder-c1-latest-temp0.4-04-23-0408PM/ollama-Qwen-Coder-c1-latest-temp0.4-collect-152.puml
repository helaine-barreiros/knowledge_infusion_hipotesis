@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  
  C --> (SAFR001)
  C --> (FAFR002)
  C --> (SFR013)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  
  FA --> (SAFR001)
  FA --> (SFR015)
}

package "System Administrator" {
  actor SystemAdmin as SysA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  SysA --> (SFR020)
}

package "System" {
  rectangle SystemBoundary {
    usecase "SFR001: Deliver Alerts" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities from AI Component Matching User Criteria and ESG Preferences" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
    usecase "SFR010: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR010
    usecase "SFR011: Request Contextualized News Insights from AI Component Identifying Potential Impacts on Users' Investments" as SFR011
    usecase "SFR012: Generate Client Dashboards Presenting Financial Information in an Intuitive and Actionable Format" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions Ensuring Timely Notification of Important Financial Events" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component Identifying When Financial Advisors Should Engage with Clients" as SFR016
    usecase "SFR017: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR018
    usecase "SFR019: Manage Users' Financial Goals Tracking Progress Providing Relevant Recommendations" as SFR020
    usecase "SFR021: Maintain a Historical Record of Users' Insights Enabling Trend Analysis and Effectiveness Measurement" as SFR021
    
    C --> (SFR003)
    C --> (SFR004)
    C --> (SFR005)
    FA --> (SFR006)
    FA --> (SFR007)
    FA --> (SFR008)
    FAFR01 --> (AIFR003)
  }
}

package "AI System" {
  rectangle AIBoundary {
    usecase "AIFR001: Generate Financial Predictions for Users Analyzing Historical Transaction Data Market Trends and Economic Indicators" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations Based on User Profiles Goals and Risk Tolerance Industry Standards Like FINRA Guidelines" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses Evaluating Potential Investments Against User Risk Profiles Time Horizons and Financial Goals" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Identifying Financial Instruments Aligning with User Strategies Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts Employing Pattern Recognition Detecting Potentially Fraudulent Activities in Compliance With FinCEN Requirements" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News with Specific User Portfolios Identifying Relevant Impacts" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations Supporting More Effective Financial Planning" as AIFR010
    
    C --> (SFR023)
  }
}

C --> (CFR011)
FA --> (CFR011)
SysA --> (CFR011)

@enduml