@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR003: View Financial Predictions Based on Historical Data and Current Market Trends" as SAFR004
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as SAFR005
  usecase "CFR006: Manage Personalized Recommendations Preferences to Ensure Insights Relevant to My Financial Objectives and Risk Tolerance" as SAFR013
  usecase "CFR007: View Spending Limit Alerts When Exceed Predefined Thresholds in Specific Expense Categories" as SFR005
  
  CFR001 --> (SAFR002)
  CFR001 --> (SAFR004)
  CFR001 --> (SAFR005)
  CFR001 --> (SFR006)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts When System Detects Patterns Requiring Professional Attention" as SAFR007
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as SFR016
  
  FAFR001 --> (SAFR002)
  FAFR001 --> (SFR016)
}

package "System Administrator" {
  actor SystemAdmin as SAFR001
  
  usecase "SAFR001: Manage Analysis Parameters for the AI System to Ensure Algorithms Remain Accurate, Relevant, and Compliant with Financial Regulations Such as Basel III for Risk Management" as SAFR001
}

package "System Components" {
  rectangle "Alerts Delivery" {
    usecase "SFR001: Deliver Alerts to Users Through Appropriate Notification Channels" as SFR001
    
    CFR002 --> (SFR001)
    FAFR002 --> (SFR001)
    SAFR007 --> (SFR001)
  }
  
  rectangle "Personalized Recommendations" {
    usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002
    
    CFR004 --> (SFR002)
    FAFR003 --> (SFR002)
  }
  
  rectangle "Financial Predictions and Insights" {
    usecase "SFR003: Request Financial Predictions from the AI Component to Provide Users with Forward-Looking Financial Insights" as SFR003
    usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
    
    CFR002 --> (SFR003)
    FAFR003 --> (SFR003)
  }
  
  rectangle "Spending Limit Alerts" {
    usecase "SFR005: Request Spending Limit Alerts from the AI Component When User Spending Patterns Exceed Defined Thresholds" as SFR005
    usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations From Established Spending Patterns" as AIFR003
    
    CFR006 --> (SFR005)
  }
  
  rectangle "Investment Opportunities and Recommendations" {
    usecase "SFR012: Request Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as SFR012
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
    
    CFR007 --> (SFR012)
  }
  
  rectangle "News Insights" {
    usecase "SFR009: Request Contextualized News Relevant to Users' Financial Portfolios from Trusted Financial News Sources" as SFR009
    usecase "AIFR008: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
    
    CFR008 --> (SFR009)
  }
  
  rectangle "Client Predictive Insights and Intervention Recommendations" {
    usecase "AIFR012: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR016
    usecase "SFR015: Request Predictive Intervention Analyses from the AI Component to Identify When Financial Advisors Should Engage with Clients" as SFR015
    
    FAFR002 --> (AIFR012)
  }
}

package "User Feedback Management" {
  actor UserFeedback as CFR011
  
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights to Help Improve Accuracy and Relevance of Future Outputs" as SFR020
  
  CFR011 --> (SFR020)
}

@enduml