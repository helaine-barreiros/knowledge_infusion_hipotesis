@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001
:User: as User

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "AIFR009: Generate Contextualized News Insights" as AIFR009

  Client --> CFR001
  Client --> SAFR001
  Client --> FAFR002
  SysAdmin --> SAFR001
  FinancialAdvisor --> FAFR001
  User --> CFR001
  User --> SFR003
  User --> AIFR009

  rectangle "Client Features" {
    usecase "CFR002: View Alerts" as CFR002
    usecase "CFR003: View Predictions" as CFR003
    usecase "CFR004: Receive Recommendations" as CFR004
    usecase "CFR005: Manage Preferences" as CFR005
    usecase "CFR006: View Spending Limits" as CFR006
    usecase "CFR007: View Investment Opportunities" as CFR007
    usecase "CFR008: View News" as CFR008
    usecase "CFR009: Access Personalized Dashboard" as CFR009

    Client --> CFR002
    Client --> CFR003
    Client --> CFR004
    Client --> CFR005
    Client --> CFR006
    Client --> CFR007
    Client --> CFR008
    Client --> CFR009
  }

  rectangle "Financial Advisor Features" {
    usecase "FAFR01: Manage Mentoring Sessions" as FAFR01
    usecase "FAFR03: View Predictive Analytics" as FAFR03

    FinancialAdvisor --> FAFR01
    FinancialAdvisor --> FAFR03
  }

  rectangle "System Features" {
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
    usecase "SFR012: Generate Client Dashboards" as SFR012

    System --> SFR002
    System --> SFR004
    System --> SFR005
    System --> SFR006
    System --> SFR012
  }

  rectangle "AI Features" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities based on Modern Portfolio Theory" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006

    System --> AIFR001
    System --> AIFR002
    System --> AIFR003
    System --> AIFR004
    System --> AIFR005
    System --> AIFR006
  }
}

User <|-- Client
User <|-- FinancialAdvisor

@enduml