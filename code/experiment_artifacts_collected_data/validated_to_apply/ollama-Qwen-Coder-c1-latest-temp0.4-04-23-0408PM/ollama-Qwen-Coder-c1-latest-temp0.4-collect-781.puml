@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

' Actors
actor Client as C
actor FinancialAdvisor as FA
actor SysAdmin as SA
actor User as U

' Packages
package "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
}

package "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Clients" as FAFR002
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
}

package "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
}

package "System" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
