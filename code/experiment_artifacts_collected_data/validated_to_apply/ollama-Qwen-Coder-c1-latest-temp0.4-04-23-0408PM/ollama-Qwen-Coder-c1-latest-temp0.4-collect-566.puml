@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Deliver Personalized Recommendations" as SFR003
  
  Client --> CFR001
  Client --> (View Alerts)
  SysAdmin --> SAFR001
  FinancialAdvisor --> FAFR002
}

rectangle "Client Dashboard Features" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  
  Client --> CFR009
}

rectangle "Financial Prediction and Insights" {
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "SFR014: Generate Client Analytics" as SFR014
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  Client --> CFR003
  SysAdmin --> (Request Predictions)
}

rectangle "Investment and Risk Management" {
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "SFR016: Enhance Financial Guidance Insights" as SFR016
  
  Client --> CFR007
  SysAdmin --> (Request Investments)
}

rectangle "News and Updates" {
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "SFR009: Request Contextualized News Insights" as SFR009
  
  Client --> CFR008
  SysAdmin --> (Request News)
}

rectangle "User Management and Feedback" {
  usecase "CFR11: Send System Recommendations Feedback" as CFR11
  
  User -> CFR11
}
@enduml