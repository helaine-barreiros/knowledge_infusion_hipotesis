@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> FAFR003
  System --> (SFR002)
}

rectangle "Client Management" {
  usecase "CFR005: Manage Recommendations Preferences" as CFR005
  
  Client --> CFR005
}

rectangle "Spending Limits" {
  usecase "CFR010: View Spending Limit Alerts" as CFR010
  usecase "SFR005: Request Spending Limit Alerts" as SFR005
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  
  Client --> CFR010
}

rectangle "Investment Opportunities" {
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  Client --> CFR007
}

rectangle "News and Analytics" {
  usecase "CFR012: View News Related to Portfolio" as CFR012
  usecase "SFR008: Request Contextualized News Insights" as SFR008
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  
  Client --> CFR012
}

rectangle "Advisory and Mentoring" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "SFR015: Request Predictive Intervention Analyses" as SFR015
  
  FinancialAdvisor --> (FAFR001)
}

rectangle "Feedback Management" {
  usecase "CFR11: Send Feedback" as CFR11

  Client --> (CFR11)
}
@enduml