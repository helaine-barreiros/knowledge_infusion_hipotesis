@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure analysis parameters for specific client segments" as FAFR004
  
  Client --> (CFR001)
  SysAdmin --> (SAFR001)
  SysAdmin --> (FAFR004)
}

rectangle "Client Functions" {
  usecase "CFR002: View Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  
  Client --> (CFR002)
  Client --> (CFR003)
  Client --> (CFR004)
  Client --> (CFR005)
  Client --> (CFR006)
  Client --> (CFR007)
  Client --> (CFR008)
  Client --> (CFR012) : "Send Feedback"
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  
  Financial Advisor --> (FAFR001)
  Financial Advisor --> (FAFR002)
  Financial Advisor --> (FAFR003)
}

rectangle "System Functions" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities from AI" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to User Portfolio" as SFR009
  usecase "SFR10: Process Contextualized News for Users" as SFR10
  usecase "SFR11: Request Contextualized News Insights from AI" as SFR11
  usecase "SFR12: Generate Client Dashboards" as SFR12
  usecase "SFR13: Generate Client Alerts Based on Predefined Conditions" as SFR13
  usecase "SFR14: Generate Client Analytics Providing Meaningful Insights" as SFR14
  usecase "SFR15: Request Predictive Intervention Analyses from AI" as SFR15
  usecase "SFR16: Request Predictive Insights From the AI Component to Enhance Financial Guidance" as SFR16
  usecase "SFR17: Generate Financial Health Reports Assessing User's Overall Financial Wellbeing" as SFR17
  usecase "SFR18: Manage Users' Financial Goals Tracking Progress and Providing Relevant Recommendations" as SFR18
  usecase "SFR19: Maintain Historical Record of Users' Insights for Trend Analysis" as SFR19
  usecase "SFR20: Manage User Feedback to Continuously Improve System Outputs" as SFR20
  
  SysAdmin --> (SAFR001)
  FAFD --> (FAFR004)
}

@enduml