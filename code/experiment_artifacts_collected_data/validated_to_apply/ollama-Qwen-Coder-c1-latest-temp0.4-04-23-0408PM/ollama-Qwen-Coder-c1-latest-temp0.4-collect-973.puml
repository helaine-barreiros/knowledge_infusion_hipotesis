@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FinancialAdvisor
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  
  Client --> CFR001
  SystemAdmin --> SAFR001
  FinancialAdvisor --> FAFR002
}

rectangle "Client Features" {
  usecase "CFR002: View Alerts" as CFR002
  usecase "CFR003: View Predictions" as CFR003
  usecase "CFR004: Receive Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  
  Client --> CFR002
  Client --> CFR003
  Client --> CFR004
  Client --> CFR005
  Client --> CFR006
  Client --> CFR007
}

rectangle "Financial Advisor Features" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  
  FinancialAdvisor --> FAFR001
  FinancialAdvisor --> FAFR003
}

rectangle "System Features" {
  usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "SFR13: Generate Client Alerts Based on Predefined Conditions" as SFR13
  
  System --> SAFR001
  System --> FAFR002
  System --> SFR005
  System --> SFR006
  System --> SFR12
  System --> SFR13
}

rectangle "AI Features" {
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  usecase "AIFR004: Generate Spending Limit Alerts for Users" as AIFR004
  usecase "AIFR005: Generate Investment Opportunity Analyses for Users" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition" as AIFR006
  
  System --> AIFR002
  System --> AIFR004
  System --> AIFR005
  System --> AIFR006
