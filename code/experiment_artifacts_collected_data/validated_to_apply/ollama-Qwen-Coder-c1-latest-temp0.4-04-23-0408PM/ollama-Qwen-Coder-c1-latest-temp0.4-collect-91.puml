@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as CFR001
actor FinancialAdvisor as FAFR002
actor SysAdmin as SAFR003

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001a
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002a
  usecase "CFR003: View Financial Predictions" as CFR003a
  usecase "CFR004: Receive Personalized Recommendations" as CFR004a
  usecase "CFR005: Manage Recommendation Preferences" as CFR005a
  usecase "CFR006: View Spending Limit Alerts" as CFR006a
  usecase "CFR007: View Investment Opportunities" as CFR007a
  usecase "CFR008: View News Related to Portfolio" as CFR008a
  usecase "CFR009: Access Personalized Dashboard" as CFR009a
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10a
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001a
  usecase "FAFR002: View Intervention Alerts for Clients" as FAFR002a
  usecase "FAFR003: View Predictive Analytics about Client Financial Situations" as FAFR003a
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004a
}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001a
}

package System {
  rectangle "Notification Channel Management" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001a
  }
  
  rectangle "Recommendation Generation" {
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002a
  }

  rectangle "Financial Prediction Requesting" {
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003a
  }
  
  rectangle "Recommendation Requesting" {
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004a
  }

  rectangle "Spending Limit Alert Requesting" {
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005a
  }
  
  rectangle "Investment Opportunity Analysis Requesting" {
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006a
  }

  rectangle "Specific Investment Opportunities Requesting" {
    usecase "SFR007: Request Specific Investment Opportunities from AI Component Matching User Criteria and ESG Preferences" as SFR007a
  }
  
  rectangle "Anomaly Transaction Alert Requesting" {
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008a
  }

  rectangle "Contextualized News Requesting and Processing" {
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009a
    usecase "SFR010: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR010a
  }
  
  rectangle "News Insights Requesting and Generating" {
    usecase "SFR011: Request Contextualized News Insights from AI Component Identifying Potential Impacts on Users' Investments" as SFR011a
  }

  rectangle "Dashboard Generation" {
    usecase "SFR012: Generate Client Dashboards Presenting Financial Information in an Intuitive and Actionable Format" as SFR012a
  }
  
  rectangle "Client Alerts Requesting and Generating" {
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions Ensuring Timely Notification of Important Financial Events" as SFR013a
  }

  rectangle "Analytics Generation" {
    usecase "SFR014: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR014a
  }
  
  rectangle "Predictive Intervention Analysis Requesting and Generating" {
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component Identifying When Financial Advisors Should Engage with Clients" as SFR015a
  }

  rectangle "Predictive Insights Generation" {
    usecase "SFR016: Request Predictive Insights From the AI Component Enhancing the Value of Financial Guidance Provided to Clients" as SFR016a
  }
  
  rectangle "Financial Health Report Generating" {
    usecase "SFR017: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR017a
  }

  rectangle "User Goal Management" {
    usecase "SFR018: Manage User Goals Tracking Progress Providing Relevant Recommendations" as SFR018a
  }
  
  rectangle "Historical Record Management" {
    usecase "SFR019: Maintain a Historical Record of Users' Insights Enabling Trend Analysis and Effectiveness Measurement" as SFR019a
  }

  rectangle "User Feedback Management" {
    usecase "SFR020: Manage User Feedback Continuously Improving the Quality Relevance of Financial Insights" as SFR020a
  }
}

