@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  Client --> CFR001
  SysAdmin --> SAFR001
  
  rectangle "Client Features" {
    usecase "CFR002: View Alerts for Anomalous Transactions" as CFR002
    usecase "CFR003: View Financial Predictions" as CFR003
    usecase "CFR004: Receive Personalized Recommendations" as CFR004
    usecase "CFR005: Manage Recommendation Preferences" as CFR005
    usecase "CFR006: View Spending Limit Alerts" as CFR006
    usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
    
    Client --> CFR002
    Client --> CFR003
    Client --> CFR004
    Client --> CFR005
    Client --> CFR006
    Client --> CFR010
  }
  
  rectangle "Financial Advisor Features" {
    usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
    usecase "FAFR002: View Intervention Alerts for Clients" as FAFR002
    usecase "FAFR003: View Predictive Analytics about Client Situations" as FAFR003
    
    Financial Advisor --> FAFR001
    Financial Advisor --> FAFR002
    Financial Advisor --> FAFR003
  }
  
  rectangle "System Features" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities from AI Component Matching User Criteria and ESG Preferences" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
    usecase "SFR010: Process Contextualized News for Users' Financial Situations" as SFR010
    usecase "SFR011: Request Contextualized News Insights from AI Component Identifying Potential Impacts on Users' Investments" as SFR011
    usecase "SFR012: Generate Client Dashboards Presenting Financial Information in an Intuitive and Actionable Format" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions Ensuring Timely Notification of Important Financial Events" as SFR013
    usecase "SFR014: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component Identifying When Advisors Should Engage with Clients" as SFR015
    usecase "SFR016: Request Predictive Insights From the AI Component Enhancing Value of Financial Guidance Provided to Clients" as SFR016
    usecase "SFR017: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR017
    usecase "SFR018: Manage Users' Financial Goals Tracking Progress Providing Relevant Recommendations" as SFR018
    usecase "SFR019: Maintain a Historical Record of Users' Insights Enabling Trend Analysis and Effectiveness Measurement" as SFR019
    usecase "SFR020: Manage User Feedback Continuously Improving Quality Relevance of Financial Insights" as SFR020
    
    System Admin --> SAFR004
  }
  
  rectangle "AI Features" {
    usecase "AIFR001: Generate Financial Predictions for Users Analyzing Historical Data Market Trends and Economic Indicators" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Profiles Goals and Risk Tolerance Industry Standards Like FINRA Guidelines" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts for Users Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses For Users Evaluating Potential Investments Against Their Risk Profiles Time Horizons and Financial Goals" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities for Users Identifying Financial Instruments Aligning with Their Strategies Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts Employing Pattern Recognition Detecting Potentially Fraudulent Activities in Compliance With FinCEN Requirements" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News with Specific User Portfolios Identifying Relevant Impacts" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations Supporting More Effective Financial Planning" as AIFR009
    
    System Admin --> SAFR004
  }
  
  rectangle "User Feedback Feature" {
    usecase "CFR011: Send Feedback about System's Recommendations and Insights to Help Improve Future Outputs" as CFR011
    
    Client --> CFR011
    Financial Advisor --> CFR011
    SysAdmin --> SAFR004
  }
}

@enduml