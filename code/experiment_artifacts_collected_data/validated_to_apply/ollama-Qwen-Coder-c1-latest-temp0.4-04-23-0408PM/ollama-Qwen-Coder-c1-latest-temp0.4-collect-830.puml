@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR005: Manage Personalized Recommendations Preferences" as SAFR004
  usecase "CFR006: View Spending Limit Alerts" as SAFR010
  
  CFR001 --> SAFR002 : "View Financial Insights Dashboard"
  CFR001 --> SAFR003 : "Receive Alerts about Anomalous Transactions"
  CFR001 --> SAFR004 : "Manage Personalized Recommendations Preferences"
  CFR001 --> SAFR010 : "View Spending Limit Alerts"
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
  
  usecase "FAFR003: View Predictive Analytics about Client's Financial Situations" as SAFR005
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as AIFR017
  
  FinancialAdvisor --> SAFR002 : "Manage Client Mentoring Sessions"
  FinancialAdvisor --> SAFR003 : "View Predictive Analytics about Client's Financial Situations"
  FinancialAdvisor --> FAFR004 : "Configure Analysis Parameters for Specific Client Segments"
}

package "System" {
  actor System as SFR012
  
  usecase "SFR001: Deliver Alerts to Users through Appropriate Notification Channels" as SAFR006
  usecase "SFR003: Request Financial Predictions from the AI Component for Forward-Looking Insights" as AIFR001
  usecase "SFR004: Request Personalized Recommendations from the AI Component Based on User Data and Preferences" as AIFR002
  
  System --> SAFR006 : "Deliver Alerts to Users"
  System --> SFR003 : "Request Financial Predictions for Forward-Looking Insights"
  System --> SFR004 : "Request Personalized Recommendations Based on User Data and Preferences"
}

package "AI" {
  actor AI as AIFR016
  
  usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific Portfolios" as SAFR008
  usecase "AIFR009: Generate Client Predictive Intervention Recommendations Based on Identified Patterns" as AIFR015
  
  AI --> SFR006 : "Generate Anomaly Transaction Alerts"
  AI --> AIFR017 : "Generate Financial Health Reports"
  AI --> SAFR008 : "Generate Contextualized News Insights by Correlating Financial News with Specific Portfolios"
  AI --> AIFR015 : "Generate Client Predictive Intervention Recommendations Based on Identified Patterns"
}

package "System Administrator" {
  actor SystemAdmin as SAFR002
  
  usecase "SAFR001: Manage Analysis Parameters for the AI System to Ensure Compliance and Accuracy" as SAFR007
  usecase "SFR019: Maintain a Historical Record of Users' Insights to Enable Trend Analysis and Effectiveness Measurement" as AIFR024
  
  SystemAdmin --> SAFR002 : "Manage Client Mentoring Sessions"
  SystemAdmin --> SAFR007 : "Manage Analysis Parameters for the AI System"
}

package "User (Client, Financial Advisor, or System Administrator)" {
  actor User as CFR011
  usecase "CFR011: Send Feedback about Recommendations and Insights" as AIFR025
  
  User --> SAFR006 : "Send Feedback about Recommendations and Insights"
}

@enduml