@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFR001 --> FAFR003
}

rectangle "Client Management" {
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "SFR020: Manage User Feedback" as SFR020
  
  Client --> CFR005
  System --> SFR020
}

rectangle "Spending Management" {
  usecase "CFR010: View Spending Limit Alerts" as CFR010
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  
  Client --> CFR010
  System --> SFR005
}

rectangle "Investment Management" {
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  
  Client --> CFR007
  System --> SFR006
}

rectangle "News Management" {
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "SFR012: Generate Client Dashboards that Present Financial Information in an Intuitive and Actionable Format" as SFR012
  
  Client --> CFR008
}

rectangle "Financial Advisor Management" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "SFR004: Request Personalized Recommendations from AI Component Based on Each User's Financial Data and Preferences" as SFR004
  
  FAFR001 --> FAFR001
}

rectangle "System Alerts" {
  usecase "SAFR002: Manage Client Intervention Alerts When the System Detects Patterns Requiring Professional Attention to Proactively Assist Clients with Potential Financial Issues" as SAFR002
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR013
  
  SysAdmin --> SAFR002
}

rectangle "Historical Record Management" {
  usecase "SFR019: Maintain a Historical Record of Users' Insights to Enable Trend Analysis and Effectiveness Measurement" as SFR019
  
  System --> SFR019
}
@enduml