@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
}

package "System Administrator" {
  actor SysAdmin as SAFR003
}

rectangle "User (Client, Financial Advisor, or System Administrator)" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  
  CFR001 --> (View Financial Insights Dashboard)
  SAFR003 --> (Manage Analysis Parameters)
  FAFR002 --> (View Client Intervention Alerts)
}

rectangle "System" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities from AI" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  usecase "SFR10: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR10
  usecase "SFR11: Request Contextualized News Insights from AI" as SFR11
  usecase "SFR12: Generate Client Dashboards" as SFR12
  usecase "SFR13: Generate Client Alerts Based on Predefined Conditions" as SFR13
  usecase "SFR14: Generate Client Analytics that Provide Meaningful Insights into Financial Behavior and Performance" as SFR14
  usecase "SFR15: Request Predictive Intervention Analyses from AI" as SFR15
  usecase "SFR16: Request Predictive Insights from AI to Enhance the Value of Financial Guidance Provided to Clients" as SFR16
  usecase "SFR17: Generate Financial Health Reports" as SFR17
  usecase "SFR18: Manage Users' Financial Goals to Track Progress and Provide Relevant Recommendations" as SFR18
  usecase "SFR19: Maintain a Historical Record of Users' Insights for Trend Analysis and Effectiveness Measurement" as SFR19
  usecase "SFR20: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR20
  
  CFR001 --> (Deliver Alerts to Users)
  SAFR003 --> (Deliver Personalized Recommendations)
  FAFR002 --> (Request Predictive Intervention Analyses from AI)
  
  CFR001 --> (Generate Client Dashboards)
  SAFR003 --> (Generate Financial Health Reports)
  FAFR002 --> (Generate Client Analytics that Provide Meaningful Insights into Financial Behavior and Performance)
}

rectangle "AI System" {
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations Based on User Profiles, Goals, and Risk Tolerance" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users Based on Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities by Identifying Financial Instruments that Align with User Strategies and Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations Based on Identifying Patterns that Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  usecase "AIFR010: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR010
  
  CFR001 --> (Generate Personalized Recommendations Based on User Profiles, Goals, and Risk Tolerance)
  SAFR003 --> (Generate Financial Health Reports)
  FAFR002 --> (Generate Client Predictive Intervention Recommendations Based on Identifying Patterns that Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement)
  
  CFR001 --> (Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts)
  SAFR003 --> (Generate Client Analytics That Provide Meaningful Insights into Financial Behavior and Performance)
  FAFR002 --> (Generate Predictive Insights from AI to Enhance the Value of Financial Guidance Provided to Clients)
}

rectangle "User Feedback" {
  usecase "CFR11: Send Feedback About System's Recommendations and Insights" as CFR11
  
  CFR001 --> (Send Feedback About System's Recommendations and Insights)
}
@enduml