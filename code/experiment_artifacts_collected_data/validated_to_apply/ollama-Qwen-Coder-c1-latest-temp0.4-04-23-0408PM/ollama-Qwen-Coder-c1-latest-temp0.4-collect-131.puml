@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  usecase "CFR002: View Alerts" as SAFR003
  usecase "CFR003: View Financial Predictions" as SFR004
  usecase "CFR004: Receive Personalized Recommendations" as AIFR002
  usecase "CFR005: Manage Recommendation Preferences" as SAFR001
  usecase "CFR006: View Spending Limit Alerts" as SFR005
  usecase "CFR007: View Investment Opportunities" as AIFR004
  usecase "CFR008: View News Related to Portfolio" as SFR009
  usecase "CFR009: Access Personalized Dashboard" as SFR12
  usecase "CFR10: Manage Relationship with Financial Advisors" as SAFR005

  CFR001 --> (SAFR003)
  CFR001 --> (SFR004)
  CFR001 --> (AIFR002)
  CFR001 --> (SAFR001)
  CFR001 --> (SFR005)
  CFR001 --> (AIFR004)
  CFR001 --> (SFR009)
  CFR001 --> (SFR12)
  CFR001 --> (SAFR005)

}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as SAFR004
  usecase "FAFR003: View Predictive Analytics" as SFR006
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as AIFR005

  FAFR001 --> (SAFR004)
  FAFR001 --> (SFR006)
  FAFR001 --> (AIFR005)

}

package "System Administrator" {
  actor SystemAdministrator as SAFR001
  usecase "SAFR002: Manage Analysis Parameters for the AI system" as AIFR003

  SAFR001 --> (AIFR003)
}

rectangle "AI Component" {
    package "Prediction and Recommendations"{
        usecase "AIFR001: Generate Financial Predictions" as SFR025
        usecase "AIFR004: Generate Personalized Recommendations" as AIFR007

        SAFR003 --> (SFR025)
        SAFR004 --> (AIFR007)

    }
    
    package "Alerts and Interventions"{
        usecase "AIFR003: Generate Spending Limit Alerts" as SFR026
        usecase "AIFR008: Generate Anomaly Transaction Alerts" as AIFR015

        SAFR004 --> (SFR026)
        SAFR007 --> (AIFR015)

    }
    
    package "Investment Opportunities and News"{
        usecase "AIFR004: Generate Investment Opportunity Analyses" as SFR030
        usecase "AIFR009: Generate Contextualized News Insights" as AIFR027

        SAFR016 --> (SFR030)
        SAFR018 --> (AIFR027)

    }
    
}

package "System Operations"{
  usecase "SFR011: Request Financial Predictions from AI Component" as SFR045
  usecase "SFR016: Request Personalized Recommendations from AI Component" as AIFR030

  SAFR002 --> (AIFR030)
}

package "User Feedback Management"{
    actor UserFeedback as CFR011
    usecase "CFR011: Send Feedback about System's Recommendations and Insights" as SFR046
    
    UserFeedback --> (SFR046)

}
@enduml