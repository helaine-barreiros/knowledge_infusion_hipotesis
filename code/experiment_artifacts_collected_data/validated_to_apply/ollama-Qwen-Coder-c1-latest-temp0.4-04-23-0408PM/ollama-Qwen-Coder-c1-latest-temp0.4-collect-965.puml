@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "SFR013: Generate Client Alerts" as SFR013
  usecase "SFR014: Generate Client Analytics" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses" as SFR015
  usecase "SFR016: Request Predictive Insights" as SFR016
  usecase "SFR017: Generate Financial Health Reports" as SFR017
  usecase "SFR018: Manage Users' Financial Goals" as SFR018
  usecase "SFR019: Maintain Historical Record of Insights" as SFR019
  usecase "SFR020: Manage User Feedback" as SFR020
  
  rectangle "Client" {
    actor Client as C
    C --> CFR001 : View Financial Insights Dashboard
    C --> CFR002 : Receive Alerts about Anomalous Transactions
    C --> CFR003 : View Financial Predictions Based on Historical Data and Current Market Trends
    C --> CFR004 : Receive Personalized Recommendations Aligned with My Financial Profile and Goals
    C --> CFR005 : Manage Personalized Recommendations Preferences
    C --> CFR006 : View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories
    C --> CFR007 : View Investment Opportunities Suitable to My Risk Profile (as Defined Under MiFID II or Equivalent Standards)
    C --> CFR008 : View News Related to My Investment Portfolio
    C --> CFR009 : Access a Personalized Dashboard That Consolidates My Financial Information in a Single View
    C --> CFR10 : Manage Relationship with Financial Advisors, Including Permissions for Sharing Data
    
    Client --> SFR020 : Send Feedback About System's Recommendations and Insights
  }
  
  rectangle "Financial Advisor" {
    actor FA as FA
    FA --> FAFR001 : Manage Client Mentoring Sessions Based on System-Generated Insights
    FA --> FAFR002 : View Client Intervention Alerts When the System Detects Patterns Requiring Professional Attention
    FA --> FAFR003 : View Predictive Analytics About Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations
    
    rectangle "System" {
      usecase "SFR015: Request Predictive Intervention Analyses" as SFR015
      usecase "SFR016: Request Predictive Insights" as SFR016
      
      FA --> SFR012 : Generate Client Dashboards
      FA --> SFR013 : Generate Client Alerts
      FA --> SFR014 : Generate Client Analytics
    }
    
    FA --> AIFR008 : Generate Predictive Intervention Recommendations for Clients Based on Identified Patterns
      
  }
  
  rectangle "System Administrator" {
    actor SA as SA
    
    SA --> SAFR001 : Manage Analysis Parameters for the AI System to Ensure Compliance with Financial Regulations
    
    SA --> SFR020 : Manage User Feedback
  }

}

@enduml