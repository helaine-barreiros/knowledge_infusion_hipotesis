@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics about My Clients' Financial Situations" as FAFR003
  
  Client --> (CFR001)
  SysAdmin --> (SAFR001)
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts When the System Detects Patterns Requiring Professional Attention to Proactively Assist Clients with Potential Financial Issues" as FAFR002
  
  FAFD --> (FAFR001)
  FAFD --> (FAFR002)
}

rectangle "Client Functions" {
  usecase "CFR002: Receive Alerts About Anomalous Transactions in My Accounts to Quickly Identify Potential Fraud or Unusual Spending Patterns According to Regulations Set by the Financial Action Task Force (FATF)" as CFR002
  usecase "CFR003: View Financial Predictions Based on My Historical Data and Current Market Trends to Make More Informed Financial Decisions and Plan for Future Expenses" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals to Optimize My Financial Strategies and Investment Portfolio" as CFR004
  usecase "CFR005: Manage My Personalized Recommendations Preferences to Ensure the System Provides Insights Relevant to My Financial Objectives and Risk Tolerance As Defined in My KYC (Know Your Customer) Profile" as CFR005
  
  Client --> (CFR002)
  Client --> (CFR003)
  Client --> (CFR004)
  Client --> (CFR005)
}

rectangle "Spending Limits and Alerts" {
  usecase "CFR010: Manage My Relationship with Financial Advisors, Including Permissions for Sharing My Financial Data to Maintain Privacy and Control Over My Financial Information" as CFR010
  usecase "SFR003: Request Spending Limit Alerts from the AI Component When User Spending Patterns Exceed Defined Thresholds" as SFR005
  
  Client --> (CFR010)
}

rectangle "Investment Opportunities" {
  usecase "FAFR007: View Investment Opportunities Suitable to My Risk Profile (As Defined Under MiFID II or Equivalent Standards) to Diversify My Portfolio and Maximize Returns" as FAFR007
  usecase "SFR006: Request Investment Opportunity Analysis from the AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles" as SFR005
  
  Client --> (FAFR007)
}

rectangle "News and Insights" {
  usecase "CFR008: View News Related to My Investment Portfolio to Stay Informed About Market Events That Might Affect My Assets" as CFR008
  usecase "SFR013: Request Contextualized News from the AI Component to Identify Potential Impacts on Users' Investments" as SFR027
  
  Client --> (CFR008)
}

rectangle "System Functions" {
  usecase "SFR004: Request Personalized Recommendations from the AI Component Based on Each User's Financial Data and Preferences" as SFR005
  usecase "SFR016: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as SFR027
  
  Sys --> (SAFR001)
}

rectangle "User Feedback" {
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as CFR011
  
  Client -> (SFR028)
}
@enduml