@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as CFR001
}

package "Financial Advisors" {
  actor FinancialAdvisor as FAFR002
}

package "System Administrators" {
  actor SysAdmin as SAFR003
}

package "Users (Client, Financial Advisor, or System Administrator)" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Analysis Parameters for AI System" as SAFR002
  usecase "FAFR003: View Predictive Analytics about Client's Financial Situation" as FAFR003

  CFR001 --> (View)
  SAFR002 --> (Manage)
  FAFR003 --> (View)

  rectangle "Client Use Cases" {
    usecase "CFR002: View Alerts for Anomalous Transactions" as CFR002
    usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
    usecase "CFR004: Receive Personalized Recommendations Aligned with Financial Profile and Goals" as CFR004
    usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
    usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as CFR006
    usecase "CFR007: View Investment Opportunities Suitable to Risk Profile" as CFR007
    usecase "CFR008: View News Related to Investment Portfolio" as CFR008
    usecase "CFR009: Access Personalized Dashboard Consolidating Financial Information" as CFR009
  }

  rectangle "Financial Advisor Use Cases" {
    usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
    usecase "FAFR002: View Intervention Alerts for Potential Financial Issues" as FAFR002
    usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004

    CFR003 --> (View)
  }

  rectangle "System Use Cases" {
    usecase "SFR001: Deliver Alerts to Users Through Appropriate Notification Channels" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations Based on Financial Profiles" as SFR002
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR004: Request Personalized Recommendations From AI Component" as SFR004
    usecase "SFR005: Request Spending Limit Alerts From AI Component" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities Matching User Criteria and ESG Preferences" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts From AI Component" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
    usecase "SFR010: Process Contextualized News To Extract Relevant Information for User's Financial Situation" as SFR010
    usecase "SFR011: Request Contextualized News Insights From AI Component to Identify Potential Impacts on Users' Investments" as SFR011
    usecase "SFR012: Generate Client Dashboards Presenting Financial Information in an Intuitive and Actionable Format" as SFR012
    usecase "SFR013: Generate Client Alerts Based On Predefined Conditions To Ensure Timely Notification of Important Financial Events" as SFR013
    usecase "SFR014: Generate Client Analytics That Provide Meaningful Insights Into Financial Behavior and Performance" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses From AI Component to Identify When Financial Advisors Should Engage With Clients" as SFR015
    usecase "SFR016: Request Predictive Insights from AI Component To Enhance the Value of Financial Guidance Provided to Clients" as SFR016
    usecase "SFR017: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR017
    usecase "SFR018: Manage Users' Financial Goals To Track Progress And Provide Relevant Recommendations" as SFR018
    usecase "SFR019: Maintain Historical Record of Users' Insights To Enable Trend Analysis and Effectiveness Measurement" as SFR019
    usecase "SFR020: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR020

    CFR004 --> (View)
  }

  rectangle "AI System Use Cases" {
    usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations Based on User's Financial Profiles, Goals, and Risk Tolerance As Defined By Industry Standards Like FINRA Guidelines" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses For Users By Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities for Users by Identifying Financial Instruments That Align with User's Investment Strategies and Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts By Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance With FinCEN Requirements" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios To Identify Relevant Impacts" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations By Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights that Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009

    CFR005 --> (Manage)
  }
}

rectangle "System Boundary" {
  :Client: as CFR012
  :Financial Advisor: as FAFR014
  :SysAdmin: as SAFR016
}
@enduml