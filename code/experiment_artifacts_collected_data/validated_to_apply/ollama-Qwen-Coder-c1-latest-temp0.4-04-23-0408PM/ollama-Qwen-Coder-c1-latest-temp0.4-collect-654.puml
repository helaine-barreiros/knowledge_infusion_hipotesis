@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  Client --> (SFR012) : Generate client dashboards that present financial information in an intuitive and actionable format.
  SysAdmin --> SAFR001

  rectangle "Client Functions" {
    Client --> CFR001
    Client --> (SAFR005) : Manage personalized recommendations preferences to ensure the system provides insights relevant to my financial objectives and risk tolerance as defined in my KYC profile.
    Client --> (SFR003) : Request financial predictions from the AI component to provide users with forward-looking financial insights.
    Client --> (SFR004) : Request personalized recommendations from the AI component based on each user's financial data and preferences.
    Client --> (SFR016) : Generate client predictive insights that provide forward-looking analysis of financial situations to support more effective financial planning.
  }

  rectangle "Financial Advisor Functions" {
    FAFD --> (FAFR002) : View client intervention alerts when the system detects patterns requiring professional attention to proactively assist clients with potential financial issues.
    FAFD --> (FAFR016) : Generate client predictive insights that provide forward-looking analysis of financial situations to support more effective financial planning.
  }

  rectangle "System Functions" {
    Sys --> (SFR008) : Request anomaly transaction alerts from the AI component by employing pattern recognition to detect potentially fraudulent activities in compliance with FinCEN requirements.
    Sys --> (AIFR001) : Generate financial predictions for users by analyzing historical transaction data, market trends, and economic indicators.
  }

  rectangle "Notifications" {
    System --> (SFR013) : Generate client alerts based on predefined conditions to ensure timely notification of important financial events.
  }
}

rectangle "User Feedback Loop" {
  Client --> (CFR011) : Send feedback about the system's recommendations and insights to help improve the accuracy and relevance of future outputs.
}
@enduml