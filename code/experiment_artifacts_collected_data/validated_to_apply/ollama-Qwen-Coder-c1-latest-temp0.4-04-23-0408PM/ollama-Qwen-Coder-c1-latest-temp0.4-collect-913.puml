@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAdvisor
:User: as User

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAdvisor --> FAFR002
  User --> CFR001
  User --> SFR003
}

rectangle "Financial Insights Dashboard" {
  usecase "CFR009: Access Personalized Financial Dashboard" as CFR009
  
  Client --> CFR009
  SysAdmin --> SAFR001
  FAdvisor --> AIFR004
  User --> CFR009
}

rectangle "Personal Recommendations and Alerts" {
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "SAFR005: Request Spending Limit Alerts" as SAFR005
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  
  Client --> CFR002
  SysAdmin --> SAFR005
  FAdvisor --> FAFR001
}

rectangle "Investment Opportunities and News" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "SAFR006: Request Investment Opportunity Analysis" as SAFR006
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  
  Client --> CFR007
  SysAdmin --> SAFR006
  FAdvisor --> AIFR004
}

rectangle "News and Analytics" {
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "SFR019: Maintain a Historical Record of Users' Insights" as SFR019
  
  Client --> CFR008
}

rectangle "Feedback and Management" {
  usecase "CFR11: Send Feedback About System's Recommendations and Insights" as CFR11
  
  User --> CFR11
}
@enduml