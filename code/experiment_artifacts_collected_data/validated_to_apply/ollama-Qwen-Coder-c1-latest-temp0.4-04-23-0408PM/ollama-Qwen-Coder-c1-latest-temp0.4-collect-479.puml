@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations" as SAFR006
  usecase "CFR005: Manage Preferences for Recommendations" as SAFR018
  
  CFR001 --> SAFR002 : "View Alerts about Anomalous Transactions"
  CFR001 --> SAFR004 : "Receive Personalized Recommendations"
  CFR001 --> SAFR005 : "Manage Preferences for Recommendations"
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts" as SAFR008
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as SFR016
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as AIFR009
  
  FAFR001 --> SAFR002 : "View Client Intervention Alerts"
  FAFR001 --> SAFR003 : "View Predictive Analytics about Clients' Financial Situations"
  FAFR001 --> SAFR004 : "Configure Analysis Parameters for Specific Client Segments"
}

package "System" {
  actor System as SFR002
  
  usecase "SFR007: Request Investment Opportunity Analysis from AI Component" as AIFR005
  usecase "SFR13: Generate Client Alerts Based on Predefined Conditions" as SAFR008
  usecase "SFR14: Generate Client Analytics That Provide Meaningful Insights into Financial Behavior and Performance" as SFR017
  
  System --> AIFR005 : "Request Investment Opportunity Analysis from AI Component"
  System --> SAFR008 : "Generate Client Alerts Based on Predefined Conditions"
  System --> SFR014 : "Generate Client Analytics That Provide Meaningful Insights into Financial Behavior and Performance"
}

package "AI" {
  actor AI as AIFR002
  
  usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as SAFR015
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as SFR020
  
  AI --> SAFR013 : "Generate Client Alerts Based on Predefined Conditions"
  AI --> AIFR003 : "Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns"
  AI --> AIFR004 : "Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals"
}

package "User" {
  actor User as CFR011
  
  usecase "CFR011: Send Feedback about the System's Recommendations and Insights to Help Improve Future Outputs" as AIFR008
  
  User --> AIFR008 : "Send Feedback about the System's Recommendations and Insights"
}

@enduml