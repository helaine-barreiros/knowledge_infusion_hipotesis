@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR002
  
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
}

package System {
  actor "System Administrator" as SAFR001
  
  rectangle "Notification Channel" {
    usecase "SFR001: Deliver Alerts to Users Through Appropriate Notification Channels" as SFR001
  }
  
  rectangle "Personalized Recommendations" {
    usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002
  }
  
  rectangle "Financial Predictions" {
    usecase "SFR003: Request Financial Predictions from the AI Component" as SFR003
  }
  
  rectangle "Personalized Recommendations AI" {
    usecase "SFR004: Request Personalized Recommendations From the AI Component Based on Each User's Financial Data and Preferences" as SFR004
  }
  
  rectangle "Spending Limit Alerts" {
    usecase "SFR005: Request Spending Limit Alerts from the AI Component When User Spending Patterns Exceed Defined Thresholds" as SFR005
  }
  
  rectangle "Investment Opportunity Analysis" {
    usecase "SFR006: Request Investment Opportunity Analysis From the AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles" as SFR006
  }
  
  rectangle "Specific Investment Opportunities" {
    usecase "SFR007: Request Specific Investment Opportunities from the AI Component That Match User Investment Criteria and ESG Preferences" as SFR007
  }
  
  rectangle "Anomaly Transaction Alerts" {
    usecase "SFR008: Request Anomaly Transaction Alerts From the AI Component to Detect Potentially Fraudulent Activities in Accordance with AML Regulations" as SFR008
  }
  
  rectangle "Contextualized News Insights" {
    usecase "SFR010: Generate Contextualized News Insights by Correlating Financial News With Specific User Portfolios to Identify Relevant Impacts" as SFR010
  }
}

package AIComponent {
  actor "AI System" as AIFR001
  
  rectangle "Financial Predictions" {
    usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
  }
  
  rectangle "Personalized Recommendations AI" {
    usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance As Defined by Industry Standards Like FINRA Guidelines" as AIFR002
  }
  
  rectangle "Spending Limit Alerts" {
    usecase "AIFR003: Generate Spending Limit Alerts For Users By Identifying Unusual Deviations From Established Spending Patterns" as AIFR003
  }
  
  rectangle "Investment Opportunity Analysis" {
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  }
  
  rectangle "Investment Opportunities AI" {
    usecase "AIFR005: Generate Investment Opportunities For Users By Identifying Financial Instruments That Align With Their Investment Strategies and Modern Portfolio Theory Principles" as AIFR005
  }
  
  rectangle "Anomaly Transaction Alerts AI" {
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
  }
  
  rectangle "Contextualized News Insights AI" {
    usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News With Specific User Portfolios to Identify Relevant Impacts" as AIFR007
  }
  
  rectangle "Client Predictive Intervention Recommendations" {
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  }
}

package UserFeedback {
  actor "User (Client, Financial Advisor, System Administrator)" as CFR011
  
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as CFR011
}

rectangle "System Boundary" {
  Client --> CFR001 : "View Financial Insights Dashboard"
  Client --> CFR002 : "Receive Alerts for Anomalous Transactions"
  Client --> CFR003 : "View Financial Predictions"
  Client --> CFR004 : "Receive Personalized Recommendations"
  Client --> CFR005 : "Manage Recommendation Preferences"
  Client --> CFR006 : "View Spending Limit Alerts"
  Client --> CFR007 : "View Investment Opportunities"
  Client --> CFR008 : "View News Related to Portfolio"
  Client --> CFR009 : "Access Personalized Dashboard"
  Client --> CFR10 : "Manage Relationship with Financial Advisors"
  
  FinancialAdvisor --> FAFR002 : "Manage Mentoring Sessions"
  FinancialAdvisor --> FAFR003
  FinancialAdvisor --> FAFR004
  
  SystemAdministrator --> SAFR001 : "Manage Analysis Parameters"
  
  NotificationChannel --> SFR001
  PersonalizedRecommendations --> SFR002
  FinancialPredictions --> SFR003
  PersonalizedRecommendationsAI --> SFR004
  SpendingLimitAlerts --> SFR005
  InvestmentOpportunityAnalysis --> SFR006
  SpecificInvestmentOpportunities --> SFR007
  AnomalyTransactionAlerts --> SFR008
  
  ContextualizedNewsInsightsAI --> SFR010
  
  AIComponent --> AIFR001 : "Generate Financial Predictions"
  AIComponent --> AIFR002
  AIComponent --> AIFR003
  AIComponent --> AIFR004
  AIComponent --> AIFR005
  AIComponent --> AIFR006
  AIComponent --> AIFR007
  
  ClientPredictiveInterventionRecommendationsAI --> AIFR008 : "Generate Predictive Intervention Recommendations"
  
  UserFeedback --> CFR011
}

@enduml