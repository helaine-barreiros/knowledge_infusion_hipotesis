@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Predictive Analytics" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> (View Financial Insights Dashboard)
  C --> (Receive Anomaly Transaction Alerts)
  C --> (View Predictive Analytics)
  C --> (Receive Personalized Recommendations)
  C --> (Manage Recommendation Preferences)
  C --> (View Spending Limit Alerts)
  C --> (View Investment Opportunities)
  C --> (View Financial News)
  C --> (Access Personalized Dashboard)
  C --> (Manage Relationship with Advisors)
}

package "Financial Advisor" {
  actor "Financial Advisor" as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004
  
  FA --> (Manage Client Mentoring Sessions)
  FA --> (View Intervention Alerts)
  FA --> (View Predictive Analytics for Clients)
  FA --> (Configure Analysis Parameters by Client Segment)
}

package "System Administrator" {
  actor SysAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  SA --> (Manage Analysis Parameters)
}

rectangle "AI System" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Based on Modern Portfolio Theory" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  usecase "AIFR008: Generate Predictive Intervention Recommendations for Clients" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  C --> (Receive Financial Predictions)
  C --> (Receive Personalized Recommendations)
  C --> (Receive Spending Limit Alerts)
  C --> (View Investment Opportunities)
  FA --> (Receive Financial Predictions)
  FA --> (Receive Personalized Recommendations)
  SA --> (Generate Financial Predictions)
}

rectangle "System" {
  usecase "SFR001: Deliver User Notifications" as SFR001
  usecase "SFR002: Provide Personalized Recommendations to Users" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Based on ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Portfolios" as SFR009
  usecase "SFR010: Process Contextualized News for User Insights" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics for Financial Behavior and Performance" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
  usecase "SFR016: Request Predictive Insights from AI Component to Enhance Guidance" as SFR016
  usecase "SFR017: Generate Financial Health Reports for Users" as SFR017
  usecase "SFR018: Manage User Goals and Track Progress" as SFR018
  usecase "SFR019: Maintain Historical Record of Insights" as SFR019
  usecase "SFR020: Manage User Feedback for Continuous Improvement" as SFR020
  
  C --> (Receive Notifications)
  FA --> (Receive Recommendations and Alerts)
  SA --> (Manage Analysis Parameters)
}

C --> (Send Feedback)

@enduml