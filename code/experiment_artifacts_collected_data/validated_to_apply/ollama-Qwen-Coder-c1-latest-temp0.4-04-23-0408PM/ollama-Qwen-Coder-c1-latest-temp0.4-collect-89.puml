@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  Client --> CFR001
  SysAdmin --> SAFR001

  rectangle "Client Features" {
    usecase "CFR002: View Alerts for Anomalous Transactions" as CFR002
    usecase "CFR003: View Financial Predictions" as CFR003
    usecase "CFR004: Receive Personalized Recommendations" as CFR004
    usecase "CFR005: Manage Recommendation Preferences" as CFR005
    usecase "CFR006: View Spending Limit Alerts" as CFR006
    usecase "CFR007: View Investment Opportunities" as CFR007
    usecase "CFR008: View News Related to Portfolio" as CFR008
    usecase "CFR009: Access Personalized Dashboard" as CFR009
    usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
    
    Client --> CFR002
    Client --> CFR003
    Client --> CFR004
    Client --> CFR005
    Client --> CFR006
    Client --> CFR007
    Client --> CFR008
    Client --> CFR009
    Client --> CFR10

    rectangle "Client Alerts" {
      usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
      
      SysAdmin --> SFR013
      FAFD --> SFR013
      
      Client --> SFR013 : (Receive)
    }
  }

  rectangle "Financial Advisor Features" {
    usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
    usecase "FAFR002: View Intervention Alerts for Clients" as FAFR002
    usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
    usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
    
    Financial Advisor --> FAFR001
    Financial Advisor --> FAFR002
    Financial Advisor --> FAFR003
    Financial Administrator --> FAFR004

    rectangle "Financial Advisor Insights" {
      usecase "SFR016: Request Predictive Insights from AI Component" as SFR016
      
      SysAdmin --> SFR016
      Financial Advisor --> SFR016
      
      Financial Advisor --> SFR016 : (Receive)
    }
  }

  rectangle "System Features" {
    usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Profiles" as SFR002
    
    System Admin --> SFR002
    Financial Administrator --> SFR002

    rectangle "System Analytics and Predictions" {
      usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
      
      SysAdmin --> AIFR003
      FAFD --> AIFR003
      
      Financial Advisor --> AIFR003 : (Receive)
    }

    rectangle "System Recommendations and Insights" {
      usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Profiles, Goals, and Risk Tolerance as Defined by Industry Standards Like FINRA Guidelines" as AIFR002
      
      SysAdmin --> AIFR002
      FAFD --> AIFR002
      
      Financial Advisor --> AIFR002 : (Receive)
    }

    rectangle "System News and Insights" {
      usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
      
      SysAdmin --> AIFR007
      FAFD --> AIFR007
      
      Financial Advisor --> AIFR007 : (Receive)
    }

    rectangle "System Predictive Interventions and Insights" {
      usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
      
      SysAdmin --> AIFR008
      FAFD --> AIFR008
      
      Financial Advisor --> AIFR008 : (Receive)
    }
  }

  rectangle "AI System Features" {
    usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities for Users by Identifying Financial Instruments That Align with Their Investment Strategies and Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts By Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance With FinCEN Requirements" as AIFR006
    
    System Admin --> AIFR001
    FAFD --> AIFR004

    rectangle "AI Insights and Predictions" {
      usecase "AIFR009: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009
      
      SysAdmin --> AIFR009
      FAFD --> AIFR009
      
      Financial Advisor --> AIFR009 : (Receive)
    }
  }

  rectangle "User Feedback and Improvement" {
    usecase "CFR11: Send Feedback About System Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as CFR11
    
    Client --> CFR11
    Financial Advisor --> CFR11
    SysAdmin --> CFR11

    rectangle "User Feedback Management" {
      usecase "SFR020: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR020
      
      System Admin --> SFR020
      FAFD --> SFR020
      
      Client --> SFR020 : (Provide)
    }
  }

}

@enduml