@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
  
  usecase "CFR11: Send Feedback" as CFR11
  C --> (SAFR005) : CFR11
}

package FinancialAdvisor {
  actor "Financial Advisor" as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FA --> (SAFR005) : FAFR001
  FA --> (SFR027) : FAFR002
}

package System {
  actor "System Administrator" as SysAdmin
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities from AI Component Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  usecase "SFR10: Process Contextualized News to Extract Relevance for Users' Financial Situations" as SFR10
  usecase "SFR11: Request Contextualized News Insights from AI Component" as SFR11
  usecase "SFR12: Generate Client Dashboards" as SFR12
  usecase "SFR13: Generate Client Alerts Based on Predefined Conditions" as SFR13
  usecase "SFR14: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR14
  usecase "SFR15: Request Predictive Intervention Analyses from AI Component" as SFR15
  usecase "SFR16: Request Predictive Insights From the AI Component to Enhance Value of Financial Guidance Provided to Clients" as SFR16
  usecase "SFR17: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR17
  usecase "SFR18: Manage Users' Financial Goals Tracking Progress and Providing Relevant Recommendations" as SFR18
  usecase "SFR19: Maintain Historical Record of Users' Insights for Trend Analysis and Effectiveness Measurement" as SFR19
  usecase "SFR20: Manage User Feedback to Continuously Improve Quality and Relevance of Financial Insights" as SFR20
  
  SysAdmin --> SAFR001
}

package AI {
  actor "AI System" as AISys
  
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations Based on User Profiles, Goals, and Risk Tolerance" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Matching User Strategies and Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News With Specific User Portfolios to Identify Relevant Impacts" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009
  
  AISys --> (SFR12) : AIFR001
  AISys --> (SFR13) : AIFR002
  AISys --> (SFR15) : AIFR004
}

@enduml