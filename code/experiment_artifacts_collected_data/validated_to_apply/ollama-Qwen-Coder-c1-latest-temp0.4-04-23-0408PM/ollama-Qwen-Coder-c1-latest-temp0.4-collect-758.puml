@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as Client
:User (Financial Advisor): as FAdvisor
:System Administrator: as SysAdmin
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Deliver Personalized Recommendations" as SFR003
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  Client --> CFR001
  Client --> SAFR001
  FAdvisor --> FAFR002
  SysAdmin --> SAFR001

  rectangle "Client Dashboard Features" {
    usecase "CFR009: Access Personalized Dashboard" as CFR009
    usecase "SFR017: Generate Financial Health Reports" as SFR017
    
    Client --> CFR009
    SysAdmin --> CFR009
  }

  rectangle "Client Relationship Management" {
    usecase "CFR010: Manage Relationship with Advisors" as CFR010
    
    Client --> CFR010
  }
  
  rectangle "Alerts and Notifications" {
    usecase "SFR002: Deliver Alerts" as SFR002
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    
    Client --> SFR002
    SysAdmin --> SFR002
  }
  
  rectangle "Investment and Predictive Analytics" {
    usecase "CFR003: View Financial Predictions" as CFR003
    usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
    usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    
    Client --> CFR003
    FAdvisor --> FAFR001
  }
  
  rectangle "News and Information" {
    usecase "CFR008: View News Related to Portfolio" as CFR008
    usecase "SFR009: Find Contextualized News Relevant to User's Financial Portfolios" as SFR009
    
    Client --> CFR008
  }
  
  rectangle "Recommendations and Feedback Management" {
    usecase "CFR11: Send Feedback about System Recommendations and Insights" as CFR11
    
    Client --> CFR11
  }

}

@enduml