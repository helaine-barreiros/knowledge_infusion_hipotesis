@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  SA --> (SAFR001)
}

rectangle "AI Component" {
  rectangle "AIFR002: Generate Personalized Recommendations" as AIFR002
  rectangle "AIFR003: Generate Spending Limit Alerts" as AIFR003
  rectangle "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  rectangle "AIFR005: Generate Financial Predictions for Users" as AIFR005
  
  AIFR002 --> (SFR016)
  AIFR003 --> (SFR018)
  AIFR004 --> (SFR020)
  AIFR005 --> (SFR017)
}

rectangle "Notification System" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  rectangle "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  
  C --> (SFR001)
  FA --> (SFR001)
  SA --> (SFR001)
  
  AIFR002 <|-- (SAFR001)
  AIFR003 <|-- (SAFR001)
  AIFR004 <|-- (SAFR001)
  AIFR005 <|-- (SFR001)
  
  AIFR006 --> (SFR008)
}

rectangle "News Processing System" {
  usecase "SFR009: Find Contextualized News Relevant to Users' Portfolios" as SFR009
  rectangle "AIFR007: Generate Contextualized News Insights" as AIFR007
  
  C --> (SFR009)
  
  AIFR002 <|-- (SFR013)
  AIFR004 <|-- (SFR016)
}

rectangle "Dashboard Generation System" {
  usecase "SFR12: Generate Client Dashboards" as SFR12
  
  C --> (SFR12)
  
  AIFR005 <|-- (SFR13)
}

rectangle "Predictive Intervention Analysis System" {
  usecase "AIFR08: Generate Predictive Intervention Recommendations for Users" as AIFR08
  rectangle "SFR14: Request Predictive Insights from AI Component to Enhance Financial Guidance" as SFR14
  
  FA --> (AIFR08)
  
  AIFR02 <|-- (SFR16)
}

rectangle "AI News Processing System" {
  usecase "AIFR07: Generate Contextualized News Insights by Correlating with User Portfolios" as AIFR07
  
  C --> (AIFR07)
  
  AIFR02 <|-- (SFR13)
}

rectangle "Feedback Management System" {
  usecase "CFR11: Send Feedback about Recommendations and Insights" as CFR11
  rectangle "SFR20: Manage User Feedback to Improve Future Outputs" as SFR20
  
  C --> (CFR11)
  
  AIFR08 <|-- (SFR20)
}
@enduml