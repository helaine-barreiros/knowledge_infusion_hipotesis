@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004

  Client --> CFR001
  SysAdmin --> SAFR001
  FAFR002 <|-- (FAFR001)
}

rectangle "Financial Advisor Interface" {
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as FAFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004

  FAFR001 --> (FAFR002)
}

rectangle "Client Interface" {
  usecase "CFR002: View Alerts about Anomalous Transactions" as CFR002
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005

  Client --> (FAFR001)
}

rectangle "Investment Interface" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006

  Client --> (FAFR001)
}

rectangle "News Interface" {
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "SFR009: Request Contextualized News Relevant to Users' Financial Portfolios from Trusted Financial News Sources" as SFR009

  Client --> (FAFR001)
}

rectangle "Dashboard Interface" {
  usecase "CFR009: Access a Personalized Dashboard that Consolidates My Financial Information in a Single View" as CFR009
  usecase "SFR12: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as SFR12

  Client --> (FAFR001)
}

rectangle "Feedback Interface" {
  usecase "CFR11: Send Feedback about the System's Recommendations and Insights to Help Improve Future Outputs" as CFR11
  usecase "SFR20: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR20

  Client --> (FAFR001)
}

@enduml