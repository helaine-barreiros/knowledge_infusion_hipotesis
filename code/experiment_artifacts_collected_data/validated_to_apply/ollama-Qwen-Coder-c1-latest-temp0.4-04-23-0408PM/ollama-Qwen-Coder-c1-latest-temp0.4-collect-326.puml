@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Financial Client" {
  actor :Client: as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR003: View Financial Predictions" as SAFR004
  usecase "CFR004: Receive Personalized Recommendations" as SAFR005
  usecase "CFR005: Manage Recommendation Preferences" as SAFR019
  usecase "CFR006: View Spending Limit Alerts" as SAFR007
  usecase "CFR007: View Investment Opportunities" as SAFR008
  usecase "CFR008: View News Related to Portfolio" as SAFR10
  usecase "CFR009: Access Personalized Dashboard" as SFR023
  
  CFR001 --> (SAFR003)
  CFR001 --> (SAFR004)
  CFR001 --> (SAFR005)
  CFR001 --> (SAFR019)
  CFR001 --> (SAFR007)
  CFR001 --> (SAFR008)
  CFR001 --> (SFR023)
}

package "Financial Advisor" {
  actor :FinancialAdvisor: as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts" as SAFR009
  usecase "FAFR003: View Predictive Analytics for Clients" as SAFR014
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as AIFR007
  
  FAFR001 --> (SAFR009)
  FAFR001 --> (SAFR014)
  FAFR001 --> (AIFR007)
}

package "System Administrator" {
  actor :SysAdmin: as SAFR002
  
  usecase "SAFR006: Manage Analysis Parameters for AI System" as AIFR008
  usecase "CFR11: Send Feedback about Recommendations and Insights" as SFR035
  
  SysAdmin --> (AIFR008)
  SysAdmin --> (SFR035)
}

package "System Components" {
  rectangle "Notifications" { 
    usecase "SFR001: Deliver Alerts to Users" as AIFR009
  }
  
  rectangle "Recommendations" {
    usecase "SFR002: Deliver Personalized Recommendations" as AIFR010
  }
  
  rectangle "Predictions" { 
    usecase "SFR003: Request Financial Predictions from AI Component" as AIFR011
  }

  rectangle "Recommendations Generation" {
    usecase "SFR004: Request Personalized Recommendations from AI Component" as AIFR012
  }
  
  rectangle "Spending Limits Alerts" { 
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as AIFR013
  }

  rectangle "Investment Opportunities Analysis" {
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as AIFR014
  }
  
  rectangle "ESG Preferences Matching" { 
    usecase "SFR007: Request Specific Investment Opportunities from AI Component that Match User Criteria and ESG Preferences" as AIFR015
  }

  rectangle "Anomaly Detection Alerts" {
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as AIFR016
  }
  
  rectangle "News Insights Generation" { 
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as AIFR017
  }

  rectangle "Predictive Intervention Recommendations" {
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as AIFR023
  }
  
  rectangle "Enhanced Insights Generation" { 
    usecase "SFR016: Request Predictive Insights from AI Component to Enhance Financial Guidance" as AIFR024
  }

  rectangle "Financial Health Reports" {
    usecase "SFR017: Generate Financial Health Reports that Assess Users' Overall Financial Wellbeing According to Standard Ratios and Metrics" as AIFR035
  }
  
  rectangle "Goal Management" { 
    usecase "SFR018: Manage Users' Financial Goals to Track Progress and Provide Relevant Recommendations" as AIFR026
  }

  rectangle "Feedback Management" {
    usecase "SFR020: Request User Feedback to Continuously Improve the Quality of Financial Insights" as AIFR037
  }
}

@enduml