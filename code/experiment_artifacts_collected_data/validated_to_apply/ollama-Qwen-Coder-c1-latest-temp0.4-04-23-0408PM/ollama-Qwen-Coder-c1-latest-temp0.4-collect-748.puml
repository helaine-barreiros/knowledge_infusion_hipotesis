@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  rectangle "Client Dashboard" {
    usecase "CFR001: View Financial Insights Dashboard" as CFR001
    usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
    usecase "CFR003: View Financial Predictions" as CFR003
    usecase "CFR004: Receive Personalized Recommendations" as CFR004
    usecase "CFR005: Manage Recommendation Preferences" as CFR005
    usecase "CFR006: View Spending Limit Alerts" as CFR006
    usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
    
    C --> CFR001 : "View Dashboard"
    C --> CFR002 : "Receive Alerts"
    C --> CFR003 : "View Predictions"
    C --> CFR004 : "Get Recommendations"
    C --> CFR005 : "Manage Preferences"
    C --> CFR006 : "Check Spending Limits"
    C --> CFR10 : "Manage Advisors"
  }
}

package "Financial Advisors" {
  actor FinancialAdvisor as F
  
  rectangle "Advisory Services" {
    usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
    usecase "FAFR002: View Client Intervention Alerts" as FAFR002
    usecase "FAFR003: View Predictive Analytics" as FAFR003
    usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
    
    F --> FAFR001 : "Manage Sessions"
    F --> FAFR002 : "View Alerts"
    F --> FAFR003 : "Get Analytics"
    F --> FAFR004 : "Configure Parameters"
  }
}

package "System" {
  actor System as S
  
  rectangle "Core Functions" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions from AI" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities from AI" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from AI" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Portfolios" as SFR009
    usecase "SFR010: Process Contextualized News for Users" as SFR010
    usecase "SFR011: Request Contextualized News Insights from AI" as SFR011
    usecase "SFR012: Generate Client Dashboards" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
    usecase "SFR014: Generate Client Analytics for Financial Behavior and Performance" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses from AI" as SFR015
    usecase "SFR016: Request Predictive Insights from AI to Enhance Guidance" as SFR016
    usecase "SFR017: Generate Financial Health Reports" as SFR017
    usecase "SFR018: Manage Users' Financial Goals and Track Progress" as SFR018
    usecase "SFR019: Maintain Historical Record of Insights for Trend Analysis" as SFR019
    usecase "SFR020: Manage User Feedback to Improve Recommendations" as SFR020
    
    S --> SFR001 : "Deliver Alerts"
    S --> SFR002 : "Deliver Recommendations"
    S --> SFR003 : "Request Predictions from AI"
    S --> SFR004 : "Request Personalized Recommendations from AI"
    S --> SFR005 : "Request Spending Limit Alerts from AI"
    S --> SFR006 : "Request Investment Opportunity Analysis from AI"
    S --> SFR007 : "Request Specific Opportunities from AI"
    S --> SFR008 : "Request Anomaly Transaction Alerts from AI"
    S --> SFR009 : "Find Contextualized News"
    S --> SFR010 : "Process News for Users"
    S --> SFR011 : "Request News Insights from AI"
    S --> SFR012 : "Generate Dashboards"
    S --> SFR013 : "Generate Alerts Based on Conditions"
    S --> SFR014 : "Generate Analytics"
    S --> SFR015 : "Request Predictive Intervention Analyses from AI"
    S --> SFR016 : "Request Predictive Insights to Enhance Guidance"
    S --> SFR017 : "Generate Financial Health Reports"
    S --> SFR018 : "Manage Goals and Track Progress"
    S --> SFR019 : "Maintain Historical Record of Insights"
    S --> SFR020 : "Manage User Feedback for Improvement"
  }
}

package "AI System" {
  actor AI as A
  
  rectangle "AI Functions" {
    usecase "AIFR001: Generate Financial Predictions Based on Data and Trends" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations" as AIFR003
    usecase "AIFR004: Analyze Potential Investments Based on Risk Profiles and Goals" as AIFR004
    usecase "AIFR005: Identify Financial Instruments Aligning with Investment Strategies" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition" as AIFR006
    usecase "AIFR007: Correlate News to User Portfolios for Relevant Insights" as AIFR007
    usecase "AIFR008: Identify Patterns Indicating Potential Financial Difficulties or Opportunities" as AIFR008
    usecase "AIFR009: Provide Forward-Looking Analysis to Support Planning" as AIFR009
    
    S --> A : "Request Predictions"
    S --> A : "Request Recommendations"
    S --> A : "Request Spending Limit Alerts"
    S --> A : "Request Investment Opportunity Analyses"
    S --> A : "Generate Insights for Dashboards and Reports"
    
    A --> SFR012 : "Provide Client Dashboards"
    A --> SFR013 : "Deliver Contextualized News Insights to Users"
  }
}

package "Users" {
  actor User as U
  
  rectangle "User Actions" {
    usecase "CFR011: Send Feedback About Recommendations and Insights" as CFR011
    
    C, F, S --> CFR011 : "Send Feedback"
  }
}
@enduml