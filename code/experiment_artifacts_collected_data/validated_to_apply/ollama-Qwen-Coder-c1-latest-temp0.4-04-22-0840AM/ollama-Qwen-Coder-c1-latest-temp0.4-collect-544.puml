@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as SAFR004
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as SAFR005
  usecase "CFR005: Manage Personalized Recommendations Preferences to Ensure Insights Relevant to My Financial Objectives and Risk Tolerance" as SAFR019
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as SFR005
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile (as Defined Under MiFID II or Equivalent Standards)" as SAFR012
  usecase "CFR008: View News Related to My Investment Portfolio" as AIFR007
  usecase "CFR009: Access a Personalized Dashboard That Consolidates My Financial Information in a Single View" as SFR012
  usecase "CFR010: Manage Relationship with Financial Advisors, Including Permissions for Sharing My Financial Data" as SAFR006
  
  CFR001 --> SAFR003
  CFR001 --> SAFR004
  CFR001 --> SAFR005
  CFR001 --> SAFR019
  CFR001 --> SFR005
  CFR001 --> SAFR012
  CFR001 --> AIFR007
  CFR001 --> SAFR006
  
}

package "Financial Advisors" {
  actor FinancialAdvisor as FAFR001

  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as AIFR009
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments to Customize the System's Behavior According to Different Client Profiles and Regulatory Requirements Such As GDPR or CCPA" as SAFR018
  
  FAFR001 --> AIFR009
  FAFR001 --> SAFR018

}

package "System Administrators" {
  actor SysAdmin as SAFR001

  usecase "SAFR002: Manage Client Mentoring Sessions Based on System-Generated Insights to Provide More Valuable Guidance Aligned with Each Client's Financial Goals" as FAFR003
  usecase "SAFR004: View Predictive Intervention Alerts When the System Detects Patterns Requiring Professional Attention to Proactively Assist Clients With Potential Financial Issues" as AIFR015
  
  SAFR001 --> FAFR003
  SAFR001 --> AIFR015

}

package "System Components" {
  
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles to Support Better Financial Decision-Making" as SFR002
  usecase "SFR003: Request Financial Predictions from the AI Component to Provide Users With Forward-Looking Financial Insights" as AIFR001
  usecase "SFR004: Request Personalized Recommendations From the AI Component Based on Each User's Financial Data and Preferences" as AIFR002
  usecase "SFR006: Request Investment Opportunity Analysis from the AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles" as AIFR003
  
  rectangle "Alerts Management System (AMS)" {
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR013
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
    
    AMS --> SFR013
    AMS --> AIFR006

  }

  
  rectangle "Dashboard System (DS)" {
    usecase "SFR12: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as SFR012
  
    DS --> SFR012
    
  }
  
  
  rectangle "News Management System (NMS)" {
    
    usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
    usecase "SFR10: Request Contextualized News from Trusted Financial News Sources and Extract Relevant Information for Users' Financial Situations" as SFR010
    
    NMS --> AIFR007
    NMS --> SFR010

  }
  
}

rectangle "AI System (AIS)" {
  
  
  usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals and Risk Tolerance as Defined by Industry Standards Like FINRA Guidelines" as AIFR002
  usecase "AIFR014: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR016
  
  
}

rectangle "System (Sys)" {
  
  
  usecase "SFR007: Request Specific Investment Opportunities from the AI Component that Match User Investment Criteria and ESG Preferences" as SFR007
  usecase "AIFR005: Generate Investment Opportunities for Users by Identifying Financial Instruments That Align with Their Investment Strategies and Modern Portfolio Theory Principles" as AIFR014
  
  
}

rectangle "User Feedback System (UFS)" {
  
  
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as SAFR020

}


@enduml