@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
  
  usecase "CFR002: View Financial Insights Dashboard" as CFR002
  usecase "SAFR003: Manage Analysis Parameters" as SAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  CFR001 --> (CFR002)
  CFR001 --> (SFR002)
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR005
  
  usecase "FAFR006: View Client Intervention Alerts" as FAFR006
  usecase "FAFR007: View Predictive Analytics About Clients' Financial Situations" as FAFR007
  usecase "FAFR008: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR008
  
  FAFR005 --> (FAFR006)
  FAFR005 --> (FAFR007)
  FAFR005 --> (FAFR008)
}

package System {
  actor "System Administrator" as SAFR002
  actor "Financial Advisor" as FAFR009
  
  usecase "SFR013: Deliver Alerts to Users Through Appropriate Notification Channels" as SFR013
  usecase "AIFR006: Generate Anomaly Transaction Alerts for Users by Employing Pattern Recognition" as AIFR006
  usecase "FAFR015: Request Predictive Intervention Analyses from the AI Component to Identify When Financial Advisors Should Engage with Clients" as FAFR015
  
  SAFR002 --> (SFR013)
  FAFR009 --> (AIFR006)
}

package System {
  usecase "SFR014: Generate Client Analytics That Provide Meaningful Insights into Financial Behavior and Performance" as SFR014
  usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
  
  SAFR002 --> (SFR014)
}

package System {
  usecase "SFR015: Request Predictive Intervention Analyses from the AI Component to Identify When Financial Advisors Should Engage with Clients" as SFR015
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  
  SAFR002 --> (SFR015)
}

package System {
  usecase "SFR016: Request Predictive Insights from the AI Component to Enhance the Value of Financial Guidance Provided to Clients" as SFR016
  usecase "AIFR009: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009
  
  SAFR002 --> (SFR016)
}

package System {
  usecase "SFR017: Generate Financial Health Reports that Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR017
  usecase "AIFR100: Analyze User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as AIFR100
  
  SAFR002 --> (SFR017)
}

package System {
  usecase "SFR018: Manage Users' Financial Goals to Track Progress and Provide Relevant Recommendations" as SFR018
  usecase "AIFR101: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as AIFR101
  
  SAFR002 --> (SFR018)
}

package System {
  usecase "SFR019: Maintain a Historical Record of Users' Insights to Enable Trend Analysis and Effectiveness Measurement" as SFR019
  usecase "AIFR102: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as AIFR102
  
  SAFR002 --> (SFR019)
}

package System {
  usecase "SFR020: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR020
  usecase "AIFR103: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR103
  
  SAFR002 --> (SFR020)
}

package System {
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights to Help Improve Future Outputs" as CFR011
  
  CFR001 --> (CFR011)
}
@enduml