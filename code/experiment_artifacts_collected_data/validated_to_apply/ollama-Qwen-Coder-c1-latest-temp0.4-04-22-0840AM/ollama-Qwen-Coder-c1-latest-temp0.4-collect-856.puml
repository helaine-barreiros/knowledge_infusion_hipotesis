@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Access Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Receive Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access Financial News" as CFR008
  usecase "CFR009: View Consolidated Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> (View Insights) : CFR001
  C --> (Receive Alerts) : CFR002
  C --> (Predictions) : CFR003
  C --> (Recommendations) : CFR004
  C --> (Manage Preferences) : CFR005
  C --> (Spending Limits) : CFR006
  C --> (Investment Opportunities) : CFR007
  C --> (Financial News) : CFR008
  C --> (Consolidated Dashboard) : CFR009
  C --> (Manage Advisors) : CFR10
  
}

package "System Administrator" {
  actor SysAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
    
  SA --> (Manage Params) : SAFR001
}

package "Financial Advisor" {
  actor FAF as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (Mentoring Sessions) : FAFR001
  FA --> (Intervention Alerts) : FAFR002
  FA --> (Predictive Analytics) : FAFR003
  FA --> (Configure Params) : FAFR004
}

package "System" {
  rectangle "Core System" {
    usecase "SFR001: Deliver Alerts" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions" as SFR003
    usecase "SFR004: Request Personalized Recommendations" as SFR004
    usecase "SFR005: Request Spending Limit Alerts" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts" as SFR008
    usecase "SFR009: Find Contextualized News" as SFR009
    usecase "SFR010: Process Contextualized News" as SFR010
    usecase "SFR011: Request Contextualized News Insights" as SFR011
    usecase "SFR012: Generate Client Dashboards" as SFR012
    usecase "SFR013: Generate Client Alerts" as SFR013
    usecase "SFR014: Generate Client Analytics" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses" as SFR015
    usecase "SFR016: Request Predictive Insights" as SFR016
    usecase "SFR017: Generate Financial Health Reports" as SFR017
    usecase "SFR018: Manage Users' Financial Goals" as SFR018
    usecase "SFR019: Maintain Historical Record of Insights" as SFR019
    usecase "SFR020: Manage User Feedback" as SFR020
    
  }
  
}

package "AI System" {
  rectangle "AI Component" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities based on Modern Portfolio Theory" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
    
  }
}

package "User (Client, Financial Advisor, or System Administrator)" {
  actor User as U
  
  usecase "CFR11: Send Feedback" as CFR11
  
  U --> (Send Feedback) : CFR11
}
@enduml