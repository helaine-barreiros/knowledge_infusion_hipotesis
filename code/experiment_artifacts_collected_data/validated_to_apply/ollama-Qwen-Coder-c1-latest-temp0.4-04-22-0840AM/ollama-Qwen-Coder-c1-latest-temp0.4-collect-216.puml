@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFD001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  rectangle "Client Functions" {
    Client --> CFR001 : View Financial Insights Dashboard
    Client --> SAFR005 : Manage Preferences for Recommendations
    Client --> SFR013 : Receive Alerts through Notification Channels
    Client --> CFR019 : Access Historical Records of Insights
    Client --> CFR020 : Send Feedback about System Outputs
  }
  
  rectangle "Financial Advisor Functions" {
    FAFD --> FAFD001 : Manage Client Mentoring Sessions
    FAFD --> SFR003 : View Predictive Analytics for Clients
    FAFD --> AIFR009 : Generate Client Predictive Intervention Recommendations
  }
  
  rectangle "System Administrator Functions" {
    SysAdmin --> SAFR001 : Manage Analysis Parameters
  }

  System --> CFR002 : Deliver Personalized Recommendations
  System --> SFR003 : Request Financial Predictions from AI Component
  System --> AIFR004 : Generate Investment Opportunity Analyses for Users
  System --> FAFD001 : View Client Intervention Alerts
  System --> SFR016 : Enhance the Value of Financial Guidance Provided to Clients
}

@enduml