@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAdvisor

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  Client --> CFR001
  Client --> SAFR001
  Client --> FAFR001
  SysAdmin --> SAFR001
  Financial Advisor --> FAFR001
}

rectangle "Client Dashboard Features" {
  usecase "CFR002: View Alerts" as CFR002
  usecase "SAFR005: Request Spending Limit Alerts" as SAFR005
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  
  Client --> CFR002
  SysAdmin --> SAFR005
  Financial Advisor --> FAFR002
}

rectangle "Investment and News Features" {
  usecase "CFR003: View Predictive Analytics" as CFR003
  usecase "SAFR006: Request Investment Opportunity Analysis" as SAFR006
  usecase "FAFR007: Configure Analysis Parameters for Client Segments" as FAFR007
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  Client --> CFR003
  SysAdmin --> SAFR006
  Financial Advisor --> FAFR007
}

rectangle "News and Insights Features" {
  usecase "CFR008: View News Related to Investment Portfolio" as CFR008
  usecase "SFR010: Process Contextualized News" as SFR010
  
  Client --> CFR008
  SysAdmin --> SFR010
}

rectangle "User Management Features" {
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
  usecase "SFR020: Manage User Feedback" as SFR020
  
  Client --> CFR010
  SysAdmin --> SFR020
}

rectangle "System Operations Features" {
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  
  SysAdmin --> SFR003
}

rectangle "AI System Features" {
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  
  SysAdmin --> SFR004

}

rectangle "Financial Health and Goals Features" {
  usecase "SFR17: Generate Financial Health Reports" as SFR17
  usecase "AIFR009: Generate Client Predictive Insights for Users" as AIFR009
  
  SysAdmin --> SFR17
}

rectangle "Feedback and Improvement Features" {
  usecase "CFR11: Send Feedback about System's Recommendations and Insights" as CFR11
  
  Client --> CFR11
}
@enduml