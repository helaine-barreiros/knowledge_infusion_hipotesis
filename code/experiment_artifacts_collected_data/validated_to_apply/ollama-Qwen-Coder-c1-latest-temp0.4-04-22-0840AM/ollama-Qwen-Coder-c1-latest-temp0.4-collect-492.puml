@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  Client --> CFR001
  Client --> SAFR001
  Client --> FAFR003
  Client --> SFR002
  Client --> AIFR004

  SysAdmin --> SAFR001

  Financial Advisor --> FAFR003
  Financial Advisor --> SFR002
  Financial Advisor --> AIFR004
  
}

rectangle "Notifications and Alerts" {
  usecase "SFR005: Request Spending Limit Alerts" as SFR005
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "SAFR002: Manage Analysis Parameters for Client Segments" as SAFR002
  
  Client --> (SFR005)
  SysAdmin --> (SAFR002)

}

rectangle "Personalization and Management" {
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "SFR003: Deliver Personalized Recommendations to Users Based on Financial Profiles" as SFR003
  
  Client --> (CFR004)
  Financial Advisor --> (FAFR001)

}

rectangle "Investment and News" {
  usecase "CFR007: View Investment Opportunities Suitable for My Risk Profile" as CFR007
  usecase "SFR008: Request Contextualized News Relevant to Users' Financial Portfolios" as SFR008
  
  Client --> (CFR007)
  System Admin --> (AIFR006)

}

rectangle "Feedback and Improvement" {
  usecase "CFR11: Send Feedback about the System's Recommendations and Insights" as CFR11

  Client --> (CFR11)
}
@enduml