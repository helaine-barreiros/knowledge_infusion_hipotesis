@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFD002
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  
  User --> CFR001
  SysAdmin --> SAFR001
  FAFD --> FAFD002
  System Admin --> AIFR006
}

rectangle "Client Dashboard Features" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  
  User --> CFR009
}

rectangle "Financial Insights and Recommendations" {
  usecase "SAFR002: Manage Analysis Parameters" as SAFR002
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  User --> SAFR002
  System Admin --> SAFR002
  FAFD --> SAFR002
  User --> AIFR001
  User --> AIFR002
}

rectangle "Spending Limits and Alerts" {
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  
  User --> CFR006
}

rectangle "Investment Opportunities and News" {
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: View Financial News Related to Portfolio" as CFR008
  
  User --> CFR007
  User --> CFR008
}

rectangle "Client Relationship Management" {
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  User --> CFR10
}

@enduml