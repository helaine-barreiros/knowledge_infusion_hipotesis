@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR005: Manage Recommendations Preferences" as SAFR005
  usecase "SFR009: Request Contextualized News" as SFR009
}

rectangle "Financial Advisor" {
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "AIFR004: Generate Investment Opportunity Analyses for Clients" as AIFR004
  usecase "SFR016: Request Predictive Insights from AI Component" as SFR016
}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "SFR020: Request User Feedback Management" as SFR020
}

rectangle "System" {
  usecase "SFR008: Delivers Alerts to Users" as SFR008
  usecase "AIFR001: Generate Financial Predictions for Clients" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations for Clients" as AIFR002
}

rectangle "AI System" {
  usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
  usecase "AIFR005: Generate Investment Opportunities Based on Risk Profiles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights for Users" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
}

rectangle "User (Client, Financial Advisor, or System Administrator)" {
  usecase "CFR011: Send Feedback to Improve Outputs" as CFR011
}

Client --> CFR001
Client --> SAFR005
Client --> SFR009

FinancialAdvisor --> FAFR002
FinancialAdvisor --> AIFR004
FinancialAdvisor --> SFR016

SystemAdministrator --> SAFR001
SystemAdministrator --> FAFR003
SystemAdministrator --> SFR020

System --> SFR008
System --> AIFR001
System --> AIFR002

AI System --> AIFR003
AI System --> AIFR005
AI System --> AIFR006
AI System --> AIFR007
AI System --> AIFR008

User --> CFR011

@enduml