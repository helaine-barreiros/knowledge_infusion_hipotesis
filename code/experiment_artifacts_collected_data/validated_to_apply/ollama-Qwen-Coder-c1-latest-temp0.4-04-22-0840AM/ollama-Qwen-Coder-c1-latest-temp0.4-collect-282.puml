@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR004
  usecase "CFR003: View Financial Predictions" as SAFR005
  usecase "CFR004: Receive Personalized Recommendations" as SAFR006
  usecase "CFR005: Manage Recommendation Preferences" as SAFR007
  usecase "CFR006: View Spending Limit Alerts" as SAFR008
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as SAFR012
  usecase "CFR008: View News Related to My Investment Portfolio" as SAFR013
  usecase "CFR009: Access a Personalized Dashboard" as SFR014
  usecase "CFR10: Manage Relationship with Financial Advisors" as SAFR026
  
  CFR001 --> SAFR004
  CFR001 --> SAFR005
  CFR001 --> SAFR006
  CFR001 --> SAFR007
  CFR001 --> SAFR008
  CFR001 --> SAFR012
  CFR001 --> SAFR013
  CFR001 --> SFR014
  CFR001 --> SAFR026
  
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts" as SAFR009
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as SAFR015
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as SAFR027
  
  FAFR001 --> SAFR009
  FAFR001 --> SAFR015
  FAFR001 --> SAFR027
}

package "System Administrator" {
  actor SystemAdministrator as SAFR001
  
  usecase "SAFR001: Manage Analysis Parameters for the AI System" as AIFR009
  
  SAFR001 --> AIFR009
}

package "AI System" {
  rectangle "System Components" {
    usecase "AIFR001: Generate Financial Predictions" as SFR028
    usecase "AIFR002: Generate Personalized Recommendations" as SFR030
    usecase "AIFR003: Generate Spending Limit Alerts" as SFR031
    usecase "AIFR004: Generate Investment Opportunity Analyses" as SFR032
    usecase "AIFR005: Generate Investment Opportunities for Users" as AIFR016
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as SFR037
    usecase "AIFR007: Generate Contextualized News Insights" as SFR040
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR019
    usecase "AIFR009: Generate Client Predictive Insights" as SFR035
    
    CFR011 --> SFR28
    CFR011 --> SFR30
    CFR011 --> SFR31
    CFR011 --> AIFR040
  }
}

package "System" {
  usecase "SFR001: Deliver Alerts to Users Through Appropriate Notification Channels" as SFR029
  usecase "SFR002: Deliver Personalized Recommendations Based on Users' Financial Profiles" as SAFR036
  usecase "SFR003: Request Financial Predictions from the AI Component" as AIFR018
  usecase "SFR004: Request Personalized Recommendations from the AI Component" as SFR29
  usecase "SFR005: Request Spending Limit Alerts from the AI Component" as SFR36
  usecase "SFR006: Request Investment Opportunity Analysis from the AI Component" as AIFR017
  usecase "SFR007: Request Specific Investment Opportunities from the AI Component That Match User Investment Criteria and ESG Preferences" as SFR42
  usecase "SFR008: Request Anomaly Transaction Alerts from the AI Component to Detect Potentially Fraudulent Activities in Accordance with AML Regulations" as SFR39
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios From Trusted Financial News Sources" as SAFR041
  usecase "SFR010: Process Contextualized News To Extract Relevant Information for Users' Financial Situations" as AIFR023
  usecase "SFR011: Request Contextualized News Insights from the AI Component to Identify Potential Impacts on Users' Investments" as SFR45
  usecase "SFR012: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as AIFR036
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR47
  usecase "SFR014: Generate Client Analytics That Provide Meaningful Insights into Financial Behavior and Performance" as AIFR025
  usecase "SFR015: Request Predictive Intervention Analyses from the AI Component to Identify When Financial Advisors Should Engage With Clients" as SFR38
  usecase "SFR016: Request Predictive Insights From the AI Component to Enhance the Value of Financial Guidance Provided to Clients" as AIFR024
  usecase "SFR017: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR53
  usecase "SFR018: Manage Users' Financial Goals To Track Progress and Provide Relevant Recommendations" as AIFR026
  usecase "SFR019: Maintain a Historical Record of Users' Insights To Enable Trend Analysis and Effectiveness Measurement" as SFR48
  usecase "SFR020: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as AIFR035
  
}
@enduml