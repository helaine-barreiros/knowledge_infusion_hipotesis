@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR002
  usecase "CFR003: View Financial Predictions" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations" as SAFR004
  usecase "CFR005: Manage Recommendation Preferences" as SAFR005
  usecase "CFR006: View Spending Limit Alerts" as SAFR006
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as SAFR007
  usecase "CFR008: View News Related to My Investment Portfolio" as SAFR008
  usecase "CFR009: Access Personalized Dashboard" as SAFR012
  usecase "CFR10: Manage Relationship with Financial Advisors" as SAFR014
  
  CFR001 --> (SAFR002)
  CFR001 --> (SAFR003)
  CFR001 --> (SAFR004)
  CFR001 --> (SAFR005)
  CFR001 --> (SAFR006)
  CFR001 --> (SAFR007)
  CFR001 --> (SAFR008)
  CFR001 --> (SAFR012)
  CFR001 --> (SAFR014)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts" as SAFR007
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as SAFR008
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as SAFR015
  
  FAFR001 --> (SAFR007)
  FAFR001 --> (SAFR008)
  FAFR001 --> (SAFR015)
}

package "System Administrator" {
  actor SystemAdministrator as SAFR009
  
  usecase "SAFR001: Manage Analysis Parameters for the AI System" as SAFR001
  usecase "SFR017: Generate Financial Health Reports" as SAFR016
  
  SAFR009 --> (SAFR001)
  SAFR009 --> (SAFR016)
}

package "System" {
  rectangle "Financial Insights System" {
    usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002
    usecase "SFR003: Request Financial Predictions from the AI Component" as AIFR001
    usecase "SFR004: Request Personalized Recommendations from the AI Component" as AIFR002
    usecase "SFR005: Request Spending Limit Alerts from the AI Component" as AIFR003
    usecase "SFR006: Request Investment Opportunity Analysis from the AI Component" as AIFR004
    usecase "SFR007: Request Specific Investment Opportunities from the AI Component That Match User Investment Criteria and ESG Preferences" as AIFR005
    usecase "SFR008: Request Anomaly Transaction Alerts from the AI Component" as AIFR006
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios From Trusted Financial News Sources" as SFR017
    usecase "SFR010: Process Contextualized News To Extract Relevant Information for Users' Financial Situations" as AIFR008
    usecase "SFR011: Request Contextualized News Insights from the AI Component to Identify Potential Impacts on Users' Investments" as SFR023
    usecase "SFR012: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as AIFR009
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR024
    usecase "SFR014: Generate Client Analytics That Provide Meaningful Insights into Financial Behavior and Performance" as AIFR010
    usecase "SFR015: Request Predictive Intervention Analyses from the AI Component to Identify When Financial Advisors Should Engage with Clients" as SFR026
    usecase "SFR016: Request Predictive Insights From the AI Component to Enhance the Value of Financial Guidance Provided to Clients" as AIFR011
    usecase "SFR018: Manage Users' Financial Goals to Track Progress and Provide Relevant Recommendations" as SFR027
  }
}

package "AI System" {
  rectangle "Artificial Intelligence Component" {
    usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance As Defined By Industry Standards Like FINRA Guidelines" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users By Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR005
    usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News With Specific User Portfolios to Identify Relevant Impacts" as AIFR012
  }
}

CFR011 --> (SFR034)
FAFR011 --> (SFR035)
SAFR011 --> (SFR036)

@enduml