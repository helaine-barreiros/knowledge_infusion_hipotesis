@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

rectangle "System" {
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR005
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR017: Generate Financial Health Reports" as SFR017
  
  CFR002 --> (SAFR005)
}

rectangle "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  rectangle "Client Mentoring Sessions" {
    usecase "FAFR003: View Predictive Analytics about Client's Financial Situation" as FAFR003
    usecase "SFR016: Request Predictive Insights from AI Component" as SFR016
    
    FAFR001 --> (FAFR003)
  }
  
  rectangle "Client Intervention Alerts" {
    usecase "FAFR002: View Client Intervention Alerts" as FAFR002
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
    
    FAFR001 --> (FAFR002)
  }
  
  rectangle "Client Recommendations" {
    usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
    usecase "SFR002: Request Personalized Recommendations from AI Component" as SFR002
    
    FAFR001 --> (AIFR002)
  }
  
  rectangle "Client Spending Limits" {
    usecase "CFR006: View Spending Limit Alerts" as SAFR004
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    
    FAFR001 --> (SAFR004)
  }
}

rectangle "System Administrator" {
  actor SystemAdmin as SAFR001
  
  rectangle "Manage Analysis Parameters" {
    usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
    usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
    
    SAFR001 --> (SAFR001)
  }
  
  rectangle "Manage Client Recommendations Preferences" {
    usecase "CFR005: Manage Personalized Recommendations Preferences" as CFR005
    usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
    
    SAFR001 --> (CFR005)
  }
}

rectangle "System Components" {
  rectangle "AI System" {
    usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities for Users by Identifying Financial Instruments that Align with Their Investment Strategies and Modern Portfolio Theory Principles" as AIFR005
    
    SAFR001 --> (AIFR003)
  }
  
  rectangle "News Processing Component" {
    usecase "SFR009: Request Contextualized News from Trusted Financial News Sources" as SFR009
    usecase "SFR010: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR010
    
    SAFR001 --> (SFR009)
  }
}

CFR002 --> (SAFR005)
FAFR003 --> (AIFR004)

@enduml