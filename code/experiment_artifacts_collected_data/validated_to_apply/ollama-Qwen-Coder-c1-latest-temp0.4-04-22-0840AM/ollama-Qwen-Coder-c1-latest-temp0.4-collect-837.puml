@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

' Define actors
actor Client as CFR001
actor FinancialAdvisor as FAFR002
actor SysAdmin as SAFR005

package "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR010
  
  CFR001 --> (View financial insights dashboard)
  CFR002 --> (Receive alerts for anomalous transactions)
  CFR003 --> (View financial predictions)
  CFR004 --> (Receive personalized recommendations)
  CFR005 --> (Manage recommendation preferences)
  CFR006 --> (View spending limit alerts)
  CFR007 --> (View investment opportunities)
  CFR008 --> (View financial news)
  CFR009 --> (Access personalized dashboard)
  CFR10 --> (Manage relationship with advisors)
}

package "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FAFR001 --> (Manage client mentoring sessions)
  FAFR002 --> (View intervention alerts)
  FAFR003 --> (View predictive analytics)
  FAFR004 --> (Configure analysis parameters for client segments)
}

package "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SAFR001 --> (Manage analysis parameters)
}

' Define system
rectangle System {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities from AI Component" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  usecase "SFR010: Process Contextualized News for Users" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
  usecase "SFR016: Request Predictive Insights From the AI Component to Enhance Value of Financial Guidance Provided to Clients" as SFR016
  usecase "SFR017: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR017
  usecase "SFR018: Manage Users' Financial Goals Tracking Progress and Providing Relevant Recommendations" as SFR018
  usecase "SFR019: Maintain a Historical Record of Users' Insights for Trend Analysis and Effectiveness Measurement" as SFR019
  usecase "SFR020: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR020
  
  CFR001 --> (Generate client dashboards)
  FAFR003 --> (Generate predictive insights from AI component)
  SAFR005 --> (Manage analysis parameters for specific client segments)
}

package "AI System" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations Based on Industry Standards" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users Based on Their Risk Profiles and Financial Goals" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities by Identifying Financial Instruments Aligning with User Strategies and Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance With FinCEN Requirements" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009
  
  SFR003 --> (Generate financial predictions)
  SFR004 --> (Generate personalized recommendations based on user data and preferences)
  FAFR002 --> (Provide guidance aligned with client goals during consultations)
}

' Define feedback loop
rectangle Feedback {
  usecase "CFR11: Send Feedback about System's Recommendations" as CFR11
  
  CFR11 --> (Send feedback to improve future outputs)
}
@enduml