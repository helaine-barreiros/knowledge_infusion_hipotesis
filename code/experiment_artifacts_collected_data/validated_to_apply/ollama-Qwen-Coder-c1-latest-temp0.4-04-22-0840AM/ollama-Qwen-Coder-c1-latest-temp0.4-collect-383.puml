@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
}

package "System Administrator" {
  actor SysAdmin as SAFR003
}

rectangle "System" {
  usecase "CFR002: View Alerts about Anomalous Transactions" as CFR002
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR004
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR005
  usecase "FAFR003: View Predictive Analytics about Financial Situations" as FAFR006
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR019
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR015
}

CFR001 --> CFR002
FAFR002 --> FAFR003
SFR019 <|-- SFR018

@enduml