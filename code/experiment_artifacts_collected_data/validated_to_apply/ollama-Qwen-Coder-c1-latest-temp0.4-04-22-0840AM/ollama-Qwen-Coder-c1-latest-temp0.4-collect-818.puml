@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  User --> CFR001
}

rectangle "Client Functions" {
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  
  User --> CFR002
  User --> CFR003
  User --> CFR004
  User --> CFR005
  User --> CFR006
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  
  User --> FAFR001
  User --> FAFR002
  User --> FAFR003
}

rectangle "System Functions" {
  usecase "SFR007: Request Investment Opportunity Analysis from AI Component" as SFR007
  usecase "SFR008: Generate Anomaly Transaction Alerts" as SFR008
  
  System --> SFR007
  System --> SFR008
}

rectangle "AI Functions" {
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  
  System --> AIFR001
  System --> AIFR002
}

rectangle "User Feedback Loop" {
  usecase "CFR011: Send Feedback about the System's Recommendations and Insights" as CFR011
  
  User --> CFR011
}
@enduml