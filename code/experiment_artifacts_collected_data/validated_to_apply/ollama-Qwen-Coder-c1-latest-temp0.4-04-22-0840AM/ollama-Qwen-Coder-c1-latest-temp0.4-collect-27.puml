@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

' Actors
actor Client as CFR001
actor FinancialAdvisor as FAFR002
actor SysAdmin as SAFR003
actor User as CFR011

package "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR010

  Client --> (SAFR005)
}

package "Financial Advisor" {
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003

  FinancialAdvisor --> (SAFR005)
}

package "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SysAdmin --> (SAFR005)
}

rectangle System {
  package "AI Component" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on Strategies" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009

    System --> (SAFR013)
  }

  package "System Functions" {
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions" as SFR003
    usecase "SFR004: Request Personalized Recommendations based on Data and Preferences" as SFR004
    usecase "SFR005: Request Spending Limit Alerts" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities Matching Criteria and Preferences" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to User's Portfolio" as SFR009
    usecase "SFR010: Process Contextualized News for Users' Financial Situations" as SFR010
    usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
    usecase "SFR012: Generate Client Dashboards with Intuitive and Actionable Information" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
    usecase "SFR014: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
    usecase "SFR016: Request Predictive Insights to Enhance Value of Financial Guidance" as SFR016
    usecase "SFR017: Generate Financial Health Reports Assessing Users' Overall Wellbeing" as SFR017
    usecase "SFR018: Manage User's Financial Goals Tracking Progress and Providing Recommendations" as SFR018
    usecase "SFR019: Maintain Historical Record of Insights for Trend Analysis" as SFR019
    usecase "SFR020: Manage User Feedback to Improve System Outputs" as SFR020

    System --> (SAFR013)
  }
}

' Relationships
CFR001 --> (AIFR001 : Generate Financial Predictions)
CFR004 --> (AIFR002 : Generate Personalized Recommendations)
CFR006 --> (AIFR003 : Generate Spending Limit Alerts)
CFR007 --> (AIFR005 : Generate Investment Opportunity Analyses)
FAFR001 --> (SFR004 : Request Personalized Recommendations based on Data and Preferences)
FAFR002 --> (AIFR006 : Generate Anomaly Transaction Alerts)
SAFR003 --> (AIFR007 : Generate Contextualized News Insights)

' User Feedback
User --> (System : Send Feedback about System's Recommendations and Insights)

@enduml