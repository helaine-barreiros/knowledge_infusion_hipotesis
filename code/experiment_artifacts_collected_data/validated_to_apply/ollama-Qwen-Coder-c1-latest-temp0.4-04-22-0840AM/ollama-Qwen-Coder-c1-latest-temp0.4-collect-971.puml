@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FAFR

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  
  User --> CFR001
  SysAdmin --> (SAFR001)
  
  rectangle "Client Subsystem" {
    usecase "CFR002: View Alerts for Anomalous Transactions" as CFR002
    usecase "CFR003: View Financial Predictions" as CFR003
    usecase "CFR004: Receive Personalized Recommendations" as CFR004
    usecase "CFR005: Manage Recommendation Preferences" as CFR005
    usecase "CFR006: View Spending Limit Alerts" as CFR006
    usecase "CFR012: Generate Client Dashboards" as CFR12
    
    User --> (CFR002)
    User --> (CFR003)
    User --> (CFR004)
    User --> (CFR005)
    User --> (CFR006)
    User --> (CFR12)
  }
  
  rectangle "Financial Advisor Subsystem" {
    usecase "FAFR002: View Client Intervention Alerts" as FAFR002
    usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
    usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
    
    FinancialAdvisor --> (FAFR002)
    FinancialAdvisor --> (FAFR003)
    FinancialAdvisor --> (FAFR004)
  }
  
  rectangle "System Subsystem" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    
    System --> (SFR001)
    System --> (SFR008)
  }
}

rectangle "AI Subsystem" {
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition" as AIFR006
  
  System --> (AIFR002)
  System --> (AIFR006)
}

User --> FAFR : Manage Relationship with Financial Advisors
FAFR --> User : Provide Guidance and Recommendations

@enduml