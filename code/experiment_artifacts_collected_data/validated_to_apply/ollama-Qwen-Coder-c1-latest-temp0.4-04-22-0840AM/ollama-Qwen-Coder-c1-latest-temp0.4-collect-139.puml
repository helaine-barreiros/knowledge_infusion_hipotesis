@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  SA --> (SAFR001)
}

rectangle "AI Component" {
    rectangle "AIFR001: Generate Financial Predictions" as AIFR001
    rectangle "AIFR002: Generate Personalized Recommendations" as AIFR002
    rectangle "AIFR003: Generate Spending Limit Alerts" as AIFR003
    rectangle "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    rectangle "AIFR005: Generate Investment Opportunities Based on Strategies and MPT" as AIFR005
    rectangle "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    rectangle "AIFR007: Generate Contextualized News Insights" as AIFR007
    rectangle "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
    rectangle "AIFR009: Generate Client Predictive Insights" as AIFR009

  C --> (SFR012 : "Generate Client Dashboards")
  FA --> (FAFR003)
  SA --> (SAFR001)

  SFR007 <|-- (AIFR007)
  SFR006 <|-- (AIFR003)
  SFR005 <|-- (AIFR002)
  SFR004 <|-- (AIFR001)
  SFR009 <|-- (AIFR008)
  
}

rectangle "System" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities Based on Criteria and ESG Preferences" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
    usecase "SFR10: Process Contextualized News for User's Financial Situations" as SFR10
    usecase "SFR11: Request Contextualized News Insights from AI Component" as SFR11
    usecase "SFR12: Generate Client Alerts Based on Predefined Conditions" as SFR13
    usecase "SFR14: Generate Client Analytics for Financial Behavior and Performance" as SFR15
    usecase "SFR16: Request Predictive Intervention Analyses from AI Component" as SFR17
    usecase "SFR18: Request Predictive Insights from AI Component to Enhance Financial Guidance" as SFR19
    usecase "SFR20: Generate Financial Health Reports Based on Standard Ratios and Metrics" as SFR21
    usecase "SFR21: Manage Users' Financial Goals for Progress Tracking and Recommendations" as SFR22

  C --> (SFR003)
  FA --> (FAFR004)
  SA --> (SAFR001)

}

rectangle "System Components" {
    rectangle "User Interface" as UI
    rectangle "Data Management System" as DMS
    rectangle "AI Engine" as AIEng

  C --> (UI : "Interact with User Interface")
  FA --> (UI)
  SA --> (UI)

  UI <|-- (DMS)
  UI <|-- (AIFR001)
  UI <|-- (AIFR002)
  UI <|-- (AIFR003)
  UI <|-- (AIFR004)
  UI <|-- (AIFR005)
  UI <|-- (AIFR006)
  UI <|-- (AIFR007)
  UI <|-- (AIFR008)
  UI <|-- (AIFR009)

}

@enduml