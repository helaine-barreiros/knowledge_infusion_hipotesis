@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
  
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  
  SA --> SAFR001
}

rectangle "AI Component" {
  package "Financial Insights" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    
    CFR003 <|-- AIFR001
    FAFR003 <|-- AIFR001
    SFR002 <|-- AIFR001
  }
  
  package "Personalized Recommendations" {
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    
    CFR004 --> AIFR002
    FAFR003 --> AIFR002
    SFR001 <|-- AIFR002
  }
  
  package "Spending Limit Alerts" {
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    
    CFR006 --> AIFR003
    SFR005 <|-- AIFR003
  }
  
  package "Investment Opportunities Analysis" {
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    
    CFR007 --> AIFR004
    FAFR002 --> AIFR004
    SFR006 <|-- AIFR004
  }
  
  package "Anomaly Transaction Alerts" {
    usecase "AIFR005: Generate Anomaly Transaction Alerts" as AIFR005
    
    CFR002 --> AIFR005
    SFR008 <|-- AIFR005
  }
  
  package "Contextualized News Insights" {
    usecase "AIFR006: Generate Contextualized News Insights" as AIFR006
    
    CFR008 --> AIFR006
    SFR010 <|-- AIFR006
  }
  
  package "Predictive Intervention Recommendations" {
    usecase "AIFR007: Generate Predictive Intervention Recommendations" as AIFR007
    
    FAFR002 --> AIFR007
    SFR15 <|-- AIFR007
  }
  
  package "Predictive Insights" {
    usecase "AIFR008: Generate Predictive Insights" as AIFR008
    
    FAFR003 --> AIFR008
    SFR16 <|-- AIFR008
  }
}

package "System Functions" {
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  CFR008 --> SFR009
  FAFR003 --> SFR009
  SAFR001 <|-- SFR009
}

package "Notifications and Alerts" {
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  
  CFR002 --> SFR013
  FAFR002 --> SFR013
  SAFR001 <|-- SFR013
}

package "Analytics and Reports" {
  usecase "SFR014: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR014
  
  FAFR002 --> SFR014
  SAFR001 <|-- SFR014
}

package "Feedback Management" {
  usecase "CFR11: Send Feedback About System's Recommendations and Insights" as CFR11
  
  C --> CFR11
  FA --> CFR11
  SA --> CFR11
}
@enduml