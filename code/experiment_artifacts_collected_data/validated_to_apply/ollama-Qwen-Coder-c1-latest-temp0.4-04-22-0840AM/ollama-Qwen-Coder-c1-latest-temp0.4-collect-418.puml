@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System: as Sys
:Financial Advisor: as FAFR001
:System Administrator: as SAFR001

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Analysis Parameters" as SAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "SFR007: Request Specific Investment Opportunities" as SFR007
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  Client --> CFR001
  SAFR002 <|-- (SAFR001)
  FAFR003 <|-- (FAFR001)
  SFR007 --> (AIFR004)
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  
  Financial Advisor --> FAFR001
  Financial Advisor --> FAFR002
}

rectangle "Client" {
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "SAFR005: Manage Personalized Recommendations Preferences" as SAFR005
  
  Client --> CFR002
  Client --> SAFR005
}

rectangle "System Administrator" {
  usecase "SFR019: Maintain Historical Record of Users' Insights" as SFR019
  usecase "CFR11: Send Feedback about System Recommendations and Insights" as CFR11
  
  System Administrator --> SFR019
  System Administrator --> CFR11
}

@enduml