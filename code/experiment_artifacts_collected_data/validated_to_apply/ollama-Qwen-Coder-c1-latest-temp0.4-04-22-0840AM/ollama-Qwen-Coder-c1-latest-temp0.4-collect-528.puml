@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
  
  rectangle "Mentoring Sessions" {
    usecase "FAFR001: Manage client mentoring sessions based on system-generated insights to provide more valuable guidance aligned with each client's financial goals." as FAFR001
  }
  
  rectangle "Intervention Alerts" {
    usecase "FAFR002: View client intervention alerts when the system detects patterns requiring professional attention to proactively assist clients with potential financial issues." as FAFR002
  }

  rectangle "Predictive Analytics" {
    usecase "FAFR003: View predictive analytics about my clients' financial situations to provide data-driven recommendations during consultations." as FAFR003
  }
  
  rectangle "Analysis Parameters Configuration" {
    usecase "FAFR004: Configure analysis parameters for specific client segments to customize the system's behavior according to different client profiles and regulatory requirements such as GDPR or CCPA." as FAFR004
  }

}

package "System Administrator" {
  actor SystemAdministrator as SAFR001
  
  usecase "SAFR001: Manage analysis parameters for the AI system to ensure the algorithms remain accurate, relevant, and compliant with financial regulations such as Basel III for risk management." as SAFR001
}

package "System" {
  rectangle "Alerts Management" {
    usecase "SFR001: As a system, I must deliver alerts to users through appropriate notification channels to ensure timely awareness of critical financial events." as SFR001
  }
  
  rectangle "Recommendations Generation" {
    usecase "SFR002: As a system, I must deliver personalized recommendations to users based on their financial profiles to support better financial decision-making." as SFR002
  }

  rectangle "Predictive Analytics Request" {
    usecase "SFR003: As a system, I must request financial predictions from the AI component to provide users with forward-looking financial insights." as SFR003
  }
  
  rectangle "Personalized Recommendations Request" {
    usecase "SFR004: As a system, I must request personalized recommendations from the AI component based on each user's financial data and preferences." as SFR004
  }

  rectangle "Spending Limit Alerts Request" {
    usecase "SFR005: As a system, I must request spending limit alerts from the AI component when user spending patterns exceed defined thresholds." as SFR005
  }
  
  rectangle "Investment Opportunity Analysis Request" {
    usecase "SFR006: As a system, I must request investment opportunity analysis from the AI component to identify suitable investments for users based on their risk profiles." as SFR006
  }

  rectangle "Specific Investment Opportunities Request" {
    usecase "SFR007: As a system, I must request specific investment opportunities from the AI component that match user investment criteria and ESG (Environmental, Social, and Governance) preferences." as SFR007
  }
  
  rectangle "Anomaly Transaction Alerts Request" {
    usecase "SFR008: As a system, I must request anomaly transaction alerts from the AI component to detect potentially fraudulent activities in accordance with AML (Anti-Money Laundering) regulations." as SFR008
  }

  rectangle "Contextualized News Retrieval Request" {
    usecase "SFR009: As a system, I must find contextualized news relevant to users' financial portfolios from trusted financial news sources." as SFR009
  }
  
  rectangle "News Processing Request" {
    usecase "SFR010: As a system, I must process contextualized news to extract relevant information for users' financial situations." as SFR010
  }

  rectangle "Contextualized News Insights Request" {
    usecase "SFR011: As a system, I must request contextualized news insights from the AI component to identify potential impacts on users' investments." as SFR011
  }
  
  rectangle "Client Dashboards Generation" {
    usecase "SFR012: As a system, I must generate client dashboards that present financial information in an intuitive and actionable format." as SFR012
  }

  rectangle "Client Alerts Generation" {
    usecase "SFR013: As a system, I must generate client alerts based on predefined conditions to ensure timely notification of important financial events." as SFR013
  }
  
  rectangle "Client Analytics Generation" {
    usecase "SFR014: As a system, I must generate client analytics that provide meaningful insights into financial behavior and performance." as SFR014
  }

  rectangle "Predictive Intervention Analyses Request" {
    usecase "SFR015: As a System, I must request predictive intervention analyses from the AI component to identify when financial advisors should engage with clients." as SFR015
  }
  
  rectangle "Predictive Insights Generation" {
    usecase "SFR016: As a system, I must request predictive insights from the AI component to enhance the value of financial guidance provided to clients." as SFR016
  }

  rectangle "Financial Health Reports Generation" {
    usecase "SFR017: As a System, I must generate financial health reports that assess users' overall financial wellbeing according to standard financial ratios and metrics." as SFR017
  }
  
  rectangle "User Goals Management" {
    usecase "SFR018: As a system, I must manage users' financial goals to track progress and provide relevant recommendations." as SFR018
  }

  rectangle "Historical Insights Record Maintenance" {
    usecase "SFR019: As a System, I must maintain a historical record of users' insights to enable trend analysis and effectiveness measurement." as SFR019
  }
  
  rectangle "User Feedback Management" {
    usecase "SFR020: As a system, I must manage user feedback to continuously improve the quality and relevance of financial insights." as SFR020
  }

}

package "AI System" {
  actor AIFR001
  
  rectangle "Financial Predictions Generation" {
    usecase "AIFR001: Generate financial predictions for users by analyzing historical transaction data, market trends, and economic indicators." as AIFR001
  }
  
  rectangle "Personalized Recommendations Generation" {
    usecase "AIFR002: Generate personalized recommendations for users based on their financial profiles, goals, and risk tolerance as defined by industry standards like FINRA guidelines." as AIFR002
  }

  rectangle "Spending Limit Alerts Generation" {
    usecase "AIFR003: Generate spending limit alerts for users by identifying unusual deviations from established spending patterns." as AIFR003
  }
  
  rectangle "Investment Opportunity Analysis Generation" {
    usecase "AIFR004: Generate investment opportunity analyses for users by evaluating potential investments against their risk profiles, time horizons, and financial goals." as AIFR004
  }

  rectangle "Investment Opportunities Identification" {
    usecase "AIFR005: Generate investment opportunities for users by identifying financial instruments that align with their investment strategies and Modern Portfolio Theory principles." as AIFR005
  }
  
  rectangle "Anomaly Transaction Alerts Generation" {
    usecase "AIFR006: Generate anomaly transaction alerts by employing pattern recognition to detect potentially fraudulent activities in compliance with FinCEN requirements." as AIFR006
  }

  rectangle "Contextualized News Insights Generation" {
    usecase "AIFR007: Generate contextualized news insights by correlating financial news with specific user portfolios to identify relevant impacts." as AIFR007
  }
  
  rectangle "Client Predictive Intervention Recommendations Generation" {
    usecase "AIFR008: Generate client predictive intervention recommendations by identifying patterns that indicate potential financial difficulties or opportunities requiring advisor engagement." as AIFR008
  }

  rectangle "Client Predictive Insights Generation" {
    usecase "AIFR009: Generate client predictive insights that provide forward-looking analysis of financial situations to support more effective financial planning." as AIFR009
  }
}

CFR001 --> SFR002 : "View Personalized Recommendations"
FAFR002 --> FAFR003 : "View Predictive Analytics"
SFR004 --> CFR001 : "Deliver Personalized Recommendations to Client"
AIFR002 --> SAFR001 : "Manage Analysis Parameters"

@enduml