@startuml
left to right direction

title Use Case Diagram for AI-Powered Financial Insights & Recommendations System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Current Trends" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as SAFR004
  usecase "CFR005: Manage Personalized Recommendations Preferences to Ensure Relevance" as SAFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as SAFR006
  usecase "View Investment Opportunities Suitable to My Risk Profile" as FAFR007
  usecase "View News Related to My Investment Portfolio" as SFR010
  usecase "Access a Personalized Dashboard Consolidating Financial Information" as SAFR009
  
  CFR001 --> (SAFR002)
  CFR001 --> (SAFR003)
  CFR001 --> (SAFR004)
  CFR001 --> (SAFR005)
  CFR001 --> (SAFR006)
  CFR001 --> FAFR007
  CFR001 --> SFR010
  CFR001 --> SAFR009
  
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts When Patterns Require Professional Attention" as SAFR007
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as SAFR008
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments Based on Different Profiles and Regulatory Requirements" as AIFR012
  
  FAFR001 --> (SAFR007)
  FAFR001 --> (SAFR008)
  FAFR001 --> (AIFR012)
}

package "System Administrator" {
  actor SystemAdmin as SAFR001
  
  usecase "SAFR001: Manage Analysis Parameters for the AI System to Ensure Accuracy, Relevance, and Compliance with Financial Regulations" as SAFR001
  usecase "Manage Client Mentoring Sessions Based on System-Generated Insights to Provide More Valuable Guidance Aligned With Each Client's Financial Goals" as FAFR002
  
  SAFR001 --> (SAFR001)
  SAFR001 --> (FAFR002)
}

package "System Components" {
  rectangle "AI System" {
    usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance as Defined by Industry Standards Like FINRA Guidelines" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities for Users by Identifying Financial Instruments That Align With Their Investment Strategies and Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts By Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News With Specific User Portfolios To Identify Relevant Impacts" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations By Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights that Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009
    
  }
  
  rectangle "Notification System" {
    usecase "SFR013: Request Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR013
  }

  rectangle "Dashboard Generator" {
    usecase "AIFR012: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as AIFR012
  }
  
  rectangle "Recommendation Engine" {
    usecase "SFR014: Request Personalized Recommendations from the AI Component Based on Each User's Financial Data and Preferences" as SFR014
  }

  rectangle "Health Report Generator" {
    usecase "AIFR017: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as AIFR017
  }
  
}

package "Feedback Management System" {
  actor User as CFR011
  
  usecase "Send Feedback About the System's Recommendations and Insights to Help Improve Future Outputs" as SAFR020
  
  CFR011 --> (SAFR020)
}
@enduml