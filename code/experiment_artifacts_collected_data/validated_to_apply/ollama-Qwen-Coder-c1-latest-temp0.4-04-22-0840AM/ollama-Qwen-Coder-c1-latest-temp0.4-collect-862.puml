@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive FATF Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> (View Financial Insights Dashboard)
  C --> (Receive FATF Alerts)
  C --> (View Financial Predictions)
  C --> (Receive Personalized Recommendations)
  C --> (Manage Recommendation Preferences)
  C --> (View Spending Limit Alerts)
  C --> (View Investment Opportunities)
  C --> (View Financial News)
  C --> (Access Personalized Dashboard)
  C --> (Manage Relationship with Advisors)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (Manage Client Mentoring Sessions)
  FA --> (View Intervention Alerts)
  FA --> (View Predictive Analytics)
  FA --> (Configure Analysis Parameters for Client Segments)
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  SA --> (Manage Analysis Parameters)
}

rectangle "AI Component" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Based on Modern Portfolio Theory" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  C --> (Receive Financial Predictions)
  C --> (Receive Personalized Recommendations)
  C --> (View Spending Limit Alerts)
  FA --> (Manage Analysis Parameters for Specific Client Segments)
  SA --> (SAFR001)
  
  SFR002 <|-- AIFR002
  SFR003 <|-- AIFR009
  SFR004 <|-- AIFR002
  SFR005 <|-- AIFR003
  SFR006 <|-- AIFR004
  SFR007 <|-- AIFR007
  SFR011 <|-- AIFR007
  SFR012 <|-- (Generate Client Dashboards)
  SFR013 <|-- (Generate Client Alerts Based on Predefined Conditions)
  SFR014 <|-- (Generate Client Analytics)
  SFR015 <|-- AIFR008
  SFR016 <|-- AIFR009
  
}

rectangle "System" {
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Based on User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  usecase "SFR10: Process Contextualized News for User's Financial Situations" as SFR010
  usecase "SFR11: Request Contextualized News Insights from AI Component" as SFR011
  usecase "SFR12: Generate Client Dashboards Presenting Financial Information Intuitively and Actionably" as SFR012
  usecase "SFR13: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR013
  usecase "SFR14: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR014
  usecase "SFR15: Request Predictive Intervention Analyses from AI Component Identifying When Advisors Should Engage with Clients" as SFR015
  usecase "SFR16: Request Predictive Insights From the AI Component to Enhance Financial Guidance Provided to Clients" as SFR016
  usecase "SFR17: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR017
  usecase "SFR18: Manage Users' Financial Goals Tracking Progress and Providing Relevant Recommendations" as SFR018
  usecase "SFR19: Maintain a Historical Record of Users' Insights for Trend Analysis and Effectiveness Measurement" as SFR019
  usecase "SFR20: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR020
  
  C --> (Receive Personalized Recommendations)
  FA --> (View Predictive Analytics About Clients' Financial Situations)
  SA --> (Manage Analysis Parameters for Client Segments)
  
}

package "System Components" {
  usecase "(Generate Client Dashboards)" as GenDash
  usecase "(Process Contextualized News)" as ProcNews
  
  SFR12 <|-- GenDash
  SFR09 <|-- ProcNews
}

@enduml