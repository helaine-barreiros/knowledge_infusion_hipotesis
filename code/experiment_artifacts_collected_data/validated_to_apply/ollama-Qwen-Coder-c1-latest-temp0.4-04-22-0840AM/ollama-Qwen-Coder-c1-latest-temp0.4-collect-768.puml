@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  
  Client --> (CFR001)
  SysAdmin --> SAFR001
  FAFD --> (FAFR002)
  
  Client --> CFR002
  System Admin --> SFR013
}

rectangle "Client Dashboard" {
  usecase "SFR012: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as SFR012
  
  Client --> (SFR012)
}

rectangle "Personalized Recommendations" {
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as CFR004
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations" as FAFR003
  
  Client --> (CFR004)
  FAFD --> (FAFR003)
}

rectangle "Spending Limits and Alerts" {
  usecase "CFR010: Manage Relationship with Financial Advisors, Including Permissions for Sharing My Financial Data" as CFR010
  usecase "SFR005: Request Spending Limit Alerts From the AI Component When User Spending Patterns Exceed Defined Thresholds" as SFR005
  
  Client --> (CFR010)
  System Admin --> SFR005
}

rectangle "Investment Opportunities and News" {
  usecase "SAFR002: Manage Analysis Parameters for Specific Client Segments to Customize the System's Behavior According to Different Client Profiles and Regulatory Requirements Such as GDPR or CCPA" as SAFR002
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as CFR011
  
  SysAdmin --> (SAFR002)
  Client --> (CFR011)
}

rectangle "Financial Health Reports" {
  usecase "SFR017: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR017
  
  SysAdmin --> (SFR017)
}
@enduml