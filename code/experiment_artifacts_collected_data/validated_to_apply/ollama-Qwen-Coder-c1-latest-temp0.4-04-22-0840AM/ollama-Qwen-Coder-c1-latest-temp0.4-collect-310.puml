@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SystemAdmin as SA
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  
  SA --> (SAFR001)
}

rectangle "Notifications and Recommendations" {
  package "User Interface" {
    usecase "SFR012: Generate Client Dashboards" as SFR012
    usecase "SFR013: Generate Client Alerts" as SFR013
    usecase "SFR014: Generate Client Analytics" as SFR014
    
    C --> (SFR012)
    FA --> (SFR012)
    SA --> (SFR012)
    
    C --> (SFR013)
    FA --> (SFR013)
    SA --> (SFR013)
    
    C --> (SFR014)
    FA --> (SFR014)
    SA --> (SFR014)
  }
  
  package "AI Component" {
    usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
    
    C --> (AIFR002)
    FA --> (AIFR002)
    
    C --> (AIFR003)
    FA --> (AIFR003)
    
    C --> (AIFR004)
    FA --> (AIFR004)
  }
}

package "News and Insights" {
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  usecase "SFR10: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR10
  
  C --> (SFR009)
  FA --> (SFR009)
  
  C --> (SFR10)
  FA --> (SFR10)
}

package "Predictive Interventions and Insights" {
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  usecase "SFR15: Request Predictive Intervention Analyses from the AI Component to Identify When Financial Advisors Should Engage with Clients" as SFR15
  
  C --> (AIFR008)
  FA --> (AIFR008)
  
  C --> (SFR15)
  FA --> (SFR15)
}

package "Financial Health and Goals Management" {
  usecase "AIFR009: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009
  usecase "SFR23: Request Predictive Insights from the AI Component to Enhance the Value of Financial Guidance Provided to Clients" as SFR23
  
  C --> (AIFR009)
  FA --> (AIFR009)
  
  C --> (SFR23)
  FA --> (SFR23)
}

package "Feedback and Continuous Improvement" {
  usecase "CFR11: Send Feedback about System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as CFR11
  
  C --> (CFR11)
  SA --> (CFR11)
  
  FA <|-- (C)
}

@enduml