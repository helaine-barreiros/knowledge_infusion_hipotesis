@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Monitor Spending Limits" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access Financial News" as CFR008
  usecase "CFR009: Consolidate Financial Information Dashboard" as CFR009
  usecase "CFR10: Manage Relationships with Financial Advisors" as CFR10
  
  C --> (View Financial Insights Dashboard)
  C --> (Receive Anomaly Transaction Alerts)
  C --> (View Financial Predictions)
  C --> (Receive Personalized Recommendations)
  C --> (Manage Recommendation Preferences)
  C --> (Monitor Spending Limits)
  C --> (View Investment Opportunities)
  C --> (Access Financial News)
  C --> (Consolidate Financial Information Dashboard)
  C --> (Manage Relationships with Financial Advisors)
}

package "Financial Advisors" {
  actor Advisor as A
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  A --> (Manage Client Mentoring Sessions)
  A --> (View Intervention Alerts)
  A --> (View Predictive Analytics)
  A --> (Configure Analysis Parameters for Client Segments)
}

package "System Administrator" {
  actor SysAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR020: Manage User Feedback" as SFR020
  
  SA --> (Manage Analysis Parameters)
  SA --> (Manage User Feedback)
}

package "System Components" {
  rectangle System {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities from AI Component" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
    usecase "SFR010: Process Contextualized News for User's Financial Situations" as SFR010
    usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
    usecase "SFR012: Generate Client Dashboards" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
    usecase "SFR014: Generate Client Analytics" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
    usecase "SFR016: Request Predictive Insights from AI Component" as SFR016
    usecase "SFR017: Generate Financial Health Reports" as SFR017
    usecase "SFR018: Manage Users' Financial Goals" as SFR018
    usecase "SFR019: Maintain Historical Record of Users' Insights" as SFR019
    
    System --> (Deliver Alerts to Users)
    System --> (Deliver Personalized Recommendations)
    System --> (Request Financial Predictions from AI Component)
    System --> (Request Personalized Recommendations from AI Component)
    System --> (Request Spending Limit Alerts from AI Component)
    System --> (Request Investment Opportunity Analysis from AI Component)
    System --> (Request Specific Investment Opportunities from AI Component)
    System --> (Request Anomaly Transaction Alerts from AI Component)
    System --> (Find Contextualized News Relevant to Users' Financial Portfolios)
    System --> (Process Contextualized News for User's Financial Situations)
    System --> (Request Contextualized News Insights from AI Component)
    System --> (Generate Client Dashboards)
    System --> (Generate Client Alerts Based on Predefined Conditions)
    System --> (Generate Client Analytics)
    System --> (Request Predictive Intervention Analyses from AI Component)
    System --> (Request Predictive Insights from AI Component)
    System --> (Generate Financial Health Reports)
    System --> (Manage Users' Financial Goals)
    System --> (Maintain Historical Record of Users' Insights)
  }
}

package "AI Components" {
  rectangle AI {
    usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on User Strategies and Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition in Compliance with FinCEN Requirements" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News With User Portfolios to Identify Relevant Impacts" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009
    
    AI --> (Generate Financial Predictions for Users)
    AI --> (Generate Personalized Recommendations for Users)
    AI --> (Generate Spending Limit Alerts for Users)
    AI --> (Generate Investment Opportunity Analyses for Users)
    AI --> (Generate Investment Opportunities Based on User Strategies and Modern Portfolio Theory Principles)
    AI --> (Generate Anomaly Transaction Alerts by Employing Pattern Recognition in Compliance with FinCEN Requirements)
    AI --> (Generate Contextualized News Insights Correlating Financial News With User Portfolios to Identify Relevant Impacts)
    AI --> (Generate Client Predictive Intervention Recommendations by Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement)
    AI --> (Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning)
  }
}

package "Feedback Management" {
  actor User as U
  
  usecase "CFR11: Send Feedback About System Recommendations and Insights" as CFR11
  U --> (Send Feedback About System Recommendations and Insights)
}
@enduml