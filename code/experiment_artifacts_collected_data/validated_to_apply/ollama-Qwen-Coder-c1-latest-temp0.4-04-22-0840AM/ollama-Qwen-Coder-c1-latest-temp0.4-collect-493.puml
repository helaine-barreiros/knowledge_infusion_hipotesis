@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  Client --> (SFR012) : "View"
  SysAdmin --> (SFR013) : "Manage"
}

rectangle "Financial Advisor System" {
  usecase "FAFR001: Manage client mentoring sessions based on system-generated insights" as FAFR001
  usecase "FAFR002: View client intervention alerts when the system detects patterns requiring professional attention to proactively assist clients with potential financial issues" as FAFR002
  
  Financial Advisor --> (SFR013) : "Manage"
}

rectangle "Client Dashboard System" {
  usecase "CFR009: Access a personalized dashboard that consolidates my financial information in a single view to efficiently monitor my finances" as CFR009
  usecase "AIFR002: Generate personalized recommendations for users based on their financial profiles, goals, and risk tolerance as defined by industry standards like FINRA guidelines" as AIFR002
  
  Client --> (SFR013) : "Manage"
}

rectangle "Spending Limit Alerts System" {
  usecase "CFR006: View spending limit alerts when I exceed predefined thresholds in specific expense categories to maintain better control over my budget" as CFR006
  usecase "AIFR003: Generate spending limit alerts for users by identifying unusual deviations from established spending patterns" as AIFR003
  
  Client --> (SFR015) : "Request"
}

rectangle "Investment Opportunities System" {
  usecase "CFR007: View investment opportunities suitable to my risk profile (as defined under MiFID II or equivalent standards) to diversify my portfolio and maximize returns" as CFR007
  usecase "AIFR004: Generate investment opportunity analyses for users by evaluating potential investments against their risk profiles, time horizons, and financial goals" as AIFR004
  
  Client --> (SFR016) : "Request"
}

rectangle "News System" {
  usecase "CFR008: View news related to my investment portfolio to stay informed about market events that might affect my assets" as CFR008
  usecase "AIFR007: Generate contextualized news insights by correlating financial news with specific user portfolios to identify relevant impacts" as AIFR007
  
  Client --> (SFR019) : "Request"
}

rectangle "Feedback System" {
  usecase "CFR011: Send feedback about the system's recommendations and insights to help improve the accuracy and relevance of future outputs" as CFR011
  usecase "AIFR020: Generate financial health reports that assess users' overall financial wellbeing according to standard financial ratios and metrics" as AIFR020
  
  Client --> (SFR020) : "Provide"
}

@enduml