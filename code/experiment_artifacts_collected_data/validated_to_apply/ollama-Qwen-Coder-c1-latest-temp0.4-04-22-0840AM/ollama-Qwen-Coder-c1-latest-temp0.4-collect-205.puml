@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
}

package "System Administrator" {
  actor SysAdmin as SAFR003
}

rectangle "System Components" {
  usecase "SFR001: Deliver Alerts" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
  usecase "SFR005: Request Spending Limit Alerts" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Matching ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to User's Portfolio" as SFR009
  usecase "SFR010: Process Contextualized News for Users' Financial Situations" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI" as SFR011
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI" as SFR015
  usecase "SFR016: Request Predictive Insights From the AI Component to Enhance Value of Financial Guidance Provided to Clients" as SFR016
  usecase "SFR017: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Ratios and Metrics" as SFR017
  usecase "SFR018: Manage User Feedback To Continuously Improve the Quality and Relevance of Financial Insights" as SFR018
}

package "AI System" {
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations Based on User Profiles and Goals" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Patterns" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users Based on Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Matching User Strategies and Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News With Specific User Portfolios To Identify Relevant Impacts" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009

}

CFR001 --> SFR002 : "View Personalized Recommendations"
CFR001 --> SFR003 : "Request Financial Predictions"
CFR001 --> SFR004 : "Receive AI-Generated Recommendations"
CFR001 --> SFR005 : "Manage Spending Limit Alerts Preferences"
CFR002 --> FAFR001 : "Mentor Clients Based on System Insights"
CFR002 --> AIFR009 : "Predictive Intervention Analyses for Client Engagement"
FAFR003 --> SFR006 : "View Investment Opportunity Analysis"
SFR007 --> CFR008 : "Find Contextualized News Relevant to Portfolio"
AIFR001 --> SFR002
AIFR002 --> SFR004
AIFR003 --> SFR005
AIFR006 --> SFR008
SFR019 --> CFR011 : "Send Feedback to Improve Outputs"

@enduml