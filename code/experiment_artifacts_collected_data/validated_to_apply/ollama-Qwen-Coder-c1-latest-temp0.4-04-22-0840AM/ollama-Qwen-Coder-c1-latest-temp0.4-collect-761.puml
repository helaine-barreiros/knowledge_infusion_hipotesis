@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR005: Manage Analysis Parameters Preferences" as SAFR005
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "AIFR009: Generate Contextualized News Insights" as AIFR009
  
  Client --> CFR001
  SysAdmin --> SAFR005
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  
  FinancialAdvisor --> FAFR001
  FinancialAdvisor --> FAFR002
}

rectangle "System Functions" {
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "SFR004: Request Personalized Recommendations" as SFR004
  usecase "SFR016: Generate Client Analytics" as SFR016
  
  System --> SFR003
  System --> SFR004
  System --> SFR016
}

rectangle "AI Functions" {
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR005: Generate Investment Opportunities" as AIFR005
  
  System --> AIFR002
  System --> AIFR005
}

rectangle "Client Functions" {
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
  usecase "SFR013: Generate Client Alerts" as SFR013
  
  Client --> CFR010
  System --> SFR013
}

rectangle "Feedback Loop" {
  usecase "CFR011: Send Feedback About Recommendations and Insights" as CFR011
  
  Client --> CFR011
}
@enduml