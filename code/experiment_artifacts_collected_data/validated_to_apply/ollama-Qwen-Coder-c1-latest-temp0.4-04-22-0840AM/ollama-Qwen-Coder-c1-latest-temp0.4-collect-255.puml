@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client) : as UserC
:User (Financial Advisor) : as UserFA
:System Administrator : as SysAdmin
:System : as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Deliver Personalized Recommendations" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "CFR011: Send Feedback" as CFR011
  
  UserC --> (SAFR001)
  UserFA --> (SFR003)
  SysAdmin --> SAFR001
  Sys --> SFR003
  Sys --> AIFR004
}

rectangle "Client Dashboard" {
  usecase "CFR002: View Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR005: Manage Personalized Recommendations Preferences" as CFR005
  
  UserC --> (CFR002)
  UserC --> (CFR004)
  UserC --> (CFR005)
}

rectangle "Financial Advisor Dashboard" {
  usecase "FAFR01: Manage Client Mentoring Sessions" as FAFR01
  usecase "FAFR03: View Predictive Analytics for Clients" as FAFR03
  
  UserFA --> (FAFR01)
  UserFA --> (FAFR04)
}

rectangle "Investment Dashboard" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "SFR006: Request Specific Investment Opportunities Based on ESG Preferences" as SFR006
  
  UserC --> (CFR007)
  Sys --> SFR006
}

rectangle "News Dashboard" {
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "SFR010: Process Contextualized News for Users' Financial Situations" as SFR010
  
  UserC --> (CFR008)
  Sys --> SFR010
}

rectangle "Relationship Management Dashboard" {
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  UserC --> (CFR10)
}
@enduml