@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10" : Manage Relationship with Financial Advisors
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SystemAdministrator as SA
  
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  usecase "SFR020": Manage User Feedback
  
  SA --> (SAFR001)
  SA --> (SFR020)
}

package "System Components" {
  rectangle "AI Component" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on ESG Preferences" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "AIFR008: Generate Predictive Intervention Recommendations for Clients" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
    
    CFR001 --> (AIFR002)
    SAFR001 --> (AIFR003)
    FAFR004 --> (AIFR005)
  }
  
  rectangle "Notification Component" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    usecase "SFR017": Generate Financial Health Reports
    
    CFR002 --> (SFR001)
    SAFR001 --> (SFR001)
  }
  
  rectangle "Recommendation Component" {
    usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
    usecase "AIFR004": Generate Investment Opportunity Analyses
    
    CFR003 --> (SFR001)
    SAFR001 --> (SFR001)
  }
  
  rectangle "Prediction Component" {
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "AIFR004": Generate Investment Opportunity Analyses
    
    CFR002 --> (SFR001)
    SAFR001 --> (SFR001)
  }
  
  rectangle "Spending Limit Alerts Component" {
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "AIFR003": Generate Spending Limit Alerts
    
    CFR002 --> (SFR001)
    SAFR001 --> (SFR001)
  }
  
  rectangle "Investment Opportunity Analysis Component" {
    usecase "SFR006: Request Investment Opportunity Analyses from AI Component" as SFR006
    usecase "AIFR004": Generate Investment Opportunity Analyses
    
    CFR002 --> (SFR001)
    SAFR001 --> (SFR001)
  }
  
  rectangle "News Analysis Component" {
    usecase "SFR007: Request Contextualized News Insights from AI Component" as SFR007
    usecase "AIFR007": Generate Contextualized News Insights
    
    CFR002 --> (SFR001)
    SAFR001 --> (SFR001)
  }
  
  rectangle "Predictive Intervention Analysis Component" {
    usecase "SFR15: Request Predictive Intervention Analyses from AI Component" as SFR15
    usecase "AIFR008": Generate Predictive Intervention Recommendations for Clients
    
    FAFR002 --> (SFR001)
  }
  
  rectangle "Predictive Insights Analysis Component" {
    usecase "SFR16: Request Predictive Insights from AI Component" as SFR16
    usecase "AIFR009": Generate Client Predictive Insights
    
    FAFR002 --> (SFR001)
  }
}

C --> (CFR11) : Send Feedback

FA --> (FAFR05)

SA --> (SAFR003)

@enduml