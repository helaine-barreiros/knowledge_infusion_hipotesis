@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor (FA): as FA
:User: as User

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  Client --> CFR001 : (Financial Insights)
  SysAdmin --> SAFR001 : (Manage Parameters)
  FA --> FAFR001 : (Mentoring Sessions)
  
  User --> SFR003 : "Send Feedback"
}

rectangle "Client" {
  usecase "CFR002: View Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "SAFR005: Manage Recommendation Preferences" as SAFR005
  
  Client --> CFR002 : (Anomalous Alerts)
  Client --> CFR003 : (Predictions)
  Client --> CFR004 : (Recommendations)
  SysAdmin --> SAFR005 : (Manage Preferences)
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "SAFR004: Configure Analysis Parameters for Client Segments" as SAFR004
  
  FA --> FAFR001 : (Mentoring)
  FA --> FAFR002 : (Intervention Alerts)
  FA --> FAFR003 : (Predictive Analytics)
  SysAdmin --> SAFR004 : (Configure Parameters for Segments)
}

rectangle "System" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  
  System --> SFR001 : (Deliver Alerts)
  SysAdmin --> SAFR006 : (Manage Analysis Parameters for Client Segments)
  
  rectangle "AI Component" {
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "SFR007: Request Specific Investment Opportunities from AI" as SFR007
    
    FA --> FAFR006 : (View Predictive Insights)
  }
}

@enduml