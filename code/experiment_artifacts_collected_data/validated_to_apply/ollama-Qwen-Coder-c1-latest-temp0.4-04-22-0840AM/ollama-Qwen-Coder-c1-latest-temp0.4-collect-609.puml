@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:User (Client, Financial Advisor, or System Administrator): as User

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFD002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  usecase "CFR011: Send Feedback about System Recommendations and Insights" as CFR011
  
  Client --> (SAFR001)
  Client --> (FAFD002)
  Client --> (SFR003)
  Client --> (AIFR004)
  Client --> (CFR011)

  SysAdmin --> SAFR001
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFD001
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "AIFR002: Generate Personalized Recommendations for Users based on Financial Profiles, Goals, and Risk Tolerance" as AIFR002
  
  FAFD --> (FAFD001)
  FAFD --> (SFR004)
  FAFD --> (AIFR002)

}

rectangle "User Interface" {
  usecase "CFR002: View Alerts about Anomalous Transactions in Accounts" as CFR002
  usecase "SAFR005: Manage Personalized Recommendations Preferences" as SAFR005
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFD003
  
  User --> (CFR001)
  User --> (SFR002)
  User --> (SAFR005)
  User --> (FAFD003)

}

@enduml