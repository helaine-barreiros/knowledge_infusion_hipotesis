@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SA --> SAFR001
}

rectangle "AI Component" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Based on Modern Portfolio Theory" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  C --> AIFR001 : CFR003
  C --> AIFR002 : CFR004
  C --> AIFR003 : CFR006
  C --> AIFR004 : CFR007
  C --> AIFR005 : CFR007
  C --> AIFR006 : CFR002
  C --> AIFR007 : CFR008
  C --> AIFR008 : FAFR003
  C --> AIFR009 : FAFR003
  
  FA --> AIFR001 : FAFR003
  FA --> AIFR002 : FAFR004
  FA --> AIFR003 : FAFR006
  FA --> AIFR005 : FAFR007
  
  SA --> AIFR001 : SAFR001
}

rectangle "System" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Based on User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  usecase "SFR10: Process Contextualized News for User's Financial Situations" as SFR010
  usecase "SFR11: Request Contextualized News Insights from AI Component" as SFR011
  usecase "SFR12: Generate Client Dashboards in an Intuitive Format" as SFR012
  usecase "SFR13: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR14: Generate Client Analytics for Financial Behavior and Performance" as SFR014
  usecase "SFR15: Request Predictive Intervention Analyses from AI Component" as SFR015
  usecase "SFR16: Request Predictive Insights from AI Component to Enhance Guidance Value" as SFR016
  usecase "SFR17: Generate Financial Health Reports Based on Standard Ratios and Metrics" as SFR017
  usecase "SFR18: Manage Users' Financial Goals for Progress Tracking" as SFR018
  usecase "SFR19: Maintain Historical Record of User Insights for Trend Analysis" as SFR019
  usecase "SFR20: Manage User Feedback to Improve System Outputs" as SFR020
  
  C --> SFR001 : CFR002
  C --> SFR002 : CFR004
  C --> SFR003 : CFR003
  C --> SFR004 : CFR004
  C --> SFR005 : CFR006
  C --> SFR006 : CFR007
  C --> SFR009 : CFR008
  C --> SFR12 : CFR009
  
  FA --> SFR003 : FAFR004
  FA --> SFR005 : FAFR006
  FA --> SFR007 : FAFR007
  
  SA --> SFR003 : SAFR001

}

rectangle "Notifications" {
  usecase "SFR021: Notify Users of Critical Financial Events" as SFR021
  
  C --> SFR021
  FA --> SFR021
  SA --> SFR021
}
@enduml