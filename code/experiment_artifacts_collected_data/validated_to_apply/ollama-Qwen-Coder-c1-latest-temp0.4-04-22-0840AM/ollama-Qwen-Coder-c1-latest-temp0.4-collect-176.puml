@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  SA --> (SAFR001)
}

rectangle "AI Component" {
  package "AIFR001-AIFR009" {
    usecase "Generate Financial Predictions" as AIFR001
    usecase "Generate Personalized Recommendations" as AIFR002
    usecase "Generate Spending Limit Alerts" as AIFR003
    usecase "Generate Investment Opportunity Analyses" as AIFR004
    usecase "Generate Investment Opportunities" as AIFR005
    usecase "Generate Anomaly Transaction Alerts" as AIFR006
    usecase "Generate Contextualized News Insights" as AIFR007
    usecase "Generate Client Predictive Intervention Recommendations" as AIFR008
    usecase "Generate Client Predictive Insights" as AIFR009
    
    C --> (AIFR001)
    FA --> (AIFR002)
    SA --> (AIFR003)
  }
  
  package "SFR001-SFR018" {
    usecase "Deliver Alerts to Users" as SFR001
    usecase "Deliver Personalized Recommendations" as SFR002
    usecase "Request Financial Predictions from AI Component" as SFR003
    usecase "Request Personalized Recommendations from AI Component" as SFR004
    usecase "Request Spending Limit Alerts from AI Component" as SFR005
    usecase "Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "Request Specific Investment Opportunities from AI Component" as SFR007
    usecase "Request Anomaly Transaction Alerts from AI Component" as SFR008
    usecase "Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
    usecase "Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR010
    usecase "Request Contextualized News Insights from AI Component" as SFR011
    usecase "Generate Client Dashboards that Present Financial Information in an Intuitive and Actionable Format" as SFR012
    usecase "Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR013
    usecase "Generate Client Analytics That Provide Meaningful Insights into Financial Behavior and Performance" as SFR014
    usecase "Request Predictive Intervention Analyses from AI Component" as SFR015
    usecase "Request Predictive Insights From the AI Component to Enhance the Value of Financial Guidance Provided to Clients" as SFR016
    usecase "Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR017
    usecase "Manage Users' Financial Goals To Track Progress and Provide Relevant Recommendations" as SFR018
    
    C --> (SFR003)
    FA --> (SFR004)
    SA --> (SFR005)
  }
  
  package "AIFR010-AIFR19" {
    usecase "Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR010
    usecase "Maintain a Historical Record of Users' Insights To Enable Trend Analysis and Effectiveness Measurement" as SFR019
    usecase "Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR020
    
    C --> (AIFR010)
  }
}

C --> AIComponent
FA --> AIComponent
SA --> AIComponent

@enduml