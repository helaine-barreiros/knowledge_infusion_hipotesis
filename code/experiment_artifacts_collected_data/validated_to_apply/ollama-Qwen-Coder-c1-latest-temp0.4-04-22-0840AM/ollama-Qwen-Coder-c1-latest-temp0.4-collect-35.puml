@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001
:AIComponent: as AIFR001

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Analysis Parameters for AI System" as SAFR002
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "AIFR006: Generate Anomaly Transaction Alerts for Users" as AIFR006
  
  Client --> CFR001
  SysAdmin --> SAFR002
  FAFR001 --> FAFR004
  SystemAdmin --> SFR013
  AIComponent --> AIFR006
}

rectangle "Client" {
  usecase "CFR002: View Alerts About Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as CFR004
  usecase "CFR005: Manage My Personalized Recommendations Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceed Predefined Thresholds in Specific Expense Categories" as CFR006
  
  Client --> CFR002
  Client --> CFR003
  Client --> CFR004
  Client --> CFR005
  Client --> CFR006
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts When Patterns Require Professional Attention" as FAFR002
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as FAFR003
  
  FinancialAdvisor --> FAFR001
  FinancialAdvisor --> FAFR002
  FinancialAdvisor --> FAFR003
}

rectangle "AI Component" {
  usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance as Defined by Industry Standards Like FINRA Guidelines" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities for Users by Identifying Financial Instruments That Align with Their Investment Strategies and Modern Portfolio Theory Principles" as AIFR005
  
  AIComponent --> AIFR001
  AIComponent --> AIFR002
  AIComponent --> AIFR003
  AIComponent --> AIFR004
  AIComponent --> AIFR005
}

rectangle "System" {
  usecase "SFR007: Request Specific Investment Opportunities from the AI Component That Match User Investment Criteria and ESG (Environmental, Social, and Governance) Preferences" as SFR007
  
  SystemAdmin --> SAFR002
  FinancialAdvisor --> FAFR004
  Client --> CFR005
}

rectangle "Client Feedback" {
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights to Help Improve Future Outputs" as CFR11
  
  Client --> CFR11
}
@enduml