@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure analysis parameters for specific client segments" as FAFR004
  usecase "SFR020: Manage user feedback to continuously improve the quality and relevance of financial insights" as SFR020
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FinancialAdvisor --> FAFR004
}

rectangle "Client Functions" {
  usecase "CFR002: View Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile" as CFR004
  usecase "CFR005: Manage Personalized Recommendations Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as CFR006
  
  Client --> CFR002
  Client --> CFR003
  Client --> CFR004
  Client --> CFR005
  Client --> CFR006
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts When the System Detects Patterns Requiring Professional Attention" as FAFR002
  
  FinancialAdvisor --> FAFR001
  FinancialAdvisor --> FAFR002
}

rectangle "System Functions" {
  usecase "SFR001: Deliver Alerts to Users Through Appropriate Notification Channels" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from the AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations From the AI Component Based On Each User's Financial Data and Preferences" as SFR004
  usecase "SFR005: Request Spending Limit Alerts From the AI Component When User Spending Patterns Exceed Defined Thresholds" as SFR005
  
  System --> SFR001
  System --> SFR002
  System --> SFR003
  System --> SFR004
  System --> SFR005
}

rectangle "Investment Functions" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile (as Defined Under MiFID II or Equivalent Standards)" as CFR007
  usecase "SFR016: Request Predictive Insights From the AI Component To Enhance The Value of Financial Guidance Provided to Clients" as SFR016
  
  Client --> CFR007
  System --> SFR016
}

rectangle "News Functions" {
  usecase "CFR008: View News Related to My Investment Portfolio To Stay Informed About Market Events That Might Affect My Assets" as CFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios From Trusted Financial News Sources" as SFR009
  
  Client --> CFR008
  System --> SFR009
}

rectangle "Dashboard Functions" {
  usecase "CFR009: Access a Personalized Dashboard That Consolidates My Financial Information in a Single View to Efficiently Monitor My Finances" as CFR009
  usecase "SFR12: Generate Client Dashboards that Present Financial Information in an Intuitive and Actionable Format" as SFR12
  
  Client --> CFR009
  System --> SFR12
}

rectangle "Relationship Management Functions" {
  usecase "CFR10: Manage My Relationship with Financial Advisors, Including Permissions for Sharing My Financial Data, to Maintain Privacy and Control Over My Financial Information" as CFR10
  
  Client --> CFR10
}
@enduml