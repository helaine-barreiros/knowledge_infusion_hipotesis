@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FinancialAdvisor
:User: as User

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR005: Manage Analysis Parameters Preferences" as SAFR005
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  Client --> (CFR001)
  Client --> (SAFR005)
  SystemAdmin --> (SAFR005)
}

rectangle "Financial Advisor Module" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  
  FinancialAdvisor --> (FAFR001)
  FinancialAdvisor --> (FAFR002)
}

rectangle "AI Component Module" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  System --> (SFR013)
  FinancialAdvisor --> (FAFR004)
}

rectangle "Notifications Module" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  User --> (SFR001)
  
  Client --> (SAFR005)
  SystemAdmin --> (SAFR005)
}

rectangle "Personalization & Recommendations Module" {
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  User --> (SFR002)
  
  FinancialAdvisor --> (FAFR003)
  SystemAdmin --> (SAFR018)
}

rectangle "Predictive Analytics Module" {
  usecase "SFR004: Request Financial Predictions from AI Component" as SFR004
  User --> (SFR004)
  
  FinancialAdvisor --> (FAFR003)
  SystemAdmin --> (SAFR15)
}

rectangle "Spending Limits Module" {
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  User --> (SFR005)
  
  FinancialAdvisor --> (FAFR03)
  SystemAdmin --> (SAFR16)
}

rectangle "Investment Opportunities Module" {
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  User --> (SFR006)
  
  FinancialAdvisor --> (FAFR04)
  SystemAdmin --> (SAFR17)
}

rectangle "News & Insights Module" {
  usecase "SFR008: Request Contextualized News from AI Component" as SFR008
  User --> (SFR008)
  
  FinancialAdvisor --> (FAFR03)
  SystemAdmin --> (SAFR19)
}

rectangle "Feedback & Improvement Module" {
  usecase "CFR011: Send Feedback About Recommendations and Insights" as CFR011
  
  Client --> (CFR011)
  FinancialAdvisor --> (CFR011)
  User --> (CFR011)
}
@enduml