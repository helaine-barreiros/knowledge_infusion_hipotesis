@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure analysis parameters for specific client segments" as FAFR004
  usecase "SFR012: Generate client dashboards that present financial information in an intuitive and actionable format" as SFR012

  Client --> CFR001
  SysAdmin --> SAFR001
  Financial Advisor --> FAFR004
}

rectangle "Client Features" {
  usecase "CFR002: Receive alerts about anomalous transactions in my accounts" as CFR002
  usecase "CFR003: View financial predictions based on my historical data and current market trends" as CFR003
  usecase "CFR004: Receive personalized recommendations aligned with my financial profile and goals" as CFR004
  usecase "CFR005: Manage my personalized recommendations preferences to ensure the system provides insights relevant to my financial objectives and risk tolerance as defined in my KYC (Know Your Customer) profile." as CFR005
  usecase "CFR006: View spending limit alerts when I exceed predefined thresholds in specific expense categories" as CFR006
  usecase "SFR013: Generate client alerts based on predefined conditions to ensure timely notification of important financial events." as SFR013

  Client --> CFR002
  Client --> CFR003
  Client --> CFR004
  Client --> CFR005
  Client --> CFR006
}

rectangle "Financial Advisor Features" {
  usecase "FAFR001: Manage client mentoring sessions based on system-generated insights to provide more valuable guidance aligned with each client's financial goals." as FAFR001
  usecase "FAFR002: View client intervention alerts when the system detects patterns requiring professional attention to proactively assist clients with potential financial issues." as FAFR002
  usecase "FAFR003: View predictive analytics about my clients' financial situations to provide data-driven recommendations during consultations." as FAFR003

  Financial Advisor --> FAFR001
  Financial Advisor --> FAFR002
  Financial Advisor --> FAFR003
}

rectangle "System Features" {
  usecase "SFR007: Request investment opportunity analysis from the AI component to identify suitable investments for users based on their risk profiles." as SFR007
  usecase "SFR014: Generate client analytics that provide meaningful insights into financial behavior and performance." as SFR014

  System Admin --> SAFR001
}

rectangle "AI Features" {
  usecase "AIFR002: Generate personalized recommendations for users based on their financial profiles, goals, and risk tolerance as defined by industry standards like FINRA guidelines." as AIFR002
  usecase "SFR013: Generate client alerts based on predefined conditions to ensure timely notification of important financial events." as SFR013

  System Admin --> SAFR001
}

rectangle "User Feedback" {
  usecase "CFR11: Send feedback about the system's recommendations and insights to help improve the accuracy and relevance of future outputs." as CFR11
  
  Client -> (SFR20)
  Financial Advisor -> (SFR20)
  System Admin -> (SFR20)

}

@enduml