@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFD002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  usecase "CFR011: Send Feedback about System Recommendations and Insights" as CFR011

  Client --> CFR001
  Client --> SFR003 : Request Predictions
  FinancialAdvisor --> FAFD002
  FinancialAdvisor --> AIFR004 : Generate Opinions
}

rectangle "Client Management" {
  usecase "CFR002: View Alerts about Anomalous Transactions" as CFR002
  usecase "SFR013: Request Client Alerts Based on Predefined Conditions" as SFR013

  Client --> CFR002 : Receive Alerts
}

rectangle "Investment Management" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006

  Client --> CFR007 : View Opinions
}

rectangle "Financial Planning & Guidance" {
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as CFR004
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFD003

  Client --> CFR004 : Get Recommendations
}

rectangle "Spending Management & Alerts" {
  usecase "CFR006: View Spending Limit Alerts When I Exceed Predefined Thresholds in Specific Expense Categories" as CFR006
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005

  Client --> CFR006 : Get Alerts
}

rectangle "News & Information" {
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "SFR014: Generate Client Analytics That Provide Meaningful Insights into Financial Behavior and Performance" as SFR014

  Client --> CFR008 : Get News
}

rectangle "Personalized Dashboard & Preferences Management" {
  usecase "CFR009: Access a Personalized Dashboard that Consolidates My Financial Information in a Single View to Efficiently Monitor My Finances" as CFR009
  usecase "SFR12: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as SFR12

  Client --> CFR009 : Access Dashboard
}

rectangle "Relationship Management & Permissions" {
  usecase "CFR10: Manage My Relationship with Financial Advisors, Including Permissions for Sharing My Financial Data, to Maintain Privacy and Control Over My Financial Information" as CFR10

  Client --> CFR10 : Manage Relationships
}
@enduml