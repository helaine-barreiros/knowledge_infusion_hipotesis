@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  
  Client --> (CFR002)
  Client --> (SFR009) : "View News"
  
  SysAdmin --> (SAFR001)
  
  Financial Advisor --> (FAFR001)
  Financial Advisor --> (FAFR004)
}

rectangle "Client" {
  usecase "CFR002: View Alerts" as CFR002
  usecase "CFR003: View Predictive Insights" as CFR003
  usecase "CFR004: Receive Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limits Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  
  Client --> (SFR013) : "View Alerts"
  Client --> (SFR024) : "Manage Preferences"
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  
  Financial Advisor --> (SFR035) : "View Predictive Insights"
}

rectangle "System Functions" {
  usecase "SFR009: Deliver News Alerts" as SFR009
  usecase "SFR18: Manage User Goals" as SFR18
  
  System Admin --> (SAFR024) : "Manage Preferences"
  
  Financial Advisor --> (FAFR035)
}

rectangle "AI Functions" {
  usecase "AIFR001: Generate Predictions" as AIFR001
  usecase "AIFR002: Generate Recommendations" as AIFR002
  
  Client --> (SFR024) : "Manage Preferences"
  
  Financial Advisor --> (FAFR035)
}

rectangle "User Feedback" {
  usecase "CFR11: Send Feedback" as CFR11
}
@enduml