@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR009: Generate Contextualized News Insights for Users" as AIFR009
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFR002 <|-- (FAFR001)
  
  rectangle "Client Alerts & Recommendations" {
    usecase "CFR002: View Alerts about Anomalous Transactions" as CFR002
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
    
    Client --> (CFR002)
    System --> (SFR004) : <<ID: CFR004>>
  }
  
  rectangle "Client Spending & Budget Management" {
    usecase "CFR006: View Spending Limit Alerts" as CFR006
    usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
    
    Client --> (CFR006)
  }
  
  rectangle "Client Investment Management" {
    usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
    
    Client --> (CFR007)
  }
  
  rectangle "Client News & Information" {
    usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
    usecase "SFR010: Process Contextualized News for Users" as SFR010
    
    Client --> (CFR008)
  }
  
  rectangle "Client Dashboard & Goals Management" {
    usecase "CFR009: Access a Personalized Dashboard that Consolidates My Financial Information" as CFR009
    usecase "SFR20: Manage Users' Financial Goals to Track Progress and Provide Relevant Recommendations" as SFR20
    
    Client --> (CFR009)
  }
  
  rectangle "Client-System Interaction" {
    usecase "AIFR11: Generate Contextualized News Insights for Clients" as AIFR11
    usecase "SFR013: Request Client Alerts Based on Predefined Conditions" as SFR013
    
    System --> (CFR002)
  }
  
  rectangle "Client-Advisor Interaction" {
    usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
    
    FinancialAdvisor --> (FAFR004)
  }
  
  rectangle "Client-System Admin Interaction" {
    usecase "CFR011: Send Feedback about System's Recommendations and Insights to Improve Future Outputs" as CFR011
    usecase "SFR20: Manage Users' Financial Goals to Track Progress and Provide Relevant Recommendations" as SFR20
    
    SysAdmin --> (CFR011)
  }
}

@enduml