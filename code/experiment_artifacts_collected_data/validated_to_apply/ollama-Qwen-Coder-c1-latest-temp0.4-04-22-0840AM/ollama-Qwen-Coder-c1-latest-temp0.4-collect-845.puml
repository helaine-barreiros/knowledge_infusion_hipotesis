@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR013: Access Consolidated Financial Dashboard" as CFR013
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR013
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  
  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SA --> SAFR001
}

package "AI Component" {
  rectangle AIComponent {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
    
    C --> (AIFR001)
    C --> (AIFR002)
    C --> (AIFR003)
    C --> (AIFR004)
    C --> (AIFR005)
    C --> (AIFR006)
    C --> (AIFR007)
    C --> (AIFR008)
    C --> (AIFR009)

    FA --> (AIFR001)
    FA --> (AIFR002)
    FA --> (AIFR003)
    
    SA --> (SAFR001)
  }
}

package "System" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities from AI Component" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  usecase "SFR010: Process Contextualized News for Users" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
  usecase "SFR12: Generate Client Dashboards" as SFR012
  usecase "SFR13: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR14: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR014
  usecase "SFR15: Request Predictive Intervention Analyses from AI Component" as SFR015
  usecase "SFR16: Request Predictive Insights From the AI Component to Enhance Value of Financial Guidance Provided to Clients" as SFR016
  usecase "SFR17: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR017
  usecase "SFR18: Manage Users' Financial Goals Tracking Progress and Providing Relevant Recommendations" as SFR018
  usecase "SFR19: Maintain a Historical Record of Users' Insights for Trend Analysis and Effectiveness Measurement" as SFR019
  usecase "SFR20: Manage User Feedback to Continuously Improve Quality and Relevance of Financial Insights" as SFR020
  
  C --> (SFR001)
  C --> (SFR002)
  C --> (SFR003)
  C --> (SFR004)
  C --> (SFR005)
  C --> (SFR006)
  C --> (SFR007)
  C --> (SFR008)
  C --> (SFR009)
  C --> (SFR010)
  C --> (SFR011)
  C --> (SFR012)
  C --> (SFR013)
  C --> (SFR014)
  C --> (SFR015)
  C --> (SFR016)
  C --> (SFR017)
  C --> (SFR018)
  C --> (SFR019)
  C --> (SFR020)

  FA --> (SFR003)
  FA --> (SFR004)
  FA --> (SFR005)
  
  SA --> (SAFR001)
}

C --> AIComponent
FA --> AIComponent
SA --> AIComponent

@enduml