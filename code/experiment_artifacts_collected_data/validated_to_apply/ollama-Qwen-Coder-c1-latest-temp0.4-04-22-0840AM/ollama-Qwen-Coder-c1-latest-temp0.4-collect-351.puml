@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor "Client" as Client
actor "Financial Advisor" as FAdvisor
actor "System Administrator" as SysAdmin
actor "User (Client, Financial Advisor, or System Administrator)" as User

rectangle "Client Functions" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Consolidated Financial Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10

  Client --> (SAFR002)
  Client --> (SFR003)
  Client --> (AIFR004)
  Client --> (AIFR005)
  Client --> (AIFR006)
  Client --> (AIFR007)
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003

  FAdvisor --> (SAFR004)
  FAdvisor --> (SFR016)
}

rectangle "System Administrator Functions" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004

  SysAdmin --> (SFR002)
}

rectangle "System Functions" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities from AI Component" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Portfolios" as SFR009
  usecase "SFR10: Process Contextualized News for Users" as SFR10
  usecase "SFR11: Request Contextualized News Insights from AI Component" as SFR11
  usecase "SFR12: Generate Client Dashboards" as SFR12
  usecase "SFR13: Generate Client Alerts Based on Predefined Conditions" as SFR13
  usecase "SFR14: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR14
  usecase "SFR15: Request Predictive Intervention Analyses from AI Component" as SFR15
  usecase "SFR16: Enhance Value of Financial Guidance Provided to Clients by Generating Predictive Insights" as SFR16
  usecase "SFR17: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing" as SFR17
  usecase "SFR18: Manage Users' Financial Goals Tracking Progress and Providing Relevant Recommendations" as SFR18
  usecase "SFR19: Maintain Historical Record of Users' Insights for Trend Analysis and Effectiveness Measurement" as SFR19
  usecase "SFR20: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR20

  Sys --> (SAFR003)
  Sys --> (FAFR005)
}

rectangle "AI System Functions" {
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations Based on User Profiles and Goals" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Patterns" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users Based on Their Risk Profiles and Financial Goals" as AIFR004
  usecase "AIFR005: Identify Investments Aligning with User Strategies Using Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition in Compliance with FinCEN Requirements" as AIFR006
  usecase "AIFR007: Correlate Financial News to Specific User Portfolios for Relevant Insights" as AIFR007
  usecase "AIFR008: Generate Predictive Intervention Recommendations by Identifying Patterns Indicating Potential Issues or Opportunities Requiring Advisor Engagement" as AIFR008
  usecase "AIFR009: Provide Forward-Looking Analysis of Financial Situations to Support More Effective Planning" as AIFR009

  Sys --> (SAFR001)
}

User <|-- Client
User <|-- FAdvisor
User <|-- SysAdmin

Client --> CFR011
FAdvisor --> FAFR008
SysAdmin --> SAFR020
@enduml