@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
}

package "System Administrator" {
  actor SysAdmin as SAFR003
}

package "System" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities from AI Component" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  usecase "SFR010: Process Contextualized News to Extract Relevance Information for Users" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
  usecase "SFR012: Generate Client Dashboards that Present Financial Info in an Intuitive Format" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics That Provide Meaningful Insights into Financial Behavior and Performance" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
  usecase "SFR016: Request Predictive Insights From the AI Component to Enhance Value of Guidance Provided to Clients" as SFR016
  usecase "SFR017: Generate Financial Health Reports That Assess Users' Overall Wellbeing According to Standard Ratios and Metrics" as SFR017
  usecase "SFR018: Manage Users' Financial Goals To Track Progress and Provide Relevant Recommendations" as SFR018
  usecase "SFR019: Maintain a Historical Record of Users' Insights to Enable Trend Analysis and Effectiveness Measurement" as SFR019
  usecase "SFR020: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR020
  
}

package "AI System" {
  usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Data, Market Trends, and Economic Indicators" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Profiles, Goals, and Risk Tolerance" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Patterns" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users Evaluating Potential Investments Against Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities for Users by Identifying Instruments Aligning with Their Strategies and Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts Using Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance With FinCEN Requirements" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios Identifying Relevant Impacts" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations for Patterns Indicating Potential Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations Supporting More Effective Planning" as AIFR009
  
}

CFR001 --> SFR002 : View Personalized Recommendations
CFR001 --> SFR003 : Request Financial Predictions from AI Component
CFR001 --> SFR005 : Request Spending Limit Alerts From AI Component
CFR001 --> SFR006 : Request Investment Opportunity Analysis From AI Component
CFR001 --> SFR008 : Request Anomaly Transaction Alerts From AI Component
CFR001 --> SFR009 : Find Contextualized News Relevant to Users' Financial Portfolios
CFR001 --> CFR011 : Send Feedback

FAFR002 --> SFR003 : View Predictive Analytics About Clients' Financial Situations
FAFR002 --> SFR004 : Request Personalized Recommendations From AI Component
FAFR002 --> FAFR006 : Manage Client Mentoring Sessions Based on System-Generated Insights

SysAdmin --> SAFR001 : Manage Analysis Parameters for the AI System
SysAdmin --> CFR011 : Send Feedback

SFR004 <|-- SFR005 : Request Personalized Recommendations from AI Component
SFR006 <|-- SFR007 : Request Specific Investment Opportunities From AI Component
SFR008 <|-- AIFR003 : Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Patterns

AIFR001 --> SFR002 : Deliver Personalized Recommendations to Users Based on Their Profiles, Goals, and Risk Tolerance
AIFR004 --> SFR006 : Request Investment Opportunity Analysis From AI Component
AIFR005 --> SFR007 : Request Specific Investment Opportunities From AI Component
AIFR013 <|-- AIFR020 : Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations Supporting More Effective Planning

@enduml