@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  rectangle "Client" {
    actor "Client" as C
    
    C --> CFR001
    C --> SFR012
  }
  
  rectangle "Financial Advisor" {
    actor "Financial Advisor (FA)" as FA
    
    FA --> FAFR003: View Predictive Analytics
    FA --> FAFR004: Configure Analysis Parameters for Specific Client Segments
    FA --> FAFR002: View Client Intervention Alerts
  }
  
  rectangle "System Administrator" {
    actor "SysAdmin" as SA
    
    SA --> SAFR001: Manage Analysis Parameters
  }

  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  
  C --> (CFR002) : Receive Alerts about Anomalous Transactions
  FA --> FAFR006: View Spending Limit Alerts
  SA --> SAFR017: Generate Financial Health Reports

  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  
  C --> (CFR003) : View Financial Predictions Based on Historical Data and Current Market Trends
  FA --> FAFR001: Manage Client Mentoring Sessions
  SA --> SAFR020: Manage User Feedback

  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  
  C --> (CFR004) : Receive Personalized Recommendations Aligned with Financial Profile and Goals
  FA --> FAFR016: Request Predictive Insights From the AI Component to Enhance Value of Guidance Provided to Clients

  usecase "SFR007: Request Investment Opportunity Analysis from AI Component" as SFR007
  
  C --> (CFR005) : Manage Personalized Recommendations Preferences
  FA --> FAFR16: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations

  usecase "SFR008: Request Contextualized News from AI Component" as SFR008
  
  C --> (CFR007) : View Investment Opportunities Suitable to Risk Profile
  FA --> FAFR15: Generate Predictive Intervention Analyses From the AI Component

  usecase "SFR009: Request Contextualized News Insights from AI Component" as SFR009
  
  C --> (CFR008) : View News Related to Investment Portfolio
  FA --> FAFR14: Generate Client Analytics That Provide Meaningful Insights Into Financial Behavior and Performance

  usecase "SFR020: Manage Users' Feedback To Continuously Improve the Quality and Relevance of Financial Insights" as SFR020
  
  C --> (CFR011) : Send Feedback About System's Recommendations And Insights
}

@enduml