@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FAFR

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics about My Clients' Financial Situations" as FAFR003
  
  User --> CFR001
  SysAdmin --> SAFR001
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts When the System Detects Patterns Requiring Professional Attention" as FAFR002
  
  Financial Advisor --> FAFR001
  Financial Advisor --> FAFR002
}

rectangle "Client Management Functions" {
  usecase "CFR005: Manage Personalized Recommendations Preferences To Ensure the System Provides Insights Relevant to My Financial Objectives and Risk Tolerance As Defined in My KYC (Know Your Customer) Profile" as CFR005
  
  User --> CFR005
}

rectangle "Spending Limit Alerts Functions" {
  usecase "CFR006: View Spending Limit Alerts When I Exceed Predefined Thresholds In Specific Expense Categories To Maintain Better Control Over My Budget" as CFR006
  
  User --> CFR006
}

rectangle "Investment Opportunities Functions" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile (As Defined Under MiFID II or Equivalent Standards) to Diversify My Portfolio and Maximize Returns" as CFR007
  
  User --> CFR007
}

rectangle "News Related Functions" {
  usecase "CFR008: View News Related To My Investment Portfolio To Stay Informed About Market Events That Might Affect My Assets" as CFR008
  
  User --> CFR008
}

rectangle "Personalized Dashboard Functions" {
  usecase "CFR012: Generate Client Dashboards that Present Financial Information in an Intuitive and Actionable Format" as CFR012
  
  User --> CFR012
}

rectangle "Relationship Management Functions" {
  usecase "CFR010: Manage My Relationship with Financial Advisors, Including Permissions for Sharing My Financial Data, to Maintain Privacy and Control Over My Financial Information" as CFR010
  
  User --> CFR010
}

rectangle "System Functions" {
  usecase "SFR002: Deliver Personalized Recommendations To Users Based on Their Financial Profiles to Support Better Financial Decision-Making" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance As Defined by Industry Standards Like FINRA Guidelines" as AIFR002
  
  System --> SFR002
  System --> AIFR002
}

rectangle "Feedback Management Functions" {
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as CFR11
  
  User --> CFR11
}
@enduml