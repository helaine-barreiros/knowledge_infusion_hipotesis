@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendations Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (View Financial Insights Dashboard)
  C --> (Receive Alerts about Anomalous Transactions)
  C --> (View Financial Predictions)
  C --> (Receive Personalized Recommendations)
  C --> (Manage Recommendations Preferences)
  C --> (View Spending Limit Alerts)
  C --> (View Investment Opportunities)
  C --> (View News Related to Portfolio)
  C --> (Access Personalized Dashboard)
  C --> (Manage Relationship with Financial Advisors)
}

package "Financial Advisors" {
  actor Advisor as A
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  A --> (Manage Client Mentoring Sessions)
  A --> (View Client Intervention Alerts)
  A --> (View Predictive Analytics about Clients' Financial Situations)
  A --> (Configure Analysis Parameters for Specific Client Segments)
}

package "System Administrator" {
  actor SysAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFAFR001: Send Feedback about System's Recommendations and Insights" as SFAFR001
  
  SA --> (Manage Analysis Parameters)
  SA --> (Send Feedback about System's Recommendations and Insights)
}

package "System Components" {
  rectangle "AI Component" {
    usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities for Users" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights that Provide Forward-Looking Analysis of Financial Situations" as AIFR009
    
    C --> (Generate Financial Predictions for Users)
    C --> (Generate Personalized Recommendations for Users)
    C --> (Generate Spending Limit Alerts for Users)
    C --> (Generate Investment Opportunity Analyses for Users)
    C --> (Generate Investment Opportunities for Users)
    C --> (Generate Anomaly Transaction Alerts by Employing Pattern Recognition)
    C --> (Generate Contextualized News Insights)
    C --> (Generate Client Predictive Intervention Recommendations)
    C --> (Generate Client Predictive Insights that Provide Forward-Looking Analysis of Financial Situations)
    
    A --> (Generate Financial Predictions for Users)
    A --> (Generate Personalized Recommendations for Users)
    A --> (Generate Spending Limit Alerts for Users)
    A --> (Generate Investment Opportunity Analyses for Users)
    A --> (Generate Investment Opportunities for Users)
    A --> (Generate Anomaly Transaction Alerts by Employing Pattern Recognition)
    A --> (Generate Contextualized News Insights)
    A --> (Generate Client Predictive Intervention Recommendations)
    A --> (Generate Client Predictive Insights that Provide Forward-Looking Analysis of Financial Situations)
    
    SA --> (Manage Analysis Parameters for Users)
  }
  
  rectangle "Notification System" {
    usecase "SFR001: Deliver Alerts to Users Through Appropriate Notification Channels" as SFR001
    C --> (Deliver Alerts to Users Through Appropriate Notification Channels)
  }
}

@enduml