@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts About Anomalous Transactions" as SAFR004
  usecase "CFR003: View Financial Predictions Based on Historical Data and Current Market Trends" as SAFR005
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as SAFR006
  usecase "CFR005: Manage Personalized Recommendations Preferences to Ensure Relevance to My Financial Objectives and Risk Tolerance" as SAFR018
  usecase "CFR006: View Spending Limit Alerts When I Exceed Predefined Thresholds in Specific Expense Categories" as SFR004
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile (as Defined Under MiFID II or Equivalent Standards)" as SAFR012
  usecase "CFR008: View News Related to My Investment Portfolio to Stay Informed About Market Events" as SFR009
  usecase "CFR009: Access a Personalized Dashboard That Consolidates My Financial Information in a Single View" as SAFR017
  
  CFR001 --> SAFR004 : Receive Alerts
  CFR001 --> SAFR005 : View Predictions
  CFR001 --> SAFR006 : Get Recommendations
  CFR001 --> SAFR008 : Manage Preferences
  CFR001 --> SFR004 : Exceed Thresholds
  CFR001 --> SAFR012 : View Opportunities
  CFR001 --> SFR009 : Stay Informed
  CFR001 --> SAFR017 : Access Dashboard
  
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR002: Manage Client Mentoring Sessions Based on System-Generated Insights to Provide More Valuable Guidance Aligned with Each Client's Financial Goals" as SAFR007
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as SAFR016
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments to Customize the System's Behavior According to Different Client Profiles and Regulatory Requirements Such As GDPR or CCPA" as SFR023
  
  FinancialAdvisor --> SAFR007 : Manage Sessions
  FinancialAdvisor --> SAFR016 : View Analytics
  FinancialAdvisor --> SFR023 : Configure Parameters
  
}

package "System Administrator" {
  actor SystemAdmin as SAFR001
  
  usecase "SAFR009: Deliver Alerts to Users Through Appropriate Notification Channels to Ensure Timely Awareness of Critical Financial Events" as SFR014
  usecase "SAFR012: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as SAFR015
  
  SystemAdmin --> SFR014 : Deliver Alerts
  SystemAdmin --> SAFR015 : Generate Dashboards
  
}

package "System Components" {
  
  usecase "SFR023: Request Predictive Intervention Analyses from the AI Component to Identify When Financial Advisors Should Engage with Clients" as AIFR009
  usecase "AIFR008: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance With FinCEN Requirements" as SFR024
  
  SystemComponents --> AIFR009 : Request Analyses
  SystemComponents --> SFR024 : Generate Alerts
  
}

package "AI System" {
  
  usecase "AIFR013: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR013
  usecase "AIFR016: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance As Defined By Industry Standards Like FINRA Guidelines" as SAFR025
  
  AISystem --> AIFR013 : Generate Predictions
  AISystem --> SAFR025 : Generate Recommendations
  
}

package "User Feedback Management" {
  
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as SFR026
  
  UserFeedbackManagement --> SFR026 : Receive Feedback
  
}
@enduml