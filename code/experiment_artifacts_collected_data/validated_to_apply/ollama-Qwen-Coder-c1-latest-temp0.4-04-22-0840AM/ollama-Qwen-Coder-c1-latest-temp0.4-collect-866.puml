@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FinancialAdvisor
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FinancialAdvisor --> FAFR002
}

rectangle "Client Dashboard Management" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  Client --> CFR009
  SysAdmin --> SFR012
}

rectangle "Alert Management" {
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "SFR013: Generate Client Alerts" as SFR013
  
  Client --> CFR006
  SysAdmin --> SFR013
}

rectangle "Recommendation Management" {
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  
  Client --> CFR004
  SysAdmin --> SFR002
}

rectangle "Investment Management" {
  usecase "CFR017: View Investment Opportunities Suitable to My Risk Profile" as CFR017
  usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
  
  Client --> CFR017
  SysAdmin --> SFR006
}

rectangle "News Management" {
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "SFR009: Request Contextualized News Insights" as SFR009
  
  Client --> CFR008
  SysAdmin --> SFR009
}

rectangle "Relationship Management" {
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  Client --> CFR10
  SystemAdmin --> CFR10
}

rectangle "Feedback Management" {
  usecase "CFR11: Send Feedback about the System's Recommendations and Insights" as CFR11
  
  Client --> CFR11
  SysAdmin --> CFR11
}
@enduml