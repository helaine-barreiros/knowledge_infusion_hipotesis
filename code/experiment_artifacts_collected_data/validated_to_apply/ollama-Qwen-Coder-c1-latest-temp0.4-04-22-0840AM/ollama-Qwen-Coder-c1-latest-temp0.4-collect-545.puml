@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor (FA): as FA
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR005: Manage Analysis Parameters Preferences" as SAFR005
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  Client --> CFR001
  SysAdmin --> SAFR005
}

rectangle "Financial Advisor (FA)" {
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FA --> FAFR003
  FA --> FAFR004
}

rectangle "System (Notifications)" {
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  
  Sys --> SFR013
  Sys --> AIFR006
}

rectangle "System (Recommendations)" {
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  
  Sys --> SFR002
  Sys --> AIFR002
}

rectangle "System (Predictive Insights)" {
  usecase "SFR16: Request Predictive Insights from the AI Component to Enhance Value of Financial Guidance Provided to Clients" as SFR16
  usecase "AIFR009: Generate Client Predictive Insights that Provide Forward-Looking Analysis of Financial Situations" as AIFR009
  
  Sys --> SFR16
  Sys --> AIFR009
}

rectangle "System (Investment Opportunities)" {
  usecase "SFR006: Request Investment Opportunity Analysis from the AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles" as SFR006
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  
  Sys --> SFR006
  Sys --> AIFR004
}

rectangle "System (Spending Limits)" {
  usecase "SFR005: Request Spending Limit Alerts from the AI Component When User Spending Patterns Exceed Defined Thresholds" as SFR005
  usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
  
  Sys --> SFR005
  Sys --> AIFR003
}

rectangle "System (News)" {
  usecase "SFR010: Find Contextualized News Relevant to Users' Financial Portfolios From Trusted Financial News Sources" as SFR010
  usecase "AIFR007: Generate Client Predictive Insights by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR007
  
  Sys --> SFR010
  Sys --> AIFR007
}

rectangle "System (Health Reports)" {
  usecase "SFR17: Generate Financial Health Reports that Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR17
  
  Sys --> SFR17
}

rectangle "User Feedback" {
  usecase "CFR011: Send Feedback about the System's Recommendations and Insights to Help Improve Accuracy and Relevance of Future Outputs" as CFR011
  
  Client --> CFR011
  FA --> CFR011
  SysAdmin --> CFR011
}
@enduml