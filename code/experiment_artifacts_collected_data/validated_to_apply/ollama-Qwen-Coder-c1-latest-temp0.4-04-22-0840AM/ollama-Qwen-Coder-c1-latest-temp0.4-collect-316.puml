@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SysAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR019: Maintain Historical Record of Users' Insights" as SFR019
  
  SA --> (SAFR001)
  SA --> (SFR019)
}

package "System" {
  rectangle SystemBoundary {
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities from AI Component with ESG Preferences" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
    usecase "SFR10: Process Contextualized News for User's Financial Situation" as SFR10
    usecase "SFR11: Request Contextualized News Insights from AI Component" as SFR11
    usecase "SFR12: Generate Client Dashboards with Financial Information" as SFR12
    usecase "SFR13: Generate Client Alerts Based on Predefined Conditions" as SFR13
    usecase "SFR14: Generate Client Analytics for Meaningful Insights into Financial Behavior and Performance" as SFR14
    usecase "SFR15: Request Predictive Intervention Analyses from AI Component" as SFR15
    usecase "SFR16: Request Predictive Insights from AI Component to Enhance Value of Guidance Provided by Advisors" as SFR16
    usecase "SFR17: Generate Financial Health Reports Based on Standard Ratios and Metrics" as SFR17
    usecase "SFR18: Manage Users' Financial Goals for Tracking Progress and Recommendations" as SFR18
    usecase "SFR20: Request User Feedback to Improve Accuracy and Relevance of Outputs" as SFR20
    
    C --> (SFR002)
    FA --> (SFR003)
    SA --> (SFR004)
  }
}

package "AI System" {
  rectangle AIBoundary {
    usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations Based on User Profiles and Goals" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Patterns" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users Based on Their Risk Profiles and Financial Goals" as AIFR004
    usecase "AIFR005: Identify Suitable Investments Aligning with User Strategies Using Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition for Fraud Detection in Compliance with FinCEN Requirements" as AIFR006
    usecase "AIFR007: Correlate Financial News to Specific User Portfolios to Identify Relevant Impacts" as AIFR007
    usecase "AIFR008: Generate Predictive Intervention Recommendations by Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Provide Forward-Looking Analysis of Financial Situations to Support More Effective Planning" as AIFR009
    
    C --> (AIFR001)
    FA --> (AIFR002)
    SA --> (AIFR003)
  }
}

@enduml