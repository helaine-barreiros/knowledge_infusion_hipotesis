@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FAFR001

package "Clients" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  User --> CFR001
  User --> CFR002
  User --> CFR003
  User --> CFR004
  User --> CFR005
  User --> CFR006
  User --> CFR007
  User --> CFR008
  User --> CFR009
  User --> CFR10
  
}

package "Financial Advisors" {
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FinancialAdvisor --> FAFR001
  FinancialAdvisor --> FAFR002
  FinancialAdvisor --> FAFR003
  FinancialAdvisor --> FAFR004

}

package "System Admins" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SystemAdmin --> SAFR001

}

rectangle "Notifications & Alerts" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  
  User --> SFR001
  FinancialAdvisor --> SFR001
  SystemAdmin --> SFR001
  FAFR002 <|-- (User)
}

rectangle "Personalized Recommendations & Predictions" {
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  
  User --> SFR002
  FinancialAdvisor --> SFR002
  SystemAdmin --> SFR002

}

rectangle "Financial Predictions & Insights" {
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  
  User --> SFR003
  FinancialAdvisor --> SFR003
  SystemAdmin --> SFR003

}

rectangle "Spending Limit Alerts & Investment Opportunities" {
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
  
  User --> SFR005
  FinancialAdvisor --> SFR005

}

rectangle "Investment Opportunity Analysis & News Insights" {
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  
  User --> SFR006
  FinancialAdvisor --> SFR006

}

rectangle "Contextualized News & Predictive Insights" {
  usecase "SFR012: Request Client Dashboards from AI Component" as SFR012
  usecase "AIFR007: Generate Contextualized News Insights for Users" as AIFR007
  
  User --> SFR012

}

rectangle "Feedback Management & System Maintenance" {
  usecase "CFR11: Send Feedback about Recommendations and Insights" as CFR11
  usecase "SFR020: Manage User Feedback to Improve Outputs" as SFR020
  
  User --> CFR11
  FinancialAdvisor --> CFR11
  SystemAdmin --> CFR11

}

@enduml