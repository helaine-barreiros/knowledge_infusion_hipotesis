@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
}

package "System Administrator" {
  actor SysAdmin as SAFR003
}

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  CFR001 --> CFR002 : "View Alerts"
  CFR001 --> CFR003 : "View Predictions"
  CFR001 --> CFR004 : "Receive Recommendations"
  CFR001 --> CFR005 : "Manage Preferences"
  CFR001 --> CFR006 : "Spending Limit Alerts"
  CFR001 --> CFR007 : "Investment Opportunities"
  CFR001 --> CFR008 : "View News"
  CFR001 --> CFR009 : "Consolidated Dashboard"
  CFR001 --> CFR010 : "Manage Relationships"

  FAFR002 --> SAFR004 : "Configure Parameters for Client Segments"
  
  SysAdmin --> SAFR005 : "Set Alerts" 
}

@enduml