@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure analysis parameters for specific client segments" as FAFR004
  usecase "SFR002: Deliver personalized recommendations to users based on their financial profiles" as SFR002
  usecase "AIFR001: Generate financial predictions for users by analyzing historical transaction data, market trends, and economic indicators" as AIFR001
  usecase "SFR013: Request predictive intervention analyses from the AI component to identify when financial advisors should engage with clients" as SFR013
  
  Client --> CFR001 : "View Financial Insights Dashboard"
  Client --> SAFR001 : "Manage Analysis Parameters"
  SysAdmin --> SAFR001 : "Manage Analysis Parameters"
  FAFR001 --> FAFR004 : "Configure analysis parameters for specific client segments"
  SystemAdmin --> SFR002 : "Deliver personalized recommendations to users based on their financial profiles"
  Client --> AIFR001 : "Generate financial predictions for users by analyzing historical transaction data, market trends, and economic indicators"
  FAFR001 --> SFR013 : "Request predictive intervention analyses from the AI component to identify when financial advisors should engage with clients"
}

@enduml