@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as client
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  client --> CFR001 : "View"
  client --> CFR002 : "Receive Alerts"
  client --> CFR003 : "Predictions"
  client --> CFR004 : "Recommendations"
  client --> CFR005 : "Manage Preferences"
  client --> CFR006 : "Spending Limits"
  client --> CFR007 : "Investment Opportunities"
  client --> CFR008 : "News"
  client --> CFR009 : "Dashboard"
  client --> CFR10 : "Relationship Management"
}

package "Financial Advisor" {
  actor FinancialAdvisor as advisor
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  advisor --> FAFR001 : "Manage Sessions"
  advisor --> FAFR002 : "View Alerts"
  advisor --> FAFR003 : "Predictive Analytics"
  advisor --> FAFR004 : "Configure Parameters"
}

package "System" {
  actor System as sys
  
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities from AI Component" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Portfolios" as SFR009
  usecase "SFR010: Process Contextualized News for Users" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics Providing Meaningful Insights" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
  usecase "SFR016: Request Predictive Insights From the AI Component" as SFR016
  usecase "SFR017: Generate Financial Health Reports Assessing Users' Overall Wellbeing" as SFR017
  usecase "SFR018: Manage Users' Financial Goals Tracking Progress and Providing Recommendations" as SFR018
  usecase "SFR019: Maintain Historical Record of Users' Insights for Trend Analysis" as SFR019
  usecase "SFR020: Manage User Feedback to Improve System Outputs" as SFR020
  
  sys --> CFR001 : "Deliver"
  sys --> CFR002 : "Alerts"
  sys --> CFR003 : "Predictions"
  sys --> CFR004 : "Recommendations"
  sys --> CFR005 : "Manage Preferences"
  sys --> CFR006 : "Spending Limits"
  sys --> CFR007 : "Investment Opportunities"
  sys --> CFR008 : "News"
  sys --> CFR009 : "Dashboard"
  sys --> CFR10 : "Relationship Management"
  
  sys --> FAFR001 : "Manage Sessions"
  sys --> FAFR002 : "View Alerts"
  sys --> FAFR003 : "Predictive Analytics"
  sys --> FAFR004 : "Configure Parameters"
}

package "AI System" {
  actor AI as ai
  
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations Based on User Profiles and Goals" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Patterns" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users Based on Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Aligning with User Strategies and Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance With FinCEN Requirements" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009
  
  ai --> CFR001 : "Generate"
  ai --> CFR002 : "Recommendations"
  ai --> CFR003 : "Spending Limits"
  ai --> CFR004 : "Investment Opportunities"
  ai --> CFR005 : "Opportunities Based on Strategies and Principles"
  ai --> CFR006 : "Anomaly Alerts"
  ai --> CFR007 : "News Insights"
  ai --> CFR008 : "Intervention Recommendations"
  ai --> CFR009 : "Predictive Insights"
}

rectangle System {
  client
  advisor
  sys
  ai
}
@enduml