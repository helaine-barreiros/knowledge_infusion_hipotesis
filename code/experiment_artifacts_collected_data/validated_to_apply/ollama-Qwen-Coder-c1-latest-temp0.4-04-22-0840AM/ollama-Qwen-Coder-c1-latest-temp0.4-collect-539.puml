@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR012) : "View Dashboards"
  C --> (CFR11) : "Send Feedback"
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR019: Maintain Historical Record of Insights" as SFR019
  usecase "SFR20: Manage User Feedback" as SFR20
  
  SA --> (SAFR001)
}

package "System" {
  rectangle SystemBoundary {
    usecase "SFR001: Deliver Alerts" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
    usecase "SFR005: Request Spending Limit Alerts" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities from AI" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Portfolios" as SFR009
    usecase "SFR10: Process Contextualized News for Users" as SFR10
    usecase "SFR11: Request Contextualized News Insights from AI" as SFR11
    usecase "SFR12: Generate Client Dashboards" as SFR12
    usecase "SFR13: Generate Client Alerts Based on Predefined Conditions" as SFR13
    usecase "SFR14: Generate Client Analytics Providing Meaningful Insights" as SFR14
    usecase "SFR15: Request Predictive Intervention Analyses from AI" as SFR15
    usecase "SFR16: Request Predictive Insights From the AI Component to Enhance Financial Guidance" as SFR16
    usecase "SFR17: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing" as SFR17
    usecase "SFR18: Manage Users' Financial Goals Tracking Progress and Providing Relevant Recommendations" as SFR18
    
    C --> (SFR003)
    FA --> (SFR006)
    SA --> (SFR20)
  }
}

package "AI System" {
  rectangle AIBoundary {
    usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations Based on User Profiles and Goals" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users Based on Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities by Identifying Financial Instruments Aligning with User Strategies and Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance With FinCEN Requirements" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009
    
    C --> (AIFR002)
    FA --> (AIFR004)
  }
}

@enduml