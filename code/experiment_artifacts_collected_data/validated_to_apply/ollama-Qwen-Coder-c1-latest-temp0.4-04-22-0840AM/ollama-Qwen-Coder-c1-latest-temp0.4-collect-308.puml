@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (View Financial Insights Dashboard)
  C --> (Receive Alerts about Anomalous Transactions)
  C --> (View Financial Predictions)
  C --> (Receive Personalized Recommendations)
  C --> (Manage Recommendation Preferences)
  C --> (View Spending Limit Alerts)
  C --> (View Investment Opportunities)
  C --> (View News Related to Portfolio)
  C --> (Access Personalized Dashboard)
  C --> (Manage Relationship with Financial Advisors)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FA --> (Manage Client Mentoring Sessions)
  FA --> (View Client Intervention Alerts)
  FA --> (View Predictive Analytics about Clients' Financial Situations)
  FA --> (Configure Analysis Parameters for Specific Client Segments)
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR021: Send Feedback about Recommendations and Insights" as SFR021
  
  SA --> (Manage Analysis Parameters)
  SA --> (Send Feedback about Recommendations and Insights)
}

package "System" {
  rectangle SystemBoundary {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities from AI Component" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
    usecase "SFR010: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR010
    usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
    usecase "SFR012: Generate Client Dashboards that Present Financial Information in an Intuitive and Actionable Format" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR013
    usecase "SFR014: Generate Client Analytics that Provide Meaningful Insights into Financial Behavior and Performance" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component to Identify When Financial Advisors Should Engage with Clients" as SFR015
    usecase "SFR016: Request Predictive Insights from AI Component to Enhance the Value of Financial Guidance Provided to Clients" as SFR016
    usecase "SFR017: Generate Financial Health Reports that Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR017
    usecase "SFR018: Manage Users' Financial Goals to Track Progress and Provide Relevant Recommendations" as SFR018
    usecase "SFR019: Maintain a Historical Record of Users' Insights to Enable Trend Analysis and Effectiveness Measurement" as SFR019
    usecase "SFR020: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR020
    
    C --> (Deliver Alerts to Users)
    FA --> (Deliver Personalized Recommendations)
    SA --> (Request Financial Predictions from AI Component)
    SA --> (Request Personalized Recommendations from AI Component)
    SA --> (Request Spending Limit Alerts from AI Component)
    SA --> (Request Investment Opportunity Analysis from AI Component)
    SA --> (Request Specific Investment Opportunities from AI Component)
    SA --> (Request Anomaly Transaction Alerts from AI Component)
    SA --> (Find Contextualized News Relevant to Users' Financial Portfolios)
    SA --> (Process Contextualized News to Extract Relevant Information for Users' Financial Situations)
    SA --> (Request Contextualized News Insights from AI Component)
    SA --> (Generate Client Dashboards that Present Financial Information in an Intuitive and Actionable Format)
    SA --> (Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events)
    SA --> (Generate Client Analytics that Provide Meaningful Insights into Financial Behavior and Performance)
    SA --> (Request Predictive Intervention Analyses from AI Component to Identify When Financial Advisors Should Engage with Clients)
    SA --> (Request Predictive Insights from AI Component to Enhance the Value of Financial Guidance Provided to Clients)
    SA --> (Generate Financial Health Reports that Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics)
    SA --> (Manage Users' Financial Goals to Track Progress and Provide Relevant Recommendations)
    SA --> (Maintain a Historical Record of Users' Insights to Enable Trend Analysis and Effectiveness Measurement)
    SA --> (Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights)
  }
}

package "AI System" {
  rectangle AIBoundary {
    usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities for Users" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights that Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009
    
    C --> (Generate Financial Predictions for Users)
    FA --> (Generate Personalized Recommendations for Users)
    SA --> (Generate Spending Limit Alerts for Users)
    SA --> (Generate Investment Opportunity Analyses for Users)
    SA --> (Generate Investment Opportunities for Users)
    SA --> (Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements)
    SA --> (Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts)
    SA --> (Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement)
    SA --> (Generate Client Predictive Insights that Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning)
  }
}

@enduml