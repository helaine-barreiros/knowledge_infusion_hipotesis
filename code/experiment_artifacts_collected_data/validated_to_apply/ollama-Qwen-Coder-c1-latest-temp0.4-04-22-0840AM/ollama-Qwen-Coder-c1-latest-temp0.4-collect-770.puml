@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as Client
:User (Financial Advisor): as FAdvisor
:System Admin: as SysAdmin

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  Client --> (CFR001)
}

rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage client mentoring sessions based on system-generated insights" as FAFR001
  usecase "FAFR002: View client intervention alerts when the system detects patterns requiring professional attention to proactively assist clients with potential financial issues" as FAFR002
  
  FAdvisor --> (FAFR001)
  FAdvisor --> (FAFR002)
}

rectangle "Client Interface" {
  usecase "CFR002: Receive alerts about anomalous transactions in my accounts to quickly identify potential fraud or unusual spending patterns according to regulations set by the Financial Action Task Force (FATF)" as CFR002
  usecase "CFR003: View financial predictions based on my historical data and current market trends to make more informed financial decisions and plan for future expenses" as CFR003
  usecase "CFR004: Receive personalized recommendations aligned with my financial profile and goals to optimize my financial strategies and investment portfolio" as CFR004
  usecase "CFR005: Manage my personalized recommendations preferences to ensure the system provides insights relevant to my financial objectives and risk tolerance as defined in my KYC (Know Your Customer) profile" as CFR005
  usecase "CFR006: View spending limit alerts when I exceed predefined thresholds in specific expense categories to maintain better control over my budget" as CFR006
  usecase "CFR007: View investment opportunities suitable to my risk profile (as defined under MiFID II or equivalent standards) to diversify my portfolio and maximize returns" as CFR007
  usecase "CFR008: View news related to my investment portfolio to stay informed about market events that might affect my assets" as CFR008
  usecase "CFR009: Access a personalized dashboard that consolidates my financial information in a single view to efficiently monitor my finances" as CFR009
  
  Client --> (CFR002)
  Client --> (CFR003)
  Client --> (CFR004)
  Client --> (CFR005)
  Client --> (CFR006)
  Client --> (CFR007)
  Client --> (CFR008)
  Client --> (CFR009)
}

rectangle "System Interface" {
  usecase "SFR001: Deliver alerts to users through appropriate notification channels to ensure timely awareness of critical financial events" as SFR001
  usecase "SFR002: Deliver personalized recommendations to users based on their financial profiles to support better financial decision-making" as SFR002
  usecase "SFR003: Request financial predictions from the AI component to provide users with forward-looking financial insights" as SFR003
  usecase "SFR004: Request personalized recommendations from the AI component based on each user's financial data and preferences" as SFR004
  usecase "SFR005: Request spending limit alerts from the AI component when user spending patterns exceed defined thresholds" as SFR005
  usecase "SFR006: Request investment opportunity analysis from the AI component to identify suitable investments for users based on their risk profiles" as SFR006
  usecase "SFR007: Request specific investment opportunities from the AI component that match user investment criteria and ESG (Environmental, Social, and Governance) preferences" as SFR007
  usecase "SFR008: Request anomaly transaction alerts from the AI component to detect potentially fraudulent activities in accordance with AML (Anti-Money Laundering) regulations" as SFR008
  usecase "SFR009: Find contextualized news relevant to users' financial portfolios from trusted financial news sources" as SFR009
  usecase "SFR010: Process contextualized news to extract relevant information for users' financial situations" as SFR010
  usecase "SFR011: Request contextualized news insights from the AI component to identify potential impacts on users' investments" as SFR011
