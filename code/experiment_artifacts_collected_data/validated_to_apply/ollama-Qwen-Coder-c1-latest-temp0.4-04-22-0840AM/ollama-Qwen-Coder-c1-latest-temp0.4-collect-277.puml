@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User: as User
:System: as Sys

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10

  User --> CFR001
  User --> CFR002
  User --> CFR003
  User --> CFR004
  User --> CFR005
  User --> CFR006
  User --> CFR007
  User --> CFR008
  User --> CFR009
  User --> CFR10

}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004

  User --> FAFR001
  User --> FAFR002
  User --> FAFR003
  User --> FAFR004
}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters for the AI System" as SAFR001

  SysAdmin --> SAFR001
}

package "Notifications and Alerts" {
  rectangle "SFR001: Deliver Alerts to Users" {
    usecase "SFR002: Deliver Personalized Recommendations Based on Financial Profiles" as SFR002
    usecase "SFR003: Request Financial Predictions from the AI Component" as SFR003
    usecase "SFR004: Request Personalized Recommendations from the AI Component Based on Each User's Data and Preferences" as SFR004
    usecase "SFR005: Request Spending Limit Alerts From the AI Component When Spending Patterns Exceed Defined Thresholds" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from the AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities From the AI Component That Match User Criteria and ESG Preferences" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from the AI Component to Detect Potentially Fraudulent Activities in Accordance with AML Regulations" as SFR008
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013

    User --> SFR002
    User --> SFR003
    User --> SFR004
    User --> SFR005
    User --> SFR006
    User --> SFR007
    User --> SFR008
    User --> SFR013

  }
}

package "News and Insights" {
  rectangle "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" {
    usecase "SFR010: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR010
    usecase "SFR017: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR017

    User --> SFR010
    User --> SFR017
  }
}

package "Predictive Analytics and Recommendations" {
  rectangle "SFR014: Generate Client Analytics That Provide Meaningful Insights into Financial Behavior and Performance" {
    usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Profiles, Goals, and Risk Tolerance as Defined by Industry Standards" as AIFR002
    usecase "SFR015: Request Predictive Intervention Analyses From the AI Component to Identify When Financial Advisors Should Engage with Clients" as SFR015

    User --> AIFR002
    User --> SFR015
  }

  rectangle "AIFR009: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Planning" {
    usecase "SFR016: Request Predictive Insights From the AI Component To Enhance the Value of Financial Guidance Provided to Clients" as SFR016

    User --> AIFR009
    User --> SFR016
  }
}

package "AI System Functions" {
  rectangle "AIFR003: Generate Spending Limit Alerts for Users By Identifying Unusual Deviations From Established Spending Patterns" {
    usecase "SFR020: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR020

    User --> AIFR003
  }

  rectangle "AIFR017: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios To Identify Relevant Impacts" {
    usecase "SFR019: Maintain a Historical Record of Users' Insights to Enable Trend Analysis and Effectiveness Measurement" as SFR019

    User --> AIFR017
  }
}

rectangle "User Feedback Management" {
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights" as CFR11

  User --> CFR11
}

@enduml