@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System: as Sys
:FinancialAdvisor: as FinancialAdvisor
:SystemAdmin: as SysAdmin

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  Client --> (SFR012) : "View Financial Insights"
  SysAdmin --> SAFR001

  rectangle "Client Features" {
    Client --> CFR002 : "Receive Alerts for Anomalous Transactions"
    Client --> CFR003 : "View Financial Predictions"
    Client --> CFR004 : "Get Personalized Recommendations"
    Client --> CFR005 : "Manage Recommendation Preferences"
    Client --> CFR006 : "View Spending Limit Alerts"
    Client --> CFR007 : "Access Investment Opportunities"
    Client --> CFR008 : "View Financial News"
    Client --> CFR009 : "Access Personalized Dashboard"
    Client --> (SFR11) : "Send Feedback"
  }

  rectangle "Financial Advisor Features" {
    FinancialAdvisor --> FAFR001 : "Manage Mentoring Sessions"
    FinancialAdvisor --> FAFR002 : "View Intervention Alerts"
    FinancialAdvisor --> FAFR003 : "View Predictive Analytics"
    FinancialAdvisor --> (SFR05) : "Configure Analysis Parameters for Client Segments"
  }

  rectangle "System Features" {
    System --> SFR013 : "Deliver Personalized Recommendations"
    System --> SFR009 : "Request News Insights"
    System --> SFR012 : "Generate Dashboards"
    System --> (SFR07) : "Request Investment Opportunities Matching Criteria and Preferences"
  }
}

@enduml