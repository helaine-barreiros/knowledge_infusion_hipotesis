  usecase "FAFR002: View predictive analytics about my clients' financial situations to provide data-driven recommendations during consultations" as FAFR013
  
  CFR001 --> (View Financial Insights Dashboard)
  SAFR002 --> (Manage Analysis Parameters)
  FAFR003 --> (Configure analysis parameters for specific client segments)
}

rectangle "Feedback System" {
  usecase "CFR011: Send feedback about the system's recommendations and insights to help improve the accuracy and relevance of future outputs" as CFR011
  
  CFR001 --> (View Financial Insights Dashboard)
  SAFR002 --> (Manage Analysis Parameters)
  FAFR003 --> (Configure analysis parameters for specific client segments)
}

