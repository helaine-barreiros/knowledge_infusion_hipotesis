@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
}

package "System Administrator" {
  actor SysAdmin as SAFR003
}

rectangle "User Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR002
  usecase "FAFR004: Configure analysis parameters for specific client segments" as FAFR003
  
  CFR001 --> (View Financial Insights Dashboard)
  SAFR002 --> (Manage Analysis Parameters)
  FAFR003 --> (Configure analysis parameters for specific client segments)
}

rectangle "Notification System" {
  usecase "SFR001: Deliver alerts to users through appropriate notification channels" as SFR001
  usecase "FAFR002: View client intervention alerts when the system detects patterns requiring professional attention" as FAFR004
  
  CFR001 --> (View Financial Insights Dashboard)
  SAFR002 --> (Manage Analysis Parameters)
  FAFR003 --> (Configure analysis parameters for specific client segments)
}

rectangle "Recommendation System" {
  usecase "SFR002: Deliver personalized recommendations to users based on their financial profiles" as SFR002
  usecase "FAFR001: Manage client mentoring sessions based on system-generated insights" as FAFR005
  
  CFR001 --> (View Financial Insights Dashboard)
  SAFR002 --> (Manage Analysis Parameters)
  FAFR003 --> (Configure analysis parameters for specific client segments)
}

