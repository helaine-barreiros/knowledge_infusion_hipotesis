rectangle "News System" {
  usecase "SFR006: Request contextualized news from the AI component to identify potential impacts on users' investments" as SFR006
  usecase "FAFR002: View predictive analytics about my clients' financial situations to provide data-driven recommendations during consultations" as FAFR009
  
  CFR001 --> (View Financial Insights Dashboard)
  SAFR002 --> (Manage Analysis Parameters)
  FAFR003 --> (Configure analysis parameters for specific client segments)
}

rectangle "Dashboard System" {
