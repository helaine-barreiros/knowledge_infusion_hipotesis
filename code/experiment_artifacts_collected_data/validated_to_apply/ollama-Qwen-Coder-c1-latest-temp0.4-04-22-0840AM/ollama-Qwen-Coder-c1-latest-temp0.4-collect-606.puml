  usecase "FAFR002: View predictive analytics about my clients' financial situations to provide data-driven recommendations during consultations" as FAFR007
  
  CFR001 --> (View Financial Insights Dashboard)
  SAFR002 --> (Manage Analysis Parameters)
  FAFR003 --> (Configure analysis parameters for specific client segments)
}

rectangle "Spending Limit System" {
  usecase "SFR005: Request spending limit alerts from the AI component when user spending patterns exceed defined thresholds" as SFR005
  usecase "FAFR002: View predictive analytics about my clients' financial situations to provide data-driven recommendations during consultations" as FAFR008
  
  CFR001 --> (View Financial Insights Dashboard)
  SAFR002 --> (Manage Analysis Parameters)
  FAFR003 --> (Configure analysis parameters for specific client segments)
