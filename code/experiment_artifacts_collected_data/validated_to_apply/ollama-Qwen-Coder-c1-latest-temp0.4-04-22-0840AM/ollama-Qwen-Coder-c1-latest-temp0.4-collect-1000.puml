@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Analysis Parameters" as SAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "SFR004: Request Financial Predictions" as SFR004
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  
  Client --> CFR001
  SysAdmin --> SAFR002
  FAFD --> FAFR003
}

rectangle "Client Dashboard" {
  usecase "CFR009: View Personalized Dashboard" as CFR009
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  Client --> CFR009
  Sys --> SFR012
}

rectangle "Alerts and Notifications" {
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "SFR005: Request Spending Limit Alerts" as SFR005
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  
  Client --> CFR002
  Sys --> SFR005
  FAFD --> (FAFR004)
}

rectangle "Personalized Recommendations and Insights" {
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "SFR013: Generate Client Alerts" as SFR013
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  Client --> CFR004
  Sys --> (FAFR006)
}

rectangle "Financial Health and Goals Management" {
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "SFR18: Manage Users' Financial Goals" as SFR18
  
  Client --> CFR005
  Sys --> (AIFR017)
}

rectangle "Investment Opportunities and News" {
  usecase "CFR003: View Investment Opportunities" as CFR003
  usecase "SFR026: Request Contextualized News Insights" as SFR026
  usecase "AIFR005: Generate Investment Opportunity Analyses" as AIFR005
  
  Client --> CFR003
  Sys --> (FAFR014)
}

rectangle "Feedback and Continuous Improvement" {
  usecase "CFR11: Send Feedback about Recommendations" as CFR11
  usecase "SFR20: Manage User Feedback" as SFR20
  
  Client --> CFR11
  Sys --> SFR20
}
@enduml