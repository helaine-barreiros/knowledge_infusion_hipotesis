@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FAdvisor

rectangle "System" {
    usecase "CFR001: View Financial Insights Dashboard" as CFR001
    usecase "SAFR001: Manage Analysis Parameters" as SAFR001
    usecase "FAFR002: View Client Intervention Alerts" as FAFR002
    
    User --> (CFR001)
    SysAdmin --> (SAFR001)
}

rectangle "Client Dashboard Features" {
    usecase "CFR009: Access Personalized Dashboard" as CFR009
    usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
    
    User --> (CFR009)
    User --> (CFR010)
}

rectangle "Client Alerts & Predictions" {
    usecase "SFR013: Generate Client Alerts based on Predefined Conditions" as SFR013
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
    
    User --> (SFR013)
}

rectangle "Client Recommendations & Insights" {
    usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
    usecase "AIFR005: Generate Investment Opportunities for Users by Identifying Financial Instruments that Align with Their Investment Strategies and Modern Portfolio Theory Principles" as AIFR005
    
    User --> (CFR002)
}

rectangle "Financial Advisor Features" {
    usecase "FAFR01: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR01
    usecase "FAFR03: View Predictive Analytics About My Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as FAFR03
    
    FAdvisor --> (FAFR01)
}

rectangle "Financial Advisor Alerts & Management" {
    usecase "SAFR002: Manage Analysis Parameters for Specific Client Segments Based on Different Client Profiles and Regulatory Requirements Such As GDPR or CCPA" as SAFR002
    usecase "SFR015: Request Predictive Intervention Analyses from the AI Component to Identify When Financial Advisors Should Engage with Clients" as SFR015
    
    FAdvisor --> (SAFR002)
}

rectangle "System Operations & Maintenance" {
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance With FinCEN Requirements" as AIFR006
    usecase "SFR017: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR017
    
    System Admin --> (AIFR006)
}

rectangle "System Notifications & Feedback Management" {
    usecase "SFR020: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR020
    usecase "CFR011: Send Feedback About the System's Recommendations and Insights to Help Improve Future Outputs" as CFR011
    
    User --> (SFR020)
}

@enduml