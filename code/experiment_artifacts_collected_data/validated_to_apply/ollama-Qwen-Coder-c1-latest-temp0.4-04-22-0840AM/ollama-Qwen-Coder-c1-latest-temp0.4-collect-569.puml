@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FinancialAdvisor
:AISystem: as AISystem

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  Client --> (SFR012) : Generate client dashboards that present financial information in an intuitive and actionable format.
  Client --> (CFR009) : Access a personalized dashboard that consolidates my financial information in a single view to efficiently monitor my finances.
  Client --> (SAFR005) : Manage my relationship with Financial Advisors, including permissions for sharing my financial data, to maintain privacy and control over my financial information.
  
  SystemAdmin --> SAFR001
  
  FinancialAdvisor --> FAFR002
  FinancialAdvisor --> FAFR003
  FinancialAdvisor --> (SFR015) : Request predictive intervention analyses from the AI component to identify when financial advisors should engage with clients.
  FinancialAdvisor --> (AIFR008) : Generate client predictive intervention recommendations by identifying patterns that indicate potential financial difficulties or opportunities requiring advisor engagement.

  AISystem --> SFR002
  AISystem --> AIFR001
  AISystem --> AIFR003
  AISystem --> AIFR004
  AISystem --> (SFR007) : Request investment opportunity analysis from the AI component to identify suitable investments for users based on their risk profiles.
  AISystem --> (AIFR005) : Generate investment opportunities that align with user investment strategies and Modern Portfolio Theory principles.
  
}

rectangle "Client" {
  Client --> CFR002
  Client --> CFR003
  Client --> CFR004
  Client --> CFR006
  Client --> CFR010
  
}

rectangle "Financial Advisor" {
  FinancialAdvisor --> FAFR001
  FinancialAdvisor --> (SFR003) : Request financial predictions from the AI component to provide users with forward-looking financial insights.
  FinancialAdvisor --> (AIFR002) : Generate personalized recommendations for users based on their financial profiles, goals, and risk tolerance as defined by industry standards like FINRA guidelines.

}

rectangle "System Admin" {
  SystemAdmin --> SAFR001
}
@enduml