@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

' Define actors
:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAdvisor

rectangle "System" {
  ' Define use cases under the system boundary
  usecase "SFR012: Generate client dashboards" as SFR012
  usecase "SFR013: Generate client alerts" as SFR013
  usecase "SFR014: Generate client analytics" as SFR014
  usecase "SFR015: Request predictive intervention analyses" as SFR015
  usecase "SFR016: Request predictive insights" as SFR016
  usecase "SFR017: Generate financial health reports" as SFR017
  usecase "SFR018: Manage users' financial goals" as SFR018
  usecase "SFR019: Maintain a historical record of users' insights" as SFR019
  usecase "SFR020: Manage user feedback" as SFR020
  
  ' Relationships between actors and system use cases
  Client --> (Client)
  SysAdmin --> (SysAdmin)
  FAdvisor --> (FAdvisor)
  
  Client --> SFR012 : "View financial insights dashboard"
  Client --> SFR013 : "Receive alerts about anomalous transactions"
  Client --> SFR014 : "View financial predictions based on historical data and current market trends"
  Client --> SFR015 : "Manage personalized recommendations preferences to ensure the system provides insights relevant to my financial objectives and risk tolerance as defined in my KYC (Know Your Customer) profile."
  Client --> SFR016 : "Receive personalized recommendations aligned with my financial profile and goals to optimize my financial strategies and investment portfolio"
  Client --> SFR017 : "View spending limit alerts when I exceed predefined thresholds in specific expense categories"
  Client --> SFR018 : "View investment opportunities suitable to my risk profile (as defined under MiFID II or equivalent standards)"
  Client --> SFR019 : "View news related to my investment portfolio"
  Client --> SFR020 : "Access a personalized dashboard that consolidates my financial information in a single view"
  
  SysAdmin --> SAFR001
  
  FAdvisor --> (FAFR004)
}

' Define use cases under the client boundary
usecase "CFR001: View Financial Insights Dashboard" as CFR001 : "View financial insights dashboard that presents my financial data in a comprehensive format to better understand my overall financial health."
usecase "CFR002: Receive Alerts About Anomalous Transactions" as CFR002
usecase "CFR003: View Financial Predictions Based on Historical Data and Current Market Trends" as CFR003
usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals to Optimize My Financial Strategies and Investment Portfolio" as CFR004 : "Receive personalized recommendations aligned with my financial profile and goals to optimize my financial strategies and investment portfolio"
usecase "CFR005: Manage Personalized Recommendations Preferences To Ensure the System Provides Insights Relevant to My Financial Objectives and Risk Tolerance As Defined in My KYC (Know Your Customer) Profile" as CFR005
usecase "CFR006: View Spending Limit Alerts When I Exceed Predefined Thresholds In Specific Expense Categories" as CFR006 : "View spending limit alerts when I exceed predefined thresholds in specific expense categories"
usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile (As Defined Under MiFID II or Equivalent Standards)" as CFR007
usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
usecase "CFR009: Access a Personalized Dashboard That Consolidates My Financial Information in a Single View" as CFR009 : "Access a personalized dashboard that consolidates my financial information in a single view"
usecase "CFR010: Manage Relationship with Financial Advisors, Including Permissions for Sharing My Financial Data, to Maintain Privacy and Control Over My Financial Information" as CFR010
usecase "CFR011: Send Feedback About the System's Recommendations and Insights To Help Improve the Accuracy and Relevance of Future Outputs" as CFR011

' Relationships between actors and client use cases
Client --> (CFR001)
Client --> (CFR002)
Client --> (CFR003)
Client --> (CFR004)
Client --> (CFR005)
Client --> (CFR006)
Client --> (CFR007)
Client --> (CFR008)
Client --> (CFR009)
Client --> (CFR010)

' Define use cases under the financial advisor boundary
usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004 : "Configure analysis parameters for specific client segments to customize the system's behavior according to different client profiles and regulatory requirements such as GDPR or CCPA."
usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
usecase "FAFR002: View Client Intervention Alerts When the System Detects Patterns Requiring Professional Attention to Proactively Assist Clients with Potential Financial Issues" as FAFR002 : "View client intervention alerts when the system detects patterns requiring professional attention to proactively assist clients with potential financial issues"
usecase "FAFR003: View Predictive Analytics About My Client's Financial Situations To Provide Data-Driven Recommendations During Consultations" as FAFR003

' Relationships between actors and financial advisor use cases
FAdvisor --> (FAFR01)
FAdvisor --> (FAFR02)
FAdvisor --> (FAFR03)

@enduml