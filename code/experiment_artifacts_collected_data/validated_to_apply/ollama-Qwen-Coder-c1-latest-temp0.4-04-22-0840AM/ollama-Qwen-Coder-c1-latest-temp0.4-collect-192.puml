@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
}

package "System Administrator" {
  actor SysAdmin as SAFR004
}

rectangle "User Interface" {
  usecase "CFR009: View personalized dashboard" as CFR009
  usecase "SFR12: Generate client dashboards" as SFR12
  
  CFR001 --> (CFR009)
  FAFR002 --> (CFR009)
}

rectangle "Alerts and Notifications" {
  usecase "SAFR005: Request anomaly transaction alerts from AI component" as SAFR005
  usecase "SFR013: Generate client alerts based on predefined conditions" as SFR013
  
  CFR001 --> (SAFR005)
  FAFR002 --> (SAFR005)
}

rectangle "Financial Insights and Predictions" {
  usecase "CFR007: View investment opportunities suitable to my risk profile" as CFR007
  usecase "SFR16: Generate client predictive insights that provide forward-looking analysis of financial situations" as SFR16
  
  CFR001 --> (CFR007)
  FAFR002 --> (CFR007)
}

rectangle "Recommendations and Strategies" {
  usecase "SFR004: Request personalized recommendations from the AI component based on each user's financial data and preferences" as SFR004
  usecase "AIFR002: Generate personalized recommendations for users based on their financial profiles, goals, and risk tolerance as defined by industry standards like FINRA guidelines" as AIFR002
  
  CFR001 --> (SFR004)
  FAFR002 --> (AIFR002)
}

rectangle "Spending Limits" {
  usecase "CFR010: View spending limit alerts when I exceed predefined thresholds in specific expense categories" as CFR010
  usecase "SAFR006: Request spending limit alerts from the AI component when user spending patterns exceed defined thresholds" as SAFR006
  
  CFR001 --> (CFR010)
}

rectangle "News and Updates" {
  usecase "SFR008: Find contextualized news relevant to users' financial portfolios from trusted financial news sources" as SFR008
  usecase "AIFR007: Generate contextualized news insights by correlating financial news with specific user portfolios to identify relevant impacts" as AIFR007
  
  CFR001 --> (SFR008)
}

rectangle "System Management and Support" {
  usecase "SAFR003: Request financial predictions from the AI component to provide users with forward-looking financial insights" as SAFR003
  usecase "AIFR009: Generate client predictive intervention recommendations by identifying patterns that indicate potential financial difficulties or opportunities requiring advisor engagement" as AIFR009
  
  SysAdmin --> (SAFR001)
}

rectangle "AI System Functions" {
  usecase "SFR020: Manage user feedback to continuously improve the quality and relevance of financial insights" as SFR020
  usecase "AIFR006: Generate anomaly transaction alerts by employing pattern recognition to detect potentially fraudulent activities in compliance with FinCEN requirements" as AIFR006
  
  SysAdmin --> (SFR020)
}

rectangle "Client Relationship Management" {
  usecase "CFR10: Manage my relationship with Financial Advisors, including permissions for sharing my financial data, to maintain privacy and control over my financial information" as CFR10
  usecase "FAFR004: Configure analysis parameters for specific client segments to customize the system's behavior according to different client profiles and regulatory requirements such as GDPR or CCPA." as FAFR004
  
  CFR001 --> (CFR10)
}

rectangle "Financial Health" {
  usecase "SFR17: Generate financial health reports that assess users' overall financial wellbeing according to standard financial ratios and metrics" as SFR17
  usecase "AIFR008: Generate client predictive intervention recommendations by identifying patterns that indicate potential financial difficulties or opportunities requiring advisor engagement." as AIFR008
  
  CFR001 --> (SFR17)
}

@enduml