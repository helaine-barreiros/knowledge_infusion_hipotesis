@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  Client --> CFR001
  SysAdmin --> SAFR001
}

rectangle "Financial Advisor System" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  
  FinancialAdvisor --> FAFR001
  FinancialAdvisor --> FAFR003
}

rectangle "System Notifications & Alerts" {
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SAFR005: Request Spending Limit Alerts" as SAFR005
  usecase "FAFR008: View Client Intervention Alerts" as FAFR008
  
  System --> SFR002
  FinancialAdvisor --> SAFR005
  FinancialAdvisor --> FAFR008
}

rectangle "AI Component Analysis & Recommendations" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  System --> AIFR001
  System --> AIFR002
}

rectangle "Investment Opportunities & News" {
  usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
  usecase "SFR007: Generate Specific Investment Opportunities" as SFR007
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  System --> SFR006
  FinancialAdvisor --> SFR007
  System --> AIFR004
}

rectangle "News & Insights Correlation" {
  usecase "SFR010: Process Contextualized News to Extract Relevant Information" as SFR010
  
  System --> SFR010
}

rectangle "User Feedback Management" {
  usecase "CFR011: Send Feedback about Recommendations and Insights" as CFR011
  
  Client --> CFR011
  FinancialAdvisor --> CFR011
  SysAdmin --> CFR011
}
@enduml