@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics about My Clients' Financial Situations" as FAFR003
  
  Client --> (CFR001)
  SysAdmin --> (SAFR001)
  FAFR001 --> (FAFR003)
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FinancialAdvisor --> (FAFR002)
  FinancialAdvisor --> (FAFR004)
}

rectangle "System Functions" {
  usecase "SFR001: Deliver Alerts to Users Through Appropriate Notification Channels" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from the AI Component" as SFR003
  
  System --> (SFR001)
  System --> (SFR002)
  System --> (SFR003)
}

rectangle "AI Functions" {
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  usecase "AIFR004: Generate Spending Limit Alerts for Users" as AIFR004
  
  System --> (AIFR001)
  System --> (AIFR004)
}

rectangle "User Functions" {
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights" as CFR011
  
  Client --> (CFR011)
  FinancialAdvisor --> (CFR011)
  SysAdmin --> (CFR011)
}

@enduml