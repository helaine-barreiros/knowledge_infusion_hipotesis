@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001
:User: as User

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  rectangle "Client Functions" {
    Client --> CFR001 : "View Dashboard"
    Client --> SAFR001 : "Manage Analysis Parameters"
    Client --> FAFR002 : "Receive Alerts"
    User --> SFR003 : "Request Predictions"
    User --> AIFR004 : "Generate Analyses"
  }
  
  rectangle "Financial Advisor Functions" {
    FinancialAdvisor --> SAFR001 : "Manage Analysis Parameters"
    FinancialAdvisor --> FAFR002 : "View Client Alerts"
    FinancialAdvisor --> FAFR003 : "Receive Predictive Insights"
    User --> AIFR004 : "Generate Analyses"
  }
  
  rectangle "System Functions" {
    SystemAdmin --> SAFR001 : "Manage Analysis Parameters"
    User --> SFR002 : "Request Alerts"
    User --> SFR003 : "Request Predictions"
    User --> AIFR004 : "Generate Analyses"
    User --> CFR011 : "Send Feedback"
  }
}
@enduml