@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FinancialAdvisor
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure analysis parameters for specific client segments" as FAFR004
  usecase "SFR002: Deliver personalized recommendations to users based on their financial profiles" as SFR002
  usecase "AIFR001: Generate financial predictions for users by analyzing historical transaction data, market trends, and economic indicators" as AIFR001
  usecase "SFR013: Generate client alerts based on predefined conditions to ensure timely notification of important financial events" as SFR013
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FinancialAdvisor --> FAFR004
  System --> (CFR001)
  System --> (SAFR001)
  System --> (FAFR004)
  System --> (SFR002)
  System --> (AIFR001)
  System --> (SFR013)
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage client mentoring sessions based on system-generated insights to provide more valuable guidance aligned with each client's financial goals" as FAFR001
  usecase "FAFR002: View client intervention alerts when the system detects patterns requiring professional attention to proactively assist clients with potential financial issues" as FAFR002
  usecase "FAFR003: View predictive analytics about my clients' financial situations to provide data-driven recommendations during consultations" as FAFR003
  
  FinancialAdvisor --> (FAFR01)
  FinancialAdvisor --> (FAFR02)
  FinancialAdvisor --> (FAFR03)
}

rectangle "Client Dashboard" {
  usecase "CFR009: Access a personalized dashboard that consolidates my financial information in a single view to efficiently monitor my finances" as CFR009
  usecase "SFR12: Generate client dashboards that present financial information in an intuitive and actionable format" as SFR12
  
  Client --> (CFR009)
  System --> (SFR12)
}

rectangle "Client Alerts" {
  usecase "SAFR005: Request anomaly transaction alerts from the AI component to detect potentially fraudulent activities in accordance with AML regulations" as SAFR005
  usecase "FAFR002: View client intervention alerts when the system detects patterns requiring professional attention to proactively assist clients with potential financial issues" as FAFR002
  
  Client --> (SAFR005)
  FinancialAdvisor --> (FAFR002)
}

rectangle "Investment Opportunities" {
  usecase "CFR007: View investment opportunities suitable to my risk profile (as defined under MiFID II or equivalent standards) to diversify my portfolio and maximize returns" as CFR007
  usecase "AIFR004: Generate investment opportunity analyses for users by evaluating potential investments against their risk profiles, time horizons, and financial goals" as AIFR004
  
  Client --> (CFR007)
  System --> (AIFR004)
}

rectangle "News Insights" {
  usecase "CFR008: View news related to my investment portfolio to stay informed about market events that might affect my assets" as CFR008
  usecase "SFR13: Generate client alerts based on predefined conditions to ensure timely notification of important financial events" as SFR13
  
  Client --> (CFR008)
  System --> (SFR13)
}

rectangle "Feedback Management" {
  usecase "AIFR019: Manage user feedback to continuously improve the quality and relevance of financial insights" as AIFR019
  usecase "SAFR020: Maintain a historical record of users' insights to enable trend analysis and effectiveness measurement" as SAFR020
  
  Client --> (AIFR019)
  SystemAdmin --> (SAFR020)
}
@enduml