@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> CFR001 : "View"
  C --> CFR002 : "Receive Alerts for Anomalous Transactions"
  C --> CFR003 : "Predictions"
  C --> CFR004 : "Recommendations"
  C --> CFR005 : "Manage Preferences"
  C --> CFR006 : "Spending Limits"
  C --> CFR007 : "Investment Opportunities"
  C --> CFR008 : "News for Portfolio"
  C --> CFR009 : "Dashboard"
  C --> CFR10 : "Relationship Management"
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> FAFR001 : "Manage Sessions"
  FA --> FAFR002 : "View Alerts"
  FA --> FAFR003 : "Predictive Analytics"
  FA --> FAFR004 : "Configure Parameters"
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  
  SA --> SAFR001
}

rectangle "AI Component" {
  package "Financial Insights Generation" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
  }
  
  package "Personalized Recommendations" {
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  }
  
  package "Spending Limit Alerts" {
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  }
  
  package "Investment Opportunity Analysis" {
    usecase "AIFR004: Analyze Investment Opportunities" as AIFR004
  }
  
  package "Anomaly Transaction Detection" {
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  }
  
  package "Contextualized News Insights" {
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  }
}

rectangle "System Operations" {
  package "Alert Delivery" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
  }
  
  package "Recommendation Generation" {
    usecase "SFR002: Generate Personalized Recommendations" as SFR002
  }
  
  package "Prediction Requests" {
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  }
  
  package "Recommendation Requests" {
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  }
  
  package "Spending Limit Alerts" {
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  }
  
  package "Investment Opportunity Analysis Requests" {
    usecase "SFR006: Request Investment Opportunity Analyses from AI Component" as SFR006
  }
  
  package "Specific Investment Opportunities" {
    usecase "SFR007: Request Specific Investment Opportunities from AI Component" as SFR007
  }
  
  package "Anomaly Transaction Alerts Requests" {
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  }
  
  package "Contextualized News Insights" {
    usecase "SFR010: Generate Contextualized News Insights for Users" as SFR010
  }
  
  package "Client Predictive Intervention Recommendations" {
    usecase "SFR015: Request Client Predictive Intervention Analyses from AI Component" as SFR015
  }
  
  package "Predictive Insights Requests" {
    usecase "SFR016: Generate Predictive Insights for Financial Guidance" as SFR016
  }
}

rectangle "System Management" {
  usecase "SFR017: Generate Financial Health Reports" as SFR017
  usecase "SFR018: Manage Users' Financial Goals" as SFR018
  usecase "SFR019: Maintain Historical Record of Insights" as SFR019
  usecase "SFR020: Manage User Feedback for Continuous Improvement" as SFR020
  
  C --> SFR017 : "Generate Reports"
  FA --> SFR018 : "Manage Goals"
  SA --> SFR019 : "Maintain Record"
  C --> SFR020 : "Provide Feedback"
}

rectangle "User Interface" {
  usecase "CFR11: Send Feedback to System" as CFR11
  
  C --> CFR11
  FA --> CFR11
  SA --> CFR11
}
@enduml