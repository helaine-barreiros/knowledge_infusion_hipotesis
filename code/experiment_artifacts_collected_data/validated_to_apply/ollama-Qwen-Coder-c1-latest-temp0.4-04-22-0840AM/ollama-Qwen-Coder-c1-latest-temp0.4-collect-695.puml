@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
}

package "System Administrator" {
  actor SysAdmin as SAFR003
}

rectangle "User Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001_UI
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002_UI
  usecase "CFR003: View Financial Predictions" as CFR003_UI
  usecase "CFR004: Receive Personalized Recommendations" as CFR004_UI
  usecase "CFR005: Manage Recommendation Preferences" as CFR005_UI
  usecase "CFR006: View Spending Limit Alerts" as CFR006_UI
  usecase "CFR007: View Investment Opportunities" as CFR007_UI
  usecase "CFR008: View News Related to Investments" as CFR008_UI
  usecase "CFR009: Access Personalized Dashboard" as CFR009_UI
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10_UI
  
  package "Client Use Cases" {
    CFR001 --> CFR001_UI : Uses
    CFR002 --> CFR002_UI : Uses
    CFR003 --> CFR003_UI : Uses
    CFR004 --> CFR004_UI : Uses
    CFR005 --> CFR005_UI : Uses
  }
  
  package "Financial Advisor Use Cases" {
    FAFR002 --> CFR007_UI : Provides
    FAFR003 --> CFR016_UI : Provides
    FAFR004 --> SAFR004 : Configures
  }
}

rectangle "System Functions" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Provide Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities from AI" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Portfolios" as SFR009
  usecase "SFR010: Process Contextualized News for Users" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI" as SFR011
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics for Insights" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI" as SFR015
  usecase "SFR016: Request Predictive Insights from AI" as SFR016
  usecase "SFR017: Generate Financial Health Reports" as SFR017
  usecase "SFR018: Manage Users' Financial Goals" as SFR018
  usecase "SFR019: Maintain Historical Record of Insights" as SFR019
  usecase "SFR020: Manage User Feedback for Improvement" as SFR020
  
  package "System Use Cases" {
    SAFR003 --> SFR004 : Provides
    AIFR002 --> SFR005 : Generates
    AIFR006 --> SFR008 : Identifies
    FAFR001 --> SFR009 : Correlates
  }
}

rectangle "AI Functions" {
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations Based on Profiles and Goals" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  usecase "AIFR005: Identify Financial Instruments Aligning with User Strategies and MPT Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition" as AIFR006
  usecase "AIFR007: Correlate News to Specific Portfolios for Insights" as AIFR007
  usecase "AIFR008: Identify Patterns Indicating Potential Financial Difficulties or Opportunities" as AIFR008
  usecase "AIFR009: Provide Forward-Looking Analysis of Financial Situations" as AIFR009
  
  package "AI Use Cases" {
    SFR012 --> AIFR007 : Uses
    FAFR003 --> AIFR004 : Provides
  }
}

rectangle "Feedback Loop" {
  usecase "CFR11: Send Feedback About Recommendations and Insights" as CFR11
  
  package "Client Feedback Use Cases" {
    CFR11 --> SFR020 : Sends feedback to improve accuracy and relevance of future outputs.
  }
}
@enduml