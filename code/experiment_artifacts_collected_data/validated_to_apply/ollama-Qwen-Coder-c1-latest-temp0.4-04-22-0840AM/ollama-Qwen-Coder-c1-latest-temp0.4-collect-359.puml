@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "AIFR009: Generate Contextualized News Insights" as AIFR009
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> FAFR003
}

rectangle "Client Interactions" {
  usecase "CFR002: View Alerts for Anomalous Transactions" as CFR002
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
  
  Client --> CFR002
  Client --> CFR006
  Client --> CFR010
}

rectangle "Financial Advisor Interactions" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FAFD --> FAFR001
  FAFD --> FAFR004
}

rectangle "System Operations" {
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
  usecase "SFR12: Generate Client Alerts Based on Predefined Conditions" as SFR12
  
  System --> SFR003
  System --> SFR006
  System --> SFR12
}

rectangle "AI Operations" {
  usecase "AIFR004: Generate Personalized Recommendations for Users" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Based on User Profiles" as AIFR005
  
  System --> AIFR004
  System --> AIFR005
}

rectangle "Feedback Loop" {
  usecase "CFR11: Send Feedback about Recommendations and Insights" as CFR11
  
  Client --> CFR11
}
@enduml