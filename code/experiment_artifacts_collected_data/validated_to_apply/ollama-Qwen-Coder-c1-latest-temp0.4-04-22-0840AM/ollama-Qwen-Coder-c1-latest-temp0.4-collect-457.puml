@startuml
left to right direction

title Use Case Diagram for AI-Powered Financial Insights & Recommendations System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFR001

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  
  Client --> (CFR001)
  SysAdmin --> (SAFR001)
  
  rectangle "Client Dashboards & Insights" {
    usecase "CFR009: Access Personalized Dashboard" as CFR009
    usecase "SFR017: Generate Financial Health Reports" as SFR017
    
    Client --> (CFR009)
    SysAdmin --> (SFR017)
  }
  
  rectangle "Financial Predictions & Recommendations" {
    usecase "CFR003: View Financial Predictions" as CFR003
    usecase "SAFR002: Request Personalized Recommendations from AI" as SAFR002
    
    Client --> (CFR003)
    SysAdmin --> (SFR018)
  }
  
  rectangle "Investment Opportunities & News" {
    usecase "CFR007: View Investment Opportunities" as CFR007
    usecase "SAFR006: Request Investment Opportunity Analysis from AI" as SAFR006
    
    Client --> (CFR007)
    SysAdmin --> (SFR12)
  }
  
  rectangle "Spending Limits & Alerts" {
    usecase "CFR006: View Spending Limit Alerts" as CFR006
    usecase "SAFR005: Request Spending Limit Alerts from AI" as SAFR005
    
    Client --> (CFR006)
  }
  
  rectangle "Client Mentoring & Guidance" {
    usecase "FAFR01: Manage Client Mentoring Sessions" as FAFR01
    usecase "SFR13: Generate Client Alerts Based on Predefined Conditions" as SFR13
    
    FinancialAdvisor --> (FAFR01)
  }
  
  rectangle "System Notifications & Feedback" {
    usecase "SAFR08: Request Anomaly Transaction Alerts from AI" as SAFR08
    usecase "SFR20: Manage User Feedback to Improve Recommendations" as SFR20
    
    Client --> (SAFR08)
    SysAdmin --> (SFR20)
  }
}

Client <|-- FinancialAdvisor
FinancialAdvisor <|-- SysAdmin

@enduml