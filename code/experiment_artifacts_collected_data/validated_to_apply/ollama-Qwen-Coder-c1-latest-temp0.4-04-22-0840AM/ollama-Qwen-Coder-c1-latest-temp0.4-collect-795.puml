@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as Client
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Consolidated Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  Client --> (SAFR002)
  Client --> (SFR013)
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAdv
  
  usecase "FAFR001: Manage Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FAdv --> (SAFR001)
  FAdv --> (SFR015)
}

package System {
  rectangle "System" {
    actor "SysAdmin" as SysAdmin
    
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on Strategies and MPT Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
    
    SysAdmin --> (SAFR001)
    SysAdmin --> (SFR020)
    
    rectangle "Notification Channel" {
      usecase "SFR013: Deliver Alerts to Users" as SFR013
      usecase "SFR014: Generate Client Analytics" as SFR014
      
      SysAdmin --> (SFR013)
      SysAdmin --> (SFR014)
    }
    
    rectangle "Recommendation Engine" {
      usecase "SFR02: Deliver Personalized Recommendations to Users" as SFR02
      usecase "AIFR002: Generate Financial Predictions Based on User Data and Preferences" as AIFR002
      
      SysAdmin --> (SFR02)
      SysAdmin --> (AIFR002)
    }
    
    rectangle "Prediction Engine" {
      usecase "SFR03: Request Financial Predictions from AI Component" as SFR03
      usecase "SFR16: Generate Client Predictive Insights Based on Forward-Looking Analysis" as SFR16
      
      SysAdmin --> (SFR03)
      SysAdmin --> (SFR16)
    }
    
    rectangle "Spending Limit Engine" {
      usecase "SFR05: Request Spending Limit Alerts from AI Component" as SFR05
      usecase "AIFR003: Generate Spending Limit Alerts Based on Deviations in Spending Patterns" as AIFR003
      
      SysAdmin --> (SFR05)
      SysAdmin --> (AIFR003)
    }
    
    rectangle "Investment Opportunity Engine" {
      usecase "SFR06: Request Investment Opportunity Analysis from AI Component" as SFR06
      usecase "SFR17: Generate Financial Health Reports Based on User Data and Metrics" as SFR17
      
      SysAdmin --> (SFR06)
      SysAdmin --> (SFR17)
    }
    
    rectangle "News Engine" {
      usecase "SFR09: Request Contextualized News from AI Component" as SFR09
      usecase "AIFR007: Generate Contextualized News Insights Based on User Portfolios and ESG Preferences" as AIFR007
      
      SysAdmin --> (SFR09)
      SysAdmin --> (AIFR007)
    }
    
    rectangle "Feedback Engine" {
      usecase "CFR11: Send Feedback about Recommendations and Insights" as CFR11
      usecase "SFR20: Manage User Feedback to Improve Outputs" as SFR20
      
      SysAdmin --> (CFR11)
      SysAdmin --> (SFR20)
    }
  }
}

@enduml