@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFD002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> FAFD002
  System Admin -down-> SFR003
  Financial Advisor -up-> AIFR004
}

rectangle "Client Dashboard" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  
  Client --> CFR009
}

rectangle "Financial Recommendations" {
  usecase "SAFR005: Manage Recommendation Preferences" as SAFR005
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  
  Client --> SAFR005
  System Admin -down-> SFR012
  Financial Advisor -up-> AIFR003
}

rectangle "Investment Opportunities" {
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
  
  Client --> CFR007
  System Admin -down-> SFR006
}

rectangle "News and Alerts" {
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "SFR010: Request Contextualized News Insights" as SFR010
  
  Client --> CFR008
  System Admin -down-> SFR010
}

rectangle "Client Relationship Management" {
  usecase "CFR10: Manage Financial Advisors' Relationships" as CFR10
  
  Client --> CFR10
}
@enduml