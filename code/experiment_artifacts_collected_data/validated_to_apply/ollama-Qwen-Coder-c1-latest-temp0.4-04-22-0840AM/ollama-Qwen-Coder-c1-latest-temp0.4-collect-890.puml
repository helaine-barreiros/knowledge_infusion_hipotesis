@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FinancialAdvisor
:User: as User

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure analysis parameters for specific client segments" as FAFR004
  usecase "SFR002: Deliver personalized recommendations to users based on their financial profiles" as SFR002
  usecase "AIFR002: Generate personalized recommendations for users based on their financial profiles, goals, and risk tolerance" as AIFR002
  usecase "CFR011: Send feedback about the system's recommendations and insights" as CFR011
  
  Client --> (SFR002)
  SysAdmin --> SAFR001
  FinancialAdvisor --> FAFR004
  User --> CFR011
}

rectangle "Client Dashboards" {
  usecase "CFR009: Access a personalized dashboard that consolidates my financial information in a single view" as CFR009
  
  Client --> (SFR012)
  SysAdmin --> (SFR012)
  FinancialAdvisor --> (SFR012)
}

rectangle "Alerts and Notifications" {
  usecase "CFR006: View spending limit alerts when I exceed predefined thresholds in specific expense categories" as CFR006
  usecase "FAFR002: View client intervention alerts when the system detects patterns requiring professional attention to proactively assist clients with potential financial issues" as FAFR002
  
  Client --> (SFR013)
  SysAdmin --> (SFR014)
  FinancialAdvisor --> (SFR015)
}

rectangle "Investment Opportunities and Recommendations" {
  usecase "CFR007: View investment opportunities suitable to my risk profile (as defined under MiFID II or equivalent standards) to diversify my portfolio and maximize returns" as CFR007
  usecase "FAFR001: Manage client mentoring sessions based on system-generated insights to provide more valuable guidance aligned with each client's financial goals" as FAFR001
  
  Client --> (SFR016)
  SysAdmin --> (SFR019)
  FinancialAdvisor --> (AIFR005) : "Generate investment opportunities"
}

rectangle "News and Analytics" {
  usecase "CFR008: View news related to my investment portfolio to stay informed about market events that might affect my assets" as CFR008
  usecase "SFR017: Generate financial health reports that assess users' overall financial wellbeing according to standard financial ratios and metrics" as SFR017
  
  Client --> (AIFR007)
  SysAdmin --> (SFR020)
}

rectangle "Feedback Management" {
  usecase "CFR011: Send feedback about the system's recommendations and insights" as CFR011
}
@enduml