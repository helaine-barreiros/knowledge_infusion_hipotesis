@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive FATF Anomaly Alerts" as CFR002
  usecase "CFR003: View Predictive Analytics" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Receive Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR010)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SysAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  SA --> (SAFR001)
}

rectangle "AI Component" {
  
  package "Financial Insights & Predictions" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "SFR003: Request Financial Predictions from AI" as SFR003
    
    (CFR009) --> (AIFR001)
  }
  
  package "Personalized Recommendations & Insights" {
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
    
    (CFR003) --> (AIFR002)
  }
  
  package "Spending Limit Alerts & Management" {
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
    
    (CFR006) --> (AIFR003)
  }
  
  package "Investment Opportunities & Management" {
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "SFR012: Request Client Dashboards from AI" as SFR012
    
    (CFR007) --> (AIFR004)
  }
  
  package "News & Insights Management" {
    usecase "AIFR005: Generate Investment Opportunities for Users" as AIFR005
    usecase "SFR009: Request Contextualized News from AI" as SFR009
    
    (CFR008) --> (AIFR005)
  }
  
  package "Anomaly Detection & Alerts Management" {
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "SFR013: Request Client Alerts from AI" as SFR013
    
    (CFR002) --> (AIFR006)
  }
  
  package "Predictive Intervention & Insights Management" {
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "SFR15: Request Predictive Intervention Analyses from AI" as SFR15
    
    (FAFR002) --> (AIFR007)
  }
  
  package "Client Feedback Management" {
    usecase "CFR11: Send Feedback" as CFR11
    CFR11 --> AIFR009
  }

}

@enduml