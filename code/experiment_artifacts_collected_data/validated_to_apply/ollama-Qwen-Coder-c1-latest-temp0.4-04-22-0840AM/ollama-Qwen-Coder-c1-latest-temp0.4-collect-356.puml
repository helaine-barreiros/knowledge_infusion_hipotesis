  CFR001 --> (SFR002)
  FAFR002 --> (FAFR003)
  SAFR005 --> (SAFR001)

  AIFR001 --> (SFR003)
  AIFR002 --> (SFR002)
  AIFR003 --> (SFR005)
  AIFR004 --> (SFR006)
  AIFR005 --> (AIFR007)
  AIFR006 --> (SFR008)
  AIFR007 --> (SFR10)
  AIFR008 --> (SFR13)
  AIFR009 --> (SFR14)

