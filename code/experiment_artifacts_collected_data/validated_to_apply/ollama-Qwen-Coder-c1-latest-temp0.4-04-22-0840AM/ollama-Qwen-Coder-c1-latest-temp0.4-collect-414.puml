@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts About Anomalous Transactions" as SAFR003
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as SAFR004
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as SAFR005
  usecase "CFR005: Manage Personalized Recommendations Preferences" as SAFR006
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as SAFR007
  usecase "CFR012: Access a Personalized Dashboard That Consolidates My Financial Information" as SAFR008
  
  CFR001 --> SAFR003
  CFR001 --> SAFR004
  CFR001 --> SAFR005
  CFR001 --> SAFR006
  CFR001 --> SAFR007
  CFR001 --> SAFR008
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
  
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations" as SAFR009
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as SAFR010
  usecase "FAFR005: Manage Client Mentoring Sessions Based on System-Generated Insights" as SAFR011
  
  FinancialAdvisor --> SAFR009
  FinancialAdvisor --> SAFR010
  FinancialAdvisor --> SAFR011
}

package "System Administrator" {
  actor SysAdmin as SAFR002
  
  usecase "SAFR001: Manage Analysis Parameters for the AI System" as SAFR013
  usecase "SFR019: Maintain a Historical Record of Users' Insights to Enable Trend Analysis and Effectiveness Measurement" as SFR019
  
  SysAdmin --> SAFR013
  SysAdmin --> SFR019
}

package "System Components" {
  rectangle "AI System" {
    usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance as Defined by Industry Standards Like FINRA Guidelines" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities for Users by Identifying Financial Instruments That Align with Their Investment Strategies and Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance With FinCEN Requirements" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights that Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009
    
    CFR011 --> AIFR001 : sends feedback about system's recommendations and insights
  }
  
  rectangle "System Interface" {
    usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles to Support Better Financial Decision-Making" as SFR002
    usecase "SFR003: Request Financial Predictions from the AI Component to Provide Users With Forward-Looking Financial Insights" as SFR014
    usecase "SFR005: Request Spending Limit Alerts From the AI Component When User Spending Patterns Exceed Defined Thresholds" as SFR026
    usecase "SFR007: Request Investment Opportunity Analysis from the AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles" as SFR031
    usecase "SFR008: Generate Client Alerts Based On Predefined Conditions To Ensure Timely Notification of Important Financial Events" as SFR025
    
    CFR011 --> SFR002 : sends feedback about system's recommendations and insights
  }
  
  rectangle "Notification Channels" {
    usecase "SFR013: Generate Client Analytics That Provide Meaningful Insights Into Financial Behavior and Performance" as SFR036
    usecase "SFR017: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR042
    
    CFR011 --> SFR036 : sends feedback about system's recommendations and insights
  }
}

@enduml