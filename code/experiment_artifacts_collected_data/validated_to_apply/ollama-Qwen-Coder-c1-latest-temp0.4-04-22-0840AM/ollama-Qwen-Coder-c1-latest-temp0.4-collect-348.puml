@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SysAdmin as SA
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SA --> (SAFR001)
}

rectangle System {
  package "User Interface" {
    usecase "SFR012: Generate Client Dashboards" as SFR012
    
    C --> (SFR012)
    FA --> (SFR012)
    SA --> (SFR012)
  }
  
  package "Alerts and Notifications" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
    
    C --> (SFR001)
    FA --> (SFR001)
    SA --> (SFR001)
    
    C --> (SFR013)
    FA --> (SFR013)
    SA --> (SFR013)
  }
  
  package "Recommendations and Insights" {
    usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
    usecase "SFR014: Generate Client Analytics Based on Financial Behavior and Performance" as SFR014
    
    C --> (SFR002)
    FA --> (SFR002)
    SA --> (SFR002)
    
    C --> (SFR014)
    FA --> (SFR014)
    SA --> (SFR014)
  }
  
  package "Predictive Analytics" {
    usecase "SFR03: Request Financial Predictions from AI Component" as SFR03
    usecase "SFR09: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR09
    
    C --> (SFR03)
    FA --> (SFR03)
    SA --> (SFR03)
    
    C --> (SFR09)
    FA --> (SFR09)
    SA --> (SFR09)
  }
  
  package "Investment Opportunities" {
    usecase "SFR06: Request Investment Opportunity Analysis from AI Component" as SFR06
    usecase "AIFR005: Generate Investment Opportunities for Users Based on Modern Portfolio Theory Principles" as AIFR005
    
    C --> (SFR06)
    FA --> (SFR06)
    SA --> (SFR06)
    
    C --> (AIFR005)
    FA --> (AIFR005)
    SA --> (AIFR005)
  }
  
  package "Spending Limits" {
    usecase "SFR05: Request Spending Limit Alerts from AI Component" as SFR05
    
    C --> (SFR05)
    FA --> (SFR05)
    SA --> (SFR05)
  }
  
  package "Anomaly Detection" {
    usecase "SFR08: Request Anomaly Transaction Alerts from AI Component" as SFR08
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
    
    C --> (SFR08)
    FA --> (SFR08)
    SA --> (SFR08)
    
    C --> (AIFR006)
    FA --> (AIFR006)
    SA --> (AIFR006)
  }
  
  package "News and Insights" {
    usecase "SFR10: Request Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR10
    usecase "AIFR007: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR007
    
    C --> (SFR10)
    FA --> (SFR10)
    SA --> (SFR10)
    
    C --> (AIFR007)
    FA --> (AIFR007)
    SA --> (AIFR007)
  }
  
  package "Predictive Insights" {
    usecase "SFR16: Request Predictive Insights from AI Component to Enhance the Value of Financial Guidance Provided to Clients" as SFR16
    
    C --> (SFR16)
    FA --> (SFR16)
    SA --> (SFR16)
  }
  
  package "Health Reports and Goals Management" {
    usecase "AIFR017: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as AIFR017
    usecase "SFR18: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR18
    
    C --> (AIFR017)
    FA --> (AIFR017)
    SA --> (AIFR017)
    
    C --> (SFR18)
    FA --> (SFR18)
    SA --> (SFR18)
  }
  
  package "AI Component" {
    usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance As Defined By Industry Standards Like FINRA Guidelines" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
    
    C --> (AIFR001)
    FA --> (AIFR001)
    SA --> (AIFR001)
    
    C --> (AIFR002)
    FA --> (AIFR002)
    SA --> (AIFR002)
    
    C --> (AIFR003)
    FA --> (AIFR003)
    SA --> (AIFR003)
  }
}

rectangle "User Feedback" {
  usecase "CFR11: Send Feedback About System's Recommendations and Insights" as CFR11
  
  C --> (CFR11)
  FA --> (CFR11)
  SA --> (CFR11)
}
@enduml