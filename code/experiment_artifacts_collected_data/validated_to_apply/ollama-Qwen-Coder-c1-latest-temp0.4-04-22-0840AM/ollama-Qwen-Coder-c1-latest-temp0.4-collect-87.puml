@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR004
  usecase "CFR003: View Financial Predictions Based on Historical Data and Current Trends" as SAFR005
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as SAFR006
  usecase "CFR005: Manage Personalized Recommendations Preferences to Ensure the System Provides Insights Relevant to My Financial Objectives and Risk Tolerance" as SAFR007
  usecase "CFR006: View Spending Limit Alerts When I Exceed Predefined Thresholds in Specific Expense Categories" as SAFR012
  usecase "CFR009: Access a Personalized Dashboard That Consolidates My Financial Information in a Single View to Efficiently Monitor My Finances" as SFR018
  
  CFR001 --> SAFR004 : "Receive Alerts"
  CFR001 --> SAFR005 : "View Predictions"
  CFR001 --> SAFR006 : "Get Recommendations"
  CFR001 --> SAFR007 : "Manage Preferences"
  CFR001 --> SAFR012 : "Monitor Spending Limits"
  CFR001 --> SFR018 : "View Dashboard"
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts When the System Detects Patterns Requiring Professional Attention to Proactively Assist Clients with Potential Financial Issues" as SAFR009
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as AIFR012
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments to Customize the System's Behavior According to Different Client Profiles and Regulatory Requirements Such As GDPR or CCPA" as SAFR015
  
  FAFR001 --> SAFR009 : "View Alerts"
  FAFR001 --> AIFR012 : "Get Predictive Analytics"
  FAFR001 --> SAFR015 : "Configure Parameters"
}

package "System" {
  actor System as SFR008
  
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios from Trusted Financial News Sources" as AIFR023
  usecase "SFR10: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR024
  
  SFR008 --> AIFR023 : "Request News"
  SFR008 --> SFR024 : "Process News"
}

rectangle "AI System" {
  usecase "AIFR01: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
  usecase "AIFR02: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance As Defined By Industry Standards Like FINRA Guidelines" as AIFR002
  usecase "AIFR03: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
  usecase "AIFR04: Generate Investment Opportunity Analyses for Users By Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  usecase "AIFR05: Generate Investment Opportunities For Users by Identifying Financial Instruments That Align With Their Investment Strategies and Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR06: Generate Anomaly Transaction Alerts By Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
  usecase "AIFR07: Generate Contextualized News Insights by Correlating Financial News With Specific User Portfolios to Identify Relevant Impacts" as AIFR007
  
  AIFR01 --> SFR025 : "Provide Predictions"
  AIFR02 --> SAFR006 : "Generate Recommendations"
  AIFR03 --> SAFR012 : "Send Alerts"
  AIFR04 --> FAFR003 : "Offer Insights"
  AIFR05 --> SFR019 : "Propose Investments"
  AIFR06 --> SAFR008 : "Alert of Anomalies"
  AIFR07 --> SFR020 : "Provide News Insights"
}

package "User (Client, Financial Advisor, or System Administrator)" {
  actor User as CFR011
  
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as SFR026
  
  User --> SFR026 : "Provide Feedback"
}

@enduml