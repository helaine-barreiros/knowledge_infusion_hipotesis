@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Consolidated Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
  
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA

  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004

}

package "System Administrator" {
  actor SysAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SA --> SAFR001
  
}

rectangle System {
  
  package "Components" {
    rectangle "AI Component" {
      usecase "AIFR001: Generate Financial Predictions" as AIFR001
      usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
      usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
      usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
      usecase "AIFR005: Generate Investment Opportunities based on Modern Portfolio Theory" as AIFR005
      usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
      usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
      usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
      usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
      
    }
    
    rectangle "Notification Component" {
      usecase "SFR001: Deliver Alerts to Users through Notification Channels" as SFR001
    }

    rectangle "Personalization Component" {
      usecase "SFR002: Deliver Personalized Recommendations based on Financial Profiles" as SFR002
      
    }
    
    rectangle "Prediction Requester Component" {
      usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
      usecase "SFR014: Generate Client Analytics that Provide Meaningful Insights into Financial Behavior and Performance" as SFR014
      
    }
    
    rectangle "Recommendation Requester Component" {
      usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    }

    rectangle "Spending Limit Alert Requester Component" {
      usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
      
    }
    
    rectangle "Investment Opportunity Analysis Requester Component" {
      usecase "SFR006: Request Investment Opportunity Analyses from AI Component" as SFR006
      usecase "SFR013: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR013
      
    }
    
    rectangle "Specific Investment Opportunities Requester Component" {
      usecase "SFR007: Request Specific Investment Opportunities from AI Component that Match User Criteria and ESG Preferences" as SFR007
    }

    rectangle "Anomaly Transaction Alert Requester Component" {
      usecase "SFR008: Request Anomaly Transaction Alerts from AI Component to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as SFR008
      
    }
    
    rectangle "Contextualized News Requester Component" {
      usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios from Trusted Sources" as SFR009
      usecase "SFR10: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR10
      
    }
    
    rectangle "News Insights Requester Component" {
      usecase "SFR11: Request Contextualized News Insights from AI Component to Identify Potential Impacts on User's Investments" as SFR11
    }

    rectangle "Client Dashboard Generator Component" {
      usecase "SFR012: Generate Client Dashboards that Present Financial Information in an Intuitive and Actionable Format" as SFR012
      
    }
    
  }
  
}

package "System Components Interaction" {
  C --> AIFR001
  C --> AIFR002
  C --> AIFR003
  C --> AIFR004
  C --> AIFR005
  C --> AIFR006
  C --> AIFR007
  C --> AIFR008
  C --> AIFR009
  
  FA --> AIFR001
  FA --> AIFR002
  FA --> AIFR003
  FA --> AIFR004

  SA --> SAFR001
  
  SFR001 <|-- (AIFR006)
  SFR001 <|-- (AIFR008)

  SFR002 <|-- (SFR003)
  
  SFR003 <|-- (AIFR001)
  SFR004 <|-- (AIFR002)
  SFR005 <|-- (AIFR003)
  SFR006 <|-- (AIFR004)
  
  SFR007 <|-- (AIFR001)
  SFR008 <|-- (AIFR002)

  SFR009 <|-- (SFR005)
  SFR013 <|-- (SFR006)
  SFR14 <|-- (SFR007)
  
}

@enduml