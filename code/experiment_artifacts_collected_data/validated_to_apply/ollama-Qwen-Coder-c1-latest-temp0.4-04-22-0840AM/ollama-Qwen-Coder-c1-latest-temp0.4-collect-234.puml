@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SysAdmin as SA
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SA --> (SAFR001)
}

rectangle "AI System" {
  package "Financial Insights" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "SFR027: Request Financial Predictions from AI Component" as SFR027
    
    C --> (CFR003) --> (SFR027)
  }
  
  package "Personalized Recommendations" {
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "SFR014: Request Personalized Recommendations from AI Component" as SFR014
    
    C --> (CFR004) --> (SFR014)
  }
  
  package "Spending Limit Alerts" {
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "SFR025: Request Spending Limit Alerts from AI Component" as SFR025
    
    C --> (CFR006) --> (SFR025)
  }
  
  package "Investment Opportunities" {
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR007: Generate Investment Opportunities for Users Matching Criteria and Preferences" as AIFR007
    
    C --> (CFR007) --> (SFR026)
  }
  
  package "Anomaly Transaction Alerts" {
    usecase "AIFR005: Generate Anomaly Transaction Alerts" as AIFR005
    usecase "SFR018: Request Anomaly Transaction Alerts from AI Component" as SFR018
    
    C --> (CFR002) --> (SFR018)
  }
  
  package "Contextualized News Insights" {
    usecase "AIFR006: Generate Contextualized News Insights" as AIFR006
    usecase "SFR024: Request Contextualized News from AI Component" as SFR024
    
    C --> (CFR008) --> (SFR024)
  }
  
  package "Predictive Intervention Recommendations" {
    usecase "AIFR009: Generate Predictive Intervention Recommendations" as AIFR009
    usecase "SFR15: Request Predictive Intervention Analyses from AI Component" as SFR15
    
    C --> (FAFR002) --> (SFR15)
  }
  
  package "Predictive Insights" {
    usecase "AIFR016: Generate Client Predictive Insights" as AIFR016
    usecase "SFR17: Request Predictive Insights from AI Component" as SFR17
    
    C --> (FAFR003) --> (SFR17)
  }
  
  package "Financial Health Reports" {
    usecase "AIFR025: Generate Financial Health Reports" as AIFR025
    usecase "SFR19: Request Predictive Insights from AI Component for Financial Health Reporting" as SFR19
    
    C --> (FAFR004) --> (SFR19)
  }
}

package "System Management" {
  usecase "SFR030: Send Feedback to Improve System Outputs" as SFR030
  
  C --> (CFR11) --> (SFR030)
}
@enduml