@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Access Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Receive Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR010)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: Access Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR011": Request Contextualized News Insights from AI Component for Users' Financial Situations to Identify Potential Impacts on Investments as SFR011
  
  SA --> (SAFR001)
}

package "System Components" {
  rectangle System as Sys
  
  usecase "SFR002: Deliver Personalized Recommendations Based on User Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component Based on Each User's Data and Preferences" as SFR004
  usecase "SFR005: Request Spending Limit Alerts From AI Component When User Spending Patterns Exceed Defined Thresholds" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities From AI Component That Match User Investment Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component to Detect Potentially Fraudulent Activities in Accordance with AML Regulations" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios From Trusted Financial News Sources" as SFR009
  usecase "SFR010: Process Contextualized News to Extract Relevant Information for User's Financial Situations" as SFR010
  usecase "SFR012: Request Client Dashboards That Present Financial Information in an Intuitive and Actionable Format from AI Component" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events from AI Component" as SFR013
  usecase "SFR014: Request Predictive Insights From the AI Component to Enhance the Value of Financial Guidance Provided to Clients" as SFR014
  usecase "SFR015: Generate Client Analytics That Provide Meaningful Insights into Financial Behavior and Performance from AI Component" as SFR015
  usecase "SFR016: Request Predictive Intervention Analyses From the AI Component to Identify When Financial Advisors Should Engage with Clients" as SFR016
  usecase "SFR017": Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics from AI Component as SFR017
  usecase "SFR018: Manage User Goals To Track Progress and Provide Relevant Recommendations" as SFR018
  usecase "SFR019": Maintain a Historical Record of Users' Insights to Enable Trend Analysis and Effectiveness Measurement" as SFR019
  usecase "SFR020: Request Feedback From Users to Continuously Improve the Quality and Relevance of Financial Insights from AI Component" as SFR020
  
  Sys --> (SFR002)
  Sys --> (SFR003)
  Sys --> (SFR004)
  Sys --> (SFR005)
  Sys --> (SFR006)
  Sys --> (SFR007)
  Sys --> (SFR008)
  Sys --> (SFR009)
  Sys --> (SFR010)
  Sys --> (SFR012)
  Sys --> (SFR013)
  Sys --> (SFR014)
  Sys --> (SFR015)
  Sys --> (SFR016)
  Sys --> (SFR017)
  Sys --> (SFR018)
  Sys --> (SFR019)
  Sys --> (SFR020)
}

package "AI System" {
  rectangle AI as AIF
  
  usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations Based on User Profiles, Goals, and Risk Tolerance As Defined By Industry Standards Like FINRA Guidelines" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations From Established Spending Patterns" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses For Users By Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities for Users by Identifying Financial Instruments That Align With Their Investment Strategies and Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts By Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News With Specific User Portfolios To Identify Relevant Impacts" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations By Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  usecase "AIFR009": Generate Client Predictive Insights that Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning As Defined by Industry Standards Like FINRA Guidelines
  
  AI --> (SFR012)
}

C <|-- Sys
FA <|-- Sys
SA <|-- Sys

@enduml