@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR002
  
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004

  FinancialAdvisor --> (View Predictive Analytics)
  FinancialAdvisor --> (Configure Analysis Parameters)
}

package SystemAdmin {
  actor "System Administrator" as SAFR001
  
  usecase "SAFR002: Manage Analysis Parameters for the AI System" as SAFR002
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013

  SystemAdmin --> (Manage Analysis Parameters)
  SystemAdmin --> (Generate Client Alerts)
}

package User {
  actor "User (Client, Financial Advisor, or System Administrator)" as CFR011
  
  usecase "CFR011: Send Feedback about the System's Recommendations and Insights" as CFR011

  User --> (Send Feedback)
}

rectangle "System Components" {
  rectangle AIComponent {
    usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities for Users" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns that Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009

    AIComponent --> (Generate Financial Predictions)
    AIComponent --> (Generate Personalized Recommendations)
    AIComponent --> (Generate Spending Limit Alerts)
    AIComponent --> (Generate Investment Opportunity Analyses)
    AIComponent --> (Generate Investment Opportunities)
    AIComponent --> (Generate Anomaly Transaction Alerts)
    AIComponent --> (Generate Contextualized News Insights)
    AIComponent --> (Generate Client Predictive Intervention Recommendations)
    AIComponent --> (Generate Client Predictive Insights)
  }

  rectangle NotificationSystem {
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition" as AIFR006

    NotificationSystem --> (Generate Client Alerts)
    NotificationSystem --> (Anomaly Transaction Alerts)
  }

  rectangle DashboardGenerator {
    usecase "SFR12: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR17
    usecase "AIFR009: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009

    DashboardGenerator --> (Generate Financial Health Reports)
    DashboardGenerator --> (Client Predictive Insights)
  }

  rectangle RecommendationSystem {
    usecase "SFR12: Generate Client Alerts Based on Predefined Conditions" as SFR13
    usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007

    RecommendationSystem --> (Generate Recommendations)
    RecommendationSystem --> (Contextualized News Insights)
  }
}

CFR001 --> CFR002
CFR001 --> CFR003
CFR001 --> CFR004
CFR001 --> CFR005
CFR001 --> CFR006
CFR001 --> CFR007
CFR001 --> CFR008
CFR001 --> CFR009
CFR001 --> (SFR02: Generate Personalized Recommendations)
CFR001 --> (AIFR004: Generate Investment Opportunity Analyses for Users)

FAFR002 --> FAFR003
FAFR002 --> FAFR004

SAFR001 --> SAFR002
SAFR001 --> SFR013

CFR011 --> CFR011

@enduml