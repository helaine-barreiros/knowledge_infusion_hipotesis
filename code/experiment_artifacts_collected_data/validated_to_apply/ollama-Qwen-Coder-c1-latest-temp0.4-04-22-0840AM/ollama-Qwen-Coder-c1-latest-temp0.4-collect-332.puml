@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR003: View Financial Predictions" as SFR004
  usecase "CFR004: Receive Personalized Recommendations" as SFR005
  usecase "CFR005: Manage Recommendation Preferences" as SAFR002
  usecase "CFR006: View Spending Limit Alerts" as SFR013
  usecase "CFR007: View Investment Opportunities" as AIFR004
  usecase "CFR008: View News Related to Portfolio" as SFR009
  usecase "CFR009: Access Personalized Dashboard" as SFR12
  usecase "CFR10: Manage Relationship with Financial Advisors" as SAFR04
  
  CFR001 --> (SAFR003)
  CFR001 --> (SFR004)
  CFR001 --> (SFR005)
  CFR001 --> (SAFR002)
  CFR001 --> (SFR013)
  CFR001 --> (AIFR004)
  CFR001 --> (SFR009)
  CFR001 --> (SFR12)
  CFR001 --> (SAFR04)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR003: View Predictive Analytics for Clients" as SFR006
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as SAFR05
  usecase "FAFR002: Manage Client Mentoring Sessions Based on Insights" as AIFR010
  
  FAFR001 --> (SFR006)
  FAFR001 --> (SAFR05)
  FAFR001 --> (AIFR010)
}

package "System Administrator" {
  actor SystemAdmin as SAFR001
  usecase "SAFR004: Manage Analysis Parameters for AI System" as AIFR002
  
  SAFR001 --> (AIFR002)
}

rectangle "AI Component" {
  usecase "AIFR003: Generate Spending Limit Alerts" as SFR05
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR007
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as SAFR018
  usecase "AIFR009: Generate Contextualized News Insights" as SFR023
  
  rectangle "Financial Predictions" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR006
  }
  
  rectangle "Personalized Recommendations" {
    usecase "AIFR002: Generate Personalized Recommendations for Users" as SFR05
  }
}

rectangle "System" {
  usecase "SFR013: Deliver Client Alerts Through Appropriate Notification Channels" as SAFR08
  usecase "SFR14: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as AIFR029
  
  rectangle "User Feedback Management" {
    usecase "AIFR017: Manage User Feedback to Continuously Improve System Outputs" as SAFR03
  }
}

@enduml