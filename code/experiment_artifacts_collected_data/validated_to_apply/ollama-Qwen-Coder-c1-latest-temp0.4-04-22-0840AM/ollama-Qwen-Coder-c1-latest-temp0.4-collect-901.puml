@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR002
  
  usecase "FAFR003: View Predictive Analytics about My Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FinancialAdvisor --> (FAFR002)
}

package System {
  actor "System Administrator" as SAFR001
  actor "AI System" as AIFR009
  
  usecase "SFR003: Request Financial Predictions from the AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from the AI Component" as SFR004
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  
  System --> (SAFR001)
}

package Alerts {
  package ClientAlerts {
    usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition" as AIFR006
    
    CFR001 --> (SFR002)
  }
  
  package AdvisorAlerts {
    usecase "FAFR005: View Client Intervention Alerts When the System Detects Patterns Requiring Professional Attention to Proactively Assist Clients with Potential Financial Issues" as FAFR005
    usecase "AIFR018: Generate Predictive Insights from the AI Component to Enhance the Value of Financial Guidance Provided to Clients" as AIFR018
    
    FAFR002 --> (FAFR005)
  }
}

package News {
  package ClientNews {
    usecase "SFR007: Request Contextualized News Insights from the AI Component to Identify Potential Impacts on Users' Investments" as SFR007
    usecase "AIFR013: Generate Client Predictive Insights that Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR013
    
    CFR001 --> (SFR007)
  }
  
  package AdvisorNews {
    usecase "FAFR008: View News Related to My Investment Portfolio to Stay Informed About Market Events That Might Affect My Assets" as FAFR008
    usecase "AIFR021: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR021
    
    FAFR002 --> (FAFR008)
  }
}

package Dashboards {
  package ClientDashboards {
    usecase "SFR12: Generate Client Dashboards that Present Financial Information in an Intuitive and Actionable Format" as SFR12
    usecase "AIFR034: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR034
    
    CFR001 --> (SFR12)
  }
  
  package AdvisorDashboards {
    usecase "FAFR09: View Predictive Analytics about My Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as FAFR09
    usecase "AIFR35: Generate Client Dashboards that Present Financial Information in an Intuitive and Actionable Format" as AIFR35
    
    FAFR002 --> (FAFR09)
  }
}

package Feedback {
  package UserFeedback {
    usecase "CFR11: Send Feedback about the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as CFR11
    
    CFR001 --> (CFR11)
    FAFR002 --> (CFR11)
  }
  
  package AdminFeedback {
    usecase "SAFR05: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SAFR05
    
    SAFR001 --> (SAFR05)
  }
}

@enduml