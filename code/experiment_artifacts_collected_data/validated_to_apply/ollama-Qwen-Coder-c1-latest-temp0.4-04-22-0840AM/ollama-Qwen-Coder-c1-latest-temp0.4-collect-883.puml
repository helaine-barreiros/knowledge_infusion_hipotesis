@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
  
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004

  FinancialAdvisor --> (FAFR002)
  FinancialAdvisor --> FAFR003
  FinancialAdvisor --> FAFR004
}

package "System Administrator" {
  actor SystemAdministrator as SAFR001
  
  usecase "SAFR001: Manage Analysis Parameters for the AI System" as SAFR001

  SystemAdministrator --> (SAFR001)
}

rectangle "System Components" {
  package "AI Component" {
    usecase "AIFR002: Generate Personalized Recommendations Based on Financial Profiles, Goals and Risk Tolerance" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users Evaluating Potential Investments Against Their Risk Profiles, Time Horizons and Financial Goals" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on Alignment with User's Investment Strategies and Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance With FinCEN Requirements" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations Based on Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009

    SAFR001 --> (SAFR001)
  }

  package "User Interface" {
    usecase "SFR012: Generate Client Dashboards Presenting Financial Information in an Intuitive and Actionable Format" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR013

    CFR001 --> (CFR001)
  }

  package "Notification System" {
    usecase "SFR008: Deliver Anomaly Transaction Alerts to Users Through Appropriate Notification Channels" as SFR008
    usecase "SFR014: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR014

    SAFR001 --> (SAFR001)
  }

  package "Recommendation System" {
    usecase "AIFR002: Generate Personalized Recommendations Based on Financial Profiles, Goals and Risk Tolerance" as AIFR002
    usecase "SFR009: Request Contextualized News Insights from the AI Component to Identify Potential Impacts on Users' Investments" as SFR009

    SAFR001 --> (SAFR001)
  }

  package "Prediction System" {
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users Evaluating Potential Investments Against Their Risk Profiles, Time Horizons and Financial Goals" as AIFR004
    usecase "SFR016: Request Predictive Insights from the AI Component to Enhance the Value of Financial Guidance Provided to Clients" as SFR016

    SAFR001 --> (SAFR001)
  }

  package "Health Report System" {
    usecase "AIFR009: Generate Client Predictive Intervention Recommendations Based on Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR009
    usecase "SFR017: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR017

    SAFR001 --> (SAFR001)
  }

  package "Feedback System" {
    usecase "CFR011: Send Feedback About the System's Recommendations and Insights to Help Improve Future Outputs" as CFR011

    SAFR001 --> (SAFR001)
  }
}

@enduml