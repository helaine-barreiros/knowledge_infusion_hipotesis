@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
  
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA

  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004

}

package "System Administrator" {
  actor SystemAdmin as SA

  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  
  SA --> SAFR001

}

package "System Components" {
  
  rectangle "AI Component" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
    
  }
  
  rectangle "Notification Component" {
    usecase "SFR001: Deliver Alerts to Users Through Appropriate Notification Channels" as SFR001

  }

  rectangle "Recommendation Engine" {
    usecase "SFR002: Deliver Personalized Recommendations Based on Each User's Financial Profiles" as SFR002
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users Based on Their Risk Tolerance and Goals"
    
  }

  rectangle "Prediction Engine" {
    usecase "SFR003: Request Financial Predictions from the AI Component" as SFR003
    
  }
  
  rectangle "Recommendation Generation Engine" {
    usecase "SFR004: Request Personalized Recommendations from the AI Component Based on Each User's Financial Data and Preferences"
    
  }

  rectangle "Spending Limit Alert Generator" {
    usecase "SFR005: Request Spending Limit Alerts From the AI Component When User Spending Patterns Exceed Defined Thresholds"
    
  }
  
  rectangle "Investment Opportunity Analysis Engine" {
    usecase "SFR006: Request Investment Opportunity Analysis from the AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles"
    
  }

  rectangle "Specific Investment Opportunities Generator" {
    usecase "AIFR005: Generate Investment Opportunities for Users by Identifying Financial Instruments That Align with Their Investment Strategies and Modern Portfolio Theory Principles"
    
  }
  
  rectangle "Anomaly Transaction Alert Detector" {
    usecase "SFR007: Request Anomaly Transaction Alerts From the AI Component to Detect Potentially Fraudulent Activities in Compliance With FinCEN Requirements"
    
  }

  rectangle "Contextualized News Insights Generator" {
    usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts"
    
  }
  
  rectangle "Predictive Intervention Analysis Engine" {
    usecase "SFR15: Request Predictive Intervention Analyses From the AI Component to Identify When Financial Advisors Should Engage With Clients"
    
  }

  rectangle "Client Predictive Insights Generator" {
    usecase "AIFR09: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning"
    
  }
  
}

C --> AIFR001
C --> AIFR002
C --> AIFR003
C --> AIFR004
FA --> FAFR008
SA --> SAFR001

@enduml