@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004

  User --> CFR001
  SysAdmin --> SAFR001
  FAFD --> FAFR002
}

rectangle "Client Dashboard Features" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "SAFR005: Manage Recommendations Preferences" as SAFR005

  User --> CFR009
  SysAdmin --> SAFR005
}

rectangle "Spending Limits and Alerts" {
  usecase "CFR010: View Spending Limit Alerts" as CFR010
  usecase "SFR004: Request Spending Limit Alerts from AI Component" as SFR004

  User --> CFR010
}

rectangle "Investment Opportunities and Recommendations" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006

  User --> CFR007
}

rectangle "Financial Predictions and Insights" {
  usecase "CFR012: View News Related to My Investment Portfolio" as CFR012
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009

  User --> CFR012
}

rectangle "Feedback and Improvement" {
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights" as CFR011

  User --> CFR011
}

@enduml