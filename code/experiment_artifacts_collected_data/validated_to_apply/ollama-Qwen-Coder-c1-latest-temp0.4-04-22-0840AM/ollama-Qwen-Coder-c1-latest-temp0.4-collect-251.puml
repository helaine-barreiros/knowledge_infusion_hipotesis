@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FAFR001

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001_1
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  User --> CFR001
  SysAdmin --> SAFR001
  FAFR001 --> (FAFR001_1)
  
  User <|-- SFR002 : "Deliver"
  System Admin <|-- SAFR001 : "Manage"
  Financial Advisor <|-- AIFR002 : "Generate Recommendations" 
}

rectangle "Client Dashboards" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  User --> CFR009
  
  rectangle "News and Insights" {
    usecase "CFR008: View News Related to Investment Portfolio" as CFR008
    usecase "SFR017: Generate Financial Health Reports" as SFR017
    
    User --> (CFR008)
    System Admin --> (SFR017)
  }
  
  rectangle "Spending Limits and Alerts" {
    usecase "CFR006: View Spending Limit Alerts" as CFR006
    usecase "SAFR005: Request Spending Limit Alerts from AI Component" as SAFR005
    
    User --> (CFR006)
    System Admin --> (SFR005)
  }
  
  rectangle "Investment Opportunities" {
    usecase "CFR012: Generate Client Dashboards with Investment Insights" as CFR012
    usecase "FAFR007: View Predictive Analytics about Clients' Financial Situations" as FAFR003
    
    User --> (CFR012)
    System Admin --> (SFR016 : "Generate")
  }
}

rectangle "Financial Goals and Management" {
  usecase "SAFR018: Manage Users' Financial Goals to Track Progress" as SAFR018
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  User --> (SFR018)
  System Admin --> (SFR020 : "Manage Feedback")
}

rectangle "Feedback and Improvement" {
  usecase "CFR11: Send Feedback about Recommendations and Insights" as CFR11
  User --> (CFR11)
}
@enduml