@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
}

package "System Administrator" {
  actor SysAdmin as SAFR003
}

rectangle "User Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR005: Manage Recommendations Preferences" as SAFR005
  
  CFR001 --> (View Financial Insights Dashboard)
  SAFR003 --> (Manage Analysis Parameters)
}

rectangle "Alerts and Notifications" {
  usecase "SFR001: Deliver Alerts" as SFR001
  usecase "SAFR008: Anomaly Transaction Alerts" as SAFR008
  
  CFR002 --> (View Client Intervention Alerts)
  FAFR003 --> (Predictive Analytics for Clients)
}

rectangle "Personalized Recommendations" {
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  CFR004 --> (Receive Personalized Recommendations)
}

rectangle "Spending Limits and Alerts" {
  usecase "SFR005: Request Spending Limit Alerts" as SFR005
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  
  CFR006 --> (View Spending Limit Alerts)
}

rectangle "Investment Opportunities and Insights" {
  usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  CFR007 --> (View Investment Opportunities)
}

rectangle "News and Analytics" {
  usecase "SFR008: Request Contextualized News Insights" as SFR008
  usecase "AIFR005: Generate News Insights for Users" as AIFR005
  
  CFR008 --> (View Financial News)
}

rectangle "Dashboards and Reporting" {
  usecase "SFR12: Generate Client Dashboards" as SFR12
  usecase "AIFR06: Generate Dashboard Insights" as AIFR06
  
  CFR009 --> (Access Personalized Dashboard)
}

rectangle "Feedback Management" {
  usecase "CFR11: Send Feedback" as CFR11
  
  CFR001 <|-- (Send Client Feedback)
  FAFR002 <|-- (Provide Advisor Insights)
  SAFR003 <|-- (Receive Admin Recommendations)
}
@enduml