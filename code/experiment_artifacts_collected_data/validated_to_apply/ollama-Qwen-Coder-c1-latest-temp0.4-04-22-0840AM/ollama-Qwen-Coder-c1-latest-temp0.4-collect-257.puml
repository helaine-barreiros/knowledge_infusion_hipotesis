@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (View Financial Insights Dashboard)
  C --> (Receive Alerts about Anomalous Transactions)
  C --> (View Financial Predictions)
  C --> (Receive Personalized Recommendations)
  C --> (Manage Recommendation Preferences)
  C --> (View Spending Limit Alerts)
  C --> (View Investment Opportunities)
  C --> (View News Related to Portfolio)
  C --> (Access Personalized Dashboard)
  C --> (Manage Relationship with Financial Advisors)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FA --> (Manage Client Mentoring Sessions)
  FA --> (View Client Intervention Alerts)
  FA --> (View Predictive Analytics about Clients' Financial Situations)
  FA --> (Configure Analysis Parameters for Specific Client Segments)
}

package "System Administrator" {
  actor SystemAdministrator as SA
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SA --> (Manage Analysis Parameters)
}

rectangle "AI Component" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Based on Modern Portfolio Theory" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  C --> (Generate Financial Predictions)
  FA --> (Generate Personalized Recommendations)
  C --> (Generate Spending Limit Alerts)
  C --> (Generate Investment Opportunity Analyses)
  C --> (Generate Investment Opportunities Based on Modern Portfolio Theory)
  C --> (Generate Anomaly Transaction Alerts)
  C --> (Generate Contextualized News Insights)
  C,FA --> (Generate Client Predictive Intervention Recommendations)
  C,FA --> (Generate Client Predictive Insights)
}

package "System" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Based on User Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Portfolios" as SFR009
  usecase "SFR010: Process Contextualized News for User Information Extraction" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
  usecase "SFR012: Generate Client Dashboards with Financial Data" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics for Insights into Behavior and Performance" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
  usecase "SFR016: Request Predictive Insights from AI Component to Enhance Financial Guidance" as SFR016
  usecase "SFR017: Generate Financial Health Reports Based on Standard Ratios and Metrics" as SFR017
  usecase "SFR018: Manage Users' Financial Goals for Progress Tracking and Recommendations" as SFR018
  usecase "SFR019: Maintain Historical Record of Insights for Trend Analysis" as SFR019
  usecase "SFR020: Manage User Feedback to Improve System Outputs" as SFR020
  
  C --> (Deliver Alerts to Users)
  FA,SA,C --> (Deliver Personalized Recommendations)
  SA,C --> (Request Financial Predictions from AI Component)
  SA,C --> (Request Personalized Recommendations from AI Component)
  SA,C --> (Request Spending Limit Alerts from AI Component)
  SA,C --> (Request Investment Opportunity Analysis from AI Component)
  C,FA --> (Request Specific Investment Opportunities Based on User Preferences)
  FA,SA,C --> (Request Anomaly Transaction Alerts from AI Component)
  C,FA --> (Find Contextualized News Relevant to Users' Portfolios)
  C,FA --> (Process Contextualized News for User Information Extraction)
  C,FA --> (Request Contextualized News Insights from AI Component)
  SA,C --> (Generate Client Dashboards with Financial Data)
  SFR013,SFR014 --> (Generate Client Alerts Based on Predefined Conditions)
  FA,SA --> (Generate Client Analytics for Insights into Behavior and Performance)
  C,FA --> (Request Predictive Intervention Analyses from AI Component)
  SA,C --> (Request Predictive Insights from AI Component to Enhance Financial Guidance)
  SFR017 --> (Generate Financial Health Reports Based on Standard Ratios and Metrics)
  FA,SA,C --> (Manage Users' Financial Goals for Progress Tracking and Recommendations)
  C,FA,SA --> (Maintain Historical Record of Insights for Trend Analysis)
  SA,C --> (Manage User Feedback to Improve System Outputs)
}

C --> SFR013
FA --> SFR016
SFR020 --> FA

@enduml