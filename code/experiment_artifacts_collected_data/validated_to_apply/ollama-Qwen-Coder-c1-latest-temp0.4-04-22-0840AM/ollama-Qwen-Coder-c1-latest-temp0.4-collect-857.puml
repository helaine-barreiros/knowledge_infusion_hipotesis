@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> CFR001 : (View)
  C --> CFR002 : (Alerts)
  C --> CFR003 : (Predictions)
  C --> CFR004 : (Recommendations)
  C --> CFR005 : (Manage Preferences)
  C --> CFR006 : (Spending Alerts)
  C --> CFR007 : (Investment Opportunities)
  C --> CFR008 : (News)
  C --> CFR009 : (Dashboard)
  C --> CFR10 : (Relationship Management)
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> FAFR001 : (Manage Sessions)
  FA --> FAFR002 : (Alerts)
  FA --> FAFR003 : (Predictive Analytics)
  FA --> FAFR004 : (Configure Parameters)
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SA --> SAFR001 : (Manage Parameters)
}

package "AI System" {
  rectangle AI {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
    
    C --> AIFR001 : (Predictions)
    C --> AIFR002 : (Recommendations)
    C --> AIFR003 : (Spending Alerts)
    C --> AIFR004 : (Investment Opportunities)
    C --> AIFR005 : (Opportunities)
    C --> AIFR006 : (Alerts)
    C --> AIFR007 : (News Insights)
    C --> AIFR008 : (Predictive Recommendations)
    C --> AIFR009 : (Client Predictive Insights)
    
    FA --> AIFR001 : (Predictions)
    FA --> AIFR002 : (Recommendations)
    FA --> AIFR003 : (Spending Alerts)
    FA --> AIFR004 : (Investment Opportunities)
    FA --> AIFR005 : (Opportunities)
    FA --> AIFR006 : (Alerts)
    FA --> AIFR007 : (News Insights)
    FA --> AIFR008 : (Predictive Recommendations)
    FA --> AIFR009 : (Client Predictive Insights)
    
    SA --> AIFR001 : (Parameters)
  }
}

package "System" {
  rectangle Sys {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    usecase "SFR002: Delivers Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities Based on ESG Preferences" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
    usecase "SFR010: Process Contextualized News to Extract Information for User's Financial Situation" as SFR010
    usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
    usecase "SFR012: Generate Client Dashboards in an Intuitive Format" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
    usecase "SFR014: Generate Client Analytics Providing Insights into Financial Behavior and Performance" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
    usecase "SFR016: Request Predictive Insights From the AI Component" as SFR016
    usecase "SFR017: Generate Financial Health Reports Assessing Users' Overall Wellbeing" as SFR017
    usecase "SFR018: Manage User's Financial Goals to Track Progress and Provide Recommendations" as SFR018
    usecase "SFR019: Maintain a Historical Record of Users' Insights for Trend Analysis" as SFR019
    usecase "SFR020: Manage User Feedback To Improve Future Outputs" as SFR020
    
    C --> Sys : (Deliver Alerts)
    C --> Sys : (Personalized Recommendations)
    FA --> Sys : (Deliver Alerts)
    FA --> Sys : (Personalized Recommendations)
    
    SA --> Sys : (Manage Parameters)
  }
}

package "User Feedback" {
  usecase "CFR11: Send Feedback about System's Recommendations and Insights" as CFR11
  
  C --> CFR11
  FA --> CFR11
  SA --> CFR11
}

@enduml