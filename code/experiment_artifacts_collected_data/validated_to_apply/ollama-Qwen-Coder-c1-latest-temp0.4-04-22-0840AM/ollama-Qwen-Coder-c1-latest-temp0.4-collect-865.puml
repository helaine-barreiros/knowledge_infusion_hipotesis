@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access Financial News" as CFR008
  usecase "CFR009: View Consolidated Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR017: Generate Financial Health Reports" as SFR017
  usecase "CFR11: Send Feedback" as CFR11

  SA --> (SAFR001)
  SA --> (SFR017)
  SA --> (CFR11)
}

package "System Components" {
  rectangle System {
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
    usecase "SFR005: Request Spending Limit Alerts" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities Matching Criteria" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to User Portfolios" as SFR009
    usecase "SFR010: Process Contextualized News for Users' Financial Situations" as SFR010
    usecase "SFR011: Request Contextualized News Insights from AI" as SFR011
    usecase "SFR012: Generate Client Dashboards" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
    usecase "SFR014: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses from AI" as SFR015
    usecase "SFR016: Request Predictive Insights From the AI Component to Enhance Value of Guidance Provided to Clients" as SFR016
    usecase "SFR020: Manage User Feedback To Continuously Improve Quality and Relevance Of Financial Insights" as SFR020

    C --> (SFR002)
    FA --> (SFR003)
    SA --> (SFR017)

    SystemAdmin <|-- SAFR001
    SystemAdmin <|-- SFR017
  }
}

@enduml