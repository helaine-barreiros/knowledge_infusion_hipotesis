@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFD002
  usecase "SFR009: Request Contextualized News Insights" as SFR009
  
  Client --> CFR001
  SysAdmin --> SAFR001
  Financial Advisor --> (FAFD002)
  System Admin --> (SAFR001)
}

rectangle "Financial Advice Module" {
  usecase "FAFR003: View Predictive Analytics" as FAFD003
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  Financial Advisor --> (FAFD003)
}

rectangle "Personalization Module" {
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "SFR012: Request Dashboards" as SFR012
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  Client --> (CFR004)
}

rectangle "Security and Compliance Module" {
  usecase "SAFR005: Manage Recommendation Preferences" as SAFR005
  usecase "SFR13: Request Alerts" as SFR13
  
  SysAdmin --> (SAFR005)
}

rectangle "Spending Limits Module" {
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  
  Client --> (CFR006)
}

rectangle "Investment Opportunities Module" {
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "FAFR015: Request Predictive Intervention Analyses" as FAFD015
  usecase "AIFR004: Generate Investment Opportunity Analysis" as AIFR004
  
  Client --> (CFR007)
}

rectangle "News Module" {
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "SFR10: Request Contextualized News Insights" as SFR10
  
  Client --> (CFR008)
  
  rectangle "AI Component" {
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "SFR023: Request Predictive Insights from AI" as SFR023
    
    Financial Advisor --> (FAFD015)
  }
}

rectangle "Feedback Module" {
  usecase "CFR11: Send Feedback about Recommendations and Insights" as CFR11
  
  Client --> (CFR11)
}
@enduml