@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics about My Clients' Financial Situations" as FAFR003
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002
  usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> FAFR003
  SFR002 <|-- (SFR005)
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights to Provide More Valuable Guidance Aligned with Each Client's Financial Goals" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts When the System Detects Patterns Requiring Professional Attention to Proactively Assist Clients With Potential Financial Issues" as FAFR002
  
  FAFD --> (FAFR001)
  FAFD --> (FAFR002)
}

rectangle "System Functions" {
  usecase "SFR003: Request Financial Predictions From the AI Component to Provide Users With Forward-Looking Financial Insights" as SFR003
  usecase "AIFR004: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance As Defined by Industry Standards Like FINRA Guidelines" as AIFR002
  
  Sys --> (SFR003)
  Sys --> (AIFR004)
}

rectangle "Client Functions" {
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as CFR011
  
  Client --> (CFR011)
}
@enduml