@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFD002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  Client --> CFR001
  Client --> SAFR001
  Client --> FAFD002
  SysAdmin --> SAFR001
  FinancialAdvisor --> FAFD002
}

rectangle "Client Dashboard" {
  usecase "CFR011: Send Feedback about Recommendations and Insights" as CFR011
  
  Client --> CFR011
}

@enduml