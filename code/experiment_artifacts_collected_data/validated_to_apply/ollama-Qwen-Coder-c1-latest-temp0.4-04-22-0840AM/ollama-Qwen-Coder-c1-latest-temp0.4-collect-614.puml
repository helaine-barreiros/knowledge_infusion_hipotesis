@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure analysis parameters for specific client segments" as FAFR004
  
  User --> CFR001
  SysAdmin --> SAFR001
  FinancialAdvisor --> (FAFR004)
}

rectangle "Client Dashboard" {
  usecase "CFR002: View Alerts about Anomalous Transactions" as CFR002
  usecase "SAFR006: Request spending limit alerts from the AI component" as SAFR006
  
  User --> (CFR002)
}

rectangle "Financial Predictions and Recommendations" {
  usecase "CFR003: View Financial Predictions Based on Historical Data" as CFR003
  usecase "SAFR005: Request financial predictions from the AI component" as SAFR005
  
  User --> (CFR003)
}

rectangle "Personalized Recommendations and Preferences Management" {
  usecase "CFR004: Receive Personalized Recommendations Aligned with Financial Profile and Goals" as CFR004
  usecase "SAFR002: Manage personalized recommendations preferences to ensure the system provides insights relevant to my financial objectives and risk tolerance" as SAFR002
  
  User --> (CFR004)
}

rectangle "Investment Opportunities Management" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "SAFR006: Request investment opportunity analysis from the AI component" as SAFR006
  
  User --> (CFR007)
}

rectangle "News and Information Management" {
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "SAFR009: Find contextualized news relevant to users' financial portfolios from trusted financial news sources" as SAFR009
  
  User --> (CFR008)
}

rectangle "Relationship Management with Financial Advisors" {
  usecase "CFR10: Manage My Relationship with Financial Advisors, including permissions for sharing my financial data" as CFR10
  usecase "FAFR002: View client intervention alerts when the system detects patterns requiring professional attention to proactively assist clients with potential financial issues" as FAFR002
  
  User --> (CFR10)
}

rectangle "Feedback Management System" {
  usecase "CFR11: Send Feedback about the System's Recommendations and Insights" as CFR11
  
  User --> (CFR11)
}
@enduml