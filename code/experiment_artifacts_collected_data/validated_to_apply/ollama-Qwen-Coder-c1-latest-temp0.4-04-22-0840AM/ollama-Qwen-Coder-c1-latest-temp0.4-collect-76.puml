@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor (FA): as FAFR001

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Analysis Parameters" as SAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  
  Client --> CFR001
  SysAdmin --> SAFR002
  FAFR001 --> FAFR003
}

rectangle "Client Dashboard Features" {
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Get Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  
  Client --> CFR002
  Client --> CFR003
  Client --> CFR004
  Client --> CFR005
}

rectangle "Spending Limits and Alerts" {
  usecase "SAFR001: Set Spending Limit Alerts" as SAFR001
  
  SysAdmin --> SAFR001
}

rectangle "Investment Opportunities" {
  usecase "CFR006: View Investment Opportunities Suitable to Risk Profile" as CFR006
  usecase "FAFR007: Configure Analysis Parameters for Client Segments" as FAFR004
  
  Client --> CFR006
  SysAdmin --> FAFR004
}

rectangle "News and Analytics" {
  usecase "CFR008: View News Related to Investment Portfolio" as CFR008
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  Client --> CFR008
  SysAdmin --> SFR012
}

rectangle "Client Relationship Management" {
  usecase "CFR10: Manage Relationships with Financial Advisors" as CFR10
  usecase "SFR03: Deliver Personalized Recommendations to Users" as SFR03
  
  Client --> CFR10
  SysAdmin --> SFR03
}

rectangle "Feedback and Continuous Improvement" {
  usecase "CFR11: Send Feedback About System's Recommendations and Insights" as CFR11
  
  Client --> CFR11
}
@enduml