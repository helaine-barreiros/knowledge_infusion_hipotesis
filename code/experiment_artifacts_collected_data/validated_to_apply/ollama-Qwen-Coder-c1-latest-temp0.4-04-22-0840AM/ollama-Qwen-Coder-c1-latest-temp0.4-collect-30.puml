@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor (FA): as FA
:User: as User

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Analysis Parameters" as SAFR002
  usecase "SFR003: Request Predictive Analytics" as SFR003
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  Client --> CFR001
  SysAdmin --> SAFR002
  FA --> FAFR001
  User --> (CFR001, SFR003)
}

rectangle "Client Management" {
  usecase "SFR018: Manage Users' Financial Goals" as SFR018
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  Client --> (SAFR005, SFR019)
}

rectangle "Notification System" {
  usecase "SFR013: Request Alerts from AI Component" as SFR013
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  
  Client --> (CFR012, SFR014)
}

rectangle "Investment Management" {
  usecase "SFR007: Request Investment Opportunity Analysis" as SFR007
  usecase "AIFR005: Generate Investment Opportunities" as AIFR005
  
  Client --> (FAFR002, FAFR003)
}

rectangle "Financial Advisor Management" {
  usecase "FAFR014: Configure Analysis Parameters for Specific Client Segments" as FAFR014
  usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
  
  FA --> (FAFR015, SFR020)
}

rectangle "System Feedback Management" {
  usecase "CFR011: Send System Feedback" as CFR011
}
@enduml