@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> (FAFR002)
}

rectangle "Financial Advisor System" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  
  FinancialAdvisor --> (FAFR001)
  FinancialAdvisor --> (FAFR002)
}

rectangle "Client Dashboard System" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  Client --> (CFR009)
  SysAdmin --> (SAFR001)
}

rectangle "Notification System" {
  usecase "SFR0013: Request Client Alerts" as SFR0013
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  
  Sys --> (SFR0013)
}

rectangle "Recommendation System" {
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  Sys --> (CFR004)
}

rectangle "Spending Limit System" {
  usecase "CFR011: Send Feedback about the system's recommendations and insights" as CFR011
  usecase "SFR005: Request Spending Limit Alerts" as SFR005
  
  Sys --> (SFR005)
}

rectangle "Investment Opportunity System" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  
  Sys --> (SFR006)
}

rectangle "News System" {
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  
  Sys --> (SFR010)
}

rectangle "Financial Health System" {
  usecase "CFR012: Access Personalized Dashboard" as CFR012
  usecase "AIFR009: Generate Financial Health Reports" as AIFR009
  
  Sys --> (SFR017)
}
@enduml