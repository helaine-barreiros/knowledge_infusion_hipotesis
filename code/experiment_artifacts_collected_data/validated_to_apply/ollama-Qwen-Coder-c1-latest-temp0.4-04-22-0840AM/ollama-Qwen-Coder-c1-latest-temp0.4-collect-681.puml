@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FAFR001

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Deliver Personalized Recommendations" as SFR003
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  User --> CFR001
  User --> SAFR001
  SysAdmin --> SAFR001
  FAFR001 --> FAFR002
}

rectangle "Client Dashboard Features" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  
  User --> CFR009
}

rectangle "Investment Management" {
  usecase "SAFR005: Manage Analysis Parameters for Specific Client Segments" as SAFR005
  usecase "FAFR007: View Predictive Analytics about Clients' Financial Situations" as FAFR003
  
  User --> SAFR005
  SysAdmin --> SAFR005
  FAFR001 --> FAFR007
}

rectangle "News and Alerts" {
  usecase "CFR008: View News Related to Investment Portfolio" as CFR008
  usecase "SFR009: Request Contextualized News Insights from AI Component" as SFR009
  
  User --> CFR008
}

rectangle "Spending Limits and Alerts" {
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  
  User --> CFR010
}

rectangle "Feedback Mechanism" {
  usecase "CFR11: Send Feedback about System's Recommendations and Insights" as CFR11
  
  User --> CFR11
}
@enduml