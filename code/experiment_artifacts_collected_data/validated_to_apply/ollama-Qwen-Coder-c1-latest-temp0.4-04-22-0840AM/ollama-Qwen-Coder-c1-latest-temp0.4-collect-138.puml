@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics about My Clients' Financial Situations" as FAFR003
  
  Client --> (CFR001)
  SysAdmin --> (SAFR001)
}

rectangle "Financial Advisor" {
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FinancialAdvisor --> (FAFR002)
  FinancialAdvisor --> (FAFR003)
  FinancialAdvisor --> (FAFR004)
}

rectangle "Client Dashboard Management" {
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
  usecase "CFR019: Maintain a Historical Record of Users' Insights" as CFR019
  
  Client --> (CFR010)
}

rectangle "User Feedback Management" {
  usecase "CFR011: Send Feedback about the System's Recommendations and Insights" as CFR011
  
  Client --> (CFR011)
}
@enduml