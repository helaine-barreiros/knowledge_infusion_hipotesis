@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> CFR001 : "View"
  C --> CFR002 : "Receive Alerts"
  C --> CFR003 : "Predictions"
  C --> CFR004 : "Recommendations"
  C --> CFR005 : "Manage Preferences"
  C --> CFR006 : "Spending Limits"
  C --> CFR007 : "Investment Opportunities"
  C --> CFR008 : "View News"
  C --> CFR009 : "Access Dashboard"
  C --> CFR10 : "Manage Relationship"
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> FAFR001 : "Manage Sessions"
  FA --> FAFR002 : "View Alerts"
  FA --> FAFR003 : "Predictive Analytics"
  FA --> FAFR004 : "Configure Parameters"
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SA --> SAFR001
}

rectangle "AI Component" {
  rectangle "AIFR001: Generate Financial Predictions" as AIFR001
  rectangle "AIFR002: Generate Personalized Recommendations" as AIFR002
  rectangle "AIFR003: Generate Spending Limit Alerts" as AIFR003
  rectangle "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  rectangle "AIFR005: Generate Investment Opportunities Based on Modern Portfolio Theory" as AIFR005
  rectangle "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  rectangle "AIFR007: Generate Contextualized News Insights" as AIFR007
  rectangle "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
  rectangle "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  C --> (AIFR001) : "Request"
  C --> (AIFR002) : "Request"
  C --> (AIFR003) : "Request"
  C --> (AIFR004) : "Request"
  C --> (AIFR005) : "Request"
  C --> (AIFR006) : "Request"
  C --> (AIFR007) : "Request"
  C --> (AIFR008) : "Request"
  C --> (AIFR009) : "Request"
  
  FA --> (AIFR001) : "Request"
  FA --> (AIFR002) : "Request"
  FA --> (AIFR003) : "Request"
  FA --> (AIFR004) : "Request"
  FA --> (AIFR005) : "Request"
  FA --> (AIFR006) : "Request"
  FA --> (AIFR007) : "Request"
  FA --> (AIFR008) : "Request"
  FA --> (AIFR009) : "Request"
  
  SA --> (AIFR001)
}

package "System" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Based on User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  usecase "SFR010: Process Contextualized News to Extract Information for User's Financial Situation" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
  usecase "SFR012: Generate Client Dashboards in an Intuitive Format" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics Providing Meaningful Insights" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
  usecase "SFR016: Request Predictive Insights from AI Component to Enhance Financial Guidance" as SFR016
  usecase "SFR017: Generate Financial Health Reports Assessing Users' Wellbeing" as SFR017
  usecase "SFR018: Manage Users' Financial Goals for Progress Tracking and Recommendations" as SFR018
  usecase "SFR019: Maintain Historical Record of Insights for Trend Analysis" as SFR019
  usecase "SFR020: Manage User Feedback to Improve System Outputs" as SFR020
  
  C --> (SFR001) : "Deliver"
  C --> (SFR002)
  C --> (SFR003)
  C --> (SFR004)
  C --> (SFR005)
  C --> (SFR006)
  C --> (SFR007)
  C --> (SFR008)
  C --> (SFR009)
  C --> (SFR010)
  C --> (SFR011)
  C --> (SFR012) : "Generate"
  C --> (SFR013)
  C --> (SFR014)
  C --> (SFR015)
  C --> (SFR016)
  C --> (SFR017)
  C --> (SFR018)
  C --> (SFR019)
  C --> (SFR020) : "Manage"
  
  FA --> (SFR001)
  FA --> (SFR003)
  FA --> (SFR004)
  FA --> (SFR005)
  FA --> (SFR006)
  FA --> (SFR007)
  FA --> (SFR008)
  FA --> (SFR012) : "Generate"
  FA --> (SFR013)
  FA --> (SFR014)
  
  SA --> (SFR001)
}

package "User" {
  actor User as U
  
  usecase "CFR11: Send Feedback to Improve System Outputs" as CFR11
  
  U --> CFR11
}
@enduml