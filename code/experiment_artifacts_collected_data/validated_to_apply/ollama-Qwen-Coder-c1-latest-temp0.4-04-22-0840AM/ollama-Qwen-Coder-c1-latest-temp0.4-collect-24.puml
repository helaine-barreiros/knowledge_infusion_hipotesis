@startuml

left to right direction

title Use Case Diagram for AI-Powered Financial Insights & Recommendations System

package "Clients" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR002
  usecase "CFR003: View Financial Predictions" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations" as SAFR004
  usecase "CFR005: Manage Recommendation Preferences" as SAFR005
  usecase "CFR006: View Spending Limit Alerts" as SAFR006
  usecase "CFR007: View Investment Opportunities" as SAFR007
  usecase "CFR008: View News Related to Portfolio" as SAFR008
  usecase "CFR009: Access Personalized Dashboard" as SAFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as SAFR10
  
  CFR001 --> (SAFR002)
  CFR001 --> (SAFR003)
  CFR001 --> (SAFR004)
  CFR001 --> (SAFR005)
  CFR001 --> (SAFR006)
  CFR001 --> (SAFR007)
  CFR001 --> (SAFR008)
  CFR001 --> (SAFR009)
  CFR001 --> (SAFR10)
}

package "Financial Advisors" {
  actor FinancialAdvisor as FAFR002
  
  usecase "FAFR003: View Predictive Analytics about Client's Financial Situation" as SAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as SAFR016
  usecase "FAFR005: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR002
  
  FinancialAdvisor --> (SAFR003)
  FinancialAdvisor --> (FAFR004)
  FinancialAdvisor --> (FAFR005)
}

package "System Administrator" {
  actor SysAdmin as SAFR018
  
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  usecase "SFR020: Manage User Feedback to Improve Outputs" as SFR020
  
  SysAdmin --> (SAFR001)
  SysAdmin --> (SFR020)
}

package "System" {
  rectangle "AI System" {
    usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on User Strategies and MPT Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights Correlating with User Portfolios" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations Based on Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Planning" as AIFR009
    
    SAFR016 <|-- (SAFR003)
  }
  
  rectangle "User Interface & Notifications" {
    usecase "SFR012: Generate Client Dashboards Presenting Financial Information in an Intuitive and Actionable Format" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR013
    
    SAFR016 <|-- (SAFR012)
  }
  
  rectangle "Financial Health & Recommendations Management" {
    usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations Based on User Profiles, Goals, and Risk Tolerance Using Industry Standards Like FINRA Guidelines" as AIFR002
    
    SAFR016 <|-- (SAFR014)
  }
  
  rectangle "News & Insights Processing" {
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios from Trusted Financial News Sources" as SFR009
    usecase "AIFR007: Generate Client Predictive Intervention Recommendations Based on Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    
    SAFR016 <|-- (SFR015)
  }
  
  rectangle "User Feedback & Continuous Improvement" {
    usecase "CFR11: Send Feedback About System's Recommendations and Insights to Improve Future Outputs" as CFR11
    usecase "AIFR020: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as AIFR020
    
    SAFR016 <|-- (CFR11)
  }
  
  rectangle "Historical Record Management & Trend Analysis" {
    usecase "SFR019: Maintain a Historical Record of Users' Insights to Enable Trend Analysis and Effectiveness Measurement" as SFR019
    usecase "AIFR020: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as AIFR020
    
    SAFR016 <|-- (SFR019)
  }
}

@enduml