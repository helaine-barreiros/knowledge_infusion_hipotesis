@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR010)
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SysAdmin as SA
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  
  SA --> (SAFR001)
}

rectangle "AI Components" {
  rectangle "AIFR001: Generate Financial Predictions" as AIFR001
  rectangle "AIFR002: Generate Personalized Recommendations" as AIFR002
  rectangle "AIFR003: Generate Spending Limit Alerts" as AIFR003
  rectangle "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  rectangle "AIFR005: Generate Investment Opportunities Based on Strategies and MPT Principles" as AIFR005
  rectangle "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  rectangle "AIFR007: Generate Contextualized News Insights" as AIFR007
  rectangle "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
  rectangle "AIFR009: Generate Client Predictive Insights for Forward-Looking Analysis" as AIFR009
  
  AIFR001 --> (SFR003)
  AIFR002 --> (SFR004)
  AIFR003 --> (SFR005)
  AIFR004 --> (SFR006)
  AIFR005 --> (SFR016)
  AIFR006 --> (SFR008)
  AIFR007 --> (SFR013)
  AIFR008 --> (SFR014)
  AIFR009 --> (SFR015)
  
}

package "System" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  
  C --> (SFR001)
  FA --> (SFR001)
  SA --> (SFR001)
  
  C --> (SFR002)
  FA --> (SFR002)
  SA --> (SFR002)
}

package "Contextualized News" {
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  usecase "SFR013: Deliver Alerts to Users" as SFR013
  
  C --> (AIFR007)
  FA --> (AIFR007)
  
}

package "Feedback Management" {
  usecase "CFR11: Send Feedback about System's Recommendations and Insights" as CFR11
  usecase "SFR20: Manage User Feedback to Continuously Improve Outputs" as SFR20
  
  C --> (CFR11)
  FA --> (CFR11)
  SA --> (CFR11)
  
}

@enduml