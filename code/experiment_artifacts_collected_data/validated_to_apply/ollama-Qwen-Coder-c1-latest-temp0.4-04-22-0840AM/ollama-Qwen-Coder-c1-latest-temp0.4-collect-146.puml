@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
  
  usecase "FAFR003: View Predictive Analytics about My Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
}

package "System Administrator" {
  actor SystemAdmin as SAFR001
  
  usecase "SAFR002: Manage Analysis Parameters for the AI System" as SAFR002
}

usecase "SFR005: Request Spending Limit Alerts from the AI Component" as SFR005
usecase "SFR006: Request Investment Opportunity Analysis from the AI Component" as SFR006
usecase "SFR017: Generate Financial Health Reports that Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR017

package "System Components" {
  usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
  
  rectangle "AI Component" {
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities for Users by Identifying Financial Instruments that Align with Their Investment Strategies and Modern Portfolio Theory Principles" as AIFR005
    
    CFR011 --> (SFR005)
    FAFR002 --> (FAFR003)
    
    SAFR001 <|-- (SAFR002)
  }
  
  rectangle "Notification Component" {
    usecase "SFR008: Request Anomaly Transaction Alerts from the AI Component by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as SFR008
    
    CFR011 --> (SFR008)
  }
  
  rectangle "News Component" {
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios from Trusted Financial News Sources" as SFR009
    usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
    
    CFR011 --> (SFR009)
  }
  
  rectangle "Dashboard Component" {
    usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance as Defined by Industry Standards like FINRA Guidelines" as AIFR002
    usecase "SFR13: Generate Client Alerts based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR13
    
    CFR011 --> (AIFR002)
  }
}

CFR001 --> (FAFR004) : "Manage Recommendations Preferences"
SFR005 <|-- (AIFR003)
SFR006 <|-- (AIFR004)

@enduml