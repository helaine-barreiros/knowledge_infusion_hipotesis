@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as SAFR004
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as SAFR005
  usecase "CFR005: Manage Personalized Recommendations Preferences to Ensure Relevance to My Financial Objectives and Risk Tolerance" as SAFR006
  usecase "CFR006: View Spending Limit Alerts When Exceeding Defined Thresholds in Specific Expense Categories" as SAFR007
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile (as defined under MiFID II or equivalent standards)" as SAFR012
  usecase "CFR008: View News Related to My Investment Portfolio to Stay Informed About Market Events" as SAFR014
  usecase "CFR009: Access a Personalized Dashboard That Consolidates Financial Information in a Single View to Efficiently Monitor Finances" as SAFR023
  
  CFR001 --> SAFR003 : "View Alerts"
  CFR001 --> SAFR004 : "View Predictions"
  CFR001 --> SAFR005 : "Receive Recommendations"
  CFR001 --> SAFR006 : "Manage Preferences"
  CFR001 --> SAFR007 : "View Spending Alerts"
  CFR001 --> SAFR012 : "View Investment Opportunities"
  CFR001 --> SAFR014 : "View News"
  CFR001 --> SAFR023 : "Access Dashboard"
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts When System Detects Patterns Requiring Professional Attention to Proactively Assist Clients with Potential Financial Issues" as SAFR008
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as SAFR016
  
  FAFR001 --> SAFR008 : "View Alerts"
  FAFR001 --> SAFR016 : "View Predictions"
}

package "System Administrator" {
  actor SystemAdministrator as SAFR009

  usecase "SAFR002: Manage Analysis Parameters for the AI System to Ensure Algorithms Remain Accurate, Relevant, and Compliant with Financial Regulations Such As Basel III for Risk Management" as SAFR015
  
  SAFR009 --> SAFR015 : "Manage Parameters"
}

package "System" {
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles to Support Better Financial Decision-Making" as AIFR002
  usecase "SFR003: Request Financial Predictions from the AI Component to Provide Users With Forward-Looking Financial Insights" as AIFR001
  
  System --> SAFR008 : "Deliver Alerts"
  System --> SAFR016 : "Provide Recommendations"
}

package "AI System" {
  usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance as Defined by Industry Standards Like FINRA Guidelines" as AIFR002
  usecase "AIFR017: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as AIFR017
  
  System --> SAFR023 : "Generate Dashboards"
}

package "User (Client, Financial Advisor, or System Administrator)" {
  actor User as CFR011

  usecase "CFR011: Send Feedback About the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as SAFR024
  
  User --> SAFR024 : "Send Feedback"
}

@enduml