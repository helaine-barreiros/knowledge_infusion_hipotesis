@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics about Client's Financial Situations" as FAFR003
  
  Client --> (CFR001)
  SysAdmin --> (SAFR001)
}

rectangle "Financial Advisor System" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts When the System Detects Patterns Requiring Professional Attention" as FAFR002
  
  FinancialAdvisor --> (FAFR001)
  FinancialAdvisor --> (FAFR002)
}

rectangle "Notification System" {
  usecase "SFR001: Deliver Alerts to Users Through Appropriate Notification Channels" as SFR001
  usecase "SFR003: Request Personalized Recommendations from the AI Component Based on Each User's Financial Data and Preferences" as SFR003
  
  SystemAdmin --> (SFR001)
  Client --> (SFR001)
  FinancialAdvisor --> (SFR002)
  
}

rectangle "AI Analysis System" {
  usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
  usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
  
  SystemAdmin --> (SAFR001)
}

rectangle "Investment Analysis System" {
  usecase "SFR006: Request Investment Opportunity Analysis From the AI Component to Identify Suitable Investments For Users Based on Their Risk Profiles" as SFR006
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  
  SystemAdmin --> (SAFR001)
}

rectangle "News Analysis System" {
  usecase "SFR008: Request Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR008
  usecase "AIFR007: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR007
  
  SystemAdmin --> (SAFR001)
}

rectangle "Feedback Management System" {
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights to Help Improve Future Outputs" as CFR011
  usecase "SFR020: Manage User Feedback To Continuously Improve Quality and Relevance of Financial Insights" as SFR020
  
  Client --> (CFR011)
  SysAdmin --> (SFR020)
}

@enduml