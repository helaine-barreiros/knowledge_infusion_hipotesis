@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System: as Sys
:Financial Advisor: as FAFR001
:System Administrator: as SAFR001

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Deliver Personalized Recommendations" as SFR003
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  Client --> CFR001
  Client --> SAFR001
  FAFR001 --> FAFR002
  SysAdmin --> SAFR001
}

rectangle "Client Functions" {
  usecase "CFR002: View Alerts About Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Current Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as CFR004
  usecase "CFR005: Manage Personalized Recommendations Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as CFR006
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard That Consolidates Financial Information in a Single View" as CFR009
  
  Client --> CFR002
  Client --> CFR003
  Client --> CFR004
  Client --> CFR005
  Client --> CFR006
  Client --> CFR007
  Client --> CFR008
  Client --> CFR009
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations" as FAFR003
  
  FinancialAdvisor --> FAFR001
  FinancialAdvisor --> FAFR003
}

rectangle "System Functions" {
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002
  usecase "SFR004: Request Financial Predictions From the AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts From the AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis From the AI Component" as SFR006
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions To Ensure Timely Notification of Important Financial Events" as SFR013
  
  System --> SAFR001
  System --> FAFR002
  System --> AIFR004
  System --> SFR005
  System --> SFR006
}

rectangle "AI Functions" {
  usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
  usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  
  System --> AIFR001
  System --> AIFR002
  System --> AIFR003
}

rectangle "User Feedback" {
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights to Help Improve Accuracy and Relevance of Future Outputs" as CFR11
  
  Client --> CFR11
  FinancialAdvisor --> CFR11
  SystemAdministrator --> SAFR001
}

@enduml