@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Investment Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
  
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004
}

package "System Administrator" {
  actor SysAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters for the AI System" as SAFR001
  
  SA --> SAFR001
}

rectangle "AI Component" {
    package "Financial Insights & Predictions" {
        usecase "AIFR001: Generate Financial Predictions" as AIFR001
        usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
        
        CFR002 --> SFR003 : <<SFR>>
        SAFR001 <|-- AIFR001 : <<SAFR>>
    }
    
    package "Personalized Recommendations" {
        usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
        usecase "SFR002: Request Personalized Recommendations from AI Component" as SFR002
        
        CFR004 --> SFR002 : <<SFR>>
    }
    
    package "Spending Limit Alerts" {
        usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
        usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
        
        CFR006 --> SFR005 : <<SFR>>
    }
    
    package "Investment Opportunities" {
        usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
        usecase "AIFR005: Identify Financial Instruments for Users" as AIFR005
        usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
        
        CFR007 --> SFR006 : <<SFR>>
    }
    
    package "Anomaly Transaction Alerts" {
        usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
        usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
        
        CFR002 --> SFR008 : <<SFR>>
    }
    
    package "Contextualized News Insights" {
        usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
        usecase "SFR013: Request Predictive Intervention Analyses from AI Component" as SFR013
        
        CFR008 --> SFR013 : <<SFR>>
    }
    
    package "Client Predictive Interventions & Insights" {
        usecase "AIFR009: Generate Client Predictive Intervention Recommendations" as AIFR009
        usecase "AIFR008: Identify Patterns for Financial Difficulties or Opportunities" as AIFR010
        
        FAFR002 --> SFR013 : <<SFR>>
    }
}

package "System Components" {
  rectangle "Notification System" {
      usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  }

  rectangle "Dashboard Generator" {
      usecase "AIFR012: Generate Financial Health Reports" as AIFR012
      usecase "SFR12: Request Contextualized News Insights from AI Component" as SFR12
      
      CFR009 --> SFR12 : <<SFR>>
  }

  rectangle "Goal Management System" {
      usecase "AIFR018: Manage Users' Financial Goals to Track Progress and Provide Relevant Recommendations" as AIFR018
      usecase "SFR14: Request Client Analytics from AI Component" as SFR14
      
      CFR018 --> SFR14 : <<SFR>>
  }

  rectangle "Feedback Management System" {
      usecase "CFR11: Send Feedback about the System's Recommendations and Insights" as CFR11
      usecase "AIFR20: Generate Client Predictive Insights Based on User Data" as AIFR20
      
      CFR11 --> SFR20 : <<SFR>>
  }
}

@enduml