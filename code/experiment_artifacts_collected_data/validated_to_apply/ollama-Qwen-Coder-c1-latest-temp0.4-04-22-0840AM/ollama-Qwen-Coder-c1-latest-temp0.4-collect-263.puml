@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (View)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA

  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (Manage)
}

package "System Administrator" {
  actor SystemAdmin as SA

  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase ("SFAFR002") as SFAFR002 : "Manage Client Feedback"
  
  SA --> (Configure)
}

package "System Components" {
  rectangle System as Sys
  
  usecase "SFR001: Deliver Alerts" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase ("SFAFR003") as SFAFR003 : "Request Financial Predictions"
  usecase ("SFAFR004") as SFAFR004 : "Request Personalized Recommendations"
  usecase ("SFAFR005") as SFAFR005 : "Request Spending Limit Alerts"
  usecase ("SFAFR006") as SFAFR006 : "Request Investment Opportunity Analysis"
  usecase ("SFAFR007") as SFAFR007 : "Request Specific Investment Opportunities with ESG Preferences"
  usecase ("SFAFR008") as SFAFR008 : "Request Anomaly Transaction Alerts"
  usecase ("SFAFR009") as SFAFR009 : "Find Contextualized News Relevant to User Financial Portfolios"
  usecase ("SFAFR010") as SFAFR010 : "Process Contextualized News for Users' Financial Situations"
  usecase ("SFAFR011") as SFAFR011 : "Request Contextualized News Insights from AI Component"
  usecase ("SFAFR012") as SFAFR012 : "Generate Client Dashboards"
  usecase ("SFAFR013") as SFAFR013 : "Generate Client Alerts Based on Predefined Conditions"
  usecase ("SFAFR014") as SFAFR014 : "Generate Client Analytics for Meaningful Insights into Financial Behavior and Performance"
  usecase ("SFAFR015") as SFAFR015 : "Request Predictive Intervention Analyses from AI Component"
  usecase ("SFAFR016") as SFAFR016 : "Request Predictive Insights from AI Component to Enhance Financial Guidance"
  usecase ("SFAFR017") as SFAFR017 : "Generate Financial Health Reports for Users' Overall Financial Wellbeing"
  usecase ("SFAFR018") as SFAFR018 : "Manage User Financial Goals and Track Progress with Relevant Recommendations"
  usecase ("SFAFR019") as SFAFR019 : "Maintain Historical Record of Insights for Trend Analysis and Effectiveness Measurement"
  usecase ("SFAFR020") as SFAFR020 : "Manage User Feedback to Improve System Outputs"

  Sys --> (Deliver)
}

package "AI Components" {
  rectangle AI as A
  
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase ("AIFR002") as AIFR002 : "Generate Personalized Recommendations"
  usecase ("AIFR003") as AIFR003 : "Generate Spending Limit Alerts"
  usecase ("AIFR004") as AIFR004 : "Generate Investment Opportunity Analyses"
  usecase ("AIFR005") as AIFR005 : "Identify Financial Instruments Aligning with User Strategies and Modern Portfolio Theory Principles"
  usecase ("AIFR006") as AIFR006 : "Generate Anomaly Transaction Alerts in Compliance with FinCEN Requirements"
  usecase ("AIFR007") as AIFR007 : "Generate Contextualized News Insights Correlating Financial News with User Portfolios"
  usecase ("AIFR008") as AIFR008 : "Identify Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement"
  usecase ("AIFR009") as AIFR009 : "Generate Client Predictive Insights for Forward-Looking Analysis of Financial Situations"

  Sys --> (Analyze)
}

C --> (SFR001) --> S
FA --> (SFR002) --> S
SA --> (SFR003) --> A
A --> (SFAFR004) --> SA

@enduml