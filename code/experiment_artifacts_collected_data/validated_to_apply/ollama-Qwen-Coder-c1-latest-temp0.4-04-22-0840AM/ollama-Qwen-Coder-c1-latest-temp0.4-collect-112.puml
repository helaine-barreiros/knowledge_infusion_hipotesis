@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System: as Sys
:Financial Advisor: as FAFD
:System Administrator: as SAFA

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  Client --> (CFR001)
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "SFR015: Request Predictive Intervention Analyses" as SFR015
  
  Financial Advisor --> (FAFR001)
}

rectangle "System Administrator" {
  usecase "SAFR002: Manage Client Mentoring Sessions" as SAFR002
  usecase "SFR016: Request Predictive Insights" as SFR016
  
  System Administrator --> (SAFR002)
}

Client --> (FAFR003) : "View Predictive Analytics"
Financial Advisor --> (SAFR002) : "Manage Client Mentoring Sessions"

package "Notifications and Alerts" {
  usecase "SFR005: Request Spending Limit Alerts" as SFR005
  usecase "SFR019: Maintain Historical Record of Insights" as SFR019
  
  System --> (SFR005)
}

package "Recommendations" {
  usecase "SFR020: Manage User Feedback" as SFR020
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002

  Client --> (AIFR002) : "Receive Personalized Recommendations"
}

package "Investment Opportunities and News" {
  usecase "SFR016: Request Predictive Insights" as SFR016
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004

  Client --> (AIFR004) : "View Investment Opportunities"
}

package "AI Processing" {
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006

  System --> (AIFR003)
}

package "Contextualized News Processing" {
  usecase "SFR017: Request Contextualized News Insights" as SFR017
  usecase "AIFR007: Generate Client Predictive Intervention Recommendations" as AIFR007

  System --> (AIFR007)
}

@enduml