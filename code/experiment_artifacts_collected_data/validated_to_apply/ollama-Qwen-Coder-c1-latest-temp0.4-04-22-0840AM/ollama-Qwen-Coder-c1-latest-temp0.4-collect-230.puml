@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR003: View Financial Predictions" as SFR004
  usecase "CFR004: Receive Personalized Recommendations" as AIFR002
  usecase "CFR005: Manage Recommendation Preferences" as SAFR001
  usecase "CFR006: View Spending Limit Alerts" as SFR007
  usecase "CFR008: View Investment Opportunities" as AIFR004
  usecase "CFR009: Access Personalized Dashboard" as SFR12
  usecase "CFR10: Manage Relationship with Financial Advisors" as SAFR05
  
  CFR001 --> (SAFR003)
  CFR001 --> (SFR004)
  CFR001 --> (AIFR002)
  CFR001 --> (SAFR001)
  CFR001 --> (SFR007)
  CFR001 --> (AIFR004)
  CFR001 --> (SFR12)
  CFR001 --> (SAFR05)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts" as SAFR004
  usecase "FAFR003: View Predictive Analytics" as AIFR008
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as SFR015
  
  FAFR001 --> (SAFR004)
  FAFR001 --> (AIFR008)
  FAFR001 --> (SFR015)
}

package "System Administrator" {
  actor SystemAdministrator as SAFR001
  
  usecase "SAFR002: Manage Analysis Parameters for the AI System" as AIFR007
  usecase "CFR11: Send Feedback about Recommendations and Insights" as SFR020
  
  SAFR001 --> (AIFR007)
  SAFR001 --> (SFR020)
}

package "System Components" {
  rectangle "AI System" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR009
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR012
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR015
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR016
  }
  
  rectangle "Notification System" {
    usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR005
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR014
  }
  
  rectangle "Dashboard System" {
    usecase "SFR12: Generate Client Dashboards" as SFR12
  }
}

@enduml