@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001
:User: as User

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004

  Client --> CFR001
  SysAdmin --> SAFR001
  FAFR002 <|-- (FAFR001)
  User -> (CFR001)
}

rectangle "Client Services" {
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "SAFR005: Manage Personalized Recommendations Preferences" as SAFR005
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004

  Client --> (CFR002)
  SysAdmin --> (SAFR005)
}

rectangle "Financial Advisor Services" {
  usecase "FAFR01: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR01
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006

  FinancialAdvisor --> (FAFR01)
}

rectangle "System Operations" {
  usecase "AIFR03: Generate Spending Limit Alerts for Users" as AIFR03
  usecase "SFR007: Request Specific Investment Opportunities from AI Component Matching User Criteria and ESG Preferences" as SFR007

  SystemAdmin --> (SAFR001)
}

rectangle "News & Analytics Services" {
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios from Trusted Financial News Sources" as SFR009

  Client --> (CFR008)
}

rectangle "Dashboard & Feedback Services" {
  usecase "CFR012: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as CFR012
  usecase "SFR13: Request Contextualized News Insights from AI Component to Identify Potential Impacts on Users' Investments" as SFR013

  User --> (CFR012)
}

rectangle "AI System Components" {
  usecase "AIFR06: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR06
  usecase "SFR14: Request Predictive Insights from the AI Component to Enhance the Value of Financial Guidance Provided to Clients" as SFR14

  SystemAdmin --> (SAFR001)
}

rectangle "Feedback Management" {
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights to Help Improve Future Outputs" as CFR011

  User -> (CFR011)
}
@enduml