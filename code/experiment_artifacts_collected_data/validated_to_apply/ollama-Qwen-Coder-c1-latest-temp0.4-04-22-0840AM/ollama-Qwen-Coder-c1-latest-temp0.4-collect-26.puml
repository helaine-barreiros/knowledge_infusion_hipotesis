@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as Client
:User (Financial Advisor): as Advisor
:System Admin: as SysAdmin

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002

  rectangle "Client Functions" {
    Client --> CFR001 : View Financial Insights Dashboard
    Client --> SAFR005 : Manage Preferences for Recommendations
    Client --> SFR009 : Access News Related to Portfolio
    Client --> CFR011 : Send Feedback
  }

  rectangle "Financial Advisor Functions" {
    Advisor --> FAFR001 : Manage Mentoring Sessions
    Advisor --> SAFR004 : Configure Analysis Parameters for Clients
    Advisor --> SFR016 : Enhance Financial Guidance Insights
    Advisor --> CFR011 : Send Feedback
  }

  rectangle "System Admin Functions" {
    SysAdmin --> SAFR001 : Manage System Analysis Parameters
    SysAdmin --> FAFR004 : Configure Client Segments for Advisors
    SysAdmin --> SFR020 : Manage User Feedback
    SysAdmin --> CFR011 : Send Feedback
  }
}

@enduml