@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR005: Manage Analysis Parameters Preferences" as SAFR005
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  Client --> (CFR001)
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FinancialAdvisor --> (FAFR003)
  FinancialAdvisor --> (FAFR004)
}

rectangle "Client Management Functions" {
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
  usecase "SAFR002: View Client Intervention Alerts" as SAFR002
  
  Client --> (CFR010)
  SystemAdmin --> (SAFR005)
}

rectangle "System Functions" {
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  
  System --> (SAFR005)
}

rectangle "Alerts and Notifications Functions" {
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  
  System --> (SAFR005)
}

rectangle "Investment Functions" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  
  Client --> (CFR007)
}

rectangle "News and Information Functions" {
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios" as AIFR007
  
  Client --> (CFR008)
}

rectangle "Feedback and Improvement Functions" {
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights" as CFR11
  usecase "SFR20: Manage User Feedback to Continuously Improve Output Quality" as SFR20
  
  Client --> (CFR11)
}

@enduml