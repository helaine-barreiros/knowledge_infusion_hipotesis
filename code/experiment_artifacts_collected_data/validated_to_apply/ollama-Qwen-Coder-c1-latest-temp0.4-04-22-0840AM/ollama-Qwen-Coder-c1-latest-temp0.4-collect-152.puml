@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR004
  usecase "CFR003: View Financial Predictions" as SAFR005
  usecase "CFR004: Receive Personalized Recommendations" as SAFR006
  usecase "CFR005: Manage Recommendation Preferences" as SAFR007
  usecase "CFR006: View Spending Limit Alerts" as SAFR008
  usecase "CFR007: View Investment Opportunities" as SAFR012
  usecase "CFR008: View News Related to Portfolio" as SFR009
  usecase "CFR009: Access Personalized Dashboard" as AIFR014
  usecase "CFR10: Manage Relationship with Financial Advisors" as SAFR015
  
  CFR001 --> SAFR002 : "View Alerts"
  CFR001 --> SAFR003 : "View Predictions"
  CFR001 --> SAFR004 : "Receive Recommendations"
  CFR001 --> SAFR005 : "Manage Preferences"
  CFR001 --> SAFR006 : "Spending Alerts"
  CFR001 --> SAFR007 : "View Opportunities"
  CFR001 --> SAFR008 : "View News"
  CFR001 --> SAFR009 : "Access Dashboard"
  CFR001 --> SAFR015 : "Manage Advisors"
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR002
  
  usecase "FAFR003: View Predictive Analytics" as SAFR016
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as AIFR009
  
  FAFR002 --> SAFR003 : "View Analytics"
  FAFR002 --> AIFR009 : "Configure Parameters"
}

package System {
  actor "System Administrator" as SAFR001
  actor "User (Client, Financial Advisor, or System Admin)" as CFR011
  
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as AIFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as AIFR004
  usecase "SFR004: Request Personalized Recommendations from AI Component" as AIFR005
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as AIFR003
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as AIFR014
  usecase "SFR007: Request Specific Investment Opportunities from AI Component Matching User Criteria and ESG Preferences" as AIFR005
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component in Compliance with FinCEN Requirements" as AIFR016
  usecase "SFR013: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SAFR020
  
  SAFR001 --> SFR001 : "Manage Analysis Parameters"
  
  CFR011 --> SFR001 : "Send Feedback"
}

@enduml