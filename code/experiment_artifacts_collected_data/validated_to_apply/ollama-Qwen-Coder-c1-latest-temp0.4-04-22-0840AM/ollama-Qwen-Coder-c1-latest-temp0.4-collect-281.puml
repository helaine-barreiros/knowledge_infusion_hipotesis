@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "View Financial Predictions Based on Historical Data and Current Trends" as SAFR004
  usecase "Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as SAFR005
  usecase "Manage Personalized Recommendations Preferences to Ensure Relevance" as SAFR006
  usecase "View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as SAFR007
  usecase "View Investment Opportunities Suitable for My Risk Profile" as SAFR012
  usecase "View News Related to My Investment Portfolio" as SAFR013
  usecase "Access a Personalized Dashboard That Consolidates Financial Information in One View" as SAFR014
  
  CFR001 --> (SAFR003)
  CFR001 --> (SAFR005)
  CFR001 --> (SAFR006)
  CFR001 --> (SAFR007)
  CFR001 --> (SAFR012)
  CFR001 --> (SAFR013)
  CFR001 --> (SAFR014)
}

package "Financial Advisors" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts When Detected Patterns Requiring Professional Attention" as SAFR008
  usecase "View Predictive Analytics About Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as SAFR009
  usecase "Configure Analysis Parameters for Specific Client Segments Based on Different Profiles and Regulatory Requirements" as SAFR015
  
  FAFR001 --> (SAFR008)
  FAFR001 --> (SAFR009)
  FAFR001 --> (SAFR015)
}

package "System Administrator" {
  actor SystemAdmin as SAFR002
  
  usecase "Manage Analysis Parameters for AI System to Ensure Compliance and Accuracy with Financial Regulations" as SAFR001
  usecase "FAFR004: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR003
  usecase "SFR020: Manage User Feedback to Continuously Improve the Quality of Recommendations" as SFR020
  
  SAFR002 --> (SAFR001)
  SAFR002 --> (FAFR004)
  SAFR002 --> (SFR020)
}

package "System Components" {
  usecase "Deliver Alerts to Users Through Appropriate Notification Channels" as SFR003
  usecase "Generate Personalized Recommendations Based on Financial Profiles" as AIFR002
  usecase "Request Financial Predictions from AI Component for Forward-Looking Insights" as SFR004
  usecase "Request Personalized Recommendations from AI Component Based on User Data and Preferences" as SFR019
  usecase "Generate Spending Limit Alerts by Identifying Unusual Deviations in Spending Patterns" as AIFR003
  usecase "Generate Investment Opportunity Analyses for Users Based on Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  usecase "Request Specific Investment Opportunities from AI Component Matching User Criteria and ESG Preferences" as SFR017
  usecase "Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
  usecase "Generate Contextualized News Insights Correlating Financial News with Specific User Portfolios" as SFR017
  usecase "Request Predictive Intervention Analyses from AI Component Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  usecase "Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Planning" as SFR019
  
  rectangle System {
    SAFR002 --> (SFR003)
    SAFR002 --> (AIFR002)
    SAFR002 --> (SFR004)
    SAFR002 --> (SFR015)
    
    FAFR001 --> (FAFR003)
    FAFR001 --> (AIFR006)
    FAFR001 --> (SFR017)
  }
}

@enduml