@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FAFR001

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "AIFR009: Generate Contextualized News Insights" as AIFR009

  User --> CFR001
  SysAdmin --> SAFR001
  FAFR002 <|-- (FAFR001)
}

rectangle "Client Dashboards & Alerts" {
  usecase "CFR002: View Alerts about Anomalous Transactions" as CFR002
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013

  User --> CFR002
}

rectangle "Predictive Analytics & Recommendations" {
  usecase "CFR003: View Financial Predictions Based on Historical Data and Current Market Trends" as CFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  usecase "SFR016: Request Predictive Insights from the AI Component" as SFR016

  User --> CFR003
}

rectangle "Personalized Recommendations & Management" {
  usecase "CFR004: Receive Personalized Recommendations Aligned with Financial Profile and Goals" as CFR004
  usecase "SFR20: Manage Users' Financial Goals to Track Progress and Provide Relevant Recommendations" as SFR20

  User --> CFR004
}

rectangle "Spending Limits & Investment Opportunities" {
  usecase "CFR006: View Spending Limit Alerts When Exceed Predefined Thresholds in Specific Expense Categories" as CFR006
  usecase "SFR15: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR15

  User --> CFR006
}

rectangle "Investment Opportunities & News" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile (as Defined Under MiFID II or Equivalent Standards)" as CFR007
  usecase "SFR9: Find Contextualized News Relevant to Users' Financial Portfolios From Trusted Financial News Sources" as SFR09

  User --> CFR007
}

rectangle "Client Relationship Management" {
  usecase "CFR10: Manage My Relationship with Financial Advisors, Including Permissions for Sharing My Financial Data" as CFR10

  User --> (User)
}
@enduml