@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  Client --> CFR001
  SysAdmin --> SAFR001
  Financial Advisor --> FAFR003
}

rectangle "Alerts and Notifications" {
  usecase "SFR005: Request Spending Limit Alerts" as SFR005
  usecase "SAFR002: Manage Client Mentoring Sessions" as SAFR002
  
  Client --> SFR005
  Financial Advisor --> SAFR003
}

rectangle "Recommendations and Insights" {
  usecase "SFR004: Request Personalized Recommendations" as SFR004
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  Client --> SFR004
  Financial Advisor --> SAFR003
}

rectangle "Investment Opportunities and Analysis" {
  usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  Client --> SFR006
}

rectangle "News and Analytics" {
  usecase "CFR012: View News Related to Portfolio" as CFR012
  usecase "SFR007: Request Contextualized News Insights" as SFR007
  
  Client --> CFR012
}

rectangle "User Management and Feedback" {
  usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
  usecase "CFR011: Send Feedback about System's Outputs" as CFR011
  
  Client --> CFR011
}

@enduml