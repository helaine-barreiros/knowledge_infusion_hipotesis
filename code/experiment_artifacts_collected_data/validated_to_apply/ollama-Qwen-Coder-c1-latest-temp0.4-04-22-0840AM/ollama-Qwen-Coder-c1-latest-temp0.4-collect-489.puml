@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as CFR001
}

package "Financial Advisors" {
  actor FinancialAdvisor as FAFR002
}

package "System Administrator" {
  actor SysAdmin as SAFR003
}

rectangle "Client Dashboard" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR005: Manage Recommendation Preferences" as SAFR005
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  CFR001 --> CFR001
}

rectangle "Alerts and Notifications" {
  usecase "CFR002: View Anomalous Transactions Alerts" as CFR002
  usecase "SFR003: Deliver Alerts to Users" as SFR003
  
  CFR001 --> CFR002
}

rectangle "Investment and Financial Predictions" {
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "SAFR006: Request Investment Opportunity Analysis" as SAFR006
  usecase "SFR013: Generate Client Alerts based on Predefined Conditions" as SFR013
  
  CFR001 --> CFR007
}

rectangle "Recommendations and Insights" {
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR016: Generate Predictive Insights from the AI Component" as SFR016
  
  CFR001 --> CFR004
}

rectangle "Spending Limits and Budget Management" {
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "SFR005: Request Spending Limit Alerts from the AI Component" as SFR005
  
  CFR001 --> CFR006
}

rectangle "News and Information" {
  usecase "CFR008: View News Related to Investment Portfolio" as CFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  
  CFR001 --> CFR008
}

rectangle "System Management and Support" {
  usecase "SAFR002: Manage Analysis Parameters for the AI System" as SAFR002
  usecase "SFR020: Manage User Feedback to Continuously Improve Insights" as SFR020
  
  CFR001 --> SAFR002
}

rectangle "Financial Advisor Support" {
  usecase "FAFR003: View Predictive Analytics about Client Financial Situations" as FAFR003
  usecase "SFR015: Request Predictive Intervention Analyses from the AI Component" as SFR015
  
  CFR001 --> FAFR002
}

rectangle "AI System Functions" {
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  usecase "AIFR004: Generate Spending Limit Alerts for Users" as AIFR004
  
  CFR001 --> AIFR001
}

rectangle "Client Feedback and Improvement" {
  usecase "CFR11: Send Feedback about System Recommendations and Insights" as CFR11
  
  CFR001 --> CFR11
}
@enduml