@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FinancialAdvisor
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  
  Client --> (CFR001)
  SysAdmin --> (SAFR001)
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  
  FinancialAdvisor --> (FAFR001)
  FinancialAdvisor --> (FAFR002)
}

rectangle "Client Dashboard" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "SAFR005: Manage Recommendations Preferences" as SAFR005
  
  Client --> (CFR009)
  SysAdmin --> (SAFR005)
}

rectangle "Spending Limits and Alerts" {
  usecase "CFR010: View Spending Limit Alerts" as CFR010
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  
  Client --> (CFR010)
}

rectangle "Investment Opportunities and Recommendations" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FinancialAdvisor --> (FAFR004)
}

rectangle "News and Analytics" {
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  
  FinancialAdvisor --> (FAFR02)
}

rectangle "Feedback and Continuous Improvement" {
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights" as CFR011
}
@enduml