@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (SAFR005) : Manage Recommendation Preferences
  C --> (SFR020) : Send Feedback about Recommendations and Insights
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA

  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (SAFR005) : Manage Recommendation Preferences
  FA --> (SFR020) : Send Feedback about Recommendations and Insights
}

package "System Administrator" {
  actor SystemAdmin as SA

  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SA --> (SAFR005) : Manage Recommendation Preferences
  SA --> (SFR020) : Send Feedback about Recommendations and Insights
}

package "System" {
  rectangle System {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities from AI Component Matching User Criteria and ESG Preferences" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
    usecase "SFR010: Process Contextualized News for User's Financial Situations" as SFR010
    usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
    usecase "SFR012: Generate Client Dashboards with Intuitive and Actionable Format" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
    usecase "SFR014: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
    usecase "SFR016: Request Predictive Insights from AI Component to Enhance Value of Guidance Provided to Clients" as SFR016
    usecase "SFR017: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing" as SFR017
    usecase "SFR018: Manage User's Financial Goals Tracking Progress and Providing Relevant Recommendations" as SFR018
    usecase "SFR019: Maintain Historical Record of Users' Insights for Trend Analysis and Effectiveness Measurement" as SFR019
  }
}

package "AI System" {
  rectangle AI {
    usecase "AIFR001: Generate Financial Predictions Based on Data, Trends, and Indicators" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations for Users' Profiles, Goals, and Risk Tolerance" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Patterns" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users' Profiles, Time Horizons, and Goals" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on User Strategies and Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition in Compliance with FinCEN Requirements" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News with User Portfolios" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns Indicating Potential Issues or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support Planning" as AIFR009
  }
}

C --> (SFR012) : View Dashboards with Intuitive and Actionable Format
FA --> (SFR016) : Enhance Value of Guidance Provided to Clients Through Predictive Insights
SA --> (SFR017) : Generate Financial Health Reports Assessing Users' Overall Wellbeing

C --> (AIFR002) : Receive Personalized Recommendations Based on Profiles, Goals, and Risk Tolerance
FA --> (AIFR004) : Analyze Investments Against User's Time Horizons and Financial Goals
SA --> (SFR018) : Manage Users' Financial Goals Tracking Progress

C --> (SFR013) : Receive Alerts Based on Predefined Conditions for Critical Events
FA --> (SFR015) : Request Predictive Intervention Analyses to Engage Clients When Necessary
SA --> (SFR020) : Send Feedback about Recommendations and Insights to Improve Future Outputs

@enduml