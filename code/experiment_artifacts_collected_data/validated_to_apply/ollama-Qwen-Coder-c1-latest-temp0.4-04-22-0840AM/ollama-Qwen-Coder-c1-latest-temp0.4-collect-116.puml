@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

' Actors
actor Client as C
actor FinancialAdvisor as FA
actor SysAdmin as SA
actor User as U

' Packages
package "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
}

package "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
}

package "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
}

package "AI System" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Based on Strategies and MPT Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
}

package "System" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities from AI Component Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  usecase "SFR010: Process Contextualized News for User's Financial Situations" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
  usecase "SFR012: Generate Client Dashboards Presenting Financial Information Intuitively and Actionably" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI Component Identifying When Advisors Should Engage with Clients" as SFR015
  usecase "SFR016: Request Predictive Insights From the AI Component Enhancing Financial Guidance Provided to Clients" as SFR016
  usecase "SFR017: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Metrics" as SFR017
  usecase "SFR018: Manage Users' Financial Goals Tracking Progress and Providing Relevant Recommendations" as SFR018
  usecase "SFR019: Maintain Historical Record of Users' Insights for Trend Analysis and Effectiveness Measurement" as SFR019
  usecase "SFR020: Manage User Feedback to Continuously Improve System Outputs" as SFR020
}

package "Feedback Mechanism" {
  usecase "CFR11: Send Feedback about Recommendations and Insights" as CFR11
}

' Relationships
C --> (View Financial Insights Dashboard)
C --> (Receive Alerts for Anomalous Transactions)
C --> (View Financial Predictions)
C --> (Receive Personalized Recommendations)
C --> (Manage Recommendation Preferences)
C --> (View Spending Limit Alerts)
C --> (View Investment Opportunities)
C --> (View News Related to Portfolio)
C --> (Access Personalized Dashboard)
C --> (Manage Relationship with Financial Advisors)

FA --> (Manage Client Mentoring Sessions)
FA --> (View Client Intervention Alerts)
FA --> (View Predictive Analytics for Clients)
FA --> (Configure Analysis Parameters for Specific Segments)

SA --> SAFR001

AIFR001 --> SFR003
AIFR002 --> SFR004
AIFR003 --> SFR005
AIFR004 --> SFR006
AIFR005 --> SFR007
AIFR006 --> SFR008
AIFR007 --> SFR009
AIFR008 --> SFR013
AIFR009 --> SFR014

SFR002 --> U
SFR015 --> FA
SFR016 --> FA
SFR017 --> C
SFR018 --> C
SFR019 --> SA
SFR020 --> AIFR003, SFR004

CFR11 --> U
@enduml