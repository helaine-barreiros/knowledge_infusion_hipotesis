@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Segment" as FAFR004
  
  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SA --> SAFR001
}

rectangle "AI Component" {
  package "Financial Insights & Predictions" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    
    CFR003 <|-- (AIFR001)
    FAFR002 <|-- (AIFR001)
  }
  
  package "Personalized Recommendations" {
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    
    CFR004 <|-- (AIFR002)
    FAFR003 <|-- (AIFR002)
  }
  
  package "Spending Limit Alerts" {
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    
    CFR006 <|-- (AIFR003)
  }
  
  package "Investment Opportunities Analysis" {
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on Strategies" as AIFR005
    
    CFR007 <|-- (AIFR004)
  }
  
  package "Anomaly Transaction Alerts" {
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    
    CFR002 --> (AIFR006)
  }
  
  package "Contextualized News Insights" {
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "AIFR108: Request Client Predictive Intervention Recommendations" as AIFR108
    
    CFR008 <|-- (AIFR007)
  }
  
  package "Predictive Interventions & Insights" {
    usecase "AIFR109: Generate Predictive Insights for Financial Guidance" as AIFR109
    usecase "AIFR110: Request Client Analytics" as AIFR110
    
    FAFR002 <|-- (AIFR109)
  }
  
  package "Financial Health Reports" {
    usecase "AIFR111: Generate Financial Health Reports" as AIFR111
    usecase "SFR018: Manage Users' Financial Goals" as SFR018
    
    CFR017 <|-- (AIFR111)
  }
  
  package "Feedback Management" {
    usecase "SFR020: Manage User Feedback for Improvement" as SFR020
    
    CFR11 --> (SFR020)
  }
}

package "System Functions" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR007: Request Investment Opportunity Analysis from AI Component" as SFR007
  
  CFR003 --> (SFR001)
  CFR002 --> (SFR001)
  FAFR002 --> (SFR001)
}

C --> CFR11
FA --> FAFR11
SA --> SAFR001

@enduml