@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SystemAdmin as SA
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SA --> (SAFR001)
}

package "System Components" {
  rectangle "Alerts Management" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
  }
  
  rectangle "Recommendations Generation" {
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  }
  
  rectangle "Predictive Analytics" {
    usecase "SFR003: Request Financial Predictions from AI" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
    usecase "SFR016: Generate Client Predictive Insights" as SFR016
  }
  
  rectangle "Spending Limits Management" {
    usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
  }
  
  rectangle "Investment Opportunities Analysis" {
    usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
    usecase "SFR007: Generate Specific Investment Opportunities Matching User Criteria and ESG Preferences" as SFR007
  }
  
  rectangle "Anomaly Detection" {
    usecase "SFR008: Request Anomaly Transaction Alerts from AI" as SFR008
  }
  
  rectangle "News Management" {
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
    usecase "SFR10: Process Contextualized News for User's Financial Situations" as SFR10
    usecase "SFR11: Request Contextualized News Insights from AI" as SFR11
  }
  
  rectangle "Client Dashboards" {
    usecase "SFR12: Generate Client Dashboards Presenting Financial Information Intuitively and Actionably" as SFR12
  }
  
  rectangle "Financial Health Reports" {
    usecase "SFR17: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing" as SFR17
  }
}

package "AI System Components" {
  rectangle "Predictive Analysis" {
    usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
  }
  
  rectangle "Recommendations Generation" {
    usecase "AIFR002: Generate Personalized Recommendations Based on Financial Profiles, Goals, and Risk Tolerance" as AIFR002
  }
  
  rectangle "Investment Opportunities Analysis" {
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Matching User Investment Strategies and Modern Portfolio Theory Principles" as AIFR005
  }
  
  rectangle "Anomaly Detection" {
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
  }
  
  rectangle "News Insights Generation" {
    usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News with Specific User Portfolios" as AIFR007
  }
}

package "User Feedback Management" {
  usecase "CFR11: Send Feedback about System's Recommendations and Insights" as CFR11
  
  C --> (CFR11)
  FA --> (CFR11)
  SA --> (CFR11)
}
@enduml