@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

' Define actors
actor Client as CFR001
actor FinancialAdvisor as FAFR002
actor SysAdmin as SAFR003

package "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR010
  
  ' Relationships between Client and Use Cases
  CFR001 --> (View)
  CFR002 --> (Receive Alerts for Anomalous Transactions)
  CFR003 --> (View Predictions)
  CFR004 --> (Receive Recommendations)
  CFR005 --> (Manage Preferences)
  CFR006 --> (View Spending Limit Alerts)
  CFR007 --> (View Investment Opportunities)
  CFR008 --> (View News Related to Portfolio)
  CFR009 --> (Access Dashboard)
  CFR010 --> (Manage Relationship with Advisors)
}

package "Financial Advisor" {
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  ' Relationships between Financial Advisor and Use Cases
  FAFR002 --> (View Alerts)
  FAFR003 --> (View Predictive Analytics)
  FAFR004 --> (Configure Parameters)
}

package "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  
  ' Relationships between System Admin and Use Cases
  SAFR001 --> (Manage Parameters)
}

' Define system boundary
rectangle "AI-Powered Financial Insights System" {
  
    package "System Functions" {
      usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
      usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
      usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
      usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
      usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
      usecase "SFR007: Request Specific Investment Opportunities with ESG Preferences" as SFR007
      usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
      usecase "SFR009: Find Contextualized News Relevant to Users' Portfolios" as SFR009
      usecase "SFR010: Process Contextualized News for User Insights" as SFR010
      usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
      usecase "SFR012: Generate Client Dashboards with Financial Information" as SFR012
      usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
      usecase "SFR014: Generate Client Analytics for Insights into Behavior and Performance" as SFR014
      usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
      usecase "SFR016: Request Predictive Insights from AI Component to Enhance Financial Guidance" as SFR016
      usecase "SFR017: Generate Financial Health Reports Based on Ratios and Metrics" as SFR017
      usecase "SFR018: Manage Users' Financial Goals for Progress Tracking" as SFR018
      usecase "SFR019: Maintain Historical Record of User Insights for Trend Analysis" as SFR019
      usecase "SFR020: Manage User Feedback to Improve System Outputs" as SFR020
      
      ' Relationships between System and Use Cases
      CFR004 --> (Deliver Personalized Recommendations)
      
      SAFR003 <|-- (Request Financial Predictions from AI Component)
      FAFR001 <|-- (Request Personalized Recommendations from AI Component)
      CFR005 <|-- (Manage Preferences for Recommendations)
      CFR006 <|-- (Request Spending Limit Alerts from AI Component)
      
      SAFR003 --> (Generate Client Dashboards with Financial Information)
      SFR002 --> (Deliver Personalized Recommendations to Users)
      FAFR001 --> (Configure Analysis Parameters for Specific Segments)
    }
    
}

' Define relationships between actors and use cases
CFR004 --> (SFR002: Deliver Personalized Recommendations to Users)

FAFR003 <|-- (SFR009: Find Contextualized News Relevant to Users' Portfolios)

SAFR001 --> (SFR008: Request Anomaly Transaction Alerts from AI Component)
    
CFR011 --> (SFR020: Manage User Feedback to Improve System Outputs)

@enduml