@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

' Client actor
actor "Client" as Client

' Financial Advisor actor
actor "Financial Advisor" as FAdviser

' System Administrator actor
actor "System Admin" as SysAdmin

' User (general term) actor
actor "User" as User

rectangle "Clients and Advisors" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  Client --> (View Financial Insights Dashboard)
  Client --> (Receive Anomalous Transaction Alerts)
  Client --> (View Financial Predictions)
  Client --> (Receive Personalized Recommendations)
  Client --> (Manage Recommendation Preferences)
  Client --> (View Spending Limit Alerts)
  Client --> (View Investment Opportunities)
  Client --> (View News Related to Portfolio)
  Client --> (Access Personalized Dashboard)
  Client --> (Manage Relationship with Advisors)

  FAdviser --> (FAFR001: Manage Client Mentoring Sessions)
  FAdviser --> (FAFR002: View Client Intervention Alerts)
  FAdviser --> (FAFR003: View Predictive Analytics About Clients' Financial Situations)
  FAdviser --> (FAFR004: Configure Analysis Parameters for Specific Client Segments)

  SysAdmin --> (SAFR001: Manage Analysis Parameters)
}

rectangle "System" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities from AI Component Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  usecase "SFR010: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
  usecase "SFR012: Generate Client Dashboards in an Intuitive and Actionable Format" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
  usecase "SFR016: Request Predictive Insights From the AI Component to Enhance Value of Financial Guidance Provided to Clients" as SFR016
  usecase "SFR017: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Metrics and Ratios" as SFR017
  usecase "SFR018: Manage Users' Financial Goals Tracking Progress and Providing Relevant Recommendations" as SFR018
  usecase "SFR019: Maintain a Historical Record of Users' Insights for Trend Analysis and Effectiveness Measurement" as SFR019
  usecase "SFR020: Manage User Feedback to Continuously Improve System Outputs Accuracy and Relevance" as SFR020

  SysAdmin --> (Deliver Alerts to Users)
  SysAdmin --> (Deliver Personalized Recommendations)

  Client --> (Request Financial Predictions from AI Component)
  Client --> (Request Personalized Recommendations from AI Component)
  Client --> (Request Spending Limit Alerts from AI Component)
  Client --> (Request Investment Opportunity Analysis from AI Component Matching User Criteria and ESG Preferences)
  Client --> (Request Anomaly Transaction Alerts from AI Component)
  Client --> (Find Contextualized News Relevant to Users' Financial Portfolios)
  Client --> (Process Contextualized News to Extract Relevant Information for Users' Financial Situations)
  Client --> (Generate Client Dashboards in an Intuitive and Actionable Format)

  FAdviser --> (Request Predictive Intervention Analyses from AI Component)
  FAdviser --> (Request Predictive Insights From the AI Component to Enhance Value of Financial Guidance Provided to Clients)

  SysAdmin --> (Manage Users' Financial Goals Tracking Progress and Providing Relevant Recommendations)
}

User <|-- Client
User <|-- FAdviser
User <|-- SysAdmin

@enduml