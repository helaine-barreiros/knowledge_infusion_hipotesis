@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FinancialAdvisor
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR005: Manage Analysis Parameters Preferences" as SAFR005
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  
  Client --> (CFR001)
  SysAdmin --> (SAFR005)
}

rectangle "Financial Advisor System" {
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FinancialAdvisor --> (FAFR003)
  FinancialAdvisor --> (FAFR004)
}

rectangle "Notification System" {
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
  
  Sys --> (SFR012)
  Sys --> (SFR015)
}

rectangle "News System" {
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios" as AIFR007
  
  Sys --> (SFR009)
  Sys --> (AIFR007)
}

rectangle "AI System" {
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations Based on User Profiles and Goals" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users Based on Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities by Identifying Financial Instruments that Align with User Strategies and Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
  
  Sys --> (AIFR001)
  Sys --> (AIFR002)
  Sys --> (AIFR003)
  Sys --> (AIFR004)
  Sys --> (AIFR005)
  Sys --> (AIFR006)
}

rectangle "Feedback System" {
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights" as CFR11
  
  Client --> (CFR11)
}
@enduml