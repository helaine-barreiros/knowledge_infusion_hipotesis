@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFD002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009

  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> FAFD002
}

rectangle "Client Functions" {
  usecase "CFR002: View Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Current Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with Financial Profile and Goals" as CFR004
  usecase "CFR005: Manage Personalized Recommendations Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as CFR006
  usecase "CFR010: Manage Relationship with Financial Advisors, Including Permissions for Sharing My Financial Data" as CFR010

  Client --> CFR002
  Client --> CFR003
  Client --> CFR004
  Client --> CFR005
  Client --> CFR006
  Client --> CFR010
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFD001
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as FAFD003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFD004

  FAFD --> FAFD001
  FAFD --> FAFD003
  FAFD --> FAFD004
}

rectangle "System Functions" {
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002
  usecase "SFR005: Request Spending Limit Alerts from the AI Component When User Spending Patterns Exceed Defined Thresholds" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from the AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles" as SFR006
  usecase "SFR012: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as SFR012

  System --> SFR002
  System --> SFR005
  System --> SFR006
  System --> SFR012
}

rectangle "AI Functions" {
  usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
  usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004

  System --> AIFR001
  System --> AIFR003
  System --> AIFR004
}

rectangle "Feedback Loop" {
  usecase "CFR011: Send Feedback about the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as CFR011

  Client <-> CFR011
  SysAdmin <-> CFR011
  FAFD <-> CFR011
}

@enduml