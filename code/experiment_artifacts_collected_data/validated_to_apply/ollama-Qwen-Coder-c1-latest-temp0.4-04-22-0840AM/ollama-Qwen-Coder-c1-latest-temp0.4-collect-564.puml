@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SysAdmin as SA
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  
  SA --> (SAFR001)
}

rectangle "System Components" {
  package "AI Component" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on Strategies" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
    
    C --> (AIFR001)
    FA --> (AIFR002)
    SA --> (AIFR003)
    FA --> (AIFR004)
    FA --> (AIFR005)
    C --> (AIFR006)
    C --> (AIFR007)
    FAFR001 <|-- (FAFR008)
    AIFR009 <|-- (FAFR003)
  }
  
  package "Notification System" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    
    C --> (SFR001)
    FAFR002 <|-- (AIFR008)
    AIFR006 <|-- (FAFR003)
  }
  
  package "Recommendation System" {
    usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
    
    C --> (SFR002)
    FAFR001 <|-- (AIFR002)
    AIFR004 <|-- (FAFR003)
  }
  
  package "Prediction System" {
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR017: Generate Financial Health Reports" as SFR017
    
    C --> (SFR003)
    SA --> (SFR017)
  }
  
  package "Recommendation Request System" {
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    
    C --> (SFR004)
    FAFR003 <|-- (AIFR002)
  }
  
  package "Spending Limit Alert System" {
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    
    C --> (SFR005)
    AIFR003 <|-- (FAFR008)
  }
  
  package "Investment Opportunity Analysis System" {
    usecase "SFR006: Request Investment Opportunity Analyses from AI Component" as SFR006
    usecase "SFR015: Generate Predictive Intervention Recommendations for Advisors" as SFR015
    
    C --> (SFR006)
    FAFR003 <|-- (AIFR004)
  }
  
  package "ESG Investment Analysis System" {
    usecase "SFR007: Request Specific Investment Opportunities from AI Component that Match User Criteria and ESG Preferences" as SFR007
    
    C --> (SFR007)
    AIFR005 <|-- (FAFR014)
  }
  
  package "Anomaly Transaction Alert System" {
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    
    C --> (SFR008)
    AIFR006 <|-- (FAFR014)
  }
  
  package "News Retrieval and Processing System" {
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios from Trusted Sources" as SFR009
    usecase "SFR016: Generate Client Predictive Insights that Provide Forward-Looking Analysis of Financial Situations" as SFR016
    
    C --> (SFR009)
    FAFR003 <|-- (AIFR002)
  }
  
  package "Dashboard Generation System" {
    usecase "SFR12: Generate Client Dashboards that Present Financial Information in an Intuitive and Actionable Format" as SFR12
    
    C --> (SFR12)
    FAFR003 <|-- (AIFR002)
  }
  
  package "Feedback Management System" {
    usecase "CFR11: Send Feedback about the System's Recommendations and Insights to Improve Future Outputs" as CFR11
    
    C --> (CFR11)
  }
}

@enduml