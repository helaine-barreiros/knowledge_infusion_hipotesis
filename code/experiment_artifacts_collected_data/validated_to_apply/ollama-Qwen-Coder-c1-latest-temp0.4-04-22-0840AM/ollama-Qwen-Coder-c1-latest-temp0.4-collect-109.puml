@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client) as UserC
:User (Financial Advisor) as UserFA
:System Admin as SysAdmin
:AIFR001:AI System as AIFR001

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI" as SFR003
  usecase "AIFR004: Generate Personalized Recommendations for Users" as AIFR004
  
  UserC --> CFR001
  UserFA --> FAFR002
  SysAdmin --> SAFR001
}

rectangle "Client Dashboard" {
  usecase "CFR009: Access Consolidated Financial Information" as CFR009
  usecase "SFR12: Generate Client Dashboards" as SFR12
  
  UserC --> CFR009
  SysAdmin --> SFR12
}

rectangle "Alert System" {
  usecase "SFR013: Request Alerts from AI" as SFR013
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  
  UserC --> SFR013
  SysAdmin --> AIFR006
}

rectangle "Recommendation System" {
  usecase "SFR020: Manage Users' Financial Goals and Feedback" as SFR20
  usecase "AIFR005: Generate Investment Opportunity Analyses for Users" as AIFR005
  
  UserC --> SFR20
  SysAdmin --> AIFR005
}

rectangle "Investment System" {
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as FAFR003
  
  UserC --> CFR010
  SysAdmin --> AIFR005
}

rectangle "News System" {
  usecase "CFR008: View News Related to Investment Portfolio" as CFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  
  UserC --> CFR008
  SysAdmin --> SFR009
}

rectangle "Advisory System" {
  usecase "FAFR01: Manage Client Mentoring Sessions Based on Insights" as FAFR01
  usecase "SFR015: Request Predictive Intervention Analyses from AI" as SFR015
  
  UserFA --> FAFR01
  SysAdmin --> AIFR006
}

rectangle "AI System Operations" {
  usecase "AIFR002: Generate Personalized Recommendations for Users Based on Profiles and Goals" as AIFR002
  usecase "SFR03: Request Financial Predictions from AI" as SFR03
  
  SysAdmin --> AIFR001
}

rectangle "User Feedback System" {
  usecase "CFR11: Send Feedback about Recommendations and Insights to Improve Future Outputs" as CFR11
  
  UserC --> CFR11
}
@enduml