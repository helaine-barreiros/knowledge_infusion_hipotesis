@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FA

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Deliver Financial Predictions" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  User --> CFR001
  SysAdmin --> SAFR001
  FA --> FAFR002
  System Admin <|-- (SAFR001)
}

rectangle "Client Dashboard and Alerts" {
  usecase "CFR002: View Alerts about Anomalous Transactions" as CFR002
  usecase "SFR005: Deliver Spending Limit Alerts" as SFR005
  
  User --> CFR002
  System Admin <|-- (SAFR001)
}

rectangle "Financial Predictions and Recommendations" {
  usecase "CFR003: View Financial Predictions Based on Historical Data" as CFR003
  usecase "SFR007: Request Specific Investment Opportunities from AI Component" as SFR007
  
  User --> CFR003
  System Admin <|-- (SAFR001)
}

rectangle "Personalized Recommendations and Preferences Management" {
  usecase "CFR004: Receive Personalized Recommendations Aligned with Financial Profile and Goals" as CFR004
  usecase "CFR005: Manage Personalized Recommendations Preferences Based on KYC Profile" as CFR005
  
  User --> CFR004
  User --> CFR005
}

rectangle "Investment Opportunities and News" {
  usecase "CFR007: View Investment Opportunities Suitable to Risk Profile" as CFR007
  usecase "CFR008: View News Related to Investment Portfolio" as CFR008
  
  User --> CFR007
  User --> CFR008
}

rectangle "Client Relationship Management" {
  usecase "CFR10: Manage Client Relationships with Financial Advisors" as CFR10
  
  User --> CFR10
}

rectangle "Feedback and Continuous Improvement" {
  usecase "AIFR009: Generate Predictive Insights for Clients" as AIFR009
  usecase "SFR20: Manage Users' Feedback to Improve System Outputs" as SFR20
  
  User --> AIFR009
  SysAdmin <|-- (SAFR001)
}

@enduml