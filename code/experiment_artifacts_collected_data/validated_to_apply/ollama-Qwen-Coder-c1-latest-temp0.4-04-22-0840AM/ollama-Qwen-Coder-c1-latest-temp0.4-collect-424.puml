@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: View News Related to Investment Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  Client --> (SFR02)
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as FAFR003
  
  FinancialAdvisor --> (SFR06)
}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  SystemAdmin --> (AIFR02)
}

package "AI Component" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Based on Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  System --> (AIFR01)
}

rectangle "System" {
  usecase "SFR03: Request Financial Predictions from AI Component" as SFR03
  usecase "SFR04: Request Personalized Recommendations from AI Component" as SFR04
  usecase "SFR05: Request Spending Limit Alerts from AI Component" as SFR05
  usecase "SFR06: Request Investment Opportunity Analysis from AI Component" as SFR06
  usecase "SFR07: Request Specific Investment Opportunities Based on User Criteria and ESG Preferences" as SFR07
  usecase "SFR08: Request Anomaly Transaction Alerts from AI Component" as SFR08
  usecase "SFR09: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR09
  usecase "SFR10: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR10
  usecase "SFR11: Request Contextualized News Insights from AI Component" as SFR11
  usecase "SFR12: Generate Client Dashboards in an Intuitive and Actionable Format" as SFR12
  usecase "SFR13: Generate Client Alerts Based on Predefined Conditions" as SFR13
  usecase "SFR14: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR14
  usecase "SFR15: Request Predictive Intervention Analyses from AI Component" as SFR15
  usecase "SFR16: Request Predictive Insights from AI Component to Enhance Value of Financial Guidance Provided to Clients" as SFR16
  usecase "SFR17: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Metrics" as SFR17
  usecase "SFR18: Manage Users' Financial Goals Tracking Progress and Providing Relevant Recommendations" as SFR18
  usecase "SFR19: Maintain Historical Record of Users' Insights for Trend Analysis and Effectiveness Measurement" as SFR19
  usecase "SFR20: Manage User Feedback to Continuously Improve System Outputs" as SFR20
  
  Client --> (SFR03)
  FinancialAdvisor --> (SFR06)
  SystemAdmin --> (SAFR001)
}

rectangle "Notifications and Alerts" {
  usecase "SFR01: Deliver Alerts to Users Through Appropriate Notification Channels" as SFR01
  usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
  
  Client --> (SFR01)
}

rectangle "Personalized Recommendations and Insights" {
  usecase "SFR02: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR02
  usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance as Defined by Industry Standards like FINRA Guidelines" as AIFR002
  
  Client --> (SFR02)
}

rectangle "Contextualized News and Insights" {
  usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
  usecase "SFR10: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR10
  
  Client --> (AIFR007)
}

rectangle "Predictive Interventions and Insights" {
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  usecase "SFR15: Request Predictive Intervention Analyses from AI Component" as SFR15
  
  Client --> (AIFR008)
}

rectangle "Financial Health and Analytics" {
  usecase "AIFR009: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009
  usecase "SFR14: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR14
  
  Client --> (AIFR009)
}

rectangle "Feedback Management" {
  usecase "CFR11: Send Feedback About System's Recommendations and Insights to Help Improve Accuracy and Relevance of Future Outputs" as CFR11
  usecase "SFR20: Manage User Feedback to Continuously Improve System Outputs" as SFR20
  
  Client --> (SFR20)
}

@enduml