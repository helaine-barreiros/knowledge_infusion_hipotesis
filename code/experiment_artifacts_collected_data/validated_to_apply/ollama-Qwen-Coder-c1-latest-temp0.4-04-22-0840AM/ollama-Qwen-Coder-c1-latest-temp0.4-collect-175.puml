@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (SAFR001)
  
  C --> CFR001 : "View"
  C --> CFR002 : "Alerts"
  C --> CFR003 : "Predictions"
  C --> CFR004 : "Recommendations"
  C --> CFR005 : "Manage Preferences"
  C --> CFR006 : "Spending Alerts"
  C --> CFR007 : "Investment Opportunities"
  C --> CFR008 : "News"
  C --> CFR009 : "Dashboard"
  C --> CFR10 : "Relationship Management"
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (SAFR001)
  
  FA --> FAFR001 : "Manage Sessions"
  FA --> FAFR002 : "Intervention Alerts"
  FA --> FAFR003 : "Predictive Analytics"
  FA --> FAFR004 : "Configure Parameters"
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR020: Manage User Feedback" as SFR020
  
  SA --> (SAFR001)
  
  SA --> SAFR001 : "Manage"
  SA --> SFR020 : "Feedback Management"
}

package "System Components" {
  rectangle System as Sys
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities from AI Component" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  usecase "SFR010: Process Contextualized News to Extract Information for Users' Financial Situations" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
  usecase "SFR012: Generate Client Dashboards in an Intuitive Format" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics Providing Meaningful Insights" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
  usecase "SFR016: Request Predictive Insights from AI Component to Enhance Financial Guidance" as SFR016
  usecase "SFR017: Generate Financial Health Reports Assessing Users' Wellbeing" as SFR017
  usecase "SFR018: Manage Users' Financial Goals and Track Progress" as SFR018
  usecase "SFR019: Maintain Historical Record of Insights for Trend Analysis" as SFR019
  
  Sys --> (SAFR001)
  
  Sys --> SFR001 : "Deliver Alerts"
  Sys --> SFR002 : "Personalized Recommendations"
  Sys --> SFR003 : "Financial Predictions"
  Sys --> SFR004 : "Recommendations"
  Sys --> SFR005 : "Spending Limit Alerts"
  Sys --> SFR006 : "Investment Opportunity Analysis"
  Sys --> SFR007 : "Specific Investment Opportunities"
  Sys --> SFR008 : "Anomaly Transaction Alerts"
  Sys --> SFR009 : "Contextualized News"
  Sys --> SFR010 : "Process News"
  Sys --> SFR011 : "News Insights"
  Sys --> SFR012 : "Dashboards"
  Sys --> SFR013 : "Client Alerts"
  Sys --> SFR014 : "Analytics"
  Sys --> SFR015 : "Predictive Interventions"
  Sys --> SFR016 : "Enhanced Insights"
  Sys --> SFR017 : "Financial Health Reports"
  Sys --> SFR018 : "Goals and Progress Management"
  Sys --> SFR019 : "Historical Record Maintenance"
}

package "AI System" {
  rectangle AI as A
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Based on Strategies and MPT Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights for Forward-Looking Analysis" as AIFR009
  
  Sys --> (AI)
  
  AI --> SFR003 : "Generate Predictions"
  AI --> SFR004 : "Recommendations"
  AI --> SFR005 : "Spending Alerts"
  AI --> SFR006 : "Investment Analysis"
  AI --> SFR007 : "News Insights"
  AI --> SFR013 : "Intervention Recommendations"
  AI --> SFR014 : "Predictive Insights"
}

package "User (Client, Financial Advisor, or System Administrator)" {
  actor User as U
  
  usecase "CFR11: Send Feedback" as CFR11
  
  U --> Sys
  U --> CFR11 : "Send Feedback"
}
@enduml