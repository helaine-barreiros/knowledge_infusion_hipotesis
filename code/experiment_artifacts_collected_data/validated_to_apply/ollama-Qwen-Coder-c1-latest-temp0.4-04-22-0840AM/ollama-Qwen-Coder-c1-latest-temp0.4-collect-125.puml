@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR003: View Financial Predictions" as SFR004
  usecase "CFR004: Receive Personalized Recommendations" as SFR005
  usecase "CFR005: Manage Recommendation Preferences" as SAFR012
  usecase "CFR006: View Spending Limit Alerts" as SFR008
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as AIFR004
  usecase "CFR008: View News Related to My Investment Portfolio" as AIFR012
  usecase "CFR009: Access Personalized Dashboard" as SFR017
  usecase "CFR10: Manage Relationship with Financial Advisors" as SAFR013
  
  CFR001 --> (SAFR003)
  CFR001 --> (SFR004)
  CFR001 --> (SFR005)
  CFR001 --> (SAFR012)
  CFR001 --> (SFR008)
  CFR001 --> (AIFR004)
  CFR001 --> (AIFR012)
  CFR001 --> (SFR017)
  CFR001 --> (SAFR013)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts" as SFR009
  usecase "FAFR003: View Predictive Analytics about My Clients' Financial Situations" as AIFR016
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as SAFR020
  
  FAFR001 --> (SFR009)
  FAFR001 --> (AIFR016)
  FAFR001 --> (SAFR020)
}

package "System Administrator" {
  actor SystemAdmin as SAFR001
  
  usecase "SAFR001: Manage Analysis Parameters for the AI System" as SFR003
  usecase "SFR007: Request Specific Investment Opportunities from the AI Component that Match User Investment Criteria and ESG Preferences" as AIFR005
  
  SAFR001 --> (SFR003)
  SAFR001 --> (AIFR005)
}

package "System" {
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002
  usecase "SFR006: Request Investment Opportunity Analysis from the AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles" as AIFR014
  
  System --> (SFR002)
  System --> (AIFR014)
}

package "AI System" {
  usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance as Defined by Industry Standards like FINRA Guidelines" as AIFR002
  
  System --> (AIFR001)
  System --> (AIFR002)
}

package "User Feedback Management" {
  usecase "CFR11: Send Feedback about the System's Recommendations and Insights to Help Improve Future Outputs" as SFR025
}
@enduml