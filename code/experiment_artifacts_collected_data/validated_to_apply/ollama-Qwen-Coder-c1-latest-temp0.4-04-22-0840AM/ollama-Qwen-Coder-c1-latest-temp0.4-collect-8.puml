@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FinancialAdvisor
:User: as User

package "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  Client --> CFR001
  Client --> SAFR001
  Client --> FAFR003
  Client --> SFR002
  Client --> AIFR002
}

package "Client Management" {
  usecase "CFR005: Manage Personalized Recommendations Preferences" as CFR005
  
  User --> CFR005
}

package "Financial Advisor Activities" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
  
  FinancialAdvisor --> FAFR001
  FinancialAdvisor --> FAFR002
  FinancialAdvisor --> SFR015
}

package "Notifications and Alerts" {
  usecase "SFR003: Request Anomaly Transaction Alerts from AI Component" as SFR003
  usecase "SFR004: Request Spending Limit Alerts from AI Component" as SFR004
  
  User --> SFR003
  User --> SFR004
}

package "Investment Opportunities and News" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  
  User --> CFR007
  User --> CFR008
}

package "System Feedback Management" {
  usecase "CFR11: Send Feedback about System's Recommendations and Insights" as CFR11
  
  User --> CFR11
}
@enduml