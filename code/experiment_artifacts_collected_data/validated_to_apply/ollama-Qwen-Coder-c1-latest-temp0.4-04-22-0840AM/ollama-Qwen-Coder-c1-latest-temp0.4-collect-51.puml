@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
  
  usecase "CFR11: Send Feedback" as CFR11 <|-- (C)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Segments" as FAFR004
  
  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004
  
  usecase "CFR11: Send Feedback" as CFR11 <|-- (FA)
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  SA --> SAFR001
  
  usecase "CFR11: Send Feedback" as CFR11 <|-- (SA)
}

package "System" {
  rectangle "Financial Insights System" {
    usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities Matching User Criteria and ESG Preferences" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
    usecase "SFR010: Process Contextualized News to Extract Information for Users' Financial Situations" as SFR010
    usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
    usecase "SFR012: Generate Client Dashboards in Intuitive Format" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
    usecase "SFR014: Generate Client Analytics for Meaningful Insights" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
    usecase "SFR016: Request Predictive Insights From AI Component to Enhance Financial Guidance" as SFR016
    usecase "SFR017: Generate Financial Health Reports Assessing Users' Wellbeing" as SFR017
    usecase "SFR018: Manage Users' Financial Goals for Progress Tracking and Recommendations" as SFR018
    usecase "SFR019: Maintain Historical Record of Insights for Trend Analysis" as SFR019
    usecase "SFR020: Manage User Feedback to Improve System Outputs" as SFR020
    
    C --> SFR002
    FA --> SFR003
    SA --> SFR004
  }
}

package "AI Component" {
  rectangle "Artificial Intelligence Module" {
    usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations Based on Profiles and Goals" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users Matching Risk Profiles, Time Horizons and Goals" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on User Strategies and MPT Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts Using Pattern Recognition in Compliance with FinCEN Requirements" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News With User Portfolios" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations Based on Patterns Indicating Potential Issues or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support Planning" as AIFR009
    
    SFR003 --> (AIFR001)
    SFR004 --> (AIFR002)
    SFR005 --> (AIFR003)
    SFR006 --> (AIFR004)
    SFR007 --> (AIFR005)
    SFR008 --> (AIFR006)
    SFR012 --> (AIFR007)
  }
}

@enduml