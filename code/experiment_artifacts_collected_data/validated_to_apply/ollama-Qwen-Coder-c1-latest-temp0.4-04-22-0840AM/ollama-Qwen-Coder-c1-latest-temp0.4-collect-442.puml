@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001_Client
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Get Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Receive Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access Financial News" as CFR008
  usecase "CFR009: Manage Relationship with Advisors" as CFR010
  
  CFR001_Client --> CFR001
  CFR001_Client --> CFR002
  CFR001_Client --> CFR003
  CFR001_Client --> CFR004
  CFR001_Client --> CFR005
  CFR001_Client --> CFR006
  CFR001_Client --> CFR007
  CFR001_Client --> CFR008
  CFR001_Client --> CFR010
  
  'rectangle "Client System" {
    usecase "SFR012: Generate Client Dashboards" as SFR012
    usecase "SFR013: Generate Client Alerts" as SFR013
    
    CFR001_Client --> SFR012
    CFR001_Client --> SFR013
  }
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR001_Advisor
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  
  FAFR001_Advisor --> FAFR001
  FAFR001_Advisor --> FAFR002
  FAFR001_Advisor --> FAFR003
  
  'rectangle "Financial Advisor System" {
    usecase "SFR015: Generate Predictive Intervention Analyses" as SFR015
    
    FAFR001_Advisor --> SFR015
  }
}

package SystemAdmin {
  actor "System Administrator" as SAFR001_Admin
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SAFR001_Admin --> SAFR001
  
  'rectangle "System Admin System" {
    usecase "SFR020: Manage User Feedback" as SFR020
    
    SAFR001_Admin --> SFR020
  }
}

package AIComponent {
  actor "AI System" as AIFR001_System
  
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Based on Modern Portfolio Theory" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  'rectangle "AI System Component" {
    usecase "SFR014: Generate Analytics" as SFR014
    
    AIFR001_System --> SFR014
  }
}

package UserFeedback {
  actor "User (Client, Financial Advisor, or System Administrator)" as CFR011_User
  
  usecase "CFR011: Send Feedback about Recommendations and Insights" as CFR011
  
  CFR011_User --> CFR011
}
@enduml