@startuml "AI-Powered Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Use Cases"

actor "Individual Customer" as user [#CUSTOMER_COLOR]
actor "Financial Advisor" as advisor [#CUSTOMER_COLOR]

package "Authentication & Security" {
    usecase "UC01: Authenticate User" as UC01
    note right of UC01
      **Req. ID:** FR01, NFR06
      **Description:** Allows users to authenticate via 
      username/password or OAuth2 providers, with 
      optional multi-factor authentication.
    end note
    
    usecase "UC02: Manage Account Settings" as UC02
}

package "Financial Management & Aggregation" {
    usecase "UC03: Connect Financial Accounts" as UC03
    usecase "UC04: View Transactions" as UC04
    usecase "UC05: Categorize Transactions" as UC05
    
    UC03 ..> UC04 : <<include>>
    UC04 ..> UC05 : <<extend>>
}

package "Analysis & Recommendations" {
    usecase "UC06: View Financial Dashboard" as UC06
    usecase "UC07: Receive AI Insights" as UC07
    
    usecase "UC08: Generate Personalized Reports" as UC08
    usecase "UC09: Forecast Future Positions" as UC09
    UC09 --|> UC08
    
    usecase "UC10: Suggest Investment Opportunities" as UC10
}

package "Planning & Budgeting" {
    usecase "UC11: Set Financial Goals" as UC11
    usecase "UC12: Track Spending Patterns" as UC12
    usecase "UC13: Create and Monitor Budgets" as UC13
    
    UC12 ..> UC14 : <<extend>>
}

package "Collaboration & Sharing" {
    usecase "UC15: Share Financial Data with Advisors" as UC15
    usecase "UC16: Access Shared Customer Data" as UC16
}

package "AI-Powered Assistance" {
    usecase "UC17: Use Chatbot for Queries" as UC17
    usecase "UC18: Provide Explanations and Reasoning" as UC18
    
    UC09 ..> UC18 : <<include>>
}

package "Notifications & Alerts" {
    usecase "UC19: Receive Financial Notifications" as UC19
    usecase "UC20: Get Alerts for Unusual Spending Patterns" as UC20
    
    UC04 ..> UC19 : <<extend>>
}

package "Compliance & Security" {
    usecase "UC21: Maintain Audit Trail of Data Access" as UC21
    usecase "UC22: Secure Financial Data with Encryption" as UC22
    note right of UC22
      **Req. ID:** NFR02, NFR06
      **Description:** Ensures all financial data is 
      encrypted at rest and in transit to comply 
      with GDPR and PSD2 regulations.
    end note
    
    usecase "UC23: Comply with Financial Regulations" as UC23
}

' CROSS-PACKAGE RELATIONSHIPS

user --> UC01
user --> UC03
user --> UC06
advisor --> UC15
bank --> UC03
investment_api --> UC10
ai_engine --> UC07,UC18
news_service --> UC24 : <<include>>

@enduml