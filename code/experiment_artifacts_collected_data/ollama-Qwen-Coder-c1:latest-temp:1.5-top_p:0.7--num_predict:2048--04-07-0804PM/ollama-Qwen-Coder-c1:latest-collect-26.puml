@startuml "AI-Powered Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Use Cases"

actor "Individual Customer" as user
actor "Financial Advisor" as advisor

package "Authentication & Security" {
    usecase "UC01: Authenticate User" as UC01 <<include>>
    note right of UC01
      **Req. ID:** FR01, NFR06
      **Description:** Allows users to authenticate via 
      username/password or OAuth2 providers.
    end note
    
    usecase "UC02: Manage Account Settings" as UC02
}

package "Financial Data Management" {
    usecase "UC03: Connect Financial Accounts" as UC03 <<include>>
    
    note right of UC03
      **Req. ID:** FR02
      **Description:** Securely links external financial accounts 
      using banking APIs to retrieve transaction data.
    end note
    
    usecase "UC04: View Transactions" as UC04 <<extend>> UC05
    usecase "UC05: Categorize Transactions" as UC05
    
    UC03 ..> UC04 : <<include>>
}

package "Analysis & Insights" {
    usecase "UC06: Generate Financial Reports" as UC06
    usecase "UC07: Receive AI Recommendations" as UC07
    note right of UC07
      **Req. ID:** FR05, FR06
      **Description:** Provides personalized financial recommendations 
      based on spending habits and market analysis.
    end note
    
    usecase "UC08: Analyze Investment Opportunities" as UC08 <<include>> UC09
    usecase "UC09: Suggest Specific Investments" as UC09
    
    UC06 ..> UC04 : <<extend>>
}

package "Budget & Goal Management" {
    usecase "UC10: Set Financial Goals" as UC10
    usecase "UC11: Track Budgets and Spending" as UC11
    note right of UC11
      **Req. ID:** FR07, FR08
      **Description:** Allows users to create budgets 
      and track their spending against those goals.
    end note
    
    UC10 ..> UC11 : <<include>>
}

package "Notifications & Alerts" {
    usecase "UC12: Receive Financial Alerts" as UC12
    usecase "UC13: Monitor Unusual Spending Patterns" as UC13
    note right of UC13
      **Req. ID:** FR09, NFR04
      **Description:** Delivers alerts for unusual spending patterns 
      and responds to user interactions within 1 second.
    end note
    
    UC12 ..> UC04 : <<extend>>
}

package "Forecasting & Planning" {
    usecase "UC14: Forecast Future Financial Positions" as UC14
    usecase "UC15: Plan for Retirement and Investments" as UC15
    note right of UC15
      **Req. ID:** FR10, NFR03
      **Description:** Provides forecasts based on historical data 
      to help users plan their financial future.
    end note
    
    UC14 ..> UC04 : <<extend>>
}

package "Debt Management" {
    usecase "UC16: Manage Debt and Repayments" as UC16
    usecase "UC17: Simulate Repayment Strategies" as UC17
    note right of UC17
      **Req. ID:** FR12, NFR03
      **Description:** Suggests debt management strategies with 
      repayment simulations to help users manage their debts.
    end note
    
    UC16 ..> UC04 : <<extend>>
}

package "Collaboration & Sharing" {
    usecase "UC18: Share Financial Data with Advisors" as UC18
    usecase "UC19: Access Shared Customer Data" as UC19
    note right of UC19
      **Req. ID:** FR13, NFR06
      **Description:** Allows users to share selected financial data 
      with financial advisors for personalized advice.
    end note
    
    advisor --> UC18
}

package "AI & Machine Learning" {
    usecase "UC20: Analyze Market Trends and News" as UC20 <<include>> UC21
    usecase "UC21: Provide Predictive Analytics" as UC21
    
    UC07 ..> UC20 : <<extend>>
}

package "User Interface & Experience" {
    usecase "UC22: Access Dashboards and Reports" as UC22
    note right of UC22
      **Req. ID:** FR14, NFR08
      **Description:** Provides a user-friendly interface with 
      customizable dashboards and reports for different users.
    end note
    
    usecase "UC23: Use Chatbot for Financial Queries" as UC23 <<include>> UC24
    usecase "UC24: Generate Periodic Reports" as UC24
    
    advisor --> UC23
}

package "Compliance & Security" {
    usecase "UC25: Ensure Data Compliance and Encryption" as UC25
    note right of UC25
      **Req. ID:** NFR01, NFR02
      **Description:** Ensures all financial data is compliant with 
      regulations such as GDPR and PSD2, while maintaining encryption at rest.
    end note
    
    usecase "UC26: Audit Data Access" as UC26 <<include>> UC27
    usecase "UC27: Maintain Compliance Logs" as UC27
    
    advisor --> UC25
}

user --> UC01
user --> UC03
user --> UC04
user --> UC08
user --> UC10
user --> UC12
user --> UC16
user --> UC19

advisor --> UC18
advisor --> UC23

bank --> UC03

invest --> UC20

ai --> UC07
ai --> UC21

@enduml