@startuml "AI-Powered Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Use Cases"

' ACTOR DEFINITION
actor "Individual Customer" as user
actor "Financial Advisor" as advisor
actor "Banking API" as bank_api #lightblue
actor "Investment API" as invest_api #lightblue
actor "Credit Scoring Service" as credit_service #lightgreen

' PACKAGE DEFINITION
package "Authentication & Security" {
    usecase "UC01: Authenticate User" as UC01 <<include>>
    
    note right of UC01
      **Req. ID:** FR01, NFR06
      **Description:** Allows users to authenticate via 
      username/password or OAuth2 providers.
    end note
    
    usecase "UC02: Manage Account Settings" as UC02 <<include>>
}

package "Financial Data Management" {
    usecase "UC03: Connect Financial Accounts" as UC03
    usecase "UC04: View Transactions" as UC04 <<extend>>
    
    note right of UC03
      **Req. ID:** FR02, NFR10
      **Description:** Securely links external financial accounts 
      using banking APIs to retrieve transaction data.
    end note
    
    usecase "UC05: Categorize Transactions" as UC05 <<extend>>
    
    UC03 ..> UC04 : <<include>>
}

package "Analysis & Recommendations" {
    usecase "UC06: View Financial Dashboard" as UC06
    usecase "UC07: Receive AI Insights" as UC07
    
    note right of UC07
      **Req. ID:** FR05, NFR12
      **Description:** Provides advanced financial analysis and personalized recommendations.
    end note
    
    usecase "UC08: Generate Recommendations" as UC08 <<include>>
    
    UC06 ..> UC04 : <<include>>
}

package "Budgeting & Goal Setting" {
    usecase "UC09: Set Financial Goals" as UC09
    usecase "UC10: Track Budgets and Progress" as UC10
    
    note right of UC09
      **Req. ID:** FR07, NFR08
      **Description:** Allows users to set financial goals and track budget progress.
    end note
}

package "Forecasting & Planning" {
    usecase "UC11: Forecast Future Financial Positions" as UC11
    usecase "UC12: Create Investment Strategies" as UC12
    
    note right of UC11
      **Req. ID:** FR08, NFR09
      **Description:** Forecasts future financial positions and suggests investment opportunities.
    end note
    
    UC11 ..> UC12 : <<include>>
}

package "Debt Management" {
    usecase "UC13: Manage Debt Repayment" as UC13
    usecase "UC14: Simulate Repayment Plans" as UC14
    
    note right of UC13
      **Req. ID:** FR09, NFR12
      **Description:** Provides debt management strategies with repayment simulations.
    end note
}

package "Collaboration & Sharing" {
    usecase "UC15: Share Financial Data" as UC15
    
    note right of UC15
      **Req. ID:** FR13, NFR06
      **Description:** Allows users to share selected financial data with financial advisors.
    end note
}

package "AI Components & Insights" {
    usecase "UC16: Use AI Reasoning Engine" as UC16
    
    note right of UC16
      **Req. ID:** FR05, NFR12
      **Description:** Leverages the AI reasoning engine for advanced financial analysis and personalized recommendations.
    end note
}

package "Additional Features & Tools" {
    usecase "UC17: Provide Chatbot Support" as UC17 <<include>>
    
    note right of UC17
      **Req. ID:** FR14, NFR06
      **Description:** Offers a chatbot for financial queries.
    end note
    
    usecase "UC18: Generate Financial Health Reports" as UC18 <<extend>>
    
    note right of UC18
      **Req. ID:** FR15, NFR07
      **Description:** Generates periodic financial health reports and dashboards.
    end note
    
    UC16 ..> UC17 : <<include>>
}

' CROSS-PACKAGE RELATIONSHIPS
user --> UC03
user --> UC04
user --> UC08
advisor --> UC12
bank_api --> UC03
invest_api --> UC12

@enduml