@startuml "AI-Powered Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Use Cases"

actor "Individual Customer" as user
actor "Financial Advisor" as advisor

package "Authentication & Security" {
    usecase "UC01: Authenticate User" as UC01 <<include>>
    note right of UC01
      **Req. ID:** FR01, NFR06
      Allows users to authenticate via username/password or OAuth2 providers with optional multi-factor authentication.
    end note
    
    usecase "UC02: Manage Account Settings" as UC02 <<extend>>
}

package "Financial Management & Aggregation" {
    usecase "UC03: Connect Financial Accounts" as UC03
    note right of UC03
      **Req. ID:** FR02, NFR18
      Securely links external financial accounts using banking APIs to retrieve transaction data.
    end note
    
    usecase "UC04: View Transactions" as UC04 <<include>>
    
    usecase "UC05: Categorize Transactions" as UC05 <<extend>>

    UC03 ..> UC04 : <<include>>
    UC04 ..> UC05 : <<extend>>
}

package "Analysis & Recommendations" {
    usecase "UC06: View Financial Dashboard" as UC06
    note right of UC06
      **Req. ID:** FR04, NFR12
      Provides a visual representation of spending patterns and financial history.
    end note
    
    usecase "UC07: Receive AI Insights" as UC07 <<include>>
    
    usecase "UC08: Generate Recommendations" as UC08 <<extend>>

    UC06 ..> UC04 : <<include>>
    UC07 ..> UC08 : <<extend>>
}

package "Budgeting & Goal Tracking" {
    usecase "UC09: Set Financial Goals" as UC09
    note right of UC09
      **Req. ID:** FR07, NFR12
      Allows users to set and track financial goals.
    end note
    
    usecase "UC10: Monitor Budgets" as UC10 <<extend>>

    UC09 ..> UC10 : <<include>>
}

package "Planning & Forecasting" {
    usecase "UC11: Create Budget Plans" as UC11
    note right of UC11
      **Req. ID:** FR08, NFR24
      Provides tools for budget creation and monitoring.
    end note
    
    usecase "UC12: Forecast Financial Positions" as UC12 <<extend>>

    UC11 ..> UC12 : <<include>>
}

package "Investment & Risk Management" {
    usecase "UC13: Suggest Investment Opportunities" as UC13
    note right of UC13
      **Req. ID:** FR11, NFR09
      Provides investment recommendations based on user profiles.
    end note
    
    usecase "UC14: Manage Debt Strategies" as UC14 <<extend>>

    UC13 ..> UC14 : <<include>>
}

package "Collaboration & Sharing" {
    usecase "UC15: Share Financial Data with Advisors" as UC15
    note right of UC15
      **Req. ID:** FR13, NFR09
      Allows users to share selected financial data with advisors.
    end note
    
    usecase "UC16: Access Collaborative Dashboards" as UC16 <<extend>>

    UC15 ..> UC16 : <<include>>
}

package "AI Components & Explanations" {
    usecase "UC17: Utilize AI for Advanced Analysis" as UC17
    note right of UC17
      **Req. ID:** FR05, NFR09
      Leverages AI for advanced financial analysis and personalized recommendations.
    end note
    
    usecase "UC18: Explain AI Recommendations" as UC18 <<extend>>

    UC17 ..> UC18 : <<include>>
}

package "Chatbot & Support" {
    usecase "UC19: Interact with Chatbot for Queries" as UC19
    note right of UC19
      **Req. ID:** FR14, NFR26
      Provides a chatbot for financial queries and support.
    end note
    
    usecase "UC20: Submit Support Tickets" as UC20 <<extend>>

    UC19 ..> UC20 : <<include>>
}

user --> UC01
user --> UC03
user --> UC06
user --> UC07
user --> UC08
user --> UC09
user --> UC11
user --> UC15

advisor --> UC09
advisor --> UC14
advisor --> UC16
advisor --> UC20

bank --> UC03
invest --> UC13
ai --> UC07
ai --> UC18

@enduml