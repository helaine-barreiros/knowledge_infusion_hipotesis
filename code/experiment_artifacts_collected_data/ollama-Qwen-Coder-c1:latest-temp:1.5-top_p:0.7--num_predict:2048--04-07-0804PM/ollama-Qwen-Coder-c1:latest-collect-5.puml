@startuml "AI-Powered Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Use Cases"

actor "Individual Customer" as user
actor "Financial Advisor" as advisor
actor "Banking API Service" as banking_api #lightblue
actor "Investment API Service" as investment_api #lightblue
actor "Credit Scoring Service" as credit_service #lightgreen
actor "News Service" as news_service #lightgrey
actor "AI Reasoning Engine" as ai_engine #lightyellow

package "Authentication & Security" {
    usecase "UC01: Authenticate User" as UC01 <<include>>
    note right of UC01
      **Req. ID:** FR01, NFR06
      Allows users to authenticate via username/password or OAuth2 providers with optional multi-factor authentication.
    end note
    
    usecase "UC02: Manage Account Settings" as UC02 <<extend>>
}

package "Financial Data Management" {
    usecase "UC03: Connect Financial Accounts" as UC03
    note right of UC03
      **Req. ID:** FR02, NFR04
      Securely links external financial accounts using banking APIs to retrieve transaction data.
    end note
    
    usecase "UC04: View Transactions" as UC04 <<include>>
    
    usecase "UC05: Categorize Transactions" as UC05
}

package "Analysis & Recommendations" {
    usecase "UC06: Generate Insights" as UC06
    note right of UC06
      **Req. ID:** FR05, NFR12
      Uses AI to generate insights on spending habits and provide personalized financial recommendations.
    end note
    
    usecase "UC07: Set Financial Goals" as UC07 <<include>>
    
    usecase "UC08: Track Budgets & Monitor Progress" as UC08
}

package "Forecasting & Planning" {
    usecase "UC09: Forecast Future Positions" as UC09
    note right of UC09
      **Req. ID:** FR10, NFR03
      Forecasts future financial positions based on historical data and AI predictions.
    end note
    
    usecase "UC10: Suggest Investment Opportunities" as UC10 <<include>>
    
    usecase "UC11: Manage Debt & Simulate Repayment" as UC11
}

package "Collaboration & Sharing" {
    usecase "UC12: Share Financial Data with Advisors" as UC12
    note right of UC12
      **Req. ID:** FR13, NFR08
      Allows users to share selected financial data with financial advisors for collaborative advice.
    end note
    
    usecase "UC13: Chatbot for Queries & Support" as UC13 <<include>>
}

package "Reporting & Compliance" {
    usecase "UC14: Generate Health Reports" as UC14
    note right of UC14
      **Req. ID:** FR15, NFR09
      Provides periodic financial health reports based on user data and AI analysis.
    end note
    
    usecase "UC15: Compliance with Regulations" as UC15 <<include>>
}

package "Advanced Features & Customization" {
    usecase "UC16: View Advanced Analytics Dashboard" as UC16
    note right of UC16
      **Req. ID:** FR08, NFR12
      Provides a detailed dashboard for advanced analytics and customization.
    end note
    
    usecase "UC17: Manage Cryptocurrency Portfolio" as UC17 <<include>>
    
    usecase "UC18: Customization of Dashboards & Reports" as UC18
}

user --> UC01
user --> UC03
user --> UC06
advisor --> UC12

banking_api --> UC03
investment_api --> UC04
credit_service --> UC07
news_service --> UC09
ai_engine --> UC05
ai_engine --> UC08
ai_engine --> UC10
ai_engine --> UC11

@enduml