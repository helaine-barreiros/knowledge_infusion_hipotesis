@startuml "AI-Powered Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Use Cases"

actor "Individual Customer" as user
actor "Financial Advisor" as advisor
actor "Banking API Service" as banking_api #lightblue
actor "Investment API Service" as investment_api #lightblue
actor "Credit Scoring Service" as credit_service #lightgreen
actor "News Service" as news_service #orange
actor "AI Reasoning Engine" as ai_engine #cyan

package "Authentication & Security" {
    usecase "UC01: Register User" as UC01 <<include>>
    note right of UC01
      **Req. ID:** FR01, NFR06
      **Description:** Allows users to register with a username/password or through OAuth2 providers.
    end note
    
    usecase "UC02: Login User" as UC02
}

package "Financial Data Management" {
    usecase "UC03: Connect Financial Accounts" as UC03 <<include>>
    note right of UC03
      **Req. ID:** FR02, NFR05
      **Description:** Securely connects users' financial accounts using banking APIs.
    end note
    
    usecase "UC04: Retrieve Transactions" as UC04 <<extend>> UC03
    note right of UC04
      **Req. ID:** FR03
      **Description:** Retrieves and categorizes transactions from connected accounts.
    end note

    usecase "UC05: Update Financial Data" as UC05
}

package "Analysis & Recommendations" {
    usecase "UC06: View Dashboard" as UC06 <<include>>
    note right of UC06
      **Req. ID:** FR04, FR05
      **Description:** Displays a financial dashboard and provides AI-powered insights.
    end note
    
    usecase "UC07: Get Recommendations" as UC07
}

package "Goal & Budget Management" {
    usecase "UC08: Set Financial Goals" as UC08 <<include>>
    note right of UC08
      **Req. ID:** FR07, NFR12
      **Description:** Allows users to set and track financial goals.
    end note
    
    usecase "UC09: Manage Budgets" as UC09 <<extend>> UC08
}

package "Alert & Forecasting" {
    usecase "UC10: Monitor Spending Patterns" as UC10 <<include>>
    note right of UC10
      **Req. ID:** FR09, NFR04
      **Description:** Monitors and alerts users for unusual spending patterns.
    end note
    
    usecase "UC11: Forecast Financial Positions" as UC11
}

package "Investment & Debt Management" {
    usecase "UC12: Suggest Investment Opportunities" as UC12 <<include>>
    note right of UC12
      **Req. ID:** FR10, NFR08
      **Description:** Provides investment recommendations based on user profiles.
    end note
    
    usecase "UC13: Manage Debt" as UC13
}

package "Collaboration & Chatbot" {
    usecase "UC14: Share Financial Data" as UC14 <<include>>
    note right of UC14
      **Req. ID:** FR13, NFR07
      **Description:** Allows users to share selected financial data with advisors.
    end note
    
    usecase "UC15: Chatbot for Queries" as UC15
}

package "Reporting & Health Checks" {
    usecase "UC16: Generate Reports" as UC16 <<include>>
    note right of UC16
      **Req. ID:** FR14, NFR09
      **Description:** Generates periodic financial health reports.
    end note
    
    usecase "UC17: Check Financial Health" as UC17
}

package "Advanced Features & Internationalization" {
    usecase "UC18: Cryptocurrency Portfolio Tracking" as UC18 <<include>>
    note right of UC18
      **Req. ID:** FR09, NFR10
      **Description:** Provides cryptocurrency portfolio tracking and analysis.
    end note
    
    usecase "UC19: Internationalization Support" as UC19
}

package "System Management & Auditing" {
    usecase "UC20: Manage System Settings" as UC20 <<include>>
    note right of UC20
      **Req. ID:** NFR03, NFR14
      **Description:** Allows system administrators to manage settings and maintain an audit trail.
    end note
    
    usecase "UC21: Maintain Audit Trail" as UC21 <<extend>> UC20
}

' CROSS-PACKAGE RELATIONSHIPS
user --> UC01 : Registers/Logs In
user --> UC03 : Connects Accounts
banking_api --> UC04 : Retrieves Transactions
investment_api --> UC05 : Updates Data
credit_service --> UC07 : Provides Credit Insights
news_service --> UC06 : Updates Dashboard
ai_engine --> UC08 : Offers Recommendations
advisor --> UC12 : Shares Financial Data

@enduml