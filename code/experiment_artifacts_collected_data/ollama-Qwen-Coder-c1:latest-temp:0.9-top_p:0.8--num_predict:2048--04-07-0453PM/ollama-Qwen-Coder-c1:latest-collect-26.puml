@startuml "AI-Powered Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Use Cases"

' ACTOR DEFINITION
actor "Individual Customer" as user
actor "Financial Advisor" as advisor

' PACKAGE DEFINITION
package "Authentication & Security" {
    usecase "UC01: Authenticate User" as UC01
}

package "User Profile and Preferences" {
    usecase "UC02: Set Financial Goals" as UC02
    usecase "UC03: Create Budgets" as UC03
    
    UC02 ..> UC03 : <<include>>
    
    note right of UC03
      **Req. ID:** FR07, FR08
      **Description:** Allows users to set financial goals and create budgets.
    end note
}

package "Financial Data Management" {
    usecase "UC04: Connect Financial Accounts" as UC04
    
    note right of UC04
      **Req. ID:** FR02, NFR01
      **Description:** Securely connects external financial accounts using banking APIs.
    end note
    
    usecase "UC05: View Transactions" as UC05
    usecase "UC06: Categorize Transactions" as UC06
    
    UC04 ..> UC05 : <<include>>
    
    UC05 ..> UC06 : <<extend>>
}

package "Analysis & Insights" {
    usecase "UC07: View Financial Dashboard" as UC07
    usecase "UC08: Receive AI Recommendations" as UC08
    
    note right of UC08
      **Req. ID:** FR05, FR06
      **Description:** Provides personalized financial recommendations based on user data.
    end note
    
    usecase "UC09: View Financial Insights" as UC09
    
    UC07 ..> UC05 : <<include>>
    
    UC08 --|> UC09
}

package "Planning & Forecasting" {
    usecase "UC10: Create Investment Strategies" as UC10
    usecase "UC11: Forecast Financial Positions" as UC11
    
    note right of UC11
      **Req. ID:** FR10, NFR02
      **Description:** Predicts future financial positions based on historical data.
    end note
    
    usecase "UC12: Set Up Debt Management Plans" as UC12
}

package "Collaboration & Sharing" {
    usecase "UC13: Share Financial Data with Advisors" as UC13
}
    
' CROSS-PACKAGE RELATIONSHIPS
user --> UC04 : <<include>>
user --> UC07
advisor --> UC10

@enduml