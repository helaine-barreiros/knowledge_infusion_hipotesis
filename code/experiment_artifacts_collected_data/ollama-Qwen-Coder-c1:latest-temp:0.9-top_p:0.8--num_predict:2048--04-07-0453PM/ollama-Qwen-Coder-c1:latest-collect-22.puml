@startuml "AI-Powered Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Use Cases"

actor "Individual Customer" as user
actor "Financial Advisor" as advisor

package "Authentication & Security" {
    usecase "UC01: Register User" as UC01
    note right of UC01
      **Req. ID:** FR01, NFR06
      **Description:** Registers new users with necessary details and multi-factor authentication.
    end note
    
    usecase "UC02: Login/Logout" as UC02
}

package "Financial Account Management" {
    usecase "UC03: Connect Financial Accounts" as UC03
    usecase "UC04: View Transactions" as UC04
    usecase "UC05: Categorize Transactions" as UC05
    
    UC03 ..> UC04 : <<include>>
}

package "Analysis & Insights" {
    usecase "UC06: Receive AI Insights" as UC06
    note right of UC06
      **Req. ID:** FR05, NFR12
      **Description:** Provides personalized financial insights based on user data and machine learning.
    end note
    
    usecase "UC07: Generate Reports" as UC07
}

package "Budget & Goal Management" {
    usecase "UC08: Set Financial Goals" as UC08
    usecase "UC09: Monitor Budgets" as UC09
    
    UC08 ..> UC09 : <<include>>
}

package "Investment Recommendations" {
    usecase "UC10: Suggest Investment Opportunities" as UC10
    note right of UC10
      **Req. ID:** FR11, NFR04
      **Description:** Recommends suitable investment options based on user profile and market data.
    end note
    
}

package "Debt Management" {
    usecase "UC11: Manage Debt Repayment" as UC11
    note right of UC11
      **Req. ID:** FR12, NFR07
      **Description:** Provides strategies for debt repayment with simulations and visualization.
    end note
    
}

package "Collaboration & Sharing" {
    usecase "UC12: Share Data with Advisors" as UC12
}

package "Chatbot Support" {
    usecase "UC13: Interact with Chatbot" as UC13
}

package "Reporting & Alerts" {
    usecase "UC14: Generate Health Reports" as UC14
    
    note right of UC14
      **Req. ID:** FR07, NFR09
      **Description:** Creates periodic financial health reports and alerts for unusual spending patterns.
    end note
    
}

package "Multi-Asset Management" {
    usecase "UC15: Track Cryptocurrency Portfolio" as UC15
    
    note right of UC15
      **Req. ID:** FR09, NFR13
      **Description:** Provides tracking and analysis for cryptocurrency investments.
    end note
    
}

package "Offline Mode & Customization" {
    usecase "UC16: Access in Offline Mode" as UC16
    usecase "UC17: Customize Dashboards" as UC17
}

user --> UC01 : Register
user --> UC02 : Login/Logout
user --> UC03 : Connect Financial Accounts
user --> UC04 : View Transactions
user --> UC05 : Categorize Transactions
user --> UC06 : Receive AI Insights
user --> UC07 : Generate Reports
user --> UC08 : Set Financial Goals
user --> UC09 : Monitor Budgets
user --> UC10 : Suggest Investment Opportunities
user --> UC11 : Manage Debt Repayment
user --> UC12 : Share Data with Advisors
user --> UC13 : Interact with Chatbot
user --> UC14 : Generate Health Reports
user --> UC15 : Track Cryptocurrency Portfolio
user --> UC16 : Access in Offline Mode
user --> UC17 : Customize Dashboards

@enduml