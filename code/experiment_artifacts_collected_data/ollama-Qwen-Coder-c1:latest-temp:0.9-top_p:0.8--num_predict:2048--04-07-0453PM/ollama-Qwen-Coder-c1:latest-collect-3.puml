@startuml "AI-Powered Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Use Cases"

actor "Individual Customer" as user
actor "Financial Advisor" as advisor
actor "Banking API" as bank_api #lightblue
actor "Investment API" as invest_api #lightblue
actor "Credit Scoring Service" as credit_service #lightgreen
actor "News Service" as news_service #orange
actor "Authentication Service" as auth_service #purple
actor "AI Reasoning Engine" as ai_engine #cyan

package "User Management & Authentication" {
    usecase "UC01: Register User" as UC01 <<include>>
    
    note right of UC01
      **Req. ID:** FR01, NFR06
      **Description:** Registers new users and manages authentication.
    end note
    
    usecase "UC02: Log In/Out" as UC02 <<extend>>
}

package "Financial Data Management" {
    usecase "UC03: Connect Financial Accounts" as UC03
    
    note right of UC03
      **Req. ID:** FR02, NFR01
      **Description:** Links external financial accounts using banking APIs.
    end note
    
    usecase "UC04: Retrieve Transactions" as UC04 <<include>>
    
    note right of UC04
      **Req. ID:** FR03, NFR08
      **Description:** Aggregates and categorizes transaction data from connected accounts.
    end note
    
    usecase "UC05: Monitor Spending Patterns" as UC05 <<extend>>
}

package "Analysis & Insights" {
    usecase "UC06: View Financial Dashboard" as UC06
    
    note right of UC06
      **Req. ID:** FR04, NFR12
      **Description:** Provides a visual overview of spending patterns and financial history.
    end note
    
    usecase "UC07: Receive AI Insights" as UC07 <<include>>
    
    note right of UC07
      **Req. ID:** FR05, NFR09
      **Description:** Offers AI-powered insights on spending habits based on user data.
    end note
    
    usecase "UC08: Generate Recommendations" as UC08 <<extend>>
}

package "Goal & Budget Management" {
    usecase "UC09: Set Financial Goals" as UC09
    
    note right of UC09
      **Req. ID:** FR07, NFR13
      **Description:** Allows users to create and track financial goals.
    end note
    
    usecase "UC10: Monitor Budget Progress" as UC10 <<include>>
    
    note right of UC10
      **Req. ID:** FR08, NFR05
      **Description:** Tracks budget adherence and provides visual feedback on goal progress.
    end note
}

package "Alerts & Notifications" {
    usecase "UC11: Receive Alerts" as UC11
    
    note right of UC11
      **Req. ID:** FR09, NFR07
      **Description:** Sends alerts for unusual spending patterns and other important events.
    end note
    
    usecase "UC12: Manage Alert Preferences" as UC12 <<include>>
    
    note right of UC12
      **Req. ID:** FR13, NFR15
      **Description:** Allows users to customize alert preferences.
    end note
}

package "Forecasting & Planning" {
    usecase "UC13: Forecast Future Positions" as UC13
    
    note right of UC13
      **Req. ID:** FR10, NFR04
      **Description:** Predicts future financial positions based on historical data.
    end note
    
    usecase "UC14: Plan Financial Goals" as UC14 <<include>>
    
    note right of UC14
      **Req. ID:** FR15, NFR03
      **Description:** Helps users plan and visualize their financial future goals.
    end note
}

package "Investment & Portfolio Management" {
    usecase "UC15: Suggest Investment Opportunities" as UC15
    
    note right of UC15
      **Req. ID:** FR11, NFR02
      **Description:** Provides personalized investment suggestions based on user profiles.
    end note
    
    usecase "UC16: Monitor Portfolio Performance" as UC16 <<include>>
    
    note right of UC16
      **Req. ID:** FR17, NFR08
      **Description:** Tracks and visualizes the performance of investment portfolios.
    end note
}

package "Debt Management & Repayment Simulation" {
    usecase "UC17: Manage Debt" as UC17
    
    note right of UC17
      **Req. ID:** FR12, NFR06
      **Description:** Helps users manage debt with repayment simulations.
    end note
    
    usecase "UC18: Track Repayment Progress" as UC18 <<include>>
    
    note right of UC18
      **Req. ID:** FR19, NFR05
      **Description:** Monitors and visualizes the progress towards debt repayment goals.
    end note
}

package "Collaboration & Sharing" {
    usecase "UC19: Share Financial Data with Advisors" as UC19
    
    note right of UC19
      **Req. ID:** FR20, NFR14
      **Description:** Enables users to share selected financial data with financial advisors.
    end note
    
    usecase "UC20: Receive Recommendations from Advisors" as UC20 <<include>>
    
    note right of UC20
      **Req. ID:** FR21, NFR03
      **Description:** Receives personalized recommendations based on shared data.
    end note
}

user --> UC01
user --> UC02
user --> UC03
user --> UC04
user --> UC05
user --> UC06
user --> UC07
user --> UC08
user --> UC09
user --> UC10
user --> UC11
user --> UC12
user --> UC13
user --> UC14
user --> UC15
user --> UC16
user --> UC17
user --> UC18
user --> UC19
user --> UC20

advisor --> UC13
advisor --> UC15
advisor --> UC19
advisor --> UC20

bank_api --> UC04
invest_api --> UC15
credit_service --> UC16
news_service --> UC07
auth_service --> UC01
ai_engine --> UC07
ai_engine --> UC18

@enduml