@startuml "AI-Powered Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Use Cases"

' ACTOR DEFINITION
actor "Individual Customer" as user
actor "Financial Advisor" as advisor
actor "Banking APIs" as bank #lightblue
actor "Investment APIs" as invest #lightblue
actor "Credit Scoring Service" as credit #lightgreen
actor "News Service" as news #orange

' PACKAGE DEFINITION
package "Authentication & Security" {
    usecase "UC01: Authenticate User" as UC01
}

package "Financial Account Management" {
    usecase "UC02: Connect Financial Accounts" as UC02
    
    note right of UC02
      **Req. ID:** FR02, NFR06
      **Description:** Securely links external financial accounts 
      using banking APIs to retrieve transaction data.
    end note
    
    usecase "UC03: View Transactions" as UC03
}

package "Analysis & Recommendations" {
    usecase "UC04: Receive AI Insights and Analysis" as UC04
    usecase "UC05: Generate Personalized Financial Recommendations" as UC05

    note right of UC04
      **Req. ID:** FR05, FR06, NFR12
      **Description:** Provides advanced financial analysis 
      and personalized recommendations based on AI reasoning.
    end note
    
    usecase "UC06: View Financial Dashboard" as UC06
}

package "Budgeting & Goal Management" {
    usecase "UC07: Set Financial Goals" as UC07
    usecase "UC08: Track Budget Progress" as UC08

    note right of UC07
      **Req. ID:** FR07, NFR12
      **Description:** Allows users to set and track financial 
      goals with budget monitoring capabilities.
    end note
    
    usecase "UC09: Receive Alerts for Unusual Spending" as UC09
}

package "Forecasting & Projections" {
    usecase "UC10: Forecast Future Financial Positions" as UC10

    note right of UC10
      **Req. ID:** FR10, NFR12
      **Description:** Provides future financial position 
      forecasting based on historical data.
    end note
    
    usecase "UC11: Generate Periodic Reports" as UC11
}

package "Investment & Debt Management" {
    usecase "UC12: Suggest Investment Opportunities" as UC12

    note right of UC12
      **Req. ID:** FR11, NFR06
      **Description:** Recommends investment opportunities 
      based on user profile and market data.
    end note
    
    usecase "UC13: Provide Debt Management Strategies" as UC13

    note right of UC13
      **Req. ID:** FR12, NFR04
      **Description:** Offers debt management strategies with repayment 
      simulations based on user financial profile.
    end note
}

package "Collaboration & Support" {
    usecase "UC14: Share Financial Data with Advisors" as UC14

    note right of UC14
      **Req. ID:** FR13, NFR06
      **Description:** Allows users to share selected financial data 
      with their financial advisors for collaborative advice.
    end note
    
    usecase "UC15: Access Chatbot Support" as UC15

    note right of UC15
      **Req. ID:** FR14, NFR06
      **Description:** Provides access to a chatbot for financial queries 
      and support from the system.
    end note
    
    usecase "UC16: Generate Financial Health Reports" as UC16

    note right of UC16
      **Req. ID:** FR15, NFR04
      **Description:** Generates periodic financial health reports to provide insights into user's overall financial well-being.
    end note
    
    usecase "UC17: Support Offline Mode with Limited Functionality" as UC17

    note right of UC17
      **Req. ID:** FR13, NFR04
      **Description:** Provides offline mode with limited functionality 
      to ensure the system remains accessible even without internet connectivity.
    end note
    
}

package "Security & Compliance" {
    usecase "UC18: Ensure Data Security and Compliance" as UC18

    note right of UC18
      **Req. ID:** NFR02, NFR04, NFR07
      **Description:** Ensures data security with encryption at rest 
      and in transit while complying with financial regulations such as GDPR and PSD2.
    end note
    
}

' CROSS-PACKAGE RELATIONSHIPS
UC01 ..> UC03 : <<include>>
UC04 ..> UC06 : <<extend>>

' ACTOR-USE CASE RELATIONSHIPS
user --> UC01
user --> UC02
user --> UC05
user --> UC08
advisor --> UC07
bank --> UC02
invest --> UC12

@enduml