@startuml "AI-Powered Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Use Cases"

' ACTOR DEFINITION
actor "Individual Customer" as individual
actor "Financial Advisor" as advisor

' SYSTEM actors (external systems) should use color to differentiate 
actor "Banking APIs" as banking_api #lightblue
actor "Investment APIs" as investment_api #lightgreen
actor "Credit Scoring Service" as credit_service #orange
actor "News Service" as news_service #yellow
actor "Authentication Service" as auth_service #purple
actor "AI Reasoning Engine" as ai_engine #cyan

' PACKAGE DEFINITION
package "User Authentication & Security" {
    usecase "UC01: Authenticate User" as UC01
    
    note right of UC01
      **Req. ID:** FR01, NFR06
      **Description:** Allows users to authenticate via 
      username/password or OAuth2 providers, with 
      optional multi-factor authentication.
    end note
    
    usecase "UC02: Manage Account Settings" as UC02
}

package "Financial Data Management & Aggregation" {
    usecase "UC03: Connect Financial Accounts" as UC03
    
    note right of UC03
      **Req. ID:** FR02, NFR05
      **Description:** Securely links external financial accounts 
      using banking APIs to retrieve transaction data.
    end note
    
    usecase "UC04: View Transactions" as UC04
    usecase "UC05: Categorize Transactions" as UC05
    
    ' INCLUDE RELATIONSHIP
    UC03 ..> UC04 : <<include>>
    
    ' EXTEND RELATIONSHIP
    UC04 ..> UC05 : <<extend>>
}

package "Analysis & Insights" {
    usecase "UC06: View Financial Dashboard" as UC06
    usecase "UC07: Receive AI Recommendations" as UC07
    
    note right of UC07
      **Req. ID:** FR05, NFR12
      **Description:** Provides advanced financial analysis and personalized 
      recommendations based on historical data.
    end note
    
    ' GENERALIZATION RELATIONSHIP
    usecase "UC08: View Basic Reports" as UC08
    usecase "UC09: View Advanced Analytics" as UC09
    UC09 --|> UC08
}

package "Budgeting & Goal Management" {
    usecase "UC10: Set Financial Goals" as UC10
    
    note right of UC10
      **Req. ID:** FR07, NFR13
      **Description:** Allows users to set and track financial goals.
    end note
    
    usecase "UC11: Monitor Budgets" as UC11
}

package "Debt Management & Analysis" {
    usecase "UC12: Manage Debt" as UC12
    
    note right of UC12
      **Req. ID:** FR09, NFR14
      **Description:** Provides debt management strategies with repayment simulations.
    end note
    
    usecase "UC13: Analyze Credit Score" as UC13
}

package "Investment & Portfolio Management" {
    usecase "UC14: Suggest Investment Opportunities" as UC14
    
    note right of UC14
      **Req. ID:** FR10, NFR15
      **Description:** Recommends investment opportunities based on user profile.
    end note
    
    usecase "UC15: Monitor Portfolio Performance" as UC15
}

package "Financial Reporting & Alerts" {
    usecase "UC16: Generate Financial Reports" as UC16
    
    note right of UC16
      **Req. ID:** FR08, NFR16
      **Description:** Provides periodic financial health reports.
    end note
    
    usecase "UC17: Receive Alerts for Unusual Spending" as UC17
}

package "Chatbot & Support" {
    usecase "UC18: Interact with Chatbot" as UC18
    
    note right of UC18
      **Req. ID:** FR04, NFR17
      **Description:** Offers a chatbot for financial queries and support.
    end note
}

package "Integration & Collaboration" {
    usecase "UC19: Share Financial Data with Advisors" as UC19
    
    note right of UC19
      **Req. ID:** FR03, NFR18
      **Description:** Allows users to share selected financial data with financial advisors.
    end note
    
    usecase "UC20: Collaborate on Goals and Budgets" as UC20
}

' CROSS-PACKAGE RELATIONSHIPS

# User interactions with various packages:
individual --> UC01
individual --> UC03
individual --> UC06
individual --> UC07
individual --> UC10
individual --> UC14
individual --> UC16
advisor --> UC20

banking_api --> UC03
investment_api --> UC05
credit_service --> UC13
news_service --> UC08
auth_service --> UC01
ai_engine --> UC07
advisor --> UC19


@enduml