@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
}

package "System Administrator" {
  actor SysAdmin as SAFR003
}

rectangle "AI Component" {
  usecase "AIFR001: Generate financial predictions" as AIFR001
  usecase "AIFR002: Generate personalized recommendations" as AIFR002
  usecase "AIFR003: Generate spending limit alerts" as AIFR003
  usecase "AIFR004: Generate investment opportunity analyses" as AIFR004
  usecase "AIFR005: Generate investment opportunities" as AIFR005
  usecase "AIFR006: Generate anomaly transaction alerts" as AIFR006
  usecase "AIFR007: Generate contextualized news insights" as AIFR007
  usecase "AIFR008: Generate client predictive intervention recommendations" as AIFR008
  usecase "AIFR009: Generate client predictive insights" as AIFR009
  
  CFR001 --> (CFR002 : "View Financial Insights Dashboard")
  CFR001 --> (SFR004 : "Receive personalized recommendations aligned with financial profile and goals")
  CFR001 --> (SAFR005 : "Manage personalized recommendation preferences")
  CFR001 --> (AIFR003 : "View spending limit alerts when exceeding predefined thresholds in specific expense categories")
  CFR001 --> (SFR006 : "View investment opportunities suitable to risk profile as defined under MiFID II or equivalent standards")
  CFR001 --> (SFR008 : "View news related to financial portfolio for staying informed about market events")
  CFR001 --> (AIFR007 : "Access a personalized dashboard consolidating financial information in one view")
  CFR001 --> (FAFR002 : "Manage relationship with Financial Advisors, including permissions for sharing data")

  FAFR002 --> (SFR003 : "View predictive analytics about client's financial situations to provide recommendations during consultations")
  FAFR002 --> (AIFR004 : "Configure analysis parameters for specific client segments based on regulatory requirements such as GDPR or CCPA")

  SAFR001 --> (SAFR005 : "Manage system-generated alerts and notifications for critical financial events to ensure timely awareness")
}

@enduml