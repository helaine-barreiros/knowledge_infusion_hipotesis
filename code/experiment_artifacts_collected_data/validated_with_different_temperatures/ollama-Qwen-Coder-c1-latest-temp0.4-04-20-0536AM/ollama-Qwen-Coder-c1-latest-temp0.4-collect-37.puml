@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFR001
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR005: Manage Analysis Parameters Preferences" as SAFR005
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  
  Client --> CFR001
  SysAdmin --> SAFR005
  FAFR001 --> SFR002
  System --> AIFR002
}

rectangle "Client Dashboard Features" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  
  Client --> CFR009
}

rectangle "Alerts and Notifications" {
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  
  System --> SFR013
  System --> AIFR006
}

rectangle "Financial Predictions and Insights" {
  usecase "SFR007: Request Financial Predictions from AI Component" as SFR007
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  System --> SFR007
  System --> AIFR009
}

rectangle "Investment Opportunities and Recommendations" {
  usecase "SFR016: Request Predictive Insights from AI Component" as SFR016
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  
  System --> SFR016
  System --> AIFR004
}

rectangle "Client Mentoring and Engagement" {
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "AIFR008: Generate Predictive Intervention Recommendations for Users" as AIFR008
  
  System --> FAFR002
  System --> AIFR008
}

rectangle "System Management and Feedback" {
  usecase "SFR19: Maintain Historical Record of Users' Insights" as SFR19
  usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
  
  System --> SFR19
  System --> AIFR007
  
  rectangle "Feedback Mechanism" {
    usecase "CFR011: Send Feedback about Recommendations and Insights" as CFR011
    
    Client --> CFR011
  }
}
@enduml