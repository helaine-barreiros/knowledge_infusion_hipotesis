@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as client
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  client --> CFR001 : "View"
  client --> CFR002 : "Receive Alerts"
  client --> CFR003 : "Predictions"
  client --> CFR004 : "Recommendations"
  client --> CFR005 : "Manage Preferences"
  client --> CFR006 : "Spending Limits"
  client --> CFR007 : "Investment Opportunities"
  client --> CFR008 : "News"
  client --> CFR009 : "Access Dashboard"
  client --> CFR10 : "Manage Relationship"
}

package "Financial Advisors" {
  actor FinancialAdvisor as advisor
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  advisor --> FAFR001 : "Manage Sessions"
  advisor --> FAFR002 : "View Alerts"
  advisor --> FAFR003 : "Predictive Analytics"
  advisor --> FAFR004 : "Configure Parameters"
}

package "System" {
  actor System as sys
  
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
  usecase "SFR005: Request Spending Limit Alerts" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities with ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Portfolios" as SFR009
  usecase "SFR010: Process Contextualized News" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI" as SFR011
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI" as SFR015
  usecase "SFR016: Request Predictive Insights from AI" as SFR016
  usecase "SFR017: Generate Financial Health Reports" as SFR017
  usecase "SFR018: Manage Users' Financial Goals" as SFR018
  usecase "SFR019: Maintain Historical Record of Insights" as SFR019
  usecase "SFR020: Manage User Feedback" as SFR020
  
  sys --> SFR001 : "Deliver Alerts"
  sys --> SFR002 : "Deliver Recommendations"
  sys --> SFR003 : "Request Predictions"
  sys --> SFR004 : "Request AI Recommendations"
  sys --> SFR005 : "Request Spending Limits"
  sys --> SFR006 : "Request Investment Analysis"
  sys --> SFR007 : "Request Specific Opportunities with ESG Preferences"
  sys --> SFR008 : "Request Anomaly Alerts"
  sys --> SFR009 : "Find Contextualized News"
  sys --> SFR010 : "Process News"
  sys --> SFR011 : "Request AI Insights"
  sys --> SFR012 : "Generate Dashboards"
  sys --> SFR013 : "Generate Alerts Based on Conditions"
  sys --> SFR014 : "Generate Analytics"
  sys --> SFR015 : "Request Predictive Interventions"
  sys --> SFR016 : "Request Insights from AI"
  sys --> SFR017 : "Generate Financial Health Reports"
  sys --> SFR018 : "Manage Goals"
  sys --> SFR019 : "Maintain Record of Insights"
  sys --> SFR020 : "Manage Feedback"
}

package "AI System" {
  actor AI as ai
  
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities with Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  ai --> AIFR001 : "Generate Predictions"
  ai --> AIFR002 : "Generate Recommendations"
