@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (View Alerts on Anomalous Transactions)
  C --> (Receive Personalized Recommendations)
  C --> (Manage Recommendation Preferences)
  C --> (Access Personalized Dashboard)
}

package "Financial Advisors" {
  actor Advisor as A
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Clients" as FAFR002
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  A --> (Manage Client Mentoring Sessions)
}

package "System Administrator" {
  actor SysAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR020: Manage User Feedback to Improve Recommendations" as SFR020
  
  SA --> (Manage Analysis Parameters)
}

package "System Components" {
  rectangle System {
    usecase "SFR001: Deliver Alerts through Notification Channels" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations Based on Profiles" as SFR002
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities Based on Criteria and Preferences" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Portfolios" as SFR009
    usecase "SFR010: Process Contextualized News for User Financial Situations" as SFR010
    usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
    usecase "SFR012: Generate Client Dashboards with Intuitive Format" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Conditions" as SFR013
    usecase "SFR014: Generate Client Analytics for Insights into Behavior and Performance" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
    usecase "SFR016: Request Predictive Insights from AI Component to Enhance Financial Guidance" as SFR016
    usecase "SFR017: Generate Financial Health Reports Based on Ratios and Metrics" as SFR017
    usecase "SFR018: Manage Users' Financial Goals for Progress Tracking" as SFR018
    usecase "SFR019: Maintain Historical Record of Insights for Trend Analysis" as SFR019
    
    System --> (Deliver Alerts through Notification Channels)
    System --> (Request Financial Predictions from AI Component)
  }
}

package "AI Components" {
  rectangle AI {
    usecase "AIFR001: Generate Financial Predictions Based on Data and Trends" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations based on Profiles, Goals, and Risk Tolerance" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Patterns" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users Based on Risk Profiles and Goals" as AIFR004
    usecase "AIFR005: Identify Financial Instruments Aligning with User Strategies and Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition for Fraud Detection" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News with User Portfolios" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns of Potential Issues or Opportunities for Advisor Engagement" as AIFR008
    usecase "AIFR009: Provide Forward-Looking Analysis to Support Financial Planning and Decision-Making" as AIFR009
    
    AI --> (Generate Financial Predictions Based on Data and Trends)
  }
}

C --> System : interacts with
SA --> System : interacts with
A --> System : interacts with

@enduml