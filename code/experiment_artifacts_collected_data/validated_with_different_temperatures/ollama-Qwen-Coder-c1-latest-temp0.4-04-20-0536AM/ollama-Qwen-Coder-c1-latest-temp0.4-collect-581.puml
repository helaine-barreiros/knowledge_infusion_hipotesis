@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FinancialAdvisor
:User: as User

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FinancialAdvisor --> FAFR002
  User --> (Send Feedback)
}

rectangle "Financial Insights Dashboard" {
  usecase "CFR003: View Financial Predictions Based on Historical Data and Current Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as CFR004
  
  Client --> CFR003
  Client --> CFR004
}

rectangle "Personalization & Preferences Management" {
  usecase "CFR010: Manage Relationship With Financial Advisors, Including Permissions for Sharing Data" as CFR010
  usecase "SAFR005: Manage Personalized Recommendations Preferences" as SAFR005
  
  Client --> CFR010
  SysAdmin --> SAFR005
}

rectangle "Spending Limits and Alerts" {
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as CFR006
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  
  Client --> CFR006
}

rectangle "Investment Opportunities and News" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile (as Defined Under MiFID II or Equivalent Standards)" as CFR007
  usecase "FAFR012: Configure Analysis Parameters for Specific Client Segments" as FAFR012
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
  
  Client --> CFR007
  FinancialAdvisor --> FAFR012
  Client --> SFR006
  Client --> CFR008
}

rectangle "System Notifications and Recommendations" {
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002
  usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
  
  Client --> SFR002
}

rectangle "Predictive Insights & Intervention" {
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as FAFR003
  usecase "SFR15: Request Predictive Intervention Analyses from the AI Component to Identify When Financial Advisors Should Engage with Clients" as SFR15
  
  Client --> FAFR003
}

@enduml