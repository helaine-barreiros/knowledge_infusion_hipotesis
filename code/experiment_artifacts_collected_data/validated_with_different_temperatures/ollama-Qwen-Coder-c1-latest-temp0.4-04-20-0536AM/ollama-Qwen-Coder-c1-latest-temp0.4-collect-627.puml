}

rectangle "System" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001_1
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002_1
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003_1
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004_1
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005_1
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006_1
