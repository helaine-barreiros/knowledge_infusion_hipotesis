rectangle "AI Component" {
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001_1
  usecase "AIFR002: Generate Personalized Recommendations Based on User Profiles and Goals" as AIFR002_1
  usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Patterns" as AIFR003_1
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users Based on Their Risk Profiles and Goals" as AIFR004_1
  usecase "AIFR005: Generate Investment Opportunities Matching User Strategies Using Modern Portfolio Theory Principles" as AIFR005_1
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006_1
  usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News with Specific User Portfolios" as AIFR007_1
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008_1
  usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Planning" as AIFR009_1

  SysAdmin --> SAFR003 : Manage Analysis Parameters
}

