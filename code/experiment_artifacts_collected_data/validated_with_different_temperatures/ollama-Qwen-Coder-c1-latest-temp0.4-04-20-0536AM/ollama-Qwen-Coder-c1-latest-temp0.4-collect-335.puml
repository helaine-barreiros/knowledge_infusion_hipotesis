@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR002
  usecase "CFR003: View Financial Predictions" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations" as SAFR004
  usecase "CFR005: Manage Recommendation Preferences" as SAFR005
  usecase "CFR006: View Spending Limit Alerts" as SAFR006
  usecase "CFR007: View Investment Opportunities" as SAFR007
  usecase "CFR008: View News Related to Portfolio" as SAFR008
  usecase "CFR009: Access Personalized Dashboard" as SAFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as SAFR10
  
  CFR001 --> (SAFR002)
  CFR001 --> (SAFR003)
  CFR001 --> (SAFR004)
  CFR001 --> (SAFR005)
  CFR001 --> (SAFR006)
  CFR001 --> (SAFR007)
  CFR001 --> (SAFR008)
  CFR001 --> (SAFR009)
  CFR001 --> (SAFR10)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts" as SAFR007
  usecase "FAFR003: View Predictive Analytics for Clients" as SAFR008
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as SAFR10
  
  FinancialAdvisor --> (SAFR002)
  FinancialAdvisor --> (SAFR003)
  FinancialAdvisor --> (SAFR004)
}

package "System Administrator" {
  actor SystemAdmin as SAFR001
  
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  SystemAdmin --> (SAFR001)
}

rectangle "AI Component" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Generate Financial Health Reports" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  
  SAFR001 --> (AIFR001)
  SAFR002 --> (AIFR002)
  SAFR003 --> (AIFR003)
  SAFR004 --> (AIFR004)
  SAFR005 --> (AIFR005)
  SAFR006 --> (AIFR006)
  SAFR007 --> (AIFR007)
}

package "System" {
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics Providing Meaningful Insights" as SFR014
  
  SAFR009 --> (SFR012)
  SAFR13 --> (SFR013)
  SAFR14 --> (SFR014)
}

package "User Feedback Management" {
  usecase "CFR11: Send Feedback About System Recommendations and Insights" as CFR11
  
  Client --> (SAFR11)
  FinancialAdvisor --> (SAFR11)
  SystemAdmin --> (SAFR11)
}
@enduml