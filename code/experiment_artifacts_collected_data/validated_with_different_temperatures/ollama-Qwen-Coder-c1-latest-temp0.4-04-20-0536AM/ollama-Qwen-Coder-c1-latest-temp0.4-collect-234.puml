@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFI

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001

  Client --> CFR001
  Client --> FAFR002
  SysAdmin --> SAFR001
}

rectangle "Financial Advisor System" {
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as FAFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component based on Users' Data and Preferences" as SFR004

  FAFI --> FAFR002
  FAFI --> FAFR003
}

rectangle "Client Relationship Management System" {
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
  
  Client --> CFR010
}

rectangle "News and Insights System" {
  usecase "SFR008: Request Contextualized News from AI Component" as SFR008

  Client --> SFR008
}

rectangle "Feedback Management System" {
  usecase "CFR011: Send Feedback about Recommendations and Insights to Improve Future Outputs" as CFR011
  
  Client --> CFR011
}
@enduml