@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  Client --> (SFR012) : Generate client dashboards that present financial information in an intuitive and actionable format.
  SysAdmin --> (SAFR001) : Manage analysis parameters for the AI system to ensure the algorithms remain accurate, relevant, and compliant with financial regulations such as Basel III for risk management.
}

rectangle "Client" {
  usecase "CFR002: View Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as CFR004
  usecase "CFR005: Manage Personalized Recommendations Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as CFR006
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "CFR009: Access a Personalized Dashboard That Consolidates My Financial Information in a Single View" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors Including Permissions for Sharing Data" as CFR10
  
  Client --> (SFR008) : Generate anomaly transaction alerts by employing pattern recognition to detect potentially fraudulent activities in compliance with FinCEN requirements.
  Client --> (SFR009) : Find contextualized news relevant to users' financial portfolios from trusted financial news sources.
  Client --> (AIFR004) : Generate investment opportunity analyses for users by evaluating potential investments against their risk profiles, time horizons, and financial goals.
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts When Patterns Require Professional Attention" as FAFR002
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments Based on Different Profiles and Regulatory Requirements" as FAFR004
  
  FAFR001 --> (SFR016) : Enhance the value of financial guidance provided to clients.
}

rectangle "System" {
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component for Forward-Looking Insights" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component Based on Each User's Data and Preferences" as SFR004
  usecase "SFR005: Request Spending Limit Alerts From AI Component When Patterns Exceed Defined Thresholds" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities From AI Component Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR013: Generate Client Alerts Based On Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR013
  
  SystemAdmin --> (SAFR001) : Manage analysis parameters for the AI system.
}

rectangle "AI Component" {
  usecase "AIFR001: Generate Financial Predictions by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Profiles, Goals, and Risk Tolerance As Defined By Industry Standards Like FINRA Guidelines" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities by Identifying Instruments Aligning With User Strategies and Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
  
  Client --> (SFR017) : Request predictive insights from the AI component.
}

rectangle "Feedback Loop" {
  usecase "CFR11: Send Feedback About System's Recommendations and Insights to Improve Future Outputs" as CFR11
}
@enduml