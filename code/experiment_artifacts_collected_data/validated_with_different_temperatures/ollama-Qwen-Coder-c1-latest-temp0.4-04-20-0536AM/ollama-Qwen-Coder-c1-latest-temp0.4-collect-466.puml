@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Deliver Personalized Recommendations" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "CFR011: Send Feedback about System's Recommendations and Insights" as CFR011

  Client --> (SAFR001)
  Client --> (FAFR002)
  Client --> (SFR003)
  Client --> (AIFR004)

  SysAdmin --> SAFR001
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001a
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002a
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004a

  FinancialAdvisor --> (FAFR001a)
  FinancialAdvisor --> (FAFR002a)
  FinancialAdvisor --> (AIFR004a)

}

rectangle "Client Dashboard" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  Client --> (CFR009)
}
@enduml