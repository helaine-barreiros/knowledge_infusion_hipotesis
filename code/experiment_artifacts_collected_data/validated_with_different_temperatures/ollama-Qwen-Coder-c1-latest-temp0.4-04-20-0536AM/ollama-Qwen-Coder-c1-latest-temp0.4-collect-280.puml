@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FA

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  
  User --> CFR001 : "View Financial Insights Dashboard"
  User --> SAFR005 : "Manage Personalized Recommendations Preferences"
  SysAdmin --> SAFR001 : "Manage Analysis Parameters"
  FA --> FAFR002 : "View Client Intervention Alerts"
  FA --> FAFR003 : "View Predictive Analytics"
}

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR005: Manage Personalized Recommendations Preferences" as SAFR005
  
  User --> CFR001 : "View Financial Insights Dashboard"
  User --> SAFR005 : "Manage Personalized Recommendations Preferences"
}

rectangle "Financial Advisor" {
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  
  FA --> FAFR002 : "View Client Intervention Alerts"
  FA --> FAFR003 : "View Predictive Analytics"
}

rectangle "System Components" {
  usecase "SFR001: Deliver Alerts" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  User --> SFR001 : "Receive Alerts"
  SysAdmin --> SAFR005 : "Manage Analysis Parameters"
  FA --> FAFR003 : "View Predictive Analytics"
}

rectangle "User Feedback Loop" {
  usecase "CFR011: Send Feedback" as CFR011
  
  User --> CFR011 : "Send Feedback about Recommendations and Insights"
}
@enduml