@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR002
  usecase "CFR003: View Financial Predictions" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations" as SAFR004
  usecase "CFR005: Manage Recommendation Preferences" as SAFR005
  usecase "CFR006: View Spending Limit Alerts" as SAFR006
  usecase "CFR007: View Investment Opportunities" as SAFR007
  usecase "CFR008: View News Related to Portfolio" as SAFR008
  usecase "CFR009: Access Personalized Dashboard" as SAFR012
  usecase "CFR10: Manage Relationship with Financial Advisors" as SAFR009
  
  CFR001 --> SAFR002 : "Receive Alerts"
  CFR001 --> SAFR003 : "View Predictions"
  CFR001 --> SAFR004 : "Get Recommendations"
  CFR001 --> SAFR005 : "Manage Preferences"
  CFR001 --> SAFR006 : "Check Spending Limits"
  CFR001 --> SAFR007 : "View Opportunities"
  CFR001 --> SAFR008 : "Read News"
  CFR001 --> SAFR012 : "Access Dashboard"
  CFR001 --> SAFR009 : "Manage Advisors"
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts" as SAFR007
  usecase "FAFR003: View Predictive Analytics for Clients" as SAFR008
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as SAFR015
  
  FinancialAdvisor --> SAFR002 : "View Alerts"
  FinancialAdvisor --> SAFR003 : "Get Analytics"
  FinancialAdvisor --> SAFR004 : "Configure Parameters"
}

package "System Administrator" {
  actor SystemAdmin as SAFR001
  
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR006
  usecase "SFR020: Manage User Feedback to Improve Insights" as SFR020
  
  SystemAdmin --> SAFR006 : "Manage Params"
  SystemAdmin --> SFR020 : "Process Feedback"
}

package "System" {
  rectangle "AI Component" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on Strategies" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
    
    CFR001 --> AIFR001 : "Request Predictions"
    CFR001 --> AIFR002 : "Request Recommendations"
    CFR001 --> AIFR003 : "Request Spending Alerts"
    CFR001 --> AIFR004 : "Request Investment Opportunities"
    CFR001 --> AIFR005 : "Request Suitable Investments"
    CFR001 --> AIFR006 : "Request Anomaly Alerts"
    CFR001 --> AIFR007 : "Request News Insights"
    CFR001 --> AIFR008 : "Request Intervention Recommendations"
    CFR001 --> AIFR009 : "Request Predictive Insights"
    
    FAFR001 --> AIFR002 : "Get Recommendations for Clients"
    FAFR001 --> AIFR003 : "Generate Alerts for Clients"
    FAFR001 --> AIFR004 : "Analyze Client Situations"
    
    SAFR006 <|-- (AIFR001) : Inherits
  }
  
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  
  CFR001 --> SFR002 : "Receive Recommendations"
}

@enduml