@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "SFR014: Generate Client Analytics" as SFR014
  usecase "AIFR009: Generate Predictive Insights" as AIFR009

  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> FAFR003
  System --> SFR012
  System --> SFR014
  System --> AIFR009
  
}

rectangle "Client" {
  usecase "CFR002: Receive Anomaly Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010

  Client --> CFR002
  Client --> CFR003
  Client --> CFR004
  Client --> CFR005
  Client --> CFR006
  Client --> CFR010
  
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004

  Financial Advisor --> FAFR001
  Financial Advisor --> FAFR002
  Financial Advisor --> FAFR004
  
}

rectangle "System Components" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities from AI Component" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  usecase "SFR10: Process Contextualized News for Users' Financial Situations" as SFR10
  usecase "SFR11: Request Contextualized News Insights from AI Component" as SFR11
  usecase "SFR13: Generate Client Alerts Based on Predefined Conditions" as SFR13
  usecase "SFR15: Request Predictive Intervention Analyses from AI Component" as SFR15
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002

  System --> SFR001
  System --> SFR002
  System --> SFR003
  System --> SFR004
  System --> SFR005
  System --> SFR006
  System --> SFR007
  System --> SFR008
  System --> SFR009
  System --> SFR10
  System --> SFR11
  System --> SFR13
  System --> SFR15
  System --> AIFR002
  
}

rectangle "User (Client, Financial Advisor, or System Administrator)" {
  usecase "CFR011: Send Feedback" as CFR011

  Client --> CFR011
  Financial Advisor --> CFR011
  SysAdmin --> CFR011
  
}
@enduml