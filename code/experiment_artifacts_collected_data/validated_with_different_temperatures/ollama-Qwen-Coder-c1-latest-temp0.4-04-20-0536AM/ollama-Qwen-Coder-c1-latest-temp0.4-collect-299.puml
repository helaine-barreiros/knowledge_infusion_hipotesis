@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as c
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as CFR006
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "CFR009: Access a Personalized Dashboard Consolidating Financial Information in a Single View" as CFR009
  usecase "CFR010: Manage Relationship with Financial Advisors, Including Permissions for Sharing Data" as CFR010
  
  c --> CFR001
  c --> CFR002
  c --> CFR003
  c --> CFR004
  c --> CFR005
  c --> CFR006
  c --> CFR007
  c --> CFR008
  c --> CFR009
  c --> CFR010
  
  rectangle "Client System" {
    usecase "SFR012: Generate Client Dashboards" as SFR012
    
    c --> SFR012
  }
}

package "Financial Advisor" {
  actor FinancialAdvisor as fa
  
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts When Patterns Require Professional Attention" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments to Customize the System's Behavior According to Different Client Profiles and Regulatory Requirements Such As GDPR or CCPA" as FAFR004
  
  fa --> FAFR001
  fa --> FAFR002
  fa --> FAFR003
  fa --> FAFR004
  
  rectangle "Financial Advisor System" {
    usecase "SFR015: Request Predictive Intervention Analyses from the AI Component to Identify When Financial Advisors Should Engage with Clients" as SFR015
    
    fa --> SFR015
  }
}

package "System Administrator" {
  actor SysAdmin
  
  usecase "SAFR001: Manage Analysis Parameters for the AI System to Ensure Algorithms Remain Accurate, Relevant, and Compliant With Financial Regulations Such As Basel III for Risk Management" as SAFR001
  
  SysAdmin --> SAFR001
}

package "System" {
  rectangle "Financial Insights System" {
    usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles to Support Better Financial Decision-Making" as SFR002
    
    c --> SFR002
    fa --> SFR002
    
    rectangle "AI Component" {
      usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
      
      c --> AIFR001
      fa --> AIFR001
    }
    
    rectangle "Notification Component" {
      usecase "SFR013: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR013
      
      c --> SFR013
      fa --> SFR013
      
      rectangle "Alert Sources" {
        usecase "SFR028: Request Anomaly Transaction Alerts from the AI Component by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance With FinCEN Requirements" as SFR028
        
        c --> SFR028
        fa --> SFR028
        
        usecase "SFR031: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as SFR031
        
        c --> SFR031
        fa --> SFR031
      }
    }
    
    rectangle "Recommendation Component" {
      usecase "SFR029: Request Personalized Recommendations from the AI Component Based on Each User's Financial Data and Preferences" as SFR029
      
      c --> SFR029
      fa --> SFR029
      
      usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance As Defined by Industry Standards Like FINRA Guidelines" as AIFR002
      
      c --> AIFR002
      fa --> AIFR002
    }
    
    rectangle "Spending Limit Component" {
      usecase "SFR030: Request Spending Limit Alerts from the AI Component When User Spending Patterns Exceed Defined Thresholds" as SFR030
      
      c --> SFR030
      
      usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations From Established Spending Patterns" as AIFR003
      
      c --> AIFR003
    }
    
    rectangle "Investment Opportunity Component" {
      usecase "SFR027: Request Investment Opportunity Analysis from the AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles, Time Horizons, and Financial Goals" as SFR027
      
      c --> SFR027
      fa --> SFR027
      
      usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
      
      c --> AIFR004
      
      usecase "SFR032: Request Specific Investment Opportunities from the AI Component That Match User Investment Criteria and ESG Preferences" as SFR032
      
      c --> SFR032
    }
    
    rectangle "Health Report Component" {
      usecase "SFR17: Generate Financial Health Reports that Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR17
      
      c --> SFR17
    }
  }
}

package "User Feedback" {
  actor User
  
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights to Help Improve Future Outputs" as CFR011
  
  User --> CFR011
}
@enduml