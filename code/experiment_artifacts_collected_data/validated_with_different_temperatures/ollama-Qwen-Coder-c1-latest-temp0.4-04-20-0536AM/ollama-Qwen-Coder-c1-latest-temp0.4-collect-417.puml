@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR002
  
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004

  CFR001 --> (CFR002) : Mentoring Sessions
}

package SystemAdmin {
  actor "System Administrator" as SAFR005
  
  usecase "SAFR006: Manage Analysis Parameters for the AI System" as SAFR006
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013

  CFR002 --> (FAFR004) : Configure Analysis Parameters
  
  SAFR005 --> (SAFR006) : Manage Analysis Parameters
}

package System {
  rectangle "System" {
    usecase "SFR007: Request Investment Opportunity Analysis from the AI Component" as SFR007
    usecase "SFR12: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as SFR12
    
    CFR001 --> (SFR013) : Alerts
    CFR001 --> (SFR12) : Dashboard
  }
}

package AI {
  rectangle "AI System" {
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
    
    FAFR002 --> (SFR013) : Predictive Insights
  }
}

package News {
  rectangle "News Service" {
    usecase "SFR009: Request Contextualized News Relevant to Users' Financial Portfolios from Trusted Financial News Sources" as SFR009
    
    CFR002 --> (SFR009) : News Insights
    CFR001 --> (SFR009) : News Insights
  }
}

package Feedback {
  rectangle "Feedback Mechanism" {
    usecase "CFR011: Send Feedback About the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as CFR011
    
    CFR002 --> (CFR011) : Provide Feedback
    SAFR005 --> (CFR011) : Provide Feedback
  }
}

@enduml