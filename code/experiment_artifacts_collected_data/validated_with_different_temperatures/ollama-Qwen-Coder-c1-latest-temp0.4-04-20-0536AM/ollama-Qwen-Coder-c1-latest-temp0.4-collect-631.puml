@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Receive Financial News Updates" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> (View Alerts) : CFR002
  C --> (Manage Recommendations Preferences) : CFR005
  C --> (Receive Personalized Recommendations) : CFR004
  C --> (Receive Financial News Updates) : CFR008
  C --> (Access Personalized Dashboard) : CFR009
  C --> (View Spending Limit Alerts) : CFR006
  C --> (Manage Relationship with Advisors) : CFR10
  
}

package "Financial Advisor" {
  actor FA as FFA

  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004

  FFA --> (Manage Mentoring Sessions) : FAFR001
  FFA --> (View Intervention Alerts) : FAFR002
  FFA --> (View Predictive Analytics) : FAFR003
  FFA --> (Configure Analysis Parameters for Client Segments) : FAFR004
  
}

package "System Administrator" {
  actor SysAdmin as SA

  usecase "SAFR001: Manage Analysis Parameters" as SAFR001

  SA --> (Manage System Analysis Parameters) : SAFR001
}

package "AI Component" {
  rectangle AIComp {

    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009

  }

}

package "System" {
  
  rectangle Sys {

    usecase "SFR001: Deliver Alerts to Users" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities from AI Component Matching User Criteria and ESG Preferences" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
    usecase "SFR010: Process Contextualized News to Extract Information for User's Financial Situations" as SFR010
    usecase "SFR011: Request Contextualized News Insights from AI Component Identifying Potential Impacts on Users' Investments" as SFR011
    usecase "SFR012: Generate Client Dashboards Presenting Financial Information in an Intuitive and Actionable Format" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions Ensuring Timely Notification of Important Financial Events" as SFR013
    usecase "SFR014: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component Identifying When Advisors Should Engage with Clients" as SFR015
    usecase "SFR016: Request Predictive Insights From the AI Component Enhancing Value of Financial Guidance Provided to Clients" as SFR016
    usecase "SFR017: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR017
    usecase "SFR018: Manage User's Financial Goals Tracking Progress Providing Relevant Recommendations" as SFR018
    usecase "SFR019: Maintain Historical Record of Users' Insights Enabling Trend Analysis Effectiveness Measurement" as SFR019
    usecase "SFR020: Manage User Feedback Continuously Improving Quality Relevance of Financial Insights" as SFR020

  }

}

package "User (Client, Financial Advisor, or System Administrator)" {
  
  actor Client as C
  actor FA as FFA
  actor SysAdmin as SA
  
  usecase "CFR11: Send Feedback to Improve Recommendations and Insights" as CFR11
  
  C --> (Send Feedback) : CFR11
  FFA --> (Send Feedback) : CFR11
  SA --> (Send Feedback) : CFR11

}

@enduml