@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations" as SFR002
  usecase "CFR005: Manage Recommendation Preferences" as CFR011
  
  Client --> (SAFR003)
  Client --> (SFR002)
  Client --> (CFR011)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  actor FinancialAdvisor as FAFR004
  
  usecase "FAFR002: View Intervention Alerts" as SAFR008
  usecase "FAFR003: View Predictive Analytics" as SFR016
  usecase "FAFR005: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FinancialAdvisor --> (SAFR002)
  FinancialAdvisor --> (SFR016)
  FinancialAdvisor --> (FAFR004)
}

package "System Administrator" {
  actor SystemAdministrator as SAFR001
  usecase "SAFR005: Manage Analysis Parameters for AI System" as SFR003
  
  SystemAdministrator --> (SAFR001)
  SystemAdministrator --> (SFR003)
}

rectangle "AI Component" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Based on Modern Portfolio Theory" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  
  SAFR001 --> (AIFR005)
  FAFR002 --> (AIFR008)
  FAFR003 --> (AIFR009)
  CFR004 --> (AIFR002)
  
  SFR002 --> (AIFR001)
  SAFR005 --> (AIFR007)
}

rectangle "System" {
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics for Financial Behavior and Performance" as SFR014
  
  SAFR008 --> (SFR012)
  FAFR005 --> (SFR017)
  
  SystemAdministrator --> (SAFR003)
}

@enduml