@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor "Client" as Client
actor "Financial Advisor" as FAdvisor
actor "System Administrator" as SysAdmin
actor "User" as User

rectangle "Client Functions" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  Client --> (SAFR002)
  User --> (SFR013)
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR001: Manage Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FAdvisor --> (SAFR001)
}

rectangle "System Functions" {
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
  usecase "SFR005: Request Spending Limit Alerts" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities with ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to User's Portfolio" as SFR009
  usecase "SFR010: Process Contextualized News for Users' Financial Situations" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI" as SFR011
  usecase "SFR012: Generate Client Dashboards in an Intuitive Format" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics for Financial Behavior and Performance" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI" as SFR015
  usecase "SFR016: Request Predictive Insights from AI to Enhance Guidance" as SFR016
  usecase "SFR017: Generate Financial Health Reports Based on Ratios and Metrics" as SFR017
  usecase "SFR018: Manage Users' Financial Goals for Progress Tracking and Recommendations" as SFR018
