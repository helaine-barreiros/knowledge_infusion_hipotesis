@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
  
  rectangle "Client System" {
    usecase "SFR02: Manage Users' Financial Goals" as SFR02
    usecase "SFR03: Maintain Historical Record of Insights" as SFR03
    usecase "SFR04: Manage User Feedback" as SFR04
    
    C --> SFR02
    C --> SFR03
    C --> SFR04
  }
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004
  
  rectangle "Financial Advisor System" {
    usecase "SFR05: Request Predictive Intervention Analyses" as SFR05
    
    FA --> SFR05
  }
}

package "System Administrator" {
  actor SysAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  
  SA --> SAFR001
}

rectangle "AI System" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities for Users" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  rectangle "AI System Components" {
    usecase "SFR12: Generate Client Dashboards" as SFR12
    usecase "SFR13: Generate Client Alerts Based on Predefined Conditions" as SFR13
    usecase "SFR14: Generate Client Analytics Providing Meaningful Insights" as SFR14
    
    AIFR001 --> SFR12
    AIFR002 --> SFR12
    AIFR003 --> SFR12
    AIFR004 --> SFR12
    AIFR005 --> SFR12
    
    AIFR006 --> SFR13
    AIFR007 --> SFR13
    AIFR008 --> SFR13
    AIFR009 --> SFR13
    
    AIFR001 --> SFR14
    AIFR002 --> SFR14
  }
}

package "System" {
  usecase "SFR06: Request Investment Opportunity Analysis from AI Component" as SFR06
  usecase "SFR07: Request Specific Investment Opportunities Based on User Criteria and ESG Preferences" as SFR007
  
  rectangle "Notification Channels" {
    usecase "SFR15: Deliver Alerts to Users Through Appropriate Notification Channels" as SFR15
    
    C --> SFR15
    FA --> SFR15
    SA --> SFR15
  }
}

package "News Processing" {
  rectangle "AI System Components" {
    usecase "SFR08: Request Contextualized News from Trusted Financial Sources" as SFR08
    usecase "SFR09: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR09
    
    AIFR007 --> SFR08
    AIFR007 --> SFR09
  }
}

package "User Feedback Management" {
  rectangle "AI System Components" {
    usecase "SFR16: Request User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR16
    
    C --> SFR16
    FA --> SFR16
    SA --> SFR16
  }
}

@enduml