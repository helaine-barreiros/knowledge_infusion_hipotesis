@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities Suitable to Risk Profile" as CFR007
  usecase "CFR008: View News Related to Investment Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (View Alerts on Anomalous Transactions) : CFR002
  C --> (Receive Alerts on Anomalous Transactions) : SFR008
  C --> (Manage Recommendation Preferences) : SAFR005
  C --> (Access Personalized Dashboard) : CFR10
}

package FinancialAdvisor {
  actor "Financial Advisor" as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FA --> (Manage Client Mentoring Sessions) : FAFR001
  FA --> (View Predictive Analytics About Clients' Financial Situations) : SFR016
}

package System {
  actor "System Admin" as SA
  
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Financial Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from the AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from the AI Component Based on User Data and Preferences" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from the AI Component When Spending Exceeds Thresholds" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from the AI Component Based on User Risk Profiles" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR014
  
  SA --> (Manage Analysis Parameters for AI System) : SAFR001
}

package AI {
  actor "AI System" as A
    
  usecase "AIFR002: Generate Personalized Recommendations Based on Industry Standards" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Patterns" as AIFR003
  
  A --> (Generate Personalized Recommendations) : SFR016
}

package Feedback {
  actor "User" as U
    
  usecase "CFR11: Send Feedback About System's Recommendations and Insights" as CFR11
  
  U --> (Send Feedback About System's Recommendations and Insights) : SAFR020
}
@enduml