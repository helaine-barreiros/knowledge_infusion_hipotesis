@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters for the AI System" as SAFR001
  SA --> (SAFR001)
}

rectangle "AI Component" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Based on Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  (SAFR001) --> (AIFR001)
  (CFR003, CFR004, FAFR002, SAFR001) --> (AIFR002)
  (CFR006) --> (AIFR003)
  (FAFR003, CFR007, FAFR005) --> (AIFR004)
  (SAFR001, FAFR004) --> (AIFR005)
  (SFR006, SAFR001) --> (AIFR006)
  (CFR008, SFR007) --> (AIFR007)
  (FAFR002, FAFR003) --> (AIFR008)
  (SFR014) --> (AIFR009)
}

rectangle "System" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities for Users" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to User's Financial Portfolio" as SFR009
  usecase "SFR010: Process Contextualized News for Users' Financial Situations" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
  usecase "SFR012: Generate Client Dashboards with Financial Information" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics Providing Meaningful Insights" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
  usecase "SFR016: Request Predictive Insights From the AI Component to Enhance Financial Guidance" as SFR016
  usecase "SFR017: Generate Financial Health Reports Assessing Users' Overall Wellbeing" as SFR017
  usecase "SFR018: Manage User's Financial Goals Tracking Progress and Recommendations" as SFR018
  usecase "SFR019: Maintain Historical Record of Users' Insights for Trend Analysis" as SFR019
  usecase "SFR020: Manage User Feedback to Continuously Improve System Outputs" as SFR020
  
  (SA, FA) --> (SFR001)
  (C, SA, FAFR004, SAFR001, AIFR003) --> (SFR002)
  (AIFR001, SFR008) --> (SFR003)
  (SA, FA, C, AIFR005) --> (SFR004)
  (C, FAFR003) --> (SFR005)
  (FA, SAFR001, SFR007) --> (SFR006)
  (AIFR002, AIFR008) --> (SFR009)
  (SA, FAFR003) --> (SFR010)
  (FA, SAFR001, SFR007) --> (SFR011)
  (C, FA, SA, AIFR002, AIFR004) --> (SFR012)
  (SA, C, FAFR003) --> (SFR013)
  (FA, SAFR001, SFR016) --> (SFR014)
  (AIFR008, AIFR009) --> (SFR015)
  (SA, C, FAFR002, AIFR003) --> (SFR017)
  (C, FA, SA) --> (SFR018)
  (AIFR004, SFR009) --> (SFR019)
  (SA, C, FAFR002, AIFR003) --> (SFR020)
}

rectangle "User" {
  usecase "CFR11: Send Feedback about System's Recommendations and Insights" as CFR11
  
  (C, FA, SA) --> (CFR11)
}
@enduml