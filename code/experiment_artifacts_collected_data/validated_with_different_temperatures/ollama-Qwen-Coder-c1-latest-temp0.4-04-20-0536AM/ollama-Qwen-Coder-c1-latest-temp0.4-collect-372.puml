@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
  
  usecase "CFR002: View Alerts" as SAFR002
  usecase "CFR003: View Financial Predictions" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations" as SAFR004
  usecase "CFR005: Manage Recommendation Preferences" as SAFR005
  usecase "CFR006: View Spending Limit Alerts" as SAFR006
  usecase "CFR012: Access Personalized Dashboard" as SAFR012
  
  CFR001 --> SAFR002 : "View Alerts"
  CFR001 --> SAFR003 : "View Financial Predictions"
  CFR001 --> SAFR004 : "Receive Personalized Recommendations"
  CFR001 --> SAFR005 : "Manage Recommendation Preferences"
  CFR001 --> SAFR006 : "View Spending Limit Alerts"
  CFR001 --> SAFR012 : "Access Personalized Dashboard"
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts" as SAFR007
  usecase "FAFR003: View Predictive Analytics" as SAFR008
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as SAFR019
  
  FAFR001 --> SAFR002 : "View Client Intervention Alerts"
  FAFR001 --> SAFR003 : "View Predictive Analytics"
  FAFR001 --> SAFR004 : "Configure Analysis Parameters for Specific Segments"
}

package System {
  actor "System" as SFR002
  
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as AIFR004
  usecase "SFR010: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as AIFR010
  usecase "SFR13: Generate Client Alerts Based on Predefined Conditions" as SFR013
  
  SFR002 --> AIFR004 : "Request Investment Opportunity Analysis from AI Component"
  SFR002 --> AIFR010 : "Process Contextualized News to Extract Relevant Information for Users' Financial Situations"
  SFR002 --> SFR013 : "Generate Client Alerts Based on Predefined Conditions"
}

package SystemAdmin {
  actor "System Administrator" as SAFR001
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR020: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR020
  
  SAFR001 --> SAFR001 : "Manage Analysis Parameters"
  SAFR001 --> SFR020 : "Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights"
}

package AI {
  actor "AI System" as AIFR001
  
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users Based on Their Risk Profiles, Time Horizons, and Financial Goals" as SAFR009
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
  
  AIFR001 --> SAFR009 : "Generate Investment Opportunity Analyses for Users Based on Their Risk Profiles, Time Horizons, and Financial Goals"
  AIFR001 --> AIFR006 : "Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements"
}

package User {
  actor "User (Client, Financial Advisor, or System Administrator)" as CFR011
  
  usecase "CFR011: Send Feedback" as SAFR021
  
  CFR011 --> SAFR021 : "Send Feedback"
}
@enduml