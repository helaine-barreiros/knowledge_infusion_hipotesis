@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as c
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  c --> (SAFR001)
  c --> (FAFR002)
  c --> (SFR003)
  c --> (AIFR004)
}

package "Financial Advisor" {
  actor FinancialAdvisor as fa
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  fa --> (SAFR001)
  fa --> (SFR006)
  fa --> (AIFR005)
}

package "System Administrator" {
  actor SystemAdmin as sa
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "CFR11: Send Feedback to Improve Recommendations and Insights" as CFR11
  
  sa --> (SFR020)
}

package "System Components" {
  rectangle SystemComponents {
    usecase "SFR001: Deliver Alerts" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
    usecase "SFR005: Request Spending Limit Alerts" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities Matching Criteria and Preferences" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Portfolios" as SFR009
    usecase "SFR010: Process Contextualized News for User Information Extraction" as SFR010
    usecase "SFR011: Request Contextualized News Insights from AI" as SFR011
    usecase "SFR012: Generate Client Dashboards with Financial Data in an Intuitive Format" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
    usecase "SFR014: Generate Client Analytics Providing Meaningful Insights into Behavior and Performance" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses from AI" as SFR015
    usecase "SFR016: Request Predictive Insights to Enhance Financial Guidance Value" as SFR016
    usecase "SFR017: Generate Financial Health Reports Assessing Overall Wellbeing" as SFR017
    usecase "SFR018: Manage Users' Financial Goals for Progress Tracking and Recommendations" as SFR018
    usecase "SFR019: Maintain Historical Record of Insights for Trend Analysis" as SFR019
    
  }
}

package "AI System Components" {
  rectangle AIComponents {
    usecase "AIFR001: Generate Financial Predictions Based on Data and Trends" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses Based on User Criteria and Risk Profiles" as AIFR004
    usecase "AIFR005: Identify Financial Instruments Aligning with Users' Strategies and Modern Portfolio Theory" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts Employing Pattern Recognition for Fraud Detection" as AIFR006
    usecase "AIFR007: Correlate Financial News with User Portfolios to Identify Relevant Impacts" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations Based on Identified Patterns" as AIFR008
    usecase "AIFR009: Provide Forward-Looking Analysis of Financial Situations for Effective Planning" as AIFR009
    
  }
}

@enduml