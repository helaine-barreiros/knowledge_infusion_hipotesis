@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FinancialAdvisor
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  usecase "CFR011: Send Feedback about System Recommendations and Insights" as CFR011

  Client --> CFR001
  Client --> FAFR002
  SysAdmin --> SAFR001
  FinancialAdvisor --> FAFR002
}

rectangle "Client Dashboard" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009

  Client --> CFR009
}

rectangle "Financial Recommendations" {
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "SAFR005: Manage Recommendation Preferences" as SAFR005

  Client --> CFR004
  SysAdmin --> SAFR005
}

rectangle "Spending Limits and Alerts" {
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005

  Client --> CFR006
}

rectangle "Investment Opportunities" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006

  Client --> CFR007
}

rectangle "News and Information" {
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013

  Client --> CFR008
}

rectangle "Client Relationship Management" {
  usecase "CFR10: Manage My Relationship with Financial Advisors" as CFR10

  Client --> CFR10
}
@enduml