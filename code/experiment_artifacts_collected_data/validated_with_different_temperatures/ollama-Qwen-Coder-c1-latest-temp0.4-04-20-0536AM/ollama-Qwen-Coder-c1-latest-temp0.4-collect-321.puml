@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  Client --> (SAFR003)
  Client --> (SFR007)
  Client --> (AIFR004)
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  
  FinancialAdvisor --> (SFR015)
}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  SystemAdmin --> (AIFR002)
}

package "Notifications and Alerts" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  
  Client --> (SFR001)
  FinancialAdvisor --> (SFR001)
  SystemAdministrator --> (SFR001)
  
  rectangle "Notification Channels" {
    usecase "Email Notification" as Email
    usecase "SMS Notification" as SMS
    
    SFR001 --> (Email)
    SFR001 --> (SMS)
  }
}

package "Recommendations and Insights Generation" {
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  
  Client --> (SFR002)
  FinancialAdvisor --> (SFR002)
  
  rectangle "Recommendation Sources" {
    usecase "Industry Standards and Guidelines" as IndustryStandards
    usecase "User Profiles and Goals" as UserProfile
    
    SFR002 --> (AIFR002)
    AIFR002 --> (UserProfile)
    AIFR002 --> (IndustryStandards)
  }
}

package "Predictive Analytics and Insights Generation" {
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  
  Client --> (SFR003)
  
  rectangle "Prediction Inputs" {
    usecase "Historical Transaction Data" as HistoricalData
    usecase "Market Trends and Economic Indicators" as MarketTrends
    
    SFR003 --> (AIFR001)
    AIFR001 --> (HistoricalData)
    AIFR001 --> (MarketTrends)
  }
}

package "Spending Limit Alerts Generation" {
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
  
  Client --> (SFR005)
  
  rectangle "Spending Pattern Analysis Inputs" {
    usecase "Established Spending Patterns" as EstablishedPatterns
    
    SFR005 --> (AIFR003)
    AIFR003 --> (EstablishedPatterns)
  }
}

package "Investment Opportunity Generation" {
  usecase "SFR006: Request Investment Opportunities from AI Component" as SFR006
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  
  Client --> (SFR006)
  
  rectangle "Investment Analysis Inputs" {
    usecase "User Risk Profiles and Goals" as UserRiskProfile
    usecase "Time Horizons" as TimeHorizon
    
    SFR006 --> (AIFR004)
    AIFR004 --> (UserRiskProfile)
    AIFR004 --> (TimeHorizon)
  }
}

package "News and Insights Generation" {
  usecase "SFR008: Request Contextualized News from AI Component" as SFR008
  usecase "AIFR007: Generate Contextualized News Insights for Users" as AIFR007
  
  Client --> (SFR008)
  
  rectangle "News Correlation Inputs" {
    usecase "User Portfolios and ESG Preferences" as UserPortfolio
    
    SFR008 --> (AIFR007)
    AIFR007 --> (UserPortfolio)
  }
}

package "Feedback Management" {
  usecase "CFR11: Send Feedback about System's Recommendations and Insights" as CFR11
  
  Client --> (SFR020)
  
  rectangle "Feedback Processing" {
    usecase "AIFR009: Generate Predictive Intervention Recommendations Based on User Feedback" as AIFR009
    
    SFR020 --> (AIFR009)
  }
}

@enduml