@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Deliver Personalized Recommendations" as SFR003
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  CFR001 --> Sys
  SAFR001 --> SysAdmin
  FAFR002 --> FAFD
  SFR003 --> Sys
  AIFR002 --> Sys
}

rectangle "Client Dashboard and Alerts" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "SFR014: Generate Client Analytics" as SFR014
  
  CFR009 --> Sys
  SFR014 --> Sys
}

rectangle "Investment Opportunities and News" {
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "SFR008: Request Contextualized News Insights" as SFR008
  
  CFR007 --> Sys
  SFR008 --> Sys
}

rectangle "Spending Limits and Recommendations Preferences" {
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
  usecase "SAFR005: Manage Personalized Recommendations Preferences" as SAFR005
  
  CFR010 --> SysAdmin
  SAFR005 --> SysAdmin
}

rectangle "Feedback Management" {
  usecase "CFR011: Send Feedback" as CFR011
  
  CFR011 --> Sys
}
@enduml