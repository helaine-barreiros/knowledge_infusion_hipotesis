@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR003: View Financial Predictions" as SAFR004
  usecase "CFR004: Receive Personalized Recommendations" as SAFR005
  usecase "CFR005: Manage Recommendation Preferences" as SAFR006
  usecase "CFR006: View Spending Limit Alerts" as SAFR007
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as SAFR008
  usecase "CFR008: View News Related to My Investment Portfolio" as SAFR012
  usecase "CFR009: Access Personalized Dashboard" as SFR014
  
  CFR001 --> SAFR003
  CFR001 --> SAFR004
  CFR001 --> SAFR005
  CFR001 --> SAFR006
  CFR001 --> SAFR007
  CFR001 --> SAFR008
  CFR001 --> SAFR012
  CFR001 --> SFR014
  
}

package "Financial Advisors" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts" as SAFR008
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as AIFR009
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR005
  
  CFR011 --> SAFR008
  CFR011 --> AIFR009
  CFR011 --> FAFR005
}

package "System Administrator" {
  actor SystemAdmin as SAFR001
  
  usecase "SAFR001: Manage Analysis Parameters for the AI System" as SAFR001
  
  CFR011 --> SAFR001
}

rectangle "AI Component" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities for Users" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR016
  
  SAFR004 --> AIFR002
  SAFR005 --> AIFR003
  SAFR007 --> AIFR008
  SAFR008 --> AIFR009
}

package "Notifications" {
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  
  CFR002 --> SFR013
  FAFR002 --> SFR013
  SAFR008 --> SFR013
}

package "Dashboards and Reports" {
  usecase "SFR014: Generate Client Analytics That Provide Meaningful Insights into Financial Behavior and Performance" as SFR014
  
  CFR009 --> SFR014
  FAFR002 --> SFR014
}

package "Feedback Management" {
  usecase "CFR011: Send Feedback About System's Recommendations and Insights" as AIFR018
  
  SAFR005 --> AIFR018
  AIFR009 --> AIFR018
}
@enduml