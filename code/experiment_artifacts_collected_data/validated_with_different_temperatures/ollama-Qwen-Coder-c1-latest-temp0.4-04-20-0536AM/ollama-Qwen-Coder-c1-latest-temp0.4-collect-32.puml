@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR

rectangle "System" {
    usecase "CFR001: View Financial Insights Dashboard" as CFR001
    usecase "SAFR001: Manage Analysis Parameters" as SAFR001
    usecase "FAFR004: Configure analysis parameters for specific client segments" as FAFR004
    usecase "SFR002: Deliver personalized recommendations to users based on their financial profiles" as SFR002
    usecase "AIFR002: Generate personalized recommendations for users based on their financial profiles, goals, and risk tolerance" as AIFR002

    Client --> CFR001
    SysAdmin --> SAFR001
    FAFR --> FAFR004
}

rectangle "Client Dashboard Features" {
    usecase "CFR009: Access a personalized dashboard that consolidates my financial information in a single view to efficiently monitor my finances." as CFR009
    Client --> CFR009

    rectangle "Financial Insights and Predictions" {
        usecase "CFR003: View financial predictions based on my historical data and current market trends to make more informed financial decisions and plan for future expenses." as CFR003
        usecase "SFR005: Request spending limit alerts from the AI component when user spending patterns exceed defined thresholds."
        usecase "AIFR004: Generate investment opportunity analyses for users by evaluating potential investments against their risk profiles, time horizons, and financial goals."

        Client --> CFR003
    }

    rectangle "Personalized Recommendations" {
        usecase "CFR002: Receive alerts about anomalous transactions in my accounts to quickly identify potential fraud or unusual spending patterns according to regulations set by the Financial Action Task Force (FATF)."
        usecase "SFR014: Generate client analytics that provide meaningful insights into financial behavior and performance."
        usecase "AIFR002: Generate personalized recommendations for users based on their financial profiles, goals, and risk tolerance."

        Client --> CFR002
    }

    rectangle "Spending Limits" {
        usecase "CFR010: Manage my relationship with Financial Advisors, including permissions for sharing my financial data, to maintain privacy and control over my financial information."
        usecase "SFR005: Request spending limit alerts from the AI component when user spending patterns exceed defined thresholds."

        Client --> CFR010
    }
}

rectangle "Financial Advisor Features" {
    usecase "FAFR002: Manage client mentoring sessions based on system-generated insights to provide more valuable guidance aligned with each client's financial goals."
    FAFR --> FAFR002

    rectangle "Client Intervention Alerts" {
        usecase "FAFR001: View client intervention alerts when the system detects patterns requiring professional attention to proactively assist clients with potential financial issues."
        FAFR --> FAFR001
    }

    rectangle "Predictive Analytics" {
        usecase "FAFR003: View predictive analytics about my clients' financial situations to provide data-driven recommendations during consultations."
        FAFR --> FAFR003

        usecase "SFR016: Request predictive insights from the AI component to enhance the value of financial guidance provided to clients."
        SFR016 <|-- (FAFR003)
    }

    rectangle "Client Segments" {
        usecase "AIFR004: Generate investment opportunity analyses for users by evaluating potential investments against their risk profiles, time horizons, and financial goals."

        FAFR --> AIFR004
    }
}

rectangle "System Features" {
    usecase "SFR013: Request client alerts based on predefined conditions to ensure timely notification of important financial events."
    SFR013 <|-- (CFR002)
    SFR013 <|-- (FAFR002)

    usecase "AIFR006: Generate anomaly transaction alerts by employing pattern recognition to detect potentially fraudulent activities in compliance with FinCEN requirements."

    SystemAdmin --> SAFR001
}

rectangle "Feedback" {
    usecase "CFR011: Send feedback about the system's recommendations and insights to help improve the accuracy and relevance of future outputs."
    Client --> CFR011

    FAFR --> CFR011

    SysAdmin --> SAFR001
}
@enduml