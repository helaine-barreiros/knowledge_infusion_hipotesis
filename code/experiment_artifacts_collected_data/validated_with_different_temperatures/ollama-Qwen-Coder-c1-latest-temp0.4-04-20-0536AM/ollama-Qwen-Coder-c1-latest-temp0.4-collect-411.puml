@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as SAFR004
  usecase "CFR004: Receive Personalized Recommendations Aligned with Financial Profile and Goals" as SAFR005
  usecase "CFR006: Manage Personalized Recommendations Preferences" as SAFR013
  usecase "CFR007: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as SAFR014
  usecase "CFR008: View Investment Opportunities Suitable to My Risk Profile" as SAFR026
  usecase "CFR009: View News Related to My Investment Portfolio" as SAFR037
  usecase "CFR10: Access a Personalized Dashboard that Consolidates Financial Information in a Single View" as SAFR048
  
  CFR001 --> SAFR002 : "View Alerts"
  CFR001 --> SAFR003 : "View Predictions"
  CFR001 --> SAFR004 : "Receive Recommendations"
  CFR001 --> SAFR005 : "Manage Preferences"
  CFR001 --> SAFR013 : "Manage Spending Limits"
  CFR001 --> SAFR026 : "View Investment Opportunities"
  CFR001 --> SAFR037 : "View News"
  CFR001 --> SAFR048 : "Access Dashboard"
}

package "Financial Advisors" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts When System Detects Patterns Requiring Professional Attention" as SAFR035
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as SAFR046
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments to Customize System's Behavior According to Different Client Profiles and Regulatory Requirements Such As GDPR Or CCPA" as SAFR057
  
  FAFR001 --> SAFR035 : "View Alerts"
  FAFR001 --> SAFR046 : "Provide Recommendations"
  FAFR001 --> SAFR057 : "Configure Parameters"
}

package "System" {
  actor System as SFR002
  
  usecase "SFR003: Request Financial Predictions From the AI Component to Provide Users With Forward-Looking Financial Insights" as AIFR001
  usecase "SFR004: Request Personalized Recommendations From the AI Component Based on Each User's Financial Data and Preferences" as AIFR002
  usecase "SFR005: Request Spending Limit Alerts From the AI Component When User Spending Patterns Exceed Defined Thresholds" as AIFR013
  usecase "SFR006: Request Investment Opportunity Analysis From the AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles" as AIFR027
  
  SFR002 --> AIFR001 : "Request Predictions"
  SFR002 --> AIFR002 : "Request Recommendations"
  SFR002 --> AIFR013 : "Request Spending Alerts"
  SFR002 --> AIFR027 : "Request Investment Opportunities"
}

package "AI System" {
  actor AI as AIFR003
  
  usecase "AIFR004: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as SAFR015
  usecase "AIFR006: Generate Anomaly Transaction Alerts By Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance With FinCEN Requirements" as SAFR029
  
  AI --> SAFR015 : "Generate Predictions"
  AI --> SAFR029 : "Generate Alerts"
}

package "System Administrator" {
  actor SystemAdmin as SAFR006
  
  usecase "SAFR007: Manage Analysis Parameters for the AI System to Ensure Algorithms Remain Accurate, Relevant, and Compliant With Financial Regulations Such As Basel III For Risk Management" as AIFR014
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights To Help Improve the Accuracy and Relevance of Future Outputs" as SAFR058
  
  SAFR006 --> SAFR07 : "Manage Parameters"
  SAFR006 --> SAFR058 : "Send Feedback"
}

@enduml