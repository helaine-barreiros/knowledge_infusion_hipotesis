@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR009
  usecase "CFR003: View Financial Predictions Based on Historical Data and Current Trends" as SAFR007
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as SAFR010
  usecase "CFR005: Manage Personalized Recommendations Preferences" as SAFR008
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as SAFR004
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile (as Defined Under MiFID II or Equivalent Standards)" as SAFR012
  usecase "CFR008: View News Related to My Investment Portfolio" as SAFR015
  usecase "CFR009: Access a Personalized Dashboard that Consolidates Financial Information in a Single View" as SAFR014
  usecase "CFR10: Manage Relationship with Financial Advisors, Including Permissions for Sharing Financial Data" as SAFR023
  
  CFR001 --> SAFR009
  CFR001 --> SAFR007
  CFR001 --> SAFR010
  CFR001 --> SAFR008
  CFR001 --> SAFR004
  CFR001 --> SAFR012
  CFR001 --> SAFR015
  CFR001 --> SAFR014
  CFR001 --> SAFR023
  
  CFR011 --> (Send Feedback)
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts When the System Detects Patterns Requiring Professional Attention" as SFR016
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as SAFR017
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments to Customize the System's Behavior According to Different Client Profiles and Regulatory Requirements Such As GDPR or CCPA" as SFR025
  
  FAFR001 --> (Manage Client Mentoring Sessions)
  FAFR001 --> SAFR016
  FAFR001 --> SAFR017
  FAFR001 --> SAFR025
}

package System {
  actor "System" as SFR009
  
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as AIFR006
  usecase "SFR014: Generate Client Analytics That Provide Meaningful Insights into Financial Behavior and Performance" as SAFR027
  
  SFR009 --> (Deliver Alerts)
  SFR009 --> (Deliver Personalized Recommendations)
  SFR009 --> AIFR006
  SFR009 --> SAFR027
}

package AI {
  actor "AI" as AIFR018
  
  usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as SFR015
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as SAFR028
  
  AIFR018 --> (Generate Predictive Intervention Recommendations)
  AIFR018 --> SFR015
  AIFR018 --> SAFR028
}

@enduml