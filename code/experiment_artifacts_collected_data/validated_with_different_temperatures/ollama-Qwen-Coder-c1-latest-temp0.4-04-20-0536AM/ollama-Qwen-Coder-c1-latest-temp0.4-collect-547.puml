@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (SAFR002) : Receive Alerts
  C --> (SFR003) : Request Predictions
  C --> (AIFR004) : Generate Recommendations
  C --> (AIFR005) : Generate Opportunities
  C --> (AIFR006) : Generate Anomaly Alerts
  C --> (AIFR007) : Generate News Insights
  
  CFR11 <|-- C
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (SFR016) : Enhance Financial Guidance
}

package "System Administrator" {
  actor SysAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SA --> (AIFR002) : Generate Recommendations
  SA --> (SFR015) : Request Predictive Interventions
}

package "System" {
  rectangle SystemBoundary {
    usecase "SFR001: Deliver Alerts" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
    usecase "SFR005: Request Spending Limit Alerts" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities Matching Criteria and Preferences" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Portfolios" as SFR009
    usecase "SFR010: Process Contextualized News for User Financial Situations" as SFR010
    usecase "SFR011: Request Contextualized News Insights from AI" as SFR011
    usecase "SFR012: Generate Client Dashboards in Intuitive Format" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
    usecase "SFR014: Generate Client Analytics Providing Insights into Financial Behavior and Performance" as SFR014
    usecase "SFR017: Generate Financial Health Reports Assessing Users' Overall Wellbeing" as SFR017
  }
}

package "AI System" {
  rectangle AIBoundary {
    usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations Based on Profiles and Goals" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Patterns" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users Considering Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Matching User Strategies and Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts Using Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News with User Portfolios for Relevant Impacts Identification" as AIFR007
  }
}

@enduml