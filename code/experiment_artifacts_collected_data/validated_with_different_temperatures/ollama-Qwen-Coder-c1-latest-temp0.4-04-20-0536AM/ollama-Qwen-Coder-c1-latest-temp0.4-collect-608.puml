@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  
  Client --> (CFR001)
  SysAdmin --> (SAFR001)
  
  rectangle "Client Actions" {
    Client --> (SFR009) : "View News"
    Client --> (FAFR004) : "Configure Analysis Parameters for Specific Segments"
    Client --> (AIFR006) : "Generate Anomaly Transaction Alerts"
    Client --> (SAFR005) : "Manage Personalized Recommendations Preferences"
  }
  
  rectangle "Financial Advisor Actions" {
    FAFR001 --> (FAFR003) : "View Predictive Analytics about Clients' Financial Situations"
    FAFR001 --> (FAFR004) : "Configure Analysis Parameters for Specific Segments"
    FAFR001 --> (AIFR006) : "Generate Anomaly Transaction Alerts"
  }
  
  rectangle "System Actions" {
    Sys --> (SFR002) : "Deliver Personalized Recommendations to Users"
    Sys --> (SFR003) : "Request Financial Predictions from AI Component"
    Sys --> (AIFR016) : "Generate Client Predictive Insights for Enhanced Guidance"
  }
}

rectangle "User Actions" {
  User --> (CFR011)
}
@enduml