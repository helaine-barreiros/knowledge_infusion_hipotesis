@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
}

package "System Administrator" {
  actor SysAdmin as SAFR003
}

rectangle "User Interface" {
  usecase "CFR009: View Personalized Dashboard" as CFR009
  
  Client --> (CFR001)
  FinancialAdvisor --> (FAFR002)
  SysAdmin --> (SAFR003)
  
  rectangle "Financial Insights" {
    usecase "CFR001: View Financial Insights Dashboard" as CFR001
    usecase "CFR005: Manage Personalized Recommendations Preferences" as CFR005
    
    Client --> (CFR001)
    Client --> (CFR005)
  }
  
  rectangle "Alerts and Notifications" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    usecase "SAFR002: Manage Analysis Parameters for AI System" as SAFR002
    
    Client --> (SFR001)
    FinancialAdvisor --> (FAFR002)
  }
  
  rectangle "Recommendations and Predictions" {
    usecase "CFR004: Receive Personalized Recommendations" as CFR004
    usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
    
    Client --> (CFR004)
  }
  
  rectangle "Spending Limits and Alerts" {
    usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
    usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
    
    Client --> (CFR010)
  }
  
  rectangle "Investment Opportunities and Insights" {
    usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
    
    Client --> (CFR007)
  }
  
  rectangle "News and Updates" {
    usecase "CFR012: View News Related to My Investment Portfolio" as CFR012
    usecase "AIFR008: Generate Contextualized News Insights for Users" as AIFR008
    
    Client --> (CFR012)
  }
}

rectangle "System Components" {
  rectangle "AI Engine" {
    usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
    usecase "AIFR005: Identify Suitable Investments Based on User Profiles and Strategies" as AIFR005
    
    Client --> (AIFR001)
  }
  
  rectangle "Notification System" {
    usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    
    Client --> (SFR002)
  }
  
  rectangle "Data Management and Analytics" {
    usecase "AIFR006: Generate Anomaly Transaction Alerts for Users" as AIFR006
    usecase "SFR014: Request Predictive Insights from AI Component to Enhance Financial Guidance" as SFR014
    
    Client --> (AIFR006)
  }
}

rectangle "User Feedback Loop" {
  usecase "CFR11: Send Feedback About Recommendations and Insights" as CFR11
  
  Client --> (CFR11)
}
@enduml