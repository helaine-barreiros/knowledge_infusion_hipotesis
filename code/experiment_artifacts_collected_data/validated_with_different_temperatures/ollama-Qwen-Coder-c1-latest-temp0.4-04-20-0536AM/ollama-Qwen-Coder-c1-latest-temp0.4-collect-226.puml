@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

' Actors
actor Client as CFR001
actor FinancialAdvisor as FAFR002
actor SysAdmin as SAFR003

'System and Components
rectangle "System" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities from AI" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
  usecase "SFR010: Process Contextualized News for Users" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI" as SFR011
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics Providing Meaningful Insights" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI" as SFR015
  usecase "SFR016: Request Predictive Insights from AI" as SFR016
  usecase "SFR017: Generate Financial Health Reports" as SFR017
  usecase "SFR018: Manage Users' Financial Goals to Track Progress and Provide Relevant Recommendations" as SFR018
  usecase "SFR019: Maintain a Historical Record of Users' Insights for Trend Analysis" as SFR019
  usecase "SFR020: Manage User Feedback to Continuously Improve System Outputs" as SFR020

  ' AI Components
  rectangle "AI Component" {
    usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations Based on User Profiles and Goals" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Patterns" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users Based on Their Risk Profiles and Financial Goals" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Aligning with User Strategies and Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News With Specific User Portfolios to Identify Relevant Impacts" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009

  }
}

' Relationships
CFR001 --> SFR002 : "View Personalized Recommendations"
CFR001 --> SFR003 : "Request Financial Predictions from AI"
CFR001 --> SFR004 : "Receive Personalized Recommendations Based on User Profiles and Goals" 
CFR001 --> SFR005 : "Manage Spending Limit Alerts by Identifying Unusual Deviations From Established Patterns" 
CFR001 --> SFR006 : "Request Investment Opportunity Analysis for Users Based On Their Risk Profiles And Financial Goals"
CFR001 --> SFR007 : "Generate Specific Investment Opportunities That Match User Investment Criteria and ESG Preferences"
CFR001 --> SFR008 : "Receive Anomaly Transaction Alerts From AI Component To Detect Potentially Fraudulent Activities In Compliance With FinCEN Requirements" 
CFR001 --> SFR009 : "Find Contextualized News Relevant to Users' Financial Portfolios"
CFR001 --> SFR012 : "Generate Client Dashboards That Present Financial Information in An Intuitive and Actionable Format"

FAFR002 --> SFR003 : "View Predictive Analytics About Clients’ Financial Situations To Provide Data-Driven Recommendations During Consultations" 
FAFR002 --> SFR004 : "Request Personalized Recommendations From AI Component Based On Each User’s Financial Data and Preferences"
FAFR002 --> SFR016 : "Receive Predictive Insights From AI Component To Enhance The Value Of Financial Guidance Provided to Clients"

SAFR003 --> AIFR001 : "Manage Analysis Parameters for the AI System To Ensure Algorithms Remain Accurate, Relevant, and Compliant With Financial Regulations Such As Basel III For Risk Management"
FAFR002 --> SFR005 : "Receive Spending Limit Alerts From AI Component When User Spending Patterns Exceed Defined Thresholds" 
SAFR003 --> AIFR004 : "Configure Analysis Parameters for Specific Client Segments To Customize the System’s Behavior According to Different Client Profiles and Regulatory Requirements Such As GDPR Or CCPA"
FAFR002 --> SFR015 : "Request Predictive Intervention Analyses From AI Component To Identify When Financial Advisors Should Engage With Clients"

CFR011 --> SFR020 : "Send Feedback About the System’s Recommendations And Insights to Help Improve Accuracy and Relevance of Future Outputs"
FAFR002 --> AIFR008 : "Generate Client Predictive Intervention Recommendations By Identifying Patterns Indicating Potential Financial Difficulties Or Opportunities Requiring Advisor Engagement"

@enduml