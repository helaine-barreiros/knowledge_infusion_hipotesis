@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR002
}

package SystemAdmin {
  actor "System Administrator" as SAFR003
}

rectangle "User Interface" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "SFR12: Generate Client Dashboards" as SFR12
  
  CFR001 --> CFR009
  FAFR002 --> CFR009
  SAFR003 --> CFR009
}

rectangle "Financial Insights & Recommendations" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SFR04: Request Personalized Recommendations" as SFR04
  
  CFR001 --> CFR001
  FAFR002 --> SFR04
  SAFR003 --> SFR04
}

rectangle "Alerts & Notifications" {
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "SFR13: Generate Client Alerts" as SFR13
  
  CFR001 --> CFR002
  FAFR002 --> CFR002
  SAFR003 --> CFR002
  
  CFR001 --> SFR13
}

rectangle "Spending Limits & Budget Management" {
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "SFR05: Request Spending Limit Alerts" as SFR05
  
  CFR001 --> CFR006
  FAFR002 --> CFR006
  SAFR003 --> CFR006
  
  CFR001 --> SFR05
}

rectangle "Investment Opportunities & Portfolio Management" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "SFR06: Request Investment Opportunity Analysis" as SFR06
  
  CFR001 --> CFR007
  FAFR002 --> CFR007
  SAFR003 --> CFR007
  
  CFR001 --> SFR06
}

rectangle "News & Market Information" {
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "SFR09: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR09
  
  CFR001 --> CFR008
  FAFR002 --> CFR008
  SAFR003 --> CFR008
  
  CFR001 --> SFR09
}

rectangle "System Management & Configuration" {
  usecase "SAFR001: Manage Analysis Parameters for the AI System" as SAFR001
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  SAFR003 --> SAFR001
  FAFR002 --> FAFR004
}

rectangle "Feedback & Improvement" {
  usecase "CFR11: Send Feedback about System's Recommendations and Insights" as CFR11
  
  CFR001 --> CFR11
  FAFR002 --> CFR11
  SAFR003 --> CFR11
}
@enduml