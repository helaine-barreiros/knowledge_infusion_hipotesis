@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

' Actors
actor Client as CFR001
actor FinancialAdvisor as FAFR002
actor SystemAdmin as SAFR003
actor User as CFR011

package "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR010
  
  CFR001 --> (View)
  CFR002 --> (Alerts)
  CFR003 --> (Predictions)
  CFR004 --> (Recommendations)
  CFR005 --> (Preferences Management)
  CFR006 --> (Spending Alerts)
  CFR007 --> (Investment Opportunities)
  CFR008 --> (News)
  CFR009 --> (Dashboard Access)
  CFR010 --> (Relationship Management)
}

package "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Clients" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FAFR001 --> (Sessions Management)
  FAFR002 --> (Intervention Alerts)
  FAFR003 --> (Analytics View)
  FAFR004 --> (Parameters Configuration)
}

package "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  
  SAFR001 --> (Parameter Management)
}

' Relationships
CFR001 -> CFR002 : Alerts
CFR003 -> SFR006 : Predictions
CFR004 -> AIFR002 : Recommendations
SAFR001 <|-- FAFR004 : Configuration

@enduml