@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FAFR001

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  
  User --> CFR001
  SysAdmin --> SAFR001
}

rectangle "Financial Advisor" {
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FinancialAdvisor --> (FAFR001)
  FinancialAdvisor --> FAFR002
  FinancialAdvisor --> FAFR003
  FinancialAdvisor --> FAFR004
}

rectangle "System Functions" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  
  User --> (SFR001)
  FinancialAdvisor --> (FAFR004) : <|-- (SFR003)
}

rectangle "AI System Functions" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  User --> (SFR002)
}

rectangle "Client Relationship Management" {
  usecase "CFR010: Manage Client Relationships with Financial Advisors" as CFR010
  usecase "AIFR005: Generate Investment Opportunities for Users" as AIFR005
  
  User --> (SFR002)
}

rectangle "News and Analytics" {
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  
  User --> (SFR013)
}

rectangle "Dashboard and Analytics" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
  
  User --> (SFR012)
}

rectangle "Feedback Management" {
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights" as CFR11
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  User --> (SFR020)
}

@enduml