@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Current Trends" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as SAFR004
  usecase "CFR005: Manage Personalized Recommendations Preferences to Ensure Relevance" as SAFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as SAFR006
  usecase "CFR012: Generate Client Dashboards that Present Financial Information Intuitively and Actionably" as SFR012
  
  CFR001 --> (SAFR002)
  CFR001 --> (SAFR003)
  CFR001 --> (SAFR004)
  CFR001 --> (SAFR005)
  CFR001 --> (SAFR006)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
  
  usecase "FAFR003: View Predictive Analytics about My Clients' Financial Situations for Data-Driven Recommendations During Consultations" as SAFR007
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments to Customize System Behavior According to Different Profiles and Regulatory Requirements" as AIFR004
  
  FAFR002 --> (SAFR003)
  FAFR002 --> (AIFR004)
}

package "System Administrator" {
  actor SysAdmin as SAFR001
  usecase "SAFR009: Maintain a Historical Record of Users' Insights to Enable Trend Analysis and Effectiveness Measurement" as SFR009
  
  SAFR001 --> (SFR009)
}

package "System Components" {
  rectangle "AI System" {
    usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities by Identifying Financial Instruments Aligning with User Strategies and Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News With Specific User Portfolios Identifying Relevant Impacts" as AIFR007
  }
  
  rectangle "Notification System" {
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR013
  }
}

package "User Feedback Management" {
  actor User as CFR011
  
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights to Help Improve Future Outputs" as AIFR008
  
  CFR011 --> (AIFR008)
}
@enduml