  usecase "SFR014: Generate Client Analytics that Provide Meaningful Insights into Financial Behavior and Performance" as SFR014
  
  Sys --> (AIFR009)
}

rectangle "AI Functions" {
  usecase "AIFR018: Request Predictive Insights from AI Component to Enhance the Value of Financial Guidance Provided to Clients" as AIFR016
  usecase "AIFR020: Generate Client Predictive Intervention Recommendations by Identifying Patterns that Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR018
  
  Sys --> (FAFR015)
}

rectangle "Client Functions" {
  usecase "CFR11: Send Feedback about System's Recommendations and Insights" as CFR11
  
  Client --> (SFR020)
}
