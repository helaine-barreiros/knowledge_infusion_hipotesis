@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  
  Client --> (CFR001)
  SysAdmin --> (SAFR001)
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as FAFR003
  
  FAFD --> (FAFR001)
  FAFD --> (FAFR002)
}

rectangle "System Functions" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  
  Sys --> (SFR001)
  Sys --> (SFR002)
}

rectangle "AI Functions" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  
  Sys --> (SFR003)
  Sys --> (SFR004)
}

rectangle "Client Functions" {
  usecase "CFR005: Manage Personalized Recommendations Preferences" as CFR005
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
  
  Client --> (CFR005)
  Client --> (SFR020)
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  usecase "FAFR016: Request Predictive Insights from AI Component" as FAFR016
  
  FAFD --> (SFR013)
}

rectangle "System Functions" {
  usecase "SFR005: Request Spending Limit Alerts" as SFR005
  usecase "SFR007: Request Investment Opportunity Analysis" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts" as SFR008
  
  Sys --> (AIFR003)
}

rectangle "AI Functions" {
  usecase "AIFR012: Generate Client Dashboards" as AIFR012
  usecase "AIFR017: Generate Financial Health Reports" as AIFR017
  
  Sys --> (SFR015)
}

rectangle "Client Functions" {
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR008: View News Related to Investment Portfolio" as CFR008
  
  Client --> (AIFR007)
}

rectangle "Financial Advisor Functions" {
