@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Financial Advisor Relationship" as CFR10
  
  C --> CFR001 : "View"
  C --> CFR002 : "Receive Alerts"
  C --> CFR003 : "Predictions"
  C --> CFR004 : "Recommendations"
  C --> CFR005 : "Manage Preferences"
  C --> CFR006 : "Spending Limits"
  C --> CFR007 : "Investment Opportunities"
  C --> CFR008 : "News Related to Portfolio"
  C --> CFR009 : "Access Dashboard"
  C --> CFR10 : "Manage Relationship"
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> FAFR001 : "Manage Sessions"
  FA --> FAFR002 : "View Alerts"
  FA --> FAFR003 : "Predictive Analytics"
  FA --> FAFR004 : "Configure Parameters"
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR020: Manage User Feedback" as SFR020
  
  SA --> SAFR001 : "Manage"
  SA --> SFR020 : "Feedback Management"
}

package "System" {
  rectangle "Financial Insights System" {
    usecase "SFR001: Deliver Alerts" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities from AI" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from AI" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Portfolio" as SFR009
    usecase "SFR010: Process Contextualized News for Users" as SFR010
    usecase "SFR011: Request Contextualized News Insights from AI" as SFR011
    usecase "SFR012: Generate Client Dashboards" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Conditions" as SFR013
    usecase "SFR014: Generate Client Analytics for Insights" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses from AI" as SFR015
    usecase "SFR016: Request Predictive Insights from AI" as SFR016
    usecase "SFR017: Generate Financial Health Reports" as SFR017
    usecase "SFR018: Manage Users' Financial Goals for Progress Tracking and Recommendations" as SFR018
    usecase "SFR019: Maintain Historical Record of Insights for Trend Analysis" as SFR019
    
    C --> SFR001 : "Deliver Alerts"
    FA --> SFR002 : "Deliver Personalized Recommendations"
    SA --> SFR003 : "Request Predictions"
    SA --> SFR004 : "AI Recommendations"
    C --> SFR005 : "Spending Limits Alerts"
    C --> SFR006 : "Investment Opportunity Analysis"
    C --> SFR007 : "Specific Investment Opportunities"
    FA --> SFR008 : "Anomaly Transaction Alerts"
    C --> SFR009 : "Contextualized News Relevant to Portfolio"
    SA --> SFR010 : "Process Contextualized News for Users"
    C --> SFR011 : "News Insights from AI"
    FA --> SFR012 : "Client Dashboards Generation"
    C --> SFR013 : "Alerts Based on Conditions"
    C --> SFR014 : "Analytics for Insights"
    SA --> SFR015 : "Predictive Intervention Analyses"
    FA --> SFR016 : "Predictive Insights from AI"
    C --> SFR017 : "Financial Health Reports"
    SA --> SFR018 : "Manage Financial Goals"
    C --> SFR019 : "Historical Record of Insights"
  }
}

package "AI System" {
  rectangle "AI Component" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on Strategies and Modern Portfolio Theory" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights for Forward-Looking Analysis" as AIFR009
    
    C --> AIFR001 : "Predictions"
    FA --> AIFR002 : "Recommendations"
    C --> AIFR003 : "Spending Limits Alerts"
    C --> AIFR004 : "Investment Opportunity Analysis"
    C --> AIFR005 : "Investment Opportunities Based on Strategies and Modern Portfolio Theory"
    FA --> AIFR006 : "Anomaly Transaction Alerts"
    C --> AIFR007 : "Contextualized News Insights"
    SA --> AIFR008 : "Predictive Intervention Recommendations"
    C --> AIFR009 : "Client Predictive Insights for Forward-Looking Analysis"
  }
}

package "User" {
  actor User as U
  
  usecase "CFR11: Send Feedback to System" as CFR11
  
  U --> CFR11
}
@enduml