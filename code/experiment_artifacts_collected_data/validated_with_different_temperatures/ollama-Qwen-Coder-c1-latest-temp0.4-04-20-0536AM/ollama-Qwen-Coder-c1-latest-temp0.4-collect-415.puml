@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FinancialAdvisor
:User: as User (alias)

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Analysis Parameters" as SAFR002
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "CFR011: Send Feedback about System's Recommendations and Insights" as CFR011
  
  Client --> (SAFR002)
  Client --> CFR001 : "View Financial Dashboard"
  Client --> SAFR002 : "Manage Analysis Parameters"
  Client --> FAFR003 : "View Predictive Analytics for Clients"
  
  SysAdmin --> SAFR002
  SysAdmin --> SFR004
  
  FinancialAdvisor --> (FAFR001)
  FinancialAdvisor --> (FAFR003)
  FinancialAdvisor --> AIFR002 : "Generate Personalized Recommendations"
  
  User -> CFR011 : "Send Feedback about System's Recommendations and Insights"
}

@enduml