@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

' Actors
actor Client as C
actor FinancialAdvisor as FA
actor SysAdmin as SA
actor User as U

' System components
rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Deliver Personalized Recommendations to Users" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  
  C --> CFR001 : "View Financial Insights Dashboard"
  C --> FAFR002 : "Receive Alerts about Anomalous Transactions"
  
  FA --> SAFR001
  FA --> FAFR003 : "View Predictive Analytics for Clients"
  FA --> AIFR005 : "Generate Investment Opportunities Based on Risk Profile"
  
  SA --> SAFR001
  
  U --> CFR001
  U --> SFR002 : "Receive Alerts based on Defined Conditions"
}

@enduml