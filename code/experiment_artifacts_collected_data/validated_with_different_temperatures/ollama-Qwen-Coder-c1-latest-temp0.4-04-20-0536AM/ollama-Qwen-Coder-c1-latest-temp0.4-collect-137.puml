@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
}

package "System Administrator" {
  actor SysAdmin as SAFR003
}

rectangle "User Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001_U
  usecase "SAFR005: Manage Analysis Parameters Preferences" as SAFR005
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002_U
  
  CFR001 --> CFR001_U
  SysAdmin --> SAFR005
  FinancialAdvisor --> FAFR002_U
}

rectangle "Recommendations and Insights" {
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  
  CFR001 --> SFR002
  FinancialAdvisor --> SFR002
  SysAdmin --> SAFR005
}

rectangle "Analytics and Predictions" {
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  
  CFR001 --> SFR003
  FinancialAdvisor --> SFR003
}

rectangle "Spending Limits and Alerts" {
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
  
  CFR001 --> SFR005
}

rectangle "Investment Opportunities and Analysis" {
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  
  CFR001 --> SFR006
}

rectangle "News and Insights" {
  usecase "SFR008: Request Contextualized News from AI Component" as SFR008
  usecase "AIFR007: Generate Contextualized News Insights for Users" as AIFR007
  
  CFR001 --> SFR008
}

rectangle "System Management and Alerts" {
  usecase "SFR013: Request Client Alerts Based on Predefined Conditions" as SFR013
  usecase "AIFR006: Generate Anomaly Transaction Alerts for Users" as AIFR006
  
  SysAdmin --> SFR013
}

rectangle "Financial Health and Reporting" {
  usecase "SFR017: Request Financial Health Reports from AI Component" as SFR017
  
  CFR001 --> SFR017
}

rectangle "Feedback Management" {
  usecase "CFR011: Send Feedback about System Recommendations and Insights" as CFR011_U
  
  CFR001 --> CFR011_U
}
@enduml