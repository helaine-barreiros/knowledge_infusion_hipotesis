@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System: as Sys
:Financial Advisor (FA): as FAD
:System Administrator (SA): as SA

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "SAFR004: Configure Analysis Parameters for Specific Segments" as SAFR004

  rectangle "Client Functions" {
    Client --> (CFR001)
    Client --> (CFR002)
    Client --> (CFR003)
    Client --> (CFR004)
    Client --> (CFR005)
    Client --> (CFR006)
    Client --> (CFR007)
    Client --> (CFR008)
    Client --> (CFR009)
    Client --> (SFR012)
  }

  rectangle "Financial Advisor Functions" {
    FAD --> (FAFR001)
    FAD --> (FAFR002)
    FAD --> (FAFR003)
    FAD --> (SAFR004)
  }

  rectangle "System Administrator Functions" {
    SA --> (SFR012)
    SA --> (SAFR001)
  }
}

rectangle "AI System Components" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Based on Modern Portfolio Theory" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009

  rectangle "AI Functions for Users" {
    Sys --> (SFR012)
    Sys --> (CFR005) : Manage Recommendation Preferences
    Sys --> (SAFR004) : Configure Analysis Parameters for Specific Segments
  }

  rectangle "AI Functions for System Administrator" {
    SA --> (AIFR006) : Generate Anomaly Transaction Alerts
    SA --> (SFR012)
  }
}

rectangle "Notifications and Feedback" {
  usecase "CFR11: Send Feedback About Recommendations" as CFR11

  rectangle "Feedback Pathway" {
    Client --> (CFR11)
  }
}
@enduml