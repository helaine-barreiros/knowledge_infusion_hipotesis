@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure analysis parameters for specific client segments" as FAFR004
  usecase "SFR002: Deliver personalized recommendations to users based on their financial profiles" as SFR002
  usecase "AIFR002: Generate personalized recommendations for users" as AIFR002
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> (FAFR004)
  System --> SFR002
  System --> AIFR002

}

rectangle "Client Dashboard Features" {
  usecase "CFR009: Access a personalized dashboard that consolidates my financial information in a single view to efficiently monitor my finances." as CFR009
  
  Client --> (CFR009)
  
}

rectangle "Alert and Notification Features" {
  usecase "SFR013: Generate client alerts based on predefined conditions to ensure timely notification of important financial events." as SFR013
  usecase "AIFR006: Generate anomaly transaction alerts by employing pattern recognition to detect potentially fraudulent activities in compliance with FinCEN requirements." as AIFR006
  
  Client --> (SFR013)
  System --> (AIFR006)

}

rectangle "Investment and Financial Planning Features" {
  usecase "CFR007: View investment opportunities suitable to my risk profile (as defined under MiFID II or equivalent standards) to diversify my portfolio and maximize returns." as CFR007
  usecase "AIFR004: Generate spending limit alerts for users by identifying unusual deviations from established spending patterns" as AIFR004
  
  Client --> (CFR007)
  System --> (AIFR004)

}

rectangle "Financial News and Insights Features" {
  usecase "CFR008: View news related to my investment portfolio to stay informed about market events that might affect my assets." as CFR008
  usecase "SFR017: Generate financial health reports that assess users' overall financial wellbeing according to standard financial ratios and metrics." as SFR017
  
  Client --> (CFR008)
  System --> (SFR017)

}

rectangle "Client Relationship Management Features" {
  usecase "CFR10: Manage my relationship with Financial Advisors, including permissions for sharing my financial data, to maintain privacy and control over my financial information." as CFR10
  
  Client --> (CFR10)
  
}

@enduml