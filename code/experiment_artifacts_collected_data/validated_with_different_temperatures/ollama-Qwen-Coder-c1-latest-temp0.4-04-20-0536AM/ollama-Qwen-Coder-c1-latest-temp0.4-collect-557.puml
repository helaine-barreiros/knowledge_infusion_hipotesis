@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
}

package "System Administrator" {
  actor SysAdmin as SAFR003
}

rectangle "Core System" {
  usecase "CFR002: View Alerts" as SFR004
  usecase "SAFR001: Manage Analysis Parameters" as AIFR007
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR003
  usecase "CFR009: Access Personalized Dashboard" as SFR012
  
  CFR001 --> (SFR004)
  SAFR003 --> (SAFR001)
  FAFR002 --> (FAFR001)
}

rectangle "AI Component" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR008
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR009
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR010
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR011
  
  SFR002 --> (AIFR008)
  FAFR002 --> (AIFR011)
  SAFR003 --> (SAFR007)
}

rectangle "News Component" {
  usecase "SFR009: Request Contextualized News Insights" as AIFR014
  usecase "SFR010: Process Contextualized News to Extract Relevant Information" as AIFR015
  
  SFR008 --> (AIFR012)
}

rectangle "Dashboard Component" {
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as AIFR016
  usecase "SFR17: Generate Financial Health Reports" as AIFR019
  
  CFR001 --> (AIFR020)
}

rectangle "Feedback Component" {
  usecase "CFR011: Send Feedback about System's Recommendations and Insights" as SFR023
}
@enduml