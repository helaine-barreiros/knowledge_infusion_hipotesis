@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR002
}

package SysAdmin {
  actor "System Administrator" as SAFR003
}

rectangle "AI Component" {
  usecase "AIFR001: Generate financial predictions" as AIFR001
  usecase "AIFR002: Generate personalized recommendations" as AIFR002
  usecase "AIFR003: Generate spending limit alerts" as AIFR003
  usecase "AIFR004: Generate investment opportunity analyses" as AIFR004
  usecase "AIFR005: Generate investment opportunities based on alignment with user strategies and Modern Portfolio Theory principles" as AIFR005
  usecase "AIFR006: Generate anomaly transaction alerts" as AIFR006
  usecase "AIFR007: Generate contextualized news insights" as AIFR007
  usecase "AIFR008: Generate client predictive intervention recommendations" as AIFR008
  usecase "AIFR009: Generate client predictive insights" as AIFR009
}

rectangle "System Component" {
  usecase "SFR001: Deliver alerts to users through appropriate notification channels" as SFR001
  usecase "SFR002: Deliver personalized recommendations based on financial profiles" as SFR002
  usecase "SFR003: Request financial predictions from the AI component" as SFR003
  usecase "SFR004: Request personalized recommendations from the AI component" as SFR004
  usecase "SFR005: Request spending limit alerts from the AI component" as SFR005
  usecase "SFR006: Request investment opportunity analysis from the AI component based on risk profiles and financial goals" as SFR006
  usecase "SFR007: Request specific investment opportunities that match user criteria and ESG preferences" as SFR007
  usecase "SFR008: Request anomaly transaction alerts to detect potentially fraudulent activities in accordance with AML regulations" as SFR008
  usecase "SFR009: Find contextualized news relevant to users' financial portfolios from trusted sources" as SFR009
  usecase "SFR010: Process contextualized news for user's financial situations" as SFR010
  usecase "SFR011: Request contextualized news insights from the AI component to identify potential impacts on users' investments" as SFR011
  usecase "SFR012: Generate client dashboards that present information in an intuitive format" as SFR012
  usecase "SFR013: Generate client alerts based on predefined conditions for timely notifications" as SFR013
  usecase "SFR014: Generate client analytics that provide meaningful insights into financial behavior and performance" as SFR014
  usecase "SFR015: Request predictive intervention analyses from the AI component to identify when advisors should engage with clients" as SFR015
  usecase "SFR016: Request predictive insights from the AI component to enhance financial guidance provided by advisors" as SFR016
  usecase "SFR017: Generate financial health reports that assess users' overall wellbeing according to standard ratios and metrics" as SFR017
  usecase "SFR018: Manage users' financial goals to track progress and provide recommendations" as SFR018
  usecase "SFR019: Maintain a historical record of insights for trend analysis and effectiveness measurement" as SFR019
  usecase "SFR020: Manage user feedback to continuously improve system outputs" as SFR020
}

rectangle "Client Interface" {
  CFR001 --> AIFR001 : Generate financial predictions
  CFR001 --> AIFR002 : Generate personalized recommendations
  CFR001 --> AIFR003 : Generate spending limit alerts
  CFR001 --> AIFR004 : Generate investment opportunity analyses
  CFR001 --> SFR007 : Find contextualized news relevant to financial portfolios
}

rectangle "Financial Advisor Interface" {
  FAFR002 --> AIFR003 : Generate spending limit alerts
  FAFR002 --> AIFR004 : Generate investment opportunity analyses
  FAFR002 --> AIFR015 : Request predictive intervention analyses for client engagement
}

rectangle "System Administrator Interface" {
  SAFR003 --> SFR009 : Find contextualized news relevant to financial portfolios
  SAFR003 --> SFR014 : Generate client analytics that provide meaningful insights into financial behavior and performance
}

@enduml