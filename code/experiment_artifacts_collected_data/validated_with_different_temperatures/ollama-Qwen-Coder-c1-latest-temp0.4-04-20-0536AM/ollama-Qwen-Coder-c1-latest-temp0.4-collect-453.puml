@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Analysis Parameters" as SAFR002
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  Client --> CFR001
  SysAdmin --> SAFR002
  SysAdmin --> FAFR004
}

rectangle "Client Dashboard Features" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
  
  Client --> CFR009
  Client --> CFR010
}

rectangle "Client Alert Features" {
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "CFR002: Receive Anomalous Transactions Alerts" as CFR002
  
  System --> SFR013
  Client --> CFR002
}

rectangle "Client Recommendation Features" {
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  usecase "CFR004: Receive Personalized Recommendations Aligned with Financial Goals" as CFR004
  
  System --> SFR002
  Client --> CFR004
}

rectangle "Client Spending Limit Features" {
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "CFR006: View Spending Limits Alerts When Exceeding Thresholds" as CFR006
  
  System --> SFR005
  Client --> CFR006
}

rectangle "Client Investment Opportunity Features" {
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "CFR007: View Investment Opportunities Suitable to Risk Profile" as CFR007
  
  System --> SFR006
  Client --> CFR007
}

rectangle "Client News Features" {
  usecase "SFR010: Request Contextualized News Insights from AI Component" as SFR010
  usecase "CFR008: View News Related to Investment Portfolio" as CFR008
  
  System --> SFR010
  Client --> CFR008
}

rectangle "Client Feedback Features" {
  usecase "CFR11: Send Feedback About Recommendations and Insights" as CFR11
  
  Client --> CFR11
}
@enduml