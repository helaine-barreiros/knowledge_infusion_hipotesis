@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
  
  C --> (View Financial Insights Dashboard)
  C --> (Receive Anomaly Transaction Alerts)
  C --> (View Financial Predictions)
  C --> (Receive Personalized Recommendations)
  C --> (Manage Recommendation Preferences)
  C --> (View Spending Limit Alerts)
  C --> (Manage Relationship with Financial Advisors)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Clients" as FAFR004
  
  FA --> (Manage Client Mentoring Sessions)
  FA --> (View Client Intervention Alerts)
  FA --> (View Predictive Analytics)
  FA --> (Configure Analysis Parameters for Specific Clients)
}

package "System Administrator" {
  actor SysAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR020: Manage User Feedback" as SFR020
  
  SA --> (Manage Analysis Parameters)
  SA --> (Manage User Feedback)
}

package "System" {
  rectangle SystemBoundary {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities from AI Component" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
    usecase "SFR010: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR010
    usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
    usecase "SFR012: Generate Client Dashboards" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
    usecase "SFR014: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
    usecase "SFR016: Request Predictive Insights from AI Component to Enhance the Value of Financial Guidance Provided to Clients" as SFR016
    usecase "SFR017: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR017
    usecase "SFR018: Manage Users' Financial Goals Tracking Progress and Providing Relevant Recommendations" as SFR018
    usecase "SFR019: Maintain a Historical Record of Users' Insights for Trend Analysis and Effectiveness Measurement" as SFR019
    
    C --> (Deliver Alerts to Users)
    FA --> (Deliver Personalized Recommendations)
    SA --> (Request Financial Predictions from AI Component)
    C --> (Request Personalized Recommendations from AI Component)
    C --> (Request Spending Limit Alerts from AI Component)
    FA --> (Request Investment Opportunity Analysis from AI Component)
    FA --> (Request Specific Investment Opportunities from AI Component)
    C --> (Request Anomaly Transaction Alerts from AI Component)
    C --> (Find Contextualized News Relevant to Users' Financial Portfolios)
    C --> (Process Contextualized News to Extract Relevant Information for Users' Financial Situations)
    C --> (Request Contextualized News Insights from AI Component)
    FA --> (Generate Client Dashboards)
    SA --> (Generate Client Alerts Based on Predefined Conditions)
    C --> (Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance)
    FA --> (Request Predictive Intervention Analyses from AI Component)
    C --> (Request Predictive Insights from AI Component to Enhance the Value of Financial Guidance Provided to Clients)
    SA --> (Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics)
    C --> (Manage Users' Financial Goals Tracking Progress and Providing Relevant Recommendations)
  }
}

package "AI System" {
  rectangle AIBoundary {
    usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations Based on Users' Profiles, Goals, and Risk Tolerance" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on User Strategies and Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News With Specific User Portfolios Identifying Relevant Impacts" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations Supporting More Effective Planning" as AIFR009
    
    C --> (Generate Financial Predictions for Users)
    FA --> (Generate Personalized Recommendations Based on User Profiles, Goals, and Risk Tolerance)
    SA --> (Identify Unusual Spending Patterns to Generate Alerts)
    C --> (Evaluate Potential Investments Against Their Risk Profiles and Time Horizons)
    FA --> (Align Investment Strategies with Modern Portfolio Theory Principles)
    C --> (Detect Potentially Fraudulent Activities in Compliance With FinCEN Requirements)
    FA --> (Correlate Financial News With Specific User Portfolios Identifying Relevant Impacts)
    C --> (Identify Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement)
  }
}

package "User" {
  actor Client as U1
  actor FinancialAdvisor as U2
  actor SysAdmin as U3
  
  usecase "CFR011: Send Feedback About System's Recommendations and Insights" as CFR011
  
  U1 --> (Send Feedback About System's Recommendations and Insights)
  U2 --> (Send Feedback About System's Recommendations and Insights)
  U3 --> (Send Feedback About System's Recommendations and Insights)
}

@enduml