@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations" as SFR002
  usecase "CFR005: Manage Recommendation Preferences" as CFR010
  
  Client --> (SAFR003)
  Client --> (SFR002)
  Client --> (CFR010)
}

rectangle "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  actor FinancialAdvisor as FAFR004
  
  usecase "FAFR005: View Predictive Analytics" as SFR003
  usecase "FAFR007: Configure Analysis Parameters for Client Segments" as SAFR002
  usecase "FAFR10: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR005
  
  FinancialAdvisor --> (FAFR005)
  FinancialAdvisor --> (SFR003)
  FinancialAdvisor --> (SAFR002)
}

rectangle "System Administrator" {
  actor SysAdmin as SAFR001
  usecase "Manage Analysis Parameters for AI System" as SAFR004
  
  SysAdmin --> (SAFR001)
  SysAdmin --> (SFR004)
}

package "Notifications & Alerts" {
  rectangle "System" {
    usecase "Deliver Alerts to Users Through Appropriate Notification Channels" as SFR005
    usecase "Request Financial Predictions from AI Component" as AIFR001
    
    System --> (SFR005)
    System --> (AIFR001)
  }
}

package "Personalized Recommendations & Insights" {
  rectangle "System" {
    usecase "Deliver Personalized Recommendations to Users Based on Financial Profiles" as SFR002
    usecase "Request Predictive Analytics About Client's Financial Situations" as AIFR003
    
    System --> (SFR002)
    System --> (AIFR003)
  }
}

package "Investment Opportunities & News" {
  rectangle "System" {
    usecase "Generate Investment Opportunity Analyses for Users Based on Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
    usecase "Find Contextualized News Relevant to Users' Financial Portfolios from Trusted Sources" as SFR013
    
    System --> (AIFR004)
    System --> (SFR013)
  }
}

package "Spending Limits & Predictive Interventions" {
  rectangle "System" {
    usecase "Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as AIFR005
    usecase "Request Predictive Intervention Analyses From AI Component to Identify When Financial Advisors Should Engage With Clients" as SFR16
    
    System --> (AIFR005)
    System --> (SFR16)
  }
}

package "Financial Health & Goal Management" {
  rectangle "System" {
    usecase "Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as AIFR007
    usecase "Manage Users' Financial Goals to Track Progress and Provide Relevant Recommendations" as SFR18
    
    System --> (AIFR007)
    System --> (SFR18)
  }
}

package "AI Functionality" {
  rectangle "System" {
    usecase "Generate Predictive Insights From the AI Component to Enhance Value of Financial Guidance Provided to Clients" as SFR16
    usecase "Request Contextualized News Insights from the AI Component to Identify Potential Impacts on Users' Investments" as AIFR07
    
    System --> (SFR16)
    System --> (AIFR07)
  }
}

rectangle "User Feedback Management" {
  actor User as CFR011
  
  usecase "Send Feedback About the System's Recommendations and Insights to Help Improve Future Outputs" as SFR20
  
  User --> (SFR20)
}
@enduml