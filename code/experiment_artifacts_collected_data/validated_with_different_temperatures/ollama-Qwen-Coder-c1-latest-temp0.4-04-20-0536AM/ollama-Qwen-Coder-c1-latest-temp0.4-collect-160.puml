  AIF --> AIFR004 : "Generate Investment Analysis"
  AIF --> AIFR005 : "Generate Opportunities Based on Strategies"
  AIF --> AIFR006 : "Generate Anomaly Alerts"
  AIF --> AIFR007 : "Generate News Insights"
  AIF --> AIFR008 : "Generate Predictive Interventions Recommendations"
  AIF --> AIFR009 : "Generate Client Insights"
