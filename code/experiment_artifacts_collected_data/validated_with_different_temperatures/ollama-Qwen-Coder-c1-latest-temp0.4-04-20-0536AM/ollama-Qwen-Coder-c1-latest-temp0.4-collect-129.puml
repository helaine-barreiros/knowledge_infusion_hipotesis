@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFD002
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006

  Client --> CFR001
  SysAdmin --> SAFR001
  Financial Advisor --> FAFD002
}

rectangle "Notifications and Recommendations" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002

  Client -> (SAFR001)
  Financial Advisor --> (FAFD002)
}

rectangle "Analytics and Predictions" {
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004

  Client --> (SAFR001)
  Financial Advisor --> (FAFD002)
}

rectangle "Investment Opportunities and News" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "AIFR005: Generate Investment Opportunities for Users" as AIFR005
  usecase "SFR012: Request Contextualized News Insights from AI Component" as SFR012

  Client --> (CFR007)
  Financial Advisor --> (FAFD002)

}

rectangle "User Management and Feedback" {
  usecase "AIFR008: Generate Anomaly Transaction Alerts" as AIFR008
  usecase "SFR013: Request Client Analytics from AI Component" as SFR013

  Client --> (SAFR001)
}

rectangle "System Operations" {
  usecase "AIFR009: Generate Predictive Intervention Recommendations for Users" as AIFR009
  usecase "SFR015: Request Predictive Insights from AI Component to Enhance Financial Guidance Provided to Clients" as SFR015

  Client --> (SAFR001)
}

rectangle "Financial Health and Goals" {
  usecase "AIFR017: Generate Financial Health Reports for Users" as AIFR017
  usecase "SFR018: Manage User Feedback to Continuously Improve the Quality of Financial Insights Provided by AI System" as SFR018

  Client --> (SAFR001)
}

rectangle "Client Dashboards and Alerts" {
  usecase "AIFR012: Generate Contextualized News Insights for Users' Portfolios" as AIFR012
  usecase "SFR014: Request Predictive Analytics from AI Component to Provide Meaningful Insights into Financial Behavior and Performance of Clients" as SFR014

  Client --> (SAFR001)
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations" as FAFD003
  usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts on Users' Investments" as AIFR007

  Financial Advisor --> (FAFD002)
}

rectangle "AI System Functions" {
  usecase "AIFR018: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR018
  usecase "SFR016: Request Predictive Insights from AI Component to Enhance the Value of Financial Guidance Provided to Clients" as SFR016

  System Admin --> (SAFR001)
}

rectangle "User Feedback Loop" {
  usecase "CFR011: Send Feedback about Recommendations and Insights for Improvement" as CFR011

  Client -> (AIFR008)
}
@enduml