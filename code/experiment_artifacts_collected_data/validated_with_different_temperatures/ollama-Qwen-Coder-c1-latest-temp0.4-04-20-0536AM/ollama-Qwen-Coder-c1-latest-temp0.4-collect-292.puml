@startuml

left to right direction

title Use Case Diagram for AI-Powered Financial Insights & Advisory System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SystemAdministrator as SA
  
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  SA --> (SAFR001)
}

package "System" {
  rectangle "Notification Channels" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    SFR001 <|-- (CFR002, FAFR002, SAFR001)
  }
  
  rectangle "Recommendations" {
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    SFR002 <|-- (CFR004, FAFR003, AIFR002)
  }
  
  rectangle "Predictions and Insights" {
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR016: Request Predictive Insights from AI Component" as SFR016
    
    SFR003 <|-- (CFR003, FAFR004)
    SFR016 <|-- (FAFR002, SAFR001)
  }
  
  rectangle "Spending Limits and Alerts" {
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    SFR005 <|-- (CFR006)
  }
  
  rectangle "Investment Opportunities" {
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "SFR014: Generate Client Analytics that Provide Meaningful Insights into Financial Behavior and Performance" as SFR014
    
    SFR006 <|-- (CFR007, FAFR003)
    SFR014 <|-- (FAFR002, SAFR001)
  }
  
  rectangle "News and Insights" {
    usecase "SFR008: Request Contextualized News from AI Component" as SFR008
    usecase "SFR017: Generate Financial Health Reports that Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR017
    
    SFR008 <|-- (CFR008, FAFR003)
    SFR017 <|-- (FAFR002, SAFR001)
  }
  
  rectangle "Predictive Intervention Recommendations" {
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
    SFR015 <|-- (CFR004, FAFR002)
  }

  rectangle "User Feedback Management" {
    usecase "AIFR009: Generate Client Predictive Insights that Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009
    usecase "CFR11: Send Feedback about System's Recommendations and Insights" as CFR11
    
    AIFR009 <|-- (SFR020)
    CFR11 --> (AIFR009, SFR020)
  }
}

@enduml