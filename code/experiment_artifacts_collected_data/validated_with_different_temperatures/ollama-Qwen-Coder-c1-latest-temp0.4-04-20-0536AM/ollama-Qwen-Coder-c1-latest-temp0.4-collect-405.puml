@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FA

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004

  User --> CFR001 : "View Alerts"
  SysAdmin --> SAFR001 : "Manage Parameters"
  FA --> FAFR002 : "View Alerts"
}

rectangle "Client Dashboard Features" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "SFR012: Generate Client Dashboards" as SFR012

  User --> CFR009 : "Access Dashboard"
  System Admin --> SFR012 : "Generate Dashboards"
}

rectangle "Recommendation and Insights Features" {
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002

  User --> CFR004 : "Receive Recommendations"
  System Admin --> SFR002 : "Deliver Recommendations"
}

rectangle "Spending Limit and Investment Features" {
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005

  User --> CFR010 : "Manage Relationships"
  System Admin --> SFR005 : "Request Alerts"

}

rectangle "News and Analytics Features" {
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009

  User --> CFR008 : "View News"
  System Admin --> SFR009 : "Find News"

}

rectangle "Feedback and Improvement Features" {
  usecase "CFR11: Send Feedback about Recommendations" as CFR11
  usecase "SFR20: Manage Users' Financial Goals to Track Progress and Provide Relevant Recommendations" as SFR20

  User --> CFR11 : "Send Feedback"
  System Admin --> SFR20 : "Manage Goals"

}

@enduml