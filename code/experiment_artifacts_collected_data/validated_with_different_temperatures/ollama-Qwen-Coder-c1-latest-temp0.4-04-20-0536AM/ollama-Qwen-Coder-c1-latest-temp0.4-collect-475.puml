@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations" as SFR002
  usecase "CFR005: Manage Recommendation Preferences" as CFR011
  
  CFR001 --> SAFR003
  CFR001 --> SFR002
  CFR001 --> CFR011
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts" as SFR013
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as SAFR005
  usecase "FAFR006: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR002
  
  FinancialAdvisor --> SFR013
  FinancialAdvisor --> SAFR005
  FinancialAdvisor --> FAFR002
}

package "System Administrator" {
  actor SysAdmin as SAFR001
  
  usecase "SAFR004: Manage Analysis Parameters for the AI System" as SAFR001
  
  SysAdmin --> SAFR001
}

rectangle "AI Component" {
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  CFR001 --> (AIFR002)
  FAFR001 --> (AIFR002)
  SAFR001 --> (AIFR003)
  SAFR001 --> (AIFR004)
}

rectangle "Notification System" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  
  CFR001 --> SFR001
  FAFR001 --> SFR001
  SysAdmin --> SFR001
}

rectangle "Dashboard System" {
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  CFR001 --> SFR012
  FAFR001 --> SFR012
}

@enduml