package "AI System" {
  actor AI as A

  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations Based on User Data and Preferences" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Patterns" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users Evaluating Potential Investments Against Risk Profiles and Goals" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Aligning with User Strategies Based on Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance With FinCEN Requirements" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News with User Portfolios Identifying Relevant Impacts" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of User Situations Supporting Effective Planning" as AIFR009

  A --> (Financial Predictions Generation) : AIFR001
  A --> (Personalized Recommendations Generation) : AIFR002
  A --> (Spending Limit Alerts Generation) : AIFR003
  A --> (Investment Opportunity Analysis Generation) : AIFR004
  A --> (Investment Opportunities Selection Based on User Strategies and Modern Portfolio Theory Principles) : AIFR005
  A --> (Anomaly Transaction Alerts Generation) : AIFR006
  A --> (Contextualized News Insights Generation) : AIFR007
  A --> (Client Predictive Intervention Recommendations Generation) : AIFR008
  A --> (Predictive Insights Generation) : AIFR009
  
}

