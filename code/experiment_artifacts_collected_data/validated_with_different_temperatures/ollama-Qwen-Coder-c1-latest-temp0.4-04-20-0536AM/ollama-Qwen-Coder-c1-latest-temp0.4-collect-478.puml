@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SysAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  usecase "SFR020: Manage User Feedback to Improve Recommendations" as SFR020
  
  SA --> (SAFR001)
  SA --> (SFR020)
}

package "System Components" {
  rectangle "Alerts Management" {
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
  }
  
  rectangle "Personalized Recommendations" {
    usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
    usecase "SFR014: Request Predictive Insights from AI Component" as SFR014
    usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  }
  
  rectangle "Predictive Analytics" {
    usecase "SFR03: Request Financial Predictions from AI Component" as SFR003
    usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
    usecase "AIFR009: Generate Client Predictive Insights that Provide Forward-Looking Analysis of Financial Situations" as AIFR009
  }
  
  rectangle "Investment Opportunities" {
    usecase "SFR06: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  }
  
  rectangle "News Management" {
    usecase "SFR09: Request Contextualized News from AI Component" as SFR009
    usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
    usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios" as AIFR007
  }
  
  rectangle "Client Dashboards and Analytics" {
    usecase "SFR12: Request Client Dashboards from AI Component" as SFR012
    usecase "CFR009: Access Personalized Dashboard that Consolidates My Financial Information in a Single View" as CFR009
    usecase "AIFR017: Generate Financial Health Reports for Users" as AIFR017
  }
  
  rectangle "Predictive Intervention Recommendations" {
    usecase "SFR15: Request Predictive Intervention Analyses from AI Component" as SFR015
    usecase "FAFR02: View Client Intervention Alerts When System Detects Patterns Requiring Professional Attention to Proactively Assist Clients with Potential Financial Issues" as FAFR002
    usecase "AIFR008: Generate Predictive Insights for Users by Identifying Patterns that Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  }
}

@enduml