@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  Client --> CFR001
  Client --> SAFR001
  Client --> FAFR003
  Client --> SFR002
  Client --> AIFR004

  SysAdmin --> SAFR001
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "AIFR009: Generate Predictive Insights for Advisors" as AIFR009

  Financial Advisor --> FAFR001
  Financial Advisor --> FAFR002
  Financial Advisor --> AIFR009
}

rectangle "System Components" {
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "SFR004: Request Personalized Recommendations" as SFR004
  usecase "SFR005: Request Spending Limit Alerts" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
  usecase "SFR012: Generate Client Dashboards" as SFR012

  System --> SFR003
  System --> SFR004
  System --> SFR005
  System --> SFR006
  System --> SFR012
}

rectangle "Feedback Loop" {
  usecase "CFR011: Send Feedback" as CFR011

  Client --> CFR011
  Financial Advisor --> CFR011
  SysAdmin --> CFR011
}
@enduml