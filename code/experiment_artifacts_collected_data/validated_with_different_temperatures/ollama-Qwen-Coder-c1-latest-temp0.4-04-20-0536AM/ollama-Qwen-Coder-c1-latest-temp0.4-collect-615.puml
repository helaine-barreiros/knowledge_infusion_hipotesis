@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  SA --> (SAFR001)
}

rectangle "System" {
  package "Alerts and Notifications" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    SFR001 <|-- (CFR002)
    SFR001 <|-- (FAFR002)
    SFR001 <|-- (SAFR001)
  }
  
  package "Recommendations and Insights" {
    usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
    usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
    
    SFR002 <|-- (CFR004)
    SFR002 <|-- (FAFR003)
    SFR002 --> (AIFR002)
  }
  
  package "Predictive Analytics and Insights" {
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR016: Request Predictive Insights from AI Component to Enhance Guidance" as SFR016
    
    SFR003 <|-- (CFR003)
    SFR003 --> (AIFR001)
    
    SFR016 <|-- (FAFR003)
  }
  
  package "Spending Limits and Alerts" {
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
    
    SFR005 <|-- (CFR006)
    SFR005 --> (AIFR003)
  }
  
  package "Investment Opportunities and Insights" {
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "SFR012: Generate Client Dashboards with Financial Information" as SFR012
    
    SFR006 <|-- (CFR007)
    SFR006 --> (AIFR004)
    
    SFR012 <|-- (FAFR003)
  }
  
  package "News and Insights" {
    usecase "SFR008: Request Contextualized News from AI Component" as SFR008
    usecase "SFR017: Generate Financial Health Reports" as SFR017
    
    SFR008 <|-- (CFR008)
    SFR008 --> (AIFR007)
    
    SFR017 <|-- (FAFR003)
  }
  
  package "User Feedback and Management" {
    usecase "SFR20: Manage User Feedback to Improve Outputs" as SFR20
    
    SFR20 <|-- (CFR11)
  }
}

@enduml