@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations" as SAFR005
  usecase "CFR006: Manage Recommendation Preferences" as SAFR019
  
  CFR001 --> (SAFR002)
  CFR001 --> (SAFR003)
  CFR001 --> (SAFR004)
  CFR001 --> (SAFR005)
  CFR001 --> (SFR018)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR
  
  usecase "FAFR002: View Client Intervention Alerts" as SAFR006
  usecase "FAFR003: View Predictive Analytics" as SAFR014
  usecase "FAFR005: Configure Analysis Parameters for Specific Segments" as AIFR008
  
  FAFR --> (SAFR002)
  FAFR --> (SAFR006)
  FAFR --> (SAFR003)
  FAFR --> (AIFR005)
}

package "System Administrator" {
  actor SystemAdmin as SAFR001
  
  usecase "SAFR007: Manage Analysis Parameters for AI System" as AIFR009
  usecase "SFR020: Manage User Feedback to Improve Outputs" as SFR020
  
  SAFR001 --> (AIFR007)
}

package "System Components" {
  rectangle "AI Component" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Identify Financial Instruments for Investments" as AIFR012
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR007
    usecase "AIFR008: Correlate News with User Portfolios" as AIFR013
    usecase "AIFR009: Predictive Intervention Recommendations for Advisors" as AIFR015
  }
  
  rectangle "Notification Component" {
    usecase "SFR002: Deliver Alerts to Users" as SFR002
  }

  rectangle "Recommendation Engine" {
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR016
  }
}

@enduml