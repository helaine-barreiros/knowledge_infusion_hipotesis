@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FinancialAdvisor
:User: as User
:AIFR001: as AIFR001

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI" as SFR003
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  Client --> CFR001
  SysAdmin --> SAFR001
  User -> (FAFR002)
  
  rectangle "AI Component" {
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Identify Financial Instruments for Users" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "AIFR007: Correlate News with User Portfolios" as AIFR007
  
    Client --> (SFR003)
    FinancialAdvisor --> (FAFR002)
    
    rectangle "User Feedback Loop" {
      usecase "CFR011: Send System Recommendations and Insights Feedback" as CFR011
    }
  
    User -> (AIFR009)
  }
}

@enduml