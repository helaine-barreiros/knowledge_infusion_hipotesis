@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

rectangle "System" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  rectangle "Financial Recommendations" {
    usecase "CFR002: View Alerts about Anomalous Transactions" as CFR002
    usecase "CFR004: Receive Personalized Recommendations" as CFR004
    usecase "CFR005: Manage Recommendation Preferences" as CFR005
  }
  
  rectangle "Financial Insights" {
    usecase "CFR003: View Financial Predictions" as CFR003
    usecase "CFR006: View Spending Limit Alerts" as CFR006
    usecase "CFR012: Generate Client Dashboards" as CFR012
  }
  
  rectangle "Investment Opportunities" {
    usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  }

  rectangle "News and Updates" {
    usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
    usecase "SFR017: Generate Financial Health Reports" as SFR017
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  }
  
  rectangle "System Management" {
    usecase "SFR020: Manage User Feedback to Improve Recommendations" as SFR020
    usecase "CFR11: Send Feedback about System's Recommendations and Insights" as CFR11
  }

  Client --> (SAFR001)
  
  SAFR001 <|-- (SFR003, SFR004, SFR005, AIFR002)

  CFR001 --> (CFR002, CFR003, CFR004, CFR006, CFR007, CFR008)
  
  SAFR001 <|-- (SFR009, SFR010, AIFR006)

  rectangle "Financial Advisor" {
    actor FinancialAdvisor as FAFR001
    
    usecase "FAFR002: View Client Intervention Alerts" as FAFR002
    usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as FAFR003
    usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
    
  }
  
  rectangle "System Alerts and Recommendations" {
    usecase "SFR012: Generate Client Dashboards" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
    usecase "AIFR008: Generate Predictive Intervention Recommendations for Clients" as AIFR008
    
  }
  
  rectangle "AI System Functions" {
    usecase "AIFR009: Generate Client Predictive Insights to Enhance Financial Guidance" as AIFR009
    usecase "SFR17: Manage Users' Financial Goals and Track Progress" as SFR17
    
  }
  
  FAFR001 --> (FAFR002, FAFR003, FAFR004)
}

@enduml