@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

' Actors
actor Client as CFR001
actor FinancialAdvisor as FAFR002
actor SysAdmin as SAFR003

rectangle "System" {
  usecase "CFR002: View Alerts" as SFR008
  usecase "SAFR004: Manage Analysis Parameters for Specific Client Segments" as AIFR019
  
  CFR001 --> (SFR008)
  FAFR002 --> (AIFR019)
}

rectangle "Client Dashboard Features" {
  usecase "CFR003: View Financial Predictions Based on Historical Data and Current Market Trends" as SFR004
  usecase "CFR005: Manage Personalized Recommendations Preferences" as AIFR020
  
  CFR001 --> (SFR004)
  CFR001 --> (AIFR020)
}

rectangle "Financial Insights and Recommendations" {
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as SFR005
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as AIFR018
  
  CFR001 --> (SFR005)
  FAFR002 --> (AIFR018)
}

rectangle "Investment Opportunities and News" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as SFR006
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments to Customize the System's Behavior According to Different Client Profiles and Regulatory Requirements Such as GDPR or CCPA" as AIFR021
  
  CFR001 --> (SFR006)
  FAFR002 --> (AIFR021)
}

rectangle "Client Relationship Management" {
  usecase "CFR010: Manage My Relationship with Financial Advisors, Including Permissions for Sharing My Financial Data" as SAFR005
  
  CFR001 --> (SAFR005)
}

rectangle "System Functions and Alerts" {
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles to Support Better Financial Decision-Making" as AIFR002
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR013
  
  CFR001 --> (AIFR002)
  SAFR005 --> (SFR013)
}

rectangle "AI System Functions" {
  usecase "AIFR004: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as AIFR004
  usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR012
  
  CFR001 --> (AIFR004)
  FAFR002 --> (AIFR012)
}

rectangle "User Feedback and Support" {
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as SAFR006
  
  CFR001 --> (SAFR006)
}
@enduml