@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as c
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts About Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as CFR004
  usecase "CFR005: Manage Personalized Recommendations Preferences to Ensure Relevance to My Financial Objectives and Risk Tolerance" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as CFR006
  usecase "CFR007: View Investment Opportunities Suitable for My Risk Profile" as CFR007
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "CFR009: Access a Personalized Dashboard That Consolidates Financial Information in a Single View" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors, Including Permissions for Sharing Data" as CFR10
  
  c --> (SAFR002 : Receive Alerts About Anomalous Transactions)
  c --> (SFR003 : Request Predictive Analytics from AI Component)
  c --> (AIFR004 : Generate Investment Opportunity Analyses Based on User's Risk Profile and Goals)
}

package "Financial Advisor" {
  actor FinancialAdvisor as fa
  
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts When Patterns Require Professional Attention" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as FAFR003
  
  fa --> (SAFR001 : Manage Analysis Parameters for AI System)
}

package "System Administrator" {
  actor SysAdmin as sa
  
  usecase "SAFR001: Manage Analysis Parameters for the AI System to Ensure Compliance with Financial Regulations" as SAFR001
}

rectangle "AI Component" {
  usecase "AIFR001: Generate Financial Predictions Based on Historical Data, Market Trends, and Economic Indicators" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Profiles, Goals, and Risk Tolerance" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users Based on Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities by Identifying Instruments That Align with User's Strategies and Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News With Specific User Portfolios" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations Based on Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Planning" as AIFR009
  
  c --> (SFR012 : Request Client Dashboards from AI Component)
}

rectangle "System" {
  usecase "SFR001: Deliver Alerts to Users Through Appropriate Notification Channels" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations Based on User's Financial Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component for Forward-Looking Insights" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component Based on Each User's Data and Preferences" as SFR004
  usecase "SFR005: Request Spending Limit Alerts From AI Component When Spending Patterns Exceed Defined Thresholds" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component to Identify Suitable Investments Based on User's Risk Profiles" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Matching User Criteria and ESG Preferences From AI Component" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component to Detect Potentially Fraudulent Activities in Accordance with AML Regulations" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios From Trusted Sources" as SFR009
  usecase "SFR010: Process Contextualized News to Extract Relevant Information for User's Financial Situations" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI Component to Identify Potential Impacts on Users' Investments" as SFR011
  
  c --> (AIFR007 : Generate Contextualized News Insights Based on User's Portfolio)
  
  fa --> (FAFR003 : View Predictive Analytics About Clients' Financial Situations)
}

rectangle "User Feedback System" {
  usecase "CFR11: Send Feedback about the System's Recommendations and Insights to Improve Future Outputs" as CFR11
  
  c --> (SFR020 : Manage User Feedback for Continuous Improvement of Insights)
}
@enduml