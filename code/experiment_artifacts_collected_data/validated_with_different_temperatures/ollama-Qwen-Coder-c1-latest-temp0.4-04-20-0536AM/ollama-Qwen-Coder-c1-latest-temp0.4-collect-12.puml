@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFD002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> FAFD002
}

rectangle "Client Dashboard Features" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "SFR017: Generate Financial Health Reports" as SFR017
  
  Client --> CFR009
  Client --> SFR017
}

rectangle "Client Alerts and Notifications" {
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  
  Client --> CFR002
  Client --> SFR013
}

rectangle "Client Recommendations and Insights" {
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "SFR002: Request Personalized Recommendations from AI Component" as SFR002
  
  Client --> CFR004
  Client --> SFR002
}

rectangle "Client Spending Limits and Alerts" {
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  
  Client --> CFR010
  Client --> SFR005
}

rectangle "Client Investment Opportunities and News" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  
  Client --> CFR007
  Client --> SFR006
}

rectangle "Client News and Insights" {
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "SFR010: Request Contextualized News from AI Component" as SFR010
  
  Client --> CFR008
  Client --> SFR010
}

rectangle "Client Feedback and Improvement" {
  usecase "CFR11: Send Feedback about the System's Recommendations and Insights" as CFR11
  
  Client --> CFR11
}
@enduml