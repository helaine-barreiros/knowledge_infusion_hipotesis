@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System: as Sys
:Financial Advisor: as FAdvisor
:System Administrator: as SAAdmin

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  
  Client --> CFR001
  Client --> FAFR002
  SysAdmin --> SAFR001
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  
  FinancialAdvisor --> FAFR001
  FinancialAdvisor --> FAFR002
}

rectangle "Client Dashboard" {
  usecase "CFR009: Access a Personalized Dashboard that Consolidates My Financial Information in a Single View" as CFR009
  usecase "SFR12: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as SFR12
  
  Client --> CFR009
}

rectangle "Investment Opportunities" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile (as Defined Under MiFID II or Equivalent Standards)" as CFR007
  usecase "SFR06: Request Investment Opportunity Analysis from AI Component" as SFR06
  
  Client --> CFR007
}

rectangle "Spending Limits and Alerts" {
  usecase "CFR006: View Spending Limit Alerts When I Exceed Predefined Thresholds in Specific Expense Categories" as CFR006
  usecase "SFR05: Request Spending Limit Alerts from AI Component" as SFR05
  
  Client --> CFR006
}

rectangle "News and Updates" {
  usecase "CFR008: View News Related to My Investment Portfolio to Stay Informed About Market Events That Might Affect My Assets" as CFR008
  usecase "SFR09: Request Contextualized News Relevant to Users' Financial Portfolios from Trusted Financial News Sources" as SFR09
  
  Client --> CFR008
}

rectangle "Feedback and Improvement" {
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as CFR11
  
  User -> (Client)
  User -> (Financial Advisor)
  User -> (System Administrator) : CFR11
}

@enduml