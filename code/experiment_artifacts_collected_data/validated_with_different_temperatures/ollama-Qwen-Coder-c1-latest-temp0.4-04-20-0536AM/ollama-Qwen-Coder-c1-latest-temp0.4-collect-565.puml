@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR010)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR019: Maintain Historical Record of Insights" as SFR019
  usecase "SFR20: Manage User Feedback" as SFR20
  
  SA --> (SAFR001)
  SA --> (SFR019)
  SA --> (SFR20)
}

package "System" {
  rectangle SystemBoundary {
    actor Client as C
    actor FinancialAdvisor as FA
    
    usecase "SFR001: Deliver Alerts" as SFR001
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
    usecase "SFR005: Request Spending Limit Alerts" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities Matching Criteria" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Portfolios" as SFR009
    usecase "SFR10: Process Contextualized News for Users" as SFR10
    usecase "SFR11: Request Contextualized News Insights from AI" as SFR11
    usecase "SFR12: Generate Client Dashboards" as SFR12
    usecase "SFR13: Generate Client Alerts Based on Predefined Conditions" as SFR13
    usecase "SFR14: Generate Client Analytics" as SFR14
    usecase "SFR15: Request Predictive Intervention Analyses from AI" as SFR15
    usecase "SFR16: Request Predictive Insights from AI" as SFR16
    usecase "SFR17: Generate Financial Health Reports" as SFR17
    usecase "SFR18: Manage Users' Financial Goals" as SFR18
    
    C --> (SFR002)
    FA --> (SFR003)
  }
}

package "AI System" {
  rectangle AIBoundary {
    actor Client as C
    actor FinancialAdvisor as FA
    
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations Based on Profiles and Goals" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Matching User Strategies and Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts Based on Pattern Recognition" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights Correlated with Portfolios" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations for Engagement Opportunities" as AIFR008
    usecase "AIFR009: Generate Forward-Looking Analysis of Financial Situations to Support Planning" as AIFR009
    
    C --> (AIFR002)
    FA --> (AIFR004)
  }
}

package "User Feedback System" {
  actor User as U
  
  usecase "CFR11: Send Feedback About Recommendations and Insights" as CFR11
  
  U --> (SFR20)
}
@enduml