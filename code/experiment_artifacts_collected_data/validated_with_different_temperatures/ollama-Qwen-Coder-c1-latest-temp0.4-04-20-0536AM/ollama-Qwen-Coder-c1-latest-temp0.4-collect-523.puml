@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001
:AIFR001: as AIFR001

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Deliver Personalized Recommendations to Users" as SFR003
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  
  Client --> CFR001 : "View Financial Insights Dashboard"
  Client --> SAFR001 : "Manage Analysis Parameters"
  SysAdmin --> SAFR001 : "Manage System Analysis Parameters"
  
  FAFR001 --> FAFR002 : "View Client Intervention Alerts"
  FAFR001 --> SFR003 : "Deliver Personalized Recommendations to Users"
  AIFR001 --> SAFR001 : "Manage System Analysis Parameters"
}

rectangle "Client" {
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  
  Client --> CFR002 : "Receive Anomaly Transaction Alerts"
  Client --> CFR003 : "View Financial Predictions"
  Client --> CFR004 : "Receive Personalized Recommendations"
  Client --> CFR005 : "Manage Recommendation Preferences"
  Client --> CFR006 : "View Spending Limit Alerts"
  Client --> CFR007 : "View Investment Opportunities"
  Client --> CFR008 : "View News Related to Portfolio"
  Client --> CFR009 : "Access Personalized Dashboard"
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
  
  FAFR001 --> SAFR001 : "Manage System Analysis Parameters"
}

rectangle "System" {
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  
  SysAdmin --> SAFR001 : "Manage System Analysis Parameters"
}

rectangle "User (Client, Financial Advisor, or System Administrator)" {
  usecase "CFR011: Send Feedback about Recommendations and Insights" as CFR011
}
@enduml