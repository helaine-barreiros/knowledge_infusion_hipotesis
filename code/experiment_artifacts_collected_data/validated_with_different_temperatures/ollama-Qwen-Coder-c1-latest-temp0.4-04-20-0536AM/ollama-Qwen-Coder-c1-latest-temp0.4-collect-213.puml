@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts About Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Current Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as CFR004
  usecase "CFR005: Manage Personalized Recommendations Preferences to Ensure Insights Relevant to My Financial Objectives and Risk Tolerance" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Specific Expense Categories" as CFR006
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile (as Defined Under MiFID II or Equivalent Standards)" as CFR007
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "CFR009: Access a Personalized Dashboard That Consolidates Financial Information in a Single View" as CFR009
  usecase "CFR010: Manage Relationship with Financial Advisors, Including Permissions for Sharing Data" as CFR010
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR010)
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts When Patterns Require Professional Attention" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments Based on Different Profiles and Regulatory Requirements" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SystemAdmin as SA
  usecase "SAFR001: Manage Analysis Parameters for the AI System to Ensure Compliance with Financial Regulations" as SAFR001
  
  SA --> (SAFR001)
}

rectangle "AI Component" {
    usecase "AIFR001: Generate Financial Predictions by Analyzing Historical Data, Market Trends, and Economic Indicators" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations Based on Financial Profiles, Goals, and Risk Tolerance" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users Based on Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Aligning with User Strategies and Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights Correlating Financial News With User Portfolios" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Planning" as AIFR009
    
    C --> (AIFR001)
    FA --> (AIFR002)
    SA --> (AIFR003)
}

rectangle "System" {
  usecase "SFR001: Deliver Alerts to Users Through Appropriate Notification Channels" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations Based on Financial Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions From AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component Based on User Data and Preferences" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component When Exceeding Thresholds" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis From AI Component to Identify Suitable Investments Based on Risk Profiles" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Matching User Criteria and ESG Preferences from AI Component" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts From AI Component to Detect Potentially Fraudulent Activities in Accordance with AML Regulations" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to User Financial Portfolios from Trusted Sources" as SFR009
  usecase "SFR010: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR010
  usecase "SFR011: Request Contextualized News Insights From AI Component Identifying Potential Impacts on User Investments" as SFR011
  usecase "SFR012: Generate Client Dashboards Presenting Financial Information in an Intuitive Format" as SFR012
  usecase "SFR013: Generate Client Alerts Based On Predefined Conditions to Ensure Timely Notification of Important Events" as SFR013
  usecase "SFR014: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses From AI Component Identifying When Advisors Should Engage with Clients" as SFR015
  usecase "SFR016: Request Predictive Insights from AI Component to Enhance Value of Financial Guidance Provided to Users" as SFR016
  usecase "SFR017: Generate Financial Health Reports Assessing User's Overall Wellbeing According to Standard Metrics" as SFR017
  usecase "SFR018: Manage User Goals Tracking Progress and Providing Relevant Recommendations" as SFR018
  usecase "SFR019: Maintain Historical Record of Users' Insights for Trend Analysis" as SFR019
  usecase "SFR020: Manage User Feedback to Continuously Improve Accuracy and Relevance of Outputs" as SFR020
  
  C --> (SFR001)
  FA --> (SFR002)
  SA --> (SFR003)
}

C --> (CFR011)
FA --> (FAFR005)
SA --> (SAFR006)

@enduml