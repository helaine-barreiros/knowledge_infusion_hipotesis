@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR002
}

package SystemAdministrator {
  actor "System Administrator" as SAFR003
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  SAFR003 --> (Manage Analysis Parameters)
}

rectangle ClientSubsystem {
  package FinancialInsightsDashboard {
    usecase "CFR001: View Financial Insights Dashboard" as CFR001
    CFR001 <|-- (View Financial Insights Dashboard)
    
    usecase "CFR002: Receive Alerts about Anomalous Transactions" as SAFR003
    CFR001 --> (Receive Alerts about Anomalous Transactions)
  }
  
  package PredictiveAnalytics {
    usecase "CFR003: View Financial Predictions" as SAFR004
    CFR001 --> (View Financial Predictions)
    
    usecase "FAFR003: View Predictive Analytics About Client's Financial Situations" as FAFR003
    FAFR002 --> (View Predictive Analytics About Client's Financial Situations)
  }
  
  package PersonalizedRecommendations {
    usecase "CFR004: Receive Personalized Recommendations" as SAFR005
    CFR001 --> (Receive Personalized Recommendations)
    
    usecase "FAFR002: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR002
    FAFR002 --> (Manage Client Mentoring Sessions Based on System-Generated Insights)
  }
  
  package SpendingLimitAlerts {
    usecase "CFR006: View Spending Limit Alerts" as SAFR006
    CFR001 --> (View Spending Limit Alerts)
    
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as AIFR003
  }
  
  package InvestmentOpportunities {
    usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as SAFR008
    CFR001 --> (View Investment Opportunities Suitable to My Risk Profile)
    
    usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
    FAFR002 --> (Configure Analysis Parameters for Specific Client Segments)
  }
  
  package News {
    usecase "CFR008: View News Related to My Investment Portfolio" as SAFR010
    CFR001 --> (View News Related to My Investment Portfolio)
    
    usecase "SFR007: Request Contextualized News Insights from AI Component" as AIFR007
  }
  
  package RelationshipManagement {
    usecase "CFR10: Manage Relationship with Financial Advisors" as SAFR009
    CFR001 --> (Manage Relationship with Financial Advisors)
    
    usecase "SFR020: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as AIFR018
  }
}

rectangle AdvisorSubsystem {
  package ClientMentoringSessions {
    usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR002
    FAFR002 --> (Manage Client Mentoring Sessions Based on System-Generated Insights)
    
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component to Identify When Financial Advisors Should Engage with Clients" as AIFR014
  }
  
  package InvestmentOpportunities {
    usecase "FAFR002: View Client Intervention Alerts When the System Detects Patterns Requiring Professional Attention" as FAFR005
    FAFR002 --> (View Client Intervention Alerts When the System Detects Patterns Requiring Professional Attention)
    
    usecase "SFR016: Request Predictive Insights from AI Component to Enhance the Value of Financial Guidance Provided to Clients" as AIFR017
  }
  
  package News {
    usecase "FAFR003: View Predictive Analytics About Client's Financial Situations" as FAFR004
    FAFR002 --> (View Predictive Analytics About Client's Financial Situations)
    
    usecase "SFR017: Request Contextualized News Insights from AI Component to Identify Potential Impacts on Users' Investments" as AIFR016
  }
}

rectangle System {
  package Notifications {
    usecase "SFR001: Deliver Alerts to Users Through Appropriate Notification Channels" as SAFR002
    CFR001 --> (Deliver Alerts to Users Through Appropriate Notification Channels)
    
    usecase "SAFR003: Generate Client Alerts Based on Predefined Conditions" as AIFR008
  }
  
  package Recommendations {
    usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SAFR004
    CFR001 --> (Deliver Personalized Recommendations to Users Based on Their Financial Profiles)
    
    usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance As Defined by Industry Standards Like FINRA Guidelines" as AIFR002
  }
  
  package Predictions {
    usecase "SFR003: Request Financial Predictions from the AI Component to Provide Users with Forward-Looking Financial Insights" as SAFR014
    CFR001 --> (Request Financial Predictions from the AI Component)
    
    usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
  }
  
  package Insights {
    usecase "SFR024: Request Contextualized News Insights from the AI Component to Identify Potential Impacts on Users' Investments" as SAFR007
    CFR001 --> (Request Contextualized News Insights)
    
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR005
  }
  
  package Analytics {
    usecase "SFR14: Generate Client Analytics That Provide Meaningful Insights into Financial Behavior and Performance" as SAFR026
    CFR001 --> (Generate Client Analytics)
    
    usecase "AIFR009: Generate Predictive Intervention Recommendations by Identifying Patterns that Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR015
    
    usecase "SFR17: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SAFR028
  }
}

rectangle User {
  actor "User (Client, Financial Advisor, or System Administrator)" as CFR011
  
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as AIFR029
  CFR011 --> (Send Feedback About the System's Recommendations and Insights)
}

@enduml