@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Segment" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SysAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
  usecase "AIFR007: Generate Contextualized News Insights for Users" as AIFR007
  
  SA --> (SAFR001)
}

package "System" {
  rectangle "AI System" {
    usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
    usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
    
    C --> (SFR002)
    FA --> (SFR002)
    
    C --> (AIFR002)
    FA --> (AIFR002)
  }
  
  rectangle "AI Component" {
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
    
    C --> (SFR003)
    FA --> (SFR003)
    
    C --> (AIFR001)
    FA --> (AIFR001)
  }
  
  rectangle "Spending Limit Alerts" {
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
    
    C --> (SFR005)
    FA --> (SFR005)
    
    C --> (AIFR003)
    FA --> (AIFR003)
  }
  
  rectangle "Investment Opportunities Analysis" {
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
    
    C --> (SFR006)
    FA --> (SFR006)
    
    C --> (AIFR004)
    FA --> (AIFR004)
  }
  
  rectangle "Investment Opportunities Matching User Criteria" {
    usecase "SFR012: Request Specific Investment Opportunities from AI Component that Match User Criteria and ESG Preferences" as SFR012
    usecase "AIFR005: Generate Investment Opportunities for Users by Identifying Financial Instruments That Align with Their Investment Strategies and Modern Portfolio Theory Principles" as AIFR005
    
    C --> (SFR012)
    FA --> (SFR012)
    
    C --> (AIFR005)
    FA --> (AIFR005)
  }
  
  rectangle "Anomaly Transaction Alerts" {
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
    
    C --> (SFR008)
    FA --> (SFR008)
    
    C --> (AIFR006)
    FA --> (AIFR006)
  }
  
  rectangle "News Insights for Users' Financial Portfolios" {
    usecase "SFR013: Request Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR013
    usecase "SFR017: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as SFR018
    
    C --> (SFR013)
    FA --> (SFR013)
    
    C --> (SFR017)
    FA --> (SFR017)
  }
  
  rectangle "Client Predictive Insights for Forward-Looking Analysis" {
    usecase "AIFR009: Generate Client Predictive Insights That Provide Forward-looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009
    
    C --> (AIFR009)
  }
  
  rectangle "Financial Health Reports for Users' Overall Financial Wellbeing" {
    usecase "SFR17: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR17
    
    C --> (SFR17)
  }

  rectangle "User Feedback Management" {
    usecase "CFR11: Send Feedback About System's Recommendations and Insights" as CFR11

    C --> (CFR11)
  }
}

@enduml