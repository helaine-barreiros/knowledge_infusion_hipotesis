@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations" as FAFR005
  usecase "CFR006: Manage Recommendation Preferences" as CFR010
  
  CFR001 --> (View Financial Insights Dashboard) : CFR001
  CFR001 --> SAFR003
  CFR001 --> FAFR005
  CFR001 --> CFR010
}

package "Financial Advisor" {
  actor "Financial Advisor" as FAFR002
  
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as SAFR007
  usecase "FAFR006: View Predictive Analytics about Clients' Financial Situations" as AIFR009
  
  FAFR002 --> (Manage Client Mentoring Sessions) : FAFR001
  FAFR002 --> SAFR004
  FAFR002 --> AIFR006
}

package "System" {
  actor "System Administrator" as SAFR001
  
  usecase "SFR003: Request Financial Predictions from AI Component" as AIFR001
  usecase "SFR004: Request Personalized Recommendations from AI Component" as AIFR002
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as AIFR003
  
  SAFR001 --> (Manage Analysis Parameters) : SAFR001
  SAFR001 --> SFR003
  SAFR001 --> SFR004
  SAFR001 --> SFR005
}

package "AI System" {
  actor "AI Component" as AIFR
  
  usecase "AIFR007: Generate Contextualized News Insights" as SFR008
  usecase "AIFR009: Generate Client Predictive Intervention Recommendations" as FAFR006
  
  AIFR --> (Generate Financial Predictions) : AIFR001
  AIFR --> (Generate Personalized Recommendations) : AIFR002
  AIFR --> SFR007
  AIFR --> FAFR009
}

package "User" {
  actor "Client, Financial Advisor, or System Administrator" as CFR011
  
  usecase "CFR011: Send Feedback about Recommendations and Insights" as SAFR020
  
  CFR011 --> (Send Feedback) : CFR011
}
@enduml