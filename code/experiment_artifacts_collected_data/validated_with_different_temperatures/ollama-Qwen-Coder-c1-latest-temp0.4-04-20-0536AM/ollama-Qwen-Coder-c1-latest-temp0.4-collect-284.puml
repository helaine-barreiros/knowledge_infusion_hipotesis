@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SA --> SAFR001
}

rectangle "System Components" {

  package "AI Component" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on Modern Portfolio Theory" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
    
    SAFR001 --> (AIFR001)
    SAFR001 --> (AIFR002)
    SAFR001 --> (AIFR003)
    SAFR001 --> (AIFR004)
    SAFR001 --> (AIFR005)
    SAFR001 --> (AIFR006)
    SAFR001 --> (AIFR007)
    SAFR001 --> (AIFR008)
    SAFR001 --> (AIFR009)

    FAFR004 <|-- AIFR003
  }

  package "User Interface" {
    usecase "SFR012: Generate Client Dashboards" as SFR012
    
    C --> SFR012
    FA --> SFR012
    SA --> SFR012
  }
  
  rectangle "Notification System" {
    usecase "SFR003: Deliver Alerts to Users" as SFR003

    (AIFR006) --> (SFR003)
    (AIFR008) --> (SFR003)

    SAFR001 --> (SFR003)
  }
  
  rectangle "Recommendation Engine" {
    usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002

    (AIFR002) --> (SFR002)

    SAFR001 --> (SFR002)
  }
  
  rectangle "Prediction Engine" {
    usecase "SFR004: Request Financial Predictions from AI Component" as SFR004
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006

    (AIFR001) --> (SFR004)
    (AIFR005) --> (SFR006)

    SAFR001 --> (SFR004)
    SAFR001 --> (SFR006)
  }
  
  rectangle "Intervention Engine" {
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015

    (AIFR008) --> (SFR015)

    SAFR001 --> (SFR015)
  }
  
  rectangle "Insight Engine" {
    usecase "SFR017: Generate Financial Health Reports Based on Standard Ratios and Metrics" as SFR017
    usecase "SFR020: Manage Users' Financial Goals to Track Progress and Provide Relevant Recommendations" as SFR020

    (AIFR009) --> (SFR017)
    
    SAFR001 --> (SFR020)
  }
  
  rectangle "News Engine" {
    usecase "SFR008: Request Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR009
    usecase "SFR10: Process Contextualized News Insights from AI Component" as SFR10

    (AIFR007) --> (SFR008)
    
    SAFR001 --> (SFR10)
  }
  
}

package "Feedback System" {
  usecase "CFR11: Send Feedback about Recommendations and Insights to Improve Future Outputs" as CFR11
  
  C --> CFR11
  FA --> CFR11
  SA --> CFR11
}
@enduml