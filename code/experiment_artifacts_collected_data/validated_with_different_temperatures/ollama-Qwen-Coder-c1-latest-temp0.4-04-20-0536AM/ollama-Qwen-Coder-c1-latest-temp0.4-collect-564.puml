@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  Client --> (SFR012) : Generate client dashboards
  Client --> (SFR013) : Generate client alerts
  Client --> (SFR014) : Generate client analytics
  Client --> (AIFR007) : Generate contextualized news insights
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FinancialAdvisor --> (SFR016) : Request predictive insights from AI component
}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SystemAdministrator --> (AIFR002) : Generate personalized recommendations for users based on financial profiles, goals, and risk tolerance
}

package "Notifications" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR013: Request Client Alerts from AI Component" as SFR013
  
  System --> (SFR001) : Deliver alerts through appropriate notification channels
}

package "Recommendations" {
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  usecase "AIFR002" : Generate personalized recommendations for users
  
  System --> (SFR002) : Deliver personalized recommendations based on user financial profiles
}

package "Predictions and Insights" {
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR001" : Generate financial predictions for users
  
  System --> (SFR003) : Request financial predictions from the AI component to provide forward-looking financial insights
}

package "Spending Limits and Alerts" {
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "AIFR003" : Generate spending limit alerts for users
  
  System --> (SFR005) : Request spending limit alerts when user spending patterns exceed defined thresholds
}

package "Investment Opportunities and ESG" {
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "AIFR004" : Generate investment opportunity analyses for users
  
  System --> (SFR006) : Request investment opportunity analysis to identify suitable investments for users based on their risk profiles.
}

package "News and Insights" {
  usecase "SFR007: Request Contextualized News from AI Component" as SFR007
  usecase "AIFR005" : Generate contextualized news insights
  
  System --> (SFR007) : Request specific investment opportunities that match user investment criteria and ESG preferences.
}

package "Predictive Interventions" {
  usecase "SFR15: Request Predictive Intervention Analyses from AI Component" as SFR15
  usecase "AIFR008" : Generate client predictive intervention recommendations
  
  System --> (SFR15) : Request predictive interventions to identify when financial advisors should engage with clients.
}

package "AI Functionality" {
  usecase "AIFR009" : Generate Client Predictive Insights
  usecase "AIFR017" : Generate Financial Health Reports
  
  System --> (AIFR009) : Request predictive insights from the AI component to enhance the value of financial guidance provided to clients.
}

package "Feedback and Improvement" {
  usecase "CFR11: Send Feedback about Recommendations and Insights" as CFR11
  usecase "SFR20: Manage User Feedback" as SFR20
  
  System --> (SFR20) : Manage user feedback to continuously improve the quality and relevance of financial insights.
}

@enduml