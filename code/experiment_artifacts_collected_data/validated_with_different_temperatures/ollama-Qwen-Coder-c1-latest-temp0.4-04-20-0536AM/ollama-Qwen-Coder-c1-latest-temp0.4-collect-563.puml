@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (SAFR002) : Receive Anomalous Transaction Alerts
  C --> (FAFR003) : View Predictive Analytics
  C --> (SFR006) : Request Investment Opportunity Analysis
  C --> (AIFR004) : Generate Investment Opportunity Analyses for Users
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
  
}

package FinancialAdvisor {
  actor "Financial Advisor" as FA

  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as FAFR003
  
  FA --> (SFR005) : Request Spending Limit Alerts from AI Component
  FA --> (AIFR006) : Generate Anomaly Transaction Alerts by Employing Pattern Recognition

  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  
}

package System {
  actor "System" as Sys

  usecase "SFR001: Deliver Alerts to Users through Appropriate Notification Channels" as SFR001
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component based on Each User's Financial Data and Preferences" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component When User Spending Patterns Exceed Defined Thresholds" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities from AI Component that Match User Investment Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component to Detect Potentially Fraudulent Activities in Accordance with AML Regulations" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios from Trusted Financial News Sources" as SFR009
  usecase "SFR010: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI Component to Identify Potential Impacts on Users' Investments" as SFR011
  usecase "SFR012: Generate Client Dashboards that Present Financial Information in an Intuitive and Actionable Format" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR013
  usecase "SFR014: Generate Client Analytics that Provide Meaningful Insights into Financial Behavior and Performance" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI Component to Identify When Financial Advisors Should Engage with Clients" as SFR015
  usecase "SFR016: Request Predictive Insights from AI Component to Enhance the Value of Financial Guidance Provided to Clients" as SFR016
  usecase "SFR017: Generate Financial Health Reports that Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR017
  usecase "SFR018: Manage Users' Financial Goals to Track Progress and Provide Relevant Recommendations" as SFR018
  usecase "SFR019: Maintain a Historical Record of Users' Insights to Enable Trend Analysis and Effectiveness Measurement" as SFR019
  usecase "SFR020: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR020
  
  Sys --> (AIFR003) : Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance as Defined by Industry Standards
  Sys --> (SFR017) : Generate Financial Health Reports that Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics
  
  Sys --> SFR001
  Sys --> SFR002
  Sys --> SFR003
  Sys --> SFR004
  Sys --> SFR005
  Sys --> SFR006
  Sys --> SFR007
  Sys --> SFR008
  Sys --> SFR009
  Sys --> SFR010
  Sys --> SFR011
  Sys --> SFR012
  Sys --> SFR013
  Sys --> SFR014
  Sys --> SFR015
  Sys --> SFR016
  Sys --> SFR017
  Sys --> SFR018
  Sys --> SFR019
  
}

package AI {
  actor "AI System" as A

  usecase "AIFR003: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance as Defined by Industry Standards" as AIFR003
  usecase "AIFR004: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as AIFR004
  usecase "AIFR005: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR005
  
  A --> (SFR012) : Generate Client Dashboards that Present Financial Information in an Intuitive and Actionable Format
  A --> (AIFR006) : Generate Anomaly Transaction Alerts by Employing Pattern Recognition

  A --> AIFR003
  A --> AIFR004
  A --> AIFR005
  
}

package SystemAdministrator {
  actor "System Administrator" as SA

  usecase "SAFR001: Manage Analysis Parameters for the AI System to Ensure Algorithms Remain Accurate, Relevant, and Compliant with Financial Regulations Such as Basel III for Risk Management" as SAFR001
  usecase "CFR11: Send Feedback about System's Recommendations and Insights to Help Improve Accuracy and Relevance of Future Outputs" as CFR11
  
  SA --> (SAFR001) : Manage Analysis Parameters

  SA --> SAFR001
  SA --> CFR11
  
}

@enduml