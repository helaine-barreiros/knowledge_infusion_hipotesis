@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FinancialAdvisor

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "AIFR009: Generate Contextualized News Insights" as AIFR009
  
  Client --> CFR001
  Client --> FAFR002
  SysAdmin --> SAFR001
}

rectangle "Financial Advisor Module" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  
  FinancialAdvisor --> FAFR001
  FinancialAdvisor --> FAFR002
}

rectangle "Client Management Module" {
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "SFR005: Request Spending Limit Alerts" as SFR005
  
  Client --> CFR004
  Client --> FAFR002
}

rectangle "Investment Module" {
  usecase "CFR010: View Investment Opportunities" as CFR010
  usecase "FAFR007: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FinancialAdvisor --> FAFR002
}

rectangle "Alerts and Notifications Module" {
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  
  FinancialAdvisor --> FAFR002
}

rectangle "User Feedback Module" {
  usecase "CFR011: Send Feedback about the System's Recommendations and Insights" as CFR011
  
  Client --> CFR011
  SysAdmin --> SAFR001
  FinancialAdvisor --> FAFR004
}
@enduml