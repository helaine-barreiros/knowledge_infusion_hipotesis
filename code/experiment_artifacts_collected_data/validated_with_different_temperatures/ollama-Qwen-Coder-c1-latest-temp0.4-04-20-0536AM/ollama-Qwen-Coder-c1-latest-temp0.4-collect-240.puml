@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
  
  usecase "CFR002: View Alerts About Anomalous Transactions" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations Based on Financial Profile and Goals" as SAFR005
  usecase "CFR006: Manage Personalized Recommendations Preferences to Ensure Relevance to Financial Objectives and Risk Tolerance" as SAFR012
  
  CFR001 --> SAFR003 : "View Alerts"
  CFR001 --> SAFR004 : "Receive Recommendations"
  CFR001 --> SAFR005 : "Manage Preferences"
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR002
  
  usecase "FAFR003: View Predictive Analytics About Client's Financial Situations to Provide Data-Driven Recommendations During Consultations" as SAFR016
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments Based on Different Profiles and Regulatory Requirements" as SAFR021
  
  FAFR002 --> SAFR013 : "View Alerts"
  FAFR002 --> SAFR016 : "View Analytics"
  FAFR002 --> SAFR021 : "Configure Parameters"
}

package System {
  actor "System" as SFR005
  
  usecase "SFR007: Request Investment Opportunity Analysis from AI Component Based on User Risk Profiles and Financial Goals" as AIFR004
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR006
  
  SFR005 --> SAFR013 : "Deliver Alerts"
  SFR005 --> AIFR004 : "Request Investment Analysis"
  SFR005 --> AIFR006 : "Request Anomaly Alerts"
}

package AI {
  actor "AI System" as AIFR007
  
  usecase "AIFR013: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as SAFR026
  usecase "AIFR014: Generate Client Predictive Intervention Recommendations Based on Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as SAFR037
  
  AIFR007 --> SAFR025 : "Generate Insights"
  AIFR007 --> SAFR038 : "Generate Predictive Recommendations"
}

package User {
  actor "User (Client, Financial Advisor, or System Administrator)" as CFR011
  
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights to Help Improve Future Outputs" as SFR024
  
  CFR011 --> SAFR039 : "Send Feedback"
}

@enduml