@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FinancialAdvisor

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
  User --> CFR001
  SysAdmin --> SAFR001
  FinancialAdvisor --> FAFR003
}

rectangle "Client Dashboard" {
  usecase "CFR002: View Alerts" as CFR002
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  
  User --> CFR002
  User --> CFR009
}

rectangle "Financial Advisor Dashboard" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FinancialAdvisor --> FAFR001
  FinancialAdvisor --> FAFR004
}

rectangle "System Notifications" {
  usecase "SFR003: Request Alerts from AI Component" as SFR003
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  
  System --> SFR003
  System --> AIFR006
}

rectangle "AI Recommendations" {
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  
  System --> SFR002
  System --> AIFR001
}

rectangle "Investment Opportunities" {
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  
  System --> SFR006
  System --> AIFR004
}

rectangle "News and Insights" {
  usecase "SFR013: Request Predictive Insights from AI Component" as SFR013
  usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
  
  System --> SFR013
  System --> AIFR007
}

rectangle "Feedback and Improvement" {
  usecase "CFR011: Send Feedback about the System's Recommendations and Insights" as CFR011
  
  User --> CFR011
}
@enduml