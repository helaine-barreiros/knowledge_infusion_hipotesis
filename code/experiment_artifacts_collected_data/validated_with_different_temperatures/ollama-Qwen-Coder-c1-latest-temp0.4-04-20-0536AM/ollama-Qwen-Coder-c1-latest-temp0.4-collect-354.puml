@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
}

package "System Administrator" {
  actor SysAdmin as SAFR003
}

rectangle "User Interface" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "SAFR017: Generate Financial Health Reports" as SAFR017
  
  CFR001 --> (CFR009)
  FAFR002 --> (SAFR017)
}

rectangle "Alerts & Notifications" {
  usecase "SFR003: Deliver Alerts to Users" as SFR003
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  
  CFR001 --> (SFR003)
  FAFR002 --> (SFR003)
  SysAdmin --> (SFR003)
}

rectangle "Personalized Recommendations & Insights" {
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  
  CFR001 --> (CFR004)
  FAFR002 --> (FAFR001)
  SysAdmin --> (SAFR005) <|-- (FAFR003)
}

rectangle "Financial Insights & Predictions" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SFR004: Request Financial Predictions from AI Component" as SFR004
  
  CFR001 --> (CFR001)
}

rectangle "Investment Opportunities & News" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  
  CFR001 --> (CFR007)
}

rectangle "Spending Limits & Management" {
  usecase "CFR006: View Spending Limit Alerts When I Exceed Predefined Thresholds in Specific Expense Categories" as CFR006
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  
  CFR001 --> (CFR006)
}

rectangle "System Management & Feedback" {
  usecase "SAFR003: Manage Analysis Parameters for the AI System" as SAFR003
  usecase "AIFR002: Generate Personalized Recommendations Based on User Data and Preferences" as AIFR002
  
  SysAdmin --> (SAFR001)
}

rectangle "AI Functionality & Predictive Insights" {
  usecase "SFR016: Request Predictive Insights from AI Component to Enhance the Value of Financial Guidance Provided to Clients" as SFR016
  usecase "AIFR009: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009
  
  SysAdmin --> (SFR015)
}

rectangle "User Feedback & Continuous Improvement" {
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights" as CFR11
  
  CFR001 --> (CFR11)
  FAFR002 --> (CFR11)
  SysAdmin --> (CFR11)
}

@enduml