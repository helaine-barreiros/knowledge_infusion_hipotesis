@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as SAFR004
  usecase "CFR005: Manage Personalized Recommendations Preferences" as SAFR006
  
  CFR001 --> (SAFR002)
  CFR001 --> (SAFR003)
  CFR001 --> (SAFR004)
  CFR001 --> (SAFR005)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts" as SAFR007
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as SAFR008
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as SAFR012
  
  FAFR001 --> (SAFR007)
  FAFR001 --> (SAFR008)
  FAFR001 --> (SAFR012)
}

package "System Administrator" {
  actor SystemAdmin as SAFR009
  
  usecase "SAFR001: Manage Analysis Parameters for the AI system" as SAFR001
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  
  SAFR009 --> (SAFR001)
  SAFR009 --> (SFR013)
}

package "System Components" {
  rectangle "Notifications System" {
    usecase "SFR002: Deliver Alerts to Users Through Appropriate Notification Channels" as SFR002
  }
  
  rectangle "Recommendations Engine" {
    usecase "SFR004: Request Personalized Recommendations from the AI Component Based on Each User's Financial Data and Preferences" as AIFR001
  }
  
  rectangle "Predictive Analytics Module" {
    usecase "AIFR009: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR002
  }
}

rectangle "AI System" {
  usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR003
  
  rectangle "Personalized Recommendations Generator" {
    usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance As Defined By Industry Standards Like FINRA Guidelines" as AIFR004
  }
  
  rectangle "Spending Limit Alert System" {
    usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as AIFR005
  }
  
  rectangle "Investment Opportunity Analysis Engine" {
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR006
  }
  
  rectangle "Anomaly Transaction Detection System" {
    usecase "AIFR005: Generate Anomaly Transaction Alerts By Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance With FinCEN Requirements" as AIFR007
  }
  
  rectangle "Contextualized News Insights Generator" {
    usecase "AIFR006: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR008
  }
}

rectangle "User Interface" {
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights" as CFR11
  
  rectangle "Client Dashboard Generator" {
    usecase "SFR12: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as SFR014
  }
  
  rectangle "Investment Opportunity Selector" {
    usecase "AIFR05: Generate Investment Opportunities for Users by Identifying Financial Instruments that Align with Their Investment Strategies and Modern Portfolio Theory Principles" as AIFR009
  }

}

@enduml