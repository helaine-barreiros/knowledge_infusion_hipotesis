@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
  
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004
}

package "System Administrator" {
  actor SysAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  
  SA --> SAFR001
}

rectangle "AI Component" {
  
  package "Alerts" {
    usecase "SFR008: Request Anomaly Transaction Alerts from AIFR006" as SFR008
    usecase "AIFR006: Generate Anomaly Transaction Alerts for Users" as AIFR006
    
    C --> SFR008 : "Receive"
  }
  
  package "Recommendations" {
    usecase "SFR002: Deliver Personalized Recommendations to Users based on Profiles" as SFR002
    usecase "AIFR002: Generate Personalized Recommendations for Users Based on Financial Data and Preferences" as AIFR002
    
    C --> SFR002 : "Receive"
  }
  
  package "Predictions" {
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Data, Market Trends, and Economic Indicators" as AIFR001
    
    C --> SFR003 : "Receive"
  }
  
  package "Spending Limits" {
    usecase "SFR005: Request Spending Limit Alerts from AI Component when Exceeding Thresholds" as SFR005
    usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spreading Patterns" as AIFR003
    
    C --> SFR005 : "Receive"
  }
  
  package "Investment Opportunities" {
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
    
    C --> SFR006 : "Receive"
  }
  
  package "News Insights" {
    usecase "SFR012: Generate Client Dashboards that Present Financial Information in an Intuitive Format" as SFR012
    usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
    
    C --> SFR012 : "Receive"
  }
  
}

package "System Operations" {
  usecase "SFR013: Request Client Alerts Based on Predefined Conditions" as SFR013
  usecase "AIFR008: Generate Predictive Intervention Recommendations by Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  
  C --> SFR013 : "Receive"
}

package "User Feedback" {
  usecase "CFR11: Send Feedback about System's Recommendations and Insights" as CFR11
  
  C --> CFR11
}
@enduml