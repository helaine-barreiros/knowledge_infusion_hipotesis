@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFD
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure analysis parameters for specific client segments" as FAFR004
  usecase "SFR002: Deliver personalized recommendations to users based on their financial profiles" as SFR002
  usecase "AIFR002: Generate personalized recommendations for users based on their financial profiles, goals, and risk tolerance" as AIFR002
}

rectangle "Client Interactions" {
  Client --> CFR001 : "View Financial Insights Dashboard"
  Client --> SAFR005 : "Manage Personalized Recommendations Preferences"
  Client --> SFR019 : "Access Historical Record of Users' Insights"
  Client --> FAFD : "Send Feedback about System's Recommendations and Insights"
}

rectangle "Financial Advisor Interactions" {
  FinancialAdvisor --> SAFR004 : "Configure Analysis Parameters for Specific Client Segments"
  FinancialAdvisor --> FAFR015 : "Generate Predictive Intervention Analyses"
  FinancialAdvisor --> SFR020 : "Manage User Feedback to Improve Recommendations"
}

rectangle "System Interactions" {
  SystemAdmin --> SAFR001 : "Manage Analysis Parameters for AI System"
  System --> CFR009 : "Access Personalized Dashboard"
  System --> FAFD : "View Client Intervention Alerts and Predictive Analytics"
  System --> SFR020 : "Manage User Feedback to Improve Recommendations"
}

@enduml