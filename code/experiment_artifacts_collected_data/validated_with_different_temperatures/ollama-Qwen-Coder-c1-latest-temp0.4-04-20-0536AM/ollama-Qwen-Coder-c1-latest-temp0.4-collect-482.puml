@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR010) : "Manage Relationship with Advisors"
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SystemAdmin as SA
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  
  SA --> (SAFR001)
}

rectangle "AI Component" {
  package "Financial Insights" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    useusecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    
    SFR003 --> (AIFR001)
    SFR004 --> (AIFR002)
  }
  
  package "Alerts and Notifications" {
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    useusecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    
    C --> (SFR005)
    FA --> (SFR006)
  }
  
  package "Investment Opportunities and News" {
    usecase "SFR007: Request Specific Investment Opportunities from AI Component" as SFR007
    useusecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    
    C --> (SFR007)
  }
  
  package "Anomaly Detection and Predictive Insights" {
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    useusecase "AIFR005: Generate Investment Opportunities for Users" as AIFR005
    
    C --> (SFR008)
  }
  
  package "Contextualized News and Insights" {
    usecase "SFR009: Request Contextualized News from AI Component" as SFR009
    useusecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    
    C --> (SFR009)
  }
  
  package "Predictive Intervention and Reporting" {
    usecase "SFR15: Request Predictive Intervention Analyses from AI Component" as SFR15
    useusecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
    
    C --> (SFR15)
  }
}

package "System Functions and Management" {
  usecase "SFR020: Manage User Feedback to Improve System Outputs" as SFR020
}
  
C --> (SFR020) : "Send Feedback"
FA --> (SFR020) : "Send Feedback"
SA --> (SFR020) : "Send Feedback"

@enduml