@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive FATF Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Get Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Receive Spending Limit Alerts" as CFR006
  usecase "CFR013: View Investment Opportunities" as CFR013
  usecase "CFR014: Get News Related to Portfolio" as CFR014
  usecase "CFR015: Access Personalized Dashboard" as CFR015
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (SAFR020)
  
  C --> CFR001
  C --> CFR003
  C --> CFR004
  C --> CFR006
  C --> CFR015
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: Get Predictive Analytics for Clients" as FAFR003
  usecase "FAFR015: Engage with Client Based on Insights" as FAFR015
  
  FA --> (SAFR020)
  
  FA --> FAFR002
  FA --> FAFR003
}

package "System Administrator" {
  actor SysAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR019: Maintain Historical Record of Insights" as SFR019
  
  SA --> (FAFR020)
  
  SA --> SAFR001
}

package "System" {
  rectangle System {
    usecase "SFR001: Deliver Alerts" as SFR001
    usecase "SFR002: Provide Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
    usecase "SFR005: Request Spending Limit Alerts" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
    usecase "SFR017: Generate Financial Health Reports" as SFR017
    
    C --> (SFR002)
    
    FA --> (SFR003)
    FA --> (SFR004)
  }
}

package "AI System" {
  rectangle AI {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Provide Personalized Recommendations" as AIFR002
    usecase "AIFR003: Identify Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Find Suitable Investments Based on Risk Profile" as AIFR005
    usecase "AIFR006: Identify Anomaly Transactions" as AIFR006
    
    FA --> (AIFR001)
    FA --> (AIFR002)
    
    C --> (AIFR003)
    C --> (AIFR004)
  }
}

@enduml