@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR002
  
  usecase "FAFR003: View Predictive Analytics about Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
}

package System {
  actor "System Administrator" as SAFR001
  
  rectangle "AI Component" {
    usecase "AIFR002: Generate Personalized Recommendations Based on Financial Profiles, Goals, and Risk Tolerance" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities by Identifying Financial Instruments That Align with User's Investment Strategies and Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance With FinCEN Requirements" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009
    
    CFR001 --> (SFR020)
  }
  
  rectangle "Notification System" {
    usecase "SFR008: Request Anomaly Transaction Alerts from the AI Component" as SFR008
    usecase "SFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as SFR012
    
    CFR001 --> (SFR009)
  }
  
  rectangle "Dashboard System" {
    usecase "SFR12: Generate Client Dashboards Presenting Financial Information in an Intuitive and Actionable Format" as SFR12
    usecase "SFR17: Generate Financial Health Reports Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR17
    
    CFR001 --> (SFR18)
  }
  
  rectangle "Recommendation System" {
    usecase "SFR20: Manage User Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR20
    usecase "AIFR002: Generate Personalized Recommendations Based on Financial Profiles, Goals, and Risk Tolerance" as AIFR002
    
    CFR011 --> (SFR20)
  }
  
  rectangle "Intervention System" {
    usecase "FAFR005: View Predictive Intervention Analyses Identifying When Financial Advisors Should Engage with Clients" as FAFR005
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
    
    CFR011 --> (FAFR005)
  }
  
  rectangle "Analysis System" {
    usecase "SFR24: Request Specific Investment Opportunities from the AI Component that Match User's Investment Criteria and ESG Preferences" as SFR24
    usecase "AIFR006: Generate Anomaly Transaction Alerts Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance With FinCEN Requirements" as AIFR006
    
    CFR011 --> (SFR24)
  }
  
  rectangle "News System" {
    usecase "SFR19: Find Contextualized News Relevant to Users' Financial Portfolios from Trusted Financial News Sources" as SFR19
    usecase "AIFR007: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR007
    
    CFR011 --> (SFR19)
  }
  
  rectangle "Goal System" {
    usecase "SFR23: Manage Users' Financial Goals to Track Progress and Provide Relevant Recommendations" as SFR23
    usecase "AIFR005: Generate Investment Opportunities by Identifying Financial Instruments That Align with User's Investment Strategies and Modern Portfolio Theory Principles" as AIFR005
    
    CFR011 --> (SFR23)
  }
}

CFR001 --> FAFR003
FAFR004 <|-- SAFR001

@enduml