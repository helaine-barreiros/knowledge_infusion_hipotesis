@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FinancialAdvisor
:User: as User


rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002 
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  
  Client --> CFR001
  Client --> FAFR001
  SysAdmin --> SAFR001
  FinancialAdvisor --> FAFR001
}

rectangle "Notifications & Alerts" {
  usecase "SFR003: Deliver Alerts to Users Through Appropriate Notification Channels" as SFR003 
  usecase "AIFR006: Generate Anomaly Transaction Alerts for Users" as AIFR006
  
  Client --> SFR003
}

rectangle "Predictive Analytics & Recommendations" {
  usecase "SFR004: Request Financial Predictions from AI Component to Provide Forward-Looking Insights" as SFR004 
  usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Data and Market Trends" as AIFR001
  usecase "SFR005: Request Spending Limit Alerts from AI Component When User Spending Patterns Exceed Defined Thresholds" as SFR005 
  usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
  usecase "SFR016: Request Predictive Insights from AI Component to Enhance the Value of Financial Guidance Provided to Clients" as SFR016 
  usecase "AIFR009: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009
  
  Client --> (SFR004)
  SysAdmin --> (SAFR002)
}

rectangle "Investment Opportunities & News" {
  usecase "CFR010: View Investment Opportunities Suitable for My Risk Profile" as CFR010
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as FAFR003 
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component Based on User's Risk Profiles and Preferences" as SFR006
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004 
  usecase "SFR013: Request Contextualized News Insights from AI Component to Identify Relevant Impacts on User's Investments" as SFR013
  usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
  
  Client --> CFR010
}

rectangle "User Management & Feedback" {
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights" as CFR011

  User --> (SFR020)
}
@enduml