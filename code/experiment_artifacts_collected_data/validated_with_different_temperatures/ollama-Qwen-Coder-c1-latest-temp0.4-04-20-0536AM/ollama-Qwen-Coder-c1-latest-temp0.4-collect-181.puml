@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR003: View Financial Predictions Based on Historical Data and Trends" as SAFR004
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as SAFR005
  usecase "CFR006: Manage Personalized Recommendations Preferences to Ensure Relevance" as SAFR019
  usecase "CFR007: View Spending Limit Alerts When Exceeding Defined Thresholds in Specific Expense Categories" as SFR005
  
  CFR001 --> SAFR003
  CFR001 --> SAFR004
  CFR001 --> SAFR005
  CFR001 --> SAFR019
  CFR001 --> SFR005
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts When Patterns Require Professional Attention" as AIFR006
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as SAFR014
  
  FAFR001 --> AIFR006
  FAFR001 --> SAFR014
}

package System {
  actor "System Administrator" as SAFR002
  
  usecase "SAFR007: View Predictive Analytics About My Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as AIFR006
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SAFR002
  
  SAFR002 --> SAFR007
  SAFR002 --> SFR013
}

package AI {
  actor "AI System" as AIFR001
  
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as SAFR008
  usecase "SAFR014: View Predictive Analytics About My Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as AIFR006
  
  AIFR001 --> SAFR008
  AIFR001 --> SAFR014
}

package User {
  actor "User (Client, Financial Advisor, or System Administrator)" as CFR011
  
  usecase "CFR011: Send Feedback about the System's Recommendations and Insights to Help Improve Accuracy" as SFR020
  
  CFR011 --> SFR020
}

@enduml