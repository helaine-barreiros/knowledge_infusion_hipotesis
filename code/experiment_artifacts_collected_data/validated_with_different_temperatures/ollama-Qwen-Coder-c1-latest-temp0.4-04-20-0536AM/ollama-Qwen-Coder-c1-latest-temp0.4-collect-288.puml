@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD
:User: as User

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics about Client's Financial Situation" as FAFR003
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> FAFR003
  User --> SFR002
}

rectangle "Client Dashboards & Alerts" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  
  User --> CFR009
}

rectangle "Investment Opportunities & News" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "SFR008: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR008
  
  User --> CFR007
}

rectangle "Spending Limits & Recommendations Management" {
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
  usecase "SFR020: Manage Users' Feedback to Continuously Improve the Quality and Relevance of Financial Insights" as SFR020
  
  User --> CFR010
}

rectangle "System Functionality & Management" {
  usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition" as AIFR006
  usecase "SFR004: Request Personalized Recommendations from the AI Component Based on Each User's Financial Data and Preferences" as SFR004
  
  System Admin --> SAFR001
}

rectangle "AI Processing & Insights Generation" {
  usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance" as AIFR002
  usecase "AIFR004: Generate Spending Limit Alerts by Identifying Unusual Deviations from Established Spending Patterns" as AIFR004
  
  System Admin --> SAFR001
}

rectangle "Client Mentoring & Intervention" {
  usecase "FAFR002: View Client Intervention Alerts When the System Detects Patterns Requiring Professional Attention to Proactively Assist Clients with Potential Financial Issues" as FAFR002
  usecase "SFR015: Request Predictive Intervention Analyses from the AI Component to Identify When Financial Advisors Should Engage With Clients" as SFR015
  
  User --> FAFR002
}

rectangle "Financial Health & Goal Management" {
  usecase "CFR018: Manage Users' Financial Goals To Track Progress and Provide Relevant Recommendations" as CFR018
  usecase "SFR017: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR017
  
  User --> CFR018
}

rectangle "AI Insights & Predictive Analytics" {
  usecase "AIFR009: Generate Client Predictive Intervention Recommendations by Identifying Patterns that Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR009
  usecase "SFR016: Request Predictive Insights from the AI Component to Enhance the Value of Financial Guidance Provided to Clients" as SFR016
  
  User --> AIFR009
}

rectangle "User Feedback & Continuous Improvement" {
  usecase "CFR011: Send Feedback About the System's Recommendations and Insights To Help Improve the Accuracy and Relevance of Future Outputs" as CFR011
  
  User --> CFR011
}
@enduml