@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FinancialAdvisor
:User: as User

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  
  Client --> CFR001
  Client --> FAFR002
  SystemAdmin --> SAFR001

  rectangle "Client Dashboard Management" {
    usecase "CFR009: Access Personalized Dashboard" as CFR009
    User --> CFR009
  }

  rectangle "Financial Recommendations and Insights" {
    usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
    FinancialAdvisor --> FAFR004
    usecase "SFR012: Generate Client Dashboards that Present Financial Information in an Intuitive Format" as SFR012
    SystemAdmin --> SFR012
  }

  rectangle "Investment Opportunities and News" {
    usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
    Client --> CFR007
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    SystemAdmin --> SFR006
  }

  rectangle "Spending Limits and Alerts" {
    usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
    User --> CFR010
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    SystemAdmin --> SFR005
  }

  rectangle "Feedback and Improvement" {
    usecase "CFR11: Send Feedback about the System's Recommendations and Insights" as CFR11
    User --> CFR11
  }
}

@enduml