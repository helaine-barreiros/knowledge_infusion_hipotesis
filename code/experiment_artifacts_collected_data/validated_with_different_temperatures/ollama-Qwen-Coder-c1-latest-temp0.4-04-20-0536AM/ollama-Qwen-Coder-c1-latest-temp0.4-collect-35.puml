@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004
}

package "System Administrator" {
  actor SysAdmin as SA

  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SA --> SAFR001
}

rectangle "AI System Components" {
  package "Alerts Generation" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006

    C --> SFR001 : "Receive"
    FA --> SFR001 : "Receive"
    SA --> SFR001 : "Manage"

    C --> AIFR006
  }

  package "Recommendations Generation" {
    usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
    usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002

    C --> SFR002 : "Receive"
    FA --> SFR002 : "Receive"

    C --> AIFR002
  }

  package "Predictive Analytics and Insights Generation" {
    usecase "SFR014: Generate Client Analytics" as SFR014
    usecase "AIFR009: Generate Predictive Insights for Users" as AIFR009

    C --> SFR014 : "Receive"
    FA --> SFR014 : "Receive"

    C --> AIFR009
  }

  package "Spending Limit Alerts Generation" {
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003

    C --> SFR005 : "Receive"
    
    C --> AIFR003
  }

  package "Investment Opportunity Analysis Generation" {
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004

    C --> SFR006 : "Receive"
    
    C --> AIFR004
  }

  package "News Insights Generation" {
    usecase "SFR013: Request Contextualized News from AI Component" as SFR013
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007

    C --> SFR013 : "Receive"
    
    C --> AIFR007
  }

  package "Client Predictive Intervention Recommendations Generation" {
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations for Users" as AIFR008

    C --> SFR015 : "Receive"
    
    C --> AIFR008
  }

  package "Financial Health Reports Generation" {
    usecase "SFR017: Generate Financial Health Reports" as SFR017
    
    FA --> SFR017

    SA --> SFR017
  }
}

rectangle "System Operations and Management" {
  usecase "CFR11: Send Feedback to Improve System Outputs" as CFR11
  
  C --> CFR11 : "Provide"
  
  FA --> CFR11 : "Provide"

  SA --> CFR11 : "Manage"
}
@enduml