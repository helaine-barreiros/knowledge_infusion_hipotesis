@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
}

package "System Administrator" {
  actor SysAdmin as SAFR003
}

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  Client --> (View Alerts) : CFR002
  Client --> (Financial Predictions) : CFR003
  Client --> (Personalized Recommendations) : CFR004
  Client --> (Manage Recommendation Preferences) : CFR005
  Client --> (Spending Limit Alerts) : CFR006
  Client --> (Investment Opportunities) : CFR007
  Client --> (News Related to Portfolio) : CFR008
  Client --> (Consolidated Dashboard) : CFR009
  Client --> (Manage Financial Advisors) : CFR010
  
  FinancialAdvisor --> (Mentoring Sessions) : FAFR001
  FinancialAdvisor --> (Client Intervention Alerts) : FAFR002
  FinancialAdvisor --> (Predictive Analytics for Clients) : FAFR003
  FinancialAdvisor --> (Configure Analysis Parameters by Client Segment) : FAFR004
  
  SysAdmin --> SAFR001
}

@enduml