@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System: as Sys
:Financial Advisor (FA): as FAdvisor
:System Administrator (SA): as SAAdmin

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Get Personalized Recommendations" as CFR004
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  Client --> CFR001
  Client --> CFR002
  Client --> CFR003
  Client --> CFR004
  SAAdmin --> SAFR001

}

rectangle "Financial Advisor (FA)" {
  usecase "FAFR001: Manage Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FAdvisor --> FAFR001
  FAdvisor --> FAFR002
  FAdvisor --> FAFR003
  FAdvisor --> FAFR004

}

rectangle "User (Client, Financial Advisor, or System Administrator)" {
  usecase "CFR011: Send Feedback" as CFR011
  
  Client --> CFR011
  FAdvisor --> CFR011
  SAAdmin --> CFR011

}
@enduml