@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  rectangle "Client Dashboard Features" {
    usecase "CFR001: View Financial Insights Dashboard" as CFR001
    usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
    usecase "CFR003: View Financial Predictions" as CFR003
    usecase "CFR004: Receive Personalized Recommendations" as CFR004
    usecase "CFR005: Manage Recommendation Preferences" as CFR005
    usecase "CFR006: View Spending Limit Alerts" as CFR006
    usecase "CFR012: Access Consolidated Dashboard" as CFR12
  }
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR12
  
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA
  
  rectangle "FA Dashboard Features" {
    usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
    usecase "FAFR002: View Intervention Alerts" as FAFR002
    usecase "FAFR003: View Predictive Analytics" as FAFR003
    usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  }
  
  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004
  
}

package "System Administrator" {
  actor SystemAdmin as SA

  rectangle "SA Dashboard Features" {
    usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  }
  
  SA --> SAFR001
  
}

rectangle "System Functions" {
  package "Notifications & Alerts" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  }
  
  package "Recommendations and Insights" {
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  }

  package "Predictive Analytics & Interventions" {
    usecase "SFR014: Generate Client Analytics" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
    usecase "AIFR009: Generate Client Predictive Insights that Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009
  }
  
  package "Spending Limits & Investment Opportunities" {
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations From Established Spending Patterns" as AIFR003
  }
  
  package "News & Contextual Insights" {
    usecase "SFR017: Find Contextualized News Relevant to User's Financial Portfolios from Trusted Financial News Sources" as SFR017
    usecase "AIFR008: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as AIFR008
  }
  
}

package "AI System Functions" {
  rectangle "AI Predictive & Analytical Capabilities" {
    usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  }
  
}

package "User Feedback Management" {
  actor User as U
  
  rectangle "Feedback Features" {
    usecase "CFR11: Send Feedback About System's Recommendations and Insights" as CFR11
    
  }
  
  U --> CFR11

}
@enduml