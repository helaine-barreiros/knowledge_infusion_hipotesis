@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFR001 --> (FAFR002)
  Sys --> SFR003
  Sys --> AIFR001
}

rectangle "Client" {
  usecase "CFR002: View Alerts About Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Current Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as CFR004
  usecase "CFR005: Manage Personalized Recommendations Preferences to Ensure the System Provides Insights Relevant to My Financial Objectives and Risk Tolerance" as CFR005
  usecase "CFR006: View Spending Limit Alerts When I Exceed Predefined Thresholds in Specific Expense Categories" as CFR006
  usecase "CFR012: Manage Relationship with Financial Advisors, Including Permissions for Sharing My Financial Data to Maintain Privacy and Control Over My Financial Information" as CFR010
  
  Client --> (SAFR001)
  Client --> (FAFR004)
  Client --> (SFR003)
  Client --> (AIFR002)
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights to Provide More Valuable Guidance Aligned with Each Client's Financial Goals" as FAFR001
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations to Provide Data-Driven Recommendations During Consultations" as FAFR003
  
  FAFR001 --> (SAFR001)
  FAFR001 --> (AIFR002)
}

rectangle "System Administrator" {
  usecase "SFR004: Request Personalized Recommendations from the AI Component Based on Each User's Financial Data and Preferences" as SFR004
  usecase "SFR005: Request Spending Limit Alerts From the AI Component When User Spending Patterns Exceed Defined Thresholds" as SFR005
  
  SysAdmin --> (SAFR001)
}

rectangle "System Components" {
  usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance As Defined by Industry Standards Like FINRA Guidelines" as AIFR002
  usecase "SFR006: Request Investment Opportunity Analysis From the AI Component to Identify Suitable Investments For Users Based On Their Risk Profiles" as SFR006
  
  Sys --> (AIFR003)
  Sys --> (AIFR004)
}

rectangle "Notifications and Alerts" {
  usecase "SFR012: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as SFR012
  usecase "SFR013: Generate Client Alerts Based On Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR013
  
  Sys --> (AIFR006)
}

rectangle "News and Insights" {
  usecase "CFR008: View News Related To My Investment Portfolio to Stay Informed About Market Events That Might Affect My Assets" as CFR008
  usecase "SFR017: Generate Financial Health Reports that Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR017
  
  Sys --> (AIFR005)
}

rectangle "User Feedback" {
  usecase "CFR11: Send Feedback About the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as CFR11
  
  Client --> (SFR020)
}
@enduml