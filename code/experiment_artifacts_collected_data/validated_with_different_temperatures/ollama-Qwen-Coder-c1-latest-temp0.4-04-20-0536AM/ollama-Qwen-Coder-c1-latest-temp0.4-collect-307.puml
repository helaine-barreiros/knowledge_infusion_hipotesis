@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FinancialAdvisor
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Analysis Parameters" as SAFR002
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  usecase "SFR003: Request Financial Predictions from the AI Component" as SFR003
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  
  Client --> CFR001
  SysAdmin --> SAFR002
  FinancialAdvisor --> FAFR004
  System --> (SFR003)
}

rectangle "Financial Insights Dashboard" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  
  Client --> CFR009
}

rectangle "Alerts and Notifications" {
  usecase "SAFR001: Manage Analysis Parameters for the AI System" as SAFR001
  usecase "SFR005: Request Spending Limit Alerts from the AI Component" as SFR005
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  
  Client --> (SAFR001)
  System --> (SFR005)
}

rectangle "Recommendations and Insights" {
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  usecase "SFR0013: Generate Client Analytics that Provide Meaningful Insights into Financial Behavior and Performance" as SFR0013
  
  Client --> (CFR002)
}

rectangle "Investment Opportunities" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FinancialAdvisor --> (FAFR004)
}

rectangle "News and Updates" {
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "SFR017: Generate Client Predictive Insights that Provide Forward-looking Analysis of Financial Situations to Support More Effective Financial Planning" as SFR017
  
  System --> (SFR017)
}

rectangle "Client Management" {
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  usecase "FAFR04: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  Client --> (CFR10)
  
  rectangle "Financial Advisor Roles" {
    usecase "FAFR02: View Client Intervention Alerts When the System Detects Patterns Requiring Professional Attention to Proactively Assist Clients with Potential Financial Issues" as FAFR02
    usecase "FAFR03: View Predictive Analytics About My Clients' Financial Situations to Provide Data-driven Recommendations During Consultations" as FAFR03
    
    FinancialAdvisor --> (FAFR02)
  }
}

rectangle "AI System Functions" {
  usecase "AIFR01: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR01
  usecase "AIFR04: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance As Defined By Industry Standards Like FINRA Guidelines" as AIFR02
  
  System --> (AIFR01)
}

rectangle "Feedback Management" {
  usecase "CFR11: Send Feedback about the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as CFR11
  
  Client --> (CFR11)
}
@enduml