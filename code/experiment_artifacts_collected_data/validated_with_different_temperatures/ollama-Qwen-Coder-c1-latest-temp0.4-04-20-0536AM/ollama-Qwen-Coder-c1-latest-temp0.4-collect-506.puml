@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SysAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR019: Maintain Historical Record of Users' Insights" as SFR019
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  
  SA --> (SAFR001)
}

package "System" {
  rectangle SystemBoundary {
    actor User as U
    
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    usecase "SFR007: Request Specific Investment Opportunities from AI Component Matching User Criteria and ESG Preferences" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
    usecase "SFR10: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR10
    usecase "SFR11: Request Contextualized News Insights from AI Component Identifying Potential Impacts on Users' Investments" as SFR11
    usecase "SFR12: Generate Client Dashboards in an Intuitive and Actionable Format" as SFR12
    usecase "SFR13: Generate Client Alerts Based on Predefined Conditions" as SFR13
    usecase "SFR14: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR14
    usecase "SFR15: Request Predictive Intervention Analyses from AI Component Identifying When Advisors Should Engage with Clients" as SFR15
    usecase "SFR16: Request Predictive Insights From the AI Component Enhancing Value of Financial Guidance Provided to Clients" as SFR16
    usecase "SFR17: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR17
    usecase "SFR18: Manage Users' Financial Goals Tracking Progress Providing Relevant Recommendations" as SFR18
    usecase "SFR20: Request User Feedback Continuously Improving Quality Relevance of Financial Insights" as SFR20
    
    U --> (SFR002)
    U --> (SFR003)
    U --> (SFR004)
    U --> (SFR005)
    U --> (SFR006)
    U --> (SFR007)
    U --> (SFR008)
    U --> (SFR009)
    U --> (SFR10)
    U --> (SFR11)
    U --> (SFR12)
    U --> (SFR13)
    U --> (SFR14)
    U --> (SFR15)
    U --> (SFR16)
    U --> (SFR17)
    U --> (SFR18)
    U --> (SFR20)
  }
}

package "AI System" {
  rectangle AIBoundary {
    usecase "AIFR001: Generate Financial Predictions for Users Analyzing Historical Data Market Trends Economic Indicators" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations Based on User Profiles Goals and Risk Tolerance Industry Standards FINRA Guidelines" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses Evaluating Potential Investments Against User Risk Profiles Time Horizons and Financial Goals" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Identifying Financial Instruments Aligning with User Strategies Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR017: Generate Client Predictive Intervention Recommendations Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR018
  }
}

package "Feedback Loop" {
  actor User as U
  
  usecase "CFR11: Send Feedback About System's Recommendations and Insights" as CFR11
  
  U --> (CFR11)
}
@enduml