@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Get Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Receive Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access Financial News" as CFR008
  usecase "CFR009: View Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  C --> (SAFR001)
  C --> (FAFR002)
  C --> (SFR003)
  C --> (AIFR004)
  
  rectangle "Client Features" {
    C --> CFR001
    C --> CFR002
    C --> CFR003
    C --> CFR004
    C --> CFR005
    C --> CFR006
    C --> CFR007
    C --> CFR008
    C --> CFR009
  }
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (SAFR001)
  FA --> (SFR006)
  
  rectangle "Financial Advisor Features" {
    FA --> FAFR001
    FA --> FAFR002
    FA --> FAFR003
    FA --> FAFR004
  }
}

package "System Administrators" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  rectangle "System Administrator Features" {
    SA --> SAFR001
  }
}

rectangle "AI Components" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Identify Financial Instruments for Investments" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
  usecase "AIFR009: Provide Forward-Looking Financial Insights" as AIFR009
  
  rectangle "AI Features" {
    AIFR001 --> (SFR003)
    AIFR002 --> (SFR004)
    AIFR003 --> (SFR005)
    AIFR004 --> (SFR006)
    AIFR005 --> (SFR007)
    AIFR006 --> (SFR008)
    AIFR007 --> (SFR010)
    AIFR008 --> (SFR13)
    AIFR009 --> (SFR14)
  }
}

package "System" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Provide Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities from AI" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Portfolios" as SFR009
  usecase "SFR10: Process Contextualized News for Users" as SFR10
  usecase "SFR11: Request Contextualized News Insights from AI" as SFR11
  usecase "SFR12: Generate Client Dashboards" as SFR12
  usecase "SFR13: Generate Client Alerts Based on Predefined Conditions" as SFR13
  usecase "SFR14: Generate Client Analytics for Financial Behavior and Performance" as SFR14
  usecase "SFR15: Request Predictive Intervention Analyses from AI" as SFR15
  usecase "SFR16: Request Predictive Insights from AI to Enhance Guidance" as SFR16
  usecase "SFR17: Generate Financial Health Reports Based on Standard Ratios and Metrics" as SFR17
  usecase "SFR18: Manage Users' Financial Goals for Progress Tracking" as SFR18
  usecase "SFR19: Maintain Historical Record of Insights for Trend Analysis" as SFR19
  usecase "SFR20: Manage User Feedback to Improve System Outputs" as SFR20
  
  rectangle "System Features" {
    C --> (SFR003)
    C --> (SFR004)
    C --> (SFR005)
    C --> (SFR017)
    
    FA --> (SFR006)
    FA --> (SFR12)
    
    SA --> (SAFR001)
  }
}

package "Notifications" {
  usecase "NFR001: Send Feedback to AI System" as NFR001
  
  rectangle "Notification Features" {
    C --> (NFR001)
  }
}
@enduml