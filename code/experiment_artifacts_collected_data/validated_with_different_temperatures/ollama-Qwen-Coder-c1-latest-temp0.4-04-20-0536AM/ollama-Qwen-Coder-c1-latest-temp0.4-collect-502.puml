@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor (FA): as FA

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FA --> FAFR003
  Client -> (SFR005)
}

rectangle "Client Management System" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
  
  Client --> CFR009
  Client --> CFR010
}

rectangle "Financial Advisor System" {
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FA --> FAFR001
  FA --> FAFR003
}

rectangle "System Notifications and Alerts" {
  usecase "SFR006: Request Spending Limit Alerts from AI" as SFR006
  usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
  
  Client -> (SFR005)
}

rectangle "Investment Opportunities and News" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  
  Client --> CFR007
  Client --> CFR008
}

rectangle "System Recommendations and Insights" {
  usecase "SFR13: Generate Client Alerts Based on Predefined Conditions" as SFR13
  usecase "AIFR005: Generate Investment Opportunities for Users" as AIFR005
  
  Client -> (SFR005)
}

rectangle "User Feedback and Improvement" {
  usecase "CFR11: Send Feedback about the System's Recommendations and Insights" as CFR11
  
  Client --> CFR11
}
@enduml