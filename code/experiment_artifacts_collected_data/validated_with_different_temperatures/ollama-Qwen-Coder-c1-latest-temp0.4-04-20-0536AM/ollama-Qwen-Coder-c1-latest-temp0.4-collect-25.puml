@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  Client --> (SFR012) : "View Alerts"
  Client --> (SFR013) : "Receive Recommendations"
  Client --> (AIFR009) : "Get News Insights"
  
  SysAdmin --> (SAFR001)
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  
  FinancialAdvisor --> (SFR016) : "View Predictive Insights"
}

rectangle "Client Dashboard" {
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR010: Manage Relationship with Advisors" as CFR010
  
  Client --> (SFR12) : "View Alerts"
  FinancialAdvisor --> (CFR010)
}

rectangle "AI System" {
  usecase "AIFR001: Generate Predictions" as AIFR001
  usecase "AIFR002: Generate Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities" as AIFR004
  
  System --> (SFR16) : "Generate Predictive Insights"
}

rectangle "User Feedback Loop" {
  usecase "CFR011: Send Feedback" as CFR011
}
@enduml