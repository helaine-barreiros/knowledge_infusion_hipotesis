@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as Client
:User (Financial Advisor): as FAdvisor
:System Administrator: as SysAdmin
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Analysis Parameters for AI System" as SAFR002
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "SFR003: Deliver Personalized Recommendations to Users" as SFR003
  
  Client --> CFR001
  SysAdmin --> SAFR002
  FAdvisor --> FAFR001
}

rectangle "Client Dashboard Features" {
  usecase "CFR009: Access Consolidated Financial Information" as CFR009
  usecase "SFR017: Generate Financial Health Reports" as SFR017
  
  Client --> CFR009
  Sys --> SFR017
}

rectangle "Client Alerts and Notifications" {
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  
  Client --> CFR002
  Sys --> SFR005
}

rectangle "Investment Opportunities and Recommendations" {
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as CFR007
  usecase "SFR016: Request Predictive Insights from AI Component for Financial Guidance" as SFR016
  
  Client --> CFR007
  Sys --> SFR016
}

rectangle "Financial News and Updates" {
  usecase "CFR008: View News Related to My Investment Portfolio" as CFR008
  usecase "SFR009: Request Contextualized News Insights from AI Component" as SFR009
  
  Client --> CFR008
  Sys --> SFR009
}

rectangle "User Feedback and Management" {
  usecase "CFR11: Send Feedback about System's Recommendations and Insights" as CFR11
  
  User --(Client, FAdvisor, SysAdmin)--> CFR11
}
@enduml