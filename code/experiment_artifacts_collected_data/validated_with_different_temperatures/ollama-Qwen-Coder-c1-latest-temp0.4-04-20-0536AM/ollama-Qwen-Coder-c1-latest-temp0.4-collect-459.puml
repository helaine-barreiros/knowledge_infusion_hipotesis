@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics about My Clients' Financial Situations" as FAFR003
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002
  usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Transaction Data, Market Trends, and Economic Indicators" as AIFR001
  usecase "SFR013: Request Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR013
  
  Client --> CFR001 : "View"
  SysAdmin --> SAFR001 : "Manage Parameters"
  FAFD --> FAFR003 : "Review Predictions"
  Client -> (SFR002) : "Receive Recommendations"
  System Admin -> (AIFR001) : "Generate Predictions"
  System Admin -> (SFR013) : "Send Alerts"

}

rectangle "Client Features" {
    usecase "CFR002: Receive Alerts about Anomalous Transactions in My Accounts" as CFR002
    usecase "CFR006: View Spending Limit Alerts When I Exceed Predefined Thresholds in Specific Expense Categories" as CFR006
    usecase "CFR109: Access a Personalized Dashboard That Consolidates My Financial Information in a Single View to Efficiently Monitor My Finances" as CFR109
    
    Client --> (CFR002) : "Receive Alerts"
    Client --> (CFR006) : "Monitor Spending Limits"
    Client --> (CFR109) : "View Dashboard"
}

rectangle "Financial Advisor Features" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights to Provide More Valuable Guidance Aligned with Each Client's Financial Goals" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts When the System Detects Patterns Requiring Professional Attention to Proactively Assist Clients With Potential Financial Issues" as FAFR002
  
  FAFD --> (FAFR001) : "Manage Sessions"
  FAFD --> (FAFR002) : "Review Interventions"
}

rectangle "System Management Features" {
    usecase "SFR017: Generate Financial Health Reports That Assess Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR017
    usecase "CFR011: Send Feedback About the System's Recommendations and Insights to Help Improve the Accuracy and Relevance of Future Outputs" as CFR011
    
    SysAdmin --> (SFR017) : "Generate Reports"
    Client -> (CFR011) : "Provide Feedback"
}

@enduml