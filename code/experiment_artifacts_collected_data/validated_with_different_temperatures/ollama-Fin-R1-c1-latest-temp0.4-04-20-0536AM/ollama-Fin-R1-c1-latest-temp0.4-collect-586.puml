@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Anomaly Alerts Thresholds" as SAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Portfolio" as CFR008
  usecase "CFR009: View Consolidated Financial Dashboard" as CFR010
  usecase "SAFR003: Manage Client Mentoring Sessions" as SAFR004
  usecase "FAFR002: View Intervention Alerts for Clients" as FAFR002
  usecase "CFR011: Send Feedback to System" as CFR011

  SysAdmin --> SAFR003
}

rectangle "Client" {
  actor Client as C
  
  C -> (Start) : lient --> CFR001 : "View Financial Insights Dashboard"
  
  C -> (CFR002: View Alerts) : lient --> CFR002 : "Receive Anomalous Transaction Alerts"
  
  C -> (CFR003: Predictions) : lient --> CFR003 : "View Financial Predictions"
  
  C -> (CFR004: Recommendations) : lient --> CFR004 : "Get Personalized Recommendations"
  
  C -> (CFR005: Preferences Management) : lient --> CFR005 : "Manage Recommendation Preferences"
  
  C -> (CFR006: Spending Alerts) : lient --> CFR006 : "View Spending Limit Alerts"
  
  C -> (CFR007: Investment Opportunities) : lient --> CFR007 : "Access Suitable Investments Based on Risk Profile"
  
  C -> (CFR008: News Related to Portfolio) : lient --> CFR008 : "Stay Informed About Market Events"
  
  C -> (CFR009: Consolidated Dashboard) : lient --> CFR010 : "Access Personalized Financial Overview"
  
  C -> (CFR011: Feedback) : lient --> CFR011 : "Provide System Improvements Suggestions"
}

rectangle "Financial Advisor" {
  actor FAF as F
  
  F -> SAFR003
  F -> FAFR002
  F -> FAFR004
}

rectangle "System Administrator" {
  SysAdmin --> (SAFR001: Manage Analysis Parameters)
  
  SysAdmin --> SAFR003 : "Manage Client Mentoring Sessions"
}
@enduml