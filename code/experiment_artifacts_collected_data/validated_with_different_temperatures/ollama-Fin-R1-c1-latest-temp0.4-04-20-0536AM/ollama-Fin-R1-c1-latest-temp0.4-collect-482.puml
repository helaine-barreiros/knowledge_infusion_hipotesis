@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "SFR012: Generate Client Dashboards" as SFR012

  client --> CFR001 : "View Financial Insights Dashboard"
  
  SysAdmin -> SAFR001 : "Manage Analysis Parameters"

  user --|> FAFR003 : "View Predictive Analytics for Clients"
}

rectangle "Financial Advisor Role" {
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  SysAdmin -> FAFR002 : "Manage Client Mentoring Sessions"

  user --|> FAFR003 : "View Predictive Analytics for Clients"
}

rectangle "Client Role" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Manage Relationship with Advisors" as CFR009

  SysAdmin -> SAFR001 : "Manage Analysis Parameters"
  
  client --> CFR002 : "Receive Alerts on Anomalous Transactions"
  client --> CFR003 : "View Financial Predictions"
  client --> CFR004 : "Receive Personalized Recommendations"
  client --> CFR005 : "Manage Recommendation Preferences"
  client --> CFR006 : "View Spending Limit Alerts"
  client --> CFR007 : "View Investment Opportunities"
  client --> CFR008 : "Access News Related to Portfolio"
  client --> CFR009 : "Manage Relationship with Advisors"

}

rectangle "System Administrator Role" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  SysAdmin -> FAFR002 : "View Client Intervention Alerts"
  
  user --|> SAFR001 : "Manage Analysis Parameters"
}
@enduml