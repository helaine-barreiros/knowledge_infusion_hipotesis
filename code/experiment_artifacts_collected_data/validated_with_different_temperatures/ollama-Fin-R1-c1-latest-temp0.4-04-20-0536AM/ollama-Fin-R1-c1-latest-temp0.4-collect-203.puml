@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  Client --> CFR001 : Request Financial Insights Dashboard  
  SysAdmin --> SAFR001 : Manage System Settings  
  FAAdv --> FAFR004 : Configure Analysis Parameters for Segments  
  System <|-- (CFR001, SAFR001) : Implements
}

rectangle "Client" {
  usecase "CFR002: View Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003  
  usecase "CFR004: Receive Personalized Recommendations" as CFR004  
  usecase "CFR005: Manage Recommendation Preferences" as CFR005  
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007 
  usecase "CFR008: View News Related to Portfolio" as CFR008  
  usecase "CFR009: Manage Personalized Dashboard" as CFR009
  usecase "SAFR002: Receive System-Generated Alerts" as SAFR002
  
  Client --> (CFR001, CFR002, CFR003, CFR004, CFR005, CFR006, CFR007, CFR008, CFR009) : Requests  
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002 
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003  
  FAAdv --> (FAFR001, FAFR002, FAFR003) : Manages
}

rectangle "System Administrator" {
  usecase "SAFR007: Configure System-Wide Parameters" as SAFR007
  SysAdmin --> SAFR007  
}
@enduml