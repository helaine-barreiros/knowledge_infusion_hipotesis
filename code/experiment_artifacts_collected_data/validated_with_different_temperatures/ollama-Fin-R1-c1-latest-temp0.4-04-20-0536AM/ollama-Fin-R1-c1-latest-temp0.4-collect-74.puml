@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR006: Manage Spending Limit Thresholds" as CFR006
  usecase "SFR014: Generate Client Analytics" as SFR014
  usecase "AIFR003: Identify Unusual Spending Patterns" as AIFR003
}

usecase "CFR008: View News Related to Investment Portfolio" as CFR008

rectangle "Client" {
  actor Client as C
}
rectangle "Financial Advisor" {
  actor FinancialAdvisor as FA
}
rectangle "System Administrator" {
  actor SysAdmin as SA
}

C --> CFR001 : "View Financial Insights Dashboard"
C --> CFR002 : "Receive Alerts on Anomalous Transactions"
C --> CFR003: View Historical Data Predictions
C --> CFR004: Receive Personalized Recommendations
C --> CFR005: Manage Recommendation Preferences
C --> CFR006: Monitor Spending Limits
C --> CFR008: Access Portfolio News
C --> CFR011: Provide Feedback

FA --> FAFR003 : "View Predictive Analytics for Clients"
FA --> FAFR002: View Intervention Alerts
SA --> SAFR001 : Manage Analysis Parameters

SysAdmin --> SAFR001 : Configure System Settings

rectangle "AI" {
  usecase AIFR001: Generate Financial Predictions as AIFR001
  usecase AIFR002: Personalized Recommendations Generation as AIFR002
  usecase AIFR003: Unusual Spending Alerts as AIFR003
  usecase AIFR004: Investment Opportunity Analysis as AIFR004
  usecase AIFR005: Align with Modern Portfolio Theory as AIFR005
  usecase AIFR006: Anomaly Transaction Alerts as AIFR006
  usecase AIFR007: Contextualized News Insights as AIFR007
  usecase AIFR008: Predictive Intervention Recommendations as AIFR008
}

AIFR001 <|-- CFR003 : "Provide Financial Predictions"
AIFR002 <|-- CFR004 : "Generate Personalized Recommendations"
AIFR003 <|-- CFR006 : "Trigger Spending Limit Alerts"
AIFR004 <|-- FAFR001: Generate Investment Opportunities
AIFR005 <|-- AIFR002: Align with Risk Tolerance
AIFR006 <|-- SAFR008: Comply with Regulatory Standards (AML)
AIFR007 <|-- CFR009: "Identify Portfolio Impacts"
AIFR008 <|-- FAFR015: Engage Financial Advisors

@enduml