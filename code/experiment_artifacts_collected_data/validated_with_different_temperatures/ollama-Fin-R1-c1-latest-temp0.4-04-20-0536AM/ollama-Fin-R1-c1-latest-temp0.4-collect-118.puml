  usecase "SFR010: Generate Client Dashboards" as SFR010
  usecase "SFR011: Process Contextualized News Insights" as SFR011
  usecase "SFR012: Predictive Intervention Analyses for Advisors" as SFR012
  usecase "SFR013: Generate Client Analytics" as SFR013
  usecase "SFR014: Manage Users' Financial Goals" as SFR014
  usecase "SFR015: Trend Analysis of Insights" as SFR015
