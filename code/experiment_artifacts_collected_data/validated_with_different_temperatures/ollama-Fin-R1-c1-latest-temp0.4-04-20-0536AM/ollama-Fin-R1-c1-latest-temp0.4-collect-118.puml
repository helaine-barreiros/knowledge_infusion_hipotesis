  fa --> FAFR002 : "Act on system-generated alerts for clients needing help"
  fa --> FAFR003 : "Use predictive data to guide advice during meetings"
  fa --> FAFR004 : "Set up custom analysis rules per segment"

}

rectangle "System Functionalities" {
  usecase "SFR001: Deliver Alerts through Channels" as SFR001
  usecase "SFR002: Personalize Recommendations Based on Profiles" as SFR002
