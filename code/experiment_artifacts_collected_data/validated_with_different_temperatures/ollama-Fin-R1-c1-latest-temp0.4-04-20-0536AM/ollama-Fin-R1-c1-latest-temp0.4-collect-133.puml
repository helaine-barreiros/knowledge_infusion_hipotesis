@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR004: Personalized Recommendations Based on Financial Profile" as CFR004
  usecase "SAFR006: Manage Client Relationship Permissions" as SAFR006
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  usecase "CFR009: Access Consolidated Financial Dashboard" as CFR009

  client --> CFR001 : View financial data in a consolidated format  
  client --> CFR004 : Receive personalized recommendations aligned with goals  
  client --> SAFR006 : Manage permissions for sharing data  
  client --> SFR013 : Get timely alerts on critical events  

  systemAdmin --> SAFR001 : Configure analysis parameters for the AI system  
  financialAdvisor --> FAFR002 : View predictive analytics and generate insights  
  financialAdvisor --> FAFR004 : Manage custom analysis settings per client segment  
  financialAdvisor --> AIFR008 : Generate recommendations based on patterns  

  client <|-- CFR011 : Send feedback to improve system outputs
}

@enduml