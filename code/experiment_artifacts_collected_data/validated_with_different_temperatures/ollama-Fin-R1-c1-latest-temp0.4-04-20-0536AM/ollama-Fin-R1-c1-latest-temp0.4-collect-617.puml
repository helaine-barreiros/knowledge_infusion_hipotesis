@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sas1
actor FinancialAdvisor as fa1

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics About Clients' Finances" as FAFR003
  usecase "SFR012: Generate Client Dashboards" as SFR012

  c1 --> CFR001 : "View Financial Insights Dashboard"
  
  sas1 -> SAFR001 : "Manage Analysis Parameters"

  fa1 -> FAFR003 : "View Predictive Analytics About Clients' Finances"
  
  SysAdmin --> SFR012 : "Generate Client Dashboards" (via system)
}

@enduml