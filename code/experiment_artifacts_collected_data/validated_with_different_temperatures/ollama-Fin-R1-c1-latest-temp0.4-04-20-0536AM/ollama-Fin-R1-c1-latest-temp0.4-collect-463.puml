@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  client --> CFR001 : "View Financial Insights"
  
  SysAdmin -> SAFR001 : "Manage AI System Settings"
  SysAdmin -> FAFR004 : "Configure Client-Specific Rules"
}

rectangle "Client" {
  actor "User" as User
  usecase "CFR002: View Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Monitor Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access Portfolio-Related News" as CFR008
  usecase "CFR009: Consolidate Financial Info in Dashboard" as CFR010
  
  User --> CFR002 : "View Alerts"
  User --> CFR003 : "View Predictions"
  User --> CFR004 : "Get Recommendations"
  User --> CFR005 : "Adjust Preferences"
  User --> CFR006 : "Check Spending Limits"
  User --> CFR007 : "Find Investments"
  User --> CFR008 : "Read News"
  User --> CFR010 : "View Dashboard"
}

rectangle "Financial Advisor" {
  actor "FAFR002: Financial Advisor" as FAFR002
  usecase "FAFR003: View Client Intervention Alerts" as FAFR003
  FAFR002 -> FAFR003 : "Review Alerts"
}

rectangle "System Administrator" {
  actor SysAdmin as SAAdmin
  usecase SAFR001 : "Manage Analysis Parameters"
  
  SAAdmin --> SAFR001 : "Set System Rules"
}

// Additional Use Cases for the System (SFR)
usecase SFR002: Deliver Personalized Recommendations as SFR002
usecase SFR003: Request Financial Predictions from AI as SFR003
usecase SFR004: Request Personalized Recs Based on Profiles as SFR004
usecase SFR005: Request Spending Limit Alerts as SFR005
usecase SFR006: Request Investment Opportunity Analysis as SFR006
usecase SFR007: Find Specific Investments for Users as SFR007
usecase SFR008: Detect Anomaly Transactions as SFR008
usecase SFR013: Generate Client Alerts Based on Conditions as SFR013

// AI System (AIFR)
usecase AIFR002: Generate Personalized Recs for Users as AIFR002
usecase AIFR004: Analyze Spending Limits for Unusual Patterns as AIFR004
usecase AIFR005: Identify Investment Opportunities Based on Risk Profiles as AIFR005
usecase AIFR006: Detect Fraudulent Transactions Using Pattern Recognition as AIFR006

// Feedback Loop (CFR011)
actor "User" --> usecase CFR011 : "Send System Improvements Feedback"

@enduml