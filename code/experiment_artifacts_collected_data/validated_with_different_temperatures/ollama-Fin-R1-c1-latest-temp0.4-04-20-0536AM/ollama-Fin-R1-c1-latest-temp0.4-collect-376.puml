@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage User Alerts" as SAFR002
  usecase "FAFR005: Schedule Mentoring Sessions" as FAFR005
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: Access Investment Opportunities" as CFR007
  usecase "CFR008: View Portfolio News" as CFR008
  usecase "SAFR013: Generate Client Alerts" as SAFR013
  usecase "SFR020: Manage User Feedback" as SFR020
  
  
  actor "Client" as client
  actor "Financial Advisor (FA)" as fa
  actor "System Administrator (SysAdmin)" as sysadmin

  client --> CFR001 : View Financial Insights Dashboard
  client --> SAFR002 : Manage User Alerts
  client --> FAFR005 : Schedule Mentoring Sessions
  client --> CFR003 : View Financial Predictions
  client --> CFR004 : Receive Personalized Recommendations
  sysadmin --> SAFR001 : Manage Analysis Parameters (System Admin)
  
  fa --> FAFR002 : View Client Intervention Alerts
  fa --> FAFR005 : Schedule Mentoring Sessions
  fa --> SFR020 : Send Feedback
  
  client --> CFR006 : View Spending Limit Alerts
  client --> CFR007 : Access Investment Opportunities
  client --> CFR008 : View Portfolio News

}

