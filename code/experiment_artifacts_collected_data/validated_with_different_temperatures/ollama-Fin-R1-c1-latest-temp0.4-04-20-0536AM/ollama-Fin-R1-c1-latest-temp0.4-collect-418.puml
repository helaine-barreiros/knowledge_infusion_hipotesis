@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as c1, c2, c3
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Access Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Suitable to Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Investment Portfolio" as CFR008
  usecase "CFR009: View Consolidated Financial Dashboard for Efficiency" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors, Including Data Sharing Permissions" as CFR10

}

package "Financial Advisor (FA)" {
  actor FA as fa1
  
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: Review Predictive Analytics About Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004

}

package "System Administrator (SA)" {
  actor SA as sa1
  
  usecase "SAFR001: Manage AI System's Analysis Parameters to Ensure Accuracy and Compliance with Financial Regulations" as SAFR001
}

system boundary {
  
  Client --> CFR001 : c1, c2, c3
  Client --> CFR002 : c1, c2, c3
  Client --> CFR003 : c1, c2, c3
  Client --> CFR004 : c1, c2, c3
  Client --> CFR005 : c1, c2, c3
  Client --> CFR006 : c1, c2, c3
  Client --> CFR007 : c1, c2, c3
  Client --> CFR008 : c1, c2, c3
  Client --> CFR009 : c1, c2, c3
  Client --> CFR10 : c1, c2, c3

  
  FA --> FAFR001 : fa1
  FA --> FAFR002 : fa1
  FA --> FAFR003 : fa1
  FA --> FAFR004 : fa1
  
  SA --> SAFR001 : sa1

}

@enduml