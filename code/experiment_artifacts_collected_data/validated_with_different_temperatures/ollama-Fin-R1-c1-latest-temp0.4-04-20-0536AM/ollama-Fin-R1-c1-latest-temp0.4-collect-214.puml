@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  Client --> CFR001 : "View Financial Insights Dashboard"
  
  SysAdmin --> SAFR001 : "Manage Analysis Parameters"
  
  FinancialAdvisor --> FAFR003 : "View Predictive Analytics for Clients"
  
  System --> SFR012 : "Generate Client Dashboards"
}

rectangle "Client" {
  actor "User (Client)" as User
  usecase "CFR002: View Alerts About Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Portfolio" as CFR008
  usecase "CFR009: Access Consolidated Financial Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  User --> CFR002 : "View Alerts"
  
  User --> CFR003 : "View Predictions"
  
  User --> CFR004 : "Receive Recommendations"
  
  User --> CFR005 : "Manage Preferences"
  
  User --> CFR006 : "View Spending Limit Alerts"
  
  User --> CFR007 : "View Investment Opportunities"
  
  User --> CFR008 : "Receive News"
  
  User --> CFR009 : "Access Dashboard"
  
  User --> CFR10 : "Manage Relationship with Advisors"
}

rectangle "FinancialAdvisor" {
  actor "User (Financial Advisor)" as FinancialAdvisor
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Segment" as FAFR004
  
  FinancialAdvisor --> FAFR002 : "View Intervention Alerts"
  
  FinancialAdvisor --> FAFR003 : "View Predictive Analytics for Clients"
  
  FinancialAdvisor --> FAFR004 : "Configure Analysis Parameters"
}

rectangle "SysAdmin" {
  actor "User (System Administrator)" as SysAdmin
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SysAdmin --> SAFR001 : "Manage Analysis Parameters"
}
@enduml