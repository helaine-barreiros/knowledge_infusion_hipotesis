@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sas
actor FinancialAdvisor as faa
system :System: as sys

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Data and Trends" as CFR003
  usecase "CFR004: Personalized Recommendations Aligned with Profile Goals" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidated Personalized Dashboard for Monitoring Finances" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors, Including Data Sharing Permissions" as CFR010

}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
}
  
rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
}

rectangle "System (SFR)" {
  usecase "SFR001: Deliver Alerts Through Notification Channels" as SFR001
  usecase "SFR002: Personalized Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AI Component" as SFR004
  usecase "SFR005: Spending Limit Alerts When Exceeding Thresholds" as SFR005
  usecase "SFR006: Investment Opportunity Analysis for Users Based on Risk Profiles" as SFR006
  usecase "SFR007: Specific Investment Opportunities Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Anomaly Transaction Alerts to Detect Fraud in Compliance with AML Regulations" as SFR008
  usecase "SFR009: Contextualized News Relevant to Users' Portfolios from Trusted Sources" as SFR009
  usecase "SFR010: Generate Client Dashboards for Intuitive Financial Monitoring" as SFR010
}

rectangle "AI Component (AIFR)" {
  usecase "AIFR001: Generate Financial Predictions Based on Historical Data and Trends" as AIFR001
  usecase "AIFR002: Personalized Recommendations Aligning with User Profiles and Goals" as AIFR002
  usecase "AIFR003: Spending Limit Alerts for Unusual Deviations from Patterns" as AIFR003
  usecase "AIFR004: Investment Opportunity Analyses Against Risk Profiles" as AIFR004
  usecase "AIFR005: Identify Financial Instruments Aligning with User Strategies and Portfolio Theory" as AIFR005
  usecase "AIFR006: Pattern Recognition for Anomaly Transaction Alerts in Compliance With FinCEN" as AIFR006
  usecase "AIFR007: Contextualized News Insights Correlated with User Portfolios" as AIFR007
}

usecase "CFR11: Send Feedback to Improve System Outputs" as CFR11

Client --> CFR001 : c1 wants to view financial insights.
Client --> CFR002 : c1 receives alerts for anomalous transactions.
Client --> CFR003 : c1 views financial predictions based on data and trends.
Client --> CFR004 : c1 gets personalized recommendations aligned with goals.
Client --> CFR005 : c1 manages preferences for recs to ensure relevance.
Client --> CFR006 : c1 receives spending limit alerts when exceeding thresholds.
Client --> CFR007 : c1 views investment opportunities based on risk profile.
Client --> CFR008 : c1 accesses portfolio-related news.
Client --> CFR009 : c1 uses consolidated dashboards for monitoring.
Client --> CFR010 : c1 manages data sharing with advisors.

SysAdmin --> SAFR001: sas wants to manage analysis parameters.

FinancialAdvisor --> FAFR001: faa manages client mentoring sessions based on insights.
FinancialAdvisor --> FAFR002: faa views client intervention alerts for proactive assistance.
FinancialAdvisor --> FAFR003: faa reviews predictive analytics about clients' financial situations.

System (SFR) --> SFR001 : sys sends alerts via channels.
System (SFR) --> SFR002 : sys provides personalized recs based on profiles.
System (SFR) --> SFR003 : sys requests financial predictions from AI component.
System (SFR) --> SFR004 : sys asks for personal recommendations from AI comp.
System (SFR) --> SFR005 : sys issues spending limit alerts when thresholds are exceeded.
System (SFR) --> SFR006 : sys analyzes investment opportunities based on risk profiles.
System (SFR) --> SFR007 : sys finds specific investments matching user criteria and ESG prefs.
System (SFR) --> SFR008 : sys generates anomaly transaction alerts for fraud detection.
System (SFR) --> SFR009 : sys provides contextualized news relevant to portfolios.
System (SFR) --> SFR010 : sys creates client dashboards.

AI Component (AIFR) --> AIFR001: aifr generates financial predictions via data analysis and trends.
AI Component (AIFR) --> AIFR002: aifr provides personalized recommendations based on profiles, goals, risk tolerance.
AI Component (AIFR) --> AIFR003: aifr issues spending limit alerts for unusual activity.
AI Component (AIFR) --> AIFR004: aifr evaluates investment opportunities against user's risk profile and strategies.
AI Component (AIFR) --> AIFR005: aifr identifies financial instruments aligned with user’s portfolio theory principles.
AI Component (AIFR) --> AIFR006: aifr detects anomalous transactions for compliance using pattern recognition.
AI Component (AIFR) --> AIFR007: aifr provides contextualized news insights linked to portfolios.

Client --> CFR11 : c1 sends feedback on system outputs.

@enduml