@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  usecase "AIFR009: Generate Client Predictive Intervention Recommendations" as AIFR009

  client --> CFR001 : View Financial Insights Dashboard  
  sysadmin --> SAFR001 : Manage Analysis Parameters  
  financial_advisor --> FAFR003, SFR002
}

rectangle "Client" {
  actor Client as c
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003  
  usecase "CFR004: Personalized Recommendations Alignment" as CFR004 
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007  
  usecase "CFR008: Access News Related to Portfolio" as CFR008 
  usecase "CFR009: Personalized Dashboard Consolidation" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10

  c --> CFR001 : View  
  c --> CFR002 : Receive Alerts  
  c --> CFR003 : Predictions  
  c --> CFR004 : Align Recommendations  
  c --> CFR005 : Preferences Management  
  c --> CFR006 : Spending Limit Alerts  
  c --> CFR007 : Investment Opportunities  
  c --> CFR008 : News  
  c --> CFR009 : Consolidated Dashboard  
  c --> CFR10 : Manage Relationship
}

rectangle "Financial Advisor" {
  actor Financial_Advisor as fa
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002 
  usecase "FAFR003: Predictive Analytics for Clients" as FAFR003  
  usecase "AIFR009: Generate Client Predictive Interventions" as AIFR009

  fa --> FAFR002 : View Alerts
  fa --> FAFR003 : Analyze 
}

rectangle "System Administrator" {
  actor Sys_Admin as sa
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001  

  sa --> SAFR001 : Configure  
}
@enduml