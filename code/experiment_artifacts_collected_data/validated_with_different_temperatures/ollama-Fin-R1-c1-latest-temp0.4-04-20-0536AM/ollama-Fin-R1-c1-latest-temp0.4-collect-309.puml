@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Fraud Alerts" as SAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "SAFR001: Manage Analysis Parameters (Basel III)" as SAFR001
  usecase "FAFR001: Schedule Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR013: Generate Client Alerts Based on Conditions" as SFR013
  usecase "CFR006: Manage Spending Limit Alerts" as CFR006
  usecase "FAFR004: Configure Analysis Parameters for Segments (GDPR)" as FAFR004
  usecase "SFR008: Request Anomaly Transaction Alerts from AI" as SFR008
  usecase "CFR012: View Personalized Dashboard" as CFR012
  usecase "AIFR003: Generate Spending Limit Alert for Unusual Deviations" as AIFR003
}

actor Client as c1 {
  --> CFR001 : "View Financial Insights"
  --> SAFR002 : "Manage Fraud Alerts"
  --> CFR003 : "View Predictions"
  --> CFR004 : "Receive Recommendations"
  --> CFR005 : "Manage Preferences"
  --> SFR013 : "Generate Client Alerts Based on Conditions"
  --> CFR006 : "Manage Spending Limit Alerts"
}

actor FinancialAdvisor as fad {
  --> FAFR002 : "View Intervention Alerts"
  --> FAFR004 : "Configure Analysis Parameters for Segments (GDPR)"
  --> AIFR008 : "Generate Predictive Insights"
}

actor SystemAdmin as saa {
  --> SAFR001 : "Manage Analysis Parameters (Basel III)"
  --> SFR013 : "Generate Client Alerts Based on Conditions"
}

actor AI as ai {
  <|-- AIFR002 : "Personalized Recommendations"
  <|-- AIFR007 : "Contextualized News Insights"
  <|-- AIFR008 : "Client Predictive Intervention Recs."
  <|-- AIFR015 : "Predictive Interventions for Advisors"
}

actor ClientUser as cu {
  --> CFR001
  --> SAFR002
  --> CFR003
  --> CFR004
  --> CFR005
  --> SFR008
  --> AIFR006 : "Anomaly Transaction Alerts"
}

actor ClientSystem as cs {
  --> SFR012 : "Generate Dashboards"
  --> SFR013 : "Client Alerts Based on Conditions"
}
@enduml