@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Alert Preferences" as SAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Adjust Recommendation Preferences" as CFR005
  usecase "CFR006: Monitor Spending Limits" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access Portfolio News" as CFR008
  usecase "CFR009: Consolidate Financial Data in Dashboard" as CFR010
  usecase "CFR011: Manage Relationship with Advisors" as SAFR003

  // System Admin Use Cases
  usecase "SAFR004: Configure Analysis Parameters" as SAFR004

  user Client --> CFR001 : View dashboard, predictions, recommendations, news.
  client --> CFR002 : Receive alerts (FATF)
  client --> CFR003 : Predictions
  client --> CFR004 : Recommendations
  client --> CFR005 : Adjust preferences
  client --> CFR006 : Monitor spending limits
  client --> CFR007 : Investment opportunities
  client --> CFR008 : Portfolio news
  client --> CFR009 : Consolidate data in dashboard
  client --> SAFR003 : Manage relationship with advisors

  user FinancialAdvisor --> FAFR001: Mentor clients, view alerts.
  financialadvisor --> FAFR002: View intervention alerts
  financialadvisor --> FAFR003: Predictive analytics for clients
  financialadvisor --> FAFR004: Configure parameters per client segments

  user SysAdmin --> SAFR001 : Manage analysis params, ensure compliance.
  
  // System Use Cases (SFR)
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Predictions from AI" as SFR003
  usecase "SFR004: Request Recs from AI" as SFR004
  usecase "SFR005: Request Spending Alerts from AI" as SFR005
  usecase "SFR006: Request Investment Opportunities" as SFR006
  usecase "SFR007: Find ESG-Matched Investments" as SFR007
  usecase "SFR008: Detect Anomalies via AI" as SFR008
  usecase "SFR009: Extract News Insights" as SFR009
  usecase "SFR010: Generate Client Dashboards" as SFR010
  usecase "SFR013: Manage Alerts Based on Conditions" as SFR013
  usecase "SFR014: Provide Analytics for Users" as SFR014

  // AI Use Cases (AIFR)
  usecase "AIFR002: Generate Personalized Recs" as AIFR002
  usecase "AIFR003: Alert on Spending Limits" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities" as AIFR004
  usecase "AIFR005: Identify ESG-Matched Investments" as AIFR005
  usecase "AIFR006: Detect Fraudulent Transactions" as AIFR006
  usecase "AIFR007: Correlate News with Portfolios" as AIFR007

  client --> CFR012 : Generate dashboards (SFR)
  
}

@enduml