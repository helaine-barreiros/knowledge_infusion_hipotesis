@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004

  Client --> CFR001 : View Financial Insights Dashboard  
  SysAdmin -> SAFR001 : Manage Analysis Parameters  
  FAFR003 <|-- (CFR002) : View Alerts for Anomalous Transactions
  SFR002 <|-- (CFR004) : Receive Personalized Recommendations  
  AIFR004 <|-- (CFR006) : Manage Spending Limit Alerts

  rectangle "Client" {
    actor Client as c1
    c1 --> CFR001 : View Financial Insights Dashboard  
    c1 --> FAFR003 : View Predictive Analytics for Clients  
    c1 --> SFR002 : Receive Personalized Recommendations  
    c1 --> AIFR004 : Generate Investment Opportunity Analyses  
  }

  rectangle "Financial Advisor" {
    actor FinancialAdvisor as fa
    fa -> FAFR003 : View Predictive Analytics for Clients  
    fa -> FAFR002 : Manage Client Mentoring Sessions Based on Insights  
    fa -> AIFR008 : Generate Intervention Recommendations  
  }

  rectangle "System Administrator" {
    actor SysAdmin as sa
    sa --> SAFR001 : Manage Analysis Parameters  
    sa -> SFR009 : Request Contextualized News for Users  
  }
}

@enduml