rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Fraud Alerts Thresholds" as SAFR002
  usecase "CFR003: Access Historical Data & Market Trends for Predictions" as CFR003
  usecase "CFR004: Receive Personalized Financial Recommendations" as CFR004  
  usecase "CFR005: Adjust Recommendation Preferences Based on KYC Profile" as CFR005
  usecase "SAFR001: Monitor System Parameters for Accuracy & Compliance" as SAFR001
  usecase "FAFR002: Review Client Intervention Alerts" as FAFR002  
  usecase "CFR006: Receive Spending Limit Alerts Based on Thresholds" as CFR006
  usecase "CFR007: View Investment Opportunities Matching Risk Profile" as CFR007
  usecase "CFR008: Access Portfolio-Specific News Articles" as CFR008  
