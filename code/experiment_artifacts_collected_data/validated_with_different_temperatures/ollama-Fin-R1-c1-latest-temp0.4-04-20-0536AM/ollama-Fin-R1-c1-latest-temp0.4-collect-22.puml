@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage System Parameters" as SAFR002
  usecase "FAFR005: Schedule Mentoring Sessions" as FAFR005
  usecase "SFR009: Request Contextualized News Insights" as SFR009
  
  Client --> CFR001 : View Financial Data
  SysAdmin -> SAFR002 : Manage Parameters
  Advisor -> FAFR005 : Schedule Sessions
}

rectangle "Client" {
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR010: Manage Relationship with Advisors" as CFR010
  
  Client --> CFR003 : Access Predictions
  Client --> CFR004 : Get Recommendations
  Client -> CFR010 : Share Data, Set Permissions
}

rectangle "Financial Advisor (FA)" {
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters" as FAFR004
  
  Advisor --> FAFR002 : Monitor Alerts
  Advisor -> FAFR003 : Analyze Data
  Advisor -> FAFR004 : Customize Settings
}

rectangle "System Administrator (SA)" {
  usecase "CFR011: Send Feedback" as CFR011
  
  SA --> CFR011 : Provide Input for Improvement
}
@enduml