@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Alerts Thresholds" as SAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Customize Recommendation Preferences" as CFR005
  usecase "CFR006: Monitor Spending Limits Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access Portfolio News" as CFR008
  usecase "CFR009: Consolidated Financial Dashboard" as CFR010
  usecase "CFR010: Manage Data Sharing with Advisors" as CFR010
  
  usecase "SAFR003: Configure Analysis Parameters" as SAFR003
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  
  actor "Client" as C1, C2, C3 { 
    C1 --> CFR001 : "View Financial Insights Dashboard"
    C1 --> CFR004 : "Receive Personalized Recommendations"
    C1 --> CFR006 : "Monitor Spending Limits Alerts"
    C1 --> CFR007 : "View Investment Opportunities"
    C1 --> CFR008 : "Access Portfolio News"
    C2 --> SAFR003 : "Configure Analysis Parameters" 
  }
  
  actor "Financial Advisor (FA)" as FA {
    FA --> FAFR001 : "Manage Client Mentoring Sessions"
    FA --> FAFR004 : "View Predictive Analytics for Clients"
    FA --> AIFR008 : "Generate Intervention Recommendations" 
  }
  
  actor "System Administrator (SA)" as SA {
    SA --> SAFR003 : "Configure Analysis Parameters"
  }

}

@enduml