@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  client --> CFR001 : "View Financial Insights Dashboard"
  
  SysAdmin --> SAFR001 : "Manage System Settings and Compliance"
  SysAdmin --> FAFR004 : "Adjust AI Behavior Based on Regulatory Needs"

  rectangle "Client" {
    actor Client as c
    usecase "CFR002: View Alerts for Anomalous Transactions" as CFR002
    usecase "CFR003: View Financial Predictions" as CFR003
    usecase "CFR004: Receive Personalized Recommendations" as CFR004
    usecase "CFR005: Manage Recommendation Preferences" as CFR005
    usecase "CFR006: View Spending Limit Alerts" as CFR006
    usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
    usecase "CFR008: Stay Informed with Portfolio-Related News" as CFR008
    usecase "CFR009: Consolidate Financial Information in a Dashboard" as CFR009
    usecase "CFR10: Manage Relationship with Advisors Including Data Sharing Permissions" as CFR10

    c --> CFR002 : "View Alerts for Anomalous Transactions"
    c --> CFR003 : "View Financial Predictions"
    c --> CFR004 : "Receive Personalized Recommendations"
    c --> CFR005 : "Manage Recommendation Preferences"
    c --> CFR006 : "View Spending Limit Alerts"
    c --> CFR007 : "Access Investment Opportunities Based on Risk Profile"
    c --> CFR008 : "Stay Informed with Portfolio-Related News"
    c --> CFR009 : "Consolidate Financial Information in a Dashboard"
    c --> CFR10 : "Manage Relationship with Advisors Including Data Sharing Permissions"

  }

  rectangle "Financial Advisor" {
    actor FAFR as f
    usecase "FAFR002: View Client Intervention Alerts" as FAFR002
    usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003

    f --> FAFR002 : "View Client Intervention Alerts"
    f --> FAFR003 : "Use Predictive Analytics to Guide Advice"

  }

  rectangle "System Administrator" {
    actor SysAdmin as s
    usecase "SAFR001: Manage Analysis Parameters" as SAFR001

    s --> SAFR001 : "Adjust AI Algorithms for Accuracy and Compliance"
  }
  
}

@enduml