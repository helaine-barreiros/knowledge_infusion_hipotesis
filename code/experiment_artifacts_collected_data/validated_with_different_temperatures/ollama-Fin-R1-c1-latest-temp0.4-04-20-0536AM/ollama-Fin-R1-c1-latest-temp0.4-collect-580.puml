@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFR001,FAFR002,FAFR003,FAFR004
:AIFunctionalComponent: as AIFR001,AIFR002,AIFR003,AIFR004,AIFR005,AIFR006,AIFR007,AIFR008,AIFR009

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Personalized Recommendations Based on Profile" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Spending Limit Alerts for Budget Control" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access Portfolio-Related News" as CFR008
  usecase "CFR009: Consolidated Personalized Dashboard" as CFR010
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Segment" as FAFR004

  SysAdmin --> SAFR001 : To manage system parameters ensuring compliance.

  Client --> CFR001,CFR002,CFR003,CFR004,CFR005,CFR006,CFR007,CFR008,CFR009
  FAFR001 <|-- (Client) : Financial Advisors can manage client data.
  
  AIFunctionalComponent --> CFR003 : AI generates predictions for clients.
  AIFunctionalComponent --> CFR004 : AI provides personalized recommendations based on user profiles and goals.

}

@enduml