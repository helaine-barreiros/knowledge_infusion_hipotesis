@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "CFR004: Receive Personalized Financial Recommendations" as CFR004
  usecase "SAFR002: Configure Analysis Parameters by Client Segment" as SAFR002
  usecase "SFR019: Maintain Historical Record of Insights for Trend Analysis" as SFR019
  usecase "CFR005: Manage Personalized Recommendations Preferences" as CFR005
  usecase "AIFR003: Generate Spending Limit Alerts Based on User Data" as AIFR003
  usecase "SFR020: Manage User Feedback to Improve Insights" as SFR020
}

rectangle "Client" {
  actor "User (Client)" as Client
  user -> CFR001 : View Financial Insights Dashboard
  user -> FAFR004 : Receive Personalized Recommendations
  user -> AIFR003 : Manage Spending Limit Alerts
  user -> SFR020 : Send Feedback on System Outputs
}

rectangle "Financial Advisor" {
  actor "FAF (Financial Advisor)" as FAF
  faf -> FAFR001 : Schedule Mentoring Sessions Based on Insights
  faf -> FAFR003: View Predictive Analytics for Clients
  faf -> AIFR008: Review Intervention Recommendations
}

rectangle "System Administrator" {
  actor "SysAdmin" as SysAdmin
  sysadmin -> SAFR001 : Manage Analysis Parameters
  sysadmin -> SAFR002: Configure Client-Specific Parameters
}
@enduml