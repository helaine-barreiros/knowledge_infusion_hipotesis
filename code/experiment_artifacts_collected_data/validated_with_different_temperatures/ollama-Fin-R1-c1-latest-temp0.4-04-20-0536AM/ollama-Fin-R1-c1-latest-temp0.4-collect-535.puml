@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Alerts Preferences" as SAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Manage Relationship with Advisors" as CFR009

  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003

  user "Client" as Client
  user "Financial Advisor (Advisor)" as Advisor
  user "System Administrator (SysAdmin)" as SysAdmin
  
  Client --> CFR001 : View dashboard with financial data.
  Client --> SAFR002 : Adjust alert settings for transactions or spending limits.
  Client --> CFR003 : See future projections based on history and trends.
  Client --> CFR004 : Get tailored advice aligned to personal finance goals.
  Client --> CFR005 : Customize preferences in recommendations system.
  Client --> CFR006 : Monitor budget by receiving alerts when spending exceeds limits.
  Client --> CFR007 : Explore investment options matching risk profile and criteria.
  Client --> CFR008 : Stay informed about market events affecting investments.
  Client --> CFR009 : Control access to financial data shared with advisors.

  Advisor --> FAFR002 : Review alerts for clients needing attention from professionals.
  
  SysAdmin --> SAFR001 : Configure system-wide analysis parameters ensuring compliance and accuracy.

  rectangle "System" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    usecase "SFR002: Provide Personalized Recommendations" as SFR002
    usecase "SFR003: Request Predictions from AI" as SFR003
    usecase "SFR004: Request Recos Based on Profiles" as SFR004
    usecase "SFR005: Send Spending Alerts to Users" as SFR005
    usecase "SFR006: Analyze Investment Opportunities" as SFR006
    usecase "SFR007: Find Suitable Investments for User" as SFR007
    usecase "SFR008: Detect Anomalies in Transactions" as SFR008
    usecase "SFR009: Extract News Relevant to Portfolio" as SFR009
    usecase "SFR010: Generate Client Dashboards" as SFR010
    usecase "SFR013: Manage Alerts Based on Conditions" as SFR013

    SysAdmin --> SFR002 : Ensure recommendations are accurate and relevant.
  
  }

  rectangle "AI System (AIFR)" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR004: Analyze Investment Opportunities" as AIFR004
    usecase "AIFR005: Identify Suitable Investments" as AIFR005
    usecase "AIFR006: Detect Anomalies in Transactions" as AIFR006
    usecase "AIFR007: Correlate News with Portfolios" as AIFR007

  }

  Client <|-- SFR013 : System manages alerts based on user-defined conditions.
  
}

@enduml