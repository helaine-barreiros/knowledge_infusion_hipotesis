@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR004: Request Personalized Recommendations from AI Component" as SAFR004
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "AIFR001: Generate Financial Predictions by Analyzing Transactional Data, Market Trends, Economic Indicators" as AIFR001
  
  Client --> CFR001 : "View financial insights dashboard"
  
  SysAdmin -> SAFR004 : "Manage analysis parameters for AI system compliance with regulations like Basel III"
  
  FinancialAdvisor -- SFR002 : "Receive personalized recommendations from the system"
  
  User <|-- (Client, FinancialAdvisor, SystemAdministrator) : "User types interacting within the system"

  Client --> AIFR001 : "Request financial predictions via the system"
}

@enduml