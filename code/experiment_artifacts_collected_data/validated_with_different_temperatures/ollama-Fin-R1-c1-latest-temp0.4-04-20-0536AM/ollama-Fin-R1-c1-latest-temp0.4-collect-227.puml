@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sa
actor FinancialAdvisor as fa
system "System" as sys

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Data and Trends" as CFR003
  usecase "CFR004: Personalized Recommendations Aligned with Profile" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts for Budget Control" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Receive Relevant News about Portfolio" as CFR008
  usecase "CFR009: Consolidated Personalized Dashboard for Monitoring Finances" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors Including Data Sharing Permissions" as CFR10
  
}

rectangle "System Administrator Interface" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
}

rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Guidance" as FAFR002
  usecase "FAFR003: Review Predictive Analytics About Clients' Financial Situations" as FAFR003
}

rectangle "System Core Functions (SFR)" {
  usecase "SFR001: Deliver Alerts Through Notification Channels" as SFR001
  usecase "SFR002: Generate Personalized Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts When Exceeding Thresholds" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis Based on Risk Profiles" as SFR006
  usecase "SFR007: Find Specific Investment Opportunities Matching Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts for Fraud Detection" as SFR008
  usecase "SFR009: Extract Contextualized News Relevant to Portfolios" as SFR009
  usecase "SFR010: Process Contextualized News Insights" as SFR010
  usecase "SFR011: Request AI-Generated Client Dashboards for Intuitive Presentation" as SFR011
  usecase "SFR012: Generate Client Alerts Based on Predefined Conditions" as SFR012
}

rectangle "AI Component (AIFR)" {
  usecase "AIFR001: Generate Financial Predictions by Analyzing Data and Trends" as AIFR001
  usecase "AIFR002: Create Personalized Recommendations Based on Profiles" as AIFR002
  usecase "AIFR003: Identify Spending Limit Alerts for Budget Control" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities Against Risk Tolerance and Goals" as AIFR004
  usecase "AIFR005: Discover Investment Instruments Aligned with Strategies" as AIFR005
  usecase "AIFR006: Detect Anomalous Transactions for Fraud Prevention" as AIFR006
  usecase "AIFR007: Correlate News to Portfolios for Relevant Insights" as AIFR007
}

usecase "CFR11: Send Feedback About System Outputs" as CFR11

c1 --> CFR001 : View Financial Dashboard
c1 --> CFR002 : Receive Anomaly Alerts
c1 --> CFR003 : View Predictions Based on Data and Trends
c1 --> CFR004 : Get Personalized Recommendations
c1 --> CFR005 : Manage Recommendation Preferences
c1 --> CFR006 : View Spending Limit Alerts
c1 --> CFR007 : Access Investment Opportunities
c1 --> CFR008 : Receive Portfolio-Related News
c1 --> CFR009 : Consolidated Dashboard for Monitoring Finances
c1 --> CFR10 : Manage Relationship with Advisors Including Data Sharing

sa --> SAFR001 : Manage Analysis Parameters

fa --> FAFR001 : Manage Client Mentoring Sessions Based on Insights
fa --> FAFR002 : View Intervention Alerts
fa --> FAFR003 : Review Predictive Analytics for Clients

sys --> SFR001 : Deliver Notifications
sys --> SFR002 : Generate Recommendations
sys --> SFR003 : Request Financial Predictions from AI
sys --> SFR004 : Request Personalized Recos From AI
sys --> SFR005 : Request Spending Limit Alerts
sys --> SFR006 : Request Investment Opportunity Analysis Based on Risk Profiles
sys --> SFR007 : Find Specific Investments Matching Criteria and ESG Preferences
sys --> SFR008 : Request Anomaly Transaction Alerts for Fraud Detection
sys --> SFR009 : Extract Contextualized News Relevant to Portfolios
sys --> SFR010 : Process Context Insights from AI
sys --> SFR011 : Generate Client Dashboards via AI
sys --> SFR012 : Generate Client Alerts Based on Predefined Conditions

AIFR001 <|-- sys: Provide Financial Predictions
AIFR002 <|-- sys: Create Personalized Recos for Users
AIFR003 <|-- sys: Identify Spending Limit Alerts
AIFR004 <|-- sys: Analyze Investment Opportunities Based on Profiles
AIFR005 <|-- sys: Discover Investments Matching Criteria and ESG Preferences
AIFR006 <|-- sys: Detect Anomalous Transactions for Fraud Prevention
AIFR007 <|-- sys: Correlate News to Portfolios

c1 --> CFR11 : Send Feedback about System Outputs

@enduml