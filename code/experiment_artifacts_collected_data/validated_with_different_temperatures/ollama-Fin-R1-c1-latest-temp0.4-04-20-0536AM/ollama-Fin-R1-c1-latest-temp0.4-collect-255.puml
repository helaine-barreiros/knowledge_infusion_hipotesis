@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as C
actor SysAdmin as SA
actor FinancialAdvisor as FA
system S

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Alert Preferences" as SAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: Access Investment Opportunities" as CFR007
  usecase "CFR008: View Portfolio News" as CFR008
  usecase "CFR009: Manage Relationship with Advisors" as CFR009
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: Manage Client Mentoring Sessions" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI" as SFR003
  usecase "AIFR001: Generate Financial Predictions" as AIFR001

C --> CFR001 : "View financial insights dashboard"
C --> SAFR002 : "Manage alert preferences (e.g., transaction, spending limit)"
C --> CFR003 : "View financial predictions based on historical data and trends"
C --> CFR004 : "Receive personalized recommendations aligned with profile"
C --> CFR005 : "Adjust recommendation settings"
C --> SAFR001 : "Tune analysis parameters for AI system accuracy and compliance (e.g., Basel III)"
FA --> FAFR002 : "Schedule mentoring sessions based on insights from the system"
SA --> SAFR001 : "Set up or modify system-wide parameters per regulatory standards like GDPR, CCPA"

SFR003 <|-- AIFR001 : "Request financial predictions using historical data and trends"
SFR004 <|-- AIFR002 : "Request personalized recommendations based on user profile and history"
SFR005 <|-- AIFR003 : "Trigger spending limit alerts for threshold exceedances in categories"

// Additional relationships
SA --> SAFR001 : "Manage analysis parameters" (already defined)
FA --> FAFR002 : "Plan client interactions using system-generated data"
C --> CFR009 : "Control access to advisors and sharing of financial info"
CFR006 <|-- AIFR003 : "Display spending limit alerts when thresholds are breached"

@enduml