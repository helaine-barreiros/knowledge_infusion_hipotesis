@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sas
actor FinancialAdvisor as faa
system "System" as sys

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Data and Trends" as CFR003
  usecase "CFR004: Personalized Recommendations Aligning with Goals" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidated Personalized Dashboard for Monitoring Finances" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10

  c1 --> CFR001 : View financial data in a dashboard.
  c1 --> CFR002 : Receive alerts about anomalous transactions.
  c1 --> CFR003 : View future predictions based on historical and market trends.
  c1 --> CFR004 : Get personalized recommendations tailored to goals.
  c1 --> CFR005 : Adjust preferences for recommendations relevance.
  c1 --> CFR006 : Receive spending limit alerts when exceeding thresholds.
  c1 --> CFR007 : View investment opportunities matching risk profile.
  c1 --> CFR008 : Access portfolio-related news updates.
  c1 --> CFR009 : Use consolidated dashboard to monitor finances.
  c1 --> CFR10 : Manage interactions with advisors.

}

rectangle "System Administration" {
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  sas --> SAFR001 : Configure and adjust parameters ensuring compliance (e.g., Basel III).
  
}

rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Schedule Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Proactive Guidance" as FAFR002
  usecase "FAFR003: Review Predictive Analytics to Inform Consultations" as FAFR003
  usecase "FAFR004: Customize Analysis Parameters by Client Segment" as FAFR004

  faa --> FAFR001 : Schedule sessions using system-generated insights.
  faa --> FAFR002 : View alerts to take proactive steps with clients.
  faa --> FAFR003 : Use predictive analytics for better advice during meetings.
  faa --> FAFR004 : Adjust analysis settings based on client groups and regulations (e.g., GDPR, CCPA).
}

rectangle "System Functionalities" {
  usecase "SFR001: Deliver Alerts Through Notification Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AI" as SFR004
  usecase "SFR005: Request Spending Limit Alerts From AI" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
  usecase "SFR007: Find Specific Investments Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Detect Anomalous Transactions for AML Compliance" as SFR008
  usecase "SFR009: Extract Relevant News Contextualized to Portfolio" as SFR009
  usecase "SFR010: Generate Client Dashboards with Financial Information" as SFR010
  usecase "SFR011: Ensure Timely Delivery of Alerts and Insights" as SFR011

  sys --> SFR001 : Send alerts via appropriate channels.
  sys --> SFR002 : Provide recommendations based on user profiles.
  sys --> SFR003 : Request predictions from AI for financial insights.
  sys --> SFR004 : Ask AI to generate personalized recommendations.
  sys --> SFR005 : Trigger spending limit alerts when thresholds are exceeded.
  sys --> SFR006 : Analyze investment opportunities based on user risk profiles.
  sys --> SFR007 : Identify ESG-aligned investments per client's criteria.
  sys --> SFR008 : Monitor transactions for AML compliance using pattern recognition.
  sys --> SFR009 : Correlate news with portfolios to provide relevant updates.
  sys --> SFR010 : Create dashboards presenting financial data intuitively.
  sas --> SAFR001 <|-- (sys) : Admins can adjust system parameters.

}

rectangle "AI System" {
  usecase "AIFR001: Generate Financial Predictions Based on Data and Trends" as AIFR001
  usecase "AIFR002: Personalized Recommendations Aligning with Industry Standards" as AIFR002
  usecase "AIFR003: Spending Limit Alerts Using Pattern Recognition" as AIFR003
  usecase "AIFR004: Investment Opportunity Analysis Based on Risk Profiles" as AIFR004
  usecase "AIFR005: Align Investments with Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Anomaly Transaction Alerts for Fraud Detection" as AIFR006
  usecase "AIFR007: Contextualized News Insights Based on Portfolios" as AIFR007
  usecase "AIFR008: Predictive Intervention Recommendations to Engage Advisors" as AIFR008
  usecase "AIFR009: Forward-Looking Analysis for Financial Planning" as AIFR009

  sys --> AIFR001 : AI generates predictions using data and trends.
  sys --> AIFR002 : Provide recommendations per user's financial profile (e.g., FINRA guidelines).
  sys --> AIFR003 : Detect unusual spending patterns via pattern recognition for alerts.
  sys --> AIFR004 : Evaluate investments against risk profiles to suggest opportunities.
  sys --> AIFR005 : Align investment choices with MPT principles based on user goals.
  sys --> AIFR006 : Identify potential fraud through transaction analysis (FinCEN compliance).
  sys --> AIFR007 : Correlate financial news with portfolios to highlight relevant impacts.
  sys --> AIFR008 : Recommend when advisors should engage clients based on predictive models.
  sys --> AIFR009 : Offer forward-looking analyses for better financial planning.

}

usecase "CFR11: Send Feedback" as CFR11
c1, faa, sas --> CFR11 : Provide feedback to improve system outputs and accuracy.

@enduml