@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor FinancialAdvisor as faa
actor SysAdmin as saas
system "System" as sys

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Predictive Analytics Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Access Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile (MiFID II)" as CFR007
  usecase "CFR008: Receive Relevant News for Financial Portfolios" as CFR008
  usecase "CFR009: View Consolidated Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors, Including Data Sharing Permissions" as CFR10

}

rectangle "System Administrator Interface" {
  usecase "SAFR001: Manage Analysis Parameters for AI System Compliance" as SAFR001
}

rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Schedule Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Proactive Guidance" as FAFR002
  usecase "FAFR003: Review Predictive Analytics to Inform Consultations" as FAFR003
}

rectangle "System Core Functions (SFR)" {
  usecase "SFR001: Deliver Notifications Through Appropriate Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AI" as SFR004
  usecase "SFR005: Trigger Spending Limit Alerts Based on Thresholds" as SFR005
  usecase "SFR006: Identify Investment Opportunities for Users" as SFR006
  usecase "SFR007: Find Specific Investments Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Detect Anomalous Transactions in Accordance with AML Regulations" as SFR008
  usecase "SFR009: Extract Relevant News for Portfolios From Trusted Sources" as SFR009
  usecase "SFR010: Generate Client Dashboards Intuitively" as SFR010
  usecase "SFR011: Manage Historical Insights for Trend Analysis" as SFR011
}

rectangle "AI Component (AIFR)" {
  usecase "AIFR001: Analyze Transaction Data, Market Trends, and Economic Indicators to Generate Predictions" as AIFR001
  usecase "AIFR002: Create Personalized Recommendations Based on Financial Profiles" as AIFR002
  usecase "AIFR003: Identify Unusual Spending Patterns for Alerts" as AIFR003
  usecase "AIFR004: Evaluate Investments Against Risk Tolerance and Goals" as AIFR004
  usecase "AIFR005: Discover Financial Instruments Aligning with Investment Strategies" as AIFR005
  usecase "AIFR006: Detect Fraudulent Transactions Using Pattern Recognition" as AIFR006
  usecase "AIFR007: Correlate News With Portfolios for Relevance" as AIFR007
  usecase "AIFR008: Identify Patterns Indicating Financial Opportunities or Risks For Advisors" as AIFR008
}

usecase "CFR11: Send Feedback to Improve System Outputs" as CFR11

c1 --> CFR001 : "View financial insights"
c1 --> CFR002 : "Receive alerts on anomalous transactions"
c1 --> CFR003 : "View predictive analytics based on data and trends"
c1 --> CFR004 : "Access personalized recommendations aligned with profile"
c1 --> CFR005 : "Manage recommendation preferences"
c1 --> CFR006 : "View spending limit alerts when exceeding thresholds"
c1 --> CFR007 : "Access investment opportunities matching risk profile (MiFID II)"
c1 --> CFR008 : "Receive relevant news for portfolios"
c1 --> CFR009 : "View consolidated personalized dashboard"
c1 --> CFR10 : "Manage relationship with advisors, including data sharing"

saas --> SAFR001 : "Manage analysis parameters for compliance"

faaa --> FAFR001 : "Schedule mentoring sessions based on insights"
faaaa --> FAFR002 : "View intervention alerts for proactive guidance"
faaaa --> FAFR003 : "Review predictive analytics during consultations"

sys --> SFR001 : "Deliver notifications through channels"
sys --> SFR002 : "Provide personalized recommendations based on profiles"
sys --> SFR003 : "Request financial predictions from AI"
sys --> SFR004 : "Request personalized recommendations from AI"
sys --> SFR005 : "Trigger spending limit alerts when thresholds exceeded"
sys --> SFR006 : "Identify investment opportunities for users"
sys --> SFR007 : "Find specific investments matching user criteria and ESG preferences"
sys --> SFR008 : "Detect anomalous transactions per AML regulations"
sys --> SFR009 : "Extract relevant news from trusted sources"
sys --> SFR010 : "Generate client dashboards intuitively"
sys --> SFR011 : "Manage historical insights for trend analysis"

aifr --> AIFR001 : "Analyze data, trends, and indicators to generate predictions"
aifra --> AIFR002 : "Create personalized recommendations based on profiles"
aifra --> AIFR003 : "Identify unusual spending patterns for alerts"
aifra --> AIFR004 : "Evaluate investments against risk tolerance and goals"
aifra --> AIFR005 : "Discover financial instruments aligning with strategies"
aifra --> AIFR006 : "Detect fraudulent transactions using pattern recognition"
