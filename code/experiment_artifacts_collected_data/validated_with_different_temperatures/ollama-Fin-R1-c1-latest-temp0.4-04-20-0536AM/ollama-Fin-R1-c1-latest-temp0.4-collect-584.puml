@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Notification Preferences" as SAFR002
  usecase "SFR003: Request Predictive Interventions" as SFR003
  
  Client --> CFR001 : "View Financial Insights Dashboard"
  
  SysAdmin <|-- SAFR002 : "Manage Analysis Parameters, Notification Preferences"
  SysAdmin <|-- SFR003 : "Request Predictive Interventions"

  rectangle "Client" {
    actor "User (Client)" as User
    user --> CFR001 
    user --> SAFR002 
    user --> SFR003 

    usecase "CFR004: Receive Personalized Recommendations" as CFR004
    user --> CFR004 : "Receive Personalized Recommendations"
    
    usecase "CFR005: Manage Recommendation Preferences" as CFR005
    user --> CFR005
    
    usecase "CFR011: Send Feedback" as CFR011
    user --> CFR011

  }

  rectangle "Financial Advisor" {
    actor "FAFR002: Financial Advisor" as FAFR002
    FAFR002 <|-- SAFR002 : "Manage Client Mentoring Sessions, View Intervention Alerts"
    
    usecase "FAFR001: Manage Client Meetings Based on Insights" as FAFR001
    FAFR002 --> FAFR001
    
  }

  rectangle "System Administrator" {
    actor "SysAdmin" as SysAdmin
    SysAdmin <|-- SAFR001 : "Manage Analysis Parameters"
    
    usecase "SFR004: Request Financial Predictions" as SFR004
    SysAdmin --> SFR004
    
  }

}

@enduml