@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as client
actor FinancialAdvisor as fa
actor SysAdmin as sa
system "System" as system

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as cfr001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as cfr002
  usecase "CFR003: Access Financial Predictions Based on Historical Data and Market Trends" as cfr003
  usecase "CFR004: Get Personalized Recommendations Aligned with Financial Profile" as cfr004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as cfr005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds" as cfr006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as cfr007
  usecase "CFR008: Receive News Related to Investment Portfolio" as cfr008
  usecase "CFR009: Use a Consolidated Dashboard for Financial Monitoring" as cfr009
  usecase "CFR10: Manage Relationship with Financial Advisors, Including Data Sharing Permissions" as cfr10

  client --> (cfr001)
  client --> (cfr002)
  client --> (cfr003)
  client --> (cfr004)
  client --> (cfr005)
  client --> (cfr006)
  client --> (cfr007)
  client --> (cfr008)
  client --> (cfr009)
  client --> (cfr10)
}

rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as fafr001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as fafr002
  usecase "FAFR003: Review Predictive Analytics About Clients' Financial Situations" as fafr003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as fafr004

  fa --> (fafr001)
  fa --> (fafr002)
  fa --> (fafr003)
  fa --> (fafr004)
}

rectangle "System Administrator Interface" {
  usecase "SAFR001: Manage Analysis Parameters for AI System Compliance with Financial Regulations" as safr001

  sa --> (safr001)
}

system -- (cfr001 : "View Financial Insights Dashboard")
system -- (cfr002 : "Receive Alerts for Anomalous Transactions")
system -- (cfr003 : "Access Financial Predictions Based on Historical Data and Market Trends")
system -- (cfr004 : "Get Personalized Recommendations Aligned with Financial Profile")
system -- (cfr005 : "Manage Preferences for Personalized Recommendations")
system -- (cfr006 : "View Spending Limit Alerts When Exceeding Predefined Thresholds")
system -- (cfr007 : "Access Investment Opportunities Based on Risk Profile")
system -- (cfr008 : "Receive News Related to Investment Portfolio")
system -- (cfr009 : "Use a Consolidated Dashboard for Financial Monitoring")
system -- (cfr10 : "Manage Relationship with Financial Advisors, Including Data Sharing Permissions")

system -- (safr001)
system --> (cfra002)
system --> (cfra003)

@enduml