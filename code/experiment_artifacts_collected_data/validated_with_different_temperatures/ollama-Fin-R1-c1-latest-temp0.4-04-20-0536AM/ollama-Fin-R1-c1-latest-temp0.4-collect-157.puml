@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as C1
actor SysAdmin as SA
actor FinancialAdvisor as FA
system "System" as S

rectangle "Client Subsystem" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Recommendation Preferences in KYC Context" as CFR005
  usecase "CFR006: View Spending Limit Alerts for Budget Control" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Portfolio Management" as CFR008
  usecase "CFR009: Consolidated Financial Dashboard for Efficiency" as CFR009
  usecase "CFR10: Manage Relationship with Advisors, Including Data Sharing Permissions" as CFR10

}

rectangle "System Administrator Subsystem" {
  usecase "SAFR001: Manage Analysis Parameters for AI System Compliance" as SAFR001
}

rectangle "Financial Advisor Subsystem" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts from System" as FAFR002
  usecase "FAFR003: Review Predictive Analytics for Clients" as FAFR003
}

rectangle "System Subsystem" {
  usecase "SFR001: Deliver Notifications to Users via Appropriate Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts Based on User Data" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis for Users" as SFR006
  usecase "SFR007: Find Specific Investment Opportunities Matching Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Detect Anomalies in Transactions via AI Component" as SFR008
  usecase "SFR009: Extract Contextualized News Relevant to Portfolios" as SFR009
  usecase "SFR010: Generate Client Dashboards with Financial Information" as SFR010
  usecase "SFR011: Ensure Timely Delivery of Predefined Alerts" as SFR011
}

rectangle "AI Subsystem" {
  usecase "AIFR001: Analyze Historical Data and Market Trends for Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations Based on Profiles" as AIFR002
}

use C1 --> CFR001 : "View Financial Insights Dashboard"
