@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage System Parameters" as SAFR002
  
  rectangle "Client Interface" {
    actor Client as c
    client --> CFR001 : "View Alerts", "Receive Personalized Recommendations"
    
    usecase "CFR003: View Financial Predictions" as CFR003
    usecase "CFR004: Receive Personalized Recommendations" as CFR004
    usecase "CFR005: Manage Preferences for Recommendations" as CFR005
    usecase "CFR006: View Spending Limit Alerts" as CFR006
    usecase "CFR007: View Investment Opportunities" as CFR007
    usecase "CFR008: Access News Related to Portfolio" as CFR008
    usecase "CFR009: Manage Relationship with Advisors" as CFR009
    
    c --> (CFR001), (CFR003), (CFR004), (CFR005), (CFR006), (CFR007), (CFR008), (CFR009)
  }
  
  rectangle "Financial Advisor Interface" {
    actor FinancialAdvisor as fa
    usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
    usecase "FAFR002: View Intervention Alerts" as FAFR002
    usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
    usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004
    
    fa --> (FAFR001), (FAFR002), (FAFR003), (FAFR004)
  }
  
  rectangle "System Administrator Interface" {
    actor SysAdmin as sa
    usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
    usecase "SFR020: Maintain Historical Record of Insights" as SFR020
    
    sa --> (SAFR001), (SFR020)
  }
  
  rectangle "AI Component Interface" {
    actor AIFR001 as aifr1
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    
    aifr1 --> (AIFR001), (AIFR004)
  }
  
  rectangle "Notification System Interface" {
    actor SFR002 as sfr
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    
    sfr --> (SFR003), (SFR005)
  }
  
  SysAdmin <|-- SAFR001 : admin rights
  Client <|-- CFR004, CFR006, CFR009 : preferences management
  FinancialAdvisor <|-- FAFR002: alerts monitoring
}

@enduml