@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor FinancialAdvisor as fa1
actor SysAdmin as sa1
system :System: as sys

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Portfolio Investments" as CFR008
  usecase "CFR009: Manage Relationship with Financial Advisors Including Data Sharing Permissions" as CFR009

}

rectangle "FinancialAdvisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
}

rectangle "SysAdmin" {
  usecase "SAFR001: Manage Analysis Parameters to Ensure Accuracy and Compliance with Basel III" as SAFR001

}

system :System: {
  usecase "SFR001: Deliver Alerts Through Notification Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Financial Profiles" as SFR002
  usecase "SFR003: Request AI Component for Financial Predictions" as SFR003
  usecase "SFR004: Request AI Component for Personalized Recommendations" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis From AI Component" as SFR006
  usecase "SFR007: Find Specific Investment Opportunities Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Detect Anomalous Transactions via AML Compliance Using AI Component" as SFR008
  usecase "SFR009: Extract Relevant News for Users' Portfolios From Trusted Sources" as SFR009
  usecase "SFR010: Process Contextualized News to Inform Financial Situations" as SFR010
  usecase "SFR012: Generate Client Dashboards Intuitively" as SFR013
  usecase "SFR014: Provide Meaningful Client Analytics" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses From AI Component" as SFR015
  usecase "SFR016: Enhance Financial Guidance With Predictive Insights From AI" as SFR017
  usecase "SFR018: Track Users' Financial Goals and Provide Recommendations" as SFR019
  usecase "SFR020: Maintain Historical Record of User Insights for Trend Analysis" as SFR021

}

system :AI Component (AIFR) {
  usecase "AIFR001: Generate Financial Predictions via Data and Trends" as AIFR001
  usecase "AIFR002: Create Personalized Recommendations Based on Profiles" as AIFR002
  usecase "AIFR003: Identify Spending Limit Alerts for Users" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities Per Risk Profile" as AIFR004
  usecase "AIFR005: Find Financial Instruments Aligning With User Strategies and MPT Principles" as AIFR005
  usecase "AIFR006: Detect Anomalies in Transactions Compliant with FinCEN Rules" as AIFR006
  usecase "AIFR007: Correlate News to Portfolios for Relevant Insights" as AIFR007
  usecase "AIFR008: Recommend Interventions Based on Financial Patterns" as AIFR008
  usecase "AIFR009: Provide Forward-Looking Analysis of Financial Situations" as AIFR009

}

