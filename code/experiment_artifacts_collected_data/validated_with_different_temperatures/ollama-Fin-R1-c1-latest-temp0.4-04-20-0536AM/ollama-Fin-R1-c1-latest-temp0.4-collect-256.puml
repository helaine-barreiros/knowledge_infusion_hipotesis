@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "SFR004: Request Personalized Recommendations" as SFR004
  usecase "SFR005: Request Spending Limit Alerts" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003

  client --> CFR001 : "Client wants to view financial insights."
  
  SysAdmin --> SAFR001 : "System Admin manages analysis parameters."

  FAFR002 <|-- (SFR005) : Financial Advisor views alerts when spending exceeds threshold.

  SFR003 <|-- AIFR001 : System requests predictions from AI.
  
  SFR004 <|-- AIFR002 : System requests recommendations based on profiles and goals.

  SFR006 <|-- AIFR005 : System requests investment opportunities matching risk profile.

  SFR012 <|-- (CFR009) : System generates dashboards for clients.
  
  CFR011 --> Sys : "User sends feedback to improve system."
}
@enduml