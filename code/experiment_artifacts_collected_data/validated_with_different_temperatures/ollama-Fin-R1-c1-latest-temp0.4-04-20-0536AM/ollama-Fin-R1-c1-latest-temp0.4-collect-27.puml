@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c
actor SysAdmin as sadmin
actor FinancialAdvisor as fa
package Professional {
  actor Chef as chef (not used here)
}

rectangle "System" {
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003

  c --> (CFR001)
  
}

rectangle "Client-Specific Functions" {
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR004: Personalized Recommendations Based on Profile" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Spending Limit Alerts for Budget Control" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access Portfolio-Related News" as CFR008
  usecase "CFR009: Consolidated Financial Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10

  
}

rectangle "Advisor-Specific Functions" {
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR004: Configure Analysis Parameters for Segments" as FAFR004
}
  

rectangle "System-Managed Use Cases" {
  
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
}

// Relationships

Client --> CFR002 : "View Alerts"
Client --> CFR004 : "Receive Personalized Recommendations"
Client --> CFR005 : "Manage Preferences"
Client --> CFR006 : "Spending Limit Alerts"
Client --> CFR007 : "Investment Opportunities Based on Risk Profile"
Client --> CFR008 : "Portfolio News"
Client --> CFR009 : "Consolidated Dashboard"
Client --> CFR10 : "Relationship Management"

SysAdmin --> SAFR001 : "Manage Analysis Parameters"

FinancialAdvisor --> FAFR002 : "View Intervention Alerts"
FinancialAdvisor --> FAFR004 : "Configure Segments"

// System components
rectangle "System" {
  usecase "SFR003: Request Predictive Analytics from AI" as SFR003
}

Client <|-- (CFR001)
SysAdmin <|-- SAFR001

FinancialAdvisor <|-- FAFR002
FinancialAdvisor <|-- FAFR004

@enduml