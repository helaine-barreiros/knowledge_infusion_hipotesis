title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics About Client's Finances" as FAFR003
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "SAFR006: Generate Spending Limit Alerts Based on Thresholds Exceeded" as SAFR006
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004
  usecase "SFR013: Deliver Client Alerts When Conditions Are Met" as SFR013
  usecase "CFR005: Manage Personalized Recommendations Preferences" as CFR005
  usecase "AIFR002: Generate Personalized Recommendations Based on Financial Profiles" as AIFR002
  usecase "SFR004: Request AI Component for Personalized Recommendations" as SFR004
  usecase "CFR010: Manage Relationship with Advisors Including Data Sharing Permissions" as CFR010
  usecase "AIFR008: Generate Predictive Intervention Analysis for Advisor Engagement" as AIFR008
  usecase "SFR020: Maintain Historical Record of Insights for Trend Analysis" as SFR020

  client --> CFR001 : View financial data in dashboard  
  SysAdmin --> SAFR001 : Manage system parameters  
  Client --> FAFR003 : Access predictive analytics on finances  
  Client --> CFR002 : Get alerts for anomalous transactions  
  Client --> SAFR006 : Receive spending limit alerts when thresholds are exceeded  
  Client --> FAFR004 : Adjust analysis settings by client segment  
  Sys --> SFR013 : Notify clients via system-generated alerts  
  Client --> CFR005 : Update personal recommendation preferences  
  Sys --> AIFR002 : Provide personalized recommendations to users  
  Sys --> SFR004 : Request AI for personalized recommendations  
  Advisor --> FAFR001 : Manage client mentoring sessions using generated insights  
  Advisor --> FAFR003 : View predictive analytics on clients' finances  
  Client --> AIFR008 : Get intervention analysis when needed by advisor  
}

