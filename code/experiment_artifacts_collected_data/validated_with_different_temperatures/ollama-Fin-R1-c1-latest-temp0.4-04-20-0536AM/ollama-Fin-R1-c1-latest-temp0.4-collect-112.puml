@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "SAFR005: Request Spending Limit Alerts" as SAFR005
  usecase "SFR019: Maintain Historical Record of Insights" as SFR019
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "SAFR003: View Predictive Analytics for Clients" as SAFR003
  usecase "FAFR005: Configure Analysis Parameters by Client Segment" as FAFR005
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
  usecase "SAFR004: Request System-Generated Insights for Compliance" as SAFR004
  usecase "SFR020: Manage User Feedback" as SFR020
}

actor Client as C
actor SysAdmin as SA
actor FinancialAdvisor as FA

C --> CFR001 : View financial insights dashboard
SA --> SAFR001 : Manage analysis parameters for the AI system
FA --> FAFR003 : View predictive analytics about clients' financial situations during consultations
C --> CFR004 : Receive personalized recommendations aligned with their financial goals and profile
C --> SFR008 : Request investment opportunity analyses from the system based on risk profiles
SA --> SAFR005 : Set spending limit alerts for users when thresholds are exceeded
FA --> FAFR001 : View client intervention alerts generated by the AI component for proactive guidance
C --> CFR003 : Access financial predictions using historical data and market trends
SFR020 <|-- C : Collect user feedback to improve system outputs

rectangle "AI System" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
}

FA --> AIFR008 : AI generates client predictive intervention recommendations based on patterns in user data

rectangle "Notification Channel" {
  usecase "SFR013: Deliver Client Alerts" as SFR013
}

C -->> SFR013 : Receive alerts via appropriate channels (e.g., email, SMS)

@enduml