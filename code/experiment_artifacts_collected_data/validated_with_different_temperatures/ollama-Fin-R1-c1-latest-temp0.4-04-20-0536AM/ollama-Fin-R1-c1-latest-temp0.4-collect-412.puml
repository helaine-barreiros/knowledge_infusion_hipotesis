@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  Client --> CFR001 : "View Financial Insights Dashboard"
  
  SysAdmin --> SAFR001 : "Manage Analysis Parameters"
  
  FinancialAdvisor --> FAFR003 : "View Predictive Analytics for Clients"
  
  System --> SFR012 : "Generate Client Dashboards"

}

rectangle "Client" {
  usecase "CFR002: View Alerts About Anomalous Transactions" as CFR002
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR011: Send Feedback to System" as CFR011
  
  Client --> CFR002 : "View Alerts"
  
  Client --> CFR004 : "Receive Personalized Recommendations"
  
  Client --> CFR011 : "Send Feedback"

}

rectangle "FinancialAdvisor" {
  usecase "FAFR001: Manage Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Clients" as FAFR002
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
  
  FinancialAdvisor --> FAFR001 : "Manage Mentoring Sessions"
  
  FinancialAdvisor --> FAFR002 : "View Intervention Alerts"
  
  FinancialAdvisor --> FAFR004 : "Configure Analysis Parameters"

}

rectangle "SystemAdministrator" {
  usecase "SAFR007: Manage Users' Relationship Permissions" as SAFR007
  SysAdmin --> SAFR007 : "Manage Relationships with Advisors"

}
@enduml