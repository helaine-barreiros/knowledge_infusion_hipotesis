@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor FinancialAdvisor as fad
actor SysAdmin as sa
system :System: as sys

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Personalized Recommendations Based on Profile" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Spending Limit Alerts for Budget Control" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidated Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10

  c1 --> CFR001 : View dashboard
  c1 --> CFR002 : Receive alerts
  c1 --> CFR003 : Predictions view
  c1 --> CFR004 : Personalized recommendations
  c1 --> CFR005 : Manage prefs
  c1 --> CFR006 : Spending limit alerts
  c1 --> CFR007 : Investment opportunities
  c1 --> CFR008 : Portfolio news
  c1 --> CFR009 : Consolidated dashboard
  c1 --> CFR10 : Manage relationship

}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Clients" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients" as FAFR003

  fad --> FAFR001 : Manage sessions
  fad --> FAFR002 : View alerts
  fad --> FAFR003 : View analytics
}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001

  sa --> SAFR001 : Manage parameters
}

rectangle "System" {
  usecase "SFR001: Deliver Alerts Through Notification Channels" as SFR001
  usecase "SFR002: Personalized Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AI" as SFR004
  usecase "SFR005: Spending Limit Alerts Based on Thresholds" as SFR005
  usecase "SFR006: Investment Opportunity Analysis for Users" as SFR006
  usecase "SFR007: Specific Investment Opportunities Matching Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Anomaly Transaction Alerts Based on AML Regulations" as SFR008
  usecase "SFR009: Contextualized News for Financial Portfolios" as SFR009
  usecase "SFR010: Generate Client Dashboards Intuitively" as SFR010
  usecase "SFR011: Process Contextualized News Insights" as SFR011
  usecase "SFR012: Predictive Intervention Analyses for Advisors" as SFR012
  usecase "SFR013: Financial Health Reports Based on Ratios and Metrics" as SFR013
  usecase "SFR014: Track Users' Financial Goals Over Time" as SFR014

  sys --> (all above)
}

rectangle "AI System" {
  usecase "AIFR001: Generate Financial Predictions Based on Data and Trends" as AIFR001
  usecase "AIFR002: Personalized Recommendations Aligning with Profiles" as AIFR002
  usecase "AIFR003: Spending Limit Alerts Using Pattern Recognition" as AIFR003
  usecase "AIFR004: Investment Opportunity Analysis Based on Risk Profile" as AIFR004
  usecase "AIFR005: Align Investments with Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Anomaly Transaction Alerts According to FinCEN Standards" as AIFR006
  usecase "AIFR007: Contextualized News Insights for Portfolios" as AIFR007
  usecase "AIFR008: Predictive Intervention Recommendations for Advisors" as AIFR008

  sys --> (all above)
}

rectangle "User" {
  usecase "CFR11: Send Feedback to Improve System Outputs" as CFR11

  c1, fad, sa --> CFR11 : Provide feedback
}
@enduml