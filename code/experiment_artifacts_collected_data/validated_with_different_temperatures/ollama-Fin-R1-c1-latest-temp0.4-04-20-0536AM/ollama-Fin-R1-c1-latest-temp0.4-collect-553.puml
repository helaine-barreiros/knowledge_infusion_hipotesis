@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as C
actor FinancialAdvisor as FA
actor SysAdmin as SA
system "System" as S

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidated Financial Dashboard for Monitoring" as CFR009
  usecase "CFR10: Manage Relationship with Advisors Including Data Sharing Permissions" as CFR10

}

rectangle "System Admin Interface" {
  usecase "SAFR001: Manage Analysis Parameters (Basel III)" as SAFR001
}

rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment (GDPR/CCPA)" as FAFR004

}

rectangle "System Core" {
  usecase "SFR001: Deliver Alerts Through Notification Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AI" as SFR004
  usecase "SFR005: Request Spending Limit Alerts When Exceeding Thresholds" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis Based on Risk Profile" as SFR006
  usecase "SFR007: Find Specific Investment Opportunities Matching Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Detect Anomaly Transactions via AI Component (AML)" as SFR008
  usecase "SFR009: Extract Relevant News for Portfolios From Trusted Sources" as SFR009
  usecase "SFR010: Generate Client Dashboards in Intuitive Format" as SFR010
  usecase "SFR013: Generate Alerts Based on Predefined Conditions (Client)" as SFR013
  usecase "SFR014: Generate Client Analytics for Financial Performance Insights" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses From AI Component" as SFR015
  usecase "SFR016: Enhance Value of Guidance via System-Generated Insights (Client)" as SFR016
  usecase "SFR017: Generate Financial Health Reports Using Standard Metrics" as SFR017
  usecase "SFR020: Manage User Feedback to Improve Accuracy and Relevance" as SFR020

}

rectangle "AI Component" {
  usecase "AIFR001: Generate Financial Predictions via Historical Data & Market Trends" as AIFR001
  usecase "AIFR002: Personalized Recommendations Based on Profiles and Goals (FINRA)" as AIFR002
  usecase "AIFR003: Spending Limit Alerts for Unusual Deviations From Patterns" as AIFR003
  usecase "AIFR004: Investment Opportunity Analyses Matching Risk Tolerance & Portfolio Strategy" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Aligning with Strategies and MPT Principles" as AIFR005
  usecase "AIFR006: Anomaly Transaction Alerts Using Pattern Recognition (FinCEN)" as AIFR006
  usecase "AIFR007: Contextualized News Insights Correlated With Portfolios For Relevant Impacts" as AIFR007
  usecase "AIFR008: Predictive Intervention Recommendations Identifying Engagement Opportunities (Client)" as AIFR008
  usecase "AIFR009: Client-Specific Predictive Insights for Effective Financial Planning" as AIFR009

}

C --> CFR001 : View Financial Dashboard  
C --> CFR002 : Receive Alerts on Anomalous Transactions (FATF)  
C --> CFR003 : Get Market Trend-Based Financial Predictions  
C --> CFR004 : Personalized Recommendations Based On Profile  
C --> CFR005 : Manage Recommendation Preferences  
C --> CFR006 : View Spending Limit Alerts When Exceeding Thresholds  
C --> CFR007 : Access Investment Opportunities by Risk Profile  
C --> CFR008 : Get Portfolio-Related News Updates  
C --> CFR009 : Consolidated Dashboard for Monitoring Finances  
C --> CFR10 : Manage Relationship with Advisors (Data Sharing)  

SA --> SAFR001 : Configure Analysis Parameters Under Basel III  

FA --> FAFR001 : Manage Client Mentoring Sessions Based on Insights  
FA --> FAFR002 : View Proactive Alerts for Clients  
FA --> FAFR003 : Review Predictive Analytics For Financial Situations  
FA --> FAFR004 : Customize Analysis Parameters by Segments (GDPR/CCPA)  

SFR010 <|-- S : Generate Client Dashboards  
SFR020 <|-- C : Manage User Feedback for System Improvement  

AIFR009 <|-- AIFR Component: Provide Client-Specific Predictive Insights  

@enduml