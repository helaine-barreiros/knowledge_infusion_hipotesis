@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as Client
}

rectangle "System" {
  
  package Professional {
    actor FinancialAdvisor as FA
    actor SysAdmin as SA
    
    usecase "CFR001: View Financial Insights Dashboard" as CFR001
    usecase "SAFR001: Manage Analysis Parameters" as SAFR001
    usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
    usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
    usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
    usecase "FAFR004: Configure Analysis Parameters by Specific Client Segments" as FAFR004
    
    client --> CFR001 : "View financial insights dashboard"
    
    SysAdmin <|-- SAFR001 : "Manage analysis parameters for AI system compliance with regulations like Basel III."
  }
  
  package System {
    usecase "SFR008: Request Anomaly Transaction Alerts" as SFR008
    usecase "AIFR006: Generate Anomaly Transaction Alerts Using Pattern Recognition" as AIFR006
    
    client --> SFR008 : "Receive anomaly transaction alerts."
  }
  
  package AI {
    actor AISystem as AIS
    
    usecase "AIFR001: Generate Financial Predictions Based on Historical Data and Market Trends" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations Aligned with Client Profiles" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts for Unusual Deviations in Spent Amounts" as AIFR003
    usecase "AIFR004: Identify Investment Opportunities Based on Risk Tolerance and Market Analysis" as AIFR004
    usecase "AIFR005: Align Investment Recommendations with Modern Portfolio Theory Principles" as AIFR005
    usecase "AIFR006: Detect Potentially Fraudulent Transactions via Pattern Recognition" as AIFR006
    usecase "AIFR007: Correlate Financial News With Client Portfolios for Relevant Insights" as AIFR007
    usecase "AIFR008: Recommend Proactive Engagement with Advisors Based on Predictive Analysis" as AIFR008
    
    AIS --> SFR001 : "Deliver personalized recommendations."
    AIS --> SFR002 : "Generate financial predictions for clients."
  }
  
}

client --> CFR001
SysAdmin -> SAFR001

' Client and System interactions
Client --> AIFR001: "Request financial predictions"
Client --> AIFR002: "Receive personalized recommendations"

AIS <|-- SFR008 : "Generate anomaly transaction alerts."
SFR008 --> client : "Notify of potential fraud."

'AIFR006 is part of the AI system
AIFR006 --> AIS

'Other use cases in System and Professional packages are linked as per requirements.
@enduml