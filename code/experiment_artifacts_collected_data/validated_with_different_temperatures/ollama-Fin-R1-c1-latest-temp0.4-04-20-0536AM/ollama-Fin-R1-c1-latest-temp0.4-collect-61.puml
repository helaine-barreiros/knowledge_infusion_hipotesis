@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "CFR002: View Alerts for Anomalous Transactions" as CFR002
  usecase "SAFR006: Deliver Spending Limit Alerts" as SAFR006
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "SAFR012: Generate Client Dashboards" as SAFR012
  usecase "SFR009: Request Contextual News Insights" as SFR009
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "SAFR007: Deliver Investment Opportunity Analysis" as SAFR007
  usecase "FAFR002: Manage Client Intervention Alerts" as FAFR002
  usecase "SFR014: Generate Client Analytics" as SFR014
  usecase "CFR005: Manage Personalized Recommendations Preferences" as CFR005
  usecase "SAFR008: Deliver Anomaly Transaction Alerts" as SAFR008
  usecase "SFR020: Maintain Historical Record of Insights" as SFR020
  usecase "CFR011: Send Feedback on Recommendations and Insights" as CFR011

  actor Client as C
  actor SystemAdmin as SA
  actor FinancialAdvisor as FA
}

C --> SAFR006 : "View Spending Limit Alerts"
SA --> SAFR001 : "Manage Analysis Parameters"
FA --> FAFR003 : "View Predictive Analytics"
C --> CFR002 : "Receive Anomalous Transaction Alerts"
SFR009 <|-- C : "Request Contextual News Insights for Client"
CFR004 <|-- SFR016 : "Receive Personalized Recommendations from System"
SAFR007 <|-- FA : "Deliver Investment Opportunity Analysis to Advisor"
FA --> FAFR002 : "Manage Intervention Alerts"
SFR018 <|-- C : "Track Progress of Financial Goals"

rectangle "Client" {
  usecase CFR001
  usecase CFR003
  usecase CFR004
}

rectangle "System Admin" {
  usecase SAFR001
}

rectangle "Financial Advisor" {
  usecase FAFR001
  usecase FAFR002
  usecase FAFR003
}

@enduml