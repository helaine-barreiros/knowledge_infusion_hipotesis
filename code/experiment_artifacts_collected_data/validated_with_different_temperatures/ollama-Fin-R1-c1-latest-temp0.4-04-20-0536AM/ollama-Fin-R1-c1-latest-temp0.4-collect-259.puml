@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User: as User
:SystemAdmin: as SysAdmin
:FAdvisor: as FAdvisors
:SClient: as SClient

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile (MiFID II)" as CFR007
  usecase "CFR008: Receive News Related to Investment Portfolio" as CFR008
  usecase "CFR009: View Consolidated Financial Information in a Single Dashboard" as CFR009
  usecase "CFR010: Manage Relationship with Financial Advisors, Including Data Sharing Permissions" as CFR010

  SysAdmin --> SAFR001 : Manage Analysis Parameters for AI System Compliance (Basel III)
  
  FAdvisors --> FAFR001 : Manage Client Mentoring Sessions Based on System-Generated Insights
  FAdvisors --> FAFR002 : View Client Intervention Alerts from Anomaly Detection
  FAdvisors --> FAFR003 : View Predictive Analytics for Clients' Financial Situations
  FAdvisors --> FAFR004 : Configure Analysis Parameters by Client Segment (GDPR, CCPA)
  
  SClient --> SFR012 : Generate Client Dashboards with Intuitive Presentation of Data
  SClient --> SFR013 : Generate Alerts Based on Predefined Conditions for Timely Notification
  
  AIFR001 --> CFR003 : Provide Financial Predictions via Historical Analysis and Market Trends
  AIFR002 --> CFR004 : Offer Personalized Recommendations Based on User Profiles (FINRA)
  AIFR005 --> CFR007 : Identify Investment Opportunities Aligning with Risk Tolerance
  AIFR003 --> CFR006 : Alert When Spending Exceeds Predefined Thresholds in Specific Categories
  AIFR004 --> CFR008 : Suggest News Relevant to User's Portfolio Based on Market Events
  AIFR007 --> CFR010 : Correlate Financial News with Client Portfolios for Impact Analysis

  User <|-- (CFR001, CFR002, ..., CFR010)
  
}

@enduml