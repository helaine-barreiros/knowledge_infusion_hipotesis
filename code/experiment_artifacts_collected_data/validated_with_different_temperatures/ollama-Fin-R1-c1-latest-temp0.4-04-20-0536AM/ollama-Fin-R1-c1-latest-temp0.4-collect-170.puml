@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007

  Client --> CFR001 : "View Financial Dashboard"
  
  SysAdmin -> SAFR001 : "Manage Analysis Parameters"

  FinancialAdvisor -> FAFR003 : "Review Predictive Analytics for Clients"
  
  System --|> AIFR007 : "Request Contextualized News Insights"
}

rectangle "Client" {
  actor Client as c
  usecase "CFR002: View Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: Access Investment Opportunities Matching Risk Profile" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Manage Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10

  c --> CFR002 : "Receive Anomaly Alerts"
  c --> CFR003 : "View Predictions"
  c --> CFR004 : "Get Recommendations"
  c --> CFR005 : "Adjust Preferences"
  c --> CFR006 : "Check Spending Limits"
  c --> CFR007 : "Explore Investment Options"
  c --> CFR008 : "Read Portfolio News"
  c --> CFR009 : "Consolidate Dashboard"
  c --> CFR10 : "Control Data Sharing with Advisors"

}

rectangle "FinancialAdvisor" {
  actor FinancialAdvisor as fa
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: Review Predictive Analytics for Clients" as FAFR003
  usecase "SFR15: Request Predictive Interventions from AI" as SFR15

  fa --> FAFR002 : "Monitor Client Alerts"
  fa --> FAFR003 : "Analyze Client Data for Insights"
}

rectangle "SysAdmin" {
  actor SysAdmin as sa
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001

  sa -> SAFR001 : "Configure System Settings"

}
@enduml