  usecase "SFR009: Process Contextualized News for Users' Portfolios" as SFR009
  usecase "SFR010: Generate Client Dashboards in Intuitive Format" as SFR010
  usecase "SFR011: Generate Client Alerts Based on Predefined Conditions" as SFR011
  usecase "SFR012: Generate Client Analytics for Financial Insights" as SFR012
  usecase "SFR013: Request Predictive Intervention Analyses From AI Component" as SFR013
  usecase "SFR014: Manage Users' Financial Goals and Progress Tracking" as SFR014
}

rectangle "AI System (AIFR)" {
