@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR004: Get Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: Access Investment Opportunities" as CFR007
  usecase "CFR008: Get Portfolio-Related News" as CFR008
  usecase "CFR009: Manage Relationship with Advisors" as CFR009
  usecase "SAFR002: View Client Intervention Alerts" as SAFR002
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007

  actor "Client" as Client
  actor "Financial Advisor" as FAdvisor
  actor "System Administrator" as SysAdmin

  Client --> CFR001 : View financial insights dashboard.
  Client --> CFR002 : Receive alerts on anomalous transactions.
  Client --> CFR004 : Get personalized recommendations.
  Client --> CFR005 : Manage recommendation preferences.
  Client --> CFR006 : View spending limit alerts.
  Client --> CFR007 : Access investment opportunities.
  Client --> CFR008 : Get portfolio-related news.
  Client --> CFR009 : Manage relationship with advisors.

  FAdvisor --> FAFR003 : View predictive analytics during consultations.
  FAdvisor --> SAFR002 : View client intervention alerts for proactive assistance.

  SysAdmin --> SAFR001 : Manage analysis parameters to ensure compliance and accuracy.

}

@enduml