@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as client
actor SysAdmin as sysadmin
actor FinancialAdvisor as faadvisor
package Professional {
  actor Chef as c
}
system "System" {
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "AIFR009: Generate Contextualized News Insights" as AIFR009
  
  
  client --> CFR001 : View financial data in a comprehensive format\nClient wants to understand their overall financial health.
  sysadmin --> SAFR001 : Configure system parameters for accuracy and compliance.\nEnsures the AI remains compliant with regulations like Basel III, FATF, etc.
  faadvisor --> FAFR003 : Review predictive analytics during consultations.\nProvides data-driven recommendations to clients based on system-generated insights.
  
  client <|-- CFR001
  sysadmin <|-- SAFR001
  
}

@enduml