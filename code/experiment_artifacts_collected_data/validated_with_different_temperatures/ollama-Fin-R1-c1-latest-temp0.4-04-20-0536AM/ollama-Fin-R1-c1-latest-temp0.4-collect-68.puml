@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Client Alerts" as SAFR002
  usecase "CFR003: View Predictive Analytics" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: Access Investment Opportunities" as CFR007
  usecase "CFR008: Receive Market News" as CFR008
  usecase "CFR009: Consolidate Financial Information" as CFR010
  usecase "SAFR003: Manage Client Data Sharing Permissions" as SAFR004

  usecase "FAFR001: Schedule Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: Review Predictive Analytics" as FAFR003
  usecase "FAFR004: Customize Analysis Parameters by Client Segment" as FAFR004

  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Provide Personalized Recommendations" as SFR002
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Create Personalized Recommendations" as AIFR002
  usecase "AIFR003: Issue Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities" as AIFR004
  usecase "AIFR005: Identify Suitable Investments" as AIFR005
  usecase "AIFR006: Detect Anomalous Transactions" as AIFR006
  usecase "AIFR007: Extract News Insights" as AIFR007
  usecase "AIFR008: Recommend Intervention Actions" as AIFR008
  usecase "AIFR009: Provide Predictive Interventions" as AIFR009

  usecase "CFR011: Send Feedback to System" as CFR011

}

actor Client as C
actor SysAdmin as SA
actor FinancialAdvisor as FA
actor User as U

C --> CFR001 : View financial insights dashboard
SA --> SAFR004 : Manage client data sharing permissions
FA --> FAFR002 : View intervention alerts
U --> AIFR006 : Detect anomalous transactions (via system)
Client <|-- C 
SysAdmin <|-- SA  
FinancialAdvisor <|-- FA

@enduml