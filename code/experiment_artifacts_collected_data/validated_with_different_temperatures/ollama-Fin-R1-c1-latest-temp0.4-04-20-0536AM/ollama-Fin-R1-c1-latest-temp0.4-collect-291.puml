@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics About Client's Finances" as FAFR003
  usecase "SFR012: Generate Client Dashboards" as SFR012

  client --> CFR001 : "Client"
  sysAdmin --> SAFR001 : "System Administrator"
}

rectangle "Financial Advisor Role" {
  actor "FAFR004: Financial Advisor (Configure Analysis Parameters)" as FAFR004
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "AIFR008: Generate Predictive Intervention Recommendations for Advisors" as AIFR008

  client --> FAFR002 : "Client"
  sysAdmin --> SAFR001 : "System Administrator"
}

rectangle "AI System Role" {
  actor "AIFR009: AI (Generate Client Predictive Insights)" as AIFR009
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003

  client --> AIFR008 : "Client"
}

rectangle "User Feedback Role" {
  actor "CFR011: User (Send Feedback)" as CFR011
  usecase "SFR020: Manage User Feedback"

  userFeedback --> SFR020 : "User"
}
@enduml