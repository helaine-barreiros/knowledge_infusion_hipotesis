@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "SFR004: Request Financial Predictions from AI" as SFR004
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "SFR009: Request Contextualized News from AI" as SFR009
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  usecase "CFR010: Manage Relationship with Advisors" as CFR010
  usecase "SFR013: Deliver Client Alerts Based on Conditions" as SFR013
  usecase "AIFR005: Generate Investment Opportunities for Users" as AIFR005
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "SFR007: Request Specific Investment Opportunities from AI" as SFR007
  usecase "AIFR006: Generate Contextualized News Insights for Users" as AIFR006
}

actor "Client" as Client {
  --> CFR001 : View Financial Dashboard
  --> CFR002 : Receive Alerts (FATF)
  --> CFR003 : View Predictions
  --> CFR004 : Personalized Recommendations
  --> CFR005 : Manage Preferences
  --> CFR006 : Spending Limit Alerts
  --> CFR007 : Investment Opportunities
  --> CFR008 : News Related to Portfolio
  --> CFR010 : Manage Relationship with Advisors
}

actor "Financial Advisor" as FA {
  --> FAFR002 : View Client Intervention Alerts
  --> FAFR003 : Predictive Analytics for Clients
  --> AIFR005: Generate Investment Opportunities for Users (via SFR)
}

actor "System Administrator" as SysAdmin {
  --> SAFR001 : Manage Analysis Parameters
}

actor "AI System" as AI {
  <|-- AIFR002: Generate Personalized Recommendations (from Client)
  <|-- AIFR003: Generate Spending Limit Alerts (via SFR)
  <|-- AIFR004: Analyze Investment Opportunities for Users (via SFR)
  <|-- AIFR005: Identify Suitable Investments Based on Profiles
  <|-- AIFR006: Detect Anomalies in Transactions (AML compliance via SFR)
  <|-- AIFR007: Extract News Insights Relevant to Portfolios (from SFR)
}

actor "System" as Sys {
  --> CFR011 : Send Feedback for Improvement
}
@enduml