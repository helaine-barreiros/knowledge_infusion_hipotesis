@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C1, C2, C3
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts Exceeding Predefined Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidated Personalized Dashboard for Financial Monitoring" as CFR009
  usecase "CFR10: Manage Relationship with Advisors, Including Data Sharing Permissions" as CFR10

  C1 -> CFR001 : View dashboard
  C2 -> CFR002 : Receive alerts on transactions
  C3 -> CFR003 : Predictions based on data and trends
}

package "Financial Advisor (FA)" {
  actor FinancialAdvisor as F1, F2
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Clients" as FAFR002
  usecase "FAFR003: View Predictive Analytics on Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004

  F1 -> FAFR001 : Manage sessions
  F2 -> FAFR002 : View alerts for clients
}

package "System Administrator (SA)" {
  actor SysAdmin
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001

  SysAdmin -> SAFR001 : Configure parameters
}

system boundary rectangle "Financial Insights System" {
  
}
@enduml