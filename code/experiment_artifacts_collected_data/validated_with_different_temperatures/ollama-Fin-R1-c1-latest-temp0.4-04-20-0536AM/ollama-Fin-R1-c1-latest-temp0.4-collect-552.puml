@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor FinancialAdvisor as fa
actor SysAdmin as sa
system "System" as s

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Personalized Recommendations Based on Profile" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Spent Limit Alerts for Budget Control" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidated Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10

  c1 --> CFR001 : View dashboard
  c1 --> CFR002 : Receive alerts
  c1 --> CFR003 : Predictions
  c1 --> CFR004 : Recommendations based on profile
  c1 --> CFR005 : Manage preferences
  c1 --> CFR006 : Spent limit alerts
  c1 --> CFR007 : Investment opportunities
  c1 --> CFR008 : News related to portfolio
  c1 --> CFR009 : Consolidated dashboard
  c1 --> CFR10 : Manage relationship

}

rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Clients" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004

  fa --> FAFR001 : Manage sessions
  fa --> FAFR002 : View alerts
  fa --> FAFR003 : Predictive analytics
  fa --> FAFR004 : Configure parameters
}

rectangle "System Administrator Interface" {
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001

  sa --> SAFR001 : Manage params
}

system s {
  
  include "Client Interface"
  include "Financial Advisor Interface"
  include "System Administrator Interface"

  // Relationships between system and use cases
  s <|-- CFR001: Delivers insights via client interface
  s <|-- CFR002: Sends alerts through appropriate channels (SFR008)
  s <|-- CFR003: Requests predictions from AI component (AIFR001)
  s <|-- CFR004: Generates recommendations using AIFR002
  s <|-- CFR005: Manages preferences via client interface
  s <|-- CFR006: Sends spent limit alerts through SFR008
  s <|-- CFR007: Analyzes investments with AI (AIFR004)
  s <|-- CFR008: Fetches news from AIFR009
  s <|-- CFR009: Generates consolidated dashboards via client interface
  s <|-- CFR10: Manages relationships through client interface

  s <|-- FAFR001: Provides mentoring insights (via client or advisor)
  s <|-- FAFR002: Sends alerts to advisors (SFR008)
  s <|-- FAFR003: Analyzes clients' data with AI (AIFR007, AIFR009)
  s <|-- FAFR004: Configures parameters via system admin interface

  s <|-- SAFR001: Manages analysis params for AI
}
@enduml