@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor FinancialAdvisor as fa
actor SysAdmin as sa
system "System" as sys

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Trends" as CFR003
  usecase "CFR004: Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Investment Portfolio" as CFR008
  usecase "CFR009: View Consolidated Financial Information in a Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors Including Data Sharing Permissions" as CFR10

  c1 --> CFR001 : "View financial insights"
  c1 --> CFR002 : "Receive alerts for anomalous transactions"
  c1 --> CFR003 : "View predictions based on data and trends"
  c1 --> CFR004 : "Get personalized recommendations aligned with profile"
  c1 --> CFR005 : "Manage recommendation preferences"
  c1 --> CFR006 : "Receive spending limit alerts"
  c1 --> CFR007 : "Access investment opportunities based on risk profile"
  c1 --> CFR008 : "View portfolio-related news"
  c1 --> CFR009 : "Use consolidated dashboard"
  c1 --> CFR10 : "Manage relationship with advisors"

}

rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: Review Predictive Analytics About Clients' Financial Situations" as FAFR003

  fa --> FAFR001 : "Manage mentoring sessions"
  fa --> FAFR002 : "View intervention alerts"
  fa --> FAFR003 : "Review predictive analytics"

}

rectangle "System Administrator Interface" {
  usecase "SAFR001: Manage Analysis Parameters for AI System Compliance with Basel III and Other Regulations" as SAFR001

  sa --> SAFR001 : "Manage analysis parameters"
}

system sys <<includes>> CFR001, CFR002, ..., CFR10; FAFR001-3; SAFR001

@enduml