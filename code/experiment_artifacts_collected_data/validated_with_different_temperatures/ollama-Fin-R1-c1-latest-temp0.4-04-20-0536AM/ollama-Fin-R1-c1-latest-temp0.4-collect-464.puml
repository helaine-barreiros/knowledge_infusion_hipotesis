@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage AML Alerts" as SAFR002
  usecase "SFR003: Request Predictive Analytics from AI" as SFR003
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007

  Client --> CFR001 : View Financial Dashboard  
  SysAdmin -> SAFR002 : Manage Alerts  
  FAFR001 -->> SFR003 : Configure Analysis Parameters for Clients
  System --> AIFR007 : Generate News Insights Based on Portfolio
  
  // Relationships between components within the system boundary
  rectangle "AI Component" {
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003

    SFR002 <|-- SAFR001 : Manage Parameters  
    AIFR007 --> CFR008 : Deliver News Related to Portfolio  

  }
}

@enduml