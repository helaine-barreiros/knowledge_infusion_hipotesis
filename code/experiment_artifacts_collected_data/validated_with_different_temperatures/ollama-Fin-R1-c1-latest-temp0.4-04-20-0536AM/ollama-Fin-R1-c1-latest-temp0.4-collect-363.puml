@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004

  user --> CFR001 : "Client"
  SysAdmin --> SAFR001 : "System Administrator"
}

rectangle "Financial Advisor" {
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003

  user --> FAFR002 : "Client"
}

rectangle "System (SFR)" {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR007: Request Investment Opportunity Analysis from AI Component" as SFR007

  SysAdmin --> SAFR001 : "Manage analysis parameters"
}

rectangle "AI System (AIFR)" {
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003

  SFR --> AIFR003 : "Request spending limit alerts"
}

rectangle "Client (CFR)" {
  usecase "CFR011: Send Feedback to System" as CFR011
}
@enduml