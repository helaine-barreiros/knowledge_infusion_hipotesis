@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR004: Get Personalized Financial Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Portfolio" as CFR008
  usecase "CFR009: View Consolidated Financial Dashboard" as CFR010
  usecase "SFR003: Request Predictive Analysis from AI Component" as SFR003
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  usecase "CFR011: Send Feedback to Improve System Outputs" as CFR011

  actor Client as client
  actor FinancialAdvisor as advisor
  actor SysAdmin as sysadmin
  
  
  client --> CFR001 : View financial insights dashboard.
  client --> CFR002 : Receive alerts on anomalous transactions.
  client --> CFR004 : Get personalized recommendations.
  client --> SAFR001 : Manage analysis parameters (for Sys Admin).
  advisor --> FAFR003 : View predictive analytics for clients.
  sysadmin --> SAFR001 : Manage system's analysis parameters.
  
  // System components
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002 <|-- AIFR002
  
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007 <|-- SFR019 : Extract relevant info for user's portfolio.
  
  usecase "SFR003: Request Predictive Analysis from AI Component" as SFR003 <|-- AIFR002
  usecase "AIFR008: Generate Client Intervention Recommendations" as AIFR008 <|-- FAFR004 : Interventions based on system-generated insights.
  
  usecase "SFR015: Request Predictive Insights from AI Component" as SFR015 <|-- AIFR009
}

@enduml