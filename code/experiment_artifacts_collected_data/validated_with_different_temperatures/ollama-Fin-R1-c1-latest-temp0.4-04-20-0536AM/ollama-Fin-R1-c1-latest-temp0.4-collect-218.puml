@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  Client --> CFR001 : "View financial data, predictions, and recommendations"
  
  SysAdmin --> (SFR020) <|-- (CFR005) : "Manage user preferences for personalized recommendations"

  usecase "CFR002: View Alerts" as CFR002
  Client --> CFR002 : "View alerts about anomalous transactions and spending limits"
  
  SysAdmin --> SAFR008 <|-- (SFR013) : "Manage alert generation parameters for the system"

  usecase "CFR003: View Financial Predictions" as CFR003
  Client --> CFR003 : "View forward-looking financial insights"
  
  SysAdmin --> SAFR008 <|-- (SFR014) : "Manage prediction generation parameters for the system"

  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  Client --> CFR004 : "Get tailored advice based on financial profile"
  
  SysAdmin --> SAFR008 <|-- (SFR015) : "Manage recommendation generation parameters for the system"

  usecase "CFR006: View Spending Limit Alerts" as CFR006
  Client --> CFR006 : "Receive notifications when spending exceeds thresholds"
  
  SysAdmin --> SAFR008 <|-- (SFR013) : "Manage alert generation parameters for the system"

  usecase "CFR007: View Investment Opportunities" as CFR007
  Client --> CFR007 : "Explore investment options aligned with risk profile"
  
  SysAdmin --> SAFR008 <|-- (SFR016) : "Manage opportunity analysis parameters for the system"

  usecase "CFR008: View News" as CFR008
  Client --> CFR008 : "Stay informed about market events affecting investments"
  
  SysAdmin --> SAFR008 <|-- (SFR017) : "Manage news extraction parameters for the system"

  usecase "CFR009: Access Personalized Dashboard" as CFR009
  Client --> CFR009 : "Consolidate financial information in one place"
  
  SysAdmin --> SAFR008 <|-- (SFR012) : "Manage dashboard generation parameters for the system"

  usecase "CFR010: Manage Relationship with Advisors" as CFR010
  Client --> CFR010 : "Control data sharing and permissions"
  
  SysAdmin --> SAFR008 <|-- (SFR019) : "Manage user feedback parameters for the system"

  usecase "CFR011: Send Feedback" as CFR011
  User --> CFR011 : "Provide input to improve system accuracy and relevance"
  
  SysAdmin --> SAFR008 <|-- (SFR020) : "Manage feedback processing parameters for the system"

}

@enduml