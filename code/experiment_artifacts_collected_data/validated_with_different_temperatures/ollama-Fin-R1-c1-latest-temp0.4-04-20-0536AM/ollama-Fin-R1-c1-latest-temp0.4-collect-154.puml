@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Alert Preferences" as SAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Manage Relationship with Financial Advisors" as CFR009

  rectangle "Client (User)" {
    actor Client as C1
    client --> CFR001 : View financial data in a dashboard.
    client --> SAFR002 : Adjust alert settings for transactions and spending limits.
    client --> CFR003 : See future projections based on history and trends.
    client --> CFR004 : Get tailored advice aligned with personal goals.
    client --> CFR005 : Customize recommendation preferences per KYC info.
    client --> CFR006 : Monitor budget by tracking expense category limits.
    client --> CFR007 : Explore investment options matching risk profile.
    client --> CFR008 : Stay informed about market events affecting assets.
    client --> CFR009 : Control data sharing with advisors for privacy.

  }

  rectangle "System Administrator" {
    actor SysAdmin as SA1
    sysadmin --> SAFR002 : Set up system-wide parameters like compliance rules.
  }

  rectangle "Financial Advisor (FA)" {
    actor FinancialAdvisor as FA1
    fa --> FAFR001: Schedule mentoring sessions using AI insights.
    fa --> FAFR002: Act on client alerts from the system.
    fa --> FAFR003: Review predictive analytics for clients during consultations.
    fa --> FAFR004: Adjust analysis parameters tailored to specific segments.

  }

  rectangle "System (SFR)" {
    usecase "SFR012: Generate Client Dashboards" as SFR012
    usecase "SFR013: Send Alerts Based on Conditions" as SFR013
    usecase "SFR014: Provide Financial Analytics" as SFR014

  }

  rectangle "AI System (AIFR)" {
    usecase "AIFR001: Generate Predictions" as AIFR001
    usecase "AIFR002: Personalized Recommendations" as AIFR002
    usecase "AIFR003: Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Investment Opportunity Analyses" as AIFR004

  }

}

@enduml