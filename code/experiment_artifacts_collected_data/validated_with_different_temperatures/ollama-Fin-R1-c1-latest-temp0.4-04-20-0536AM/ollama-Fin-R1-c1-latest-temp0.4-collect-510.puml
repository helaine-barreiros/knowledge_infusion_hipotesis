@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  // Clients (User)
  actor "Client" as client {
    client --> CFR001 : View Financial Insights Dashboard
    client --> SFR013 : Generate Alerts Based on Predefined Conditions
    client --> AIFR007 : Receive Contextualized News Insights
    client --> AIFR009 : Get Client Predictive Intervention Recommendations
  }
  
  // System Administrator (SysAdmin)
  actor "System Administrator" as sysadmin {
    sysadmin --> SAFR001 : Manage Analysis Parameters for AI Systems
  }
  
  // Financial Advisor (FA)
  actor "Financial Advisor" as fa {
    fa --> FAFR004 : Configure Analysis Parameters for Client Segments
    fa --> AIFR008 : Generate Predictive Intervention Recommendations
    fa --> SFR012 : Manage User Dashboards
    fa --> CFR011 : Send Feedback to System
  }
  
  // AI Systems (AIS)
  actor "AI System" as ais {
    client --> AIS001: AIFR001 - Generate Financial Predictions
    client --> AIS002: AIFR002 - Personalized Recommendations
    client --> AIS003: AIFR003 - Spending Limit Alerts
    client --> AIS004: AIFR005 - Investment Opportunity Analyses
    client --> AIS006: AIFR007 - Contextualized News Insights
    client --> AIS008: AIFR009 - Client Predictive Interventions
  }
  
  // System (Sys)
  actor "System" as sys {
    sys --> SFR012 : Generate User Dashboards
    sys --> SFR013 : Manage Alerts Based on Predefined Conditions
    sys --> SFR014 : Provide Client Analytics
    sys --> AIFR008: Predictive Insights for Advisors
  }
  
}

@enduml