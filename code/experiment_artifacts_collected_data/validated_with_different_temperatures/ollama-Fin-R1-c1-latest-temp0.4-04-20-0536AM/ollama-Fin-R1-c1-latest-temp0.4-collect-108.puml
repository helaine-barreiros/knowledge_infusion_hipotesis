@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Anomaly Detection Rules" as SAFR002
  usecase "FAFR005: Schedule Client Mentoring Sessions" as FAFR005
  usecase "SFR003: Request Financial Predictions from AI" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
  usecase "SFR006: Request Spending Limit Alerts from AI" as SFR006
  usecase "SFR007: Request Investment Opportunity Analysis from AI" as SFR007
  usecase "SFR008: Request Specific Investment Opportunities from AI" as SFR008
  usecase "SFR009: Request Anomaly Transaction Alerts from AI" as SFR009
  usecase "SFR010: Find Contextualized News Relevant to Portfolio" as SFR010
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "AIFR003: Identify Unusual Spending Patterns for Alerts" as AIFR003

  actor "Client" as C
  actor "Financial Advisor (FA)" as FA
  actor "System Administrator (SA)" as SA
  actor "AI System" as AI
  
  C --> CFR001 : View financial insights dashboard  
  C --> SFR009 : Request anomaly transaction alerts  
  C --> SFR012 : Generate client dashboards  

  FA --> FAFR005 : Schedule mentoring sessions  
  FA --> AIFR007 : Find contextualized news for portfolio  

  SA --> SAFR002 : Manage analysis parameters (AML, FATF)  
  SA --> SAFR001 : Manage AI system's compliance settings  

  AI --> SFR003 : Generate financial predictions  
  AI --> AIFR004 : Generate investment opportunities  
  AI --> AIFR005 : Generate personalized recommendations  
  AI --> AIFR006 : Generate spending limit alerts  
  AI --> AIFR007 : Find contextualized news insights  

  SFR003 <|-- (AIFR001)  
  SFR004 <|-- (AIFR005)  
  SFR006 <|-- (AIFR003)  
  SFR008 <|-- (AIFR004)  
  SFR009 <|-- (AIFR006)
}

@enduml