@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure Analysis Params for Client Segments" as FAFR004

  client --> CFR001 : View Financial Insights
  SysAdmin --> SAFR001 : Manage AI System Settings
  Advisor --> FAFR004 : Customize AI Behavior per Client Segment
  
}

rectangle "Client Interface" {
  actor Client as c1
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Get Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Monitor Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Use Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10

  c1 --> CFR002 : Receive Alerts
  c1 --> CFR003 : View Predictions
  c1 --> CFR004 : Get Recommendations
  c1 --> CFR005 : Adjust Preferences
  c1 --> CFR006 : Check Spending Limits
  c1 --> CFR007 : Explore Investments
  c1 --> CFR008 : Read News
  c1 --> CFR009 : Use Dashboard
  c1 --> CFR10 : Manage Advisors

}

rectangle "Advisor Interface" {
  actor Advisor as a2
  usecase "FAFR001: Schedule Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: Review Predictive Analytics for Clients" as FAFR003

  a2 --> FAFR001 : Schedule Sessions
  a2 --> FAFR002 : Check Interventions
  a2 --> FAFR003 : Analyze Client Data

}

rectangle "System Admin Interface" {
  actor SysAdmin as sas
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  sas --> SAFR001 : Adjust Settings

}
@enduml