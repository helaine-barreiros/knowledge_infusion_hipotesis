@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  usecase "SFR009: Request Anomaly Transaction Alerts from AI Component" as SFR009
  usecase "AIFR006: Generate Contextualized News Insights Based on Portfolio" as AIFR006

  Client --> CFR001 : View Financial Dashboard  
  SysAdmin --> SAFR001 : Manage Analysis Parameters  
  FAFR004 <|-- (SAFR001) : Extends System Admin's role in parameter management for client segments  

  rectangle "Client" {
    actor "User" as User
    usecase "CFR002: View Alerts About Anomalous Transactions" as CFR002  
    usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003  
    usecase "CFR004: Receive Personalized Recommendations Aligned with Financial Goals" as CFR004  
    usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005  
    usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006  
    usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007  
    usecase "CFR008: Receive News Related to Portfolio" as CFR008  
    usecase "CFR010: Manage Relationship with Financial Advisors, Including Data Sharing Permissions" as CFR010  

    User --> (SFR009) : Receives Anomaly Alerts from System  
  }

  rectangle "Financial Advisor" {
    actor "FAFR002: View Client Intervention Alerts" as FAFR002
    usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003  
    usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004  

    SysAdmin --> (SAFR001) : Manages System-Wide Analysis Params
  }

  rectangle "System Administrator" {
    actor "SysAdmin" as SysAdmin  
    usecase "CFR009: Access Personalized Dashboard for Consolidated Financial Info" as CFR009  

    SysAdmin --> (SAFR001) : Manages System-Wide Analysis Params
  }

  rectangle "AI Component" {
    actor "AIFR008: Generate Client Predictive Interventions Based on Patterns" as AIFR008  
    usecase "CFR011: Send Feedback to Improve Recommendations and Insights" as CFR011  

    SysAdmin --> (SAFR001) : Manages System-Wide Analysis Params
  }

  rectangle "News Source Integration" {
    actor "SFR009: Request Contextualized News for Portfolio" as SFR009  
    usecase "AIFR007: Generate Contextualized News Insights Based on Portfolio" as AIFR007  

    SysAdmin --> (SAFR001) : Manages System-Wide Analysis Params
  }

}

@enduml