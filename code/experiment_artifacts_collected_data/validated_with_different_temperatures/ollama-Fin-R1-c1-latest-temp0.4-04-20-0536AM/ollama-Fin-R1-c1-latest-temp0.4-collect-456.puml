  cClient -> CFR009 : "Manage Relationship with Financial Advisors"

  fAdvisor -> FAFR001 : "Manage Client Mentoring Sessions Based on Insights"
  fAdvisor -> FAFR002 : "View Client Intervention Alerts"
  fAdvisor -> FAFR003 : "View Predictive Analytics for Clients"
  
  sAdmin -> SAFR001 : "Manage Analysis Parameters"

}

@enduml