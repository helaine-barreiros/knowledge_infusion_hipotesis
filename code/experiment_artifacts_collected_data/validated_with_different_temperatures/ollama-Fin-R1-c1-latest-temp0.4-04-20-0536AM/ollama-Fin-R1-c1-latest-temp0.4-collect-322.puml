@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Data and Trends" as CFR003
  usecase "CFR004: Get Personalized Recommendations Aligned with Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts Exceeding Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Manage Relationship with Financial Advisors" as CFR009

  SysAdmin --> SAFR001 : Configure analysis parameters for compliance.

  rectangle "Financial Advisor" {
    usecase "FAFR001: Schedule Client Mentoring Sessions Based on Insights" as FAFR001
    usecase "FAFR002: View Intervention Alerts for Proactive Assistance" as FAFR002
    usecase "FAFR003: Review Predictive Analytics to Guide Consultations" as FAFR003
  }

  rectangle "Client" {
    CFR001 --> Client : Display financial data.
    CFR002 --> Client : Notify of suspicious transactions.
    CFR003 --> Client : Present forecasts and trends.
    CFR004 --> Client : Offer tailored advice.
    CFR005 --> Client : Adjust recommendation settings.
    CFR006 --> Client : Alert on overspending in categories.
    CFR007 --> Client : Recommend investments aligned with risk profile.
    CFR008 --> Client : Share portfolio-related news updates.
  }

  SysAdmin <|-- SAFR001 : Manage system parameters.

  rectangle "System" {
    SFR001: Deliver alerts via channels
    SFR002: Provide personalized recommendations
    SFR003: Request financial predictions from AI
    SFR004: Request recommendations based on user data and preferences
    SFR005: Monitor spending limits for alerts
    SFR006: Analyze investments against risk profiles
    SFR007: Identify ESG-compliant investment opportunities
    SFR008: Detect AML-related anomalies
    SFR009: Extract portfolio-relevant news insights
    SFR010: Generate client dashboards with financial info.
    SFR012: Create client alerts based on conditions
  }

  rectangle "AI" {
    AIFR001: Forecast future transactions and market trends
    AIFR002: Personalize recommendations using user data
    AIFR003: Flag spending patterns that exceed limits
    AIFR004: Suggest investments matching risk profiles
  }

  SysAdmin --> Client : Manage client relationships (permissions, sharing).
  
  CFR011: Send feedback to improve system.
}

@enduml