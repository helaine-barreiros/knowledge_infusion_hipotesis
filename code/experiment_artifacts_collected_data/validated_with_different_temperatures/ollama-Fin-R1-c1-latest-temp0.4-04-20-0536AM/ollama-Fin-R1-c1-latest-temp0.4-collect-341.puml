@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "SFR012: Generate Client Dashboards" as SFR012

  Client --> CFR001 : "View Financial Insights"
  SysAdmin -> SAFR001 : "Manage Analysis Parameters"

  rectangle "Client Interface" {
    actor Client as c
  }
  
  rectangle "System Administrator Interface" {
    actor SystemAdministrator as sa
  }

  Client -- (c) --> CFR001: "View Financial Insights"
  SysAdmin -- (sa) -> SAFR001 : "Manage Analysis Parameters"

}

@enduml