@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Personalized Recommendations Based on Profile" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Spent Limit Alerts for Budget Control" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidated Personalized Dashboard for Monitoring Finances" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10

  Client --> CFR001 : View dashboard\nClient --> CFR002 : Receive alerts\nClient --> CFR003 : Predictions based on data and trends\nClient --> CFR004 : Personalized recommendations aligned to goals\nClient --> CFR005 : Manage preferences for relevance\nClient --> CFR006 : Spent limit alerts when exceeding thresholds\nClient --> CFR007 : Investment opportunities matching risk profile\nClient --> CFR008 : Portfolio-related news updates\nClient --> CFR009 : Consolidated view of finances\nClient --> CFR10 : Control data sharing with advisors
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: Review Predictive Analytics to Guide Consultations" as FAFR003

  FinancialAdvisor --> FAFR001 : Schedule and manage mentoring\nFinancialAdvisor --> FAFR002 : Monitor alerts for client issues\nFinancialAdvisor --> FAFR003 : Use predictive data in consultations
}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001

  SysAdmin --> SAFR001 : Configure parameters to ensure accuracy and compliance\nSysAdmin <|-- (Client) : Monitor system performance from admin perspective\nSysAdmin <|-- (FinancialAdvisor) : Ensure advisors have access to necessary data
}

rectangle "System" {
  usecase "SFR001: Deliver Alerts Through Notification Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AI" as SFR004
  usecase "SFR005: Request Spending Limit Alerts From AI" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
  usecase "SFR007: Request Specific Investments Based on Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts From AI" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Portfolio" as SFR009
  usecase "SFR010: Process Contextualized News for User Insights" as SFR010
  usecase "SFR011: Request AI-Generated Client Alerts Based on Predefined Conditions" as SFR011
  usecase "SFR012: Generate Financial Dashboards" as SFR012
  usecase "SFR013: Generate Client-Specific Analytics for Insights" as SFR013
  usecase "SFR014: Request Predictive Intervention Analyses From AI" as SFR014
  usecase "SFR015: Manage Users' Financial Goals and Progress Tracking" as SFR015
  usecase "SFR016: Maintain Historical Record of Insights for Trend Analysis" as SFR016

  System --> (CFR002) : Deliver alerts\nSystem --> CFR004, CFR007, CFR008, CFR009, CFR10 : Generate recommendations and insights\nto clients\nSystem <|-- SAFR001 : Monitor parameter settings for compliance\nSystem <|-- FAFR003 : Provide predictive analytics to advisors
}

rectangle "AI System" {
  usecase "AIFR001: Generate Financial Predictions Based on Data & Trends" as AIFR001
  usecase "AIFR002: Personalized Recommendations Aligning with Profiles and Goals" as AIFR002
  usecase "AIFR003: Spent Limit Alerts for Budget Control" as AIFR003
  usecase "AIFR004: Investment Opportunity Analyses Based on Risk Profile" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Matching Strategies and MPT Principles" as AIFR005
  usecase "AIFR006: Anomaly Transaction Alerts for Fraud Detection" as AIFR006
  usecase "AIFR007: Contextualized News Insights Correlated with Portfolios" as AIFR007
  usecase "AIFR008: Client Predictive Intervention Recommendations Based on Patterns" as AIFR008
  usecase "AIFR009: Generate Client-Specific Predictive Analytics for Financial Planning" as AIFR009

  AI --> (CFR001, CFR003) : Provide data-driven insights\nAI <|-- SFR002, SFR004, SFR005, SFR006, SFR007, SFR008, SFR009, SFR10: Generate components of system's output\nAI --> FAFR003 : Support advisors with predictive data
}

@enduml