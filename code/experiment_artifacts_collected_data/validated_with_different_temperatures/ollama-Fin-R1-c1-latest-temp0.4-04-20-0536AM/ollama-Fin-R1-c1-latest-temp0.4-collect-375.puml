@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "SFR019: Maintain Historical Record of Insights" as SFR019
  
  Client --> CFR001 : "View financial data in a comprehensive format"
  SysAdmin -> SAFR001 : "Manage analysis parameters for the AI system"
  
  Client -->> FAFR002 : "Receive alerts about anomalous transactions (FATF regulations)"
  Client -->> CFR003 : "Access future financial trends and market impacts"
  Client -->> CFR004 : "Get tailored investment advice based on profile"
  Client -->> SFR019 : "Track system performance over time"

  SysAdmin --> SAFR001 : "Adjust AI parameters for compliance (Basel III)"
}

@enduml