@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage System Alerts" as SAFR002
  
  Client --> CFR001 : "View financial data, alerts"
  
  SysAdmin -> SAFR002 : "Configure system parameters (e.g., thresholds)"
}

rectangle "Financial Advisor" {
  actor FAFR001 as FAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  
  SysAdmin -> SAFR002 : "Set analysis parameters by client segment"
  
  FAFR001 --> FAFR003 : "Review predictive analytics, provide guidance"
}

rectangle "Client" {
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  
  Client --> CFR004 : "Get recommendations based on profile"
  
  SysAdmin -> SAFR002 : "Adjust recommendation parameters (e.g., risk tolerance)"
}

rectangle "System Administrator" {
  actor SysAdmin as SysAdmin
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SysAdmin --> SAFR001 : "Set system-wide analysis rules"
  
  SysAdmin -> CFR005 : "Update client preferences in KYC profile"
}

rectangle "Financial Advisor (Client)" {
  actor FAFR002 as FAFR002
  usecase "FAFR004: Configure Client-Specific Analysis Parameters" as FAFR004
  
  SysAdmin -> SAFR001 : "Customize parameters for specific clients"
  
  FAFR002 --> FAFR004 : "Set client-specific rules (e.g., thresholds, risk profiles)"
}

rectangle "System" {
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  
  SysAdmin -> SAFR002 : "Define prediction models"
  
  Client --> CFR004 : "Request personalized recommendations (triggers SFR003)"
}

rectangle "Client Alerts System" {
  usecase "SFR006: Request Spending Limit Alerts" as SFR006
  usecase "AIFR003: Generate Spent Limit Alerts" as AIFR003
  
  SysAdmin -> SAFR002 : "Set spending limit thresholds"
  
  Client --> CFR005 : "Manage personalization (triggers SFR006)"
}

rectangle "Investment Opportunities System" {
  usecase "SFR011: Request Specific Investment Ideas" as SFR011
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  
  SysAdmin -> SAFR002 : "Define investment criteria"
  
  Client --> CFR007 : "View suitable investments (triggers SFR011)"
}

rectangle "Anomaly Detection System" {
  usecase "SFR008: Request Anomaly Transaction Alerts" as SFR008
  usecase "AIFR006: Generate Anomaly Alerts" as AIFR006
  
  SysAdmin -> SAFR002 : "Configure detection rules"
  
  Client --> CFR010 : "Manage data sharing (triggers SFR008)"
}

rectangle "News System" {
  usecase "SFR009: Request Contextualized News" as SFR009
  usecase "AIFR007: Generate News Insights" as AIFR007
  
  SysAdmin -> SAFR002 : "Set news sources and filters"
  
  Client --> CFR008 : "View relevant financial news (triggers SFR009)"
}

rectangle "Client Dashboard System" {
  usecase "SFR12: Generate Consolidated Dashboards" as SFR12
  usecase "AIFR005: Analyze Spending Patterns" as AIFR005
  
  SysAdmin -> SAFR002 : "Define dashboard components"
  
  Client --> CFR009 : "Access consolidated view (triggers SFR12)"
}

rectangle "Client Relationship Management System" {
  usecase "CFR010: Manage Data Sharing with Advisors" as CFR010
  
  SysAdmin -> SAFR002 : "Set permissions for data sharing"
  
  Client --> CFR010 : "Request access, manage shares (triggers SFR13)"
}

rectangle "User Feedback System" {
  usecase "CFR11: Send User Feedback" as CFR11
  
  SysAdmin -> SAFR002 : "Track and analyze feedback"
  
  Client --> CFR11 : "Provide input on system outputs"
}
@enduml