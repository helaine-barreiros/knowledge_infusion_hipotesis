@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Data and Trends" as CFR003
  usecase "CFR004: Personalized Recommendations Aligned with Profile" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts for Budget Control" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidated Personalized Dashboard for Monitoring" as CFR010
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: Review Predictive Analytics About Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004

  rectangle "Client" {
    actor "User (Client)" as UserClient
    userClient --> CFR001 : "View Financial Insights Dashboard"
    userClient --> CFR002 : "Receive Alerts on Anomalous Transactions"
    userClient --> CFR003 : "View Financial Predictions Based on Data and Trends"
    userClient --> CFR004 : "Personalized Recommendations Aligned with Profile"
    userClient --> CFR005 : "Manage Recommendation Preferences"
    userClient --> CFR006 : "View Spending Limit Alerts for Budget Control"
    userClient --> CFR007 : "Access Investment Opportunities Based on Risk Profile"
    userClient --> CFR008 : "Receive News Related to Portfolio"
    userClient --> CFR009 : "Consolidated Personalized Dashboard for Monitoring"
  }

  rectangle "Financial Advisor" {
    actor "User (Financial Advisor)" as UserFA
    UserFA --> FAFR001 : "Manage Client Mentoring Sessions Based on Insights"
    UserFA --> FAFR002 : "View Client Intervention Alerts for Proactive Assistance"
    UserFA --> FAFR003 : "Review Predictive Analytics About Clients' Financial Situations"
    UserFA --> FAFR004 : "Configure Analysis Parameters by Client Segment"
  }

  rectangle "System Administrator" {
    actor "User (SysAdmin)" as SysAdmin
    SysAdmin --> SAFR001 : "Manage Analysis Parameters for AI System"
  }
}

@enduml