@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  // Clients (Users)
  actor "Client" as client {
    client --> CFR001 : View Financial Insights Dashboard
    client --> SFR013 : Receive Alerts Based on Predefined Conditions
    client --> SFR012 : Access Personalized Dashboards
    client --> AIFR009 : Send Feedback to Improve System Outputs
  }
  
  // Financial Advisors (FA)
  actor "Financial Advisor" as fa {
    fa --> FAFR003 : View Predictive Analytics for Clients
    fa --> FAFR002 : Manage Client Intervention Alerts
    fa --> AIFR008 : Receive Predictive Interventions Recommendations
  }
  
  // System Administrators (SysAdmin)
  actor "System Administrator" as sysadmin {
    sysadmin --> SAFR001 : Manage Analysis Parameters for AI Algorithms
    sysadmin --> FAFR004 : Configure Client-Specific Analysis Settings
  }

  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR005: Generate Investment Opportunities Based on Risk Profiles" as AIFR005

  client --> SFR002 : Receive Personalized Financial Advice
  fa --> AIFR005 : Request Suitable Investments for Client Segments
}

@enduml