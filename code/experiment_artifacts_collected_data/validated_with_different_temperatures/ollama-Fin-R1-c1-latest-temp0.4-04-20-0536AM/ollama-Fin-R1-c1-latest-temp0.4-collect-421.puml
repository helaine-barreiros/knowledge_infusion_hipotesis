@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR009: Generate Client Alerts Based on Predefined Conditions" as SFR009
  usecase "CFR002: View Alerts About Anomalous Transactions" as CFR002
  usecase "AIFR006: Generate Anomaly Transaction Alerts for Users" as AIFR006

  Client --> CFR001 : "View Financial Insights"
  Client --> SFR009 : "Receive Predefined Condition Alerts"
  Client --> CFR002 : "Review Anomalous Transactions"
  
  SysAdmin --> SAFR001 : "Manage Analysis Parameters"

  // Relationships between components
  AIFR006 <|-- (SAFR001) : Extends

}

@enduml