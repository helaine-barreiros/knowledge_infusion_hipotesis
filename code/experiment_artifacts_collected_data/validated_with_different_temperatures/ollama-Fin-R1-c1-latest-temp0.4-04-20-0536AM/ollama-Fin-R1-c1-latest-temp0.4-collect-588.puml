  Client --> CFR001 : "View Financial Insights Dashboard"
  
  SysAdmin --> SAFR001 : "Manage Analysis Parameters"

  FAFR003 <|-- (Client) : "View Predictive Analytics about Clients' Finances"
  SFR002 <|-- (Client, Advisor) : "Deliver Personalized Recommendations to Users"
  AIFR004 <|-- (Advisor) : "Generate Investment Opportunity Analyses for Users"

}

@enduml