@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  client --> CFR001 : "View Financial Insights Dashboard"
  
  SysAdmin --> SAFR001 : "Manage System Analysis Parameters"
  SysAdmin --> FAFR004 : "Configure Analysis Parameters for Specific Client Segments"
}

rectangle "Client" {
  actor "User (Client)" as U
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  U --> CFR002 : "Receive Alerts"
  U --> CFR003 : "View Predictions"
  U --> CFR004 : "Get Recommendations"
  U --> CFR005 : "Manage Preferences"
  U --> CFR006 : "Spending Limit Alerts"
  U --> CFR007 : "Investment Opportunities"
  U --> CFR008 : "News Related to Portfolio"
  U --> CFR009 : "Personalized Dashboard"
  U --> CFR10 : "Manage Relationship with Advisors"

}

rectangle "Financial Advisor" {
  actor "FA (Advisor)" as FA
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters" as FAFR004
  
  FA --> FAFR001 : "View Client Intervention Alerts"
  FA --> FAFR002 : "Predictive Analytics"
  FA --> FAFR003 : "Configure Analysis Params for Clients"

}

rectangle "System Administrator" {
  actor "SysAdmin" as SA
  usecase "SAFR001: Manage System Parameters" as SAFR001
  
  SA --> SAFR001 : "Manage System Parameters"
  
}
@enduml