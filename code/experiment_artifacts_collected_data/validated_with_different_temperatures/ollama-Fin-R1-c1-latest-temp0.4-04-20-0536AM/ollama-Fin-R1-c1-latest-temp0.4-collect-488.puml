@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR004: Get Personalized Financial Recommendations" as CFR004
  usecase "SAFR006: Manage Recommendation Preferences for Clients" as SAFR006
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "CFR005: View Spending Limit Alerts When Exceeding Thresholds" as CFR005
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
  usecase "SFR007: Request Specific Investment Opportunities Matching User Criteria and ESG Preferences" as SFR007
  usecase "CFR012: View Consolidated Financial Information in a Single Dashboard" as CFR012
  usecase "AIFR003: Generate Spending Limit Alerts for Unusual Deviations from Established Patterns" as AIFR003
  usecase "SFR008: Request Anomaly Transaction Alerts to Detect Potentially Fraudulent Activities" as SFR008
  usecase "CFR014: View Financial Health Reports Based on Standard Ratios and Metrics" as CFR014
  usecase "AIFR007: Generate Contextualized News Insights Correlated with User Portfolios" as AIFR007
  usecase "SFR020: Manage Historical Record of Users' Financial Insights for Trend Analysis" as SFR020

  
  actor Client as c1
  actor SystemAdministrator as sa
  actor FinancialAdvisor as fa
  
  c1 --> CFR001 : "View Financial Insights Dashboard"
  c1 --> CFR002 : "Receive Alerts on Anomalous Transactions"
  c1 --> CFR004 : "Get Personalized Financial Recommendations"
  c1 --> SAFR006 : "Manage Recommendation Preferences for Clients"
  c1 --> SFR013 : "Generate Client Alerts Based on Predefined Conditions"
  c1 --> CFR005 : "View Spending Limit Alerts When Exceeding Thresholds"
  c1 --> AIFR004 : "Get Investment Opportunity Analyses"
  c1 --> SFR007 : "Request Specific Investment Opportunities Matching User Criteria and ESG Preferences"
  c1 --> CFR012 : "View Consolidated Financial Information in a Single Dashboard"
  c1 --> CFR014 : "View Financial Health Reports Based on Standard Ratios and Metrics"
  
  sa --> SAFR001 : "Manage Analysis Parameters for the AI System"
  
  fa --> FAFR003 : "View Predictive Analytics for Clients"
  fa --> SFR020 : "Manage Historical Record of Users' Financial Insights for Trend Analysis"

}

@enduml