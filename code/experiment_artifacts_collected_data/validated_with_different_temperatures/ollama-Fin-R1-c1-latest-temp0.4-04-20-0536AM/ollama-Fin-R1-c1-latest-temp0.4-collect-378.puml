@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage User Notifications" as SAFR002
  usecase "FAFR005: Schedule Mentoring Sessions" as FAFR005
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  
  Client --> CFR001 : View Financial Insights Dashboard  
  Client --> SAFR002 : Manage Notifications (Alerts)  
  Client --> FAFR005 : Schedule Mentoring Sessions
  SysAdmin --> SAFR002 : Configure System-Wide Settings  
  Advisor --> FAFR005 : Schedule Interventions for Clients  
  Advisor --> FAFR001: Manage Mentorship Based on Insights  
  Client --|> SFR013 : Receive Alerts/Interventions
}

@enduml