@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access Personalized Dashboard" as CFR008
  usecase "CFR010: Manage Relationship with Advisors" as CFR010

  rectangle "Client Interactions" {
    actor Client as C
    client --> (CFR001)
    client --> (CFR002) : "Receive Alerts"
    client --> (CFR003)
    client --> (CFR004)
    client --> (CFR005)
    client --> (CFR006)
    client --> (CFR007)
    client --> (CFR008)
    client --> (CFR010) : "Manage Relationship"
  }

  rectangle "Advisor Interactions" {
    actor FinancialAdvisor as FA
    financialadvisor --> (FAFR002)
    financialadvisor --> (FAFR003)
    financialadvisor --> (FAFR004)
  }

  rectangle "Administrator Interactions" {
    actor SysAdmin as SA
    sysadmin --> (SAFR001) : "Manage Parameters"
  }
}

@enduml