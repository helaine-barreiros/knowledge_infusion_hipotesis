@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as C1
actor SysAdmin as SA
actor FinancialAdvisor as FA
system "System" as S

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Historical Data and Market Trends Predictions" as CFR003
  usecase "CFR004: Personalized Recommendations Based on Financial Profile" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidated Financial Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10

  C1 --> CFR001 : "View"
  C1 --> CFR002 : "Receive Alerts"
  C1 --> CFR003 : "Predictions"
  C1 --> CFR004 : "Recommendations"
  C1 --> CFR005 : "Manage Preferences"
  C1 --> CFR006 : "Spending Limit Alerts"
  C1 --> CFR007 : "Investment Opportunities"
  C1 --> CFR008 : "News Related to Portfolio"
  C1 --> CFR009 : "Consolidated Dashboard"
  C1 --> CFR10 : "Manage Relationship with Advisors"

}

rectangle "System Administrator Interface" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001

  SA --> SAFR001
}
@enduml