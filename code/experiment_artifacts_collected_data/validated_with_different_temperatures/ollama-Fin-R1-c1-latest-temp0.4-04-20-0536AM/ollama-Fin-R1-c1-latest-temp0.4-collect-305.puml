@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  Client --> CFR001 : "View financial data, predictions, and recommendations"
  
  SysAdmin --> SAFR001 : "Manage system parameters for compliance"

  rectangle "Client Interface" {
    actor "User (Client)" as U
    usecase "CFR002: View Alerts on Anomalous Transactions" as CFR002
    usecase "CFR003: View Financial Predictions" as CFR003
    usecase "CFR004: Receive Personalized Recommendations" as CFR004
    usecase "CFR005: Manage Recommendation Preferences" as CFR005
    usecase "CFR006: View Spending Limit Alerts" as CFR006
    usecase "CFR007: View Investment Opportunities" as CFR007
    usecase "CFR008: Access News Related to Portfolio" as CFR008
    usecase "CFR009: Manage Personalized Dashboard" as CFR009
    usecase "CFR10: Manage Relationship with Advisors" as CFR10

    U --> CFR002 : "Receive alerts about unusual transactions"
    U --> CFR003 : "View future financial trends and projections"
    U --> CFR004 : "Get tailored investment advice based on profile"
    U --> CFR005 : "Adjust personalization settings for recommendations"
    U --> CFR006 : "Monitor spending limits to stay within budget"
    U --> CFR007 : "Explore suitable investments matching risk tolerance"
    U --> CFR008 : "Stay informed about market events affecting portfolio"
    U --> CFR009 : "Consolidate all financial info in one place for easy tracking"
    U --> CFR10 : "Control sharing of data with advisors and set permissions"

  }

  rectangle "Advisor Interface" {
    actor "Financial Advisor (FA)" as FA
    usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
    usecase "FAFR002: View Intervention Alerts for Clients" as FAFR002
    usecase "FAFR003: Review Predictive Analytics on Clients' Finances" as FAFR003
    usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004

    FA --> FAFR001 : "Schedule and manage advisory sessions"
    FA --> FAFR002 : "Act on system-generated alerts to assist clients"
    FA --> FAFR003 : "Analyze client data for better advice"
    FA --> FAFR004 : "Customize analysis settings per client group"

  }

  rectangle "System Management" {
    actor "SysAdmin (Administrator)" as SA
    usecase "SAFR001: Manage Analysis Parameters" as SAFR001

    SA --> SAFR001 : "Adjust system-wide parameters for accuracy and compliance"
    
  }
  
}

@enduml