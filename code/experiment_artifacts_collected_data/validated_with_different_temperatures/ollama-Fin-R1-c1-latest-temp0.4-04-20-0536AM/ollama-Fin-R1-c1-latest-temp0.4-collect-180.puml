  usecase "CFR002: View Alerts About Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data & Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with Financial Profile and Goals" as CFR004
  usecase "CFR005: Manage Personalized Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds in Expense Categories" as CFR006
  usecase "CFR007: View Investment Opportunities Suitable to Risk Profile" as CFR007
  usecase "CFR008: Access Personalized Dashboard for Financial Information Consolidation" as CFR008
  usecase "CFR010: Manage Relationship with Financial Advisors, Including Data Sharing Permissions" as CFR010

  Client --> CFR001 : "View"
  Client --> CFR002 : "Receive Alerts About Anomalous Transactions"
  Client --> CFR003 : "View Predictive Analytics Based on Historical and Market Trends"
  Client --> CFR004 : "Receive Personalized Recommendations"
  Client --> CFR005 : "Manage Preferences for Recommendations"
  Client --> CFR006 : "View Spending Limit Alerts"
  Client --> CFR007 : "View Investment Opportunities"
  Client --> CFR008 : "Access Consolidated Dashboard"
  Client --> CFR010 : "Manage Relationship"

}

rectangle SystemAdmin {
  usecase "SAFR001: Manage Analysis Parameters for AI" as SAFR001
  SysAdmin --> SAFR001 : "Manage Parameters"

}

rectangle FinancialAdvisor {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004

  SysAdmin --> FAFR001 : "Manage Sessions"
  SysAdmin --> FAFR002 : "View Alerts"
  SysAdmin --> FAFR003 : "View Analytics"
  SysAdmin --> FAFR004 : "Configure Parameters"

}

rectangle System {
  usecase "SFR001: Deliver Alerts to Users" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts Based on User Activity" as SFR005
