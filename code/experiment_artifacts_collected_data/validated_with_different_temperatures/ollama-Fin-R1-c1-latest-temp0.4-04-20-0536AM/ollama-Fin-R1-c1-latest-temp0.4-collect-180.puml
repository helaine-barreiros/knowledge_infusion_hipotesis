  usecase "SFR009: Extract Relevant News for Financial Portfolios From Trusted Sources" as SFR009
  usecase "SFR010: Generate Client Dashboards With Intuitive Presentation of Data" as SFR010
  usecase "SFR012: Process Contextualized News to Identify Relevance To Users' Portfolios" as SFR012
  usecase "SFR013: Request Predictive Intervention Analyses From AI Component For Advisor Engagement Timing" as SFR013

  System --> SFR001 : "Deliver Alerts"
  System --> SFR002 : "Provide Recommendations"
  System --> SFR003 : "Request Financial Predictions"
  System --> SFR004 : "Request Personalized Recommendations"
  System --> SFR005 : "Request Spending Limit Alerts"
  System --> SFR006 : "Request Investment Opportunity Analysis"
  System --> SFR007 : "Find Specific Opportunities"
  System --> SFR008 : "Detect Anomalous Transactions"
  System --> SFR009 : "Extract News Insights"
  System --> SFR010 : "Generate Dashboards"
  System --> SFR012 : "Process Contextualized News"
  SysAdmin --> SFR013 : "Request Predictive Interventions"

}

rectangle AI {
  usecase "AIFR001: Generate Financial Predictions Based on Historical Data and Market Trends" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  usecase "AIFR003: Identify Spending Limit Alerts via Pattern Recognition in User Activity" as AIFR003
  usecase "AIFR004: Evaluate Investment Opportunities Against Risk Profiles and Financial Goals" as AIFR004
  usecase "AIFR005: Align Investments With Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Detect Anomalous Transactions in Compliance with Regulatory Standards" as AIFR006
  usecase "AIFR007: Correlate Financial News to Specific Portfolios for Relevance" as AIFR007
  usecase "AIFR008: Identify Patterns Indicating Need For Advisor Engagement in Client Predictions" as AIFR008

  System --> AIFR001 : "Generate Predictions"
  System --> AIFR002 : "Provide Recommendations"
  System --> AIFR003 : "Identify Spending Alerts"
  System --> AIFR004 : "Evaluate Investments"
  System --> AIFR005 : "Align with MPT"
  System --> AIFR006 : "Detect Anomalous Transactions"
  System --> AIFR007 : "Extract News Insights"
}

Client <|-- S
SysAdmin <|-- S
