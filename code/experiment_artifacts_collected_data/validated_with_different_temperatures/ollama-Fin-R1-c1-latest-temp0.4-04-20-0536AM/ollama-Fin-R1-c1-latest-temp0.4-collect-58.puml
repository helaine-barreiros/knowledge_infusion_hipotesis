@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as C1
actor SysAdmin as SA
actor FinancialAdvisor as FA
system "System" as S

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: View Investment Opportunities Suitable to Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Investment Portfolio" as CFR008
  usecase "CFR009: Manage Relationship with Financial Advisors Including Data Sharing Permissions" as CFR009
}

rectangle "System Administration Interface" {
  usecase "SAFR001: Manage Analysis Parameters for AI System Compliance" as SAFR001
}

rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts from System" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients' Financial Situations" as FAFR003
}

rectangle "System Core Components" {
  system S

  usecase "SFR001: Deliver Alerts Through Notification Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts When Exceeding Thresholds" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis for Users Based on Risk Profiles" as SFR006
  usecase "SFR007: Find Specific Investment Opportunities Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts in Compliance with AML Regulations" as SFR008
  usecase "SFR009: Extract Contextualized News Relevant to Users' Portfolios" as SFR009
  usecase "SFR010: Process Contextualized News for Financial Portfolio Impact Analysis" as SFR010
  usecase "SFR011: Request AI-Generated Client Dashboards with Intuitive Formatting" as SFR011
  usecase "SFR012: Generate Client Alerts Based on Predefined Conditions" as SFR012
  usecase "SFR013: Provide Client Analytics for Financial Behavior and Performance Insights" as SFR013
  usecase "SFR014: Request Predictive Intervention Analyses from AI Component" as SFR014
  usecase "SFR015: Enhance Value of Financial Guidance with Predictive Insights From AI" as SFR015
  usecase "SFR016: Generate Financial Health Reports Based on Standard Metrics" as SFR016
  usecase "SFR017: Track Users' Financial Goals and Progress" as SFR017
  usecase "SFR018: Maintain Historical Record of Insights for Trend Analysis" as SFR018
  usecase "SFR019: Manage User Feedback to Improve System Accuracy" as SFR019

}

rectangle "AI Processing Component" {
  system AIFR001
  system AIFR002
  system AIFR003
  system AIFR004
  system AIFR005
  system AIFR006
  system AIFR007
  system AIFR008
  system AIFR009

}

C1 --> CFR001 : "View Financial Insights Dashboard"
