@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage User Preferences (Client)" as SAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "SAFR005: Manage Recommendation Preferences (Client)" as SAFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access Personalized Dashboard" as CFR008
  usecase "SAFR013: Manage User Permissions (Client)" as SAFR013
  usecase "SFR019: Maintain Historical Record of Insights" as SFR019

  package Professional {
    actor FinancialAdvisor as FA
  }

  package SystemAdmin {
    actor SysAdmin as SA
  }

  client --> CFR001 : View financial insights dashboard  
  client --> SAFR002 : Manage user preferences (client)
  client --> CFR003 : View financial predictions
  client --> CFR004 : Receive personalized recommendations
  client --> SAFR005 : Manage recommendation preferences (client)
  client --> CFR006 : View spending limit alerts  
  client --> CFR007 : View investment opportunities 
  client --> CFR008 : Access personalized dashboard
  client --> SAFR013 : Manage user permissions (client)
  client --> SFR019 : Maintain historical record of insights

  SA --> SAFR002 : Configure system parameters  
}

@enduml