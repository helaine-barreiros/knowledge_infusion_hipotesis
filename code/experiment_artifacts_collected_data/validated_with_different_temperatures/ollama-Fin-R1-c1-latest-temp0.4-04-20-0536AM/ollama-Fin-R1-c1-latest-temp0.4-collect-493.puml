@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Alert Thresholds and Categories" as SAFR002
  usecase "CFR003: Receive Personalized Financial Predictions" as CFR003
  usecase "CFR004: Access Personalized Recommendations" as CFR004
  usecase "CFR005: Adjust Recommendation Preferences" as CFR005
  usecase "CFR006: Monitor Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Stay Informed with Financial News" as CFR008
  usecase "CFR009: Consolidate Financial Information in a Single Dashboard" as CFR010
  usecase "SAFR003: Configure System-Wide Alerts and Notifications" as SAFR004
  usecase "FAFR002: Manage Client Intervention Alerts for Advisors" as FAFR002
  usecase "AIFR005: Generate Investment Opportunity Analyses Based on Risk Profiles" as AIFR005

  actor "Client" as Client
  actor "Financial Advisor (FAD)" as FAD
  actor "System Administrator (SA)" as SA
  
  Client --> CFR001 : View financial insights dashboard  
  Client --> CFR003 : Receive personalized predictions  
  Client --> CFR004 : Access recommendations  
  Client --> CFR005 : Adjust preferences  
  Client --> CFR006 : Monitor spending limits  
  Client --> CFR007 : Find investment opportunities  
  Client --> CFR008 : View financial news  
  Client --> CFR010 : Consolidate info in single dashboard  

  SA -> SAFR002 : Manage alert thresholds and categories
  FAD -> FAFR002: Manage client intervention alerts

  SysAdmin -->> (System) : System management, configuration
  
}

@enduml