@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR004: Personalized Recommendations Based on Financial Profile" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "SAFR009: Generate Client Alerts Based on Predefined Conditions" as SAFR009
  usecase "SFR012: Generate Client Dashboards for Financial Information" as SFR012
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "AIFR008: Generate Intervention Recommendations Based on Patterns" as AIFR008
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "CFR011: Send Feedback to Improve System Outputs" as CFR011

  // Actors and their relationships with the system
  Client --> CFR001 : View Financial Insights Dashboard
  Client --> CFR002 : Receive Alerts on Anomalous Transactions
  Client --> CFR003 : View Financial Predictions
  Client --> CFR004 : Personalized Recommendations Based on Financial Profile
  Client --> CFR005 : Manage Recommendation Preferences
  Client --> SAFR009 : Generate Client Alerts Based on Predefined Conditions (via System)
  Client --> SFR012 : Generate Client Dashboards for Financial Information

  SysAdmin --> SAFR001 : Manage Analysis Parameters
  
  FAFR003: View Predictive Analytics for Clients
  FAFR004: View Intervention Alerts Based on AI Insights (via System)
  
  AIFR008: Generate Client Predictive Interventions

  // Relationships between use cases and system components
  Sys --> CFR001 : Delivers Financial Insights Dashboard to Client
  Sys --> SAFR009 : Generates Client Alerts via System Notifications
  
  SFR006: Request Investment Opportunity Analysis from AI Component (via System)
  
}

@enduml