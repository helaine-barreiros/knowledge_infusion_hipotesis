@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as client
actor FinancialAdvisor as advisor
actor SysAdmin as sysadmin
system "System" as system

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as cfr001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as cfr002
  usecase "CFR003: View Financial Predictions" as cfr003
  usecase "CFR004: Personalized Recommendations Based on Profile" as cfr004
  usecase "CFR005: Manage Recommendation Preferences" as cfr005
  usecase "CFR006: View Spending Limit Alerts" as cfr006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as cfr007
  usecase "CFR008: Receive News Related to Portfolio" as cfr008
  usecase "CFR009: Personalized Dashboard for Financial Information" as cfr009
  usecase "CFR10: Manage Relationship with Advisors" as cfr10

  client --> (cfr001)
  client --> (cfr002) : "View Alerts"
  client --> (cfr003)
  client --> (cfr004)
  client --> (cfr005)
  client --> (cfr006)
  client --> (cfr007)
  client --> (cfr008)
  client --> (cfr009)
  client --> (cfr10)

}

rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as fafr001
  usecase "FAFR002: View Intervention Alerts" as fafr002
  usecase "FAFR003: View Predictive Analytics for Clients" as fafr003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as fafr004

  advisor --> (fafr001)
  advisor --> (fafr002) : "View Alerts"
  advisor --> (fafr003)
  advisor --> (fafr004)

}

rectangle "System Administrator Interface" {
  usecase "SAFR001: Manage Analysis Parameters for AI System" as safr001
  sysadmin --> (safr001) : "Manage"
}

system <<|-- (cfr001)
system <<|-- (cfr002)
system <<|-- (cfr003)
system <<|-- (cfr004)
system <<|-- (cfr005)
system <<|-- (cfr006)
system <<|-- (cfr007)
system <<|-- (cfr008)
system <<|-- (cfr009)
system <<|-- (cfr10)

system <<|-- (fafr001)
system <<|-- (fafr002)
system <<|-- (fafr003)
system <<|-- (fafr004)

system <<|-- (safr001)

@enduml