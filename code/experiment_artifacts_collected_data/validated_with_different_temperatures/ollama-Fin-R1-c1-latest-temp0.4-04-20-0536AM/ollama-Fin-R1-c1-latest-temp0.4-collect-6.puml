@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Spending Limit Alerts" as SAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "SAFR001: Manage Analysis Parameters (Basel III)" as SAFR001
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "CFR006: View Investment Opportunities Based on Risk Profile" as CFR006
  usecase "CFR007: Access Personalized Dashboard" as CFR012
  usecase "SAFR003: Deliver Alerts Through Notification Channels (SFR)" as SAFR003
  usecase "SAFR004: Generate Recommendations Based on Profiles and Preferences (SFR)" as SAFR004
  usecase "SAFR005: Request Spending Limit Alerts from AI" as SAFR005
  usecase "AIFR001: Analyze Historical Data for Predictions (AI)" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations (AI)" as AIFR002
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "SFR009: Extract Contextualized News for Users (SFR)" as SFR009
  usecase "AIFR007: Generate Contextualized News Insights (AI)" as AIFR007
  usecase "CFR013: Track Financial Goals" as CFR018
}

actor Client as c1 {
  --> CFR001 : "View Financial Insights Dashboard"
  --> CFR002 : "Receive Alerts for Anomalous Transactions (FATF)"
  --> CFR003 : "View Predictive Analytics"
  --> CFR004 : "Personalized Recommendations Based on Profile"
  --> CFR005 : "Manage Recommendation Preferences"
}

actor SystemAdmin as s1 {
  --> SAFR001
}

actor FinancialAdvisor as fad1, fad2 {
  --> FAFR001
  --> FAFR003
  --> AIFR008: "Generate Intervention Recommendations (AI)"
  --> CFR011 : "Send Feedback to System"
}

actor ClientUser as cu1 extends Client {}

package Professional {
  actor Chef {}
}
  
rectangle "System" {
  usecase "CFR009: Consolidated Financial Dashboard" as CFR009
  usecase "SAFR006: Generate Investment Opportunity Analysis (SFR)" as SAFR006
}

actor SysAdmin extends SystemAdmin {}

package Client {
  actor User {}
}
  
rectangle "System Boundary" {
  ClientUser --> SFR012 : "Generate Personalized Dashboard"
  ClientUser --> CFR008 : "View News Related to Portfolio (SFR)"
  ClientUser --> AIFR009: "Client Predictive Insights (AI)"
}

actor User extends Client {}

@enduml