  usecase "SFR011: Process Contextualized News for User Insights" as SFR011
  usecase "SFR012: Request Predictive Intervention Analyses from AI Component" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
