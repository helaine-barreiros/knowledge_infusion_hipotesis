  actor "Financial Advisor" as advisor1
  actor "System Administrator" as admin1

  client1 --> CFR001 : View financial insights dashboard
  client1 --> CFR002 : Receive alerts on anomalous transactions
  client1 --> CFR003 : View financial predictions based on data and trends
  client1 --> CFR004 : Personalized recommendations aligned with profile
  client1 --> CFR005 : Manage recommendation preferences
  client1 --> CFR006 : Spending limit alerts when exceeding thresholds
