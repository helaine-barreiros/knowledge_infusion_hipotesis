@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR004: Personalized Financial Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Stay Informed with Financial News" as CFR008
  usecase "CFR009: Consolidated Personalized Dashboard" as CFR010
  usecase "CFR010: Manage Relationship with Advisors" as CFR010
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AI" as SFR004
  usecase "SFR005: Request Spending Limit Alerts From AI" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Based on ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts From AI Component" as SFR008
  usecase "SFR009: Extract Contextualized News for Users' Portfolios" as SFR009
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "AIFR003: Generate Spending Limit Alerts Based on Unusual Patterns" as AIFR003
  usecase "CFR011: Send Feedback to Improve System Outputs" as CFR011

  actor Client as client {
    --> CFR001 : View Financial Insights Dashboard
    --> CFR002 : Receive Alerts on Anomalous Transactions
    --> CFR004 : Personalized Financial Recommendations
    --> CFR005 : Manage Recommendation Preferences
    --> CFR006 : View Spending Limit Alerts
    --> CFR007 : Access Investment Opportunities Based on Risk Profile
    --> CFR008 : Stay Informed with Financial News
    --> CFR010 : Consolidated Personalized Dashboard
  }

  actor SystemAdministrator as sysAdmin {
    --> SAFR001 : Manage Analysis Parameters for AI Component
  }

  actor FinancialAdvisor as advisor {
    --> FAFR003: View Predictive Analytics for Clients
    --> FAFR004: Generate Client Intervention Alerts Based on System Insights
    --> FAFR005: Configure Analysis Params for Specific Segments
    --> SFR012 : Generate Client Dashboards (via system)
  }

  actor AIComponent as ai {
    <|-- AIFR003: Generate Spending Limit Alerts from Unusual Patterns
    <|-- AIFR004: Generate Investment Opportunity Analyses Based on Risk Profiles
    <|-- AIFR005: Identify Financial Instruments Aligning with Strategies and MPT Principles
  }

  client <|-- (SFR012)
}

@enduml