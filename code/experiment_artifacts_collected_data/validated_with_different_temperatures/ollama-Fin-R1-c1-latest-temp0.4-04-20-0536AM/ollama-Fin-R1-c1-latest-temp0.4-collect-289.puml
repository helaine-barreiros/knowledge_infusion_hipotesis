@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR003: Request Financial Predictions from AI Component" as SAFR003
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  Client --> CFR001 : "View financial data in a comprehensive format"
  
  rectangle "Client" {
    actor "Client" as C
    C -> (CFR001)
    
    usecase "SFR035: View Alerts Based on Predefined Conditions" as SFR035
    Client --> SFR035 : "View alerts for anomalous transactions, spending limits, etc."
  }
  
  rectangle "Financial Advisor" {
    actor "FAFR001: Manage Client Mentoring Sessions" as FAFR001
    usecase "SAFR004: Configure Analysis Parameters by Segment" as SAFR004
    
    FAFR001 -> (CFR003) : "View financial predictions for clients"
  }
  
  rectangle "System Administrator" {
    actor "SysAdmin" as SA
    usecase "SAFR002: Manage Analysis Parameters" as SAFR002
    SysAdmin --> (SAFR001)
    
    usecase "SFR036: Process User Feedback to Improve System" as SFR036
    
  }
  
  rectangle "AI Component" {
    actor "AIFR009: Generate Client Predictive Insights" as AIFR009
    actor "AIFR012: Analyze News Contextually for Users" as AIFR012
    usecase "CFR037: View Investment Opportunities Based on Risk Profile" as CFR037
    
  }
  
  rectangle "System" {
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    usecase "AIFR006: Generate Spending Limit Alerts for Users" as AIFR006
    SysAdmin --> (SAFR001)
  }
  
}

@enduml