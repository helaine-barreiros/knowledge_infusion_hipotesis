@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sas
actor FinancialAdvisor as faa
system :System: as sys

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Portfolio" as CFR008
  usecase "CFR009: View Consolidated Financial Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10

  c1 --> CFR001 : "View financial data"
  c1 --> CFR002 : "Receive alerts for anomalous transactions"
  c1 --> CFR003 : "View predictions"
  c1 --> CFR004 : "Get personalized recommendations"
  c1 --> CFR005 : "Manage preferences"
  c1 --> CFR006 : "View spending limit alerts"
  c1 --> CFR007 : "Access investment opportunities"
  c1 --> CFR008 : "Receive news related to portfolio"
  c1 --> CFR009 : "Consolidated dashboard"
  c1 --> CFR10 : "Manage relationship with advisors"

}

rectangle "FinancialAdvisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004

  faa --> FAFR001 : "Manage client mentoring"
  faa --> FAFR002 : "View intervention alerts"
  faa --> FAFR003 : "Analyze clients' financial situations"
  faa --> FAFR004 : "Configure parameters by segment"

}

rectangle "SysAdmin" {
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001

  sas --> SAFR001 : "Manage analysis parameters (e.g., compliance with Basel III)"

}

system sys {

  usecase "SFR001: Deliver Alerts to Users via Notifications" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
  usecase "SFR007: Find Specific Investment Opportunities Based on Criteria" as SFR007
  usecase "SFR008: Generate Client Alerts Based on Predefined Conditions" as SFR008
  usecase "SFR009: Create Contextualized News for Users' Portfolios" as SFR009
  usecase "SFR010: Process Contextualized News Insights from AI" as SFR010
  usecase "SFR011: Generate Client Dashboards Intuitively" as SFR011
  usecase "SFR012: Manage User Feedback to Improve System" as SFR013

}

system sys {

  usecase "AIFR001: Generate Financial Predictions Using Data and Trends" as AIFR001
  usecase "AIFR002: Create Personalized Recommendations Based on Profiles" as AIFR002
  usecase "AIFR003: Identify Spending Limit Alerts for Users" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities Matching Risk Profiles" as AIFR004
  usecase "AIFR005: Recommend Financial Instruments Based on Strategies and MPT" as AIFR005
  usecase "AIFR006: Detect Anomalous Transactions Using Pattern Recognition" as AIFR006
  usecase "AIFR007: Correlate News with Portfolios for Relevant Insights" as AIFR007
  usecase "AIFR008: Recommend Interventions Based on Predictive Analysis" as AIFR008
  usecase "AIFR009: Provide Forward-Looking Financial Analyses to Clients" as AIFR009

}

actor Client c2 {
  usecase "CFR11: Send Feedback for System Improvements" as CFR11
  c2 --> CFR11 : "Provide feedback"
}
@enduml