@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Notification Settings" as SAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Adjust Recommendation Preferences" as CFR005
  usecase "CFR006: Monitor Spending Limits" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access Portfolio News" as CFR008
  usecase "CFR009: Consolidate Financial Information" as CFR009
  usecase "CFR010: Manage Data Sharing with Advisors" as CFR010

  SysAdmin --> SAFR002 : Can configure system parameters for alerts and notifications.
  
  rectangle "Client" {
    Client --> CFR001 : View comprehensive financial data.
    Client --> CFR003 : Access future forecasts based on history and trends.
    Client --> CFR004 : Get tailored advice aligned with personal goals.
    Client --> CFR005 : Customize recommendation preferences in KYC profile.
    Client --> CFR006 : Track spending limits to prevent overspending.
    Client --> CFR007 : Explore investment options matching risk tolerance.
    Client --> CFR008 : Stay informed about market news affecting investments.
    Client --> CFR009 : Get a single view of all financial data for efficiency.
    Client --> CFR10: Control sharing with advisors, ensuring privacy.

  }

  rectangle "Financial Advisor" {
    FAFR001 --> SAFR002 : Manage client mentoring sessions using system insights.
    FAFR003 --> AIFR008 : Use predictive analysis to guide client interactions proactively.
    
  }
  
  SysAdmin --> SFR009 : System requests contextualized news for clients.

}

@enduml