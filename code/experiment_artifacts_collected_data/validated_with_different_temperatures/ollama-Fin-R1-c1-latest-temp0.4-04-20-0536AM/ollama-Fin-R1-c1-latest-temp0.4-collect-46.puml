@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  actor "Client" as Client --> CFR001 : View financial data, receive alerts, manage preferences  
  SysAdmin -> SAFR001 : Manage system parameters  
  FinancialAdvisor -- (CFR003) : Receive personalized recommendations
  FinancialAdvisor -- (SAFR007) : Request investment opportunities based on risk profile
  Client --> CFR002 : View transaction alerts, receive notifications about fraud or unusual spending patterns.
  Client --> SAFR006 : Manage budget thresholds and view spending limit alerts.
  
  SysAdmin -> SFR019 : Maintain historical record of insights for trend analysis.  

  client --> FAFR003: Receive predictive analytics during consultations
  FinancialAdvisor -- (FAFR002) : View intervention alerts when needed
}

@enduml