@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
}

actor Client as C1, C2, C3 {
  C1 --> CFR001 : View Financial Insights Dashboard
  C1 --> SFR005 : Manage Spending Limit Alerts (Exceeding Thresholds)
  C1 --> FAFR002 : View Anomaly Transaction Alerts (FATF Compliance)
  C1 --> AIFR006: Generate Investment Opportunities Based on Risk Profile
  
  C3 --> CFR009: Access Personalized Dashboard
}

actor FinancialAdvisor as FA {
  FA --> SFR004 : Request Personalized Recommendations for Clients
  FA --> FAFR002 : View Client Intervention Alerts (Proactive Assistance)
  FA --> AIFR008 : Generate Predictive Intervention Recommendations
  
  FA <|-- SAFR001: Manage Analysis Parameters for Specific Segments
}

actor SystemAdmin as SA {
  SA --> SAFR001 : Configure AI Algorithm Settings and Compliance Checks
}

actor ClientUser as CU {
  CU --> CFR002: Receive Alerts on Anomalous Transactions (FATF)
  
  CU <|-- C3: Manage Personalized Recommendations Preferences via KYC Profile
}

rectangle "System Components" {
  usecase "SFR017: Generate Financial Health Reports" as SFR017
  usecase "SFR020: Manage User Feedback for Improvements" as SFR020

  C3 --> SFR020 : Provide Feedback on System Outputs (e.g., Recommendations)
}

actor ClientSupport {
  ClientSupport -> CFR009 : Access Consolidated Financial Dashboard
}
@enduml