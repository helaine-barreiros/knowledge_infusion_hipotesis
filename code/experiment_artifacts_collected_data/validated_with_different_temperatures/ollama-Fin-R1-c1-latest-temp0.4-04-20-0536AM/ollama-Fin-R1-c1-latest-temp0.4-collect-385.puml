@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "SFR012: Generate Client Dashboards" as SFR012

  Client --> CFR001 : "View Financial Insights Dashboard"
  SysAdmin --> SAFR001 : "Manage Analysis Parameters"
  
  rectangle "Client Interface" {
    actor User as U
    usercase "CFR002: View Alerts for Anomalous Transactions" as CFR002
    usercase "CFR003: View Financial Predictions" as CFR003
    usercase "CFR004: Receive Personalized Recommendations" as CFR004
    usercase "CFR005: Manage Recommendation Preferences" as CFR005
    usercase "CFR006: View Spending Limit Alerts" as CFR006
    usercase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
    usercase "CFR008: Access News Related to Portfolio" as CFR008
    usercase "CFR009: Manage Personalized Dashboard" as CFR009
    usercase "CFR10: Manage Relationship with Financial Advisors" as CFR10

    U --> CFR002 : "View Alerts for Anomalous Transactions"
    U --> CFR003 : "View Financial Predictions"
    U --> CFR004 : "Receive Personalized Recommendations"
    U --> CFR005 : "Manage Recommendation Preferences"
    U --> CFR006 : "View Spending Limit Alerts"
    U --> CFR007 : "View Investment Opportunities Based on Risk Profile"
    U --> CFR008 : "Access News Related to Portfolio"
    U --> CFR009 : "Manage Personalized Dashboard"
    U --> CFR10 : "Manage Relationship with Financial Advisors"

  }
  
  rectangle "Financial Advisor Interface" {
    actor FAFR as F
    usecase "FAFR002: View Client Intervention Alerts" as FAFR002
    usercase "FAFR003: View Predictive Analytics for Clients" as FAFR003
    usercase "FAFR004: Configure Analysis Parameters by Segment" as FAFR004

    F --> FAFR002 : "View Client Intervention Alerts"
    F --> FAFR003 : "View Predictive Analytics for Clients"
    F --> FAFR004 : "Configure Analysis Parameters by Segment"

  }
  
  rectangle "System Administrator Interface" {
    actor SysAdmin as SA
    usecase "SAFR001: Manage Analysis Parameters" as SAFR001

    SA --> SAFR001 : "Manage Analysis Parameters"
  }

}

@enduml