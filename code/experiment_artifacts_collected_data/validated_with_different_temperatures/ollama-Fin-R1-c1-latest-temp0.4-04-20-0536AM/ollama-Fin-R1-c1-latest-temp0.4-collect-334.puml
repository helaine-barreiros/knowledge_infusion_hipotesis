@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Anomaly Transaction Alerts" as SAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Manage Relationship with Financial Advisors" as CFR009

  rectangle "Client" {
    actor Client as client
    client --> CFR001 : View Financial Insights Dashboard
    client --> SAFR002 : Receive Anomaly Transaction Alerts
    client --> CFR003 : View Financial Predictions
    client --> CFR004 : Personalized Recommendations
    client --> CFR005 : Manage Preferences
    client --> CFR006 : Spending Limit Alerts
    client --> CFR007 : Investment Opportunities
    client --> CFR008 : News Related to Portfolio
  }

  rectangle "Financial Advisor" {
    actor FinancialAdvisor as fa
    fa --> CFR009: Relationship Management

    usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
    usecase "FAFR002: View Intervention Alerts" as FAFR002
    usecase "FAFR003: View Predictive Analytics" as FAFR003

    fa --> FAFR001 : Manage Client Mentoring Sessions
    fa --> FAFR002 : View Intervention Alerts
  }

  rectangle "System Administrator" {
    actor SysAdmin as sysadmin
    usecase "SAFR001: Manage Analysis Parameters" as SAFR001

    sysadmin --> SAFR001 : Manage AI System Parameters (Basel III, etc.)
  }
  
  system boundary {
    client <|-- CFR001
    client <|-- SAFR002
    client <|-- CFR003
    client <|-- CFR004
    client <|-- CFR005
    client <|-- CFR006
    client <|-- CFR007
    client <|-- CFR008

    sysadmin --> SAFR001 : Manage AI System Parameters (Basel III, etc.)
  }
  
}

@enduml