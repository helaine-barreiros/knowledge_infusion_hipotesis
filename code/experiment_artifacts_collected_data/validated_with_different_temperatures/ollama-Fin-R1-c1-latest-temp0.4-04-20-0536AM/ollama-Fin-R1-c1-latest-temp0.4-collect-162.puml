@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  
  // Clients (User)
  client --> CFR001 : "View Financial Insights Dashboard"
  client --> SFR012 : "Generate Client Dashboards"
  client --> SFR013 : "Generate Client Alerts"
  client --> AIFR008 : "Generate Predictive Intervention Recommendations"
  
  // System Administrator
  SysAdmin --> SAFR001 : "Manage Analysis Parameters"
  
  // Financial Advisor (FA)
  FA --> FAFR002 : "View Client Intervention Alerts"
  FA --> FAFR003 : "View Predictive Analytics about Clients' Situations"
  FA --> AIFR009 : "Generate Client Predictive Insights"
  
  client <|-- CFR005: "Manage Personalized Recommendations Preferences"
}

@enduml