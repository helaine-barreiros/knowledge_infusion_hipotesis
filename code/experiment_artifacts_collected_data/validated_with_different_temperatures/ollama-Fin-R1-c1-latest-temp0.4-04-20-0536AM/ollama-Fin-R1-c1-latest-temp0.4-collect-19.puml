@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as C1
actor SysAdmin as SA
actor FinancialAdvisor as FA
system "System" as S

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Trends" as CFR003
  usecase "CFR004: Access Personalized Recommendations Aligning with Financial Goals" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: Receive Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Portfolio Management" as CFR008
  usecase "CFR009: Use a Consolidated Personalized Dashboard for Financial Monitoring" as CFR009
  usecase "CFR10: Manage Relationship with Advisors Including Data Sharing Permissions" as CFR10

  C1 --> CFR001 : "View financial data"
  C1 --> CFR002 : "Receive alerts about anomalous transactions"
  C1 --> CFR003 : "Access future predictions based on history and trends"
  C1 --> CFR004 : "Get personalized recommendations aligned with goals"
  C1 --> CFR005 : "Adjust preferences for recommendations"
  C1 --> CFR006 : "Get spending limit alerts when exceeding thresholds"
  C1 --> CFR007 : "View investment opportunities based on risk profile"
  C1 --> CFR008 : "Read portfolio-related news"
  C1 --> CFR009 : "Use consolidated dashboard for monitoring finances"
  C1 --> CFR10 : "Manage data sharing with advisors"

}

rectangle "System Administrator Interface" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  SA --> SAFR001 : "Adjust system parameters to ensure accuracy and compliance (e.g., Basel III)"
  
}

rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Schedule Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: Access Predictive Analytics to Inform Consultations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004

  FA --> FAFR001 : "Schedule mentoring sessions"
  FA --> FAFR002 : "View intervention alerts"
  FA --> FAFR003 : "Use predictive analytics during consultations"
  FA --> FAFR004 : "Set segment-specific parameters"

}

rectangle "System Core" {
  usecase "SFR001: Deliver Alerts Through Notification Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AI Component" as SFR004
  usecase "SFR005: Monitor Spending Limits and Trigger Alerts" as SFR005
  usecase "SFR006: Identify Investment Opportunities Based on Risk Profiles" as SFR006
  usecase "SFR007: Find Specific Investments Matching Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Detect Anomalous Transactions for Fraud Prevention" as SFR008
  usecase "SFR009: Extract Relevant News Contextual to Portfolios" as SFR009
  usecase "SFR010: Generate Client Dashboards Intuitively" as SFR010
  usecase "SFR013: Manage Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Provide Financial Analytics for Insights" as SFR014
  usecase "SFR015: Schedule Predictive Interventions by Advisor Engagement Patterns" as SFR015
  usecase "SFR016: Enhance Client Guidance Through AI-Generated Insights" as SFR016
  usecase "SFR017: Assess Financial Health via Standard Metrics" as SFR017
  usecase "SFR018: Track and Report on Users' Financial Goals Progress" as SFR018

}

rectangle "AI Component Interface" {
  usecase "AIFR001: Generate Financial Predictions Using Data Analysis" as AIFR001
  usecase "AIFR002: Provide Personalized Recommendations Based on Profiles and Risk Tolerance" as AIFR002
  usecase "AIFR003: Alert When Spending Patterns Exceed Thresholds" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities Against User Preferences" as AIFR004
  usecase "AIFR005: Identify Financial Instruments Aligning with Portfolio Strategies and MPT Principles" as AIFR005
  usecase "AIFR006: Detect Anomalous Transactions Using Pattern Recognition" as AIFR006
  usecase "AIFR007: Correlate News With Portfolios for Relevant Insights" as AIFR007
  usecase "AIFR008: Recommend Interventions Based on Client Patterns" as AIFR008
  usecase "AIFR009: Offer Forward-Looking Analysis to Support Financial Planning" as AIFR009

}

C1 <|-- S : "Interacts with system"
SA <|-- S : "Manages analysis parameters for the AI component"

@enduml