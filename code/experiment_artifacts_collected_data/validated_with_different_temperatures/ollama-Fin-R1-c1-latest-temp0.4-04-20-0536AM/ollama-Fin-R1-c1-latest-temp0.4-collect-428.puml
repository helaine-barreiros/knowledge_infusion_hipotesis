@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as C1
actor FinancialAdvisor as FA1
actor SysAdmin as SA1
system Syst as Sys

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Personalized Recommendations Based on Profile" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Spending Limit Alerts for Budget Control" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidated Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10

  C1 --> CFR001 : View financial data in a comprehensive format.
  C1 --> CFR002 : Receive alerts about anomalous transactions per FATF regulations.
  C1 --> CFR003 : Get future projections based on history and trends for informed decisions.
  C1 --> CFR004 : Obtain personalized investment advice aligned with goals.
  C1 --> CFR005 : Adjust personalization settings in KYC profile to refine recommendations.
  C1 --> CFR006 : Receive notifications when spending exceeds set limits per category.
  C1 --> CFR007 : Discover investments that match risk tolerance under MiFID II.
  C1 --> CFR008 : Stay updated with market news relevant to portfolio assets.
  C1 --> CFR009 : Access a single view of all financial info for efficient monitoring.
  C1 --> CFR10 : Control sharing and permissions with advisors.

}

rectangle "FinancialAdvisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Clients" as FAFR002
  usecase "FAFR003: Review Predictive Analytics of Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004

  FA1 --> FAFR001 : Schedule and track mentoring sessions using system-generated data.
  FA1 --> FAFR002 : Monitor client alerts to proactively address financial issues.
  FA1 --> FAFR003 : Analyze predictive models for clients during consultations.
  FA1 --> FAFR004 : Customize analysis parameters based on segment-specific profiles and regulations.

}

rectangle "SysAdmin" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  SA1 --> SAFR001 : Adjust AI system's algorithms to ensure accuracy, relevance, and compliance with financial regulations like Basel III.
  
}

system Syst {
  usecase "SFR001: Deliver Alerts Through Notification Channels" as SFR001
  usecase "SFR002: Personalized Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AI Component" as SFR004
  usecase "SFR005: Spending Limit Alerts Based on Thresholds" as SFR005
  usecase "SFR006: Investment Opportunity Analysis for Users" as SFR006
  usecase "SFR007: Specific Investment Opportunities Matching Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Anomaly Transaction Alerts Compliant with AML Regulations" as SFR008
  usecase "SFR009: Contextualized News Relevant to Portfolio" as SFR009
  usecase "SFR010: Client Dashboards for Intuitive Presentation of Financial Info" as SFR010
  usecase "SFR013: Generate Timely Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Provide Meaningful Client Analytics" as SFR014
  usecase "SFR015: Predictive Intervention Analyses for Financial Advisors" as SFR015
  usecase "SFR016: Enhance Value of Financial Guidance with AI Insights" as SFR016
  usecase "SFR017: Assess Users' Financial Health via Standard Metrics" as SFR017
  usecase "SFR018: Track and Recommend Progress Towards Financial Goals" as SFR018
  usecase "SFR020: Manage User Feedback to Improve Insights Over Time" as SFR020

}

system AIFR {
  usecase "AIFR001: Generate Financial Predictions Based on Data & Trends" as AIFR001
  usecase "AIFR003: Spending Limit Alerts via Pattern Recognition" as AIFR003
  usecase "AIFR004: Investment Opportunity Analysis Aligning Risk Profiles" as AIFR004
  usecase "AIFR005: Identify Investments Based on Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Anomaly Transaction Alerts Using Pattern Recognition" as AIFR006
  usecase "AIFR007: Contextualized News Insights Correlated with Portfolios" as AIFR007
  usecase "AIFR008: Predictive Intervention Recommendations for Advisors" as AIFR008
  usecase "AIFR009: Forward-Looking Client Analysis for Effective Planning" as AIFR009

}

// Relationships between components and systems
Sys <|-- SFR001 : Delivers alerts through channels.
Sys <|-- SFR002 : Provides personalized recommendations based on profiles.
Sys --> CFR003 : Requests financial predictions from AI component (AIFR).
Sys --> AIFR004 : Receives investment opportunity analyses.

// Relationships between FinancialAdvisor and System
FA1 -> FAFR001 : Uses system data for mentoring sessions.
FA1 -> SFR002 : Accesses personalized recommendations generated by the system.
FA1 -> SAFR001 : Configures analysis parameters via SysAdmin interface.

// Client to System interactions
C1 --> AIFR004 : Receives investment opportunities from AI component through system.
C1 --> AIFR005 : Gets investment options based on portfolio theory principles (via SFR).
C1 --> CFR002 : Sends transactions for anomaly detection by the system.

// SysAdmin to System interactions
SA1 -> SAFR001 : Adjusts analysis parameters in the AI component.
SA1 --|> AIFR003 : Manages spending limit alerts via system settings.

@enduml