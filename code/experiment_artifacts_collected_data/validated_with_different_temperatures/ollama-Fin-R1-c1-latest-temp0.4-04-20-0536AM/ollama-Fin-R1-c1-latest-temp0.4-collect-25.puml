@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as C1
actor SysAdmin as SA
actor FinancialAdvisor as FA

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "AIFR009: AI System Generates Contextualized News Insights" as AIFR009

  C1 --> CFR001 : "View Financial Insights Dashboard"
  SA --> SAFR001 : "Manage Analysis Parameters"
}

rectangle "Client, Advisor, SysAdmin" {
  usecase "CFR002: View Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Manage Relationship with Financial Advisors" as CFR009

  C1 --> CFR002 : "View Alerts for Anomalous Transactions"
  C1 --> CFR003 : "View Financial Predictions"
  C1 --> CFR004 : "Receive Personalized Recommendations"
  C1 --> CFR005 : "Manage Recommendation Preferences"
  C1 --> CFR006 : "View Spending Limit Alerts"
  C1 --> CFR007 : "View Investment Opportunities Based on Risk Profile"
  C1 --> CFR008 : "Access News Related to Portfolio"
  C1 --> CFR009 : "Manage Relationship with Financial Advisors"

  FA --> CFR002 : "Receive Intervention Alerts for Clients"
  FA --> CFR004 : "Provide Guidance Using Personalized Recommendations"
}

rectangle "System" {
  usecase "SFR007: Deliver Investment Opportunity Analysis Based on Risk Profile" as SFR007
  usecase "AIFR002: AI System Generates Personalized Recommendations" as AIFR002

  SysAdmin --> SAFR001 : "Manage Parameters for Compliance"
}

rectangle "AI Component" {
  usecase "AIFR005: Generate Investment Opportunities Based on Modern Portfolio Theory" as AIFR005
  usecase "AIFR006: Detect Anomaly Transactions in Accordance with FinCEN Rules" as AIFR006

}

rectangle "Client, Advisor, SysAdmin" {
  usecase "CFR011: Send Feedback to Improve System" as CFR011
}
@enduml