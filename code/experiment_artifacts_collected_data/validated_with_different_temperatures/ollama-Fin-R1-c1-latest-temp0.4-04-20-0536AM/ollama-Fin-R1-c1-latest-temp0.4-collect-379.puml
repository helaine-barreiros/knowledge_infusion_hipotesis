@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Anomaly Alerts" as SAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "SAFR001: Set Spending Limits" as SAFR001
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Manage Relationship with Financial Advisors" as CFR009

  SysAdmin --> SAFR001 : Set analysis parameters for AI system compliance (Basel III)
  
  Client --> CFR001, CFR003, CFR004, CFR005, SAFR002, SAFR001, CFR007, CFR008, CFR009
}

rectangle "AI System" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR003: Detect Spending Limit Exceedances" as AIFR003
  usecase "AIFR004: Recommend Investment Opportunities" as AIFR004
  usecase "AIFR006: Flag Anomaly Transactions" as AIFR006
  usecase "AIFR007: Correlate News with Portfolios" as AIFR007

  SysAdmin --> AIFR001 : Configure AI parameters for accuracy and relevance (FINRA, MiFID II)
}

rectangle "Financial Advisor" {
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: Review Predictive Analytics" as FAFR003
  SysAdmin --> FAFR001 : Manage client mentoring sessions based on system insights (GDPR, CCPA)
}

rectangle "Client-Specific Services" {
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "SAFR001: Manage Spending Limits" as SAFR001 (Client-Specific)
}

rectangle "System Management" {
  SysAdmin --> SAFR002 : Configure system-wide alerts and notifications (AML, FinCEN)
}
@enduml