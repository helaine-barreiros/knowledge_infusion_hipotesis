@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: Spending Limit Alerts When Exceeding Predefined Thresholds" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Investment Portfolio" as CFR008
  usecase "CFR009: Personalized Dashboard Consolidating Financial Information" as CFR009
  usecase "CFR010: Manage Relationship with Financial Advisors Including Data Sharing Permissions" as CFR010

  usecase "SAFR001: Manage Analysis Parameters for AI System Compliance" as SAFR001
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts from System" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004

  usecase "SFR001: Deliver Alerts Through Notification Channels" as SFR001
  usecase "SFR002: Personalized Recommendations Based on Financial Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Spending Limit Alerts Based on User Activity" as SFR005
  usecase "SFR006: Investment Opportunity Analysis for Users" as SFR006
  usecase "SFR007: Specific Investment Opportunities Matching Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Anomaly Transaction Alerts Based on AML Regulations" as SFR008
  usecase "SFR009: Contextualized News Relevant to Portfolio" as SFR009
  usecase "SFR010: Generate Client Dashboards Intuitively" as SFR010
  usecase "SFR011: Process Contextualized News for Users' Portfolios" as SFR011
  usecase "SFR012: Predictive Intervention Analyses by AI Component" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Financial Health Reports Using Ratios and Metrics" as SFR014
  usecase "SFR015: Request Predictive Insights from AI Component for Advisors" as SFR015
  usecase "SFR016: Manage Users' Financial Goals Tracking Progress" as SFR016
  usecase "SFR017: Historical Record of User Insights for Trend Analysis" as SFR017
  usecase "SFR018: Continuous Improvement via User Feedback Management" as SFR018

  usecase "AIFR001: Generate Financial Predictions Using Data and Trends" as AIFR001
  usecase "AIFR002: Personalized Recommendations Based on Profiles and Goals" as AIFR002
  usecase "AIFR003: Spending Limit Alerts for Unusual Activity Detection" as AIFR003
  usecase "AIFR004: Investment Opportunity Analyses Aligning with Risk Tolerance" as AIFR004
  usecase "AIFR005: Identify Financial Instruments Matching Investment Strategies" as AIFR005
  usecase "AIFR006: Pattern Recognition for Anomaly Transaction Alerts" as AIFR006
  usecase "AIFR007: Contextualized News Insights Correlated with Portfolios" as AIFR007
  usecase "AIFR008: Predictive Intervention Recommendations by AI Component" as AIFR008
  usecase "AIFR009: Forward-Looking Analysis for Financial Planning Support" as AIFR009

  actor Client as c1 {
    CFR001 --> (CFR002)
    CFR003 --> (CFR004) : label
    CFR005 --> (CFR006) <|-- (Client)
    CFR007 --> (CFR008) 
    CFR009 --> (CFR10)
  }

  actor FinancialAdvisor as fa {
    FAFR002 --> (FAFR003)
    FAFR004 --> (FAFR005)
  }

  actor SystemAdmin as sa
  sa --> SAFR001

  rectangle "Client" { Client }
  rectangle "Financial Advisor" { FinancialAdvisor }
  rectangle "System Administrator" { SystemAdmin }

  client c1 -> SFR002 : Personalized Recommendations  
  client c1 -> AIFR002 : Generate AI-Based Recs
  client c1 -> CFR003 : View Predictions

  system sa --> SAFR001 : Manage Analysis Params  

  financialAdvisor fa -> FAFR004 : Configure Segments
  financialAdvisor fa -> SFR015 : Request Pred Interventions  
}
@enduml