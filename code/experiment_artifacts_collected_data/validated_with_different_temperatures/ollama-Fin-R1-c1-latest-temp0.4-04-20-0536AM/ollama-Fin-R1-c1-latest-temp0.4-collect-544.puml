@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as C1
actor SysAdmin as SA
actor FinancialAdvisor as FA
system "System" as S

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Personalized Recommendations Based on Profile" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Spent Limit Alerts for Budget Control" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access Portfolio-Related News" as CFR008
  usecase "CFR009: Consolidated Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10

  C1 --> CFR001 : View dashboard
  C1 --> CFR002 : Receive alerts
  C1 --> CFR003 : View predictions
  C1 --> CFR004 : Get recommendations
  C1 --> CFR005 : Manage preferences
  C1 --> CFR006 : Spent limit alerts
  C1 --> CFR007 : Investment opportunities
  C1 --> CFR008 : News access
  C1 --> CFR009 : Consolidated view
  C1 --> CFR10 : Manage advisors

}

rectangle "System Administrator Interface" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SA --> SAFR001 : Configure parameters
}
  
rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Clients" as FAFR002
  usecase "FAFR003: Review Predictive Analytics on Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004
  
  FA --> (FAFR001, FAFR002, FAFR003, FAFR004)
}

rectangle "System Core Functions" {
  usecase "SFR001-02: Notify Users of Alerts/Recommendations" as SFR001
  usecase "SFR003: Request Financial Predictions from AI" as SFR003
  usecase "SFR004: Deliver Personalized Recommendations to Client" as SFR004
  usecase "SFR005: Alert on Exceeded Spending Limits" as SFR005
  usecase "SFR006: Identify Investment Opportunities Based on Risk Profile" as SFR006
  usecase "SFR007: Find ESG-Compliant Investments for Users" as SFR007
  usecase "SFR008: Detect Anomalous Transactions via AML Compliance" as SFR008
  usecase "SFR009: Extract News Relevant to Portfolio" as SFR009
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "SFR013: Manage Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Provide Financial Analytics to Users" as SFR014

  S --> (SFR001, SFR003-SFR014)
}

rectangle "AI System Functions" {
  usecase "AIFR001-09: Generate Predictions/Recommendations/Alerts" as AIFR001
    AIFR001 <|-- (S) : Request data for predictions

  S --> AIFR001 : Provide historical data, trends, etc.
}

rectangle "User Feedback Loop" {
  usecase "CFR11: Send System Feedback" as CFR11
  
  C1 --> CFR11
}
  
C1 <|-- (SFR003-SFR014) : Request services

@enduml