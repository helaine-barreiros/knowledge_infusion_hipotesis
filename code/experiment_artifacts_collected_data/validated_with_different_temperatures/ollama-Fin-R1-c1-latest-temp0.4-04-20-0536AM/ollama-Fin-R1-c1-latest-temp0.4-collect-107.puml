@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Data and Trends" as CFR003
  usecase "CFR004: Personalized Recommendations Aligned with Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts Exceeding Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Stay Informed with News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidated Personalized Dashboard for Finances" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10

  Client --> CFR001 : View financial data in a dashboard.
  Client --> CFR002 : Receive alerts on anomalous transactions.
  Client --> CFR003 : Get predictions based on historical and market trends.
  Client --> CFR004 : Obtain personalized recommendations tailored to profile.
  Client --> CFR005 : Adjust preferences for recommendations relevance.
  Client --> CFR006 : Monitor spending limits via alerts.
  Client --> CFR007 : Discover investment opportunities matching risk profile.
  Client --> CFR008 : Access portfolio-related news updates.
  Client --> CFR009 : Use a single view to manage all financial info.
  Client --> CFR10 : Control sharing and permissions with advisors.

}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Clients" as FAFR002
  usecase "FAFR003: Review Predictive Analytics of Client Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Segments" as FAFR004

  FinancialAdvisor --> FAFR001 : Schedule and track mentoring sessions.
  FinancialAdvisor --> FAFR002 : Monitor client alerts for proactive assistance.
  FinancialAdvisor --> FAFR003 : Analyze predictive data to guide clients.
  FinancialAdvisor --> FAFR004 : Customize system settings per client segments.

}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001

  SysAdmin --> SAFR001 : Adjust parameters for AI accuracy and compliance.

}

rectangle "System (SFR)" {
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AIFR" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AIFR" as SFR004
  usecase "SFR005: Send Spending Limit Alerts to Client via AI" as SFR005
  usecase "SFR006: Generate Investment Opportunity Analysis for Client" as SFR006
  usecase "SFR007: Find Specific Investments Matching Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Detect Anomalous Transactions via AI Alerts" as SFR008
  usecase "SFR009: Extract Relevant News for Client Portfolios" as SFR009
  usecase "SFR10: Generate Contextualized News Insights Based on Portfolio" as SFR10
  usecase "SFR11: Identify Predictive Interventions Needed by Advisors" as SFR11
  usecase "SFR12: Provide Financial Health Reports for Users" as SFR12

  Sys --> SFR002 : Deliver personalized recommendations.
  Sys --> SFR003 : Request financial predictions from AIFR.
  Sys --> SFR004 : Request personalized recs based on user data and preferences.
  Sys --> SFR005 : Send spending limit alerts via AI component.
  Sys --> SFR006 : Generate investment opportunities aligned with risk profile.
  Sys --> SFR007 : Find ESG-compliant investments matching client criteria.
  Sys --> SFR008 : Detect AML-related anomalies using pattern recognition.
  Sys --> SFR009 : Extract portfolio-relevant news from sources.
  Sys --> SFR10 : Generate contextualized news insights tied to portfolios.
  Sys --> SFR11 : Identify when advisors should intervene based on patterns.
  Sys --> SFR12 : Create financial health reports using standard metrics.

}

rectangle "AI System (AIFR)" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Personalize Recommendations Based on Profile and Goals" as AIFR002
  usecase "AIFR003: Alert On Exceeding Spending Limits" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities Against Risk Profiles" as AIFR004
  usecase "AIFR005: Identify Alignable Investments Based on Strategies and MPT" as AIFR005
  usecase "AIFR006: Detect Anomalous Transactions via Pattern Recognition" as AIFR006
  usecase "AIFR007: Correlate News with Portfolios for Client Insights" as AIFR007
  usecase "AIFR008: Recommend Interventions When Needed by Advisors" as AIFR008

  AI --> AIFR001 : Analyze data and trends to predict financial outcomes.
  AI --> AIFR002 : Tailor recommendations based on user's profile, goals, risk tolerance.
  AI --> AIFR003 : Flag spending deviations exceeding thresholds for alerts.
  AI --> AIFR004 : Evaluate investments against client-specific criteria and MPT principles.
  AI --> AIFR005 : Find matching investments that align with clients' strategies.
  AI --> AIFR006 : Spot potential fraud via pattern recognition in transactions.
  AI --> AIFR007 : Cross-reference news articles to portfolio relevance for users.
  AI --> AIFR008 : Suggest advisor actions based on predictive analysis of client data.

}

client "Client" <|-- Sys
SysAdmin <|-- SAFR001

@enduml