@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Alert Preferences" as SAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Manage Relationship with Advisors" as CFR009

  rectangle "Client Interactions" {
    actor Client as c1
    client --> CFR001 : View financial data and insights.
    client --> CFR003 : Receive forecasts based on historical and market trends.
    client --> CFR004 : Get personalized investment advice aligned with profile.
    client --> CFR005 : Adjust personalization settings for recommendations.
    client --> CFR006 : Monitor spending limits via alerts.
    client --> CFR007 : Explore suitable investments per risk tolerance.
    client --> CFR008 : Stay informed about portfolio-related news.
  }

  rectangle "Alert Management" {
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
    usecase "SAFR002: Manage Alert Preferences" as SAFR002

    client --> SFR013 : Receive alerts about critical financial events.
  }

  rectangle "System Admin & Advisor Interactions" {
    actor SysAdmin as sa
    actor FinancialAdvisor as fa

    sysadmin --> SAFR001 : Configure analysis parameters for AI system compliance with regulations like Basel III, FATF.

    financialadvisor --> FAFR002 : Review client intervention alerts.
  }

  rectangle "AI System Operations" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004

    client --> AIFR001 : Request financial predictions.
  }

  rectangle "Feedback Loop" {
    actor User as u
    user --> CFR011 : Provide feedback to improve system outputs.

    usecase "SFR020: Manage User Feedback" as SFR020

    u --> SFR020 : Send comments and suggestions.
  }
}

@enduml