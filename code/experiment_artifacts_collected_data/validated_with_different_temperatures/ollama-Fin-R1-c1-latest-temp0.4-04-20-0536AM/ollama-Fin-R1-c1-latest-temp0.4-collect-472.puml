@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR005: Manage Personalized Recommendations Preferences" as CFR005
  usecase "SFR014: Generate Client Analytics for Insights into Financial Behavior" as SFR014
  usecase "SFR020: Maintain Historical Record of User Insights for Trend Analysis" as SFR020

  actor "Client" as C
  actor "Financial Advisor (FA)" as FA
  actor "System Administrator (SA)" as SA
  
  
  C --> CFR001 : View dashboard
  C --> CFR003 : Request predictions
  C --> SAFR001 : Manage parameters
  C --> FAFR004 : Configure segments for clients
  C --> SFR020 : Maintain history

  FA --> FAFR002 : Review alerts
  FA --> FAFR003 : View analytics
  FA --> FAFR005 : Adjust client parameters
  
  SA --> SAFR001 : Administer system settings
}

@enduml