@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage User Permissions and Data Sharing with Advisors" as SAFR002
  usecase "CFR003: View Historical Market Trends for Predictions" as CFR003
  usecase "SFR009: Request Contextualized News Insights from AI Component" as SFR009
  usecase "AIFR001: Generate Financial Predictions Based on Data and Trends" as AIFR001
  
  
  Client --> CFR001 : View financial insights dashboard\nClient -> SAFR002 : Manage data sharing with advisors\nClient -> CFR003 : Access market trends for predictions\nClient -> SFR009 : Request news related to portfolio\nClient -> AIFR001 : Receive financial recommendations
  
  SysAdmin --> SAFR002: Configure system settings and permissions
}

@enduml