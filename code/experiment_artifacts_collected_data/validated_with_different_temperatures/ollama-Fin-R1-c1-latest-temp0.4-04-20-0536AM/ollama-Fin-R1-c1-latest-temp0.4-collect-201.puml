@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Anomaly Detection Parameters" as SAFR002
  usecase "FAFR005: Configure Client Segments for Analysis" as FAFR005
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR006: Request Spending Limit Alerts from AI Component" as SFR006
  usecase "SFR007: Request Investment Opportunity Analysis from AI Component" as SFR007
  usecase "SFR008: Find Specific Investment Opportunities Based on ESG Preferences" as SFR008
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002

  client --> CFR001 : "View Financial Insights Dashboard"
  
  SysAdmin --> SAFR001, SAFR002, FAFR005 : (Manage Analysis Parameters), ("Manage Anomaly Detection Parameters"), ("Configure Client Segments for Analysis")
  User --> SFR003, SFR004, SFR006, SFR007, SFR008, AIFR002 : "Request Financial Predictions", "Request Personalized Recommendations", "Request Spending Limit Alerts", ("Request Investment Opportunity Analysis"), ("Find Specific Investment Opportunities Based on ESG Preferences"), ("Generate Personalized Recommendations for Users")
  FAFR001 --> FAFR005, SFR003, AIFR002 : (Manage Client Mentoring Sessions), "Configure Client Segments", ("Generate Personalized Recommendations")

}

@enduml