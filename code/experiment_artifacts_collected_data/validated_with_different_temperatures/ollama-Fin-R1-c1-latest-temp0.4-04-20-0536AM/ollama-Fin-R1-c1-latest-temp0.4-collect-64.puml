@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  
  client --> CFR001 : View financial data and insights  
  client --> FAFR002 : Receive alerts for potential issues  
  client --> SFR013 : Get timely notifications on critical events  
  client --> CFR009 : Consolidate all info in one place  
  client --> AIFR007 : Stay informed about market impacts  

  systemAdmin --> SAFR001 : Configure analysis settings for accuracy and compliance  
}

actor "Client" as Client
actor "System Administrator" as SysAdmin
actor "Financial Advisor" as FAFRA

package Professional {
  actor FinancialAdvisor as FAFRA
}
system boundary rectangle System {
  
}

@enduml