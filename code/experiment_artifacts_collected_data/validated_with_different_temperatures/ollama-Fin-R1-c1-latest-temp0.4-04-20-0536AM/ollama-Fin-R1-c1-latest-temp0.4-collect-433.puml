@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor FinancialAdvisor as fa1
actor SysAdmin as sa1
system :System: as sys

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds" as CFR006
  usecase "CFR007: View Investment Opportunities Suitable to Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Manage Relationship with Financial Advisors, Including Data Sharing Permissions" as CFR009

}

rectangle "FinancialAdvisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
}

rectangle "SysAdmin" {
  usecase "SAFR001: Manage Analysis Parameters to Ensure Accuracy and Compliance with Basel III" as SAFR001

}

system :System: as sys {

  usecase "SFR002: Deliver Personalized Recommendations Based on Financial Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts When Exceeding Thresholds" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis Based on Risk Profile" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Matching Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts for Fraud Detection in Accordance with AML Regulations" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Portfolio" as SFR009
  usecase "SFR010: Process Contextualized News to Extract Relevance" as SFR010
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics for Financial Behavior and Performance Insights" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
  usecase "SFR016: Enhance Value of Financial Guidance with Predictive Insights" as SFR016
  usecase "SFR017: Generate Financial Health Reports Based on Standard Metrics" as SFR017

}

system :AI System (AIFR) {
  usecase "AIFR002: Generate Personalized Recommendations Aligned with Financial Profile and Goals" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts Based on Unusual Deviations in Spending Patterns" as AIFR003
  usecase "AIFR004: Identify Investment Opportunities That Align With Risk Profiles and Financial Goals" as AIFR004
  usecase "AIFR005: Recommend Investments According to Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Detect Potentially Fraudulent Activities Using Pattern Recognition in Compliance with FinCEN Requirements" as AIFR006
  usecase "AIFR007: Correlate Financial News With Portfolios to Identify Relevant Impacts" as AIFR007
}

usecase "CFR011: Send Feedback About System Outputs for Improvement" as CFR011

