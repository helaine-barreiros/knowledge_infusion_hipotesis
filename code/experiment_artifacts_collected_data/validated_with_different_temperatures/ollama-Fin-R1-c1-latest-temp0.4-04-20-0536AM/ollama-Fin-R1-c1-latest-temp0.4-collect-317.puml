@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: Access Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Get Personalized Recommendations Aligned with My Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Stay Informed with Related News for My Portfolio" as CFR008
  usecase "CFR009: Consolidate Financial Information in a Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship With Financial Advisors, Including Data Sharing Permissions" as CFR10

  Client --> CFR001 : View dashboard with financial data
  Client --> CFR002 : Receive alerts on anomalous transactions
  Client --> CFR003 : Access predictions based on history and trends
  Client --> CFR004 : Get personalized recommendations aligned to profile
  Client --> CFR005 : Manage recommendation preferences
  Client --> CFR006 : View spending limit alerts when thresholds exceeded
  Client --> CFR007 : Access investment opportunities matching risk profile
  Client --> CFR008 : Stay informed with portfolio-related news
  Client --> CFR009 : Consolidate financial info in a single view
  Client --> CFR10 : Manage data sharing and permissions for advisors

}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts When System Detects Patterns Requiring Professional Attention" as FAFR002
  usecase "FAFR003: Review Predictive Analytics About Clients' Financial Situations for Consultation" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments to Customize System Behavior According to Regulatory Requirements (e.g., GDPR)" as FAFR004

  FinancialAdvisor --> FAFR001 : Manage mentoring sessions with insights
  FinancialAdvisor --> FAFR002 : View intervention alerts when needed
  FinancialAdvisor --> FAFR003 : Review predictive analytics for consultations
  FinancialAdvisor --> FAFR004 : Configure analysis parameters per client segment

}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters to Ensure Accuracy and Compliance with Basel III or Similar Regulations" as SAFR001
  SystemAdmin --> SAFR001 : Manage system's analytical settings for compliance
}

rectangle "System (SFR)" {
  usecase "SFR002: Deliver Personalized Recommendations Based on Financial Profiles" as SFR002
  usecase "SFR003: Request Predictive Insights from AI Component" as SFR003
  usecase "SFR004: Generate Client Dashboards for Intuitive Presentation of Data" as SFR004
  usecase "SFR015: Request Intervention Analyses From AI to Identify When Advisors Should Engage Clients" as SFR015

  System --> SFR002 : Deliver personalized recommendations
  System --> SFR003 : Request predictive insights from AI
  System --> SFR004 : Generate client dashboards
  System --> SFR015 : Request intervention analyses for advisor engagement timing
}

rectangle "AI Component (AIFR)" {
  usecase "AIFR002: Generate Personalized Recommendations Based on Financial Profiles" as AIFR002
  usecase "AIFR003: Identify Spending Limit Alerts by Analyzing Unusual Patterns in User Data" as AIFR003
  usecase "AIFR004: Evaluate Investment Opportunities Against Risk Tolerance and Portfolio Goals" as AIFR004

  AI --> AIFR002 : Generate personalized recommendations
  AI --> AIFR003 : Identify spending limit alerts via pattern recognition
  AI --> AIFR004 : Analyze investment opportunities based on risk profile
}

rectangle "Feedback Management" {
  usecase "CFR11: Send Feedback to Improve System Accuracy and Relevance" as CFR11

  Client --> CFR11 : Provide feedback for system improvement
}
@enduml