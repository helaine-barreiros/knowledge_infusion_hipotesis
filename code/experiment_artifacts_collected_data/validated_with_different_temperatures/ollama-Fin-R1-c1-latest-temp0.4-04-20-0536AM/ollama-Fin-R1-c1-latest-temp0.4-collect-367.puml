@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Data and Trends" as CFR003
  usecase "CFR004: Get Personalized Recommendations Aligned with Goals" as CFR004
  usecase "CFR005: Manage Recommendation Preferences in KYC Profile" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Portfolio" as CFR008
  usecase "CFR009: View Consolidated Financial Dashboard" as CFR009
  usecase "CFR010: Manage Relationship with Advisors Including Data Sharing Permissions" as CFR010

  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  usecase "FAFR001: Schedule Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts from System" as FAFR002
  usecase "FAFR003: Review Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Segments" as FAFR004

  usecase "SFR001: Deliver Alerts to Users via Notifications" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Trigger Spending Limit Alerts When Exceeding Thresholds" as SFR005
  usecase "SFR006: Identify Investment Opportunities Based on Risk Profiles" as SFR006
  usecase "SFR007: Find Specific Investments Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Detect Anomalous Transactions for AML Compliance" as SFR008
  usecase "SFR009: Extract Relevant News Contextualized to Portfolios" as SFR009
  usecase "SFR010: Generate Client Dashboards with Financial Information" as SFR010
  usecase "SFR011: Process Contextualized News for User Insights" as SFR011
  usecase "SFR012: Request Predictive Intervention Analyses from AI Component" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Produce Client Analytics for Financial Behavior and Performance" as SFR014
  usecase "SFR015: Request Predictive Insights from AI Component to Enhance Guidance" as SFR015
  usecase "SFR016: Generate Financial Health Reports Based on Standard Metrics" as SFR016
  usecase "SFR017: Track Users' Financial Goals and Progress" as SFR017
  usecase "SFR018: Maintain Historical Record of Insights for Trend Analysis" as SFR018
  usecase "SFR019: Manage User Feedback to Improve System Quality" as SFR019

  usecase "AIFR001: Generate Financial Predictions Using Data and Trends" as AIFR001
  usecase "AIFR002: Produce Personalized Recommendations Based on Profiles" as AIFR002
  usecase "AIFR003: Alert Users When Exceeding Spending Limits" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities Against Risk Tolerance" as AIFR004
  usecase "AIFR005: Identify Financial Instruments Aligning with Strategic Portfolios" as AIFR005
  usecase "AIFR006: Detect Anomalous Transactions for Regulatory Compliance" as AIFR006
  usecase "AIFR007: Correlate News to User Portfolios for Relevant Insights" as AIFR007
  usecase "AIFR008: Recommend Proactive Client Interventions Based on Patterns" as AIFR008
  usecase "AIFR009: Provide Forward-Looking Analysis of Financial Situations" as AIFR009

  actor "Client" as C1
  actor "Financial Advisor" as FA2
  actor "System Administrator" as SA3

  Client --> CFR001 : View dashboard with financial data.
  Client --> CFR002 : Receive alerts on anomalous transactions.
  Client --> CFR003 : Access financial predictions based on trends and data.
  Client --> CFR004 : Get personalized recommendations tailored to goals.
  Client --> CFR005 : Adjust preferences in KYC profile for recommendations.
  Client --> CFR006 : Monitor spending limit alerts via dashboard.
  Client --> CFR007 : Explore investment opportunities aligned with risk profiles.
  Client --> CFR008 : Stay informed about market news affecting investments.
  Client --> CFR009 : Access a consolidated view of all financial data in one place.
  Client --> CFR010 : Manage interactions and permissions with advisors.

  Financial Advisor --> FAFR002 : View client intervention alerts to proactively assist clients.
  Financial Advisor --> FAFR003 : Review predictive analytics for better guidance during consultations.
  Financial Advisor --> FAFR004 : Customize analysis parameters per client segment or profile requirements.

  System Administrator --> SAFR001 : Manage AI system's analysis parameters for compliance and accuracy.

  SysAdmin <|-- (Client) : Can access certain features via the system.
  
  SFR002 -> Client : Provide personalized recommendations directly to clients.
  SFR003 -> AIFR001 : Request financial predictions from AI component.
  SFR004 -> AIFR002 : Ask for personalized recommendations based on user profiles.
  SFR005 -> AIFR003 : Trigger spending limit alerts when thresholds are exceeded.
  SFR006 -> AIFR004 : Identify investment opportunities matching risk profiles.
  SFR007 -> AIFR005 : Find specific investments that align with user criteria and ESG preferences.
  SFR008 -> AIFR006 : Detect anomalous transactions for compliance checks (AML).
  SFR009 -> AIFR007 : Extract relevant news based on portfolio context.
  SFR010 -> Client : Generate dashboards with consolidated financial information.
  SFR013 -> Client : Send alerts when conditions are met.
  
  AIFR002 <|-- (Client) : Aligns recommendations to client profiles and goals.

  rectangle "System" {
    usecase "SFR009: Extract Relevant News Contextualized to Portfolios" as SFR009
    usecase "AIFR007: Correlate News to User Portfolios for Relevant Insights" as AIFR007

    SFR009 --> Client : Provide relevant news based on portfolio context.
  }

' Grouping actors by role
package Professional {
  actor FinancialAdvisor as FA2
}
rectangle "System" {
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004

  FinancialAdvisor --> FAFR004 : Customize analysis parameters based on client segments or profiles.
}

' System boundary components
system "AI-Driven Insights & Management Platform" as Sys {
  rectangle Professional {}
  
  usecase "CFR011: Send Feedback to Improve Recommendations and Insights" as CFR011

  Client --> CFR011 : Provide feedback for system improvement.

}
@enduml