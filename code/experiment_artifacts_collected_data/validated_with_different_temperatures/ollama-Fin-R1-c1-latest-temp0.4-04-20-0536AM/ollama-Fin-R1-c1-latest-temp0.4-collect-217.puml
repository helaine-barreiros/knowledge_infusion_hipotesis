@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sas
actor FinancialAdvisor as fa
system "System" as sys

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Access Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile (MiFID II)" as CFR007
  usecase "CFR008: Receive News Related to Investment Portfolio" as CFR008
  usecase "CFR009: View Consolidated Financial Dashboard for Efficient Monitoring" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors Including Data Sharing Permissions" as CFR10

  c1 --> CFR001 : "View financial data"
  c1 --> CFR002 : "Receive alerts about anomalous transactions"
  c1 --> CFR003 : "View predictions based on historical and market trends"
  c1 --> CFR004 : "Access personalized recommendations aligned with profile"
  c1 --> CFR005 : "Manage preferences for recommendations"
  c1 --> CFR006 : "Receive spending limit alerts when exceeding thresholds"
  c1 --> CFR007 : "View investment opportunities based on risk profile"
  c1 --> CFR008 : "Access news related to portfolio"
  c1 --> CFR009 : "Monitor finances via consolidated dashboard"
  sas --> CFR10 : "Manage data sharing permissions"

}

rectangle "System Admin Interface" {
  usecase "SAFR001: Manage Analysis Parameters for AI System Compliance with Financial Regulations (Basel III)" as SAFR001

  sas --> SAFR001 : "Adjust parameters to ensure compliance"
}
  
rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment (GDPR/CCPA)" as FAFR004

  fa --> FAFR001 : "Schedule and track mentoring sessions"
  fa --> FAFR002 : "Review alerts for proactive client support"
  fa --> FAFR003 : "Analyze predictive data during consultations"
  sas --> FAFR004 : "Set segment-specific parameters"

}

rectangle "System Core" {
  usecase "SFR001: Deliver Alerts Through Notification Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts When Exceeding Thresholds" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis Based on Risk Profiles" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts Compliant with AML Regulations (FinCEN)" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Portfolio From Trusted Sources" as SFR009
  usecase "SFR010: Extract Relevant Information for Users' Financial Situations" as SFR010
  usecase "SFR012: Generate Client Dashboards Intuitively" as SFR012
  usecase "SFR013: Generate Alerts Based on Predefined Conditions (Client)" as SFR013
  usecase "SFR014: Provide Financial Analytics for User Insights" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses From AI Component For Client Engagement Timing" as SFR015
  usecase "SFR016: Enhance Value of Financial Guidance via AI-Generated Insights (Client)" as SFR016
  usecase "SFR017: Generate Financial Health Reports Based on Standard Metrics" as SFR017
  usecase "SFR018: Track Progress Towards Financial Goals and Provide Recommendations" as SFR018
  usecase "SFR019: Maintain Historical Record of Insights for Trend Analysis (Client)" as SFR019

}

rectangle "AI Component" {
  usecase "AIFR001: Generate Financial Predictions From Transaction Data, Market Trends, Economic Indicators" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations Based on User Profiles and Goals (FINRA)" as AIFR002
  usecase "AIFR003: Identify Spending Limit Alerts for Unusual Patterns in Data" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities Against Risk Profiles, Time Horizons and Financial Goals (MPT)" as AIFR004
  usecase "AIFR005: Identify Aligning Investments With User Strategies and MPT Principles" as AIFR005
  usecase "AIFR006: Detect Anomalous Transactions Using Pattern Recognition For Fraud Prevention (FinCEN)" as AIFR006
  usecase "AIFR007: Correlate Financial News With Portfolios To Identify Relevant Impacts" as AIFR007
  usecase "AIFR008: Recommend Proactive Client Interventions Based on Patterns In Data (Advisor)" as AIFR008
  usecase "AIFR009: Provide Forward-Looking Analysis For Effective Financial Planning (Client)" as AIFR009

}

sas --> sys : "Manage system parameters"
fa --> sys : "Request client-related services"

sys <|-- SFR012 : "Generate dashboards for clients"
sys <|-- SFR008 : "Identify anomaly alerts and deliver them to clients or advisors"
sys <|-- AIFR003 : "Monitor spending patterns for alerts"
sys <|-- AIFR006 : "Detect potential fraud through transaction analysis"

@enduml