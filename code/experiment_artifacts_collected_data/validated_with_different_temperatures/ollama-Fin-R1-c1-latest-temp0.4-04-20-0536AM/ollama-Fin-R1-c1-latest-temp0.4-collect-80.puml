@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003  
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004  
  usecase "SFR019: Maintain Historical Record of Users' Insights" as SFR019
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002

  Client --> CFR001 : "View Financial Insights Dashboard"
  SysAdmin --> SAFR001 : "Manage Analysis Parameters"

  // User (Client, Advisor) interactions
  Client --> FAFR002 : "View Client Intervention Alerts"
  
  // System-to-System or AI interactions
  SFR003 <|-- AIFR009 : "Request Financial Predictions from AI Component" 
  SFR004 <|-- AIFR008 : "Request Personalized Recommendations from AI Component"

  Client --> SFR019 : "Maintain Historical Record of Users' Insights"
  
}

@enduml