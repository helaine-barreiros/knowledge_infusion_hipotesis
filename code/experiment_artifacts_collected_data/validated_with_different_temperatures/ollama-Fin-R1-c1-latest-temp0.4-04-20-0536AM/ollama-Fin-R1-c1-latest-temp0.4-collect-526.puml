@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001

  // Client Use Cases
  Client --> CFR001 : View financial data, consolidate info in a single dashboard.
  
  // System Administrator Use Cases
  SysAdmin --> SAFR001 : Manage analysis parameters to ensure accuracy and compliance.

  // Financial Advisor Use Cases
  FAFR002 <|-- (Client) : Receive alerts when system detects patterns needing professional attention. 

  // AI Component Use Cases
  AIFR001 <|-- (SFR003, SAFR001) : Generate financial predictions and manage parameters.
  
}

@enduml