@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sa
actor FinancialAdvisor as fa
system :System: as sys

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile (MiFID II)" as CFR007
  usecase "CFR008: Receive News Related to Investment Portfolio" as CFR008
  usecase "CFR009: View Consolidated Financial Information in a Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors Including Data Sharing Permissions" as CFR10

}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters to Ensure Algorithm Accuracy and Compliance with Basel III" as SAFR001

}

system :System: as sys {

  usecase "SFR002: Deliver Personalized Recommendations Based on Financial Profiles" as SFR002
  usecase "SFR003: Request AI Component for Financial Predictions" as SFR003
  usecase "SFR004: Request AI Component for Personalized Recommendations" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis From AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component for AML Compliance" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Portfolios From Trusted Sources" as SFR009
  usecase "SFR010: Process Contextualized News To Extract Relevance For User's Portfolio" as SFR010
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions for Timely Notification" as SFR013
  usecase "SFR020: Manage Historical Record of Users' Insights to Enable Trend Analysis and Effectiveness Measurement" as SFR020

}

system :AI System: {
  usecase "AIFR001: Generate Financial Predictions Based on Historical Data, Market Trends, & Economic Indicators" as AIFR001
  usecase "AIFR004: Identify Investment Opportunities Aligning With User's Risk Profile and Modern Portfolio Theory Principles" as AIFR004
}

client --> CFR001 : c1 wants to view financial insights.
client --> CFR002 : c1 needs alerts for anomalous transactions.
client --> CFR003 : c1 seeks market trend-based predictions.
client --> CFR004 : c1 requires personalized recommendations based on profile.
client --> CFR005 : c1 adjusts preferences for recs.
client --> CFR006 : c1 monitors spending limits via alerts.
client --> CFR007 : c1 explores investment options per risk profile (MiFID II).
client --> CFR008 : c1 stays informed on portfolio-related news.
client --> CFR009 : c1 consolidates info in a single view dashboard.
client --> CFR10 : c1 manages data sharing with advisors.

financialAdvisor --> FAFR003 : fa wants predictive analytics for clients.
financialAdvisor --> FAFR002 : fa needs intervention alerts proactively.
financialAdvisor --> FAFR001 : fa requires mentoring session management based on insights.

sysAdmin --> SAFR001 : sa manages analysis parameters ensuring compliance with Basel III.

system --> SFR003: sys requests AI for predictions (CFR003).
system --> SFR004: sys requests AI recs per user profile.
system --> SFR005: sys gets spending limit alerts from AI component.
system --> SFR006: sys asks AI about investment opportunities based on risk profiles and ESG.

aiSystem --> AIFR001 : ai generates financial predictions using data, trends, indicators (SFR003).
aiSystem --> AIFR004 : ai finds investments matching user's profile via MPT principles (SFR006).

@enduml