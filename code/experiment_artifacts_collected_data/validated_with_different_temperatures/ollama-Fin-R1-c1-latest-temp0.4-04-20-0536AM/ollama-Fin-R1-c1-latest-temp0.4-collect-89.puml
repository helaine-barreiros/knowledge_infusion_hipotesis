  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Personalized Recommendations Based on Profile" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Spent Limit Alerts for Budget Control" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidated Financial Dashboard" as CFR009
  usecase "CFR010: Manage Relationship with Advisors" as CFR010
  
  Client --> CFR001 : View dashboard\nClient --> CFR002 : Receive alerts\nClient --> CFR003 : Predictions based on data and trends\nClient --> CFR004 : Personalized recommendations aligned to profile\nClient --> CFR005 : Manage preferences for relevance\nClient --> CFR006 : Alerts when exceeding spending limits\nClient --> CFR007 : Investment opportunities matching risk profile\nClient --> CFR008 : Portfolio-related news updates\nClient --> CFR009 : Consolidated view of finances\nClient --> CFR010 : Control data sharing with advisors
