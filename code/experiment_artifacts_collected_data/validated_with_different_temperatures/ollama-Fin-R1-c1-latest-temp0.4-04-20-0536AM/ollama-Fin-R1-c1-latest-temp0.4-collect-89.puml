  FinancialAdvisor --> FAFR001 : Manage mentoring\nFinancialAdvisor --> FAFR002 : Monitor alerts requiring attention\nFinancialAdvisor --> FAFR003 : Review predictive data for clients\nFinancialAdvisor --> FAFR004 : Customize analysis settings per segment
}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SysAdmin --> SAFR001 : Adjust system parameters to ensure accuracy and compliance with regulations like Basel III.
}

rectangle "System (SFR)" {
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
