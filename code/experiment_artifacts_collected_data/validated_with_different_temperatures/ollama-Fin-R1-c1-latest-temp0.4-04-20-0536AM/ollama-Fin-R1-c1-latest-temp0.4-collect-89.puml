  usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Based on ESG and Risk Profile" as SFR007
