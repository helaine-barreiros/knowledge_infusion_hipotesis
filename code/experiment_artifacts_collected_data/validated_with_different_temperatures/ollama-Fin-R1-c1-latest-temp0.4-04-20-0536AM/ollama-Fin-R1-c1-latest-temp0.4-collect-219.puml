@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sa
actor FinancialAdvisor as fa
system "System" as sys

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002  
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Access Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Receive Spending Limit Alerts" as CFR006  
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007 
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Manage Personalized Dashboard" as CFR009  
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10

  c1 --> CFR001 : View financial insights dashboard
  c1 --> CFR002 : Receive alerts for anomalous transactions
  c1 --> CFR003 : View financial predictions 
  c1 --> CFR004 : Access personalized recommendations  
  c1 --> CFR005 : Manage recommendation preferences  
  c1 --> CFR006 : Receive spending limit alerts when exceeding thresholds  
  c1 --> CFR007 : View investment opportunities based on risk profile
  c1 --> CFR008 : Access news related to portfolio 
  c1 --> CFR009 : Manage personalized dashboard  
  c1 --> CFR10 : Manage relationship with financial advisors  

}

rectangle "System Administrator Interface" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  sa --> SAFR001 : Manage analysis parameters for AI system to ensure accuracy and compliance

}
  
rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002 
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003  
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004  

  fa --> FAFR001 : Manage client mentoring sessions based on system-generated insights
  fa --> FAFR002 : View client intervention alerts when patterns detected requiring professional attention  
  fa --> FAFR003 : View predictive analytics about clients' financial situations for data-driven recommendations during consultations  
  fa --> FAFR004 : Configure analysis parameters by specific client segments to customize system's behavior  

}

rectangle "System Functionalities" {
  usecase "SFR001: Deliver Alerts Through Notification Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Profiles" as SFR002  
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003  
  usecase "SFR004: Request Personalized Recommendations From AI" as SFR004
  usecase "SFR005: Request Spending Limit Alerts Based on Thresholds Exceeded" as SFR005 
  usecase "SFR006: Request Investment Opportunity Analysis for Users" as SFR006  
  usecase "SFR007: Find Specific Investment Opportunities Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Detect Anomalous Transactions via AI Component in Compliance with AML Regulations" as SFR008 
  usecase "SFR009: Extract Relevant News for Users' Portfolios from Trusted Sources" as SFR009  
  usecase "SFR010: Process Contextualized News to Inform Financial Decisions" as SFR010
  usecase "SFR011: Request AI-Generated Client Dashboards" as SFR011 
  usecase "SFR012: Generate Client Alerts Based on Predefined Conditions" as SFR012  
  usecase "SFR013: Provide Client Analytics for Financial Behavior and Performance Insights" as SFR013
  usecase "SFR014: Request Predictive Intervention Analyses from AI Component" as SFR014 
  usecase "SFR015: Enhance Value of Financial Guidance via AI-Generated Interventions" as SFR015  
  usecase "SFR016: Generate Financial Health Reports Based on Standard Metrics" as SFR016
  usecase "SFR017: Track Users' Financial Goals and Progress" as SFR017 
  usecase "SFR018: Maintain Historical Record of Insights for Trend Analysis" as SFR019  
  usecase "SFR020: Manage User Feedback to Improve System Accuracy" as SFR020

  sys --> SFR001 : Deliver alerts through appropriate channels
  sys --> SFR002 : Provide personalized recommendations based on user profiles 
  sys --> SFR003 : Request financial predictions from AI component  
  sys --> SFR004 : Request personalized recommendations from AI component   
  sys --> SFR005 : Request spending limit alerts when thresholds exceeded
  sys --> SFR006 : Request investment opportunity analysis for users 
  sys --> SFR007 : Find specific investments matching user criteria and ESG preferences  
  sys --> SFR008 : Detect anomalous transactions via AI component in compliance with AML regulations   
  sys --> SFR009 : Extract relevant news from trusted sources
  sys --> SFR010 : Process contextualized news for financial decisions 
  sys --> SFR011 : Generate client dashboards  
  sys --> SFR012 : Generate client alerts based on conditions  
  sys --> SFR013 : Provide client analytics   
  sys --> SFR014 : Request predictive intervention analyses from AI component
  sys --> SFR015 : Enhance value of financial guidance via AI-generated insights 
  sys --> SFR016 : Generate financial health reports based on metrics  
  sys --> SFR017 : Track users' goals and progress   
  sys --> SFR018 : Maintain historical record for trend analysis
  sys --> SFR019 : Manage user feedback to improve system accuracy  

}

rectangle "AI Component" {
  usecase "AIFR001: Generate Financial Predictions Based on Data, Trends & Indicators" as AIFR001  
  usecase "AIFR002: Create Personalized Recommendations Aligning with Profiles and Goals" as AIFR002
  usecase "AIFR003: Identify Spending Limit Alerts via Pattern Recognition" as AIFR003 
  usecase "AIFR004: Analyze Investment Opportunities Against Risk Profiles & Modern Portfolio Theory Principles" as AIFR004  
  usecase "AIFR005: Find Financial Instruments Matching User Strategies and MPT" as AIFR005
  usecase "AIFR006: Detect Anomalous Transactions via Pattern Recognition in Compliance with FinCEN Rules" as AIFR006 
  usecase "AIFR007: Correlate Financial News to Portfolios for Relevant Insights" as AIFR007
  usecase "AIFR008: Recommend Interventions Based on Predictive Analysis of Client Patterns" as AIFR008  
  usecase "AIFR009: Provide Forward-Looking Financial Analyses to Support Planning" as AIFR009  

  sys --> AIFR001 : Generate financial predictions using historical data, trends, and indicators
  sys --> AIFR002 : Create personalized recommendations aligned with user profiles and goals  
  sys --> AIFR003 : Identify spending limit alerts via pattern recognition 
  sys --> AIFR004 : Analyze investment opportunities against risk profiles and MPT principles   
  sys --> AIFR005 : Find financial instruments matching user strategies and MPT
  sys --> AIFR006 : Detect anomalous transactions using pattern recognition in compliance with FinCEN  
  sys --> AIFR007 : Correlate news to portfolios for relevant insights 
  sys --> AIFR008 : Recommend interventions based on predictive analysis of client patterns  
  sys --> AIFR009 : Provide forward-looking financial analyses  

}

rectangle "User Feedback Loop" {
  usecase "CFR11: Send System Recommendations and Insights Feedback" as CFR11
  c1 --> CFR11 : Send feedback to improve system accuracy

}
@enduml