@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as C1
actor SysAdmin as SA
actor FinancialAdvisor as FA
system "System" as S

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Investment Portfolio" as CFR008
  usecase "CFR009: View Consolidated Financial Dashboard for Efficiency" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors Including Data Sharing Permissions" as CFR10

  C1 --> CFR001 : "View Financial Insights"
  C1 --> CFR002 : "Receive Alerts (FATF)"
  C1 --> CFR003 : "View Predictions Based on Historical and Market Trends"
  C1 --> CFR004 : "Receive Personalized Recommendations"
  C1 --> CFR005 : "Manage Recommendation Preferences"
  C1 --> CFR006 : "View Spending Limit Alerts (Budget Control)"
  C1 --> CFR007 : "Access Investment Opportunities Based on Risk Profile"
  C1 --> CFR008 : "Receive News Related to Portfolio"
  C1 --> CFR009 : "Consolidated Financial Dashboard"
  C1 --> CFR10 : "Manage Relationship with Advisors"

}

rectangle "System Administrator Interface" {
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001

  SA --> SAFR001
}

rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004

  FA --> FAFR001 : "Manage Mentoring"
  FA --> FAFR002 : "View Intervention Alerts (AML)"
  FA --> FAFR003 : "Predictive Analytics"
  FA --> FAFR004 : "Configure Parameters for Segments"

}

rectangle "System Core" {
  usecase "SFR001: Deliver Alerts Through Notification Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts From AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis From AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Based on ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts Compliant with AML Regulations" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Portfolio" as SFR009
  usecase "SFR010: Process Contextualized News for User Insights" as SFR010
  usecase "SFR011: Request AI-Generated News Insights Based on Portfolios" as SFR011
  usecase "SFR012: Generate Client Dashboards in Intuitive Format" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions (FATF)" as SFR013
  usecase "SFR014: Generate Client Analytics for Financial Behavior and Performance" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
  usecase "SFR016: Request Predictive Insights to Enhance Advisor Guidance (FINRA)" as SFR016
  usecase "SFR017: Generate Financial Health Reports Based on Standard Metrics" as SFR017
  usecase "SFR018: Manage Users' Financial Goals for Tracking Progress and Recommendations" as SFR018
  usecase "SFR019: Maintain Historical Record of Insights for Trend Analysis (GDPR)" as SFR019
  usecase "SFR020: Manage User Feedback to Improve System Quality" as SFR020

  S --> all the above usecases : "System Core Functions"
}

rectangle "AI Component" {
  usecase "AIFR001: Generate Financial Predictions Using Historical Data and Market Trends (Basel III)" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations Based on Profiles, Goals, Risk Tolerance (FINRA)" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts for Unusual Deviations from Patterns" as AIFR003
  usecase "AIFR004: Identify Investment Opportunities Based on Risk Profiles and Portfolio Theory" as AIFR004
  usecase "AIFR005: Select Financial Instruments That Align with User Strategies (MPT)" as AIFR005
  usecase "AIFR006: Detect Anomaly Transactions Using Pattern Recognition for Fraud Prevention (FinCEN)" as AIFR006
  usecase "AIFR007: Correlate Financial News with Portfolios to Extract Relevant Insights" as AIFR007
  usecase "AIFR008: Identify Patterns Indicating Need for Advisor Engagement (ESG)" as AIFR008
  usecase "AIFR009: Provide Forward-Looking Analysis of Financial Situations to Support Planning" as AIFR009

  S --> all the above usecases : "AI Component Functions"
}

SFR020 <|-- C1 : "Collect Feedback for System Improvement"

@enduml