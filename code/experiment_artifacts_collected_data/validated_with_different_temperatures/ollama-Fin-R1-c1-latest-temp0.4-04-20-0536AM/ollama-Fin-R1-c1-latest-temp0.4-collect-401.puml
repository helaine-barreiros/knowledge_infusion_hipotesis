@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sa
actor FinancialAdvisor as faa
system "System" as sys

rectangle Professional {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
}

rectangle ClientManagement {
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Personalized Recommendations Alignment" as CFR004
  usecase "CFR005: Manage Preferences for Recommendations" as CFR005
}

rectangle BudgetControl {
  usecase "CFR006: View Spending Limit Alerts" as CFR006
}

rectangle InvestmentManagement {
  usecase "CFR007: Access Suitable Investments Based on Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidated Financial Dashboard" as CFR009
}

rectangle RelationshipManagement {
  usecase "CFR10: Manage Client-Advisor Permissions" as CFR10
}

rectangle SystemAdminFunctions {
  usecase "SAFR002: Monitor AI Accuracy and Compliance" as SAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "SFR015: Schedule Client Interventions Based on Analysis" as SFR015
}

rectangle AIComponents {
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Issue Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities" as AIFR004
}

rectangle NewsProcessing {
  usecase "SFR019: Extract Relevant Financial News" as SFR019
}

c1 --> CFR001 : "View financial insights"
sa -> SAFR001 : "Manage analysis parameters"

c1 --> CFR002 : "Receive alerts on anomalous transactions (FATF)"
c1 --> CFR003 : "View financial predictions"
c1 --> CFR004 : "Personalized recommendations alignment with goals"
c1 --> CFR005 : "Adjust recommendation preferences based on KYC"

c1 --> CFR006 : "Receive spending limit alerts when exceeding thresholds"

faa -> CFR007 : "Access suitable investments aligned to risk profile (MiFID II)"
faa -> CFR008 : "Stay informed about market news affecting portfolio"
faa -> CFR009 : "Use consolidated dashboard for efficient monitoring"

c1 --> CFR10 : "Manage data sharing permissions with advisors"

sa -> SAFR002 : "Ensure AI accuracy and compliance (Basel III)"
fafa -> FAFR003 : "View client-specific predictive analytics"
sfr015 -> SFR016 : "Enhance advisory value via predictive insights"

aifr002 -> AIFR004 : "Generate investment opportunities based on risk profile"
aifr003 -> AIFR007 : "Detect and report potential fraud (AML)"
aifr008 -> SFR019 : "Identify relevant news for clients' portfolios"

sfr015 --> aifr006 : "Request anomaly transaction alerts from AI"

sys <|-- CFR002
sys <|-- CFR003
sys <|-- CFR004
sys <|-- CFR005
sys <|-- CFR006
sys <|-- CFR007
sys <|-- CFR008
sys <|-- CFR009
sys <|-- CFR10

sys <|-- SAFR002
sys <|-- FAFR003
sys <|-- SFR015

sa --> sys : "System Admin actions"
fafa --> sys : "Financial Advisor interactions"

@enduml