@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as C1
actor SysAdmin as SA
actor FinancialAdvisor as FA
system "System" as S

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile (MiFID II)" as CFR007
  usecase "CFR008: Receive News Related to Financial Portfolio" as CFR008
  usecase "CFR009: Consolidated Personalized Dashboard for Monitoring Finances" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors, Including Data Sharing Permissions" as CFR10

  C1 --> CFR001 : View financial data in a consolidated format.
  C1 --> CFR002 : Receive alerts about unusual transactions for fraud detection.
  C1 --> CFR003 : Get future predictions based on past and market trends.
  C1 --> CFR004 : Access personalized investment advice tailored to goals.
  C1 --> CFR005 : Adjust personalization settings as per KYC profile.
  C1 --> CFR006 : Monitor spending limits in specific categories.
  C1 --> CFR007 : Explore investments aligned with risk tolerance and regulatory standards (e.g., MiFID II).
  C1 --> CFR008 : Stay informed about market events affecting assets.
  C1 --> CFR009 : Access a single view of all financial information for efficiency.
  C1 --> CFR10 : Control data sharing with advisors to maintain privacy.

}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters (Basel III)" as SAFR001
  SA --> SAFR001 : Adjust system parameters ensuring regulatory compliance.
}

rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Schedule Client Mentoring Sessions Based on System Insights" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Proactive Client Support" as FAFR002
  usecase "FAFR003: Analyze Predictive Analytics to Guide Consultations" as FAFR003
  usecase "FAFR004: Customize Analysis Parameters by Client Segment (GDPR/CCPA)" as FAFR004

  FA --> FAFR001 : Schedule sessions using AI-generated insights.
  FA --> FAFR002 : Review alerts to preemptively assist clients with issues.
  FA --> FAFR003 : Use predictive data for evidence-based recommendations in meetings.
  FA --> FAFR004 : Tailor system settings per client group's regulatory and profile needs.

}

rectangle "System Core" {
  usecase "SFR001: Deliver Alerts via Notification Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
  usecase "SFR005: Monitor Spending Limits Against Thresholds" as SFR005
  usecase "SFR006: Identify Investment Opportunities Based on Risk Profile (MiFID II)" as SFR006
  usecase "SFR007: Find Contextualized News for Portfolios" as SFR007
  usecase "SFR008: Generate Client Dashboards with Financial Information" as SFR008
  usecase "SFR013: Manage Client Alerts Based on Predefined Conditions" as SFR013

  S --> CFR002 : Trigger alerts when transactions deviate from norms.
  S --> CFR004 : Generate personalized recommendations using AI.
  S --> CFR006 : Notify of spending limits breaches automatically.
  S --> CFR007 : Present investment options matching risk profiles and ESG criteria.
  S --> CFR008 : Supply relevant news to clients for portfolio management.

}

rectangle "AI Component" {
  usecase "AIFR001: Generate Financial Predictions Using Historical Data & Trends" as AIFR001
  usecase "AIFR002: Create Personalized Recommendations Based on Profiles and Goals (FINRA)" as AIFR002
  usecase "AIFR003: Detect Unusual Spending Patterns for Alerts" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities Against Risk Tolerance" as AIFR004
  usecase "AIFR005: Identify Financial Instruments Aligning with Portfolio Theory (MPT)" as AIFR005
  usecase "AIFR006: Spot Anomalous Transactions Using Pattern Recognition" as AIFR006
  usecase "AIFR007: Correlate News to Portfolios for Contextual Insights" as AIFR007

  S --> AIFR001 : Request future predictions from AI.
  S --> AIFR002 : Ask for personalized recommendations.
  S --> AIFR003 : Check spending limits against thresholds.
  S --> AIFR004 : Evaluate investment opportunities based on risk profiles.
  S --> AIFR005 : Recommend investments aligned with MPT principles.
  S --> AIFR006 : Flag potential fraud via transaction analysis.
}

rectangle "User Feedback Loop" {
  usecase "CFR11: Send System Recommendations/Insights for Improvement" as CFR11

  C1, FA, SA --> CFR11 : Provide feedback to enhance system accuracy and relevance.

}
@enduml