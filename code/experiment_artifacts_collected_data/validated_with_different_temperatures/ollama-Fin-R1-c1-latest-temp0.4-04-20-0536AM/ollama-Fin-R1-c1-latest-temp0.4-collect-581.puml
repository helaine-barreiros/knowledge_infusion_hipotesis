@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor FinancialAdvisor as fa1
actor SysAdmin as sa1
system "System" as sys

rectangle Professional {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: Access Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Obtain Personalized Recommendations Aligned with Financial Profile and Goals" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Expense Categories" as CFR006
  usecase "CFR007: Access Investment Opportunities Suitable to Risk Profile Under MiFID II Standards" as CFR007
  usecase "CFR008: Receive News Related to Investment Portfolio" as CFR008
  usecase "CFR009: View Consolidated Financial Information in a Single Dashboard" as CFR009
  usecase "CFR010: Manage Relationship with Financial Advisors Including Data Sharing Permissions" as CFR010

  c1 --> CFR001 : "View"
  c1 --> CFR002 : "Receive Alerts for Anomalous Transactions"
  c1 --> CFR003 : "Access Predictions Based on Historical and Market Trends"
  c1 --> CFR004 : "Get Personalized Recommendations"
  c1 --> CFR005 : "Manage Recommendation Preferences"
  c1 --> CFR006 : "View Spending Limit Alerts"
  c1 --> CFR007 : "See Investment Opportunities Aligning with Risk Profile"
  c1 --> CFR008 : "Receive Portfolio-Related News"
  c1 --> CFR009 : "Access Consolidated Dashboard"
  c1 --> CFR010 : "Manage Relationship with Advisors"

}

rectangle SystemAdmin {
  usecase "SAFR001: Manage Analysis Parameters for AI" as SAFR001
  sa1 --> SAFR001 : "Manage"
}

rectangle FinancialAdvisor {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Clients" as FAFR002
  usecase "FAFR003: Access Predictive Analytics about Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004

  fa1 --> FAFR001 : "Manage Mentoring Sessions"
  fa1 --> FAFR002 : "View Intervention Alerts"
  fa1 --> FAFR003 : "Access Predictive Analytics"
  fa1 --> FAFR004 : "Configure Parameters by Segment"

}

rectangle System {
  usecase "SFR001: Deliver Notifications to Users" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts Based on User Activity" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis for Users" as SFR006
  usecase "SFR007: Find Specific Investment Opportunities Matching Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Detect Anomalous Transactions Compliant with AML Regulations" as SFR008
  usecase "SFR009: Extract Contextualized News Relevant to Portfolios from Financial Sources" as SFR009
  usecase "SFR010: Generate Client Dashboards Intuitively" as SFR010
  usecase "SFR011: Process Contextualized News Insights for Users' Situations" as SFR011
  usecase "SFR012: Request Predictive Intervention Analyses from AI Component" as SFR012
  usecase "SFR013: Track Financial Goals and Progress" as SFR013
  usecase "SFR014: Manage Historical Records of Insights for Trend Analysis" as SFR014

  sys --> SFR001 : "Deliver"
  sys --> SFR002 : "Provide"
  sys --> SFR003 : "Request Predictions"
  sys --> SFR004 : "Request Recommendations"
  sys --> SFR005 : "Request Alerts"
  sys --> SFR006 : "Request Opportunity Analysis"
  sys --> SFR007 : "Find Opportunities"
  sys --> SFR008 : "Detect Anomalies"
  sys --> SFR009 : "Extract News Insights"
  sys --> SFR010 : "Generate Dashboards"
  sys --> SFR011 : "Process Contextualized News"
  sys --> SFR012 : "Request Intervention Analyses"
  sys --> SFR013 : "Track Goals and Progress"
  sys --> SFR014 : "Manage Historical Records"

}

rectangle AIComponent {
  usecase "AIFR001: Generate Financial Predictions Based on Data" as AIFR001
  usecase "AIFR002: Create Personalized Recommendations for Users" as AIFR002
  usecase "AIFR003: Issue Spending Limit Alerts When Exceeding Thresholds" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities Based on Risk Profile and Goals" as AIFR004
  usecase "AIFR005: Identify Suitable Investments Aligning with Portfolio Theory" as AIFR005
  usecase "AIFR006: Detect Anomalous Transactions Compliantly" as AIFR006
  usecase "AIFR007: Correlate Financial News to Portfolios for Insights" as AIFR007
  usecase "AIFR008: Recommend Interventions Based on Client Patterns" as AIFR008
  usecase "AIFR009: Provide Forward-Looking Analysis of Financial Situations" as AIFR009

  sys --> AIFR001 : "Generate Predictions"
  sys --> AIFR002 : "Create Recommendations"
  sys --> AIFR003 : "Issue Alerts"
  sys --> AIFR004 : "Analyze Opportunities"
  sys --> AIFR005 : "Identify Investments"
  sys --> AIFR006 : "Detect Anomalies"
  sys --> AIFR007 : "Correlate News Insights"
  sys --> AIFR008 : "Recommend Interventions"
  sys --> AIFR009 : "Provide Predictive Analysis"

}

usecase "CFR011: Send Feedback to Improve System" as CFR011
c1, fa1, sa1 -> CFR011 : "Send Feedback"

@enduml