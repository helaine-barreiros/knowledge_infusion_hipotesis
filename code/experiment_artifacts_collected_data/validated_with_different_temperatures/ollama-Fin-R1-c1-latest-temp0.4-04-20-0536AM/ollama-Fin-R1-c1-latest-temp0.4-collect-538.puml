@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Anomaly Alerts Thresholds" as SAFR002  
  usecase "FAFR005: Configure Client-Specific Analysis Parameters" as FAFR005
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "AIFR006: Generate Anomaly Transaction Alerts for Users" as AIFR006

  client --> CFR001 : View Financial Insights Dashboard  
  sysAdmin -> SAFR002 : Manage Analysis Parameters (e.g., thresholds, regulations) 
  financialAdvisor --> FAFR005 : Configure analysis parameters for specific clients
  system --> SFR013 : Generate alerts based on conditions like spending limits or market events
  aiSystem --> AIFR006 : Detect and generate anomaly transaction alerts

  client <|-- (CFR001, CFR002, CFR003, ..., CFR011)
  
}

@enduml