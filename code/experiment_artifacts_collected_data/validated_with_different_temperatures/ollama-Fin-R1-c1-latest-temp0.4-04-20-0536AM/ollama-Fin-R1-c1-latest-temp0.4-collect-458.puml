@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Personalized Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Investment Portfolio" as CFR008
  usecase "CFR009: Consolidate Financial Information in a Personalized Dashboard" as CFR009
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010

  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts from System" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004

  usecase "SFR001: Deliver Alerts to Users via Notification Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI" as SFR004
  usecase "SFR005: Request Spending Limit Alerts Based on Thresholds" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis for Users" as SFR006
  usecase "SFR007: Find Specific Investment Opportunities Matching Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Detect Anomalous Transactions via AI Component Compliance with AML Regulations" as SFR008
  usecase "SFR009: Extract Relevant News for Users' Portfolios from Trusted Sources" as SFR009
  usecase "SFR010: Generate Client Dashboards Intuitively" as SFR010
  usecase "SFR011: Process Contextualized News Insights for User Analysis" as SFR011
  usecase "SFR012: Request Predictive Intervention Analyses from AI Component" as SFR012
  usecase "SFR013: Generate Client Analytics with Meaningful Insights into Financial Behavior and Performance" as SFR013
  usecase "SFR014: Manage Historical Record of Users' Insights for Trend Analysis" as SFR014
  usecase "SFR015: Request Predictive Interventions from AI Component to Engage Advisors Appropriately" as SFR015
  usecase "SFR016: Enhance Financial Guidance with Predictive Insights Provided by the System" as SFR016
  usecase "SFR017: Generate Financial Health Reports Based on Standard Metrics and Ratios" as SFR017
  usecase "SFR018: Track Progress of Users' Financial Goals for Relevant Recommendations" as SFR018
  usecase "SFR019: Maintain Historical Record of Insights to Measure Effectiveness" as SFR019
  usecase "SFR020: Manage User Feedback to Improve System's Outputs" as SFR020

  usecase "AIFR001: Generate Financial Predictions Using AI" as AIFR001
  usecase "AIFR002: Create Personalized Recommendations for Users via AI" as AIFR002
  usecase "AIFR003: Identify Spending Limit Alerts with AI Component" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities Using AI Based on Risk Profiles" as AIFR004
  usecase "AIFR005: Select Financial Instruments Aligning With User's Portfolio Strategies and MPT Principles via AI" as AIFR005
  usecase "AIFR006: Detect Anomalous Transactions Using Pattern Recognition in Compliance with FinCEN Rules via AI" as AIFR006
  usecase "AIFR007: Correlate Financial News With User Portfolios for Contextual Insights via AI Component" as AIFR007
  usecase "AIFR008: Recommend Interventions When Patterns Indicate Potential Issues or Opportunities via AI" as AIFR008
  usecase "AIFR009: Provide Forward-Looking Analysis of Financial Situations to Support Effective Planning via AI Component" as AIFR009

  actor Client as c1, c2, c3 { 
    c1 --> CFR001 : "View Financial Insights Dashboard"
    c2 --> CFR002 : "Receive Alerts on Anomalous Transactions"
    c3 --> CFR004 : "Personalized Recommendations Aligned with Financial Profile"
  }

  actor SystemAdministrator as sa {
    sa --> SAFR001
  }

  actor FinancialAdvisor as fa {
    fa --> FAFR002, FAFR003, FAFR004
  }

  actor User as u { 
    u --> CFR005 : "Manage Personalized Recommendation Preferences"
    u --> SFR018 : "Track Progress of Financial Goals"
    u --> AIFR009 : "Receive Forward-Looking Analysis via AI Component"
  }
  
}

@enduml