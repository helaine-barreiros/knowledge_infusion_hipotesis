@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
    usecase "CFR001: View Financial Insights Dashboard" as CFR001
    usecase "SAFR001: Manage Analysis Parameters" as SAFR001
    usecase "FAFR004: Configure Analysis Params for Client Segments" as FAFR004
    
    client --> CFR001 : "View Financial Insights Dashboard"
    sysAdmin --> SAFR001 : "Manage Analysis Parameters"
    
    package Professional {
        actor User as u
        user u --> CFR002: View Alerts
        user u --> CFR003: View Predictions
        user u --> CFR004: Receive Recommendations
        user u --> CFR005: Manage Preferences
        user u --> CFR006: View Spending Limit Alerts
        user u --> CFR007: View Investment Opportunities
        user u --> CFR008: Access News Related to Portfolio
        user u --> CFR009: View Consolidated Dashboard
        user u --> CFR10: Manage Relationship with Advisors
        
    }
    
    package Professional {
        actor FinancialAdvisor as fa
        fa --> FAFR002: View Client Intervention Alerts
        fa --> FAFR003: View Predictive Analytics
        fa --> FAFR004 : Configure Analysis Params for Segments
        fa --> AIFR007: Receive Contextualized News Insights
        
    }
    
    package Professional {
        actor SysAdmin as sa
        sa --> SAFR001 : Manage Analysis Parameters
        sa --> SFR020: Maintain Historical Record of Insights
        sa --> CFR011: Send Feedback
    }

}
@enduml