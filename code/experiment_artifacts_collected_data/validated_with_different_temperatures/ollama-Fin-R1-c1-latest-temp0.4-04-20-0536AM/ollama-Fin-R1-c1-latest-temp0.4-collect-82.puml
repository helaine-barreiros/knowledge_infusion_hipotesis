@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "SFR014: Generate Client Analytics" as SFR014
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007

  client --> CFR001 : View financial data in a dashboard.
  client -> FAFR003 : Review predictive analytics for clients.
  client -> SFR014 : Access generated client analytics reports.

  sysadmin --|> SAFR001 : Configure analysis parameters.
  
  advisor --> AIFR007 : Receive contextualized news insights related to investments.
}

@enduml