@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor FinancialAdvisor as fa
actor SysAdmin as sa
system "System" as sys

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Personalized Recommendations Alignment" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Spending Limit Alerts Management" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Personalized Dashboard Consolidation" as CFR009
}

rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: Review Predictive Analytics for Clients" as FAFR003
}

rectangle "System Administrator Interface" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
}

system sys {
  
  // Client Use Cases Relationships
  c1 --> CFR001 : View Financial Insights Dashboard
  c1 --> CFR002 : Receive Alerts for Anomalous Transactions
  c1 --> CFR003 : View Financial Predictions
  c1 --> CFR004 : Personalized Recommendations Alignment
  c1 --> CFR005 : Manage Recommendation Preferences
  c1 --> CFR006 : Spending Limit Alerts Management
  c1 --> CFR007 : View Investment Opportunities Based on Risk Profile
  c1 --> CFR008 : Access News Related to Portfolio
  c1 --> CFR009 : Personalized Dashboard Consolidation

  // Financial Advisor Use Cases Relationships
  fa --> FAFR001 : Manage Client Mentoring Sessions Based on Insights
  fa --> FAFR002 : View Client Intervention Alerts
  fa --> FAFR003 : Review Predictive Analytics for Clients

  // System Administrator Use Cases Relationship
  sa --> SAFR001 : Manage Analysis Parameters
  
}

@enduml