@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sas
actor FinancialAdvisor as fa
system :System: as sys

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Personalized Recommendations Aligned with Financial Profile and Goals" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidated Personalized Dashboard for Monitoring Finances" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors Including Data Sharing Permissions" as CFR10

  c1 --> CFR001 : View financial insights dashboard.
  c1 --> CFR002 : Receive alerts on anomalous transactions.
  c1 --> CFR003 : View financial predictions based on data and trends.
  c1 --> CFR004 : Personalized recommendations aligned with profile.
  c1 --> CFR005 : Manage personalized recommendation preferences.
  c1 --> CFR006 : View spending limit alerts for budget control.
  c1 --> CFR007 : View investment opportunities based on risk profile.
  c1 --> CFR008 : Access portfolio-related news.
  c1 --> CFR009 : Consolidated dashboard view.
  c1 --> CFR10 : Manage relationship with advisors.

}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  sas --> SAFR001 : Manage analysis parameters to ensure accuracy and compliance.
}
  
rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004

  fa --> FAFR001 : Manage mentoring sessions.
  fa --> FAFR002 : View client intervention alerts for proactive help.
  fa --> FAFR003 : Review predictive analytics during consultations.
  fa --> FAFR004 : Customize analysis parameters per segment.

}

rectangle "System" {
  usecase "SFR001: Deliver Alerts Through Notification Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AI" as SFR004
  usecase "SFR005: Request Spending Limit Alerts From AI" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Matching Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts From AI Per AML Regulations" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Portfolio" as SFR009
  usecase "SFR010: Extract Relevance from Financial News for Users' Portfolios" as SFR010
  usecase "SFR011: Request Contextualized News Insights From AI Component" as SFR011
  usecase "SFR012: Generate Client Dashboards Intuitively" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics for Financial Performance" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses From AI Component" as SFR015
  usecase "SFR016: Enhance Value of Financial Guidance with AI Insights" as SFR016
  usecase "SFR017: Generate Financial Health Reports Based on Ratios and Metrics" as SFR017
  usecase "SFR018: Manage Users' Financial Goals for Progress Tracking" as SFR018
  usecase "SFR019: Maintain Historical Record of Insights for Trend Analysis" as SFR019
  usecase "SFR020: Process User Feedback to Improve System Quality and Relevance" as SFR020

}

rectangle "AI Component" {
  usecase "AIFR001: Generate Financial Predictions Based on Historical Data, Market Trends, Economic Indicators" as AIFR001
  usecase "AIFR002: Personalized Recommendations Aligning with Profiles and Goals" as AIFR002
  usecase "AIFR003: Spending Limit Alerts for Unusual Deviations from Patterns" as AIFR003
  usecase "AIFR004: Investment Opportunity Analyses Against Risk Profiles, Time Horizons, Financial Goals" as AIFR004
  usecase "AIFR005: Align Investments With User Strategies and Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Anomaly Transaction Alerts Using Pattern Recognition for Fraud Detection" as AIFR006
  usecase "AIFR007: Contextualized News Insights Correlating with Portfolios" as AIFR007
  usecase "AIFR008: Predictive Intervention Recommendations Identifying Engagement Opportunities or Financial Difficulties" as AIFR008
  usecase "AIFR009: Forward-Looking Analysis of Financial Situations to Support Effective Planning" as AIFR009

}

sas <|-- SAFR001 : System Administrator manages analysis parameters.

fa --> FAFR004 : Configure segments for clients.

c1 --> SFR020 : Send feedback on recommendations and insights.
  
@enduml