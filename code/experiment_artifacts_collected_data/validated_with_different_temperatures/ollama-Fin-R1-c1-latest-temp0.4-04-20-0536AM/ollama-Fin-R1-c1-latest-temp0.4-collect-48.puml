@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "SAFR004: Configure Analysis Parameters for Segments" as SAFR004
  usecase "SFR015: Request Intervention Analyses from AI" as SFR015
  usecase "CFR002: Receive Alerts about Anomalous Transactions" as CFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "SFR007: Request Investment Opportunity Analysis from AI" as SFR007
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "SAFR005: Deliver Alerts to Users via System" as SAFR005
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "FAFR004: Manage Analysis Parameters by Segment" as FAFR004
  usecase "SFR020: Maintain Historical Record of Insights for Trend Analysis" as SFR020
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
}

actor Client as C
actor SystemAdministrator as SA
actor FinancialAdvisor as FA

C --> CFR001 : View financial insights dashboard
SA --> SAFR004 : Configure analysis parameters for segments
FA --> FAFR003 : View predictive analytics for clients
C --> SFR007 : Request investment opportunity analysis from AI
SFR015 <|-- (System) : Deliver intervention analyses to system
CFR002 <|-- C : Receive alerts about anomalous transactions
SA --> SAFR004 : Configure parameters by segment
FA --> FAFR004 : Manage parameters for segments

@enduml