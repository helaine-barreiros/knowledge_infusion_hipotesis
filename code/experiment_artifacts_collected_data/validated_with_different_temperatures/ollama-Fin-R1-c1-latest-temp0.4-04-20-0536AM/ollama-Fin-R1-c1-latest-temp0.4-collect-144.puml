@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts About Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Investment Portfolio" as CFR008
  usecase "CFR009: Manage Relationship with Financial Advisors Including Data Sharing Permissions" as CFR009
}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters for AI System Compliance" as SAFR001
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
}

rectangle "System (SFR)" {
  usecase "SFR001: Deliver Alerts Through Notification Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts When Exceeding Thresholds" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis for Users Based on Risk Profiles" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts Compliant with AML Regulations" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Portfolios From Trusted Sources" as SFR009
  usecase "SFR010: Process Contextualized News To Extract Relevance for Financial Situations" as SFR010
  usecase "SFR011: Request Contextualized News Insights from AI Component" as SFR011
  usecase "SFR012: Generate Client Dashboards Intuitively" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics for Financial Behavior and Performance" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses From AI Component For Advisor Engagement" as SFR015
  usecase "SFR016: Request Predictive Insights To Enhance Value of Financial Guidance" as SFR016
  usecase "SFR017: Generate Financial Health Reports Based on Standard Metrics" as SFR017
  usecase "SFR018: Manage Users' Financial Goals For Progress Tracking and Recommendations" as SFR018
  usecase "SFR019: Maintain Historical Record of Insights for Trend Analysis" as SFR019
  usecase "SFR020: Manage User Feedback To Improve System Quality" as SFR020
}

rectangle "AI Component (AIFR)" {
  usecase "AIFR001: Generate Financial Predictions Based on Data and Trends" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations Aligning With Profiles" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts For Unusual Deviations" as AIFR003
  usecase "AIFR004: Identify Investment Opportunities Based on Risk and Goals" as AIFR004
  usecase "AIFR005: Align Investments With User Strategies Using MPT Principles" as AIFR005
  usecase "AIFR006: Detect Anomalous Transactions For Fraud Prevention" as AIFR006
  usecase "AIFR007: Correlate News To Portfolios For Relevant Insights" as AIFR007
  usecase "AIFR008: Recommend Intervention When Patterns Indicate Financial Issues Or Opportunities" as AIFR008
  usecase "AIFR009: Provide Forward-Looking Analysis Of Financial Situations To Support Planning" as AIFR009
}

usecase CFR001 --> Client : View Dashboard
Client --> SFR002 : Receive Recommendations
SFR003 --> AIFR001 : Request Predictions
AIFR001 --> Client : Provide Predictions

Client --> SAFR001 : Manage Parameters (Admin)
SAFR001 <|-- SysAdmin 

FAFR004 --> SFR006 : Configure Segments For Analysis
SFR006 --> AIFR002 : Request Recommendations Based On Profiles
AIFR002 --> Client : Provide Personalized Recs

Client --> FAFR001 : Manage Mentoring Sessions (Advisor)
FAFR001 <|-- Advisor 

CFR005 --> SFR004 : Adjust Recommendation Preferences
SFR004 --> AIFR002 : Update Recommendations Based On Changes

Client --> SFR008 : View Investment Opportunities
AIFR006 --> Client : Provide Alerts For Exceeding Limits (User)
CFR009 --> Advisor : Manage Data Sharing Permissions (Advisor)

SFR017 --> AIFR009 : Generate Financial Health Reports Based On Metrics

@enduml