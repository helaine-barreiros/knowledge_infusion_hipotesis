@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Notification Preferences" as SAFR002
  
  Client --> CFR001 : "View"
  
  SysAdmin -> SAFR002 : "Manage Parameters"
}

rectangle "Client" {
  actor "User (Client)" as UserCFR
  usecase "CFR005: Manage Personalized Recommendations Preferences" as CFR005
  
  UserCFR --> CFR001 : "View Dashboard"
  UserCFR --> SAFR002 : "Manage Alerts"
  
}

rectangle "Financial Advisor" {
  actor "FAFR003: View Client Intervention Alerts" as FAFR003
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  
  FAFR003 --> SAFR002 : "View Alerts"
  
}

rectangle "System Administrator" {
  actor "SysAdmin" as SysAdminSAFR
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001

  SysAdminSAFR <|-- SAFR001
  
}
@enduml