@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as C1
actor SysAdmin as SA
actor FinancialAdvisor as FA
system SFR021: System as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Manage Relationship with Financial Advisors" as CFR009

  SysAdmin --> SAFR001 : manage analysis parameters for AI system (Basel III, etc.)
  
  Client --> SFR002 : receive personalized recommendations based on profile and goals
  Client --> AIFR004 : generate investment opportunity analyses matching risk profiles
  Client --> CFR003: view financial predictions from AI
  SysAdmin --> SAFR001 <|-- (SFR005) : manage spending limit alerts thresholds via system
  
  FinancialAdvisor --> SFR008 : receive contextualized news relevant to portfolio management
  FinancialAdvisor --> AIFR007 : generate context-aware investment recommendations

  Client --> Sys: send feedback for improvement of outputs
}

@enduml