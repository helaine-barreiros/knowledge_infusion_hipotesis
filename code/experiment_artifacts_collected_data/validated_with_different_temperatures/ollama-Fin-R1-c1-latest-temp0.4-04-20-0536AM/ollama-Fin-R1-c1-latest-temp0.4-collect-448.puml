  actor FinancialAdvisor as fa extends FAFR001, FAFR003, FAFR008

  Client --> CFR001 : "View Dashboard"
  Client --> CFR002 : "Receive Alerts on Anomalous Transactions"
  Client --> CFR003 : "View Financial Predictions Based on Data and Trends"
  Client --> CFR004 : "Personalized Recommendations Aligned with Profile"
  Client --> CFR005 : "Manage Preferences for Recs"
  Client --> CFR006 : "View Spending Limit Alerts When Exceeding Thresholds"
  Client --> CFR007 : "Investment Opportunities Based on Risk Profile"
  Client --> CFR008 : "News Related to Portfolio"
  Client --> CFR009 : "Consolidated Personalized Dashboard for Monitoring"
  Client --> CFR010 : "Manage Relationship with Advisors, Data Sharing"

  SystemAdmin --> SAFR001 : "Manage Analysis Parameters for Compliance"

  FinancialAdvisor --> FAFR002 : "Client Intervention Alerts from System"
  FinancialAdvisor --> FAFR003 : "View Predictive Analytics for Clients' Situations"
  FinancialAdvisor --> FAFR004 : "Configure Segmented Client Params"

  SFR001 <|-- (SFR008, SFR009)
  
  AIFR001 <|-- (AIFR003, AIFR006)

  'System Boundary
