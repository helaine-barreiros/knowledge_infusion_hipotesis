@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Trends" as CFR003
  usecase "CFR004: Access Personalized Recommendations Aligned with Financial Goals" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Portfolio Management" as CFR008
  usecase "CFR009: View Consolidated Financial Dashboard for Efficiency" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors, Including Data Sharing Permissions" as CFR10

  Client --> CFR001 : View financial data in a comprehensive format
  Client --> CFR002 : Receive alerts on anomalous transactions
  Client --> CFR003 : Access future predictions based on history and trends
  Client --> CFR004 : Get personalized recommendations aligned with goals
  Client --> CFR005 : Adjust preferences for better relevance
  Client --> CFR006 : Monitor spending limits via alerts
  Client --> CFR007 : Discover investment opportunities matching risk profile
  Client --> CFR008 : Stay informed about market events affecting assets
  Client --> CFR009 : Use a single view to manage finances efficiently
  Client --> CFR10 : Control data sharing with advisors

}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Proactive Client Assistance" as FAFR002
  usecase "FAFR003: Review Predictive Analytics to Inform Consultations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004

  FinancialAdvisor --> FAFR001 : Schedule and adjust mentoring sessions using insights
  FinancialAdvisor --> FAFR002 : Act on alerts to prevent financial issues
  FinancialAdvisor --> FAFR003 : Use analytics for data-driven advice during meetings
  FinancialAdvisor --> FAFR004 : Customize system settings per client type

}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters for AI System Compliance" as SAFR001

  SysAdmin --> SAFR001 : Ensure algorithm accuracy and regulatory compliance
}

rectangle "System (SFR)" {
  usecase "SFR002: Deliver Personalized Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts Based on Thresholds" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis for Users" as SFR006
  usecase "SFR007: Find Specific Investments Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Detect Anomalous Transactions via Pattern Recognition" as SFR008
  usecase "SFR009: Extract Relevant News for Portfolios from AI Component" as SFR009
  usecase "SFR010: Generate Client Dashboards with Financial Information" as SFR010
  usecase "SFR013: Generate Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR020: Manage User Feedback to Improve System Quality" as SFR020

  Sys --> (CFR) : Provide services like dashboards, alerts, and recommendations
}

rectangle "AI Component (AIFR)" {
  usecase "AIFR001: Generate Financial Predictions Using Historical Data and Trends" as AIFR001
  usecase "AIFR002: Create Personalized Recommendations Based on User Profiles" as AIFR002
  usecase "AIFR003: Issue Spending Limit Alerts for Unusual Activity Detection" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities Against Risk Profiles" as AIFR004
  usecase "AIFR005: Identify Financial Instruments Aligning with User Strategies" as AIFR005
  usecase "AIFR006: Flag Anomalous Transactions for Compliance Checks" as AIFR006
  usecase "AIFR007: Correlate News to Portfolios for Contextual Insights" as AIFR007
  usecase "AIFR008: Recommend Proactive Interventions Based on Client Patterns" as AIFR008

  AI --> (SFR) : Supply data and insights needed by the system
}

rectangle "User (Client, Advisor)" {
  usecase "CFR11: Send Feedback to Improve System Accuracy" as CFR11
  
  User --> CFR11 : Provide input for system improvement
}
@enduml