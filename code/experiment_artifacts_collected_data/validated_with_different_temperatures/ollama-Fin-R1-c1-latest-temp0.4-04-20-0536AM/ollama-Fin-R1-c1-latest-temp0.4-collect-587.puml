@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR006: Manage Spending Limit Alerts" as CFR006
  usecase "SFR014: Generate Client Analytics for Financial Health" as SFR014
  usecase "AIFR003: Generate Spending Limit Alerts Based on User Behavior" as AIFR003

  client --> CFR001 : "View financial data and insights"
  client --> FAFR003 : "Review predictive analytics for clients"
  client --> SFR014 : "Assess financial health with reports"
  
  sysAdmin --> SAFR001 : "Adjust analysis parameters"

  advisor --> FAFR002 : "Monitor client alerts and intervene proactively"
  advisor --> AIFR008 : "Identify patterns for advisory engagement"
}

client as Client
sysAdmin as SysAdmin
advisor as FinancialAdvisor

@enduml