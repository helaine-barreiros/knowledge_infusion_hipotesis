@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Client Alerts" as SAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "SAFR001: Monitor Spending Limits" as SAFR001
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Manage Relationship with Advisors" as CFR009

  rectangle "Client" {
    actor Client as c1
    client --> (CFR001)
    client --> (SAFR002)
    client --> (CFR003)
    client --> (CFR004)
    client --> (CFR005)
    client --> (CFR007)
    client --> (CFR008)
    client --> (CFR009)
  }

  rectangle "Financial Advisor" {
    actor FinancialAdvisor as fa
    fa -> (SAFR001) : label="View Alerts"
    fa -> (FAFR002) : label="Manage Client Mentoring Sessions"
    fa -> (FAFR003) : label="View Predictive Analytics"
  }

  rectangle "System Administrator" {
    actor SysAdmin as sa
    sa --> (SAFR001)
    sa --> (SAFR004)
  }
}

@enduml