@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  user --> CFR001 : "Client"
  SysAdmin --> SAFR001 : "System Administrator"
  
  rectangle "Financial Advisor Role" {
    usecase "FAFR002: View Client Intervention Alerts" as FAFR002
    usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
    user --> FAFR002 : "Client"
  }
  
  rectangle "System Components" {
    usecase "SFR019: Maintain Historical Record of Insights" as SFR019
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
    
    SysAdmin --> SAFR001 : "Manage Analysis Parameters"
  }
  
  user --> FAFR003 : "Client"
}

@enduml