left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage User Alerts" as SAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: Access Investment Opportunities" as CFR007
  usecase "CFR008: View Portfolio News" as CFR008
  usecase "CFR009: Consolidate Financial Information" as CFR010 (note here)
  usecase "CFR010: Manage Relationship with Advisors" as CFR010

  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "SAFR004: Configure Analysis Parameters for Segments" as SAFR005

  usecase "SFR010: Generate Client Alerts Based on Predefined Conditions" as SFR010
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Identify Financial Instruments for Users" as AIFR005
  usecase "AIFR006: Detect Anomaly Transactions" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  usecase "AIFR008: Recommend Predictive Interventions for Advisors" as AIFR008

  usecase "CFR011: Send Feedback to System" as CFR011
}

actor Client as C
actor FinancialAdvisor as FA
actor SysAdmin as SA
actor User as U (note here)

C --> CFR001 : View financial insights dashboard
C --> SAFR002 : Manage user alerts
C --> CFR003 : View predictions
C --> CFR004 : Receive recommendations
U --> AIFR005 : Configure preferences for recommendations
C --> CFR006 : View spending limit alerts
C --> CFR007 : Access investment opportunities
C --> SFR010 : Manage portfolio news
FA --> FAFR002 : Monitor client intervention alerts
SA --> SAFR004 : Adjust analysis parameters
U --> AIFR003 : Request predictive analytics

rectangle "System" {
  usecase "SFR008: Deliver Alerts to Users" as SFR008 (note here)
}

C --> SFR008 : Receive alerts from system

@enduml