@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as client
actor FinancialAdvisor as advisor
actor SysAdmin as admin
system :System: as sys

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as cfr001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as cfr002
  usecase "CFR003: View Financial Predictions" as cfr003
  usecase "CFR004: Personalized Recommendations Based on Profile" as cfr004
  usecase "CFR005: Manage Recommendation Preferences" as cfr005
  usecase "CFR006: View Spending Limit Alerts" as cfr006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as cfr007
  usecase "CFR008: Access News Related to Portfolio" as cfr008
  usecase "CFR009: Personalized Dashboard for Consolidated Financial Info" as cfr009
  usecase "CFR10: Manage Relationship with Advisors" as cfr10

  client --> (cfr001)
  client --> (cfr002)
  client --> (cfr003)
  client --> (cfr004)
  client --> (cfr005)
  client --> (cfr006)
  client --> (cfr007)
  client --> (cfr008)
  client --> (cfr009)
  client --> (cfr10)

}

rectangle "FinancialAdvisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as fafr001
  usecase "FAFR002: View Client Intervention Alerts" as fafr002
  usecase "FAFR003: View Predictive Analytics for Clients" as fafr003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as fafr004

  advisor --> (fafr001)
  advisor --> (fafr002)
  advisor --> (fafr003)
  advisor --> (fafr004)

}

rectangle "SysAdmin" {
  usecase "SAFR001: Manage Analysis Parameters for AI System" as safr001

  admin --> (safr001)

}

system --> (cfr001) : Delivers
system --> (cfr002) : Delivers
system --> (cfr003) : Delivers
system --> (cfr004) : Delivers
system --> (cfr005) : Requests and Processes Preferences
system --> (cfr006) : Delivers
system --> (cfr007) : Delivers
system --> (cfr008) : Delivers
system --> (cfr009) : Delivers
system --> (cfr10) : Requests and Processes

system --> (safr001) : Configures AI Parameters
system --> (fafr004) : Configures Analysis Parameters for Segments

@enduml