@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "AIFR009: Generate Client Predictive Intervention Recommendations" as AIFR009

  client --> CFR001 : "View Financial Insights Dashboard"
  sysAdmin --> SAFR001 : "Manage Analysis Parameters"
  advisor --> FAFR003 : "View Predictive Analytics for Clients"
  
  rectangle "Client Interface" {
    usecase "CFR002: View Alerts on Anomalous Transactions" as CFR002
    usecase "CFR004: Receive Personalized Recommendations" as CFR004
    usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010

    client --> CFR002 : "View Alerts on Anomalous Transactions"
    client --> CFR004 : "Receive Personalized Recommendations"
    client --> CFR010 : "Manage Relationship with Financial Advisors"

  }
  
  rectangle "Financial Advisor Interface" {
    usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
    usecase "FAFR002: View Intervention Alerts for Clients" as FAFR002

    advisor --> FAFR001 : "Manage Client Mentoring Sessions"
    advisor --> FAFR002 : "View Intervention Alerts for Clients"

  }
  
  rectangle "System Administrator Interface" {
    usecase "SAFR003: Deliver Alerts to Users via Notifications" as SAFR003
    usecase "SFR014: Generate Client Analytics" as SFR014

    sysAdmin --> SAFR003 : "Deliver Alerts"
    sysAdmin --> SFR014 : "Generate Client Analytics"

  }
  
}

@enduml