@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "SAFR006: Manage Relationship with Advisors" as SAFR006

  actor "Client" as client
  actor "Financial Advisor" as advisor
  actor "System Administrator" as sysadmin

  client --> CFR001 : View financial data in a comprehensive format.
  client --> FAFR002 : Receive alerts about potential fraud or unusual spending patterns.
  client --> SAFR006 : Manage relationship with advisors, including sharing permissions.
  
  advisor --> FAFR001 : Schedule and manage mentoring sessions based on system insights.
  advisor --> FAFR003 : View predictive analytics to guide consultations.

  sysadmin --> CFR002 : Set up alerts for clients (FATF regulations).
  sysadmin --> SAFR001 : Configure analysis parameters ensuring compliance with Basel III etc. 

  client <|-- SFR012 : Client requests dashboards.
  
  system --> AIFR003: Generate spending limit alerts based on user data and thresholds.

}

@enduml