@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sa1
actor FinancialAdvisor as fa1

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "AIFR006: Generate Contextualized News Insights Based on User Portfolios" as AIFR006

  c1 --> CFR001 : "View Financial Insights Dashboard"
  sa1 --> SAFR001 : "Manage Analysis Parameters"
  fa1 --> FAFR003 : "View Predictive Analytics for Clients"

  SysAdmin <|-- (CFR001) : Admin Rights
}

rectangle "Client-Specific Use Cases" {
  usecase "CFR002: View Alerts About Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access Personalized Dashboard for Financial Monitoring" as CFR008
  usecase "CFR10: Manage Relationship with Financial Advisors Including Data Sharing Permissions" as CFR10

  c1 --> CFR002 : "View Alerts"
  c1 --> CFR003 : "View Predictions"
  c1 --> CFR004 : "Receive Recommendations"
  c1 --> CFR005 : "Manage Preferences"
  c1 --> CFR006 : "View Spending Limit Alerts"
  c1 --> CFR007 : "View Investment Opportunities"
  c1 --> CFR008 : "Access Dashboard"
  c1 --> CFR10 : "Manage Relationship with Advisors"

}

rectangle "System-Specific Use Cases" {
  usecase "SFR009: Request Contextualized News from AI Component" as SFR009
  usecase "SFR012: Generate Client Dashboards for Financial Monitoring" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013

  SysAdmin --> SFR008 : "Request Anomaly Transaction Alerts"
  SysAdmin --> CFR009 : "View Contextualized News"

}

rectangle "AI-Specific Use Cases" {
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations Based on Profiles and Goals" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts by Identifying Unusual Deviations" as AIFR003
  usecase "AIFR004: Identify Investment Opportunities Matching Risk Profiles" as AIFR004

}

@enduml