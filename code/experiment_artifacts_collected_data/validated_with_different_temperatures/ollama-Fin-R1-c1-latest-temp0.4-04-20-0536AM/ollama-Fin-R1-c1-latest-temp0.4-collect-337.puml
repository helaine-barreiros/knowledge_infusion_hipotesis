@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "AIFR006: Generate Anomaly Transaction Alerts for Users" as AIFR006

  client --> CFR001 : "View Financial Insights Dashboard"
  
  sysAdmin --> SAFR001 : "Manage Analysis Parameters"

  financialAdvisor --> FAFR002 : "View Client Intervention Alerts"
  
  system --> SFR013 : "Generate Client Alerts Based on Predefined Conditions"
  system --> AIFR006 : "Generate Anomaly Transaction Alerts for Users"
}

actor client as c
actor sysAdmin as sa
actor financialAdvisor as fa

@enduml