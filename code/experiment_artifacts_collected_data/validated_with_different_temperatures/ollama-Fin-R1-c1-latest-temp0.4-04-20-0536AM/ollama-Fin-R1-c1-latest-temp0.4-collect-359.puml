@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR004: Personalized Recommendations Based on Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "SAFR006: Deliver Alerts When Spending Limits Exceeded" as SAFR006
  usecase "FAFR001: Schedule Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "CFR003: View Financial Predictions with Market Trends" as CFR003
  usecase "SAFR002: Manage Analysis Parameters for Specific Segments" as SAFR002
  usecase "SFR009: Extract Relevant News Based on Portfolio Context" as SFR009
  usecase "CFR010: Share Financial Data with Advisors" as CFR010

  actor Client as c1
  actor SystemAdmin as saa
  actor FinancialAdvisor as fa
}

c1 --> CFR001 : View financial insights dashboard  
saa --> SAFR001 : Manage analysis parameters  
fa --> FAFR003, FAFR001, FAFR002: Schedule sessions, view analytics, alerts  

Client <|-- (c1)
SystemAdmin <|-- (saa)
FinancialAdvisor <|-- (fa)

@enduml