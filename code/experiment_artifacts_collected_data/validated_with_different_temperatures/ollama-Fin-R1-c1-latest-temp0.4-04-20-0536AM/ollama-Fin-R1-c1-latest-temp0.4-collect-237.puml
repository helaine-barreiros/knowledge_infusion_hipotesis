@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Anomaly Detection Parameters" as SAFR002
  usecase "FAFR005: Schedule Client Mentoring Sessions Based on AI Insights" as FAFR005

  Client --> CFR001 : "View Financial Dashboard"
  
  SysAdmin <|-- (SAFR002) : "Manage Parameters for Alerts and Predictions"

  rectangle "Client Interface" {
    usecase "CFR003: View Financial Predictions" as CFR003
    usecase "CFR004: Receive Personalized Recommendations" as CFR004
    Client --> CFR003 : "View Future Projections"
    Client --> CFR004 : "Get Tailored Advice"

  }

  rectangle "Financial Advisor Interface" {
    usecase "FAFR001: Manage Mentoring Sessions" as FAFR001
    usecase "FAFR002: View Intervention Alerts" as FAFR002
    usecase "FAFR003: Review Predictive Analytics" as FAFR003

  }

  rectangle "System Administrator Interface" {
    SysAdmin --> SAFR001 : "Adjust AI Analysis Settings"
  
  }
}

@enduml