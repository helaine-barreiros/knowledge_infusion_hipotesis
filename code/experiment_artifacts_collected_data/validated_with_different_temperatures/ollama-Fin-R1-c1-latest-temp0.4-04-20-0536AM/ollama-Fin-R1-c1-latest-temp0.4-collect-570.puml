@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "SFR014: Generate Client Analytics" as SFR014
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
}

actor "Client" as C
actor "Financial Advisor" as FAdvisors
actor "System Administrator" as SysAdmin

C --> CFR001 : View Financial Insights Dashboard
SysAdmin --> SAFR001 : Manage Analysis Parameters
FAdvisors --> FAFR003 : View Predictive Analytics for Clients
Client --> CFR002 : Receive Alerts on Anomalous Transactions
SFR014 <|-- Sys: Generate Client Analytics (system requests)
AIFR007 <|-- Sys: Generate Contextualized News Insights (system requests)

@enduml