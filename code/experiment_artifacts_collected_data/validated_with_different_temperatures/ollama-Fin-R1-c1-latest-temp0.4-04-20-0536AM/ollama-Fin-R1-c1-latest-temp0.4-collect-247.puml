@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Get Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Suitable to Risk Profile" as CFR007
  usecase "CFR008: View News Related to Investment Portfolio" as CFR008
  usecase "CFR009: Manage Relationship with Financial Advisors Including Data Sharing Permissions" as CFR009
}

rectangle "Financial Advisor (FAFR)" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
}

rectangle "System Administrator (SAFR)" {
  usecase "SAFR001: Manage Analysis Parameters for AI System Compliance with Basel III and Other Regulations" as SAFR001
}

rectangle "System (SFR)" {
  usecase "SFR002: Deliver Personalized Recommendations Based on Financial Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component for Insights" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AI Component Using User Data and Preferences" as SFR004
  usecase "SFR005: Request Spending Limit Alerts When Exceeding Defined Thresholds" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis Based on Risk Profiles" as SFR006
  usecase "SFR007: Find Specific Investment Opportunities Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Detect Anomaly Transaction Alerts According to AML Regulations Using AI Component" as SFR008
  usecase "SFR009: Extract Contextualized News Relevant to Users' Portfolios from Trusted Sources" as SFR009
  usecase "SFR010: Process Contextualized News for Financial Portfolio Insights" as SFR010
  usecase "SFR012: Generate Client Dashboards with Intuitive and Actionable Financial Information" as SFR013
}

rectangle "AI System (AIFR)" {
  usecase "AIFR001: Generate Financial Predictions by Analyzing Historical Data, Market Trends, Economic Indicators" as AIFR001
  usecase "AIFR002: Create Personalized Recommendations Based on User Profiles and FINRA Standards" as AIFR002
  usecase "AIFR003: Identify Spending Limit Alerts by Recognizing Unusual Patterns in Transactions" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities Against Risk Profiles Using Modern Portfolio Theory" as AIFR004
  usecase "AIFR005: Generate ESG-Aligned Investment Options Based on User Preferences and Strategies" as AIFR005
  usecase "AIFR006: Detect Potentially Fraudulent Transactions via Pattern Recognition in Compliance with FinCEN Rules" as AIFR006
}

rectangle "User (Client, FA, SA)" {
  actor Client as C
  actor FinancialAdvisor as FAF
  actor SystemAdmin as SAF

  C --> CFR001 : view dashboard
  C --> CFR002 : receive alerts on transactions
  C --> CFR003 : get predictions based on data and trends
  C --> CFR004 : personalized recommendations aligned with goals
  C --> CFR005 : manage recommendation preferences
  C --> CFR006 : view spending limit alerts
  C --> CFR007 : access investment opportunities suitable to risk profile
  C --> CFR008 : read news related to portfolio
  C --> CFR009 : manage relationship with advisors including data sharing

  FAF --> FAFR001 : mentor clients using insights
  FAF --> FAFR002 : view intervention alerts for proactive help
  FAF --> FAFR003 : analyze predictive analytics on client financials

  SAF --> SAFR001 : manage AI analysis parameters per regulations

  SFR --> SFR002: deliver recommendations based on profiles
  SFR --> SFR003: request predictions from AIFR
  SFR --> SFR004: request personalized recos using user data and prefs
  SFR --> SFR005: request spending limit alerts for thresholds exceeded
  SFR --> SFR006: request investment opportunities based on risk profiles
  SFR --> SFR007: find specific investments matching criteria and ESG
  SFR --> SFR008: detect anomaly transaction alerts per AML regulations using AI
  SFR --> SFR009: extract contextualized news for portfolios
  SFR --> SFR12 : generate client dashboards

  AIFR --> AIFR001: generate financial predictions via data analysis and trends
  AIFR --> AIFR002: create personalized recommendations aligned with industry standards (FINRA)
  AIFR --> AIFR003: identify spending limit alerts based on transaction patterns
  AIFR --> AIFR004: analyze investments against risk profiles using MPT principles
  AIFR --> AIFR005: generate ESG-aligned investment options per user's preferences and strategies
  AIFR --> AIFR006: detect potential fraud via pattern recognition in compliance with FinCEN

@enduml