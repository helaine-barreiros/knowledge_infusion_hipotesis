@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Alert Preferences" as SAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Manage Relationship with Advisors" as CFR009
  usecase "SAFR015: Generate Predictive Intervention Analyses" as SAFR015

  package Professional {
    actor Client as cClient
    actor FinancialAdvisor as fAdvisor
    actor SystemAdministrator as SysAdmin
    
    client --> (CFR001) : View financial insights dashboard  
    client --> (SAFR002) : Manage alert preferences  
    client --> (CFR003) : View financial predictions  
    client --> (CFR004) : Receive personalized recommendations  
    client --> (CFR005) : Manage recommendation preferences  
    SysAdmin --> (SAFR001) : Manage analysis parameters  
    fAdvisor --> (FAFR002) : View client intervention alerts  
    fAdvisor --> (FAFR003) : View predictive analytics about clients' financial situations  
  }
}

@enduml