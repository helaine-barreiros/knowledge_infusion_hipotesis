@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Personalized Recommendations Based on Profile" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidated Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10

  Client --> CFR001 : View financial data in a comprehensive format.
  Client --> CFR002 : Receive alerts for potential fraud or unusual spending patterns.
  Client --> CFR003 : See future predictions based on historical and market trends.
  Client --> CFR004 : Get personalized investment advice aligned with goals.
  Client --> CFR005 : Adjust preferences to refine recommendations.
  Client --> CFR006 : Receive alerts when exceeding budget limits in specific categories.
  Client --> CFR007 : Explore investments that match your risk profile and ESG criteria.
  Client --> CFR008 : Stay informed about market events affecting your portfolio.
  Client --> CFR009 : Monitor all financial information from one dashboard.
  Client --> CFR10 : Control data sharing with advisors for privacy.

}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Intervention Alerts from System" as FAFR002
  usecase "FAFR003: Review Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004

  FinancialAdvisor --> FAFR001 : Schedule and customize mentoring sessions.
  FinancialAdvisor --> FAFR002 : Act on system-generated alerts for client issues.
  FinancialAdvisor --> FAFR003 : Analyze predictive data to guide clients.
  FinancialAdvisor --> FAFR004 : Adjust parameters based on segment-specific needs.

}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  SystemAdmin --> SAFR001 : Set and update system-wide analysis settings.
}

rectangle "System (SFR)" {
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI" as SFR003
  usecase "SFR004: Generate Client Dashboards" as SFR004
  usecase "SFR018: Manage User Goals Tracking" as SFR018

  Sys --> SFR002 : Provide personalized advice to clients.
  Sys --> SFR003 : Query AI for forecasts and trends.
  Sys --> SFR004 : Create consolidated dashboards per client.
  Sys --> SFR018 : Track progress toward financial goals.

}

rectangle "AI System (AIFR)" {
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Investment Opportunity Analysis" as AIFR004
  usecase "AIFR005: Align with Modern Portfolio Theory" as AIFR005

  AI --> AIFR002 : Offer tailored financial guidance.
  AI --> AIFR003 : Warn of excessive spending in categories.
  AI --> AIFR004 : Suggest investments matching risk profiles and goals.
  AI --> AIFR005 : Ensure portfolio optimization per MPT.

}

rectangle "Feedback System (SFR)" {
  usecase "CFR11: Send Feedback" as CFR11
  Client --> CFR11 : Provide input to improve system outputs.
}
@enduml