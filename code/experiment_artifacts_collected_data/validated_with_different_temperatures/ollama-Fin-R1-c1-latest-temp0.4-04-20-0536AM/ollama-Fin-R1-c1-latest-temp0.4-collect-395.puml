}
sys --> CFR002 : "Deliver Alerts to Users via Channels"
sys --> CFR003 : "Request Predictions from AI Component"
sys --> CFR004 : "Request Personalized Recommendations (FINRA)"
sys --> CFR005: "Manage Preferences for User"
sys --> CFR006 : "Generate Spent Limit Alerts Based on Thresholds"
sys --> CFR007 : "Identify Investment Opportunities via Risk Profile"
sys --> CFR008 : "Extract Relevant News from AI Component"
sys --> CFR009 : "Create Client Dashboards (Intuitive & Actionable)"
sys --> SAFR001: "Manage Analysis Parameters"

rectangle Professional {
  usecase "AIFR003: Generate Spent Limit Alerts" as AIFR003
  sys <|-- AIFR003 : "AI System"
}

rectangle Professional {
  usecase "AIFR004: Identify Investment Opportunities Based on Risk Profile" as AIFR004
