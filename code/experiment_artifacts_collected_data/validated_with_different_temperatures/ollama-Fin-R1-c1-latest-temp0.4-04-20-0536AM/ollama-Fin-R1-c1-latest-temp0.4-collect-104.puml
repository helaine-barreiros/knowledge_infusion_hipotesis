  SysAdmin --> SFR008, SFR009, SFR010, SFR011, SFR012, SFR013, SFR014, SFR015, SFR016, SFR017, SFR018, SFR019, SFR020

}

rectangle "AI System (AIFR)" {
  usecase "AIFR001: Generate Predictions" as AIFR001
  usecase "AIFR003: Generate Spending Alerts" as AIFR003  
  usecase "AIFR004: Analyze Investment Opportunities" as AIFR004
  SysAdmin --> AIFR002, AIFR005, AIFR006, AIFR007, AIFR008

}

Client --> CFR001, SAFR001, FAFR003, SFR001, AIFR001
SysAdmin --> SAFR002, FAFR004, SFR009, AIFR005  
FinancialAdvisor --> FAFR001, FAFR002

