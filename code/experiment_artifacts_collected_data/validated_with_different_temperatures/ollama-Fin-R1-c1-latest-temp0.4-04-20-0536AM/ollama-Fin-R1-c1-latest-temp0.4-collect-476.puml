  usecase "AIFR005: Generate Investment Recommendations" as AIFR005
  usecase "AIFR006: Detect Anomalies in Transactions" as AIFR006
  usecase "AIFR007: Provide Contextual News Insights" as AIFR007

  
}

rectangle "Client System" {
  usecase "CFR012: View Client Dashboards" as CFR012
  
}
SysAdmin --> SAFR003 : Manage analysis parameters
Client --> SAFR004, SAFR005, SAFR006, SAFR007

rectangle "Financial Advisor System" {
  usecase "FAFR001: Schedule Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
}

Client --> AIFR008 : Request predictive interventions

SysAdmin <|-- (CFR005) : Manage preferences for recommendations

rectangle "System Administrator" {
actor SysAdmin as SA
  
}
Client actor Client as C
FinancialAdvisor actor FinancialAdvisor as FA
User user as U

client -> CFR001: View financial insights dashboard  
client -> SAFR002: Configure spending limits  
client -> AIFR003: Generate spending limit alerts  

financialadvisor --> FAFR001 : Schedule mentoring sessions  
financialadvisor --> FAFR002 : Review intervention alerts  

system -- (CFR004): Deliver personalized recommendations  
system -- (AIFR005): Provide investment opportunities

SysAdmin -> SAFR006: Set spending limits
Client -> AIFR007: Receive contextualized news insights

