@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "CFR009: Access Personalized Dashboard Consolidating Financial Information" as CFR009
  usecase "AIFR007: Generate Contextualized News Insights Correlated with User Portfolios" as AIFR007

  Client --> CFR001
  SysAdmin --> SAFR001
  FAFrAdvisor --> (FAFR002)
  System --> SFR013, AIFR007
  
  group "Client Use Cases"
    rectangle {
      usecase "CFR001: View Financial Insights Dashboard" as CFR001
      usecase "CFR009: Access Personalized Dashboard Consolidating Financial Information" as CFR009
      Client --> (CFR001), (CFR009)
    }
  
  group "System Administrator Use Cases"
    rectangle {
      usecase "SAFR001: Manage Analysis Parameters" as SAFR001
      SysAdmin --> (SAFR001)
    }

  group "Financial Advisor Use Cases"
    rectangle {
      usecase "FAFR002: View Client Intervention Alerts" as FAFR002
      usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
      FAFrAdvisor --> (FAFR002), (FAFR003)
    }
  
  group "System Use Cases"
    rectangle {
      usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
      System --> (SFR013)
      
      usecase "AIFR007: Generate Contextualized News Insights Correlated with User Portfolios" as AIFR007
      System --> (AIFR007)
    }

  group "AI Use Cases"
    rectangle {
      usecase "AIFR001: Generate Financial Predictions Based on Historical Data and Market Trends" as AIFR001
      usecase "AIFR002: Generate Personalized Recommendations Aligned with Client Profiles" as AIFR002
      usecase "AIFR003: Generate Spending Limit Alerts for Exceeded Thresholds in Expense Categories" as AIFR003
      usecase "AIFR004: Identify Investment Opportunities Based on Risk Profiles and ESG Preferences" as AIFR004
      System --> (AIFR001), (AIFR002), (AIFR003), (AIFR004)
    }
  
  group "Other Actors"
    rectangle {
      usecase "CFR011: Send Feedback to Improve Recommendations" as CFR011
      Client --> (CFR011)
      System --> (CFR011)
    }

}

@enduml