@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Anomaly Detection Parameters" as SAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidate Financial Information in Personalized Dashboard" as CFR010
  usecase "CFR012: Manage Relationship with Advisors" as CFR011

  actor Client as C {
    --> CFR001 : View financial insights dashboard\nClient wants to understand their overall financial health.\n
    --> CFR003 : View future predictions based on historical data and market trends.\nClient seeks informed decisions for expenses planning.\n
    --> CFR004 : Receive tailored recommendations aligned with personal finance goals.\nClient aims at optimizing strategies and portfolio.\n
    --> CFR005 : Adjust preferences in personalized recommendations to align with financial objectives and risk tolerance as per KYC profile.\nClient ensures relevance of insights provided by the system.\n
    --> CFR006 : Get notified when exceeding spending limits in specific categories for budget control.\nClient maintains better fiscal oversight.\n
    --> CFR007 : Discover investment opportunities matching their defined risk profiles to diversify and grow wealth.\nClient looks for portfolio optimization.\n
    --> CFR008 : Stay updated with market-related news affecting investments to make informed decisions.\nClient seeks transparency in financial events impacting assets.\n
    --> CFR010 : Access a single view of all consolidated financial data for efficient monitoring.\nClient values simplicity and accessibility.\n
  }

  actor SystemAdmin as SA {
    --> SAFR002 : Adjust parameters governing anomaly detection to ensure compliance with regulations like Basel III or AML standards.\nSystem Admin ensures accuracy, relevance, and regulatory adherence in the system's operations.
  }

  actor FinancialAdvisor as FA {
    --> FAFR001: Manage client mentoring sessions based on AI-generated insights for personalized guidance aligned with clients' goals.\nFinancial Advisor uses data to provide more value during consultations.\n
    --> FAFR002: Monitor client intervention alerts when system detects patterns needing professional attention, allowing proactive support.\nFA helps clients address potential financial issues before they escalate.\n
  }

  actor ClientAdvisor as CA {
    --> CFR011 : Send feedback to the system about recommendations and insights for continuous improvement in future outputs. 
Client seeks to influence the quality of generated insights through user input.
  }
  
}

@enduml