@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Access Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Financial Portfolio" as CFR008
  usecase "CFR009: View Consolidated Personalized Dashboard for All Financial Information" as CFR009
  usecase "CFR010: Manage Relationship with Financial Advisors Including Data Sharing Permissions" as CFR010

  usecase "SAFR001: Manage Analysis Parameters for AI System Compliance" as SAFR001
  
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts from System" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004

  usecase "SFR001: Deliver Alerts Through Notification Channels" as SFR001
  usecase "SFR002: Generate Personalized Recommendations Based on User Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AI" as SFR004
  usecase "SFR005: Request Spending Limit Alerts When Exceeding Thresholds" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts Based on AML Regulations" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Portfolio from Trusted Sources" as SFR009
  usecase "SFR010: Generate Client Dashboards in Intuitive Format" as SFR010
  usecase "SFR011: Extract Relevant Information From Contextualized News for Users" as SFR011
  usecase "SFR012: Request Predictive Intervention Analyses from AI Component" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Provide Financial Health Reports Using Standard Metrics" as SFR014
  usecase "SFR015: Track Users' Progress Towards Financial Goals and Adjust Recommendations" as SFR015
  usecase "SFR016: Maintain Historical Record of Insights for Trend Analysis" as SFR016
  usecase "SFR017: Manage User Feedback to Improve System Accuracy" as SFR017

  usecase "AIFR001: Generate Financial Predictions Using Data and Trends" as AIFR001
  usecase "AIFR002: Create Personalized Recommendations Based on Profiles" as AIFR002
  usecase "AIFR003: Identify Spending Limit Alerts for Unusual Activity" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities Against Risk Tolerance" as AIFR004
  usecase "AIFR005: Recommend Financial Instruments Based on Modern Portfolio Theory" as AIFR005
  usecase "AIFR006: Detect Anomalies in Transactions Using Pattern Recognition" as AIFR006
  usecase "AIFR007: Correlate News with Portfolios for Relevant Insights" as AIFR007
  usecase "AIFR008: Recommend Timing of Financial Interventions Based on Patterns" as AIFR008
  usecase "AIFR009: Provide Forward-Looking Analysis to Enhance Client Guidance" as AIFR009

  actor "Client" as Client
  actor "System Administrator" as SysAdmin
  actor "Financial Advisor" as FAFRAdivisor
}

Client --> CFR001 : View Financial Insights Dashboard
SysAdmin --> SAFR001 : Manage Analysis Parameters for System Compliance
FAFRAdivisor --> FAFR002, FAFR003, FAFR004

Client --> SFR001 : Receive Alerts on Anomalous Transactions (via notification channels)
Client --> CFR006 : View Spending Limit Alerts When Exceeding Thresholds
Client --> AIFR003 : Identify Spending Limit Alerts for Unusual Activity
Client --> CFR007 : Access Investment Opportunities Based on Risk Profile
Client --> AIFR004, AIFR005 : Analyze & Recommend Investments Against Profiles and MPT

Client --> SFR012 : View Consolidated Personalized Dashboard (generated by system)
Client --> CFR008 : Receive News Related to Portfolio from System
FAFRAdivisor --> FAFR003, AIFR007 : Use Predictive Analytics & Correlate News with Portfolios

SysAdmin --> SFR016 : Maintain Historical Record of Insights for Trend Analysis (system role)
Client --> CFR009 : Manage Relationship with Financial Advisors via System
FAFRAdivisor --> FAFR002, AIFR008 : Track Client Progress & Recommend Timing of Interventions

AIFR001 --|> SFR003 : Provide Financial Predictions (system requests from AI)
AIFR002 --|> SFR004 : Create Personalized Recommendations for Users
AIFR006 --|> SFR008 : Detect Anomalies in Transactions

@enduml