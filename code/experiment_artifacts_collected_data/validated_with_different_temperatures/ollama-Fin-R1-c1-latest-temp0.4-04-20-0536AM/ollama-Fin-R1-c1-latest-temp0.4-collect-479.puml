@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sas
actor FinancialAdvisor as faa
package Professional {
  actor Chef as c2 { description: "Professional role" }
}

rectangle "System" {
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  usecase "AIFR003: Generate Spending Limit Alerts for Unusual Deviations" as AIFR003
  
  
  c1 --> CFR001 : "View Financial Insights Dashboard"
  sas --> SAFR001 : "Manage Analysis Parameters"
  faa --> FAFR001 : "Manage Client Mentoring Sessions Based on System-Generated Insights"
  c1 --> SFR002 : "Receive Personalized Recommendations"
  
}

@enduml