@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "AIFR006: Generate Contextualized News Insights Based on Portfolio" as AIFR006

  Client --> CFR001 : View Financial Dashboard  
  SysAdmin --> SAFR001 : Manage Analysis Parameters  
  FAFR003 <|-- (SFR008) : View Predictive Analytics 
}

rectangle "Client" {
  actor "User" as User
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR004: Personalized Recommendations Based on Profile" as CFR004  
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010

  User --> CFR002 : Receive Alerts  
  User --> CFR004 : Get Recommendations
  User --> CFR010 : Manage Relationships
}

rectangle "Financial Advisor" {
  actor "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Clients" as FAFR002  
  FAFR003 <|-- (SFR008) : View Predictive Analytics  

  FAFR001 --> FAFR002 : Manage Mentoring
}

rectangle "System Administrator" {
  actor "SysAdmin" as SysAdmin
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001

  SysAdmin --> SAFR001 : Configure Parameters  
}
@enduml