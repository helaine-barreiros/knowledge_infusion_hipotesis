@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  usecase "AIFR005: Generate Investment Opportunities Based on Risk Profiles" as AIFR005

  Client --> CFR001 : "View Financial Insights Dashboard"
  SysAdmin --> SAFR001 : "Manage Analysis Parameters"
  
  // User (Client, Advisor) relationships
  Client -> FAFR003 : "View Predictive Analytics for Clients"
  Client -> SFR002 : "Receive Personalized Recommendations"
  Client -> AIFR005 : "Access Investment Opportunities"

  FinancialAdvisor --> FAFR001 : "Mentor Clients Based on System Insights"
  FinancialAdvisor --> FAFR003 : "View Predictive Analytics for Clients"
  
  // Alert Management
  SFR008 -> AIFR006 : "Request Anomaly Transaction Alerts"
  SysAdmin <|-- SAFR001 : "Manage Analysis Parameters"

  // Feedback Loop
  Client --> CFR020: "Send User Feedback to Improve System"
}

@enduml