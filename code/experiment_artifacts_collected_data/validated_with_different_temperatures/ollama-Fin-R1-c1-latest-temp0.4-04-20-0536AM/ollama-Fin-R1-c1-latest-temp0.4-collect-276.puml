@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR009: Request Contextualized News from AI Component" as SFR009
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  
  Client --> CFR001 : "View Financial Dashboard"
  
  SysAdmin --> SAFR001 : "Manage Analysis Parameters"
  
  User --> SFR009 : "Request Contextualized News"
  AIComponent <|-- AIFR007
}

rectangle "Client" {
  actor Client as client
  
  usercase "View Financial Insights Dashboard" as viewDashboard
  usecase "Receive Alerts for Anomalous Transactions" as receiveAlerts
  usecase "View Financial Predictions" as viewPredictions
  usecase "Manage Personalized Recommendations Preferences" as managePreferences
  usecase "View Spending Limit Alerts" as viewSpendingLimits
  usecase "Access Consolidated Dashboard" as accessDashboard
  usecase "Manage Relationship with Advisors" as manageAdvisors
  
  
  client --> viewDashboard : "Request"
  client --> receiveAlerts : "Receive"
  client --> viewPredictions : "View"
  client --> managePreferences : "Adjust"
  client --> viewSpendingLimits : "Check"
  client --> accessDashboard : "Access"
  client --> manageAdvisors : "Share/Control"
}

rectangle "Financial Advisor" {
  actor FinancialAdvisor as advisor
  
  usecase "Manage Client Mentoring Sessions Based on Insights" as mentorSessions
  usecase "View Intervention Alerts for Clients" as viewInterventionAlerts
  usecase "View Predictive Analytics About Clients' Situations" as viewAnalytics
  usecase "Configure Analysis Parameters by Segments" as configureParams
  
  
  advisor --> mentorSessions : "Schedule"
  advisor --> viewInterventionAlerts : "Review"
  advisor --> viewAnalytics : "Analyze"
  advisor --> configureParams : "Set Up"
}

rectangle "System Administrator" {
  actor SysAdmin as admin
  usecase "Manage Analysis Parameters for AI System" as manageSysParams
  
  
  admin --> manageSysParams : "Adjust"
}

package "AI Component" {
  component AIFR001: Generate Financial Predictions
  component AIFR002: Personalized Recommendations Generation
  component AIFR003: Spending Limit Alerts Generation
  component AIFR004: Investment Opportunity Analysis
  component AIFR005: Investment Opportunities Matching
  component AIFR006: Anomaly Transaction Alerts
  component AIFR007: Contextualized News Insights
  
  usecase "AIFR001: Generate Financial Predictions" as generatePredictions
  usecase "AIFR002: Personalized Recommendations Generation" as genRecs
  usecase "AIFR003: Spending Limit Alerts Generation" as spendAlerts
  usecase "AIFR004: Investment Opportunity Analysis" as investAnalysis
  usecase "AIFR005: Investment Opportunities Matching" as matchInvestments
  usecase "AIFR006: Anomaly Transaction Alerts" as fraudAlerts
  usecase "AIFR007: Contextualized News Insights" as newsInsights
  
  
  AIFR001 <|-- generatePredictions : "Process"
  AIFR002 <|-- genRecs : "Compute"
  AIFR003 <|-- spendAlerts : "Identify"
  AIFR004 <|-- investAnalysis : "Evaluate"
  AIFR005 <|-- matchInvestments : "Filter"
  AIFR006 <|-- fraudAlerts : "Detect"
  AIFR007 <|-- newsInsights : "Correlate"
}

@enduml