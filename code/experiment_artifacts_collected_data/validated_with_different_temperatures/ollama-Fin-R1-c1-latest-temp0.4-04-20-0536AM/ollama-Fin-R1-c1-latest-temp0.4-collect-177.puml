@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002  
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Access Personalized Recommendations Aligned with Financial Profile" as CFR004 
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005  
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile and ESG Criteria" as CFR007 
  usecase "CFR008: Receive News Related to Financial Portfolio" as CFR008  
  usecase "CFR009: Consolidate Financial Information in a Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors, Including Data Sharing Permissions" as CFR10
}

rectangle "Financial Advisor (FAFR)" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001  
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: Review Predictive Analytics About Clients' Financial Situations During Consultations" as FAFR003 
}

rectangle "System Administrator (SAFR)" {
  usecase "SAFR001: Manage Analysis Parameters for AI System to Ensure Accuracy and Compliance" as SAFR001
}
  
rectangle "System (SFR)" {
  usecase "SFR002: Deliver Personalized Recommendations Based on Financial Profiles" as SFR002 
  usecase "SFR003: Request Financial Predictions from AI Component for Insights" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AI to Support Users" as SFR004  
  usecase "SFR005: Trigger Spending Limit Alerts When Exceeding Thresholds in Expense Categories" as SFR005 
  usecase "SFR006: Identify Investment Opportunities Based on Risk Profiles and Market Trends for Users" as SFR006
  usecase "SFR007: Find Specific Investments Matching User Criteria Including ESG Preferences" as SFR007  
  usecase "SFR008: Detect Anomalous Transactions in Compliance with AML Regulations Using AI" as SFR008 
  usecase "SFR009: Extract Contextualized News Relevant to Users' Portfolios from Trusted Sources" as SFR009
  usecase "SFR010: Generate Client Dashboards Presenting Financial Information Intuitively" as SFR010  
  usecase "SFR013: Create Alerts Based on Predefined Conditions for Timely Notifications" as SFR013 
  usecase "SFR014: Provide Client Analytics to Enhance Understanding of Financial Behavior and Performance" as SFR014
}

rectangle "AI System (AIFR)" {
  usecase "AIFR001: Generate Financial Predictions Using Historical Data, Market Trends, and Economic Indicators" as AIFR001  
  usecase "AIFR002: Produce Personalized Recommendations Based on User Profiles and Risk Tolerance" as AIFR002
  usecase "AIFR003: Identify Spending Limit Alerts by Analyzing Unusual Deviations in Spending Patterns" as AIFR003  
  usecase "AIFR004: Evaluate Investment Opportunities Against Users' Risk Profiles and Financial Goals" as AIFR004
  usecase "AIFR005: Select Investments Aligning with User Strategies and Modern Portfolio Theory Principles" as AIFR005 
  usecase "AIFR006: Detect Anomalous Transactions Using Pattern Recognition to Comply with Regulatory Standards" as AIFR006
  usecase "AIFR007: Correlate Financial News With User Portfolios To Identify Relevant Impacts" as AIFR007  
}

usecase "CFR11: Send Feedback on System Outputs for Improvement" as CFR11

