@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Fraud Alerts" as SAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "SAFR001: Monitor Spending Limits" as SAFR001
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access Portfolio News" as CFR008
  usecase "CFR009: Manage Relationship with Advisors" as CFR009

  rectangle "Client" {
    actor Client as c1
    client --> (CFR001)
    client --> (SAFR002)
    client --> (CFR003)
    client --> (CFR004)
    client --> (CFR005)
    client --> (SAFR001)
    client --> (CFR007)
    client --> (CFR008)
    client --> (CFR009)
  }

  rectangle "Financial Advisor" {
    actor FinancialAdvisor as fad
    fad --> (FAFR001)
    fad --> (FAFR002)
    fad --> (FAFR003)
    fad --> (FAFR004)
  }

  rectangle "System Administrator" {
    actor SysAdmin as saa
    saa --> (SAFR001)
  }
  
  usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003

  rectangle "AI System" {
    component AI as ai
    ai --> (AIFR001)
    ai --> (AIFR002)
    ai --> (SAFR001)
    ai --> (AIFR004)
    ai --> (AIFR005)
    ai --> (AIFR006)
    ai --> (AIFR007)
  }

  usecase "SFR020: Manage User Feedback" as SFR020
}

@enduml