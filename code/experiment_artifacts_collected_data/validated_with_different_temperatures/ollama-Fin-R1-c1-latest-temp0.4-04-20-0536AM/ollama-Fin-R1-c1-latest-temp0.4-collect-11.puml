@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "System" {
  rectangle "System Boundary" {
    usecase "CFR001: View Financial Insights Dashboard" as CFR001
    usecase "SAFR001: Manage Analysis Parameters" as SAFR001
    usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
    usecase "SFR009: Request Anomaly Transaction Alerts from AI Component" as SFR009
    usecase "AIFR006: Generate Investment Opportunities Based on Risk Profiles and ESG Preferences" as AIFR006

    client --> CFR001 : "View Financial Insights Dashboard"
    sysAdmin --> SAFR001 : "Manage Analysis Parameters"
    fafr004User --> FAFR004 : "Configure Analysis for Client Segments"
    sfr009System --> SFR009 : "Request Anomaly Alerts from AI Component"
    aifr006AI --> AIFR006 : "Generate Investment Opportunities Based on Risk Profiles and ESG"

  }
}

package "Client" {
  actor "User (Client)" as user
  usecase "CFR002: View Alerts About Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Manage Relationship with Financial Advisors" as CFR009

  user --> CFR002 : "View Alerts"
  user --> CFR003 : "View Predictions"
  user --> CFR004 : "Receive Recommendations"
  user --> CFR005 : "Manage Preferences"
  user --> CFR006 : "View Spending Limit Alerts"
  user --> CFR007 : "View Investment Opportunities"
  user --> CFR008 : "Access News"
  user --> CFR009 : "Manage Relationship"

}

package "Financial Advisor" {
  actor "FAFR001: Financial Advisor (User)" as fafr
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003

  fafr --> FAFR002 : "View Interventions"
  fafr --> FAFR003 : "View Predictive Analytics"

}

package "System Administrator" {
  actor "SysAdmin (User)" as sysadmin
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001

  sysadmin --> SAFR001 : "Manage Params"
  
}
@enduml