@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access Personalized Dashboard" as CFR008
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010

  actor Client as cClient
  actor SysAdmin as sSysAdmin
  actor FAFR as fFAFR

  cClient --> CFR001 : View financial insights dashboard  
  cClient --> CFR003 : View financial predictions  
  cClient --> CFR004 : Receive personalized recommendations  
  cClient --> CFR005 : Manage recommendation preferences  
  cClient --> CFR006 : View spending limit alerts  
  cClient --> CFR007 : View investment opportunities  
  cClient --> CFR008 : Access personalized dashboard
  sSysAdmin --> SAFR001 : Manage analysis parameters  

  fFAFR --> FAFR002 : View client intervention alerts  
}

@enduml