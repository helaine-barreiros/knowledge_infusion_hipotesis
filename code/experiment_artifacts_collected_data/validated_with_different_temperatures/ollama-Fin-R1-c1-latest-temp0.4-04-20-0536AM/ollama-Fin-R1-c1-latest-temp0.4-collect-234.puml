@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sa
actor FinancialAdvisor as fa

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  usecase "SFR009: Request Anomaly Transaction Alerts from AI Component" as SFR009
  usecase "AIFR006: Generate Contextualized News Insights Based on Portfolio" as AIFR006

  c1 --> CFR001 : View financial data and dashboards  
  sa --> SAFR001 : Manage system parameters for compliance
  fa --> FAFR004 : Customize analysis settings per client segments  
  SysAdmin --> SFR009 : Trigger anomaly alerts via system  
  AIFR006 <|-- c1 : Provide news insights relevant to portfolio

}

@enduml