@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as C1
actor FinancialAdvisor as FA
actor SysAdmin as SA
system S

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Access Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: Receive Spending Limit Alerts When Exceeding Predefined Thresholds" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile (MiFID II)" as CFR007
  usecase "CFR008: Access News Related to Investment Portfolio" as CFR008
  usecase "CFR009: Manage Relationship with Financial Advisors, Including Data Sharing Permissions" as CFR009

  C1 --> CFR001 : View dashboard
  C1 --> CFR002 : Receive alerts for transactions
  C1 --> CFR003 : Get financial predictions
  C1 --> CFR004 : Access recommendations
  C1 --> CFR005 : Manage preferences
  C1 --> CFR006 : Receive spending limit alerts
  C1 --> CFR007 : View investment opportunities
  C1 --> CFR008 : Read news
  C1 --> CFR009 : Manage relationships with advisors

}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: Review Predictive Analytics About Clients' Financial Situations" as FAFR003

  FA --> FAFR001 : Manage mentoring sessions
  FA --> FAFR002 : View intervention alerts
  FA --> FAFR003 : Review predictive analytics
}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters for AI System to Ensure Accuracy and Compliance with Basel III, etc." as SAFR001

  SA --> SAFR001 : Manage analysis parameters
}

system S {
  usecase "SFR001: Deliver Alerts Through Notification Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Financial Profiles" as SFR002
  usecase "SFR003: Request Predictive Interventions from AI Component" as SFR003
  usecase "SFR004: Generate Client Dashboards with Financial Information" as SFR004

  SysAdmin --> SAFR001 : Manage parameters for compliance and accuracy
}

rectangle "AI System (AIFR)" {
  usecase "AIFR001: Generate Financial Predictions by Analyzing Data, Market Trends, Economic Indicators" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations Based on User Profiles and Risk Tolerance" as AIFR002

  SysAdmin --> SAFR001 : Manage parameters for compliance and accuracy (inherits from system)
}

@enduml