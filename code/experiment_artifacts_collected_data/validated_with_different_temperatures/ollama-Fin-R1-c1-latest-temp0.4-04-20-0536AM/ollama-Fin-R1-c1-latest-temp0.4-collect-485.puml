@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Alert Preferences" as SAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: Access Investment Opportunities" as CFR007
  usecase "CFR008: Receive News Related to Portfolio" as CFR008
  usecase "CFR009: Manage Relationship with Advisors" as CFR009

  rectangle "Client Interface" {
    actor Client as client
    client --> CFR001 : View financial insights dashboard
    client --> CFR003 : View financial predictions
    client --> CFR004 : Receive personalized recommendations
    client --> CFR005 : Manage recommendation preferences
    client --> CFR006 : View spending limit alerts
    client --> CFR007 : Access investment opportunities
    client --> CFR008 : Receive news related to portfolio
  }

  rectangle "Client Management" {
    actor SysAdmin as sysadmin
    sysadmin --> SAFR002 : Manage alert preferences (for clients)
  }
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003

  rectangle "Financial Advisor Interface" {
    actor FinancialAdvisor as advisor
    advisor --> FAFR001 : Manage client mentoring sessions based on system-generated insights
    advisor --> FAFR002 : View client intervention alerts
    advisor --> FAFR003 : View predictive analytics about clients' financial situations
  }

  usecase "SFR001: Deliver Alerts" as SFR001
  usecase "SFR004: Request Personalized Recommendations" as SFR004

  rectangle "System Operations" {
    actor System as system
    system --> CFR002 : Receive alerts (from clients)
    system --> SAFR003 : Request financial predictions from AI component
    system --> SAFR005 : Request spending limit alerts from AI component
    system --> SFR004 : Request personalized recommendations based on user profiles and preferences

  }

  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003

  rectangle "AI Component" {
    actor AIComponent as ai
    system --> AIFR001 : Request financial predictions (from AI)
    system --> AIFR002 : Request personalized recommendations (from AI)
    client --> AIFR006 : Receive spending limit alerts from AI component

  }

  usecase "CFR011: Send Feedback" as CFR011
}

@enduml