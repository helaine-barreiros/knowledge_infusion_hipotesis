@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C1
}

rectangle "System" {
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  
  usecase "CFR004: Receive Personalized Recommendations Aligned with Financial Profile and Goals" as CFR004
  
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile (MiFID II)" as CFR007
  
  usecase "CFR008: Receive News Related to Investment Portfolio" as CFR008
  
  usecase "CFR009: View Consolidated Financial Information in a Single Dashboard" as CFR009
  
  usecase "CFR10: Manage Relationship with Financial Advisors, Including Data Sharing Permissions" as CFR10
}

actor SysAdmin as SA

rectangle "System Administrator" {
  
  usecase "SAFR001: Manage Analysis Parameters for AI System Compliance" as SAFR001
}

package "Financial Advisor" {
  
  actor FAFR001: Financial Advisor as FA
  
  usecase "FAFR002: View Client Intervention Alerts Based on System Insights" as FAFR002
  
  usecase "FAFR003: Access Predictive Analytics for Clients" as FAFR003
  
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004
}

actor SFR001: System as Sys

usecase "SFR002: Deliver Personalized Recommendations Based on Financial Profiles" as SFR002
  
usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  
usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004

usecase "SFR005: Request Spending Limit Alerts Based on User Activity" as SFR005

usecase "SFR006: Request Investment Opportunity Analysis for Users" as SFR006
  
usecase "SFR007: Find Specific Investment Opportunities Matching Risk Profiles and ESG Preferences" as SFR007

usecase "SFR008: Deliver Anomaly Transaction Alerts Based on AI Analysis" as SFR008

usecase "SFR009: Extract Contextualized News Relevant to User Portfolios" as SFR009
  
usecase "SFR010: Generate Client Dashboards with Financial Information" as SFR010

usecase "SFR013: Deliver Predefined Alerts Based on Conditions" as SFR013

usecase "SFR014: Provide Client Analytics for Performance Insights" as SFR014
  
usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015

usecase "SFR016: Enhance Financial Guidance with Proactive Recommendations" as SFR016

usecase "SFR017: Generate Financial Health Reports Based on Standard Metrics" as SFR017

usecase "SFR020: Manage User Feedback to Improve System Accuracy" as SFR020

actor AIFR001: AI System as AIS
  
  usecase "AIFR003: Identify Spending Limit Alerts for Users Based on Pattern Recognition" as AIFR003

usecase "AIFR004: Evaluate Investment Opportunities Against Risk Profiles and Financial Goals" as AIFR004

usecase "AIFR005: Align Investments with Modern Portfolio Theory Principles" as AIFR005

usecase "AIFR006: Detect Anomalies in Transactions for Fraud Prevention (FinCEN)" as AIFR006

usecase "AIFR007: Correlate Financial News to User Portfolios for Relevant Insights" as AIFR007

usecase "AIFR008: Predict Client Intervention Needs Based on Behavioral Patterns" as AIFR008

usecase "AIFR009: Provide Forward-Looking Analysis of Financial Situations" as AIFR009
}

actor CFR11: User (Client, Advisor or SysAdmin) as U

C1 --> CFR001 : View Financial Insights Dashboard\n(CFR001)
C1 --> CFR002 : Receive Alerts on Anomalous Transactions\n(CFR002)
C1 --> CFR003 : View Predictions Based on Historical Data and Trends\n(CFR003)
C1 --> CFR004 : Personalized Recommendations Aligned with Goals\n(CFR004)
C1 --> CFR005 : Manage Recommendation Preferences\n(CFR005)
C1 --> CFR006 : Spending Limit Alerts for Exceeding Thresholds\n(CFR006)
C1 --> CFR007 : Investment Opportunities Based on Risk Profile (MiFID II)\n(CFR007)
C1 --> CFR008 : News Related to Portfolio\n(CFR008)
C1 --> CFR009 : Consolidated Financial Dashboard\n(CFR009)
C1 --> CFR10 : Manage Relationship with Advisors, Data Sharing Permissions\n(CFR10)

SA --> SAFR001 : Manage AI Analysis Parameters for Compliance (SAFR001)

FA --> FAFR002 : View Client Intervention Alerts Based on System Insights (FAFR002)
FA --> FAFR003 : Access Predictive Analytics (FAFR003)
FA --> FAFR004 : Configure Analysis Parameters by Segment (FAFR004)

SysAdmin -->> Sys: Manage System Components\n(SysAdmin to System Boundary)

SFR001 --> SFR002 : Deliver Personalized Recommendations Based on Profiles\n(SFR002)
SFR001 --> SFR003 : Request Financial Predictions (AIS)\n(AIFR001 - AIFR004)
SFR001 --> SFR004 : Request Personalized Recs from AIS\n(AIFR002, AIFR005)
SFR001 --> SFR005 : Spending Limit Alerts (AIS)\n(AIFR003)
SFR001 --> SFR006 : Investment Opportunity Analysis (AIS)\n(AIFR004 - AIFR007)
SFR001 --> SFR008 : Anomaly Transaction Alerts\n(AIS - AIFR006)
SFR001 --> SFR009 : Contextualized News for Portfolios (AIS)\n(AIFR007)
SFR001 --> SFR010 : Generate Dashboards\n(AIS)
SFR001 --> SFR013 : Deliver Predefined Alerts Based on Conditions\n(SFR020)
SFR001 --> SFR014 : Client Analytics (AIS)\n(AIFR009)
SFR001 --> SFR015 : Predictive Intervention Analyses from AIS\n(AIFR008)
SFR001 --> SFR016 : Proactive Recommendations via AI Insights\n(SFR020, AIFR003 - AIFR009)
SFR001 --> SFR017 : Financial Health Reports (AIS)\n(AIFR008)
SFR001 --> SFR020 : Manage User Feedback for System Improvement\n(SFR020)

U -->> AIS: Send Feedback on Recommendations and Insights\n(CFR11 to AIFR Components)

@enduml