@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sa1
actor FinancialAdvisor as fa1

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Personalized Recommendations Based on Profile" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Spending Limit Alerts for Budget Control" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidated Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10

  c1 --> CFR001 : Request dashboard\nView data\nMonitor financial health
  c1 --> CFR002 : Set up alerts\nReceive notifications on unusual transactions\nComply with FATF regulations
  c1 --> CFR003 : Access future projections\nUse historical and market trends for decision-making
  c1 --> CFR004 : Get tailored advice\nOptimize financial strategies based on profile
  c1 --> CFR005 : Adjust preferences\nEnsure relevance of recommendations to goals and risk tolerance
  c1 --> CFR006 : Set spending limits\nReceive alerts when exceeding thresholds in expense categories
  c1 --> CFR007 : Discover portfolio opportunities\nDiversify investments based on risk profile
  c1 --> CFR008 : Stay informed about market events\nMonitor asset impacts from news sources
  c1 --> CFR009 : Centralize financial info\nEfficiently track all accounts in one place
  c1 --> CFR10 : Share data with advisors\nControl access and permissions for privacy

}

rectangle "FinancialAdvisor" {
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: Analyze Predictive Analytics on Clients" as FAFR003
  fa1 --> FAFR002 : Monitor client activity\nTake proactive steps to resolve issues
  fa1 --> FAFR003 : Use data-driven insights for consultations\nImprove guidance quality

}

rectangle "SysAdmin" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  sa1 --> SAFR001 : Adjust algorithm settings\nEnsure compliance with regulations like Basel III and GDPR
}

rectangle "System" {
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "SFR004: Request AI Recommendations" as SFR004
  usecase "SFR005: Manage Spending Limit Alerts" as SFR005
  usecase "SFR006: Analyze Investment Opportunities" as SFR006
  usecase "SFR007: Find ESG-Matched Investments" as SFR007
  usecase "SFR008: Detect Anomalies in Transactions" as SFR008
  usecase "SFR009: Extract Contextualized News" as SFR009
  usecase "SFR12: Generate Client Dashboards" as SFR12

}

rectangle "AI System" {
  usecase "AIFR003: Identify Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities" as AIFR004
  usecase "AIFR005: Recommend Investments Based on Risk Profile" as AIFR005
  usecase "AIFR006: Alert for Fraudulent Transactions" as AIFR006
}

rectangle "User (Client, Advisor)" {
  usecase "CFR11: Send Feedback to System" as CFR11

}
@enduml