@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001 
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  
  client --> CFR001 : "Client wants to view financial insights."
  
  SysAdmin --> SAFR001 : "System Administrator manages analysis parameters."
  
  FAFR002 <|-- (SFR013) : Financial Advisor views alerts generated by system.
}

rectangle "Financial Advisors" {
  actor "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "CFR009: View Personalized Dashboard" as CFR009
  
  SysAdmin --> (SFR012) : System generates dashboards for clients.
  
  FAFR001 -> (FAFR003) : Financial Advisor views predictive analytics about client financial situations.
}

rectangle "Client - System Interactions" {
  usecase "CFR008: View News Related to Investment Portfolio" as CFR008
  usecase "SFR009: Request Contextualized News Insights from AI Component" as SFR009
  
  client --> (SFR009) : Client requests news related to their portfolio.
  
  AIFR007 <|-- (SFR009) : AI system provides contextualized news insights based on user's investments.
}

rectangle "User Feedback Loop" {
  usecase "CFR011: Send System Recommendations/Insights Feedback" as CFR011
  
  client --> (AIFR002) : Client provides feedback to improve recommendations.
  
  AIFR002 <|-- (SFR020) : AI system incorporates user feedback for future improvements.
}

@enduml