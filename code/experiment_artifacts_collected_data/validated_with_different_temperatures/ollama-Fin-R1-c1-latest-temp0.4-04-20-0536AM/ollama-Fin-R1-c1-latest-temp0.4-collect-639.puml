@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "SFR012: Generate Client Dashboards" as SFR012

  // Relationships between actors and system
  Client --> CFR001 : "View Financial Insights Dashboard"
  SysAdmin --> SAFR001 : "Manage Analysis Parameters"

  // System uses cases to generate content for dashboards
  (CFR001) <|-- (SFR012)
}

rectangle "Client" {
  actor Client as c

  usecase "CFR002: View Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Manage Relationship with Financial Advisors" as CFR009

  c --> (SFR013) : "Receive Alerts"
}

rectangle "Financial Advisor" {
  actor FAdvisor as fad

  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR004: Configure Analysis Parameters for Segments" as FAFR004
  usecase "SFR015: Request Predictive Interventions from AI" as SFR015

  fad --> (SAFR001) : "Manage Analysis Parameters"
}

rectangle "System Administrator" {
  actor SysAdmin as sa

  usecase "FAFR004: Configure Analysis Parameters for Segments" as FAFR004
  usecase "SFR013: Generate Client Alerts Based on Conditions" as SFR013

  (SAFR001) <|-- (SysAdmin)
}

rectangle "AI System" {
  actor AIFR as aifr

  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Identify Investment Opportunities Based on Risk Profile" as AIFR004
  usecase "AIFR005: Align Investments with Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Detect Anomalous Transactions for Fraud Detection" as AIFR006
  usecase "AIFR007: Correlate News to Portfolios" as AIFR007

  aifr --> (SFR013) : "Generate Alerts"
}

// Relationship between System and AI components
(SAFR001) <|-- (aifr)
(AIFR002) <|-- (CFR004)
(AIFR006) <|-- (CFR008)

@enduml