@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "AIFR009: Generate Client Predictive Intervention Recommendations" as AIFR009

  Client --> CFR001
  SysAdmin --> SAFR001
  FinancialAdvisor --> FAFR003, FAFR002, FAFR004, AIFR008
}

rectangle "Client" {
  usecase "CFR002: View Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Manage Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10

  Client --> CFR002, CFR003, CFR004, CFR005, CFR006, CFR007, CFR008, CFR009, CFR10
}

rectangle "FinancialAdvisor" {
  usecase "FAFR001: Manage Mentorship Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  FinancialAdvisor --> FAFR003, FAFR004

}

rectangle "SysAdmin" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  SysAdmin --> SAFR001
}
@enduml