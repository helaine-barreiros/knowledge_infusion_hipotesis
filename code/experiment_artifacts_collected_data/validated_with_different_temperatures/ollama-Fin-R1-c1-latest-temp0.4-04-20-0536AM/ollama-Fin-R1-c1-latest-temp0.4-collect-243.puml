@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR004: Personalized Recommendations Based on Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidated Financial Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10
  
  SysAdmin --> SAFR001 : Configure system parameters for compliance and accuracy.
  
  Client -> CFR001, CFR002, CFR003, CFR004, CFR005, CFR006, CFR007, CFR008, CFR009, CFR10
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Clients" as FAFR002
  usecase "CFR003: Personalized Recommendations for Advisors to Share with Clients" as CFR004
  
  Client --> (CFR004) : Receive recommendations from advisors.
}

rectangle "Client" {
  SysAdmin -> SAFR001 : Adjust analysis parameters via system admin role.

  usecase "SFR003: Request Financial Predictions From AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts" as SFR005
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  SysAdmin --> (SAFR001) : Manage system parameters.
  
  Client -> CFR003, CFR004, CFR006, CFR007, CFR008, CFR009
}

rectangle "Financial Advisor - System" {
  usecase "AIFR002: Generate Personalized Recommendations for Users Based on Financial Profiles and Goals" as AIFR002
  usecase "AIFR003: Identify Unusual Spending Patterns via Alerts" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities Against Risk Tolerance" as AIFR004
  
  SysAdmin --> (SAFR001) : Manage system parameters.
  
  Client -> CFR002, CFR007, SFR005, SFR006
}

rectangle "System - AI Component" {
  usecase "AIFR001: Generate Financial Predictions Using Historical Data and Market Trends" as AIFR001
  usecase "AIFR008: Correlate News with Client Portfolios for Insights" as AIFR008
  
  SysAdmin --> (SAFR001) : Manage system parameters.
  
  Client -> CFR003, SFR004, SFR005
}

rectangle "Client - System" {
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Profiles" as SFR002
  usecase "SFR019: Manage Historical Record of Insights for Trend Analysis" as SFR019
  
  SysAdmin --> (SAFR001) : Adjust system settings.
  
  Client -> CFR004, CFR005, CFR006, CFR007
}

rectangle "User Feedback Loop" {
  usecase "CFR11: Send System Recommendations and Insights for Improvement" as CFR11
  
  SysAdmin --> (SAFR001) : Incorporate user feedback into system improvements.
  
  Client -> CFR11
}
@enduml