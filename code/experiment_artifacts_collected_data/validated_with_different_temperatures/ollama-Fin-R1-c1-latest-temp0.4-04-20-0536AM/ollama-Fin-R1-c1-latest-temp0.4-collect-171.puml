@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "SFR012: Generate Client Dashboards" as SFR012

  client --> CFR001 : "Client wants to view financial data in a consolidated format."
  
  SysAdmin --> SAFR001 : "System Administrator manages analysis parameters for accuracy and compliance."

  FAFR003 <|-- (SFR014) : "Financial Advisor views predictive analytics generated by the system."
}

rectangle "AI System" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002

  SFR013 --> AIFR001 : "System requests financial predictions from AI."
}

rectangle "Client-Advisor System" {
  actor Client as client
  actor FinancialAdvisor as FAdvisors
  
  client -> FAdvisors : "Client shares feedback on system outputs to improve accuracy."

  usecase "CFR011: Send Feedback" as CFR011

  FAdvisors --> SFR014 : "Financial Advisor uses generated dashboards and insights."
}

@enduml