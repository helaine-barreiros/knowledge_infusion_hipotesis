  usecase "SFR012: Process Contextualized News to Identify Portfolio Impacts" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Provide Financial Health Reports Using Standard Metrics" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI Component for Advisor Engagement Timing" as SFR015
  usecase "SFR016: Enhance Client Guidance with Predictive Insights From AI System" as SFR016

  sys --> (SFR001)
  sys --> (SFR002)
  sys --> (SFR003)
  sys --> (SFR004)
  sys --> (SFR005)
  sys --> (SFR006)
  sys --> (SFR007)
  sys --> (SFR008)
  sys --> (SFR009)
  sys --> (SFR010)
  sys --> (SFR011)
  sys --> (SFR012)
}

rectangle "AI System" {
  usecase "AIFR001: Generate Financial Predictions Using Data and Trends" as AIFR001
  usecase "AIFR002: Provide Personalized Recommendations Based on Profiles" as AIFR002
  usecase "AIFR003: Issue Spending Limit Alerts for Unusual Activity Detection" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities Against Risk Tolerance and Goals" as AIFR004
  usecase "AIFR005: Identify Financial Instruments Aligning with Portfolio Strategies" as AIFR005
  usecase "AIFR006: Detect Anomalous Transactions Using Pattern Recognition" as AIFR006
  usecase "AIFR007: Correlate News to Portfolios for Relevant Insights" as AIFR007
  usecase "AIFR008: Recommend Proactive Intervention Based on Financial Patterns" as AIFR008

  sys <|-- (AIFR001)
  sys <|-- (AIFR002)
  sys <|-- (AIFR003)
  sys <|-- (AIFR004)
  sys <|-- (AIFR005)
  sys <|-- (AIFR006)
  sys <|-- (AIFR007)
}

