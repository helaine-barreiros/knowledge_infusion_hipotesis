@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sa1
actor FinancialAdvisor as fa1

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "AIFR006: Generate Anomaly Transaction Alerts for Users" as AIFR006
  
  c1 --> CFR001 : "View Financial Insights Dashboard"
  sa1 --> SAFR001 : "Manage Analysis Parameters"
  
  fa1 --> FAFR002 : "View Client Intervention Alerts"
  
  client --> CFR004 : "Receive Personalized Recommendations"
  client --> CFR005 : "Manage Recommendation Preferences"
  
  system --> SFR013 : "Generate Client Alerts Based on Predefined Conditions"
  system --> AIFR006 : "Generate Anomaly Transaction Alerts for Users"

}

@enduml