@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sas
actor FinancialAdvisor as faa
system "System" as sys

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Access Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Receive Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidate Financial Information in a Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10

  c1 --> CFR001 : view dashboard
  c1 --> CFR002 : receive alerts
  c1 --> CFR003 : see predictions
  c1 --> CFR004 : get recommendations
  c1 --> CFR005 : manage preferences
  c1 --> CFR006 : receive spending limit alerts
  c1 --> CFR007 : view opportunities
  c1 --> CFR008 : access news
  c1 --> CFR009 : consolidate info
  c1 --> CFR10 : manage relationship

}

rectangle "System Administrator Interface" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  sas --> SAFR001 : configure parameters
}
@enduml