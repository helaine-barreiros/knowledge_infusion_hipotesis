@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002

  actor "Client" as client
  actor "Financial Advisor" as fa
  actor "System Administrator" as sysadmin
  
  client --> CFR001 : "View Financial Insights Dashboard"
  
  client --> SFR003 : "Request Financial Predictions from AI Component"
  client --> AIFR002 : "Generate Personalized Recommendations for Users"
  client --> SFR005 : "Request Spending Limit Alerts from AI Component"
  client --> SFR006 : "Request Investment Opportunity Analysis from AI Component"
  
  fa --> FAFR001 : "Manage Client Mentoring Sessions Based on System-Generated Insights"
  fa --> FAFR002 : "View Client Intervention Alerts When System Detects Patterns Requiring Professional Attention"
  fa --> SFR006 : "Request Investment Opportunity Analysis from AI Component"
  
  sysadmin --> SAFR001 : "Manage Analysis Parameters for the AI System to Ensure Accuracy and Compliance with Financial Regulations"

}

@enduml