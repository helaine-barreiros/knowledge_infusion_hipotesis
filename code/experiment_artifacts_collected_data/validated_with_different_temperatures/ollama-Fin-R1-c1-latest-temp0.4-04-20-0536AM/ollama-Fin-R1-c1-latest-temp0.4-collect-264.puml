@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "SFR017: Generate Financial Health Reports" as SFR017

  Client --> CFR001 : "View financial data, predictions, and recommendations"
  SysAdmin -> SAFR001 : "Manage system parameters for accuracy and compliance"

  rectangle "Client Interface" {
    usecase "CFR002: View Alerts on Anomalous Transactions" as CFR002
    usecase "CFR003: View Financial Predictions" as CFR003
    usecase "CFR004: Receive Personalized Recommendations" as CFR004
    usecase "CFR005: Manage Recommendation Preferences" as CFR005
    usecase "CFR006: View Spending Limit Alerts" as CFR006
    usecase "CFR007: Access Investment Opportunities" as CFR007
    usecase "CFR008: Stay Informed with Financial News" as CFR008
    usecase "CFR009: Consolidate Financial Information in Dashboard" as CFR009
    usecase "CFR10: Manage Relationship with Advisors" as CFR10

    Client --> CFR002 : "Receive alerts for potential fraud"
    Client --> CFR003 : "View future financial trends and plan expenses"
    Client --> CFR004 : "Get tailored advice based on profile"
    Client --> CFR005 : "Adjust personalization settings as per KYC data"
    Client --> CFR006 : "Monitor budget adherence via spending limits"
    Client --> CFR007 : "Explore investment options suitable for risk tolerance"
    Client --> CFR008 : "Stay updated on market events affecting investments"
    Client --> CFR009 : "Centralize financial info in a single view"
    Client --> CFR10 : "Control data sharing with advisors"

  }

  rectangle "Financial Advisor Interface" {
    usecase "FAFR002: View Intervention Alerts for Clients" as FAFR002
    usecase "FAFR004: Configure Analysis Parameters by Segment" as FAFR004

    FinancialAdvisor --> FAFR002 : "Identify clients needing immediate attention"
    FinancialAdvisor --> FAFR004 : "Customize system behavior for client groups"

  }

  rectangle "System Administrator Interface" {
    usecase "SAFR001: Manage Analysis Parameters" as SAFR001
    SysAdmin -> SAFR001 : "Adjust parameters to ensure compliance and accuracy"
  }
}

@enduml