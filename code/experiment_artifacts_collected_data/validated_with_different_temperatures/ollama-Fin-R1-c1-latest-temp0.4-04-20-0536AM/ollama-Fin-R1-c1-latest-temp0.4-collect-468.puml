@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Anomaly Alerts Thresholds" as SAFR002
  usecase "FAFR005: Schedule Client Mentoring Sessions" as FAFR005
  
  // Clients (CFR)
  client --> CFR001 : View financial data, receive alerts, view predictions, manage recommendations preferences.
  
  // System Admins (SAFR)
  SysAdmin --> SAFR002 : Manage thresholds for anomaly detection and system parameters.

  // Financial Advisors (FAFR)
  FAFR005 <|-- CFR001 : Schedule mentoring sessions based on client insights. 
}

@enduml