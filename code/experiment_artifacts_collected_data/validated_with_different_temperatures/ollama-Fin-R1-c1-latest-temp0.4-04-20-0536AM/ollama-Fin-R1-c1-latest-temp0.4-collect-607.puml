@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Notification Preferences" as SAFR002
  usecase "FAFR005: Schedule Mentoring Sessions" as FAFR005
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013  
}

rectangle "Client" {
  actor "User (Client)" as UserClient
  userClient --> CFR001 : "View Financial Insights Dashboard"
  userClient --> SAFR002 : "Manage Notification Preferences"
  userClient --> SFR013: "Generate Client Alerts Based on Predefined Conditions"
}

rectangle "Financial Advisor" {
  actor "User (Advisor)" as UserAdvisor
  userAdvisor --> FAFR005 : "Schedule Mentoring Sessions"
  userAdvisor --> FAFR002 : "View Intervention Alerts"
  userAdvisor --> AIFR008: "Generate Predictive Intervention Recommendations"
}

rectangle "System Administrator" {
  actor SysAdmin as SystemAdmin
  systemAdmin --> SAFR001 : "Manage Analysis Parameters for AI Algorithms"
}

package "Financial Insights Engine" {
  
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003  
  usecase "AIFR004: Identify Investment Opportunities Based on Risk Profile" as AIFR004
  usecase "AIFR005: Align Investments with Client's ESG Preferences and Goals" as AIFR005
  usecase "AIFR006: Detect Anomaly Transactions for Fraud Prevention" as AIFR006  
  usecase "AIFR007: Correlate News to User Portfolios" as AIFR007
  usecase "AIFR008: Recommend Intervention Actions Based on Predictive Analysis" as AIFR008

}

rectangle "User Interface (UI)" {
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SFR012: Generate Client Dashboards" as SFR012
  
  SysAdmin --> SAFR001 : "Manage Analysis Parameters for AI Algorithms"
}

rectangle "Data Processing & Storage (DPS)" {
  
  usecase "AIFR009: Process Contextualized News Insights" as AIFR009
  usecase "SFR020: Manage User Feedback to Improve System Accuracy" as SFR020
  
}

// Relationships between components

CFR001 <|-- (UserClient)
SAFR002 <|-- (UserClient)  
FAFR005 <|-- (UserAdvisor)
FAFR002 <|-- (UserAdvisor)
SFR013 <|-- (UserClient)
AIFR008 <|-- (UserAdvisor)

SysAdmin --> SAFR001 : "Manage Analysis Parameters for AI Algorithms"

// Note: The above relationships are derived from the functional requirements. Each use case is linked to its respective actors or systems as per their descriptions.

@enduml