@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  
  Client --> (CFR001)
  SysAdmin --> (SAFR001)
}

rectangle "Client" {
  actor "User" as User
  user -> CFR002 : "View Alerts"
  
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Preferences for Recommendations" as CFR005
  
  User --> (CFR001)
  User --> (CFR002)
  User --> (CFR003) : "View Financial Predictions"
  User --> (CFR004)
  User --> (CFR005)
}

rectangle "Financial Advisor" {
  actor "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Clients" as FAFR002
  
  FAFR001 --> (CFR003)
  
  SysAdmin <|-- SAFR001 : "Configure"
}

rectangle "System Administrator" {
  actor "SysAdmin" as SysAdmin
  usecase "SAFR004: Configure Analysis Parameters for Client Segments" as SAFR004
  
  SysAdmin --> (CFR003)
  
  SysAdmin <|-- SAFR001 : "Manage"
}

rectangle "System" {
  actor "SFR008: Deliver Anomaly Transaction Alerts" as SFR008
  usecase "AIFR006: Generate Spending Limit Alerts Based on AI Analysis" as AIFR006
  
  SysAdmin --> (SAFR004)
  
  SysAdmin <|-- SAFR001 : "Manage"
}

rectangle "AI System" {
  actor "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
  usecase "CFR011: Send Feedback on Insights and Recommendations" as CFR011
  
  SysAdmin <|-- SAFR004 : "Configure"
}

@enduml