@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Alert Thresholds" as SAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "SAFR006: Configure Analysis Parameters for Clients" as SAFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access Personalized Dashboard" as CFR008
  usecase "CFR010: Manage Relationship with Advisors" as CFR010
  
  rectangle "Client (User)" {
    actor Client as C
    C --> CFR001 : View Financial Insights Dashboard
    C --> CFR002 : Receive Alerts for Anomalous Transactions
    C --> CFR003 : View Financial Predictions
    C --> CFR004 : Receive Personalized Recommendations
    C --> CFR005 : Manage Recommendation Preferences
    C --> SAFR006 : Configure Analysis Parameters (via System Admin)
  }
  
  rectangle "System Administrator" {
    actor SysAdmin as SA
    SA --> SAFR001: Manage Analysis Parameters for AI
    SA --> SAFR002: Manage Alert Thresholds (for Clients)
    SA --> CFR006 : View Spending Limit Alerts
  }

  rectangle "Financial Advisor" {
    actor FAFR as FA
    FA --> FAFR001: Manage Client Mentoring Sessions
    FA --> FAFR003: View Predictive Analytics for Clients
    FA --> SAFR004: Configure Analysis Parameters (for Specific Segments)
  }

  rectangle "System" {
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "SFR007: Deliver Investment Opportunity Analysis" as SFR007
    usecase "AIFR004: Identify Suitable Investments Based on Risk Profile" as AIFR004
    usecase "SAFR008: Generate Anomaly Transaction Alerts" as SAFR008
    
    SysAdmin --> SAFR001 : Manage Analysis Parameters (for AI)
    
    C --> SFR002 : Request Personalized Recommendations from System
    SA --> AIFR003 : Configure Thresholds for Spending Limit Alerts
  }

  rectangle "AI Component" {
    usecase "AIFR005: Identify Investment Opportunities Based on Risk Profile" as AIFR005
    usecase "SFR017: Generate Financial Health Reports" as SFR017
    
    C --> AIFR002 : Receive Personalized Recommendations (from AI)
  }

  rectangle "News Component" {
    usecase "AIFR006: Correlate News with Portfolios" as AIFR006
    FAFR --> SFR019 : Manage Historical Records of Insights
  }
  
  C <|-- SAFR002 : Client can manage their own alert thresholds (via System)
}

@enduml