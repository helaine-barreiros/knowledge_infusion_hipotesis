@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Alert Preferences" as SAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Customize Recommendation Preferences" as CFR005
  usecase "CFR006: Monitor Spending Limit Alerts" as CFR006
  usecase "CFR007: Explore Investment Opportunities" as CFR007
  usecase "CFR008: Access Portfolio News" as CFR008
  usecase "CFR009: Consolidate Financial Data" as CFR010
  usecase "SAFR003: Manage System Parameters" as SAFR004
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR005: Configure Analysis for Segments" as FAFR006

  actor "Client" as client {
    CFR001 --> (CFR001)
    SAFR004 --> (SAFR003)
    CFR002 --> (SFR008) : "View Alerts"
    CFR005 --> (AIFR009) : "Feedback on Recommendations"
  }
  
  actor "Financial Advisor" as advisor {
    FAFR001 --> (FAFR003)
    FAFR002 --> (CFR006) : "View Alerts"
    FAFR005 --> (SAFR004) : "Configure Analysis Parameters"
  }
  
  actor "System Administrator" as admin {
    SAFR001 --> (SAFR003)
    SAFR002 --> (CFR006) : "Manage Alerts"
  }

  system boundary Sys
}

@enduml