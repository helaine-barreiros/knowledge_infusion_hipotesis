left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Trends" as CFR003
  usecase "CFR004: Personalized Recommendations Aligned with Client's Profile" as CFR004
  usecase "CFR005: Manage Personalized Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile and MiFID II Standards" as CFR007
  usecase "CFR008: Receive News Related to Financial Portfolio" as CFR008
  usecase "CFR009: Consolidated Personalized Dashboard for Efficient Monitoring" as CFR009
  usecase "CFR010: Manage Relationship with Financial Advisors Including Data Sharing Permissions" as CFR010

  rectangle "Financial Advisor (FAFR)" {
    usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
    usecase "FAFR002: View Client Intervention Alerts When System Detects Patterns Requiring Professional Attention" as FAFR002
