  rectangle "System Administrator (SAFR)" {
    usecase "SAFR001: Manage Analysis Parameters to Ensure Accuracy and Compliance with Basel III" as SAFR001
  }

  rectangle "Client, System, AI Components Interaction" {
    client --> CFR001 : View Financial Insights Dashboard\nCFR002: Receive Alerts for Anomalous Transactions\nCFR003: Predictions Based on Data and Trends\nCFR004: Personalized Recommendations\nCFR005: Manage Preferences\nCFR006: Spending Limit Alerts\nCFR007: Investment Opportunities\nCFR008: News Related to Portfolio\nCFR009: Consolidated Dashboard\nCFR010: Relationship Management
  }
  
  client --> FAFR001 : Manage Client Mentoring Sessions Based on Insights\nFAFR002: View Intervention Alerts\nFAFR003: Predictive Analytics for Consultations

  sysadmin --> SAFR001 : Manage Analysis Parameters

}

@enduml