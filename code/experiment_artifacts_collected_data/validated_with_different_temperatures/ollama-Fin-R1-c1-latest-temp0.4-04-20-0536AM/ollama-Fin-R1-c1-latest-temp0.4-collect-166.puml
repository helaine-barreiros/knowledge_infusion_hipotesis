@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR002: Deliver Personalized Recommendations Based on Profiles" as SFR002
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  
  Client --> CFR001 : View Financial Insights Dashboard
  SysAdmin -> SAFR001 : Manage Analysis Parameters
  Client -> (SFR002) : Request Personalized Recommendations
  SFR002 <|-- (AIFR002)
  
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "SAFR006: Deliver Spending Limit Alerts Based on Thresholds" as SAFR006
  
  Client -> CFR003 : View Financial Predictions
  SysAdmin -> (SFR005) <|-- (AIFR004)
  
  usecase "CFR007: View Investment Opportunities Suitable to Risk Profile" as CFR007
  usecase "SAFR016: Deliver Predictive Insights for Financial Guidance" as SAFR016
  
  Client -> CFR007 : View Investment Opportunities
  SysAdmin -> (SFR006) <|-- (AIFR003)
  
  usecase "CFR020: Manage User Feedback to Improve System Accuracy" as CFR020
  usecase "SAFR019: Maintain Historical Record of Insights for Trend Analysis" as SAFR019
  
  Client -> CFR020 : Send Feedback on Recommendations and Insights
  SysAdmin -> (SFR019) <|-- (AIFR008)
  
  usecase "CFR004: Receive Personalized Financial Strategy Optimization" as CFR004
  usecase "SAFR005: Deliver Spending Limit Alerts Based on Thresholds" as SAFR005
  
  Client -> CFR004 : Receive Optimized Strategies
  SysAdmin -> (SFR018) <|-- (AIFR009)
  
  usecase "CFR006: View Spending Limit Exceedance Alerts" as CFR006
  usecase "SAFR005: Deliver Spending Limit Alerts Based on Thresholds" as SAFR005
  
  Client -> CFR006 : View Alerts When Exceeding Limits
}
@enduml