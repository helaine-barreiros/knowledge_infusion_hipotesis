@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sa
actor FinancialAdvisor as fa
system SFR021 as sys

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidated Personalized Dashboard for Financial Monitoring" as CFR009
  usecase "CFR10: Manage Relationship with Advisors Including Data Sharing Permissions" as CFR10

}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
}

rectangle "System (SFR)" {
  usecase "SFR001: Deliver Alerts Through Notification Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts When Exceeding Thresholds" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Find Specific Investment Opportunities Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Detect Anomaly Transaction Alerts for Fraud Prevention" as SFR008
  usecase "SFR009: Extract Relevant News Contextualized to Users' Portfolios" as SFR009
  usecase "SFR010: Generate Client Dashboards Intuitively" as SFR010
  usecase "SFR012: Process User Feedback for System Improvement" as SFR012

}

rectangle "AI Component (AIFR)" {
  usecase "AIFR001: Generate Financial Predictions Based on Data and Trends" as AIFR001
  usecase "AIFR004: Identify Investment Opportunities Aligning with Risk Profiles" as AIFR004
}

rectangle "System (SFR)" <|-- Client : provides services to

Client --> CFR001 : View Financial Insights Dashboard
Client --> CFR002 : Receive Alerts for Anomalous Transactions
Client --> CFR003 : View Predictions Based on Data and Trends
Client --> CFR004 : Personalized Recommendations Aligned with Profile
Client --> CFR005 : Manage Preferences for Recs
Client --> CFR006 : Spending Limit Alerts Exceeding Thresholds
Client --> CFR007 : Investment Opportunities by Risk Profile
Client --> CFR008 : Access News Related to Portfolio
Client --> CFR009 : Consolidated Personalized Dashboard
Client --> CFR10: Manage Relationship with Advisors

SysAdmin --> SAFR001 : Manage Analysis Parameters for System

FinancialAdvisor --> FAFR001 : Manage Client Mentoring Sessions Based on Insights
FinancialAdvisor --> FAFR002 : View Intervention Alerts for Proactive Help
FinancialAdvisor --> FAFR003 : View Predictive Analytics About Clients' Fin Situations

SFR001 <|-- SysAdmin : Delivers alerts through channels
SFR002 <|-- Client : Personalized recommendations service
SFR003 <|-- AIFR001 : Requests financial predictions from AI
SFR004 <|-- AIFR001 : Requests personalized recs from AI
SFR005 <|-- AIFR006 : Alerts for spending limits exceeding thresholds

