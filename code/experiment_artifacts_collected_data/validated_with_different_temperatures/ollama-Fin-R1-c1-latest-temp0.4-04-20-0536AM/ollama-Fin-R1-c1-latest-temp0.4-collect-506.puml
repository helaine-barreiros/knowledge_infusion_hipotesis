@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as client
actor SysAdmin as sysadmin
actor FinancialAdvisor as advisor
system SFR012: "Client Dashboard Generation" 
system AIFR009: "Client Predictive Intervention Recommendations"
system AIFR007: "Contextualized News Insights"

rectangle "System Components" {
  usecase CFR001: View Financial Insights Dashboard as cfr001
  usecase CFR002: Receive Alerts for Anomalous Transactions as cfr002
  usecase CFR003: View Financial Predictions Based on Historical Data and Market Trends as cfr003
  usecase CFR004: Personalized Recommendations Aligned with Client's Profile as cfr004
  usecase CFR005: Manage Preferences for Personalized Recommendations as cfr005
  usecase CFR006: View Spending Limit Alerts When Exceeding Thresholds as cfr006
  usecase CFR007: View Investment Opportunities Based on Risk Profile as cfr007
  usecase CFR008: Access News Related to Portfolio as cfr008
  usecase CFR009: Consolidated Financial Information Dashboard as cfr009
  usecase CFR010: Manage Relationship with Advisors Including Data Sharing Permissions as cfr010

  usecase SAFR001: Manage Analysis Parameters for AI System as safr001
  usecase FAFR001: Manage Client Mentoring Sessions Based on Insights as fafr001
  usecase FAFR002: View Client Intervention Alerts When Patterns Require Attention as fafr002
  usecase FAFR003: View Predictive Analytics About Clients' Financial Situations as fafr003
  usecase FAFR004: Configure Analysis Parameters for Specific Segments as fafr004

  usecase SFR015: Request Intervention Analyses from AI Component to Identify When Advisors Should Engage with Clients as sfr015
}

client --> cfr001 : "View Financial Insights Dashboard"
sysadmin --> safr001 : "Manage Analysis Parameters for AI System"

advisor --> fafr002 : "View Client Intervention Alerts When Patterns Require Attention"
advisor --> fafr003 : "View Predictive Analytics About Clients' Financial Situations"
advisor --> aifr004 : "Generate Investment Opportunity Analyses Based on Risk Profiles"

sfr015 <|-- cfr009 : "Request Contextualized News Insights for Client Dashboards"
aifr007 <|-- sfr012 : "Provide Contextualized News to Enhance Dashboard Generation"
cfr003 --> aifr001 : "Request Financial Predictions from AI System"

@enduml