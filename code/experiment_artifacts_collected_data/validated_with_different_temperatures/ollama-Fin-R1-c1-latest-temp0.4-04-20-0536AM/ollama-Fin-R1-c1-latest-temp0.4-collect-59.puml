@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR004: Personalized Recommendations Based on Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidated Financial Dashboard for Monitoring" as CFR009
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010

  
  rectangle "Client Actors" {
    actor "User (Client)" as Client
    client --> CFR001 : View financial insights dashboard\nView spending limit alerts\nReceive personalized recommendations\nManage preferences for recommendations\nAccess consolidated dashboards\nView investment opportunities\nReceive news related to portfolio\nSend feedback
  
    client --> SAFR001 : Manage analysis parameters\nConfigure thresholds and limits\nAdjust system settings
  }
  
  rectangle "Financial Advisor Actors" {
    actor "User (Advisor)" as FinancialAdvisor
    financialadvisor --> FAFR003 : View predictive analytics for clients\nView client intervention alerts\nView contextualized news insights\nManage client mentoring sessions\nSend feedback
  
    financialadvisor --> SAFR001 : Manage analysis parameters\nConfigure thresholds and limits\nAdjust system settings
  }
  
  rectangle "System Administrator Actors" {
    actor "SysAdmin" as SystemAdministrator
    sysadmin --> SAFR001 : Manage analysis parameters for the AI system\nEnsure compliance with regulations like Basel III, GDPR, etc.\nManage user access controls
  
    sysadmin --> SFR002: Deliver personalized recommendations to users based on financial profiles\nDeliver alerts through appropriate channels\nProcess contextualized news
  }
  
}

@enduml