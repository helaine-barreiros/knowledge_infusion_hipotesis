@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Anomaly Detection Thresholds" as SAFR002
  usecase "FAFR005: Schedule Client Mentoring Sessions Based on AI Insights" as FAFR005
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "SFR014: Generate Client Analytics" as SFR014
  usecase "AIFR009: Generate Intervention Recommendations for Clients Based on AI Insights" as AIFR009

  // Relationships
  Client --> CFR001 : View financial data in a comprehensive format.
  SysAdmin -> SAFR002 : Configure system parameters like thresholds and regulations (Basel III, FATF).
  FinancialAdvisor --> FAFR005 : Schedule mentoring sessions based on AI-generated insights for clients.
  Client --> CFR003 : Access future financial trends and market forecasts.
  System --> SFR014 : Generate detailed client analytics using historical data and current trends.
  AIFR009 <|-- SFR014 : Use generated client predictions to create actionable recommendations.

}

@enduml