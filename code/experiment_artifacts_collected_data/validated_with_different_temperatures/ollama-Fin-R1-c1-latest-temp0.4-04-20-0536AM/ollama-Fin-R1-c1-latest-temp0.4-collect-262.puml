@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as C1
actor SysAdmin as SA
actor FinancialAdvisor as FA
system "System" as S

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: Access Financial Predictions" as CFR003
  usecase "CFR004: Get Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: Access Investment Opportunities" as CFR007
  usecase "CFR008: Receive Portfolio News" as CFR008
  usecase "CFR009: Use Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10

  C1 --> CFR001 : View financial data consolidated in a dashboard.
  C1 --> CFR002 : Receive alerts about unusual transactions for fraud detection.
  C1 --> CFR003 : Get future projections based on historical and market trends.
  C1 --> CFR004 : Personalized investment advice aligned with goals.
  C1 --> CFR005 : Adjust personalization settings in KYC profile.
  C1 --> CFR006 : Alerts when spending exceeds set limits by category.
  C1 --> CFR007 : Suitable investments based on risk tolerance (MiFID II).
  C1 --> CFR008 : Stay informed about market events affecting portfolio.
  C1 --> CFR009 : Single view for all financial info to monitor efficiently.
  C1 --> CFR10 : Share data with advisors and control permissions.

}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001

  SA --> SAFR001
}
  
rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Schedule Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: Review Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Segment" as FAFR004

  FA --> FAFR001 : Schedule sessions based on system-generated insights.
  FA --> FAFR002 : Monitor client alerts for proactive support.
  FA --> FAFR003 : Analyze predictive data to guide clients.
  FA --> FAFR004 : Customize analysis settings per client segment.

}

rectangle "System" {
  usecase "SFR001: Send Alerts via Notifications" as SFR001
  usecase "SFR002: Provide Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "SFR004: Generate Client-Specific Recs" as SFR004
  usecase "SFR005: Issue Spending Limit Alerts" as SFR005
  usecase "SFR006: Identify Investment Opportunities" as SFR006
  usecase "SFR007: Find ESG-Compliant Investments" as SFR007
  usecase "SFR008: Detect AML Risks" as SFR008
  usecase "SFR009: Extract News Relevance to Portfolios" as SFR009
  usecase "SFR010: Create Client Dashboards" as SFR010
  usecase "SFR011: Process Contextualized News" as SFR011
  usecase "SFR012: Generate Predictive Interventions" as SFR012
  usecase "SFR013: Track Financial Goals Progress" as SFR013
  usecase "SFR014: Maintain Historical Insights" as SFR014

  S --> CFR001 : Generate and present financial insights.
  S --> CFR002 : Trigger alerts for anomalous transactions.
  S --> CFR003 : Provide future projections via AI predictions.
  S --> CFR004 : Offer personalized recommendations to clients.
  S --> CFR005 : Adjust recommendation settings based on KYC data.
  S --> CFR006 : Alert when spending exceeds limits by category.
  S --> CFR007 : Recommend investments matching risk profiles (MiFID II).
  S --> CFR008 : Share portfolio news relevant to clients' holdings.
  S --> CFR009 : Consolidate financial info in a single view for monitoring.
  S --> CFR10 : Manage data sharing and permissions with advisors.

}

rectangle "AI System" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Create Personalized Recommendations" as AIFR002
  usecase "AIFR003: Issue Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities" as AIFR004
  usecase "AIFR005: Identify ESG-Compliant Investments" as AIFR005
  usecase "AIFR006: Detect Anomalous Transactions" as AIFR006
  usecase "AIFR007: Correlate News with Portfolios" as AIFR007
  usecase "AIFR008: Recommend Interventions Based on Predictions" as AIFR008
  usecase "AIFR009: Provide Forward-Looking Insights" as AIFR009

}

S --> SFR015 : Request predictive interventions for client engagement.
S --> SFR016 : Enhance value of financial guidance with insights.

FA --> FAFR004 : Configure analysis parameters per segment.

AIFR003 <|-- SFR005
AIFR002 <|-- SFR004

@enduml