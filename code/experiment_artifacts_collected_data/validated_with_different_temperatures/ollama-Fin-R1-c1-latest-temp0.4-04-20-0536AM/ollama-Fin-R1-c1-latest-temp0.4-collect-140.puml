@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage AML Alerts" as SAFR002
  usecase "CFR003: View Historical Data Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Monitor Spending Limits" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access Portfolio News" as CFR008
  usecase "CFR009: Consolidated Financial Dashboard" as CFR010
  usecase "SAFR003: Configure System Parameters" as SAFR003
  usecase "FAFR004: Customize Analysis for Segments" as FAFR004
  usecase "SFR002: Deliver Personalized Recommendations" as SFR016
  usecase "AIFR008: Generate Intervention Recommendations" as AIFR008

  actor Client as c1
  actor FinancialAdvisor as faa
  actor SystemAdmin as saa
  
  client --> CFR001 : View financial insights dashboard  
  client --> SAFR002 : Manage AML alerts  
  client --> CFR003 : View historical data predictions  
  client --> CFR004 : Receive personalized recommendations  
  client --> CFR005 : Manage recommendation preferences  
  client --> CFR006 : Monitor spending limits  
  client --> CFR007 : View investment opportunities  
  client --> CFR008 : Access portfolio news  
  client --> CFR010 : Consolidated financial dashboard  

  faa --> FAFR004 : Customize analysis for segments
  saa --> SAFR003 : Configure system parameters

  sys --> SFR002 : Deliver personalized recommendations
  sys --> AIFR008 : Generate intervention recommendations  
}
@enduml