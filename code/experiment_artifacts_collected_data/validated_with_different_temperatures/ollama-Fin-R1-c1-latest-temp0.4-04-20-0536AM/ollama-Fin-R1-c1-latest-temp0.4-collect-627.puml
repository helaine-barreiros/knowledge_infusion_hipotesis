@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage User Permissions and Data Sharing (Client)" as SAFR002
  usecase "SFR009: Generate Client Alerts Based on Predefined Conditions" as SFR009
  usecase "AIFR007: Generate Contextualized News Insights for Users" as AIFR007
  
  Client --> CFR001 : View financial data in a comprehensive format.
  
  SysAdmin -> SAFR002 : Manage user permissions and data sharing settings.

  Client --|> SFR009 : Receive alerts when spending exceeds thresholds or other conditions are met.
  Client --|> AIFR007 : Access contextualized news related to their investment portfolio.
}

rectangle "Financial Advisors" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  
  FinancialAdvisor --> FAFR001 : Schedule and manage mentoring sessions.
  
  SysAdmin -> SAFR004 : Configure analysis parameters specific to client segments or profiles.

}

rectangle "System Administrator" {
  usecase "SAFR003: Manage Analysis Parameters for AI System Compliance with Basel III" as SAFR003
  usecase "SFR018: Maintain Historical Record of User Insights" as SFR018
  
  SysAdmin --> SAFR003 : Adjust analysis parameters to ensure regulatory compliance.
  
}

rectangle "AI System (AIFR)" {
  usecase "AIFR002: Generate Personalized Recommendations Based on Financial Profiles" as AIFR002
  usecase "AIFR004: Identify Investment Opportunities Aligning with Risk Profiles" as AIFR004
  
  SysAdmin -> SAFR005 : Request spending limit alerts when user spending exceeds thresholds.
  
}

rectangle "Client Relationship Management (CRM)" {
  usecase "CFR010: Manage Relationship with Financial Advisors, Including Data Sharing Permissions" as CFR010
}
@enduml