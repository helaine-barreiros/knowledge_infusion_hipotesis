@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Alert Preferences" as SAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: Access Investment Opportunities" as CFR007
  usecase "CFR008: View Portfolio-Related News" as CFR008
  usecase "CFR009: Manage Dashboard Permissions" as CFR010
  usecase "SAFR003: Configure Analysis Parameters" as SAFR004
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR008: Request Investment Opportunity Analysis" as SFR006
  usecase "AIFR001: Generate Financial Predictions" as AIFR001

  client --> CFR001 : "View financial insights dashboard"
  sysAdmin --> SAFR002 : "Manage analysis parameters for alerts"
  
  client --> CFR003 : "View financial predictions based on historical data and market trends"
  client --> CFR004 : "Receive personalized recommendations aligned with financial profile"

  client --> CFR005 : "Manage recommendation preferences to ensure relevance"
  sysAdmin --> SAFR002 <|-- (CFR005) : "Adjust parameters for user-specific recommendations"

  client --> CFR006 : "View spending limit alerts when exceeding thresholds in expense categories"
  
  client --> CFR007 : "Access investment opportunities suitable to risk profile"
  sysAdmin --> SAFR004 <|-- (CFR007) : "Set criteria for personalized investments"

  client --> CFR008 : "View portfolio-related news from trusted sources"
  
  client --> CFR010 : "Manage dashboard permissions and sharing settings with advisors"
  advisor --> FAFR002 : "Receive alerts about clients needing professional attention"

  sysAdmin --> SAFR003 <|-- (CFR010) : "Adjust system-wide dashboards for user access control"

  client --> SFR006 : "Request investment opportunity analysis from the system"
  
  advisor --> FAFR002 : "View intervention alerts to proactively assist clients with financial issues"
  
  sysAdmin --> SAFR004 <|-- (FAFR001) : "Set up AI for generating predictions"

  client --> AIFR001 : "Receive generated financial predictions from the system"
}

@enduml