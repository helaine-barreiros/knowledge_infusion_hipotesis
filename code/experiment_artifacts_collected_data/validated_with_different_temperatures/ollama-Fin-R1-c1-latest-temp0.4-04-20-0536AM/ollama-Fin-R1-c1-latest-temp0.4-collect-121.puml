@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Analysis Parameters via UI" as SAFR002
  usecase "FAFR005: Schedule Client Mentoring Sessions" as FAFR005
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  
  Client --> CFR001 : View Financial Insights Dashboard\n(Client)
  
  SysAdmin -->
    SAFR002 <|-- (CFR004) : Manage Analysis Parameters for Recommendations\n(SysAdmin)\n(Manage Personalized Recs Preferences via UI)
    
  FAFR005 <|-- (Client, Advisor) : Schedule Client Mentoring Sessions Based on System-Generated Insights\n(Financial Advisor)\n(Client)\n(System Admin)
  
  SFR013 -->
    CFR002: Send Alerts for Anomalous Transactions\n(CSR008)\n(SysAdmin)\n(Generate Spending Limit Alerts When Exceeding Thresholds)
}

@enduml