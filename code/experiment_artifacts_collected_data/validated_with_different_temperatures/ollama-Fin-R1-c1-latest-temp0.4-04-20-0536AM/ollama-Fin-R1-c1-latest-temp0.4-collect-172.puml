@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage User Preferences and Alerts" as SAFR002
  usecase "SFR009: Generate Contextualized News for Portfolio" as SFR009
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007

  Client --> CFR001 : View Financial Dashboard  
  Client --> SAFR002 : Manage Alerts and Preferences  
  Client --> SFR009 : Receive Portfolio-related News  
  SystemAdmin --> SAFR002 : Configure Analysis Parameters  

  rectangle "Client" {
    actor "User (Client)" as User
    usecase "CFR001: View Financial Insights Dashboard"
    usecase "CFR003: View Financial Predictions"
    usecase "CFR004: Receive Personalized Recommendations"
    usecase "CFR005: Manage Recommendation Preferences"
    usecase "CFR006: View Spending Limit Alerts"
    usecase "CFR011: Send Feedback"

  }

  rectangle "Financial Advisor" {
    actor "FAFR002: Financial Advisor" as FA
    usecase "FAFR003: View Client Intervention Alerts"
    usecase "FAFR004: Configure Analysis Parameters for Segments"
  }

  rectangle "System Administrator" {
    actor "SysAdmin" as SA
    usecase "SAFR001: Manage Analysis Parameters"
  }

  rectangle "AI System" {
    component "AIFR002: Generate Personalized Recommendations" as AIPR
    component "AIFR003: Generate Spending Limit Alerts" as AISLA
    component "AIFR004: Analyze Investment Opportunities" as AIIO
    component "AIFR005: Identify ESG-aligned Investments" as AIEGSI
    component "AIFR006: Detect Anomaly Transactions" as AIAT

  }

  rectangle "Notification System" {
    usecase "SFR013: Generate Client Alerts"
  }
  
  User --> CFR002 : View Alerts 
  FA --> FAFR004
  SA --> SAFR001
  AIPR <|-- AIIO
  AISLA <|-- SFR005
  AIIO <|-- AIEGSI
  AIAT <|-- SFR008

}

@enduml