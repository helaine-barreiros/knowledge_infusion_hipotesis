@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Manage Relationship with Advisors" as CFR009

  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Generate Client Analytics" as SFR014

  actor "Client" as client
  actor "Financial Advisor (FA)" as fa
  actor "System Administrator (SA)" as sa
}

client --> CFR001 : View Financial Insights Dashboard  
sa --> SAFR001 : Manage Analysis Parameters  

fa --> FAFR002 : View Client Intervention Alerts  
fa --> SFR013 : Generate Client Alerts Based on Predefined Conditions

client --> CFR004 : Receive Personalized Recommendations
client --> CFR005 : Manage Recommendation Preferences
client --> CFR006 : View Spending Limit Alerts
client --> CFR007 : View Investment Opportunities
client --> CFR008 : Access News Related to Portfolio  
client --> CFR009 : Manage Relationship with Advisors  

Client <|-- (CFR001, CFR003-CFR009)
SA <|-- SAFR001

fa <|-- FAFR002 - FAFR004
fa <|-- SFR013

SFR012 --> client : Generate Client Dashboards  
SFR013 --> client : Send Alerts  

@enduml