@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Notification Preferences" as SAFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "SFR004: Request Personalized Recommendations" as SFR004
  usecase "SFR019: Maintain Historical Record of Insights" as SFR019

  Client --> CFR001 : View financial data in a consolidated dashboard.
  
  SysAdmin -> SAFR002 : Manage system parameters and ensure compliance with regulations.

  rectangle "Client Subsystem" {
    actor User as U
    usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
    usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010

    SysAdmin -> SAFR006 : Configure spending limit thresholds.
    
    User --> CFR005 : Adjust personalized recommendation preferences.
  }

  rectangle "Financial Advisor Subsystem" {
    actor FAFR as FA
    usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003

    SysAdmin -> SAFR014 : Generate client analytics reports.

    User --> CFR010 : Manage relationship with financial advisors.
  }

  rectangle "System Subsystem" {
    actor System as S
    usecase "SFR005: Request Spending Limit Alerts" as SFR005

    SysAdmin -> SAFR020 : Manage user feedback.

    FAFR --> FAFR014 : View client predictive insights.
  }

  rectangle "AI Subsystem" {
    actor AI as A
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008

    SysAdmin -> SAFR020 : Manage user feedback.

    FAFR --> FAFR014 : View client predictive insights.
  }

}

@enduml