@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003

  Client --> CFR001 : "View Financial Insights"
  
  SysAdmin --> SAFR001 : "Manage System Settings"

  rectangle "Client" {
    actor User as U
    usercase "CFR002: View Alerts About Anomalous Transactions" as CFR002
    usecase "CFR003: View Financial Predictions" as CFR003
    usecase "CFR004: Receive Personalized Recommendations" as CFR004
    usecase "CFR005: Manage Recommendation Preferences" as CFR005
    usecase "CFR006: View Spending Limit Alerts" as CFR006
    usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
    usecase "CFR008: Access News Related to Portfolio" as CFR008
    usecase "CFR009: Manage Personalized Dashboards" as CFR009
    usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10

  }

  rectangle "Financial Advisor (FA)" {
    actor FAF as FA
    usercase "FAFR002: View Client Intervention Alerts" as FAFR002
    usercase "FAFR003: View Predictive Analytics for Clients" as FAFR003
    usecase "FAFR004: Configure Analysis Parameters by Segment" as FAFR004

  }

  rectangle "System Administrator (SA)" {
    actor SysAdmin as SA
    usercase "CFR011: Send Feedback to System Improvements" as CFR011
    usecase "SFR020: Manage User Feedback for Insights Improvement" as SFR020

  }

}

@enduml