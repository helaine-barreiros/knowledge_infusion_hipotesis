@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor FinancialAdvisor as faa
actor SysAdmin as sa
system "System" as sys

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with Financial Profile and Goals" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds in Specific Expense Categories" as CFR006
  usecase "CFR007: View Investment Opportunities Suitable to Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Investment Portfolio" as CFR008
  usecase "CFR009: Manage Relationship with Financial Advisors Including Data Sharing Permissions" as CFR009

  c1 --> CFR001 : "View Dashboard"
  c1 --> CFR002 : "Receive Alerts"
  c1 --> CFR003 : "View Predictions"
  c1 --> CFR004 : "Receive Recommendations"
  c1 --> CFR005 : "Manage Preferences"
  c1 --> CFR006 : "View Spending Limit Alerts"
  c1 --> CFR007 : "View Investment Opportunities"
  c1 --> CFR008 : "Access News"
  c1 --> CFR009 : "Manage Relationship"

}

rectangle "System Administrator Interface" {
  usecase "SAFR001: Manage Analysis Parameters for AI System Compliance with Financial Regulations (Basel III)" as SAFR001

  sa --> SAFR001 : "Manage Parameters"
}

rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments to Customize System Behavior According to Regulatory Requirements (GDPR, CCPA)" as FAFR004

  faa --> FAFR001 : "Manage Mentoring"
  faa --> FAFR002 : "View Alerts"
  faa --> FAFR003 : "View Analytics"
  faa --> FAFR004 : "Configure Parameters"

}

rectangle "System Functionalities" {
  usecase "SFR001: Deliver Alerts to Users Through Notification Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Financial Profiles" as SFR002
  usecase "SFR003: Request AI Predictions for Financial Insights" as SFR003
  usecase "SFR004: Request AI-Generated Recommendations from Client Data and Preferences" as SFR004
  usecase "SFR005: Trigger Spending Limit Alerts When Exceeding Thresholds" as SFR005
  usecase "SFR006: Identify Investment Opportunities Based on Risk Profiles" as SFR006
  usecase "SFR007: Find Specific Investments Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Detect Anomalous Transactions for Fraud Prevention (AML)" as SFR008
  usecase "SFR009: Extract Relevant News Contextualized to Portfolio" as SFR009
  usecase "SFR010: Generate Client Dashboards with Financial Information" as SFR010
  usecase "SFR013: Manage Predefined Conditions for Alerts" as SFR013
  usecase "SFR020: Track User Feedback to Improve System Accuracy and Relevance" as SFR020

}

rectangle "AI Component Functionalities" {
  usecase "AIFR001: Generate Financial Predictions Based on Historical Data, Market Trends, Economic Indicators" as AIFR001
  usecase "AIFR003: Identify Unusual Spending Patterns to Trigger Alerts" as AIFR003
  usecase "AIFR004: Evaluate Investments Against Risk Profiles and Financial Goals" as AIFR004
  usecase "AIFR005: Align Investment Opportunities with Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Detect Potentially Fraudulent Transactions in Compliance With FinCEN" as AIFR006
  usecase "AIFR007: Correlate Financial News to User Portfolios for Relevant Insights" as AIFR007
  usecase "AIFR008: Identify Patterns Requiring Advisor Engagement (Predictive Interventions)" as AIFR008

}

