@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  usecase "AIFR002: Generate Personalized Recommendations Based on Profiles and Goals" as AIFR002
  usecase "CFR011: Send Feedback to Improve System Outputs" as CFR011

  
  actor Client as client {
    --> CFR001 : View Financial Insights Dashboard
    --> CFR004 : Receive Personalized Recommendations
    --> CFR005 : Manage Recommendation Preferences
    --> SFR013 : Generate Client Alerts Based on Predefined Conditions
    --> AIFR002: Generate Personalized Recommendations Based on Profiles and Goals
  }
  
  actor FinancialAdvisor as advisor {
    --> FAFR002: View Client Intervention Alerts
    --> FAFR003: View Predictive Analytics for Clients
    --> CFR011: Send Feedback to Improve System Outputs
  }

  actor SystemAdministrator as admin {
    --> SAFR001: Manage Analysis Parameters
    --> FAFR004: Configure Analysis Parameters for Specific Segments
  }
  
}

@enduml