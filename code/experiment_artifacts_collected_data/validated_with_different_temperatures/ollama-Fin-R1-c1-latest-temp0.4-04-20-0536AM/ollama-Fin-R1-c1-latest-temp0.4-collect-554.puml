@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR019: Manage Users' Financial Goals" as SFR019

  client --> CFR001 : View financial data and insights
  SysAdmin --> SAFR001 : Configure analysis parameters for the system
  Client --> FAFR002 : Receive alerts about potential fraud or unusual spending patterns
  System --> SFR003 : Request AI-generated predictions
  System --> SFR004 : Request personalized recommendations from the AI component
  Advisor --> FAFR001: Manage client mentoring sessions based on system insights
  Advisor --> FAFR002: View alerts for proactive assistance with clients
  Client --> CFR006: Monitor spending limits through alerts
  System --> SFR005 : Request spending limit alerts when thresholds are exceeded
}

@enduml