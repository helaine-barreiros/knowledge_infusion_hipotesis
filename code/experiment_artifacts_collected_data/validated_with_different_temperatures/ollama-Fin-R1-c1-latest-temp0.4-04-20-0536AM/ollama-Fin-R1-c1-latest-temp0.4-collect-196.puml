@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Fraud Alerts Thresholds" as SAFR002
  usecase "CFR003: View Historical Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "SAFR003: Customize Analysis Parameters by Client Segment" as SAFR003
  usecase "CFR007: View Investment Opportunities Suitability" as CFR007
  usecase "CFR008: Access Consolidated Financial Dashboard" as CFR008
  usecase "CFR010: Manage Data Sharing with Advisors" as CFR010

  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: Review Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Regulatory Standards" as FAFR004

  usecase "SFR019: Maintain Historical Record of Insights" as SFR019
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
}

actor Client as C
actor SystemAdmin as SA
actor FinancialAdvisor as FA

C --> CFR001 : View financial insights dashboard  
SA --> SAFR002 : Manage fraud alerts thresholds  
C --> CFR003 : View historical predictions  
C --> CFR004 : Receive personalized recommendations  
C --> CFR005 : Manage recommendation preferences  
C --> CFR006 : View spending limit alerts  
FA --> FAFR002 : View client intervention alerts  
FA --> FAFR003 : Review predictive analytics for clients  
SA --> SAFR001 : Manage analysis parameters (system admin)  
FAFR004 <|-- SA : Configure analysis params by regulatory standards  

rectangle "System" {
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions" as SFR003  
  usecase "SFR004: Request Personalized Recommendations" as SFR004  
  usecase "SFR005: Request Spending Limit Alerts" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities" as SFR007  
  usecase "SFR008: Request Anomaly Transaction Alerts" as SFR008
  usecase "SFR013: Generate Client Alerts Based on Conditions" as SFR013 
  usecase "AIFR002 <|-- AIFR004 : AI generates personalized recommendations based on user profiles"
  
  C --> SFR002 : Receive personalized recommendations
  C --> SFR005 : Get spending limit alerts
  FA --> FAFR001 : Financial advisor receives system-generated insights (FA uses the system)
}

rectangle "AI System" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001  
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analysis" as AIFR004  
  usecase "AIFR005: Identify Suitable Investments" as AIFR005
  usecase "AIFR006: Detect Anomaly Transactions" as AIFR006 
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007  
  usecase "AIFR008: Predict Client Interventions Needed" as AIFR008
}

FA --> FAFR001 : Financial advisor receives system-generated insights (AI generates predictions)
C --> CFR009 : View consolidated dashboard

@enduml