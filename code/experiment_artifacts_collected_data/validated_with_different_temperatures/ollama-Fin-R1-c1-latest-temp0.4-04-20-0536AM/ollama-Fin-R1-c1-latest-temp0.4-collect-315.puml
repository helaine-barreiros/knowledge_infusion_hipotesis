@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "SFR008: Request AML-Compliant Transaction Alerts" as SFR008
  usecase "AIFR006: Generate Investment Opportunity Analysis Based on Risk Profile" as AIFR006
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  usecase "CFR005: Manage Personalized Recommendations Preferences" as CFR005
  usecase "SFR007: Request Investment Opportunities Matching Risk Profiles and ESG Criteria" as SFR007
  usecase "AIFR001: Generate Financial Predictions from Historical Data and Market Trends" as AIFR001
  usecase "CFR006: View Spending Limit Alerts Based on Thresholds" as CFR006
  usecase "SFR009: Find Contextualized News Relevant to Portfolio" as SFR009
  usecase "AIFR007: Generate Contextualized News Insights for Portfolios" as AIFR007
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "AIFR008: Generate Predictive Intervention Recommendations for Advisors" as AIFR008
  usecase "CFR004: Receive Personalized Financial Recommendations" as CFR004
  usecase "SFR015: Request Predictive Interventions from AI Component" as SFR015
  usecase "AIFR009: Generate Client Predictive Insights for Forward-Looking Analysis" as AIFR009
  usecase "CFR007: View Investment Opportunities Suitable to Risk Profile" as CFR007
  usecase "SFR018: Manage Users' Financial Goals and Track Progress" as SFR018
  usecase "AIFR005: Generate Investment Opportunities Based on Modern Portfolio Theory" as AIFR005
}

actor "Client" as Client
actor "System Administrator" as SysAdmin
actor "Financial Advisor" as FAdvisors

Client --> CFR001 : View financial insights dashboard
SysAdmin --> SAFR001 : Manage analysis parameters
FAdvisors --> FAFR003 : View predictive analytics for clients
Client --> CFR002 : Receive alerts on anomalous transactions
Client --> SFR008 : Request AML-compliant transaction alerts (via system)
AIFR006 --> Client : Generate investment opportunity analysis based on risk profile
Client --> CFR003 : View financial predictions
SFR012 --> Client : Generate client dashboards
FAFR004 --> FAFR003 : Configure parameters for specific segments
Client --> CFR005 : Manage personalized recommendation preferences
AIFR007 --> SFR009 : Find contextualized news relevant to portfolio (via system)
SFR018 --> Client : Manage financial goals and track progress

SysAdmin <|-- SAFR001 : System admin can manage analysis parameters
Client <|-- CFR002, CFR003, CFR005 ...: Multiple use cases for client interaction
FAdvisors <|-- FAFR004, FAFR008 ...: Financial advisor uses specific features

@enduml