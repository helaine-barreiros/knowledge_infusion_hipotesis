@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User: as User
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR004: Personalized Recommendations Based on Profile" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "AIFR006: Generate Investment Opportunity Analyses for Users" as AIFR006

  User --> CFR001 : "View Financial Insights Dashboard"
  SysAdmin --> SAFR001 : "Manage Analysis Parameters"
  FAFR002 --> FAFR003 : "View Client Intervention Alerts -> View Predictive Analytics for Clients"
  User --> CFR002 : "Receive Alerts on Anomalous Transactions"
  User --> CFR004 : "Personalized Recommendations Based on Profile"
  User --> CFR005 : "Manage Recommendation Preferences"
  Sys --> SFR013 : "Generate Client Alerts Based on Predefined Conditions (System)"
  AIFR002 --> AIFR006 : "Generate Personalized Recommendations -> Generate Investment Opportunity Analyses for Users"

}
@enduml