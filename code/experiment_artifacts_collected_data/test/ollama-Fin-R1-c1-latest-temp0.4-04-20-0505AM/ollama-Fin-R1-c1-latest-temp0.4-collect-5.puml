@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage User Preferences" as SAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Customize Recommendation Preferences" as CFR005
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI" as SFR003
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  usecase "CFR009: View Personalized Dashboard" as CFR009
  usecase "SFR008: Request Anomaly Transaction Alerts from AI" as SFR008
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  usecase "CFR010: Manage Relationship with Advisors" as CFR010
}

actor Client as c
actor SystemAdmin as saa
actor FinancialAdvisor as fa

c --> CFR001 : View financial insights dashboard
c --> SAFR002 : Customize recommendation preferences (via system)
saa --> SAFR001 : Manage analysis parameters for compliance
fa --> FAFR002 : Monitor client alerts and intervene proactively
c --> AIFR003 : Receive spending limit alerts when thresholds are exceeded

// System-to-UseCase relationships
SFR003 -> AIFR001 : Request financial predictions from AI
AIFR001 --(CFR003) : Provide financial predictions to user
SFR005 -> AIFR003 : Request spending limit alerts from AI
AIFR003 --(CFR006) : Notify client of exceeding thresholds
SFR006 -> AIFR004 : Request investment opportunity analysis
AIFR004 --(CFR007) : Present suitable investments to user
SFR012 -> AIFR007 : Generate contextualized news insights for clients
AIFR007 --(CFR008) : Provide relevant financial news updates

// Client-to-System interactions (via SFR components)
c --> SFR003 : Request financial predictions from system
SFR003 -- AIFR001 : Process and generate predictions
AIFR001 --(CFR003) : Deliver to client via dashboard

// System-to-User feedback loop (via CFR components)
c --> SFR008 : Request anomaly transaction alerts from system
SFR008 -- AIFR006 : Process and generate alerts
AIFR006 --(CFR007) : Notify client of potential fraud

// Financial Advisor-to-System interactions (via FAFR components)
fa --> FAFR002 : View client intervention alerts generated by system
FAFR002 -- SFR013 : Manage and respond to alerts as needed

@enduml