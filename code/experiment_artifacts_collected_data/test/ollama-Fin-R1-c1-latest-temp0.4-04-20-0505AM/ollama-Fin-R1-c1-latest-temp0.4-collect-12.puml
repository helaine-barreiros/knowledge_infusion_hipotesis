@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sas
actor FinancialAdvisor as faa
actor AIFRSystem as aifrs

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile (MiFID II)" as CFR007
  usecase "CFR008: Receive News Related to Portfolio Management" as CFR008
  usecase "CFR009: View Consolidated Financial Dashboard for Efficiency" as CFR009
  usecase "CFR10: Manage Relationship with Advisors, Including Data Sharing Permissions" as CFR10

  c1 --> CFR001 : "View"
}

rectangle "FinancialAdvisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Clients" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004

  faa --> FAFR001 : "Manage"
}

rectangle "SysAdmin" {
  usecase "SAFR001: Manage AI System's Analysis Parameters for Compliance and Accuracy" as SAFR001
  sas --> SAFR001 : "Manage"

}

rectangle "AIFRSystem" {
  usecase "AIFR001: Generate Financial Predictions Using Historical Data, Market Trends" as AIFR001
  usecase "AIFR002: Create Personalized Recommendations Based on User Profiles and Goals" as AIFR002
  usecase "AIFR003: Issue Spending Limit Alerts for Exceeding Thresholds in Expense Categories" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities Against Risk Profiles" as AIFR004
  usecase "AIFR005: Identify Financial Instruments Aligning with User Strategies and Portfolio Theory" as AIFR005
  usecase "AIFR006: Detect Anomalous Transactions Using Pattern Recognition for Fraud Detection (AML)" as AIFR006
  usecase "AIFR007: Correlate Financial News With Portfolios to Extract Relevant Insights" as AIFR007
  usecase "AIFR008: Recommend Interventions When Patterns Indicate Need for Advisor Engagement (Regulatory Compliance)" as AIFR008
  usecase "AIFR009: Provide Forward-Looking Predictive Analysis to Enhance Financial Guidance" as AIFR009

}

rectangle "System" {
  usecase "SFR001: Deliver Alerts Through Appropriate Channels (Client)" as SFR001
  usecase "SFR002: Generate Personalized Recommendations for Users Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AI Component (Client)" as SFR004
  usecase "SFR005: Request Spending Limit Alerts When Exceeding Thresholds in Expense Categories (AI)" as SFR005
  usecase "SFR006: Analyze Investment Opportunities Based on Risk Profiles and Criteria" as SFR006
  usecase "SFR007: Identify Specific Investment Opportunities Matching User's ESG Preferences" as SFR007
  usecase "SFR008: Detect Anomalous Transactions in Compliance With AML Regulations (AI)" as SFR008
  usecase "SFR009: Extract Relevant News for Users' Portfolios From Trusted Sources" as SFR009
  usecase "SFR010: Process Contextualized News To Identify Impacts on Investments" as SFR010
  usecase "SFR012: Generate Client Dashboards For Intuitive Presentation of Financial Data" as SFR013
  usecase "SFR014: Provide Meaningful Insights Into Financial Behavior and Performance (Client)" as SFR015
  usecase "SFR016: Enhance Value Of Financial Guidance Through Predictive Analysis (Advisor)" as SFR017
  usecase "SFR020: Manage User Feedback To Improve System Accuracy" as SFR020

}

aifrs <|-- AIFRSystem : "Implements"

c1 --> CFR003 : "View Financial Prediction"
c1 --> CFR004 : "Receive Personalized Recommendations"
c1 --> CFR005 : "Manage Preferences for Recs."
c1 --> CFR006 : "View Spending Limit Alerts"
c1 --> CFR007 : "Access Investment Opportunities Based on Risk Profile (MiFID II)"
c1 --> CFR008 : "Receive News Related to Portfolio Management"

faa --> FAFR002 : "View Intervention Alert"
faa --> FAFR003 : "View Predictive Analytics for Clients"
faa --> AIFRSystem <|-- faa : "Uses AI Components"

sas --> SAFR001 : "Manage Analysis Parameters"

c1 -- SFR004 : "Request Personalized Recommendations (Client)"
SFR020 --> c1 : "Collect Feedback"

@enduml