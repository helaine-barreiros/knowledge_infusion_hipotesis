@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as C
actor SysAdmin as SA
actor FinancialAdvisor as FA
system S

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as VFD
  usecase "SAFR001: Manage Analysis Parameters" as MAP
  usecase "SFR002: Deliver Personalized Recommendations" as DPR
  usecase "AIFR003: Generate Spending Limit Alerts" as GLA
  usecase "AIFR004: Analyze Investment Opportunities" as AIO
  usecase "CFR011: Send Feedback" as SF

  C --> VFD : View Financial Insights Dashboard
  SA --> MAP : Manage Analysis Parameters
  FA --> FAFR002 : Manage Client Intervention Alerts
  S --> DPR : Deliver Personalized Recommendations
  S --> GLA : Generate Spending Limit Alerts
  S --> AIO : Analyze Investment Opportunities
  C --> SF : Send Feedback

  package "Client" {
    usecase "CFR001: View Financial Insights Dashboard"
    usecase "CFR002: Receive Anomaly Alerts"
    usecase "CFR003: View Predictions"
    usecase "CFR004: Get Personalized Recommendations"
    usecase "CFR005: Manage Preferences"
    usecase "CFR006: Monitor Spending Limits"
    usecase "CFR007: Access Investment Opportunities"
    usecase "CFR008: View News"
    usecase "CFR009: Consolidate Financial Dashboard"
  }

  package "System" {
    usecase "SFR002: Deliver Personalized Recommendations"
    usecase "SFR003: Request Predictions from AI"
    usecase "SFR004: Request Recommendations from AI"
    usecase "SFR005: Request Spending Limit Alerts"
    usecase "AIFR001: Generate Financial Predictions"
  }

  package "FinancialAdvisor" {
    usecase "FAFR002: Manage Client Intervention Alerts"
    usecase "FAFR003: View Predictive Analytics"
    usecase "SFR009: Request Contextualized News"
  }
}

@enduml