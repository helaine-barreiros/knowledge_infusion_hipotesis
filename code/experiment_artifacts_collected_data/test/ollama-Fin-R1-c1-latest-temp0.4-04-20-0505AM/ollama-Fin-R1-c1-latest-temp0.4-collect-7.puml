  usecase "AIFR007: Correlate News With Portfolios to Identify Relevant Impacts" as AIFR007
  usecase "AIFR008: Recommend Timing for Advisor Engagement Based on Client Patterns" as AIFR008

  actor "Client" as C1 extends CFR001, CFR002, CFR003, CFR004, CFR005, CFR006, CFR007, CFR008, CFR009, CFR010
  actor "Financial Advisor (FA)" as FA1 extends FAFR001, FAFR002, FAFR003, FAFR004
  actor "System Administrator" as SA1 extends SAFR001

  C1 --> CFR001 : View Financial Insights Dashboard
  C1 --> CFR002 : Receive Alerts on Anomalous Transactions
  C1 --> CFR003 : View Financial Predictions Based on Historical Data and Trends
  C1 --> CFR004 : Personalized Recommendations Aligned with Financial Profile
  C1 --> CFR005 : Manage Preferences for Personalized Recommendations
  C1 --> CFR006 : View Spending Limit Alerts When Exceeding Predefined Thresholds
  C1 --> CFR007 : View Investment Opportunities Based on Risk Profile
