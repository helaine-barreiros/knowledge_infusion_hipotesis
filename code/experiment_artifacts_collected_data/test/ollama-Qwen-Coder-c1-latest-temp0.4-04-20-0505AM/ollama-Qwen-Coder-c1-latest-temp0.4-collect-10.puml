@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomaly Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10

  Client --> (SFR012) : Generate client dashboards
  Client --> (SFR013) : Generate client alerts based on predefined conditions
  Client --> (SFR014) : Generate client analytics that provide meaningful insights into financial behavior and performance
  Client --> (SFR015) : Request predictive intervention analyses from the AI component to identify when financial advisors should engage with clients
  Client --> (SFR016) : Request predictive insights from the AI component to enhance the value of financial guidance provided to clients

  SysAdmin --> (SAFR001) : Manage analysis parameters for the AI system
  
  FAFD --> (FAFR001) : Manage client mentoring sessions based on system-generated insights
  FAFD --> (FAFR002) : View client intervention alerts when the system detects patterns requiring professional attention to proactively assist clients with potential financial issues
  FAFD --> (FAFR003) : View predictive analytics about my clients' financial situations to provide data-driven recommendations during consultations
  FAFD --> (FAFR004) : Configure analysis parameters for specific client segments to customize the system's behavior according to different client profiles and regulatory requirements such as GDPR or CCPA

}

rectangle "Notifications" {
  usecase "SFR001: Deliver Alerts" as SFR001
  Client --> (SFR001) : Receive alerts through appropriate notification channels
}

rectangle "Recommendations" {
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  Client --> (SFR002)
}

rectangle "Predictions and Insights" {
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  Client --> (SFR003)
  Client --> (SFR004)

}

rectangle "Spending Limit Alerts" {
  usecase "SFR005: Request Spending Limit Alerts" as SFR005
  Client --> (SFR005)
}

rectangle "Investment Opportunities" {
  usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Matching User Criteria and ESG Preferences" as SFR007
  Client --> (SFR006)
  Client --> (SFR007)

}

rectangle "News Related to Portfolio" {
  usecase "SFR008: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR008
  usecase "SFR010: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR010
  Client --> (SFR008)
  Client --> (SFR010)

}

rectangle "Client Predictive Interventions and Insights" {
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations by Identifying Patterns Indicating Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR009
  FAFD --> (AIFR008)
  FAFD --> (AIFR009)

}

rectangle "Feedback Management" {
  usecase "CFR11: Send Feedback About System's Recommendations and Insights" as CFR11

  Client --> (SFR020) : Manage user feedback to continuously improve the quality and relevance of financial insights
}
@enduml