@startuml

left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User (Client): as User
:System Admin: as SysAdmin
:Financial Advisor: as FAFR001

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions" as SFR003
  usecase "AIFR009: Generate Contextualized News Insights" as AIFR009
  
  User --> CFR001 : "View"
  User --> FAFR002 : "Receive Alerts"
  
  SysAdmin --> SAFR001 : "Manage Parameters"
  
  Financial Advisor --> FAFR003 : "Configure Analysis Parameters"
  Financial Advisor --> AIFR004 : "Generate Recommendations"
}

rectangle "Client" {
  usecase "CFR002: View Alerts for Anomalous Transactions" as CFR002
  usecase "SAFR005: Manage Personalized Recommendation Preferences" as SAFR005
  
  User --> CFR002 : "Receive Alerts"
  User --> SAFR005 : "Manage Recommendations"
}

rectangle "Financial Advisor Functions" {
  usecase "FAFR01: Manage Client Mentoring Sessions" as FAFR01
  usecase "SFR004: Request Personalized Recommendations" as SFR004
  
  Financial Advisor --> FAFR01 : "Manage Sessions"
}

rectangle "System Functions" {
  usecase "AIFR02: Generate Personalized Recommendations" as AIFR02
  usecase "SFR005: Request Spending Limit Alerts" as SFR005
  
  System Admin --> SAFR001 : "Manage Parameters"
  
  Financial Advisor --> FAFR03 : "View Intervention Alerts"
}

rectangle "Investment Functions" {
  usecase "FAFR07: View Investment Opportunities Suitable to Risk Profile" as FAFR07
  usecase "AIFR05: Generate Investment Opportunity Analyses" as AIFR05
  
  Financial Advisor --> FAFR07 : "View Opportunities"
}

rectangle "News Functions" {
  usecase "CFR008: View News Related to Investment Portfolio" as CFR008
  usecase "AIFR03: Generate Contextualized News Insights" as AIFR03
  
  User --> CFR008 : "View"
}

rectangle "Client Relationship Functions" {
  usecase "CFR10: Manage Client-Advisor Relationships" as CFR10
  usecase "SFR20: Process User Feedback for Improvement" as SFR20
  
  User --> CFR10 : "Manage Relationship"
}

User --> AIFR01 : "Send Feedback"

@enduml