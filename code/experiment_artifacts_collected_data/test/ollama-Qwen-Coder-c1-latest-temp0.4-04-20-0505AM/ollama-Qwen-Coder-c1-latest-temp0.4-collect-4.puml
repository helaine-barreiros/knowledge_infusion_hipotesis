@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR004: Receive Personalized Recommendations" as SAFR005
  usecase "CFR006: Manage Recommendation Preferences" as SAFR010
  
  CFR001 --> (SAFR002)
  CFR001 --> (SAFR003)
  CFR001 --> (SAFR004)
  CFR001 --> (SAFR005)
  CFR001 --> (SAFR010)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
  
  usecase "FAFR003: View Predictive Analytics about Client Situations" as SAFR007
  usecase "FAFR004: Configure Analysis Parameters for Specific Clients" as SAFR015

  FinancialAdvisor --> (SAFR006)
  FinancialAdvisor --> (FAFR002)
  FinancialAdvisor --> (SAFR003)
  FinancialAdvisor --> (SAFR007)
  FinancialAdvisor --> (SAFR014)
}

package "System" {
  actor System as SFR009
  
  usecase "SFR008: Request Personalized Recommendations from AI Component" as AIFR002
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SAFR013
  usecase "SFR017: Generate Financial Health Reports" as SAFR024
  
  System --> (AIFR002)
  System --> (SAFR013)
  System --> (SAFR018)
  System --> (SAFR019)
  System --> (SAFR020)
}

package "AI Component" {
  actor AI as AIFR001
  
  usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as SAFR006
  usecase "AIFR005: Generate Spending Limit Alerts for Users" as SAFR008
  usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as SAFR016
  
  AI --> (SAFR004)
  AI --> (SAFR005)
  AI --> (SAFR008)
  AI --> (AIFR007)
}

package "System Administrator" {
  actor SystemAdmin as SAFR009

  usecase "SAFR012: Generate Client Dashboards that Present Financial Information in an Intuitive and Actionable Format" as SFR015
  usecase "SFR014: Generate Client Analytics That Provide Meaningful Insights into Financial Behavior and Performance" as SAFR017

  SystemAdmin --> (SAFR012)
  SystemAdmin --> (SAFR013)
}

package "User" {
  actor User as CFR011
  
  usecase "CFR011: Send Feedback about the System's Recommendations and Insights to Help Improve Future Outputs" as SAFR025

  User --> (SFR025)
}
@enduml