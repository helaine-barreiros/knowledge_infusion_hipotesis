@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Core Functionalities"
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
' Define SPRITE for custom icons
!define FONTAWESOME https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/master/font-awesome-5
!include FONTAWESOME/users.puml
!include FONTAWESOME/user_tie.puml
!include FONTAWESOME/server.puml
!include FONTAWESOME/brain.puml
!include FONTAWESOME/newspaper.puml

' Persons / Actors
actor IndividualCustomer as user $sprite="users"
actor FinancialAdvisor as advisor $sprite="user_tie"

' Packages for Functional Groups
package "Authentication & Security" {
    usecase UC01: Authenticate User
        note right of UC01
            **Req. ID:** FR01, NFR06  
            **Description:** Enables user authentication via username/password or OAuth2 providers with optional multi-factor auth.
        end note
}

package "Financial Account Management" {
    usecase UC03: Connect Financial Accounts
        note right of UC03
            **Req. ID:** FR02  
            **Description:** Securely links external financial accounts using banking APIs for transaction data retrieval.
        end note

    usecase UC04: View Transactions 
        usecase UC05: Categorize Transactions <<extend>>
}

package "Analysis & Insights" {
    usecase UC06: View Financial Dashboard
    usecase UC07: Receive AI-Driven Financial Insights
        usecase UC08: Analyze Spending Habits <<generalization>>
            note right of UC07  
                **Req. ID:** FR05, NFR14  
                **Description:** Provides real-time spending patterns and recommendations based on historical data.
            end note

    package "Advanced Analytics" {
        usecase UC09: Forecast Future Financial Positions
        usecase UC10: Personalized Investment Recommendations <<generalization>>
            UC09 --|> UC10  
            note right of UC10  
                **Req. ID:** FR06, FR12  
                **Description:** Generates tailored investment strategies using AI and user data.
            end note
    }
}

package "Goal Management" {
    usecase UC11: Set Financial Goals 
        note right of UC11  
            **Req. ID:** FR07  
            **Description:** Allows users to define, track, and adjust their financial goals over time.
        end note

    usecase UC12: Monitor Budgets
}

package "Collaboration & Sharing" {
    usecase UC13: Share Data with Advisors 
        note right of UC13  
            **Req. ID:** FR13  
            **Description:** Facilitates secure sharing of selected financial data between users and advisors.
        end note

    usecase UC14: Chatbot for Financial Queries
}

package "AI-Engine" {
    usecase UC15: Process Data for Insights 
        note right of UC15  
            **Req. ID:** FR05, NFR12  
            **Description:** AI processes transaction data to derive actionable insights.
        end note

    usecase UC16: Generate Recommendations
}

package "Data Management" {
    usecase UC17: Store Financial Data 
        note right of UC17  
            **Req. ID:** FR03, NFR02  
            **Description:** Securely stores aggregated transactions and financial data.
        end note

    usecase UC18: Backup & Restore
}

package "User Interface" {
    usecase UC19: Accessible UI 
        note right of UC19  
            **Req. ID:** NFR04, NFR13  
            **Description:** Ensures user-friendly interface with WCAG compliance.
        end note

    usecase UC20: Multilingual Support
}

' Cross-package relationships (e.g., data flow)
UC06 ..> UC04 : <<include>>  
UC07 ..> UC08 : <<generalization>>

' Actor-use case interactions
user --> UC01  
advisor --> UC09, UC13  

@enduml