@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Enhanced Personal Financial Management System - Use Cases"

actor IndividualCustomer as user [#08427B]
actor FinancialAdvisor as advisor [#08427B]

package AuthenticationAndSecurity {
    usecase UC1: AuthenticateUser
        note right of UC1
            **Req. ID:** FR01, NFR06  
            Description: User authenticates via username/password or OAuth providers with optional multi-factor authentication.
        end note

    usecase UC2: ManageAccountSettings
}

package FinancialAccountManagement {
    usecase UC3: ConnectFinancialAccounts
        note right of UC3
            **Req. ID:** FR02  
            Description: Securely links external accounts using banking APIs to retrieve transaction data.
        end note
    
    usecase UC4: ViewTransactions
    usecase UC5: CategorizeTransactions

    UC3 --> UC4 : <<include>>
}

package AnalysisAndInsights {
    usecase UC6: ViewFinancialDashboard
    usecase UC7: ReceiveAISuggestions
    usecase UC8: ViewBasicReports
    usecase UC9: ViewAdvancedAnalytics
    
    UC9 --|> UC8

    UC6 --> UC4 : <<include>>
}

package FinancialGoalManagement {
    usecase UC10: SetFinancialGoals
    usecase UC11: TrackProgressTowardsGoals
    usecase UC12: AdjustGoals
}

package InvestmentPlanningAndRecommendations {
    usecase UC13: ReviewInvestmentPortfolio
    usecase UC14: GeneratePersonalizedRecommednationsForInvestment
    usecase UC15: SuggestInvestmentOpportunitiesBasedOnProfile

    note right of UC15  
        **Req. ID:** FR08, FR11  
        Description: AI suggests investments based on user’s financial profile.
    end note

}

package FinancialAdviceAndSupport {
    usecase UC16: ScheduleConsultationWithAdvisor
    usecase UC17: ShareDataWithAdvisor
    usecase UC18: ReceiveRealTimeFeedbackFromAI

    note right of UC17  
        **Req. ID:** FR09, FR13  
        Description: Users can share selected financial data with advisors for personalized guidance.
    end note
}

package FinancialHealthReporting {
    usecase UC19: GeneratePeriodicReportsOnFinancialHealth
}

package AdvancedAnalyticsAndForecasting {
    usecase UC20: ForecastFutureFinancesBasedOnHistory
    usecase UC21: AnalyzeCryptocurrencyPortfolios

    note right of UC21  
        **Req. ID:** FR14, NFR09  
        Description: AI components provide reasoning for financial predictions.
    end note

}

package SystemMaintenanceAndSecurity {
    usecase UC22: EnsureSystemComplianceWithRegulations
    usecase UC23: MaintainUptimeAndPerformance
}

actor Bank as bankingApi [#lightblue]
actor InvestmentService as investmentApi [#lightgreen]
actor AIEngine as aiEngine [#lightgreen]

UC1 --> user : <<include>>
UC3 --> bankingApi : <<extend>>

UC6 --> user : <<include>>
UC7 --> aiEngine : <<include>>

UC8 --> UC9

user --> UC2
user --> UC3
user --> UC4
advisor --> UC5, UC9, UC10, UC11, UC16, UC17
bankingApi --> UC3
investmentApi --> UC13, UC14, UC15
aiEngine --> UC7, UC8

@enduml