@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Enhanced Personal Financial Management System - Use Cases"

actor IndividualCustomer as user
actor Advisor as advisor

package AuthenticationAndSecurity {
    usecase UC01: AuthenticateUser
        note right of UC01
            **Req. ID:** FR01, NFR06  
            Allows users to authenticate via username/password or OAuth2 providers with optional multi-factor authentication.
        end note
}

package FinancialAccountManagement {
    usecase UC03: ConnectFinancialAccounts as CFA
        note right of CFA
            **Req. ID:** FR02  
            Securely links external financial accounts using banking APIs to retrieve transaction data.
        end note

    usecase UC04: ViewTransactions 
        usecase UC05: CategorizeTransactions <<extend>>
        
        ' Include relationship (UC03 includes UC04)
        UC03 --> UC04 : <<include>>

        ' Extend relationship (optional functionality in UC04)
        UC04 --> UC05 : <<extend>>
}

package AnalysisAndInsights {
    usecase UC06: ViewFinancialDashboard
    usecase UC07: ReceiveAIPredictions

    note right of UC06  
        **Req. ID:** FR03, FR05, FR10  
        Displays spending patterns and financial history.
    end note  

    ' Generalization relationship (UC09 extends more advanced analysis)
    usecase UC08: ViewBasicReports
    usecase UC09: PerformAdvancedAnalysis --|> UC08

    note right of UC07 
        **Req. ID:** FR05, FR10  
        Receives AI-generated insights and recommendations.
    end note
}

package GoalSettingAndBudgeting {
    usecase UC10: SetFinancialGoals
    usecase UC11: TrackProgress  

    ' Extend from basic goal setting to advanced (UC12)
    usecase UC13: CreateDetailedBudgets <<extend>>
    
    note right of UC10  
        **Req. ID:** FR07, FR08  
        Allows users to set and track financial goals.
    end note
}

package AlertsAndNotifications {
    usecase UC14: ConfigureAlertsForUnusualSpending as CASU
    usecase UC15: ReceiveFinancialNews

    ' Include relationship (UC14 is part of the core system)
    UC06 --> UC14 : <<include>>
    
    note right of UC15  
        **Req. ID:** FR09, NFR02  
        Receives relevant financial news and updates.
    end note
}

package InvestmentAndRetirement {
    usecase UC16: ExploreInvestmentOpportunities as EIO
    usecase UC17: SimulatePortfolios  

    ' Extend from basic investment analysis (UC18)
    usecase UC19: GeneratePersonalizedPortfolioRecomendations --|> UC18

    note right of EIO  
        **Req. ID:** FR06, FR13  
        Provides personalized recommendations based on user data.
    end note
}

package SecurityAndCompliance {
    usecase UC20: EnsureDataRegulatoryCompliance as DRC  

    ' Include relationship (UC20 is a compliance check for all data)
    DRC --> UC06 : <<include>>
    
    note right of DRC  
        **Req. ID:** NFR01, NFR03, NFR04  
        Ensures adherence to financial regulations and maintains high uptime.
    end note
}

package UserCollaboration {
    usecase UC21: ShareDataWithAdvisor as SDWA

    ' Extend relationship (additional sharing options)
    SDWA --> UC06 : <<extend>>
    
    note right of SDWA  
        **Req. ID:** FR13, NFR04  
        Facilitates secure data sharing between users and advisors.
    end note
}

' Cross-package relationships: e.g., FinancialAccountManagement includes ViewTransactions (from AnalysisAndInsights)
UC06 --> UC05 : <<include>>

actor user --> { UC01, CFA, UC03 }
advisor --> { UC09, UC21 }

@enduml