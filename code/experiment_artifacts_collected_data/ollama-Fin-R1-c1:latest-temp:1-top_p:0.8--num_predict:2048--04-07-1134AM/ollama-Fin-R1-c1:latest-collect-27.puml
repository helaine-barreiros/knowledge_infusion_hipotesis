@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Enhanced Personal Financial Management System - Use Cases"

actor IndividualCustomer as user #CUSTOMER_COLOR
actor FinancialAdvisor as advisor #CUSTOMER_COLOR

package Authentication {
    usecase UC01: Authenticate User as auth_user
    
    note right of auth_user
      **Req. ID:** FR01, NFR06  
      Description: Allows users to authenticate via username/password or OAuth2 providers with optional multi-factor authentication.
    end note
}

package FinancialAccountManagement {
    usecase UC03: Connect Financial Accounts as connect_accounts
    
    note right of connect_accounts
      **Req. ID:** FR02  
      Description: Securely links external financial accounts using banking APIs to retrieve transaction data.
    end note

    usecase UC04: View Transactions as view_transactions
    usecase UC05: Categorize Transactions as categorize_transactions
    
    UC03 ..> UC04 : <<include>>  % Base case includes included functionality  
}

package AnalysisAndInsights {
    usecase UC06: View Financial Dashboard as dashboard_view

    note right of dashboard_view
      **Req. ID:** FR03, FR04  
      Description: Visualizes spending patterns and financial history.
    end note
    
    usecase UC07: Receive AI Insights as ai_insights
}

package Planning {
    usecase UC10: Set Financial Goals as set_goals

    note right of set_goals
      **Req. ID:** FR07  
      Description: Allows users to establish and track financial goals.
    end note
    
    usecase UC12: Budget Creation & Monitoring as budget_creation_monitoring
}

package Recommendations {
    usecase UC13: Personalized Financial Recommendations as recs_personalize

    note right of recs_personalize
      **Req. ID:** FR06  
      Description: Generates tailored financial recommendations.
    end note
    
    generalization uc14a: Basic Recs --|> uc13 : <<generalization>>
}

package Notifications {
    usecase UC25: Receive Financial Alerts as alerts_receive

    note right of alerts_receive
      **Req. ID:** FR09  
      Description: Sends notifications for unusual spending.
    end note
    
    include UC04, UC06 % View Transactions and Dashboard to trigger alerts
}

package Collaboration {
    usecase UC27: Share Data with Advisors as share_data

    note right of share_data
      **Req. ID:** FR13  
      Description: Enables sharing selected financial data with advisors.
    end note
    
    include UC04 % View Transactions needed for sharing
}

package AdvancedAnalysis {
    usecase UC28: Forecast Financial Positions as forecast_positions

    note right of forecast_positions
      **Req. ID:** FR10  
      Description: Predicts future financial positions using historical data.
    end note
    
    extend uc13 : <<extend>> % Extend recommendations with forecasts
}

package Investment {
    usecase UC29: Suggest Investments as invest_suggestions

    note right of invest_suggestions
      **Req. ID:** FR11  
      Description: Recommends investment opportunities based on user profile.
    end note
    
    include uc04, uc13 % Use transactions and recommendations for suggestions
}

package DebtManagement {
    usecase UC30: Manage Debt as debt_management

    note right of debt_management
      **Req. ID:** FR12  
      Description: Offers strategies for managing debts with repayment simulations.
    end note
    
    include uc04, uc28 % Use transactions and forecasts to manage debt
}

package AIEngine {
    usecase UC31: Leverage AI Reasoning as ai_reason

    note right of ai_reason
      **Req. ID:** FR05  
      Description: Utilizes the AI engine for advanced financial analysis.
    end note
    
    include uc29, uc30 % Use investment and debt management in reasoning
}

package ExternalSystems {
    usecase UC18: Retrieve Data from Banking API as bank_api_fetch

    note right of bank_api_fetch
      **Req. ID:** FR02  
      Description: Fetches transaction data from banking APIs.
    end note
    
    include uc31 % AI Engine uses this for analysis
}

package NewsAndMarket {
    usecase UC19: Receive Financial News as news_receive

    note right of news_receive
      **Req. ID:** FR08  
      Description: Delivers relevant financial market updates and news.
    end note
    
    include uc25 % Alerts based on external events in the system's data flow
}

package UserInteraction {
    usecase UC34: Chatbot for Financial Queries as chatbot

    note right of chatbot
      **Req. ID:** FR14  
      Description: Provides answers to financial questions via a chat interface.
    end note
    
    include uc06 % May refer user to dashboards or reports in responses
}

package Reporting {
    usecase UC35: Generate Periodic Reports as report_gen

    note right of report_gen
      **Req. ID:** FR15  
      Description: Produces financial health reports at regular intervals.
    end note
    
    include uc06, uc28 % Dashboards and forecasts included in reports
}

package Crypto {
    usecase UC37: Track Cryptocurrency Portfolios as crypto_track

    note right of crypto_track
      **Req. ID:** FR16  
      Description: Monitors and analyzes cryptocurrency portfolios.
    end note
    
    include uc04, uc28 % Transactions (like buying/selling) affect tracking
}

' Cross-package relationships
UC35 ..> UC06 : <<include>>  % Reports may reference dashboards

user --> auth_user  
advisor --> set_goals  

bank_api_fetch --> ai_reason  

ai_insights --> recs_personalize  

share_data --> uc14a  

news_receive --> alerts_receive  

chatbot --> report_gen  

crypto_track --> uc35 

@enduml