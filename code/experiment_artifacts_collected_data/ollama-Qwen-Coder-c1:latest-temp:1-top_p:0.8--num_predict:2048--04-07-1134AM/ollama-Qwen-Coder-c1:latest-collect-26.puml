@startuml "AI-Powered Personal Financial Management System - Use Cases"
left
title "AI-Powered Personal Financial Management System - Use Cases"

' ACTOR DEFINITION
actor "Individual Customer" as individual [#CUSTOMER_COLOR]
actor "Financial Advisor" as advisor [#CUSTOMER_COLOR]

package "Authentication & Security" {
    usecase "UC01: Authenticate User" as UC01 <<include>>
    note right of UC01
      **Req. ID:** FR01, NFR06
      Description: Allows users to authenticate via 
      username/password or OAuth2 providers, with 
      optional multi-factor authentication.
    end note
    
    usecase "UC02: Manage Account Settings" as UC02 <<include>>
}

package "Financial Data Management" {
    usecase "UC03: Connect Financial Accounts" as UC03
    note right of UC03
      **Req. ID:** FR02
      Description: Securely links external financial accounts 
      using banking APIs to retrieve transaction data.
    end note
    
    usecase "UC04: Retrieve Transactions" as UC04 <<include>>
    usecase "UC05: Categorize Transactions" as UC05
    
    UC03 ..> UC04 : <<include>>
    
    UC04 ..> UC05 : <<extend>>
}

package "Analysis & Insights" {
    usecase "UC06: View Financial Dashboard" as UC06
    note right of UC06
      **Req. ID:** FR03, NFR12
      Description: Aggregates and categorizes financial transactions 
      to generate a visualized dashboard.
    end note
    
    usecase "UC07: Receive AI Insights" as UC07 <<include>>
    
    usecase "UC08: View Basic Reports" as UC08
    usecase "UC09: View Advanced Analytics" as UC09
    
    UC09 --|> UC08
    
    UC06 ..> UC04 : <<include>>
}

package "Planning & Budgeting" {
    usecase "UC10: Set Financial Goals" as UC10
    note right of UC10
      **Req. ID:** FR07, NFR12
      Description: Allows users to set and track financial goals 
      with visual representations.
    end note
    
    usecase "UC11: Create Budgets" as UC11 <<include>>
    
    usecase "UC12: Monitor Budget Compliance" as UC12
}

package "Investment & Recommendations" {
    usecase "UC13: Receive Investment Suggestions" as UC13 <<include>>
    note right of UC13
      **Req. ID:** FR08, NFR09
      Description: Provides AI-powered investment suggestions based 
      on user profile and market data.
    end note
    
    usecase "UC14: Track Portfolio Performance" as UC14
}

package "Debt Management & Alerts" {
    usecase "UC15: Manage Debt Payments" as UC15 <<include>>
    
    usecase "UC16: Set Up Alerts" as UC16
}

' CROSS-PACKAGE RELATIONSHIPS

individual --> UC01
individual --> UC03
individual --> UC04
advisor --> UC09
banking_api --> UC03
investment_api --> UC13
ai_engine --> UC07

@enduml