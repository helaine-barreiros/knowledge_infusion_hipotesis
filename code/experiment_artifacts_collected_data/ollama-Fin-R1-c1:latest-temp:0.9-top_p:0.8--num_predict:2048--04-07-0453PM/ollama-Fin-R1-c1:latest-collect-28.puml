@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Use Case Diagram"

actor IndividualCustomer as user
actor FinancialAdvisor as advisor
actor BankingSystem as bank #lightblue
actor InvestmentSystem as invest #lightblue
actor AIEngine as ai #lightgreen

package Authentication & Security {
    usecase UC01: Authenticate User as UC01 [FR01, NFR06]
        note right of UC01
            Allows users to authenticate via username/password or OAuth2 providers with optional multi-factor authentication.
        end note
}

package FinancialAccountManagement {
    usecase UC03: Connect Financial Accounts as UC03 [FR02]
        note right of UC03
            Securely links external financial accounts using banking APIs to retrieve transaction data.
        end note
        
    usecase UC04: View Transactions as UC04
    usecase UC05: Categorize Transactions as UC05
    
    UC03 --> UC04 : <<include>>  // ALWAYS includes viewing transactions after connection
    
    UC04 --> UC05 : <<extend>>   // Optional categorization of transactions (not always needed)
}

package FinancialAnalysis {
    usecase UC06: View Financial Dashboard as UC06
        note right of UC06
            Displays aggregated financial data, spending patterns, and visualizations.
        end note
        
    usecase UC07: Receive AI Insights as UC07 [FR05]
        note right of UC07
            Receives personalized insights on spending habits from the AI engine.
        end note
    
    usecase UC08: View Basic Reports 
    usecase UC09: View Advanced Analytics --|> UC08  // Specialized version (UC09 includes UC08 features)
}

package FinancialPlanning {
    usecase UC10: Set Financial Goals as UC10 [FR07]
        note right of UC10
            Enables users to create and track financial goals.
        end note
        
    usecase UC11: Create Budgets as UC11 [FR08]
        
    usecase UC12: Monitor Spending as UC12
}

package FinancialRecommendations {
    usecase UC13: Generate Recommendations as UC13 [FR06, FR09] 
        note right of UC13
            Provides personalized financial recommendations and alerts for unusual spending.
        end note
        
    usecase UC14: Forecast Future Positions as UC14 [FR10]
        
    usecase UC15: Suggest Investments as UC15 [FR11]
}

package Collaboration {
    usecase UC16: Share Data with Advisors as UC16 [FR13] 
        note right of UC16
            Allows users to share selected financial data with advisors for collaborative planning.
        end note
        
    usecase UC17: Use Chatbot for Financial Queries [FR14]
}

package Reporting {
    usecase UC18: Generate Periodic Reports as UC18 [FR15] 
        note right of UC18
            Produces regular financial health reports based on user data.
        end note
        
    usecase UC19: Support Cryptocurrency Tracking [FR16]
}

' Cross-package relationships

UC07 --> UC13 : <<extend>>  // AI insights can extend into generating recommendations (optional)

UC08 --> UC04 : <<include>>  // Basic reports include viewing transactions (categorized or not)
UC09 --> UC05 : <<extend>>   // Advanced analytics may involve extended categorization

UC12 --> UC03 : <<extend>>  // Budget monitoring could depend on connected accounts for accuracy
UC13 --> UC06 : <<include>>  // Recommendations might require financial dashboard data (spending patterns)

UC14 --> UC07 : <<extend>>   // Forecasting can use AI insights to make predictions

UC15 --> UC08 : <<include>>  // Investment suggestions could reference basic reports for context
UC16 --> UC03 : <<extend>>  // Sharing data might require account connection (if advisor needs transaction info)

' Actor-use case relationships

user --> UC01: Authenticate  
user --> UC02: Manage Account Settings [not explicitly listed here, but inferred from the package]
user --> UC04
advisor --> UC09
bank --> UC03
invest --> UC05  // Investment system could categorize transactions? Maybe not directly; more likely through investment APIs.
ai --> UC17

' Note: Some use cases are implied in their packages and relationships. For example, "UC02: Manage Account Settings" is part of the Authentication & Security package but isn't explicitly drawn here to avoid clutter.

@enduml