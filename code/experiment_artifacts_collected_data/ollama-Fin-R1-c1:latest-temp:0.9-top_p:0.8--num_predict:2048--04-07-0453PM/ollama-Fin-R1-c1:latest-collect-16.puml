@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Enhanced Personal Financial Management System - Use Cases"

actor IndividualCustomer as user [CUSTOMER_COLOR]
actor FinancialAdvisor as advisor [SYSTEM_COLOR]

package Authentication & Security {
    usecase UC01: Authenticate User as uc_auth
        note right of uc_auth
            **Req. ID:** FR01, NFR06  
            **Description:** Allows users to authenticate via username/password or OAuth2 providers with optional multi-factor authentication.
        end note

    usecase UC02: Manage Account Settings [SYSTEM_COLOR]
}

package FinancialAccountManagement {
    usecase UC03: Connect Financial Accounts as uc_connect
        note right of uc_connect
            **Req. ID:** FR02  
            **Description:** Securely links external financial accounts using banking APIs to retrieve transaction data.
        end note

    usecase UC04: View Transactions [SYSTEM_COLOR]
    
    usecase UC05: Categorize Transactions as uc_category [SYSTEM_COLOR] 
    
    UC03 ..> UC04 : <<include>>  
}

package FinancialAnalysis {
    usecase UC06: View Financial Dashboard [EXTERNAL_SYSTEM_COLOR] 
        note right of UC06
            **Req. ID:** FR05, NFR12  
            **Description:** Displays aggregated financial data in a user-friendly interface.
        end note

    usecase UC07: Receive AI Insights as uc_ai_insights [SYSTEM_COLOR]
}

package Planning {
    usecase UC08: Set Financial Goals 
        note right of UC08
            **Req. ID:** FR04, NFR13  
            **Description:** Allows users to define and track short-term and long-term financial objectives.
        end note

    usecase UC09: Monitor Budgets as uc_budget_monitor [SYSTEM_COLOR]
}

package Recommendations {
    usecase UC10: Generate Personalized Financial Advice 
        note right of UC10
            **Req. ID:** FR06, NFR13  
            **Description:** Provides tailored financial recommendations based on user data and market trends.
        end note

    usecase UC11: Receive Investment Recommendations as uc_inv_rec [SYSTEM_COLOR]  

}

package Collaboration {
    usecase UC12: Share Financial Data with Advisor 
        note right of UC12
            **Req. ID:** FR07, NFR03  
            **Description:** Enables users to securely share selected financial information with their advisors.
        end note

    usecase UC13: Use Chatbot for Queries [SYSTEM_COLOR]  

}

package Forecasting {
    usecase UC14: Forecast Financial Position 
        note right of UC14
            **Req. ID:** FR08, NFR12  
            **Description:** Estimates future financial scenarios based on historical data and assumptions.
        end note

    usecase UC15: Suggest Debt Management Strategies [SYSTEM_COLOR]  

}

package Investment {
    usecase UC16: Track Cryptocurrency Portfolios 
        note right of UC16
            **Req. ID:** FR09, NFR13  
            **Description:** Monitors cryptocurrency holdings and provides performance analysis.
        end note

    usecase UC17: Analyze Market Trends as uc_trends [SYSTEM_COLOR]  

}

package AIComponents {
    usecase UC18: Leverage Advanced Reasoning Engine 
        note right of UC18
            **Req. ID:** FR05, NFR04  
            **Description:** Uses the AI engine for financial analysis and predictive modeling.
        end note

}

' Relationships between packages
UC06 ..> UC03 : <<include>>  ' Financial Dashboard includes viewing transactions
uc_ai_insights ..> uc_category : <<extend>>  ' Insights can be extended with categorized data if needed

user --> uc_auth 
advisor --> uc12 [EXTERNAL_SYSTEM_COLOR]  

@enduml