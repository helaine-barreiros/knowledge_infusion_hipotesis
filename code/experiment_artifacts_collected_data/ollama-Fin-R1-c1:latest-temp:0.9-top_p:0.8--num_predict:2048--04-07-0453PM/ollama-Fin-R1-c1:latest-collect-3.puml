@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Use Case Diagram"

actor IndividualCustomer as user [#08427B]
actor FinancialAdvisor as advisor [#08427B]

package Authentication & Security {
    usecase UC01: Authenticate User
        note right of UC01 
            **Req. ID:** FR01, NFR06  
            **Description:** Allows users to authenticate via username/password or OAuth2 providers with optional multi-factor authentication.
        end note

    usecase UC02: Manage Account Settings
}

package FinancialAccountManagement {
    usecase UC03: Connect Financial Accounts
        note right of UC03 
            **Req. ID:** FR02  
            **Description:** Securely links external financial accounts using banking APIs to retrieve transaction data.
        end note

    usecase UC04: View Transactions
    usecase UC05: Categorize Transactions
    
    UC03 ..> UC04 : <<include>>  % include relationship between Connect and ViewTransactions (always included)
    
}

package AnalysisAndRecommendations {
    usecase UC06: View Financial Dashboard  
        note right of UC06 
            **Req. ID:** FR03, FR04  
            **Description:** Visualizes spending patterns and financial history.
        end note

    usecase UC07: Receive AI Insights
        note right of UC07 
            **Req. ID:** FR05  
            **Description:** Provides AI-powered insights on spending habits based on historical data.
        end note

    usecase UC08: Generate Personalized Recommendations  
        note right of UC08 
            **Req. ID:** FR06, NFR12  
            **Description:** Generates recommendations tailored to user financial goals and preferences.
        end note
}

package Planning {
    usecase UC09: Set Financial Goals  
        note right of UC09 
            **Req. ID:** FR07, FR08  
            **Description:** Allows users to set and track short-term and long-term financial objectives.
        end note

    usecase UC10: Monitor Budgets  
        note right of UC10
            **Req. ID:** FR08  
            **Description:** Creates and monitors budgets for spending categories.
        end note  

}

package Collaboration {
    usecase UC11: Share Data with Advisors  
        note right of UC11 
            **Req. ID:** FR13, NFR14  
            **Description:** Enables users to share selected financial data securely with their advisors via a chatbot or other means.
        end note

}

package FinancialAnalysis {
    usecase UC12: Forecast Future Positions
        note right of UC12 
            **Req. ID:** FR09, NFR03  
            **Description:** Projects future cash flows based on past transactions and market trends.
        end note  

    usecase UC13: Suggest Investment Opportunities  
        note right of UC13 
            **Req. ID:** FR11  
            **Description:** Recommends investment strategies that align with user risk tolerance and financial goals.
        end note

}

package DebtManagement {
    usecase UC14: Manage Loans
        note right of UC14 
            **Req. ID:** NFR07, FR12  
            **Description:** Helps users manage debts by simulating repayment scenarios to minimize costs.
        end note  

}

package NotificationsAndReminders {
    usecase UC15: Receive Alerts for Anomalies
        note right of UC15 
            **Req. ID:** FR09  
            **Description:** Sends notifications about unusual spending or other financial events that require attention.
        end note

    usecase UC16: Schedule Financial Reviews  
}

package AdvancedAnalysis {
    usecase UC17: View Basic Reports
        note right of UC17 
            **Req. ID:** FR04, NFR08  
            **Description:** Presents simplified financial reports such as income statements and cash flow charts.
        end note  

    usecase UC18: Perform Advanced Analytics  
}

package AIEngine {
    usecase UC19: Leverage AI for Financial Analysis
        note right of UC19 
            **Req. ID:** FR05, FR06  
            **Description:** Employs artificial intelligence to analyze financial data and generate actionable insights.
        end note  

}

package IntegrationWithExternalServices {
    usecase UC20: Connect Banking APIs
        note right of UC20 
            **Req. ID:** FR02  
            **Description:** Interfaces with third-party banking systems for real-time transaction updates.
        end note

    usecase UC21: Integrate Investment Portfolios
}

user --> UC01, UC03, UC06, UC15, UC17 
advisor --> UC09, UC18  
bank --> UC03, UC20  

@enduml