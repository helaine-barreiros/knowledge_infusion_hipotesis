@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Enhanced Personal Finance Management System Use Case Diagram"

actor IndividualCustomer as user
actor Advisor as advisor

package Authentication & Security {
    usecase UC01: Authenticate User as uc_authenticate_user
    
    note right of uc_authenticate_user
      **Req. ID:** FR01, NFR06  
      **Description:** Allows users to authenticate via username/password or OAuth2 providers with optional multi-factor authentication.
    end note

    usecase UC02: Manage Account Settings as uc_manage_account_settings
    
}

package FinancialAccountManagement {
    usecase UC03: Connect Financial Accounts as uc_connect_accounts
        note right of uc_connect_accounts  
          **Req. ID:** FR02  
          **Description:** Securely links external financial accounts using banking APIs to retrieve transaction data.
        end note

    usecase UC04: View Transactions as uc_view_transactions
    usecase UC05: Categorize Transactions as uc_categorize_transactions
    
    uc_connect_accounts ..> uc_view_transactions : <<include>>
    
}

package Analysis & Insights {
    usecase UC06: View Financial Dashboard as uc_view_dashboard  
        note right of uc_view_dashboard  
          **Req. ID:** FR03, FR04  
          **Description:** Displays aggregated financial transactions and spending patterns.
        end note

    usecase UC07: Receive AI Insights as uc_ai_insights
      note right of uc_ai_insights  
        **Req. ID:** FR05  
        **Description:** Provides personalized insights on spending habits via advanced analysis.
      end note
    
}

package Recommendations {
    usecase UC08: Generate Personalized Recommendations as uc_generate_recommendations 
        note right of uc_generate_recommendations
          **Req. ID:** FR06, NFR13  
          **Description:** Generates tailored financial advice based on user data and market trends.
        end note

}

package GoalManagement {
    usecase UC09: Set Financial Goals as uc_set_goals  
      note right of uc_set_goals 
        **Req. ID:** FR07  
        **Description:** Allows users to establish and track specific financial objectives.
      end note  

    usecase UC10: Track Progress Towards Goals as uc_track_progress
}

package Budgeting {
    usecase UC11: Create & Monitor Budgets as uc_create_budgets 
     note right of uc_create_budgets  
       **Req. ID:** FR08, NFR13  
       **Description:** Facilitates budget planning and ongoing monitoring with spending limits.
     end note  

}

package Alerts {
    usecase UC12: Receive Financial Alerts as uc_receive_alerts
      note right of uc_receive_alerts 
        **Req. ID:** FR09  
        **Description:** Sends notifications for unusual or concerning financial activities.
      end note  

}

package Forecasting & Planning {
    usecase UC13: Predict Future Positions as uc_predict_positions
     note right of uc_predict_positions  
       **Req. ID:** FR10, NFR04  
       **Description:** Uses historical data to forecast future financial scenarios.
     end note  

    usecase UC14: Suggest Investment Opportunities as uc_suggest_investments 
      note right of uc_suggest_investments
        **Req. ID:** FR11, FR03, NFR02  
        **Description:** Recommends investment options based on user profiles and market data.
      end note  

    usecase UC15: Manage Debt Repayments as uc_manage_debt
     note right of uc_manage_debt 
       **Req. ID:** FR12, NFR04  
       **Description:** Offers strategies for debt repayment with simulations and timelines.
     end note  

}

package Collaboration {
    usecase UC16: Share Financial Data with Advisors as uc_share_data_with_advisors
      note right of uc_share_data_with_advisors 
        **Req. ID:** FR13  
        **Description:** Enables users to share selected financial data for advisory review.
      end note  

}

package Communication {
    usecase UC17: Use Chatbot for Financial Queries as uc_use_chatbot
     note right of uc_use_chatbot 
       **Req. ID:** FR04, NFR02  
       **Description:** Interacts with a chatbot to answer financial questions and provide guidance.
     end note  

}

package Reporting {
    usecase UC18: Generate Periodic Financial Health Reports as uc_generate_reports
      note right of uc_generate_reports 
        **Req. ID:** FR14, NFR03  
        **Description:** Produces regular reports summarizing financial health and progress towards goals.
      end note  

}

package AdvancedAnalytics {
    usecase UC19: View Basic Financial Reports as uc_view_basic_reports
     note right of uc_view_basic_reports 
       **Req. ID:** FR04, NFR03  
       **Description:** Presents simplified financial data for quick overviews and basic analysis.
      end note  

}

package AIComponents {
    usecase UC20: Leverage AI Engine as uc_leverage_ai_engine
     note right of uc_leverage_ai_engine 
       **Req. ID:** FR05, FR13  
       **Description:** Integrates the AI reasoning engine for financial analysis and personalized recommendations.
      end note  

}

' Actor-Use Case Relationships
user --> UC01 : logs in or registers
user --> UC02: updates account details

advisor --> UC09: reviews progress on goals
advisor --> UC14: seeks investment suggestions 

' Include/Extend/Egeneralize relationships as per requirements

@enduml