@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Enhanced Personal Financial Management System - Use Cases"

actor IndividualCustomer as user [#08427B]
actor FinancialAdvisor as advisor [#08427B]

package Authentication & Security {
    usecase UC01: Authenticate User
        note right of UC01
            **Req. ID:** FR01, NFR06  
            Allows users to authenticate via username/password or OAuth2 providers with optional multi-factor authentication.
        end note
}

package FinancialAccountManagement {
    usecase UC03: Connect Financial Accounts
        note right of UC03
            **Req. ID:** FR02  
            Securely links external financial accounts using banking APIs for transaction data retrieval.
        end note
        
    usecase UC04: View Transactions
    usecase UC05: Categorize Transactions
    
    UC03 ..> UC04 : <<include>>
    
}

package Analysis & Insights {
    usecase UC06: View Financial Dashboard  
    usecase UC07: Receive AI-Generated Insights
        note right of UC07
            **Req. ID:** FR05, FR10  
            Provides advanced financial analysis and personalized recommendations.
        end note
        
}

package Planning & GoalSetting {
    usecase UC08: Set Financial Goals  
    usecase UC09: Track Progress Toward Goals  
        
}

package Collaboration & Sharing {
    usecase UC10: Share Data with Advisor
        note right of UC10
            **Req. ID:** FR13  
            Allows users to share selected financial data securely.
        end note
        
}

' Cross-package relationships
UC06 ..> UC04 : <<include>>
UC07 ..> UC09 : <<extend>>

user --> UC01 
user --> UC03 
advisor --> UC08 

@enduml