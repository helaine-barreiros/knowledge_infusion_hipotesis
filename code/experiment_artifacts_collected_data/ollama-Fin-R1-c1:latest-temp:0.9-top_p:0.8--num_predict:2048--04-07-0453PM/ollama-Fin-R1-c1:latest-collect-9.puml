@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Use Case Diagram"

actor IndividualCustomer as user
actor FinancialAdvisor as advisor
system PFMSystem
system BankingAPI, InvestmentAPI, CreditService, NewsService, AuthService, AIEngine

package Authentication & Security {
    usecase UC01: Authenticate User as auth_user
    
    note right of UC01 
        **Req. ID:** FR01  
        **Description:** Allows users to authenticate via username/password or OAuth2 providers with optional multi-factor authentication.
    end note
}

package FinancialAccountManagement {
    usecase UC03: Connect Financial Accounts as connect_accounts
    usecase UC04: View Transactions as view_transactions
    usecase UC05: Categorize Transactions as categorize_txns

    UC03 -- UC04 : <<include>>
    
    note right of UC03 
        **Req. ID:** FR02  
        **Description:** Securely links external financial accounts using banking APIs to retrieve transaction data.
    end note
}

package Analysis & Insights {
    usecase UC06: View Financial Dashboard as view_dashboard
    usecase UC07: Receive AI-Driven Insights as receive_insights
    
    note right of UC07 
        **Req. ID:** FR05  
        **Description:** Provides personalized financial insights using advanced analytics.
    end note

    usecase UC08: View Basic Reports as view_basic_reports
    usecase UC09: Generate Advanced Financial Plans as generate_plans
    
    UC09 -- UC08 : <<generalize>>
    
    note right of UC06 
        **Req. ID:** FR04  
        **Description:** Visualizes spending patterns, categorization results.
    end note
}

package GoalSetting {
    usecase UC10: Set Financial Goals as set_goals
    usecase UC11: Track Progress Towards Goals as track_progress
    
    note right of UC10 
        **Req. ID:** FR07  
        **Description:** Allows users to establish and monitor financial objectives.
    end note

    note right of UC11 
        **Req. ID:** FR08, NFR04  
        **Description:** Monitors goal achievement with real-time updates within 1 second response time.
    end note
}

package Alerts {
    usecase UC12: Receive Financial Alerts as receive_alerts
    usecase UC13: Customize Alert Preferences as customize_alerts
    
    note right of UC13 
        **Req. ID:** FR09  
        **Description:** Enables users to tailor alert settings for specific scenarios.
    end note

    usecase UC14: Set Up Recurring Alerts as set_recurring_alerts
}

package InvestmentRecommendations {
    usecase UC15: View Market Data as view_market_data
    usecase UC16: Generate Personalized Investment Plans as generate_investment_plans
    
    note right of UC16 
        **Req. ID:** FR06, FR11  
        **Description:** Recommends investment strategies based on user risk profile and market conditions.
    end note

    usecase UC17: Review Portfolio Performance as review_performance
}

package DebtManagement {
    usecase UC18: Create Repayment Plans as create_repayment_plans
    usecase UC19: Track Debt Progress as track_debt_progress
    
    note right of UC18 
        **Req. ID:** FR12  
        **Description:** Helps users plan debt repayment schedules and visualize progress.
    end note

    note right of UC19 
        **Req. ID:** NFR04, NFR07  
        **Description:** Updates debt status in real-time with minimal delays for recovery from outages.
    end note
}

package Sharing {
    usecase UC20: Share Financial Data With Advisors as share_data_with_advisors

    note right of UC20 
        **Req. ID:** FR13  
        **Description:** Allows customers to securely transfer financial data to their advisors for collaborative planning.
    end note
}

package ChatbotInteraction {
    usecase UC21: Engage with Financial Assistant as chat_with_assistant

    note right of UC21 
        **Req. ID:** FR08, NFR04  
        **Description:** Interacts via a conversational interface to answer queries and provide guidance.
    end note
}

package Reporting {
    usecase UC22: Generate Periodic Financial Reports as generate_reports

    note right of UC22 
        **Req. ID:** FR15, NFR04  
        **Description:** Creates detailed reports for review or sharing with external parties.
    end note
}

package CryptocurrencyManagement {
    usecase UC23: Track Crypto Portfolios as track_crypto_portfolios

    note right of UC23 
        **Req. ID:** FR16, NFR04  
        **Description:** Monitors cryptocurrency holdings and provides analysis similar to traditional investments.
    end note
}

' Relationships between packages (e.g., Analysis & Insights includes basic reporting)
UC08 -- view_dashboard : <<include>>

' Human-System interactions
user --> auth_user
advisor --> generate_plans, receive_insights

' System-to-system relationships for data retrieval and processing
PFMSystem .. BankingAPI: <<include>>
PFMSystem .. InvestmentAPI: <<extend>> UC16 
PFMSystem .. CreditService: <<extend>> UC07  
PFMSystem .. NewsService: <<include>> UC23, receive_insights

' Feedback relationships (e.g., Alerts)
UC14 --> PFMSystem : <<extend>>
UC12 -- PFMSystem : <<extend>>

@enduml