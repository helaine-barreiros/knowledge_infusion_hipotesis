@startuml "AI-Enhanced Personal Financial Management System - Use Cases"

title "AI-Powered Personal Financial Management System - Core Use Case Diagram"

actor IndividualCustomer as user
actor Advisor as advisor
system PFMSystem as pfm #SYSTEM_COLOR
system BankingAPI as bank_api #EXTERNAL_SYSTEM_COLOR
system InvestmentAPI as inv_api #EXTERNAL_SYSTEM_COLOR
system CreditService as credit_service #EXTERNAL_SYSTEM_COLOR
system NewsService as news_service #EXTERNAL_SYSTEM_COLOR
system AuthService as auth_service #EXTERNAL_SYSTEM_COLOR

package "Authentication & Security" {
    usecase UC01: Authenticate User
        note right of UC01 
            **Req. ID:** FR01, NFR06  
            Allows users to log in via username/password or OAuth2 providers with optional multi-factor authentication.
        end note
}

package "Financial Account Management" {
    usecase UC03: Connect Financial Accounts
        note right of UC03 
            **Req. ID:** FR02  
            Securely links external financial accounts using banking APIs to retrieve transaction data.
        end note

    usecase UC04: View Transactions as uc4
    usecase UC05: Categorize Transactions as uc5
    
    uc4 ..> uc5 : <<extend>>  -- optional categorization after viewing transactions  
}

package "Data Aggregation & Analysis" {
    usecase UC06: Aggregate Financial Data 
        note right of UC06 
            **Req. ID:** FR03, FR10  
            Collects and organizes transactional data into categories for analysis.
        end note

    usecase UC07: Generate Insights as uc7
}

package "Recommendation & Planning" {
    usecase UC08: Create Financial Goals 
        note right of UC08 
            **Req. ID:** FR04, FR13  
            Helps users set and track financial objectives.
        end note

    usecase UC09: Generate Recommendations as uc9
}

package "AI & Automation" {
    usecase UC10: Analyze Financial Patterns as uca10 
        note right of Uca10 
            **Req. ID:** FR05, NFR07  
            Uses AI to identify spending trends and predict future expenses.
        end note

    usecase UC11: Personalized Recommendations as ucr11
}

package "Collaboration & Sharing" {
    usecase UC12: Share Data with Advisor 
        note right of UC12 
            **Req. ID:** FR07, NFR03  
            Allows users to share selected financial data for advisory services.
        end note

    usecase UC13: Chatbot Interactions as ucchat
}

package "Reporting & Analytics" {
    usecase UC14: Generate Financial Health Reports 
        note right of UC14 
            **Req. ID:** FR08, NFR12  
            Produces detailed reports on financial status and performance.
        end note

    usecase UC15: Display Investment Performance as ucip
}

package "Notifications & Alerts" {
    usecase UC16: Receive Financial Alerts 
        note right of UC16 
            **Req. ID:** FR09  
            Sends notifications for unusual spending or critical financial events.
        end note

    usecase UC17: Scheduled Reminders as ucrm
}

package "Market Integration" {
    usecase UC18: Fetch Market Data from Investment API as ucfdiai 
        note right of UC18 
            **Req. ID:** FR04, NFR02  
            Pulls real-time market data and portfolio performance metrics.
        end note

    usecase UC19: Analyze Portfolio Performance as ucapa
}

package "Debt Management" {
    usecase UC20: Manage Debt Repayments 
        note right of UC20 
            **Req. ID:** FR12, NFR03  
            Offers strategies for debt reduction with repayment simulations.
        end note

    usecase UC21: Track Credit Scores as uctcs
}

package "User Experience" {
    usecase UC22: Customize Dashboards and Reports as ucudr 
        note right of UC22 
            **Req. ID:** FR07, NFR13  
            Allows personalization of the user interface for better navigation.
        end note

    usecase UC23: Offline Mode Support as ucofm
}

package "Multi-System Interactions" {
    pfm ..> bank_api : <<include>> 
    pfm ..> inv_api : <<include>>
    pfm ..> credit_service : <<include>>
    pfm ..> news_service : <<include>>
    pfm ..> auth_service : <<include>>
}

actor user --> UC01
actor advisor --> uc9, uca10

@enduml