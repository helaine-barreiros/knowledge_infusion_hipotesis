@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (View)
}

package "Financial Advisor" {
  actor FA as FFA

  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (Manage)
}

package "System Administrator" {
  actor SA as SAA

  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase ("SFAFR001: Configure System-Generated Insights") as SFAFR001
  
  SAA --> (Manage)
}

package "System" {
  rectangle "AI Component" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on ESG Preferences" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "AIFR008: Generate Predictive Intervention Recommendations" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
    
  }
  
  rectangle "Notification System" {
    usecase ("SFR001: Deliver Alerts") as SFR001
  }

  rectangle "Recommendation Engine" {
    usecase ("SFR002: Deliver Personalized Recommendations") as SFR002
  }

  rectangle "Prediction Service" {
    usecase ("SFR003: Request Financial Predictions") as SFR003
  }
  
  rectangle "Personalization Service" {
    usecase ("SFR004: Request Personalized Recommendations from AI Component") as SFR004
  }

  rectangle "Spending Limit Alert System" {
    usecase ("SFR005: Request Spending Limit Alerts") as SFR005
  }
  
  rectangle "Investment Opportunity Analysis Service" {
    usecase ("SFR006: Request Investment Opportunity Analyses") as SFR006
  }

  rectangle "ESG Alignment System" {
    usecase ("SFR007: Request Specific Investment Opportunities Based on ESG Preferences") as SFR007
  }
  
  rectangle "Anomaly Detection Service" {
    usecase ("SFR008: Request Anomaly Transaction Alerts") as SFR008
  }

  rectangle "News Integration System" {
    usecase ("SFR009: Find Contextualized News Relevant to User's Portfolio") as SFR009
    usecase ("SFR10: Process Contextualized News Insights") as SFR10
    usecase ("SFR11: Request Contextualized News Insights from AI Component") as SFR11
  }
  
  rectangle "Predictive Intervention Analysis System" {
    usecase ("SFR12: Generate Predictive Intervention Recommendations Based on Patterns Detected by AI Component") as SFR12
  }

  rectangle "Insight Enhancement Service" {
    usecase ("SFR13: Request Predictive Insights from the AI Component to Enhance Financial Guidance") as SFR13
  }
  
  rectangle "Financial Health Reporting System" {
    usecase ("SFR14: Generate Financial Health Reports Based on User's Portfolio and Metrics") as SFR14
  }

  rectangle "Goal Management Service" {
    usecase ("SFR15: Manage Users' Financial Goals to Track Progress and Provide Recommendations") as SFR15
  }
  
  rectangle "Feedback Management System" {
    usecase ("CFR11: Send Feedback about the System's Recommendations and Insights") as CFR11
  }

}

C --> (View) : CFR002, CFR03, CFR04, CFR06, CFR07, CFR08, CFR09, SAFR005, SFR002, AIFR002, AIFR003, AIFR004
FA --> (Manage) : FAFR01, FAFR02, FAFR03, FAFR04, SAFR001, SFAFR001, AIFR005, AIFR006, AIFR007, AIFR008
SAA --> (Manage) : SAFR001, SFAFR001

@enduml