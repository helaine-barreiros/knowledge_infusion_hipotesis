package "Components" {
  component AIComponent as AIC
  component NotificationSystem as NS
  component RecommendationEngine as RE
  component PredictionService as PS
  component NewsProcessor as NP
  component DashboardGenerator as DG
  component AlertManager as AM
  component AnalyticsModule as ANM
  component InterventionPredictor as IP
  
  AIComponent --> AIC: "Generates Predictions"
  AIComponent --> RE: "Generates Recommendations"
  AIComponent --> PS: "Analyzes Spending Limits"
  AIComponent --> NP: "Processes News"
  AIComponent --> DG: "Creates Dashboards"
  AIComponent --> AM: "Manages Alerts"
  AIComponent --> ANM: "Provides Analytics"
  AIComponent --> IP: "Predicts Interventions"
  
  NotificationSystem <|-- NS
  RecommendationEngine <|-- RE
  PredictionService <|-- PS
  NewsProcessor <|-- NP
  DashboardGenerator <|-- DG
  AlertManager <|-- AM
  AnalyticsModule <|-- ANM
  InterventionPredictor <|-- IP
  
}

@enduml