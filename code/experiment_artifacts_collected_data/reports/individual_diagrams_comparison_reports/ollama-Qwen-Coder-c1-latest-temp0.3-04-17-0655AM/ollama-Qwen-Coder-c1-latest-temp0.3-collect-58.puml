@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Anomalous Transaction Alerts" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View Financial News" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> (CFR001)
  C --> (CFR002)
  C --> (CFR003)
  C --> (CFR004)
  C --> (CFR005)
  C --> (CFR006)
  C --> (CFR007)
  C --> (CFR008)
  C --> (CFR009)
  C --> (CFR10)
}

package "Financial Advisor" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  
  FA --> (FAFR001)
  FA --> (FAFR002)
  FA --> (FAFR003)
  FA --> (FAFR004)
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR019: Maintain Historical Record of Insights" as SFR019
  
  SA --> (SAFR001)
  SA --> (SFR019)
}

package "System" {
  rectangle SystemBoundary {
    usecase "SFR002: Deliver Personalized Recommendations" as SFR002
    useusecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
    usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component" as SFR006
    useusecase "SFR007: Request Specific Investment Opportunities from AI Component Matching User Criteria and ESG Preferences" as SFR007
    usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
    usecase "SFR009: Find Contextualized News Relevant to Users' Financial Portfolios" as SFR009
    useusecase "SFR010: Process Contextualized News to Extract Relevant Information for Users' Financial Situations" as SFR010
    usecase "SFR011: Request Contextualized News Insights from AI Component Identifying Potential Impacts on Users' Investments" as SFR011
    useusecase "SFR012: Generate Client Dashboards Presenting Financial Information in an Intuitive and Actionable Format" as SFR012
    usecase "SFR013: Generate Client Alerts Based on Predefined Conditions Ensuring Timely Notification of Important Financial Events" as SFR013
    useusecase "SFR014: Generate Client Analytics Providing Meaningful Insights into Financial Behavior and Performance" as SFR014
    usecase "SFR015: Request Predictive Intervention Analyses from AI Component Identifying When Financial Advisors Should Engage with Clients" as SFR015
    useusecase "SFR016: Request Predictive Insights From the AI Component Enhancing Value of Financial Guidance Provided to Clients" as SFR016
    useusecase "SFR017: Generate Financial Health Reports Assessing Users' Overall Financial Wellbeing According to Standard Financial Ratios and Metrics" as SFR017
    useusecase "SFR018: Manage Users' Financial Goals Tracking Progress Providing Relevant Recommendations" as SFR018
    useusecase "SFR020: Request User Feedback Managing Continuous Improvement of System's Outputs Accuracy Relevance" as SFR020
    
  }
}

package "AI Component" {
  rectangle AIBoundary {
    usecase "AIFR001: Generate Financial Predictions for Users Analyzing Historical Transaction Data Market Trends Economic Indicators" as AIFR001
    useusecase "AIFR002: Generate Personalized Recommendations Based on User's Financial Profiles Goals Risk Tolerance Industry Standards FINRA Guidelines" as AIFR002
    useusecase "AIFR003: Generate Spending Limit Alerts Identifying Unusual Deviations from Established Spending Patterns" as AIFR003
    useusecase "AIFR004: Generate Investment Opportunity Analyses Evaluating Potential Investments Against User's Risk Profiles Time Horizons Financial Goals" as AIFR004
    useusecase "AIFR005: Generate Investment Opportunities Identifying Financial Instruments Aligning with User's Investment Strategies Modern Portfolio Theory Principles" as AIFR005
    useusecase "AIFR006: Generate Anomaly Transaction Alerts Employing Pattern Recognition Detecting Potentially Fraudulent Activities Compliance FinCEN Requirements" as AIFR006
    useusecase "AIFR007: Generate Contextualized News Insights Correlating Financial News with Specific User Portfolios Identifying Relevant Impacts" as AIFR007
    useusecase "AIFR008: Generate Client Predictive Intervention Recommendations Identifying Patterns Indicating Potential Financial Difficulties Opportunities Requiring Advisor Engagement" as AIFR008
    useusecase "AIFR009: Generate Client Predictive Insights Providing Forward-Looking Analysis of Financial Situations Supporting More Effective Financial Planning" as AIFR009
    
  }
}

C --> (SFR012)
FA --> (SFR016)
SA --> (SFR017)

@enduml