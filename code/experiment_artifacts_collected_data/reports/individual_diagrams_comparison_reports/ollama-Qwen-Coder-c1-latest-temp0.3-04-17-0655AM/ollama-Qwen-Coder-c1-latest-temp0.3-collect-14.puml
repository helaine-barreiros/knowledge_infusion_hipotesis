@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:SystemAdmin: as SysAdmin
:FinancialAdvisor: as FAFD
:User: as User
:AIFR001: as AIFR001

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Deliver Personalized Recommendations" as SFR003
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FinancialAdvisor --> FAFR002
  User --> (Send Feedback)
}

rectangle "AI System" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  
  Client -> AIFR001 : Request Predictions
  SysAdmin -> AIFR001 : Configure Parameters
  FAFD -> AIFR001 : Analyze Insights for Recommendations
}

@enduml