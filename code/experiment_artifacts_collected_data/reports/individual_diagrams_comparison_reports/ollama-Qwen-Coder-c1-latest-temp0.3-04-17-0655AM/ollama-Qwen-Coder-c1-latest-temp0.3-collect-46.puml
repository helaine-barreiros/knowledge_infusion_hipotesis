@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Clients" {
  actor Client as C
  
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: View News Related to Portfolio" as CFR008
  usecase "CFR009: Access Personalized Dashboard" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10
  
  C --> CFR001
  C --> CFR002
  C --> CFR003
  C --> CFR004
  C --> CFR005
  C --> CFR006
  C --> CFR007
  C --> CFR008
  C --> CFR009
  C --> CFR10
}

package "Financial Advisors" {
  actor FinancialAdvisor as FA
  
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  
  FA --> FAFR001
  FA --> FAFR002
  FA --> FAFR003
  FA --> FAFR004
}

package "System Administrator" {
  actor SystemAdmin as SA
  
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  
  SA --> SAFR001
}

package "System Components" {
  rectangle "AI Component" {
    usecase "AIFR001: Generate Financial Predictions" as AIFR001
    usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
    usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
    usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on Modern Portfolio Theory" as AIFR005
    usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
    usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
    usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
    usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
    
    C --> (AIFR001)
    FA --> (AIFR002)
    SA --> (AIFR003)
  }
  
  rectangle "Notification Component" {
    usecase "SFR001: Deliver Alerts to Users" as SFR001
    
    C --> (SFR001)
    FA --> (SFR001)
    SA --> (SFR001)
  }
}

package "System Operations" {
  rectangle "Personalized Recommendations Component" {
    usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
    
    C --> (SFR002)
    FA --> (SFR002)
    SA --> (SFR002)
  }
  
  rectangle "Predictive Analytics Component" {
    usecase "SFR003: Request Financial Predictions from AI" as SFR003
    usecase "SFR016: Request Predictive Insights from AI" as SFR016
    
    C --> (SFR003)
    FA --> (SFR003)
    SA --> (SFR003)
  }
  
  rectangle "Spending Limit Alerts Component" {
    usecase "SFR005: Request Spending Limit Alerts from AI" as SFR005
    
    C --> (SFR005)
    FA --> (SFR005)
    SA --> (SFR005)
  }
  
  rectangle "Investment Opportunity Analysis Component" {
    usecase "SFR006: Request Investment Opportunity Analyses from AI" as SFR006
    usecase "SFR012: Generate Client Dashboards" as SFR012
    
    C --> (SFR006)
    FA --> (SFR006)
    SA --> (SFR006)
  }
  
  rectangle "Anomaly Transaction Alerts Component" {
    usecase "SFR008: Request Anomaly Transaction Alerts from AI" as SFR008
    
    C --> (SFR008)
    FA --> (SFR008)
    SA --> (SFR008)
  }
  
  rectangle "Contextualized News Component" {
    usecase "SFR009: Request Contextualized News from AI" as SFR009
    usecase "SFR10: Process Contextualized News for Users" as SFR10
    
    C --> (SFR009)
    FA --> (SFR009)
    SA --> (SFR009)
  }
  
  rectangle "Client Predictive Intervention Component" {
    usecase "SFR015: Request Client Predictive Interventions from AI" as SFR015
    
    C --> (SFR015)
    FA --> (SFR015)
    SA --> (SFR015)
  }
  
  rectangle "Financial Health Reports Component" {
    usecase "SFR17: Generate Financial Health Reports" as SFR17
    
    C --> (SFR17)
    FA --> (SFR17)
    SA --> (SFR17)
  }
}

package "User Feedback Management" {
  rectangle "Feedback Component" {
    usecase "CFR11: Send Feedback to Improve Recommendations and Insights" as CFR11
    
    C --> (CFR11)
    FA --> (CFR11)
    SA --> (CFR11)
  }
}

@enduml