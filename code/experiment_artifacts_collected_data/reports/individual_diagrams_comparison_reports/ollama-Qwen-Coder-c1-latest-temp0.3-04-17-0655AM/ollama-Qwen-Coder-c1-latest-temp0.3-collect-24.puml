@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package Client {
  actor "Client" as CFR001
  
  usecase "CFR002: View Alerts about Anomalous Transactions" as SAFR003
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as SAFR004
  usecase "CFR005: Manage Personalized Recommendations Preferences" as SAFR006
  usecase "CFR007: View Investment Opportunities Suitable to My Risk Profile" as SAFR012
  usecase "CFR008: View News Related to My Investment Portfolio" as SAFR013
  usecase "CFR009: Access a Personalized Dashboard Consolidating Financial Information" as SAFR014
  
  CFR001 --> (SAFR002)
  CFR001 --> (SAFR003)
  CFR001 --> (SAFR004)
  CFR001 --> (SAFR005)
  CFR001 --> (SAFR012)
  CFR001 --> (SAFR013)
  CFR001 --> (SAFR014)
}

package FinancialAdvisor {
  actor "Financial Advisor" as FAFR001
  
  usecase "FAFR002: View Client Intervention Alerts" as SAFR007
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations" as SAFR008
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as SAFR015
  
  FAFR001 --> (SAFR002)
  FAFR001 --> (SAFR003)
  FAFR001 --> (SAFR004)
}

package System {
  actor "System Administrator" as SAFR001
  actor "User" as CFR011
  
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as AIFR002
  usecase "SFR003: Request Financial Predictions from the AI Component" as AIFR001
  usecase "SFR004: Request Personalized Recommendations from the AI Component Based on Each User's Financial Data and Preferences" as AIFR002
  usecase "SFR005: Request Spending Limit Alerts from the AI Component When User Spending Patterns Exceed Defined Thresholds" as AIFR003
  usecase "SFR006: Request Investment Opportunity Analysis From the AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles" as AIFR004
  usecase "SFR012: Generate Client Dashboards That Present Financial Information in an Intuitive and Actionable Format" as AIFR009
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as AIFR005
  
  SAFR001 --> (SAFR002)
  SAFR001 --> (AIFR001)
  SAFR001 --> (AIFR003)
  SAFR001 --> (AIFR004)
  
  CFR011 --> (SFR002)
  CFR011 --> (AIFR005)
  CFR011 --> (AIFR006)
}

@enduml