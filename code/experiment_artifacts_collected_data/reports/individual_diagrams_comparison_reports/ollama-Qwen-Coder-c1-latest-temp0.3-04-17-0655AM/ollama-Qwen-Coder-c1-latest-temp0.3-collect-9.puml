@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

package "Client" {
  actor Client as CFR001
}

package "Financial Advisor" {
  actor FinancialAdvisor as FAFR002
  
  usecase "FAFR003: View Predictive Analytics" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004
}

package "System Administrator" {
  actor SystemAdmin as SAFR001
  
  usecase "SAFR002: Manage Analysis Parameters" as SAFR002
}

package "AI System" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations" as AIFR002
  usecase "AIFR003: Generate Spending Limit Alerts" as AIFR003
  usecase "AIFR004: Generate Investment Opportunity Analyses" as AIFR004
  usecase "AIFR005: Generate Investment Opportunities Based on Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Generate Anomaly Transaction Alerts" as AIFR006
  usecase "AIFR007: Generate Contextualized News Insights" as AIFR007
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009
  
}

package "System Components" {
  rectangle "Notification System" {
    usecase "SFR001: Deliver Alerts to Users Through Appropriate Notification Channels" as SFR001
  }
  
  rectangle "Recommendation Engine" {
    usecase "SFR002: Deliver Personalized Recommendations Based on Financial Profiles" as SFR002
    
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users" as AIFR004
    usecase "AIFR005: Generate Investment Opportunities Based on Modern Portfolio Theory Principles" as AIFR005
  }
  
  rectangle "Prediction Engine" {
    usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
    
    usecase "AIFR001: Generate Financial Predictions for Users by Analyzing Historical Data, Market Trends, and Economic Indicators" as AIFR001
  }
  
  rectangle "Recommendation Engine (AI)" {
    usecase "SFR004: Request Personalized Recommendations from AI Component Based on Each User's Financial Data and Preferences" as SFR004
    
    usecase "AIFR002: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance As Defined by Industry Standards Like FINRA Guidelines" as AIFR002
  }
  
  rectangle "Spending Limit Alert Engine" {
    usecase "SFR005: Request Spending Limit Alerts from AI Component When User Spending Patterns Exceed Defined Thresholds" as SFR005
    
    usecase "AIFR003: Generate Spending Limit Alerts for Users by Identifying Unusual Deviations From Established Spending Patterns" as AIFR003
  }
  
  rectangle "Investment Opportunity Analysis Engine" {
    usecase "SFR006: Request Investment Opportunity Analysis from AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles" as SFR006
    
    usecase "AIFR004: Generate Investment Opportunity Analyses for Users by Evaluating Potential Investments Against Their Risk Profiles, Time Horizons, and Financial Goals" as AIFR004
  }
  
  rectangle "Anomaly Transaction Alert Engine" {
    usecase "SFR007: Request Anomaly Transaction Alerts from AI Component to Detect Potentially Fraudulent Activities in Compliance with FinCEN Requirements" as SFR007
    
    usecase "AIFR006: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance With FinCEN Requirements" as AIFR006
  }
  
  rectangle "Contextualized News Engine" {
    usecase "SFR008: Request Contextualized News from Trusted Financial News Sources" as SFR008
    
    usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
  }
  
  rectangle "Predictive Intervention Analysis Engine" {
    usecase "SFR15: Request Predictive Intervention Analyses from AI Component to Identify When Financial Advisors Should Engage With Clients" as SFR15
    
    usecase "AIFR08: Generate Client Predictive Intervention Recommendations by Identifying Patterns That Indicate Potential Financial Difficulties or Opportunities Requiring Advisor Engagement" as AIFR08
  }
  
  rectangle "Predictive Insights Engine" {
    usecase "SFR16: Request Predictive Insights from AI Component to Enhance the Value of Financial Guidance Provided to Clients" as SFR16
    
    usecase "AIFR09: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR09
  }
  
}

package "User Interface Components" {
  rectangle "Dashboard Generator" {
    usecase "SFR12: Request Dashboards that Present Financial Information in an Intuitive and Actionable Format" as SFR12
    
    usecase "AIFR03: Generate Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as AIFR03
  }
  
  rectangle "Alert Generator" {
    usecase "SFR13: Request Client Alerts Based on Predefined Conditions to Ensure Timely Notification of Important Financial Events" as SFR13
    
    usecase "AIFR06: Generate Anomaly Transaction Alerts by Employing Pattern Recognition to Detect Potentially Fraudulent Activities in Compliance With FinCEN Requirements" as AIFR06
  }
  
  rectangle "Analytics Generator" {
    usecase "SFR14: Request Client Analytics That Provide Meaningful Insights into Financial Behavior and Performance" as SFR14
    
    usecase "AIFR09: Generate Client Predictive Insights That Provide Forward-Looking Analysis of Financial Situations to Support More Effective Financial Planning" as AIFR09
  }
  
}

package "System Management Components" {
  rectangle "Goal Manager" {
    usecase "SFR18: Manage Users' Financial Goals to Track Progress and Provide Relevant Recommendations" as SFR18
    
    usecase "AIFR02: Generate Personalized Recommendations for Users Based on Their Financial Profiles, Goals, and Risk Tolerance As Defined by Industry Standards Like FINRA Guidelines" as AIFR02
  }
  
  rectangle "Feedback Manager" {
    usecase "CFR11: Send Feedback About the System's Recommendations and Insights to Help Improve Future Outputs" as CFR11
    
    usecase "SFR20: Manage User Feedback to Continuously Improve Quality and Relevance of Financial Insights" as SFR20
  }
  
}

package "Historical Record Management Components" {
  rectangle "History Manager" {
    usecase "SFR19: Maintain a Historical Record of Users' Insights to Enable Trend Analysis and Effectiveness Measurement" as SFR19
    
    usecase "AIFR07: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR07
  }
}

CFR001 --> CFR002 : "View Alerts"
CFR001 --> FAFR003 : "View Predictive Analytics"
FAFR004 <|-- SAFR002 : "Configure Analysis Parameters for Specific Client Segments"
SAFR002 --> AIFR005 : "Generate Investment Opportunities Based on Modern Portfolio Theory Principles"

CFR011 --> CFR002
CFR011 --> FAFR003
FAFR004 <|-- SAFR002
SFR007 --> SFR008

@enduml