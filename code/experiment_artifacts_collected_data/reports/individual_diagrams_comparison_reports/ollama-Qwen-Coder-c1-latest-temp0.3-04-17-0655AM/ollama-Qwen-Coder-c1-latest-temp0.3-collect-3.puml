@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:Financial Advisor: as FAFD

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR009: Generate Contextualized News Insights" as AIFR009
  
  Client --> CFR001
  SysAdmin --> SAFR001
  FAFD --> (FAFR002)
  
  Client -> SFR003 : Request Predictions
  System Admin -> SAFR001 : Manage Parameters
  Financial Advisor -> FAFR002 : View Alerts
  
  Client --(SFR009)--> AIFR009 : Get News Insights
}

rectangle "Client Dashboard" {
  usecase "CFR003: View Financial Predictions Based on Historical Data and Current Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with My Financial Profile and Goals" as CFR004
  
  Client --> (CFR003)
  Client --> (CFR004)
}

rectangle "Financial Advisor Dashboard" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR003: View Predictive Analytics About My Clients' Financial Situations" as FAFR003
  
  Financial Advisor --> (FAFR001)
  Financial Advisor --> (FAFR003)
}

rectangle "System Alerts and Recommendations" {
  usecase "SFR002: Deliver Personalized Recommendations to Users Based on Their Financial Profiles" as SFR002
  usecase "SFR004: Request Personalized Recommendations from the AI Component Based on Each User's Financial Data and Preferences" as SFR004
  
  System Admin --> (SAFR001)
  Client --> (SFR002)
  Client --> (SFR004)
}

rectangle "Spending Limits and Alerts" {
  usecase "CFR006: View Spending Limit Alerts When I Exceed Predefined Thresholds in Specific Expense Categories" as CFR006
  usecase "SFR005: Request Spending Limit Alerts from the AI Component When User Spending Patterns Exceed Defined Thresholds" as SFR005
  
  Client --> (CFR006)
  System Admin -> SAFR001 : Manage Parameters
}

rectangle "Investment Opportunities and Recommendations" {
  usecase "FAFR007: View Investment Opportunities Suitable to My Risk Profile (as Defined Under MiFID II or Equivalent Standards)" as FAFR007
  usecase "SFR006: Request Investment Opportunity Analysis from the AI Component to Identify Suitable Investments for Users Based on Their Risk Profiles" as SFR006
  
  Financial Advisor --> (FAFR007)
  Client --> (SFR006)
}

rectangle "News and Information" {
  usecase "CFR008: View News Related to My Investment Portfolio to Stay Informed About Market Events That Might Affect My Assets" as CFR008
  usecase "AIFR007: Generate Contextualized News Insights by Correlating Financial News with Specific User Portfolios to Identify Relevant Impacts" as AIFR007
  
  Client --> (CFR008)
  System Admin -> SAFR001 : Manage Parameters
}

rectangle "Client Relationship Management" {
  usecase "CFR10: Manage My Relationship With Financial Advisors, Including Permissions for Sharing My Financial Data, to Maintain Privacy and Control Over My Financial Information" as CFR10
  
  Client --> (CFR10)
}
@enduml