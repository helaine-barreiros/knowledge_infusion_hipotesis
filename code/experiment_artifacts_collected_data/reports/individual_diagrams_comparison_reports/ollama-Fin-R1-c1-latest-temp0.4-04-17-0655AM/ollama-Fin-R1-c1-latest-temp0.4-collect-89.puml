@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Personalized Recommendations Aligned with Financial Profile and Goals" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile (MiFID II)" as CFR007
  usecase "CFR008: Receive News Related to Investment Portfolio" as CFR008
  usecase "CFR009: Consolidated Personalized Dashboard for Financial Monitoring" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors, Including Data Sharing Permissions" as CFR010

  Client --> CFR001 : View financial data in a dashboard.
  Client --> CFR002 : Receive alerts on anomalous transactions.
  Client --> CFR003 : Access future financial predictions based on history and trends.
  Client --> CFR004 : Get personalized investment recommendations aligned with goals.
  Client --> CFR005 : Adjust preferences for recommendations to match risk tolerance.
  Client --> CFR006 : Monitor spending limits via alerts.
  Client --> CFR007 : Explore investments suitable for their profile.
  Client --> CFR008 : Stay informed about market news affecting assets.
  Client --> CFR009 : Use a single dashboard for all financial info.
  Client --> CFR10 : Control data sharing with advisors.

}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: Review Predictive Analytics to Guide Financial Consultations" as FAFR003

  FinancialAdvisor --> FAFR001 : Schedule mentoring sessions using insights.
  FinancialAdvisor --> FAFR002 : Act on client alerts for proactive support.
  FinancialAdvisor --> FAFR003 : Use predictive data in consultations.

}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters to Ensure Algorithm Accuracy and Compliance" as SAFR001
  SystemAdmin --> SAFR001 : Adjust parameters for AI accuracy and regulatory compliance.
}

rectangle "AI Component (AIFR)" {
  usecase "AIFR001: Generate Financial Predictions Based on Historical Data, Market Trends, etc." as AIFR001
  usecase "AIFR002: Provide Personalized Recommendations Using User Profiles and Goals" as AIFR002
  usecase "AIFR003: Issue Spending Limit Alerts for Unusual Activity Detection" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities Against Risk Tolerance and Portfolio Strategies" as AIFR004
  usecase "AIFR005: Identify Financial Instruments Aligning with User's Investment Goals (MPT)" as AIFR005
  usecase "AIFR006: Detect Anomalous Transactions Using Pattern Recognition for Fraud Prevention" as AIFR006
  usecase "AIFR007: Correlate News to Client Portfolios for Relevant Insights" as AIFR007
  usecase "AIFR008: Recommend Interventions Based on Predictive Analysis of Financial Behavior" as AIFR008
  usecase "AIFR009: Offer Forward-Looking Analytical Support to Enhance Client Guidance" as AIFR009

}

rectangle "System (SFR)" {
  usecase "SFR001: Deliver Alerts Through Appropriate Channels for Critical Financial Events" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on User Profiles and Preferences" as SFR002
  usecase "SFR003: Request Predictive Analysis from AI Component (AIFR)" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AIFR" as SFR004
  usecase "SFR005: Trigger Spending Limit Alerts When User Exceeds Thresholds via AIFR" as SFR005
  usecase "SFR006: Identify Investment Opportunities Based on Risk Profiles and Criteria (ESG)" as SFR006
  usecase "SFR007: Request Specific Investments Matching Client's ESG Preferences from AIFR" as SFR007
  usecase "SFR008: Detect Anomalous Transactions via AIFR for Compliance with AML Standards (FinCEN)" as SFR008
  usecase "SFR009: Extract Relevant News Contextualized to Client Portfolios from AI Component" as SFR009
  usecase "SFR010: Generate Dashboards Presenting Financial Information in an Actionable Format" as SFR010
  usecase "SFR011: Ensure Timely Notifications Based on Predefined Conditions for Users (Client Alerts)" as SFR011
  usecase "SFR012: Provide Client Analytics to Track Performance and Behavior" as SFR012
  usecase "SFR013: Request Predictive Intervention Analyses from AIFR to Engage Advisors at Optimal Times" as SFR013
  usecase "SFR014: Generate Financial Health Reports Based on Standard Metrics (e.g., Ratios)" as SFR014
  usecase "SFR015: Track User Progress Towards Financial Goals and Provide Recommendations" as SFR015
  usecase "SFR016: Maintain Historical Records of Insights for Trend Analysis" as SFR016

}

rectangle "Client-System Interface (CS)" {
  Client --> AIFR : Request financial predictions, recommendations, etc.
  Client --> SFR : Receive system-generated content via notifications or dashboards.

}

@enduml