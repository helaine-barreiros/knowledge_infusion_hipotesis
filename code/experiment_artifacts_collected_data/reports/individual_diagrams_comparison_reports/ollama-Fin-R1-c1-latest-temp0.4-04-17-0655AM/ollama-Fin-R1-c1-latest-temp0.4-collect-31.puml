@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004

  client --> CFR001 : View Financial Insights Dashboard  
  sysAdmin --> SAFR001 : Manage System Parameters  
  financialAdvisor --> FAFR004 : Configure Analysis Parameters  

}

rectangle "Client" {
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003  
  usecase "CFR004: Personalized Recommendations Based on Profile" as CFR004  
  usecase "CFR005: Manage Recommendation Preferences" as CFR005  
  usecase "CFR006: Spending Limit Alerts for Budget Control" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007 
  usecase "CFR008: Access News Related to Portfolio" as CFR008  
  usecase "CFR009: Personalized Dashboard for Financial Monitoring" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10  

}

rectangle "Financial Advisor" {
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002  
  usecase "FAFR003: Predictive Analytics for Clients" as FAFR003
  client --> FAFR002 : Receive Interventions  
}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001

}
@enduml