@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR009: Generate Contextualized News Insights" as AIFR009

  // Clients (User)
  actor Client1 as UserClient {
    -> CFR001 : View Financial Dashboard
    -> FAFR002 : Receive Alerts
    -> SFR003 : Request Predictions
    -> SAFR001 : Manage Parameters? Not directly, but via System Admin?
    -> AIFR009 : Contextualized News Insights
  }

  // Financial Advisors (FA)
  actor FA as FAFR002User {
    -> FAFR002: View Alerts
    -> FAFR003: Predictive Analytics
    -> SFR015: Request Intervention Analyses
    -> AIFR008: Client Predictions
  }

  // System Administrator (SysAdmin)
  actor SysAdmin as Admin {
    -> SAFR001 : Manage Parameters
    -> CFR003: View Predictions? Not directly, but via client?
  }
  
  // System Components
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "AIFR005: Generate Investment Opportunities for Users" as AIFR005

  SysAdmin --> SAFR001 : Manage Parameters (indirect)
  
}

@enduml