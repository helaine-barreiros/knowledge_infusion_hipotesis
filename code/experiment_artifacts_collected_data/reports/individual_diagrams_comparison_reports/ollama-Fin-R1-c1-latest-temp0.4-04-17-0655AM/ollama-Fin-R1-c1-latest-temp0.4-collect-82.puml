@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  usecase "CFR006: Manage Spending Limit Alerts" as CFR006
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  usecase "SFR008: Request Investment Opportunity Analysis from AI Component" as SFR008
  usecase "FAFR002: View Client Intervention Alerts Based on System-Generated Insights" as FAFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "SFR014: Generate Client Analytics for Financial Behavior and Performance" as SFR014
}

actor "Client" as client
actor "Financial Advisor (FA)" as fa
actor "System Administrator (SA)" as sa

client --> CFR001 : View financial insights dashboard
sa -> SAFR001 : Manage analysis parameters
fa -> FAFR003 : Review predictive analytics for clients
client -> SFR002 : Receive personalized recommendations
client -> CFR006 : Monitor spending limit alerts
AIFR001 --> client : Provide financial predictions
SFR008 --> AIFR004 : Request investment opportunity analysis
fa -> FAFR002 : Review client intervention alerts
cfra003 --> client : Present financial predictions based on data and trends
client -> SFR014 : Access client analytics

@enduml