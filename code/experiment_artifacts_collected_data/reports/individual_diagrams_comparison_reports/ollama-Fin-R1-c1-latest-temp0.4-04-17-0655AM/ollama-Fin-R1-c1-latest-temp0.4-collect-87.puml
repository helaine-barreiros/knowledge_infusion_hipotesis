@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor FinancialAdvisor as fa1
actor SysAdmin as sa1
system SFR021: "System" as sfr

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as cfr001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as cfr002
  usecase "CFR003: View Financial Predictions" as cfr003
  usecase "CFR004: Personalized Recommendations Based on Profile" as cfr004
  usecase "CFR005: Manage Recommendation Preferences" as cfr005
  usecase "CFR006: View Spending Limit Alerts" as cfr006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as cfr007
  usecase "CFR008: Receive News Related to Portfolio" as cfr008
  usecase "CFR009: View Consolidated Financial Dashboard" as cfr009
  usecase "CFR10: Manage Relationship with Advisors" as cfr10

  Client --> CFR001 : c1
}

rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage Mentorship Sessions Based on Insights" as fafr001
  usecase "FAFR002: View Intervention Alerts for Clients" as fafr002
  usecase "FAFR003: Review Predictive Analytics of Client Situations" as fafr003

  FinancialAdvisor --> FAFR001 : fa1
}

rectangle "System Administrator Interface" {
  usecase "SAFR001: Manage Analysis Parameters for AI System" as safr001

  SysAdmin --> SAFR001 : sa1
}

sfr <|-- cfr001
sfr <|-- cfr002
sfr <|-- cfr003
sfr <|-- cfr004
sfr <|-- cfr005
sfr <|-- cfr006
sfr <|-- cfr007
sfr <|-- cfr008
sfr <|-- cfr009
sfr <|-- cfr10

sfr <|-- fafr001
sfr <|-- fafr002
sfr <|-- fafr003

sfr <|-- safr001

@enduml