@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: View Alerts About Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with Your Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations to Align With KYC Data" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds in Expense Categories" as CFR006
  usecase "CFR007: Access Investment Opportunities Suitable To Your Risk Profile (Under MiFID II)" as CFR007
  usecase "CFR008: Receive News Related to Your Investment Portfolio From Trusted Sources" as CFR008
  usecase "CFR009: View Consolidated Financial Information in a Personalized Dashboard" as CFR010
  usecase "SAFR001: Manage Analysis Parameters for AI System Compliance With Basel III and Other Regs." as SAFR001
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts When Patterns Require Professional Attention" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations For Consultations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments To Customize System Behavior Per Regulatory Requirements (GDPR, CCPA)" as FAFR004
}

actor "Client" as Client {
  --> CFR001 : View Financial Insights Dashboard\nView Alerts About Anomalous Transactions\nView Financial Predictions Based on Historical Data and Market Trends\nReceive Personalized Recommendations Aligned with Your Financial Profile\nManage Preferences for Personalized Recommendations to Align With KYC Data\nView Spending Limit Alerts When Exceeding Predefined Thresholds in Expense Categories\nAccess Investment Opportunities Suitable To Your Risk Profile (Under MiFID II)\nReceive News Related to Your Investment Portfolio From Trusted Sources\nView Consolidated Financial Information in a Personalized Dashboard
}

actor "Financial Advisor" as FAdvisor {
  --> CFR010 : Manage Client Mentoring Sessions Based on System-Generated Insights\nView Client Intervention Alerts When Patterns Require Professional Attention\nView Predictive Analytics About Clients' Financial Situations For Consultations\nConfigure Analysis Parameters for Specific Client Segments To Customize System Behavior Per Regulatory Requirements (GDPR, CCPA)
}

actor "System Administrator" as SysAdmin {
  --> SAFR001 : Manage Analysis Parameters for AI System Compliance With Basel III and Other Regs.
}

@enduml