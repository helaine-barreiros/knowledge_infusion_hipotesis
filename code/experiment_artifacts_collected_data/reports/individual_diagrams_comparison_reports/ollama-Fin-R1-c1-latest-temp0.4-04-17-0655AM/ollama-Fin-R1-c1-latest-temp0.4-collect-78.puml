@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Alert Preferences" as SAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Manage Relationship with Advisors" as CFR009
  
  actor Client as c1 {
    --> CFR001 : "View Financial Insights Dashboard"
    --> CFR002 : "Receive Alerts for Anomalous Transactions (FATF)"
    --> CFR003 : "View Financial Predictions"
    --> CFR004 : "Receive Personalized Recommendations"
    --> CFR005 : "Manage Recommendation Preferences"
    --> CFR006 : "View Spending Limit Alerts"
    --> CFR007 : "View Investment Opportunities (MiFID II)"
    --> CFR008 : "Access News Related to Portfolio"
    --> CFR009 : "Manage Relationship with Advisors"
  }
  
  actor SysAdmin as s1 {
    --> SAFR001
  }
  
  actor FinancialAdvisor as f1 {
    --> FAFR002: "View Client Intervention Alerts (AML)"
    --> FAFR003: "View Predictive Analytics for Clients"
    --> FAFR004: "Configure Analysis Parameters by Segment"
    --> AIFR006
  }
  
  actor System as s {
    usecase "SFR001: Deliver Alerts" 
    usecase "SFR002: Provide Personalized Recommendations"
    usecase "SFR003: Request Financial Predictions from AI"
    usecase "SFR004: Request Personalized Recommendations from AI"
    usecase "SFR005: Request Spending Limit Alerts from AI"
    usecase "SFR006: Request Investment Opportunity Analysis from AI"
    usecase "SFR007: Find Specific Investment Opportunities (ESG)"
    usecase "SFR008: Request Anomaly Transaction Alerts (AML)"
    usecase "SFR009: Generate Contextualized News Insights"
    usecase "SFR010: Process Contextualized News for Portfolios"
    usecase "SFR012: Generate Client Dashboards"
    usecase "SFR013: Generate Client Alerts Based on Conditions"
    usecase "SFR014: Provide Financial Analytics"
    usecase "SFR015: Request Predictive Intervention Analyses from AI"
    usecase "SFR016: Enhance Value of Financial Guidance via AI Insights"
    usecase "SFR017: Generate Financial Health Reports (Standard Metrics)"
    usecase "SFR018: Manage User Financial Goals"
    usecase "SFR019: Maintain Historical Record for Trend Analysis"
    usecase "SFR020: Manage User Feedback to Improve Insights"

    --> CFR004
  }
  
  actor AIFR as a {
    usecase "AIFR003: Generate Spending Limit Alerts" 
    usecase "AIFR005: Identify Investment Opportunities (MPT)" 
    usecase "AIFR006: Detect Anomalies for Fraud Prevention"
    usecase "AIFR007: Correlate News with Portfolios"
    usecase "AIFR008: Recommend Predictive Interventions to Advisors"

    --> CFR003
  }
  
}

@enduml