@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "SFR005: Request Spending Limit Alerts from AI Component" as SFR005
  usecase "AIFR003: Generate Spending Limit Alerts for Users" as AIFR003
  usecase "CFR010: Manage Relationship with Financial Advisors" as CFR010
  usecase "SFR004: Request Personalized Recommendations from AI Component Based on User Data and Preferences" as SFR004
  usecase "AIFR002: Generate Personalized Recommendations for Users" as AIFR002
  usecase "CFR009: View Consolidated Financial Dashboard" as CFR009
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "AIFR008: Generate Client Predictive Intervention Recommendations" as AIFR008
  usecase "SFR015: Request Predictive Interventions from AI Component to Engage Advisors with Clients" as SFR015
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component in Compliance with AML Regulations" as SFR008
  usecase "AIFR006: Generate Anomaly Transaction Alerts Using Pattern Recognition" as AIFR006
  usecase "CFR013: Manage User Feedback to Improve System Accuracy" as CFR013
  usecase "SFR020: Maintain Historical Record of Insights for Trend Analysis" as SFR020
}

actor Client as C
actor FinancialAdvisor as FA
actor SysAdmin as SA

C --> CFR001 : View financial insights dashboard
C --> CFR006 : Receive spending limit alerts
C --> CFR009 : Access consolidated financial dashboard
C --> CFR004 : Get personalized recommendations aligned with profile and goals
C --> SAFR005 : Request spending limit alerts from AI component (via system)
C --> SFR012 : Use generated client dashboards

FA --> FAFR003 : View predictive analytics for clients during consultations
FA --> AIFR008 : Get client predictive intervention recommendations to proactively assist clients

SA --> SAFR001 : Manage analysis parameters (system admin)
SA --> FAFR004 : Configure analysis parameters for specific segments

SysAdmin -> System: "Manage system operations and ensure compliance"
System <|-- AIFR001, AIFR002, AIFR003, AIFR006, AIFR008
Client <|-- CFR001, SAFR005 (via SFR)
FinancialAdvisor <|-- FAFR004, FAFR008

@enduml