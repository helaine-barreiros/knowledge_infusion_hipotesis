@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  usecase "CFR011: Send Feedback to System" as CFR011

  Client --> CFR001 : View financial data and insights.
  SysAdmin -> SAFR001 : Manage system parameters (e.g., compliance, accuracy).
  
  // Financial Advisor interactions:
  FAFR002 <|-- (Client) via "View Alerts" 
  FAFR003 <|-- (Client) via "Analyze Client Situations"
  FAFR004 <|-- (Client) via "Configure Analysis Parameters"

  // System to AI Component requests:
  SFR003 --> AIFR001 : Request financial predictions.
  SFR004 --> AIFR002 : Request personalized recommendations.

  Client -> CFR001
  SysAdmin -->> SAFR001

}

@enduml