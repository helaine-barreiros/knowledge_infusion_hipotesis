@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as C
actor SysAdmin as SA
actor FinancialAdvisor as FA
system "System" as S

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile (MiFID II)" as CFR007
  usecase "CFR008: Access News Related to Financial Portfolio" as CFR008
  usecase "CFR009: Manage Relationship with Financial Advisors, Including Data Sharing Permissions" as CFR009
}

rectangle "System Administrator Functions" {
  usecase "SAFR001: Manage Analysis Parameters for AI System Compliance" as SAFR001
}

rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts from System" as FAFR002
  usecase "FAFR003: View Predictive Analytics for Clients' Financial Situations" as FAFR003
}

rectangle "System Core Functions" {
  usecase "SFR001: Deliver Alerts to Users via Notification Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts From AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis for Users Based on Risk Profiles" as SFR006
  usecase "SFR007: Find Specific Investment Opportunities Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Detect Anomalous Transactions via AI Component in Compliance with AML Regulations" as SFR008
  usecase "SFR009: Extract Relevant Financial News for Users' Portfolios From Trusted Sources" as SFR009
  usecase "SFR010: Generate Client Dashboards Consolidating Financial Information" as SFR010
  usecase "SFR013: Request Contextualized News Insights from AI Component" as SFR013
}

rectangle "AI System Functions" {
  usecase "AIFR001: Generate Financial Predictions Using Historical Data and Market Trends" as AIFR001
  usecase "AIFR002: Create Personalized Recommendations Based on User Profiles" as AIFR002
  usecase "AIFR003: Identify Spending Limit Alerts for Unusual Deviations in Spends" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities Against Risk Tolerance and Goals" as AIFR004
  usecase "AIFR005: Select Financial Instruments Aligning with User Strategies (MPT)" as AIFR005
  usecase "AIFR006: Detect Anomalous Transactions Using Pattern Recognition Techniques" as AIFR006
}

rectangle "User Feedback Management" {
  usecase "CFR011: Send System Recommendations/Insights Feedback for Improvement" as CFR011
}

C --> CFR001 : View Financial Insights Dashboard  
C --> CFR002 : Receive Alerts for Anomalous Transactions  
C --> CFR003 : View Financial Predictions Based on Historical Data and Market Trends  
C --> CFR004 : Receive Personalized Recommendations Aligned with Financial Profile  
C --> CFR005 : Manage Preferences for Personalized Recommendations  
C --> CFR006 : View Spending Limit Alerts When Exceeding Predefined Thresholds  
C --> CFR007 : View Investment Opportunities Based on Risk Profile (MiFID II)  
C --> CFR008 : Access News Related to Financial Portfolio  
C --> CFR009 : Manage Relationship with Financial Advisors, Including Data Sharing Permissions  

SA --> SAFR001 : Manage Analysis Parameters for AI System Compliance  

FA --> FAFR001 : Manage Client Mentoring Sessions Based on Insights  
FA --> FAFR002 : View Client Intervention Alerts from System  
FA --> FAFR003 : View Predictive Analytics for Clients' Financial Situations  

S --> SFR001 : Deliver Alerts to Users via Notification Channels  
S --> SFR002 : Provide Personalized Recommendations Based on Profiles  
S --> SFR003 : Request Financial Predictions from AI Component  
S --> SFR004 : Request Personalized Recommendations from AI Component  
S --> SFR005 : Request Spending Limit Alerts From AI Component  
S --> SFR006 : Request Investment Opportunity Analysis for Users Based on Risk Profiles  
S --> SFR007 : Find Specific Investment Opportunities Matching User Criteria and ESG Preferences  
S --> SFR008 : Detect Anomalous Transactions via AI Component in Compliance with AML Regulations  
S --> SFR009 : Extract Relevant Financial News for Users' Portfolios From Trusted Sources  
S --> SFR010 : Generate Client Dashboards Consolidating Financial Information  

AIFR001 <<|-- (S) : Generates financial predictions requested by system.  
AIFR002 <<|-- (S) : Creates personalized recommendations aligned with user profiles for the system to deliver.  
AIFR003 <<|-- (SFR005) : Identifies spending limit alerts triggered when thresholds are exceeded, notified via SFR001.  

CFR011 --> S : Send feedback about system outputs to improve future accuracy and relevance.

@enduml