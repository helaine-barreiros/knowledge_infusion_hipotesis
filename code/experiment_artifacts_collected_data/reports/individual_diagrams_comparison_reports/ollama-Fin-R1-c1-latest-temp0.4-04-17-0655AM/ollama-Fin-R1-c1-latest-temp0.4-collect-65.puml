@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR006: Manage Spending Limit Alerts" as SAFR006
  usecase "SFR012: Generate Client Dashboards" as SFR012

  client --> CFR001 : "View financial insights"
  client --> SAFR006 : "Manage spending limit alerts"
  client --> SFR012 : "Access consolidated financial info"

  systemAdmin --> SAFR006 : "Configure analysis parameters for security and compliance"

  advisor --> FAFR003 : "View predictive analytics about clients' situations"
  advisor --> FAFR004 : "Manage specific client segments' analysis settings"
}

rectangle "AI System" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Personalized Recommendations" as AIFR002
  usecase "AIFR003: Spending Limit Alerts" as AIFR003

  system --> AIFR001 : "Request financial predictions"
  system --> AIFR002 : "Request personalized recommendations"
  system --> AIFR003 : "Generate spending limit alerts"

  client --> AIFR001 : "Receive financial insights"
}

rectangle "Client" {
  actor Client as c
}
actor SystemAdmin as sa
actor Advisor as a

@enduml