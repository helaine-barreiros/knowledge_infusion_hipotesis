@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as C
actor SysAdmin as SA
actor FinancialAdvisor as FA
system "System" as S

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Data and Trends" as CFR003
  usecase "CFR004: Access Personalized Recommendations Aligned with Profile" as CFR004
  usecase "CFR005: Manage Recommendation Preferences in KYC Context" as CFR005
  usecase "CFR006: View Spending Limit Alerts Exceeding Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Matching Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Portfolio" as CFR008
  usecase "CFR009: Manage Personalized Dashboard for Financial Monitoring" as CFR009
  usecase "CFR10: Control Data Sharing with Advisors" as CFR10

}

rectangle "System Admin Interface" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
}

rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Schedule Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: Review Predictive Analytics About Clients' Situations" as FAFR003
}

rectangle "System Core Functions (S)" {
  usecase "SFR001: Deliver Alerts Through Notification Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AI Component" as SFR004
  usecase "SFR005: Monitor Spending Limits Against Defined Thresholds" as SFR005
  usecase "SFR006: Identify Investment Opportunities Based on Risk Profiles" as SFR006
  usecase "SFR007: Find Specific Investments Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Detect Anomalous Transactions for AML Compliance" as SFR008
  usecase "SFR009: Extract Contextualized News Relevant to Portfolios" as SFR009
  usecase "SFR010: Process Contextualized News Insights" as SFR010
  usecase "SFR012: Generate Client Dashboards for Financial Monitoring" as SFR012
  usecase "SFR013: Issue Predefined Alerts Based on Conditions" as SFR013
  usecase "SFR014: Produce Client Analytics for Insights" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses from AI Component" as SFR015
  usecase "SFR016: Enhance Financial Guidance with Predictive Insights" as SFR016
  usecase "SFR017: Generate Financial Health Reports Using Standard Metrics" as SFR017
}

rectangle "AI System (AIFR)" {
  usecase "AIFR001: Analyze Historical Data for Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations Based on Profiles and Goals" as AIFR002
  usecase "AIFR003: Identify Spending Limit Alerts via Pattern Recognition" as AIFR003
  usecase "AIFR004: Evaluate Investment Opportunities Against Risk Tolerance" as AIFR004
  usecase "AIFR005: Recommend Financial Instruments Based on Portfolio Theory" as AIFR005
  usecase "AIFR006: Detect Anomalous Transactions Using Pattern Recognition" as AIFR006
  usecase "AIFR007: Correlate News with Portfolios for Relevant Insights" as AIFR007
  usecase "AIFR008: Identify Patterns Requiring Advisor Engagement Proactively" as AIFR008
}

use C --> CFR001 : "View Financial Dashboard"
C --> CFR002 : "Receive Alerts on Anomalous Transactions"
C --> CFR003 : "View Predictions Based on Data and Trends"
C --> CFR004 : "Access Personalized Recommendations"
