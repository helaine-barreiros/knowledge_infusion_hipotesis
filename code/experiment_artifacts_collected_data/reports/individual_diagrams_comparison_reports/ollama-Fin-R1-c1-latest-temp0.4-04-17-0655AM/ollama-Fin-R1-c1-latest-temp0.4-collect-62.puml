@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Personalized Recommendations Based on Profile" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidated Personalized Dashboard" as CFR010
  usecase "SAFR002: Manage Client Mentoring Sessions" as SAFR002
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "SFR009: Contextualized News Based on Portfolio" as SFR009

  actor "Client" as Client
  actor "Financial Advisor" as FinancialAdvisor
  actor "System Administrator" as SysAdmin
  
  Client --> CFR001 : View dashboard
  Client --> CFR002 : Receive alerts (FATF)
  Client --> CFR003 : Predictions based on data and trends
  Client --> CFR004 : Personalized recommendations aligned with profile goals
  Client --> CFR005 : Manage preferences for recommendations
  Client --> CFR006 : Spending limit alerts when exceeding thresholds
  Client --> CFR007 : Investment opportunities matching risk profile (MiFID II)
  Client --> CFR008 : News related to portfolio
  Client --> CFR010 : Consolidated personalized dashboard

  SysAdmin --> SAFR001 : Manage analysis parameters for compliance (Basel III)

  FinancialAdvisor --> FAFR002: Manage client mentoring sessions based on insights
  FinancialAdvisor --> FAFR003: View predictive analytics about clients' financial situations during consultations
  FinancialAdvisor --> SFR009: Contextualized news relevant to portfolio

}

@enduml