@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "SFR009: Request Contextualized News from AI Component" as SFR009
  usecase "CFR002: Receive Alerts About Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Receive Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Personalized Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: View Investment Opportunities Suitable to Risk Profile" as CFR007
  usecase "CFR008: Access Personalized Dashboard for Consolidated Financial Information" as CFR008
  usecase "CFR010: Manage Relationship with Financial Advisors Including Data Sharing Permissions" as CFR010

  rectangle "Client" {
    client "User (Client)" as Client
    user --> CFR001 : View financial insights dashboard
    user --> CFR002 : Receive alerts about anomalous transactions
    user --> CFR003 : View financial predictions based on historical data and market trends
    user --> CFR004 : Receive personalized recommendations aligned with profile
    user --> CFR005 : Manage preferences for personalized recommendations
    user --> CFR006 : View spending limit alerts when exceeding thresholds
    user --> CFR007 : View investment opportunities suitable to risk profile
    user --> CFR008 : Access consolidated financial information dashboard
  }

  rectangle "Financial Advisor" {
    advisor as FAFR001: Manage client mentoring sessions based on system-generated insights
    advisor as FAFR002: View client intervention alerts when patterns detected requiring attention
    advisor as FAFR003: View predictive analytics about clients' financial situations for recommendations during consultations
  }

  rectangle "System Administrator" {
    sysadmin --> SAFR001 : Manage analysis parameters ensuring compliance with regulations like Basel III and FATF standards
  }

  usecase "AIFR009: Generate Client Predictive Intervention Recommendations Based on Patterns in Data" as AIFR009

  user <|-- (Client)
  advisor <|-- FAFR001
  sysadmin <|-- SAFR001
}

@enduml