@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "SFR008: Request AML-Compliant Transaction Alerts" as SFR008
  usecase "FAFR004: Configure Analysis Parameters for Client Segments" as FAFR004
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "SFR012: Generate Personalized Dashboards" as SFR012
  usecase "AIFR001: Generate Financial Predictions Using AI" as AIFR001
  usecase "CFR004: Receive Personalized Recommendations Based on Financial Profile" as CFR004
  usecase "SFR009: Find Contextualized News Relevant to Portfolio" as SFR009
  usecase "FAFR002: View Client Intervention Alerts from System" as FAFR002
  usecase "CFR005: Manage Personalized Recommendation Preferences via KYC Profile" as CFR005
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "AIFR006: Identify Investment Opportunities Using AI" as AIFR006
  usecase "CFR007: View Suitable Investments Based on Risk Profile" as CFR007
  usecase "SFR020: Manage User Feedback to Improve Insights" as SFR020
  usecase "AIFR008: Generate Predictive Intervention Recommendations Using AI" as AIFR008
  usecase "CFR011: Send System Feedback for Continuous Improvement" as CFR011

  actor Client as C
  actor FinancialAdvisor as FA
  actor SysAdmin as SA
  
  
  C --> CFR001 : View financial insights dashboard\n(CFR002)
  C --> SFR013 : Manage alerts (SFR008)\n(SAFR001, FAFR004)
  C --> AIFR009 : Generate predictive insights using AI\n(AIFR007)
  
  SA --> SAFR001: Configure analysis parameters for system
  
  FA --> FAFR003: View client-specific analytics (AIFR008)\n(FAFR002, AIFR006)
}

@enduml