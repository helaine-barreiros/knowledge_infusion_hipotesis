@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sas
actor FinancialAdvisor as faa
system "System" as sys

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Personalized Recommendations Based on Profile" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Spending Limit Alerts for Budget Control" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Personalized Dashboard for Financial Monitoring" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10

  c1 --> CFR001 : View dashboard  
  c1 --> CFR002 : Receive alerts  
  c1 --> CFR003 : Predictions  
  c1 --> CFR004 : Recommendations  
  c1 --> CFR005 : Manage preferences  
  c1 --> CFR006 : Spending limits  
  c1 --> CFR007 : Investment opportunities  
  c1 --> CFR008 : News  
  c1 --> CFR009 : Consolidated view  
  c1 --> CFR10 : Relationship management
}

rectangle "System Administrator Interface" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001

  sas --> SAFR001 : Configure parameters for accuracy and compliance
}
 
rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001  
  usecase "FAFR002: View Intervention Alerts" as FAFR002  
  usecase "FAFR003: Predictive Analytics for Clients" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004

  faa --> FAFR001 : Schedule sessions  
  faa --> FAFR002 : Review alerts  
  faa --> FAFR003 : Analyze trends  
  faa --> FAFR004 : Customize parameters
}

rectangle "System (SFR)" {
  usecase "SFR001: Deliver Alerts" as SFR001
  usecase "SFR002: Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions" as SFR003  
  usecase "SFR004: Request Personalized Recommendations" as SFR004
  usecase "SFR005: Spending Limit Alerts" as SFR005
  usecase "SFR006: Investment Opportunity Analysis" as SFR006  
  usecase "SFR007: Specific Investment Opportunities Based on Criteria and ESG Preferences" as SFR007  
  usecase "SFR008: Anomaly Transaction Alerts for AML Compliance" as SFR008
  usecase "SFR009: Contextualized News Relevant to Portfolio" as SFR009  
  usecase "SFR010: Client Dashboards" as SFR010  
  usecase "SFR011: Process Contextualized News for Users" as SFR011
  usecase "SFR012: Financial Health Reports Based on Standard Metrics" as SFR012
  usecase "SFR013: Client Analytics" as SFR013  
  usecase "SFR014: Predictive Intervention Analysis for Advisor Engagement Timing" as SFR014 
  usecase "SFR015: Generate Financial Goals Progress Tracking" as SFR015
  usecase "SFR016: Historical Record Management of Insights" as SFR017  
  usecase "SFR018: User Feedback Processing for Improvement" as SFR019  

  sys --> (all SFR cases) : Execute system functionalities
}

rectangle "AI System Interface (AIFR)" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001  
  usecase "AIFR002: Personalized Recommendations Based on Profile and Risk Tolerance" as AIFR002
  usecase "AIFR003: Spending Limit Alerts for Anomalies" as AIFR003
  usecase "AIFR004: Investment Opportunity Analysis Matching User Profiles" as AIFR004  
  usecase "AIFR005: Align Investments with Modern Portfolio Theory Principles" as AIFR005 
  usecase "AIFR006: Anomaly Transaction Alerts Based on Pattern Recognition" as AIFR006
  usecase "AIFR007: Contextualized News Insights for Portfolios" as AIFR007  
  usecase "AIFR008: Predictive Intervention Recommendations Timing" as AIFR008 
  usecase "AIFR009: Forward-Looking Financial Analysis for Advisors" as AIFR009  

  sys --> (all AI cases) : Provide data and generate insights
}

usecase "CFR11: Send Feedback to System" as CFR11

c1, faa, sas -> CFR11 : Provide feedback  
@enduml