@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "AIFR001: Generate Financial Predictions for Users" as AIFR001
  usecase "CFR011: Send Feedback to System" as CFR011

  Client --> CFR001 : View financial data and insights  
  SysAdmin --> SAFR001 : Manage analysis parameters  
  User --> FAFR002 : Receive alerts about potential fraud or unusual spending  
  SFR003 <|-- AIFR001: Request predictions from AI Component
  SFR004 <|-- AIFR002: Request recommendations based on user profile
  Client --> CFR005: Manage personalized recommendation preferences (not directly linked here)
}

@enduml