@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR002: View Client Intervention Alerts" as FAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "SAFR002: Deliver Alerts Through Notification Channels" as SAFR002
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "FAFR004: Configure Analysis Parameters for Specific Segments" as FAFR004
  usecase "SFR008: Request Anomaly Transaction Alerts from AI Component" as SFR008
  usecase "CFR012: Generate Client Dashboards" as CFR012
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "AIFR009: Generate Client Predictive Insights" as AIFR009

  
  actor "Client" as clientActor {
    CFR001 --> SAFR002 : Request Financial Data Presentation
    CFR004 --> SAFR002 : Receive Recommendations
    CFR005 --> SFR008 : Adjust Preferences
    CFR006 --> AIFR003: Monitor Spending Limits
  }

  actor "Financial Advisor" as advisorActor {
    FAFR001 --> AIFR009: Schedule Mentoring Sessions  
    FAFR002 --> SFR014 : Review Intervention Alerts 
    FAFR003 --> AIFR008: Analyze Predictive Interventions
  }

  actor "System Administrator" as adminActor {
    SAFR001 --> AIFR007: Adjust AI System Parameters  
  }
}

@enduml