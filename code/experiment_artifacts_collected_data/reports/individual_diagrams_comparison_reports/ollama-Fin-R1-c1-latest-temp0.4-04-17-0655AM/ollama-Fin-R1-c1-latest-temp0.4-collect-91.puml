@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Personalized Recommendations Based on Profile" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts" as CFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Personalized Dashboard for Financial Monitoring" as CFR010
  usecase "SAFR002: Manage Client Mentoring Sessions" as SAFR002
  usecase "FAFR001: View Intervention Alerts from System" as FAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "SFR001: Deliver User Notifications" as SFR001
  usecase "AIFR001: Generate Financial Predictions" as AIFR001

  Client --> CFR001 : View dashboard with financial data
  SysAdmin -> SAFR001 : Manage analysis parameters for system accuracy and compliance
  Client -> CFR002 : Receive alerts about anomalous transactions per FATF regulations
  Client -> CFR003 : Get forward-looking insights based on historical and market trends
  Client -> CFR004 : Personalized recommendations aligned with financial goals, risk tolerance (KYC)
  Client -> CFR005 : Adjust personalization settings for relevance to financial objectives
  Client -> CFR006 : Alerts when exceeding spending limits in specific categories
  Client -> CFR007 : Suitable investment opportunities based on risk profile and ESG criteria
  Client -> CFR008 : Stay informed about market events affecting investments via news feed
  Client -> CFR010 : Consolidated view of financial information for efficient monitoring
  SysAdmin -> SAFR002 : Schedule mentoring sessions with clients using system-generated insights
  FAFR001 --> Client : Alerts when client needs professional attention based on system analysis
  FAFR003 --> Client : Data-driven recommendations during consultations
  FinancialAdvisor -> FAFR004 : Customize analysis parameters for specific segments (e.g., risk profiles)
  AIFR001 --> System : Provide financial predictions using transaction, trend data
}

@enduml