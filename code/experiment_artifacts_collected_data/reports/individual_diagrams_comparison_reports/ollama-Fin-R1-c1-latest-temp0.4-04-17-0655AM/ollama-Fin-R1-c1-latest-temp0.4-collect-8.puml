@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor FinancialAdvisor as fa1
actor SysAdmin as sa1

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "SFR002: Deliver Personalized Recommendations to Users" as SFR002
  usecase "AIFR005: Generate Investment Opportunities Based on Risk Profiles" as AIFR005

  c1 --> CFR001 : "View Financial Insights Dashboard"
  fa1 --> FAFR003 : "View Predictive Analytics for Clients"
  sa1 --> SAFR001 : "Manage Analysis Parameters"

  Client <|-- (CFR001)
  SysAdmin <|-- (SAFR001)
}

rectangle "Client" {
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Get Personalized Recommendations" as CFR004
  usecase "CFR011: Send Feedback to System" as CFR011

  c1 --> CFR002 : "Receive Alerts on Anomalous Transactions"
  c1 --> CFR003 : "View Financial Predictions"
  c1 --> CFR004 : "Get Personalized Recommendations"
}

rectangle "FinancialAdvisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System Insights" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Clients in Need of Attention" as FAFR002

  fa1 --> FAFR001 : "Manage Client Mentoring"
}

rectangle "SysAdmin" {
  usecase "SFR009: Generate Contextualized News Relevant to Users' Portfolios" as SFR009
  usecase "AIFR006: Detect Anomaly Transaction Alerts Based on Patterns" as AIFR006

  sa1 --> SFR009 : "Generate Contextualized News"
}

rectangle "System" {
  usecase "SFR012: Generate Client Dashboards" as SFR012
  usecase "AIFR003: Identify Spending Limit Alerts Based on User Activity" as AIFR003

  SysAdmin <|-- (SAFR001)
}

@enduml