@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sas
actor FinancialAdvisor as faa
system "System" as sys

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Data and Trends" as CFR003
  usecase "CFR004: Personalized Recommendations Aligned with Profile" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts for Budget Control" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidated Personalized Dashboard for Monitoring Finances" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10

  c1 --> CFR001 : View dashboard
  c1 --> CFR002 : Receive alerts
  c1 --> CFR003 : Predictions based on data and trends
  c1 --> CFR004 : Personalized recommendations
  c1 --> CFR005 : Manage preferences
  c1 --> CFR006 : Spending limit alerts
  c1 --> CFR007 : Investment opportunities
  c1 --> CFR008 : News related to portfolio
  c1 --> CFR009 : Consolidated dashboard
  c1 --> CFR10 : Manage relationship

}

rectangle "System Administrator Interface" {
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  
  sas --> SAFR001 : Configure parameters
}
  
rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Clients" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004

  faa --> FAFR001 : Manage sessions
  faa --> FAFR002 : View alerts
  faa --> FAFR003 : Predictive analytics
  faa --> FAFR004 : Configure parameters by segment
}

rectangle "System Functions" {
  usecase "SFR001: Deliver Alerts Through Notification Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Profiles" as SFR002
  usecase "SFR003: Request Financial Predictions from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AI" as SFR004
  usecase "SFR005: Request Spending Limit Alerts From AI" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis from AI" as SFR006
  usecase "SFR007: Request Specific Investments Based on ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts From AI Component" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Portfolio" as SFR009
  usecase "SFR010: Generate Client Dashboards for Financial Monitoring" as SFR010
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013

  sys --> SFR001 : Deliver alerts
  sys --> SFR002 : Provide recommendations
  sys --> SFR003 : Request predictions
  sys --> SFR004 : Request personalized recs
  sys --> SFR005 : Request spending limit alerts
  sys --> SFR006 : Request investment analysis
  sys --> SFR007 : Request ESG investments
  sys --> SFR008 : Request anomaly alerts
  sys --> SFR009 : Find news
  sys --> SFR10 : Generate dashboards
}

rectangle "AI System" {
  usecase "AIFR001: Generate Financial Predictions Based on Data and Trends" as AIFR001
  usecase "AIFR002: Personalized Recommendations Aligned with User Profiles" as AIFR002
  usecase "AIFR003: Spending Limit Alerts for Unusual Activity Detection" as AIFR003
  usecase "AIFR004: Investment Opportunity Analysis Based on Risk Profile" as AIFR004
  usecase "AIFR005: Identify Financial Instruments Aligning with Strategies and MPT Principles" as AIFR005
  usecase "AIFR006: Pattern Recognition for Anomaly Transaction Alerts in Compliance With FinCEN Rules" as AIFR006
  usecase "AIFR007: Contextualized News Insights Correlated with User Portfolios" as AIFR007
  usecase "AIFR008: Predictive Intervention Recommendations for Advisors Based on Client Patterns" as AIFR008

  sys --> AIFR001 : Generate predictions
  sys --> AIFR002 : Personalized recs
  sys --> AIFR003 : Spending limit alerts
  sys --> AIFR004 : Investment analysis
}

@enduml