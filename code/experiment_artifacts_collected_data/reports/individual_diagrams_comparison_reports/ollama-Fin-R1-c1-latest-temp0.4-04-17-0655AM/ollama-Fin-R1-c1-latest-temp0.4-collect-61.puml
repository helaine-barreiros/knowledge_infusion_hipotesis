@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sa
actor FinancialAdvisor as fa
system "System" as s

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Personalized Recommendations Aligned with Financial Profile and Goals" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Investment Portfolio" as CFR008
  usecase "CFR009: Personalized Dashboard Consolidating Financial Information" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors Including Data Sharing Permissions" as CFR10

  c1 --> CFR001 : View dashboard
  c1 --> CFR002 : Receive alerts on transactions
  c1 --> CFR003 : Predictions based on data and trends
  c1 --> CFR004 : Personalized recommendations
  c1 --> CFR005 : Manage preferences
  c1 --> CFR006 : Spending limit alerts
  c1 --> CFR007 : Investment opportunities
  c1 --> CFR008 : Access news
  c1 --> CFR009 : Consolidated dashboard
  c1 --> CFR10 : Manage relationship with advisors

}

rectangle "System Administrator Interface" {
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  
  sa --> SAFR001 : Configure parameters
}
s <|-- (CFR001, CFR002, ..., CFR10)
s <|-- SAFR001

rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Clients Requiring Professional Attention" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters for Specific Client Segments" as FAFR004

  fa --> FAFR001 : Manage mentoring sessions
  fa --> FAFR002 : View intervention alerts
  fa --> FAFR003 : Analyze clients' financials
  fa --> FAFR004 : Configure parameters for segments
}
s <|-- (FAFR001, FAFR002, ..., FAFR004)

rectangle "System Functions" {
  usecase "SFR001: Deliver Alerts Through Notification Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Financial Profiles" as SFR002
  usecase "SFR003: Request Predictive Analysis from AI Component" as SFR003
  usecase "SFR004: Request Personalized Recommendations from AI Component" as SFR004
  usecase "SFR005: Request Spending Limit Alerts From AI Component" as SFR005
  usecase "SFR006: Request Investment Opportunity Analysis From AI Component" as SFR006
  usecase "SFR007: Request Specific Investment Opportunities Based on Risk Profiles and ESG Preferences" as SFR007
  usecase "SFR008: Request Anomaly Transaction Alerts Compliant with AML Regulations" as SFR008
  usecase "SFR009: Find Contextualized News Relevant to Users' Portfolios" as SFR009
  usecase "SFR010: Process Contextualized News for Financial Portfolio Insights" as SFR010
  usecase "SFR011: Request AI-Generated News Insights Based on User Portfolios" as SFR011
  usecase "SFR012: Generate Client Dashboards with Financial Information" as SFR012
  usecase "SFR013: Generate Alerts Based on Predefined Conditions" as SFR013
  usecase "SFR014: Provide Client Analytics for Performance Tracking" as SFR014
  usecase "SFR015: Request Predictive Intervention Analyses From AI Component" as SFR015
  usecase "SFR016: Enhance Financial Guidance With Predictive Insights from AI" as SFR016
  usecase "SFR017: Generate Financial Health Reports Based on Standard Metrics" as SFR017
  usecase "SFR018: Track Users' Financial Goals and Progress" as SFR018
  usecase "SFR019: Maintain Historical Record of Insights for Trend Analysis" as SFR019
  usecase "SFR020: Manage User Feedback to Improve System Outputs" as SFR020

  s --> (SFR001, ..., SFR20)
}

rectangle "AI Component" {
  usecase "AIFR001: Generate Financial Predictions Using Historical Data and Market Trends" as AIFR001
  usecase "AIFR002: Personalized Recommendations Based on User Profiles and Goals" as AIFR002
  usecase "AIFR003: Spending Limit Alerts for Unusual Transactions" as AIFR003
  usecase "AIFR004: Investment Opportunity Analysis Matching Risk Tolerance" as AIFR004
  usecase "AIFR005: Align Investments with Modern Portfolio Theory Principles" as AIFR005
  usecase "AIFR006: Anomaly Transaction Alerts for Fraud Detection in Compliance With FinCEN Rules" as AIFR006
  usecase "AIFR007: Contextualized News Insights Relevant to Portfolios" as AIFR007
  usecase "AIFR008: Predictive Intervention Recommendations Based on User Behavior Patterns" as AIFR008
  usecase "AIFR009: Forward-Looking Financial Analysis for Clients" as AIFR009

  s --> (AIFR001, ..., AIFR09)
}

@enduml