@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sas
actor FinancialAdvisor as faa

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  usecase "FAFR003: View Predictive Analytics for Clients" as FAFR003
  usecase "SFR012: Generate Client Dashboards" as SFR012

  c1 --> CFR001 : "View Financial Insights Dashboard"
  sas --> SAFR001 : "Manage Analysis Parameters"
}

rectangle "Financial Advisor Subsystem" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Anomalous Transactions" as FAFR002
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004

  faa --> FAFR001 : "Manage Client Mentoring Sessions"
  faa --> FAFR002 : "View Intervention Alerts for Anomalous Transactions"
}

rectangle "System Subsystem" {
  usecase "SFR008: Request Investment Opportunity Analysis from AI Component" as SFR008
  usecase "SFR014: Generate Client Analytics" as SFR014

  SysAdmin --> SAFR001 : "Manage Analysis Parameters"
}

rectangle "AI Subsystem" {
  usecase "AIFR002: Generate Personalized Recommendations Based on Financial Profiles" as AIFR002
  usecase "AIFR005: Identify Investment Opportunities Aligning with Risk Profile and MPT Principles" as AIFR005

  SysAdmin --> SAFR001 : "Manage Analysis Parameters"
}

rectangle "Client Feedback Subsystem" {
  usecase "CFR011: Send User Feedback to Improve System Outputs" as CFR011
}
@enduml