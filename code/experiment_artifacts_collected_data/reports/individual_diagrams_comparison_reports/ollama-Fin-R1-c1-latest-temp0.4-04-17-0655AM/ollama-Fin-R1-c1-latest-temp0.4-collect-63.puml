@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sas
actor FinancialAdvisor as faa
system "System" as sys

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile (MiFID II)" as CFR007
  usecase "CFR008: View News Related to Investment Portfolio" as CFR008
  usecase "CFR009: Consolidated Financial Dashboard for Efficient Monitoring" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors, Including Data Sharing Permissions" as CFR10

}

rectangle "System Administrator Interface" {
  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
}
  
rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004
}

rectangle "System (SFR)" {
  usecase "SFR001: Deliver Alerts Through Notification Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Financial Profiles" as SFR002
  usecase "SFR003: Request Predictive Interventions from AI Component" as SFR003
}

rectangle "AI System (AIFR)" {
  usecase "AIFR001: Generate Financial Predictions via Historical Data and Market Trends" as AIFR001
  usecase "AIFR002: Personalized Recommendations Based on User Profiles" as AIFR002
}

rectangle "System (SFR)" {
  usecase "SFR004: Request AI Component for Spending Limit Alerts" as SFR004
}
  
rectangle "System (SFR)" {
  usecase "SFR005: Request Investment Opportunity Analysis from AI" as SFR005
}

rectangle "System (SFR)" {
  usecase "SFR006: Generate Client Dashboards for Financial Information" as SFR006
}
  
rectangle "System (SFR)" {
  usecase "SFR013: Manage User Feedback to Improve System" as SFR013
}

sas --> SAFR001

c1 -->> CFR001 : View Financial Insights Dashboard
c1 -->> CFR002 : Receive Alerts for Anomalous Transactions
c1 -->> CFR003 : View Financial Predictions Based on Historical Data and Market Trends
c1 -->> CFR004 : Personalized Recommendations Aligned with Financial Profile
c1 -->> CFR005 : Manage Preferences for Personalized Recommendations
c1 -->> CFR006 : View Spending Limit Alerts When Exceeding Thresholds
c1 -->> CFR007 : Access Investment Opportunities Based on Risk Profile (MiFID II)
c1 -->> CFR008 : View News Related to Investment Portfolio
c1 -->> CFR009 : Consolidated Financial Dashboard for Efficient Monitoring
c1 -->> CFR10 : Manage Relationship with Financial Advisors, Including Data Sharing Permissions

faa --> FAFR001 : Manage Client Mentoring Sessions Based on System-Generated Insights
faa --> FAFR002 : View Client Intervention Alerts for Proactive Assistance
faa --> FAFR003 : View Predictive Analytics About Clients' Financial Situations
faa --> FAFR004 : Configure Analysis Parameters by Client Segment

sys -->> SFR001 : Deliver Alerts Through Notification Channels
sys -->> SFR002 : Provide Personalized Recommendations Based on Financial Profiles
sys -->> SFR003 : Request Predictive Interventions from AI Component
sys -->> AIFR001 : Generate Financial Predictions via Historical Data and Market Trends

sas --> sys: Manage Analysis Parameters (SAFR001)

c1 --> SFR004 : Request Spending Limit Alerts From System
c1 --> SFR005 : Request Investment Opportunity Analysis from AI Component
c1 --> AIFR002 : Personalized Recommendations Based on User Profiles

faa --> sys: Manage Client Dashboards (SFR006)

sas --> sys: Manage User Feedback to Improve System (SFR013)
@enduml