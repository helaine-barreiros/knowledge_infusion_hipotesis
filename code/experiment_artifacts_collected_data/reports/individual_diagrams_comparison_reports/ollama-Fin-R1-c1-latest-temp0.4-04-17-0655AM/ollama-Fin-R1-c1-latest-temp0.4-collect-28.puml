@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Personalized Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Financial Portfolio" as CFR008
  usecase "CFR009: Consolidated Personalized Dashboard for Monitoring Finances" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors Including Data Sharing Permissions" as CFR10

  Client --> CFR001 : View dashboard\nClient --> CFR002 : Receive alerts\nClient --> CFR003 : Predictions based on data and trends\nClient --> CFR004 : Personalized recommendations\nClient --> CFR005 : Manage preferences\nClient --> CFR006 : Spending limit alerts\nClient --> CFR007 : Investment opportunities\nClient --> CFR008 : News related to portfolio\nClient --> CFR009 : Consolidated view\nClient --> CFR10 : Manage relationship
}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001

  SysAdmin --> SAFR001 : Configure parameters to ensure accuracy and compliance with regulations like Basel III.
}

rectangle "Financial Advisor (FA)" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003

  FA --> FAFR001 : Manage sessions\nFA --> FAFR002 : Interventions alerts\nFA --> FAFR003 : Analyze clients
}

rectangle "System (S)" {
  usecase "SFR001: Deliver Alerts Through Notification Channels" as SFR001
  usecase "SFR002: Personalized Recommendations Based on Financial Profiles" as SFR002
  usecase "SFR003: Request Predictive Interventions from AI Component" as SFR003

  Sys --> SFR001 : Alerts\nSys --> SFR002 : Recommendations\nSys --> SFR003 : Interventions request
}

rectangle "AI System (AIS)" {
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Personalized Recommendations Based on Profiles and Risk Tolerance" as AIFR002

  AIS --> AIFR001 : Analyze data\nAIS --> AIFR002 : Generate recommendations based on profiles
}

rectangle "Client (C)" {
  usecase "CFR011: Send Feedback to Improve System Outputs" as CFR011

  Client --> CFR011 : Provide feedback for improvement.
}
@enduml