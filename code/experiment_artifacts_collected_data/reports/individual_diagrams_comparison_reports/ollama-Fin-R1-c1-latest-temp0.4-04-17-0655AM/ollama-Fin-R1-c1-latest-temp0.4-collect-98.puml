@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:Client: as Client
:System Admin: as SysAdmin
:FInancial Advisor: as FAFR001, FAFR002, FAFR003, FAFR004
:SFR Component: as SFR001 to SFR020
:AIFR Component: as AIFR001 to AIFR009

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts Based on Predefined Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Suitable to Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Investment Portfolio" as CFR008
  usecase "CFR009: Consolidated Personalized Dashboard for Financial Monitoring" as CFR009
  usecase "CFR010: Manage Relationship with Financial Advisors Including Data Sharing Permissions" as CFR010

  SysAdmin --> SAFR001 : Configure analysis parameters to ensure compliance and accuracy.

  FAFR003 <|-- (FAFR002) : View client intervention alerts when needed.
  
  SFR Component {
    usecase "SFR008: Request Anomaly Transaction Alerts" as SFR008
    usecase "SFR019: Manage Historical Record of Insights for Trend Analysis" as SFR019

    FAFR002 --> (SFR008) : View client intervention alerts.
  }

  AIFR Component {
    usecase "AIFR003: Generate Spending Limit Alerts Based on Unusual Patterns" as AIFR003
    usecase "AIFR004: Analyze Investment Opportunities Against Risk Profiles and Goals" as AIFR004

    FAFR001 --> (AIFR007) : Receive contextualized news insights.
  }

  Client --> CFR001, CFR002, ..., CFR009, CFR010
  SysAdmin --> SAFR001, SFR008, AIFR003

  FAFR004 <|-- (CFR011) : Send feedback to improve the system's outputs.
}

@enduml