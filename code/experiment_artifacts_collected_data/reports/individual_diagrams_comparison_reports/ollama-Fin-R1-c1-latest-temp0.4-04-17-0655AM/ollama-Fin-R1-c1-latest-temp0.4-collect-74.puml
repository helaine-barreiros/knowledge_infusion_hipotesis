@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as C
actor FinancialAdvisor as FA
actor SysAdmin as SA
system "System" as S

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Personalized Recommendations Based on Profile" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: Spending Limit Alerts for Budget Control" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Access News Related to Portfolio" as CFR008
  usecase "CFR009: Personalized Dashboard for Financial Monitoring" as CFR009
  usecase "CFR10: Manage Relationship with Advisors" as CFR10

  C --> CFR001 : "View financial data"
  C --> CFR002 : "Receive alerts about anomalous transactions"
  C --> CFR003 : "View predictions based on historical and market trends"
  C --> CFR004 : "Get personalized recommendations aligned with profile"
  C --> CFR005 : "Adjust recommendation preferences in KYC settings"
  C --> CFR006 : "Get spending limit alerts when exceeding thresholds"
  C --> CFR007 : "View investment opportunities matching risk profile"
  C --> CFR008 : "Read portfolio-related news"
  C --> CFR009 : "Consolidate financial info in a single view"
  C --> CFR10 : "Manage sharing permissions with advisors"

}

rectangle "Advisor Interface" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  usecase "FAFR002: View Intervention Alerts for Clients" as FAFR002
  usecase "FAFR003: Review Predictive Analytics on Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004

  FA --> FAFR001 : "Schedule and track mentoring sessions"
  FA --> FAFR002 : "Review alerts for proactive client support"
  FA --> FAFR003 : "Analyze clients' financial data trends"
  FA --> FAFR004 : "Set segment-specific analysis parameters"

}

rectangle "System Admin Interface" {
  usecase "SAFR001: Manage Analysis Parameters (Basel III)" as SAFR001

  SA --> SAFR001 : "Adjust system-wide parameters for compliance"
}

package "AI & System Components" {
  
  system S
  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  usecase "SFR003: Request Financial Predictions from AI" as SFR003
  usecase "SFR004: Request Personalized Recs Based on Data" as SFR004
  usecase "SFR005: Send Spending Limit Alerts to Users" as SFR005
  usecase "SFR006: Analyze Investment Opportunities for Users" as SFR006
  usecase "SFR007: Find ESG-Compliant Investments" as SFR007
  usecase "SFR008: Detect Anomalous Transactions (AML)" as SFR008
  usecase "SFR009: Extract News Relevance to Portfolios" as SFR009
  usecase "SFR012: Generate Client Dashboards" as SFR012

}

package "AI System" {
  
  system AIFR001: "Generate Financial Predictions"
  system AIFR002: "Personalized Recommendations Engine"
  system AIFR003: "Spending Limit Alert Generator"
  system AIFR004: "Investment Opportunity Analyzer"
  system AIFR005: "ESG Investment Selector"
  system AIFR006: "Anomaly Transaction Detector (AML)"
  system AIFR007: "Contextualized News Correlator"
  system AIFR008: "Client Intervention Predictor"
  system AIFR009: "Predictive Insights Generator"

}

S --> SFR002 : "Deliver recommendations to clients"
S --> SFR003 : "Request financial predictions from AI"
S --> SFR004 : "Request personalized recs based on data"
S --> SFR005 : "Send spending limit alerts when thresholds exceeded"
S --> SFR006 : "Analyze investment opportunities for users"
S --> SFR007 : "Identify ESG-compliant investments"
S --> SFR008 : "Detect AML-related transactions"
S --> SFR009 : "Extract portfolio-relevant news"
S --> SFR012 : "Generate client dashboards"

AIFR001 <|-- S : "AI generates predictions for system requests (via SFR003)"
AIFR002 <|-- S : "AI provides personalized recs via SFR004 and others"
AIFR003 <|-- S : "AI sends spending limit alerts through SFR005"
AIFR004 <|-- S : "AI analyzes investments for opportunities (via SFR006)"
AIFR005 <|-- AIFR004 : "ESG criteria applied in investment analysis"
AIFR007 <|-- S : "News relevance checked via AI's correlator"

'System components and their relationships with the system boundary.

@enduml