@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Alert Thresholds and Categories" as SAFR002
  usecase "CFR003: View Historical Data Predictions" as CFR003
  usecase "CFR004: Receive Personalized Financial Recommendations" as CFR004
  usecase "CFR005: Adjust Recommendation Preferences" as CFR005
  usecase "CFR006: Monitor Spending Limits" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Stay Informed with Financial News" as CFR008
  usecase "CFR009: Consolidate Financial Information in a Single View" as CFR010
  usecase "CFR011: Manage Relationship and Data Sharing with Advisors" as SAFR003

  usecase "FAFR002: Monitor Client Intervention Alerts" as FAFR002
  usecase "FAFR004: Configure Analysis Parameters for Segments" as FAFR005
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013

  usecase "AIFR001: Analyze Historical Data and Market Trends" as AIFR001
  usecase "AIFR002: Personalize Recommendations to Profiles" as AIFR002
  usecase "AIFR004: Identify Spending Limit Anomalies" as AIFR003
  usecase "AIFR005: Find Investment Opportunities Matching Risk Profile" as AIFR006
  usecase "AIFR007: Detect Fraudulent Transactions via Pattern Recognition" as AIFR008

  usecase "SFR014: Provide Financial Health Reports Based on Ratios and Metrics" as SFR015
}

actor Client as C
actor SystemAdmin as SA
actor FinancialAdvisor as FA
actor User as U

C --> CFR001 : "View Financial Insights Dashboard"
SA -> SAFR002 : Manage Alert Thresholds and Categories (Sys Admin)
FA <- FAFR004 : Configure Analysis Parameters for Segments (Financial Advisor)
U -->> SFR013 : Generate Client Alerts Based on Predefined Conditions

rectangle "Client" {
  C --> CFR005 : Adjust Recommendation Preferences
}

rectangle "Advisor & SysAdmin" {
  FA -> FAFR002 : Monitor Client Intervention Alerts (FA and SA)
  SA <- SAFR004 : Configure Analysis Parameters for Segments (SA)
}

rectangle "System" {
  SFR013 --> AIFR008 : Generate Fraudulent Transaction Alerts
}
@enduml