@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor SysAdmin as sa
actor FinancialAdvisor as faa
system :System: as sys

rectangle "Client" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Data and Trends" as CFR003
  usecase "CFR004: Personalized Recommendations Aligned with Profile" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "CFR006: View Spending Limit Alerts for Budget Control" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Portfolio" as CFR008
  usecase "CFR009: Consolidated Personalized Dashboard for Monitoring" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors" as CFR10

  c1 --> CFR001 : View financial insights dashboard.
  c1 --> CFR002 : Receive alerts on anomalous transactions.
  c1 --> CFR003 : View financial predictions based on data and trends.
  c1 --> CFR004 : Personalized recommendations aligned with profile.
  c1 --> CFR005 : Manage recommendation preferences.
  c1 --> CFR006 : View spending limit alerts for budget control.
  c1 --> CFR007 : Access investment opportunities based on risk profile.
  c1 --> CFR008 : Receive news related to portfolio.
  c1 --> CFR009 : Consolidated personalized dashboard for monitoring.
  c1 --> CFR10 : Manage relationship with financial advisors.

}

rectangle "Financial Advisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: View Predictive Analytics About Clients' Financial Situations" as FAFR003
  usecase "FAFR004: Configure Analysis Parameters by Client Segment" as FAFR004

  faa --> FAFR001 : Manage client mentoring sessions.
  faa --> FAFR002 : View client intervention alerts for proactive assistance.
  faa --> FAFR003 : View predictive analytics about clients' financial situations during consultations.
  faa --> FAFR004 : Configure analysis parameters by segment.

}

rectangle "System Administrator" {
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001

  sa --> SAFR001 : Manage analysis parameters to ensure accuracy and compliance.
}

system <|-- CFR001
system <|-- CFR002
system <|-- CFR003
system <|-- CFR004
system <|-- CFR005
system <|-- CFR006
system <|-- CFR007
system <|-- CFR008
system <|-- CFR009
system <|-- CFR10

system <|-- FAFR001
system <|-- FAFR002
system <|-- FAFR003
system <|-- FAFR004

system <|-- SAFR001

@enduml