@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Access Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: Receive Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: View Investment Opportunities Based on Risk Profile and ESG Criteria" as CFR007
  usecase "CFR008: Access News Related to Financial Portfolio" as CFR008
  usecase "CFR009: Manage Personalized Dashboard for Consolidated Financial Information" as CFR009
  usecase "CFR010: Manage Relationship with Financial Advisors Including Data Sharing Permissions" as CFR010

  actor Client as c1
  client --> (CFR001) : View financial insights dashboard\n(client)
  client --> (CFR002) : Receive alerts on anomalous transactions\n(fatf regulations)\n(client)
  client --> (CFR003) : View financial predictions based on data and trends\n(client)
  client --> (CFR004) : Access personalized recommendations aligned with profile\n(client)
  client --> (CFR005) : Manage recommendation preferences\n(kyc defined goals)\n(client)
  client --> (CFR006) : Receive spending limit alerts when exceeding thresholds\n(budget control)\n(client)
  client --> (CFR007) : View investment opportunities based on risk profile and esg criteria\n(mifid ii compliance)\n(client)
  client --> (CFR008) : Access news related to portfolio\n(client)
  client --> (CFR009) : Manage personalized dashboard for consolidated info\n(client)
  client --> (CFR010) : Manage relationship with financial advisors including data sharing permissions\n(privacy)\n(client)

  usecase "SAFR001: Manage Analysis Parameters" as SAFR001
  systemAdmin --> (SAFR001) : Manage analysis parameters for ai system to ensure accuracy and compliance\n(basel iii, regulations)\n(system admin)
  
  actor SystemAdministrator as sa
  sysadmin --> (SAFR001) : Manage analysis parameters\n(regulatory requirements)

  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001
  financialAdvisor --> (FAFR001) : Manage client mentoring sessions based on system insights\ndata-driven guidance\n(financial advisor)
  
  actor FinancialAdvisor as faa
  financialadvisor --> (FAFR001) : Manage client mentoring sessions\n(insights from ai)

  usecase "SFR002: Deliver Personalized Recommendations" as SFR002
  system --> (SFR002) : Request personalized recommendations based on user data and preferences\n(personalization)\n(system)
  
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  aiSystem --> (AIFR001) : Analyze historical transactions, market trends to generate predictions\ncustomer insights\n(ai system)
  
}

@enduml