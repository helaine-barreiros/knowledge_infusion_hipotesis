@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage User Alerts (Anomalies)" as SAFR002
  usecase "CFR003: View Financial Predictions" as CFR003
  usecase "CFR004: Receive Personalized Recommendations" as CFR004
  usecase "CFR005: Manage Recommendation Preferences" as CFR005
  usecase "SAFR006: Monitor Spending Limits" as SAFR006
  usecase "CFR007: View Investment Opportunities" as CFR007
  usecase "CFR008: Access Portfolio News" as CFR008
  usecase "CFR009: Consolidate Financial Information" as CFR010
  usecase "SAFR003: Manage Data Sharing with Advisors" as SAFR004

  package Professional {
    actor Client as cClient
    actor SystemAdmin as SysAdmin
    actor FinancialAdvisor as FAFRAgent
  }

  client --> CFR001 : View financial data consolidated in a dashboard.
  
  SysAdmin -> SAFR002 : Manage system parameters for alerts and notifications.

  cClient -> CFR003 : Request future financial trends based on historical data and market conditions.
  
  FAFRAgent -> CFR004 : Receive tailored investment advice aligned with client's risk profile.
  
  Client --> CFR005 : Adjust personalization settings to refine recommendations.
  
  SysAdmin -> SAFR006 : Set spending limits for clients, monitor threshold breaches.

  cClient -> CFR007 : Explore potential investments suitable based on their financial profiles and risk tolerance.
  
  FAFRAgent -> CFR008 : Stay informed about market events affecting portfolio assets.
  
  Client --> CFR010 : Access a single view of all financial metrics for efficient tracking.
  
  SysAdmin -> SAFR004 : Control data sharing permissions between clients and advisors.

  usecase "CFR011: Provide Feedback" as CFR011
  cClient, FAFRAgent, SysAdmin --> CFR011 : Send feedback to improve system outputs.

}

@enduml