@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

:User: as User
:System: as Sys

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Trends" as CFR003
  usecase "CFR004: Access Personalized Recommendations Aligning with Financial Goals" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile" as CFR007
  usecase "CFR008: Receive News Related to Financial Portfolio" as CFR008
  usecase "CFR009: View Consolidated Personalized Dashboard for Finances" as CFR010
  usecase "CFR010: Manage Relationship with Financial Advisors Including Data Sharing Permissions" as SAFR002
  
  SysAdmin --> SAFR001
}

rectangle "AI System" {
  usecase "AIFR001: Generate Financial Predictions via AI" as AIFR001
  usecase "AIFR002: Create Personalized Recommendations Using AI" as AIFR002
  usecase "AIFR003: Issue Spending Limit Alerts with AI" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities via AI" as AIFR004
  usecase "AIFR005: Identify ESG-Aligned Investments Using AI" as AIFR005
  usecase "AIFR006: Detect Anomalies in Transactions with AI" as AIFR006
  usecase "AIFR007: Extract Contextualized News Insights via AI" as AIFR007
  usecase "AIFR008: Recommend Predictive Interventions Using AI" as AIFR008
  usecase "AIFR009: Provide Forward-Looking Analysis with AI" as AIFR009

  Sys --> (AIFR001)
}

rectangle "Financial Advisor" {
  actor FAFR001 as FAFR001
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System Insights" as FAFR001UC
  usecase "FAFR002: View Client Intervention Alerts from AI" as FAFR002
  usecase "FAFR003: Review Predictive Analytics for Clients" as FAFR003

  Sys --> (FAFR001)
}

rectangle "System Administrator" {
  actor SysAdmin as SysAdmin
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001
  
  Sys --> (SAFR001)
}

