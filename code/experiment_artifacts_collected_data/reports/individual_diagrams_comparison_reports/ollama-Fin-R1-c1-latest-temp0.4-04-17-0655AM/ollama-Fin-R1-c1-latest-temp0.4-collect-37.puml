@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

actor Client as c1
actor FinancialAdvisor as fad
actor SysAdmin as sa
system "System" as sys

package Professional {
  actor Chef as chef 
}

rectangle "Client Interface" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "CFR002: Receive Alerts for Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions Based on Historical Data and Market Trends" as CFR003
  usecase "CFR004: Access Personalized Recommendations Aligned with Financial Profile" as CFR004
  usecase "CFR005: Manage Preferences for Personalized Recommendations" as CFR005
  usecase "CFR006: View Spending Limit Alerts When Exceeding Predefined Thresholds" as CFR006
  usecase "CFR007: Access Investment Opportunities Based on Risk Profile (e.g., MiFID II)" as CFR007
  usecase "CFR008: Receive News Related to Financial Portfolio" as CFR008
  usecase "CFR009: View Consolidated Personalized Dashboard for Efficient Monitoring" as CFR009
  usecase "CFR10: Manage Relationship with Financial Advisors Including Data Sharing Permissions" as CFR10

}

rectangle "Financial Advisor Interface" {
  usecase "FAFR001: Manage Client Mentoring Sessions Based on System-Generated Insights" as FAFR001
  usecase "FAFR002: View Client Intervention Alerts for Proactive Assistance" as FAFR002
  usecase "FAFR003: Review Predictive Analytics About Clients' Financial Situations" as FAFR003
}

rectangle "System Administrator Interface" {
  usecase "SAFR001: Manage Analysis Parameters to Ensure Algorithm Accuracy and Compliance with Basel III, etc." as SAFR001

}

package System {
  
  system "AI Component (AIFR)" as aifr
  
  usecase "AIFR001: Generate Financial Predictions" as AIFR001
  usecase "AIFR002: Generate Personalized Recommendations Based on Profiles and Goals" as AIFR002
  usecase "AIFR003: Identify Spending Limit Alerts for Unusual Patterns" as AIFR003
  usecase "AIFR004: Analyze Investment Opportunities Against Risk Profiles" as AIFR004
  usecase "AIFR005: Generate Investment Opportunity Lists Based on Criteria and ESG Preferences" as AIFR005
  usecase "AIFR006: Detect Anomalous Transactions for Fraud Prevention (AML)" as AIFR006
  usecase "AIFR007: Correlate Financial News with Portfolios to Extract Relevant Insights" as AIFR007
  usecase "AIFR008: Recommend Timing of Engagements Based on Client Predictive Analytics" as AIFR008
  usecase "AIFR009: Provide Forward-Looking Analysis for Financial Planning" as AIFR009

}

package System {
  
  system "SFR Component (System Functionality)" as sfr
  
  usecase "SFR001: Deliver Alerts Through Notification Channels" as SFR001
  usecase "SFR002: Provide Personalized Recommendations Based on Profiles and Goals" as SFR002
  usecase "SFR003: Request Financial Predictions from AIFR" as SFR003
  usecase "SFR004: Request Personalized Recommendations From AIFR" as SFR004
  usecase "SFR005: Trigger Spending Limit Alerts Based on Thresholds" as SFR005
  usecase "SFR006: Analyze Investment Opportunities for Users" as SFR006
  usecase "SFR007: Identify Specific Investments Matching User Criteria and ESG Preferences" as SFR007
  usecase "SFR008: Detect Anomalous Transactions in Compliance with AML Regulations" as SFR008
  usecase "SFR009: Extract Contextualized News for Financial Portfolios" as SFR009
  usecase "SFR010: Process Contextualized News to Inform Users' Investments" as SFR010
  usecase "SFR011: Generate Client Dashboards with Intuitive Presentation of Data" as SFR011
  usecase "SFR012: Manage Client Alerts Based on Predefined Conditions" as SFR012
  usecase "SFR013: Provide Financial Analytics for Insights into User Behavior and Performance" as SFR013
  usecase "SFR014: Request Predictive Interventions from AIFR to Engage Advisors at Optimal Times" as SFR014
  usecase "SFR015: Generate Health Reports Based on Financial Ratios and Metrics" as SFR015
  usecase "SFR016: Track User Progress Towards Financial Goals for Continuous Improvement" as SFR016
  usecase "SFR017: Maintain Historical Record of Insights to Analyze Trends and Effectiveness" as SFR017

}

usecase "CFR011: Send Feedback About System Outputs" as CFR011 extends sys
  
Client c1 --> CFR001 : "View Financial Dashboard"
c1 --> CFR002 : "Receive Alerts for Anomalous Transactions (FATF)"
c1 --> CFR003 : "View Predictions Based on Data and Trends"
c1 --> CFR004 : "Access Personalized Recommendations"
c1 --> CFR005 : "Manage Recommendation Preferences via KYC Profile"
c1 --> CFR006 : "Receive Spending Limit Alerts (Budget Control)"
c1 --> CFR007 : "View Investment Opportunities Based on Risk Profile (MiFID II)"
c1 --> CFR008 : "Get News Related to Portfolio"
c1 --> CFR009 : "Consolidated Dashboard for Monitoring"
c1 --> CFR10 : "Manage Relationship with Advisors, Share Data"

FinancialAdvisor fad --> FAFR001 : "Mentor Clients Using Insights"
fad --> FAFR002 : "View Intervention Alerts (Proactive)"
fad --> FAFR003 : "Review Predictive Analytics for Consultations"

SysAdmin sa --> SAFR001 : "Manage Analysis Parameters Compliance"

AIFR aifr <|-- AIFR001
aifr <|-- AIFR002
aifr <|-- AIFR003
aifr <|-- AIFR004
aifr <|-- AIFR005
aifr <|-- AIFR006
aifr <|-- AIFR007
aifr <|-- AIFR008
aifr <|-- AIFR009

SFR sfr <|-- SFR001
sfr <|-- SFR002
sfr <|-- SFR003
sfr <|-- SFR004
sfr <|-- SFR005
sfr <|-- SFR006
sfr <|-- SFR007
sfr <|-- SFR008
sfr <|-- SFR009
sfr <|-- SFR010
sfr <|-- SFR011
sfr <|-- SFR012
sfr <|-- SFR013
sfr <|-- SFR014
sfr <|-- SFR015
sfr <|-- SFR016
sfr <|-- SFR017

CFR011 --> sys : "Feedback on Recommendations/Insights"

@enduml