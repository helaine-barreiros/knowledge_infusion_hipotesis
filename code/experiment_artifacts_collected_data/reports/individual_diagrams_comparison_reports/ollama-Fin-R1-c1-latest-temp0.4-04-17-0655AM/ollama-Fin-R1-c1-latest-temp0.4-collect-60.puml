@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Anomaly Detection Parameters" as SAFR002
  usecase "FAFR005: Schedule Client Mentoring Sessions" as FAFR005
  usecase "SFR013: Generate Client Alerts Based on Predefined Conditions" as SFR013
  usecase "AIFR006: Generate Investment Opportunity Analyses for Users" as AIFR006

  Client --> CFR001 : View Financial Insights Dashboard
  SysAdmin -> SAFR002 : Manage Analysis Parameters (AI)
  FAFR001 -> FAFR005 : Schedule Mentoring Sessions Based on System-Generated Insights
  FAFR002 -> FAFR005 : View Intervention Alerts for Proactive Client Assistance
  FAFR003 -> AIFR008 : View Predictive Interventions to Guide Financial Advisors
  SysAdmin --> SFR013 : Generate Client-Specific Alerts (System)
  System -->> CFR002: Receive Anomaly Transaction Alerts via Notifications

  // Grouping related use cases under different actors and packages
  package "Client" {
    usecase "CFR001"
    usecase "SAFR002"
    usecase "FAFR005"
    usecase "SFR013"
    usecase "AIFR006"
  }

  package "Financial Advisor" {
    usecase FAFR001
    usecase FAFR002
    usecase FAFR003
  }

  package "System Administrator" {
    usecase SAFR002
  }
}

@enduml