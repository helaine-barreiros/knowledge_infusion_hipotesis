@startuml
left to right direction

title Use Case Diagram for AI-Powered Analysis & Insights System

rectangle "System" {
  usecase "CFR001: View Financial Insights Dashboard" as CFR001
  usecase "SAFR002: Manage Anomaly Detection Rules" as SAFR002
  usecase "FAFR005: Schedule Client Mentoring Sessions" as FAFR005
  usecase "SFR013: Generate Alerts Based on Predefined Conditions" as SFR013
  
  Client --> CFR001 : View Financial Insights Dashboard  
  SysAdmin -> SAFR002 : Manage Analysis Parameters for AI System  
  FinancialAdvisor -> FAFR005 : Schedule Mentoring Sessions
}

rectangle "Client" {
  usecase "CFR002: Receive Alerts on Anomalous Transactions" as CFR002
  usecase "CFR003: View Financial Predictions" as CFR003  
  usecase "CFR004: Personalized Recommendations" as CFR004 
  usecase "CFR011: Send Feedback to System" as CFR011

  Client --> CFR002 : Receive Alerts
  Client --> CFR003 : View Predictions
  Client --> CFR004 : Get Recommendations  
}

rectangle "FinancialAdvisor" {
  usecase "FAFR001: Manage Client Mentoring Sessions" as FAFR001 
  usecase "FAFR002: View Intervention Alerts" as FAFR002
  usecase "FAFR003: View Predictive Analytics" as FAFR003  
  FinancialAdvisor --> FAFR001 : Schedule Sessions
}

rectangle "SysAdmin" {
  usecase "SAFR001: Manage Analysis Parameters for AI System" as SAFR001 
  SysAdmin -> SAFR002 : Configure Rules

  SysAdmin --> SAFR001 : Set Parameters  
}
@enduml