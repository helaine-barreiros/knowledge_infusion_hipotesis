@startuml "Sistema de Gestão Financeira Pessoal - Casos de Uso"

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title "Sistema de Gestão Financeira Pessoal - Casos de Uso"

' Atores
actor "Cliente Individual" as user #32CD32
actor "Financiador" as lender #FF69B4
actor "Plataforma de Pagamento" as paymentPlatform #ADD8E6

' Sistema e casos de uso
rectangle "Sistema de Gestão Financeira Pessoal" {
    usecase "UC01: Cadastro e Login" as UC01 {
        note right of UC01
            **Req. ID:** FR01, FR02
            **Descrição:** Permite ao usuário realizar o cadastro no sistema 
            utilizando email e senha, ou autenticação via OAuth.
        end note
    }
    
    usecase "UC02: Visualizar Contas Bancárias Conectadas" as UC02 {
        note right of UC02
            **Req. ID:** FR03, FR04
            **Descrição:** Exibe uma lista de todas as contas bancárias 
            conectadas ao perfil do usuário.
        end note
    }
    
    usecase "UC03: Conectar Nova Conta Bancária" as UC03 {
        note right of UC03
            **Req. ID:** FR05, FR16
            **Descrição:** Permite conectar uma nova conta bancária 
            ao perfil do usuário através de OAuth.
        end note
    }
    
    usecase "UC04: Transferir Fundos" as UC04 {
        note right of UC04
            **Req. ID:** FR06, FR13
            **Descrição:** Facilita a transferência de fundos entre contas 
            bancárias conectadas ou com financiadores.
        end note
    }
    
    usecase "UC05: Gerenciar Financiamentos" as UC05 {
        note right of UC05
            **Req. ID:** FR10, FR12
            **Descrição:** Permite ao usuário verificar status de 
            financiamentos pendentes ou em andamento.
        end note
    }
    
    usecase "UC06: Gerar Relatórios Financeiros" as UC06 {
        note right of UC06
            **Req. ID:** FR14, FR15
            **Descrição:** Gera relatórios financeiros personalizados 
            com análise de despesas e investimentos.
        end note
    }
    
    usecase "UC07: Acompanhar Despesas" as UC07 {
        note right of UC07
            **Req. ID:** FR08, FR14
            **Descrição:** Permite a visualização de gastos em categorias 
            predefinidas.
        end note
    }
    
    usecase "UC08: Configurar Avisos Bancários" as UC08 {
        note right of UC08
            **Req. ID:** FR09, FR16
            **Descrição:** Oferece a opção de configurar avisos e alertas 
            sobre transações bancárias.
        end note
    }
    
    usecase "UC09: Controle de Orçamento" as UC09 {
        note right of UC09
            **Req. ID:** FR11, FR14
            **Descrição:** Permite ao usuário criar e monitorar 
            orçamentos pessoais.
        end note
    }
    
    usecase "UC10: Automação de Transações" as UC10 {
        note right of UC10
            **Req. ID:** FR13, FR15
            **Descrição:** Automatiza processos como pagamentos 
            recorrentes e investimentos.
        end note
    }
    
    usecase "UC11: Integração com Plataforma de Pagamento" as UC11 {
        note right of UC11
            **Req. ID:** FR07, FR16
            **Descrição:** Permite transações seguras através da 
            plataforma de pagamento.
        end note
    }
    
    usecase "UC12: Recuperar Senha" as UC12 {
        note right of UC12
            **Req. ID:** FR01, FR02
            **Descrição:** Oferece um processo para redefinir a senha 
            do usuário em caso de esquecimento.
        end note
    }
    
    usecase "UC13: Sincronizar Contas Externas" as UC13 {
        note right of UC13
            **Req. ID:** FR05, FR16
            **Descrição:** Realiza a sincronização automática de 
            informações financeiras com outras plataformas.
        end note
    }
    
    usecase "UC14: Segurança e Comunicação" as UC14 {
        note right of UC14
            **Req. ID:** FR07, FR08, FR12
            **Descrição:** Implementa medidas de segurança e 
            meios de comunicação seguros com o suporte.
        end note
    }
    
    usecase "UC15: Compartilhar Dados Financeiros" as UC15 {
        note right of UC15
            **Req. ID:** FR09, FR13
            **Descrição:** Facilita a compartilhamento de dados 
            financeiros com entidades autorizadas.
        end note
    }
    
    usecase "UC16: Opções de Pagamento" as UC16 {
        note right of UC16
            **Req. ID:** FR08, FR13
            **Descrição:** Permite várias opções de pagamento 
            (transferência bancária, cartão, etc.) para financiamentos.
        end note
    }
}

' Relationships between use cases
UC02 includes UC03 : "Inclui conectar nova conta"
UC04 extends UC11 : "Integração com plataforma de pagamento é necessária para transferências"
UC05 includes UC06 : "Relatórios financeiros podem ser gerados em relação a financiamentos"
UC07 includes UC09 : "Controle de orçamento influencia acompanhamento das despesas"
UC12 extends UC14 : "Segurança é um componente fundamental do processo de redefinição de senha"

' Actors - use cases interactions
user --> UC01
lender --> UC05
paymentPlatform --> UC11

@enduml