@startuml "C4_UC_ShareData"

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title "Sistema de Gestão Financeira Pessoal - Compartilhamento de Dados Financeiros - Casos de Uso"

' Atores
actor "Cliente Individual" as user
actor "Assistente Bancário" as advisor #7B1FA2
actor "Servidor de Segurança" as securityServer #3CB371

' Sistema e casos de uso
rectangle "Sistema de Gestão Financeira Pessoal" {
    usecase "UC08: Compartilhar Dados Selecionados com Assistente Bancário" as UC08
    
    note right of UC08
      **Req. ID:** FR13, NFR02, NFR06
      **Descrição:** Permite ao cliente individual selecionar transações financeiras e 
      compartilhar esses dados de forma segura com seu assistente bancário.
    end note
    
    usecase "UC09: Receber Compartilhamento de Dados do Cliente" as UC09
    usecase "UC10: Gerar Relatórios Bimestrais a partir de Dados Compartilhados" as UC10
    usecase "UC11: Remover Acesso a Contas Compartilhadas" as UC11
    
    ' Relacionamentos entre casos de uso
    UC08 ..> UC09 : <<include>>
    UC09 --> UC10 : <<extend>>
    UC10 --> UC11 : <<include>>

}

' Relacionamentos ator-caso de uso
user --> UC08
advisor --> UC09
securityServer --> UC11

@enduml