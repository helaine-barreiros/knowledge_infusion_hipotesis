@startuml "C4_UC_PersonalFinance"

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title "Sistema de Gestão Financeira Pessoal - Casos de Uso"

' Atores
actor "Cliente Individual" as user

' Sistema e casos de uso
rectangle "Sistema de Gestão Financeira Pessoal" {
    usecase "UC01: Visualizar Transações" as UC01
    usecase "UC02: Categorizar Transação Manualmente" as UC02
    usecase "UC03: Receber Categorização Automática" as UC03
    usecase "UC04: Filtrar Transações" as UC04
    usecase "UC05: Buscar Transações" as UC05
    usecase "UC06: Exportar Transações" as UC06
    
    usecase "UC10: Visualizar Balanço" as UC10
    usecase "UC11: Receber Balanço Automático" as UC11
    
    note right of UC10
      **Req. ID:** FR13, FR14
      **Descrição:** Permite ao usuário visualizar o balanço geral 
      das suas contas conectadas, incluindo receitas e despesas.
    end note
    
    usecase "UC20: Criar Orçamento" as UC20
    usecase "UC21: Ajustar Orçamento" as UC21
    usecase "UC22: Visualizar Orçamentos" as UC22
    usecase "UC23: Receber Sugestão de Orçamento Automática" as UC23
    
    note right of UC20
      **Req. ID:** FR15, FR16
      **Descrição:** Permite ao usuário criar e ajustar orçamentos para 
      diferentes categorias de despesas.
    end note
    
    usecase "UC30: Compartilhar Dados com Profissional de Contabilidade" as UC30
    usecase "UC31: Receber Recomendação Automática de Profissional de Contabilidade" as UC31
    
    note right of UC30
      **Req. ID:** FR17, FR18
      **Descrição:** Permite ao usuário compartilhar dados financeiros 
      selecionados com profissionais de contabilidade para obter conselhos e orientações.
    end note

    ' Relacionamentos entre casos de uso
    UC01 ..> UC02 : <<include>>
    UC01 ..> UC03 : <<include>>
    UC01 ..> UC04 : <<extend>>
    UC01 ..> UC05 : <<extend>>
    UC01 ..> UC06 : <<extend>>

    UC10 ..> UC11 : <<include>>

    UC20 ..> UC23 : <<include>>

    UC30 ..> UC31 : <<include>>

    ' Relacionamentos ator-caso de uso
    user --> UC01
    user --> UC03
    user --> UC04
    user --> UC05
    user --> UC06
    user --> UC10
    user --> UC20
    user --> UC21
    user --> UC22
    user --> UC30
}

@enduml