@startuml "C4_UC_Diagram"

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title "Sistema de Gestão Financeira Pessoal - Casos de Uso"

' Atores
actor "Cliente Individual" as user
actor "Sistema Bancário" as bank #999999
actor "Finanças Públicas" as public_finance #00ff00

' Sistema e casos de uso
rectangle "Sistema de Gestão Financeira Pessoal" {
    usecase "UC01: Visualizar Balanço Financeiro" as UC01
    
    note right of UC01
      **Req. ID:** FR01, FR02
      **Descrição:** Permite ao usuário visualizar o balanço financeiro 
      consolidado de suas contas conectadas.
    end note
    
    usecase "UC02: Realizar Transferência Bancária" as UC02
    usecase "UC03: Receber Pagamento de Serviço Público" as UC03
    usecase "UC04: Gerenciar Contratos Financeiros" as UC04
    
    ' Relacionamentos entre casos de uso
    UC01 ..> UC02 : <<include>>
    UC01 ..> UC03 : <<extend>>
}

' Relacionamentos ator-caso de uso
user --> UC01
user --> UC02
bank --> UC04
public_finance --> UC03

@enduml