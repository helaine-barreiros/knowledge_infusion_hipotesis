@startuml "C4_UC_Sistema"

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title "Sistema de Gestão Financeira Pessoal - Casos de Uso"

' Atores
actor "Cliente Individual" as user
actor "Sistema Bancário" as bank #999999
actor "Consultor Financeiro" as advisor #66b2ff

' Sistema e casos de uso
rectangle "Sistema de Gestão Financeira Pessoal" {
    usecase "UC01: Visualizar Dashboard Financeiro" as UC01
    usecase "UC02: Gerenciar Contas Bancárias" as UC02
    usecase "UC03: Realizar Transações Financeiras" as UC03
    
    note right of UC01
      **Req. ID:** FR07
      **Descrição:** Permite ao usuário visualizar um resumo das 
      suas transações financeiras e indicadores importantes.
    end note
    
    usecase "UC04: Receber Recomendações Financeiras" as UC04
    
    note right of UC04
      **Req. ID:** FR13
      **Descrição:** Permite ao consultor financeiro fornecer 
      recomendações financeiras personalizadas com base na 
      análise de dados do cliente.
    end note
    
    ' Relacionamentos entre casos de uso
    UC01 ..> UC02 : <<include>>
    UC02 ..> UC03 : <<include>>
    UC01 ..> UC04 : <<extend>>
    
    ' Relacionamento ator-caso de uso
    user --> UC01
    user --> UC03
    
    bank --> UC07
}

' Subdiagrama: Casos de Uso para Transações Financeiras
rectangle "Cadeia de Cases of Use para Transações" {
    usecase "UC05: Visualizar Lista de Transações" as UC05
    usecase "UC06: Filtrar Transações" as UC06
    
    note right of UC05
      **Req. ID:** FR03, FR04
      **Descrição:** Permite ao usuário visualizar todas as transações 
      financeiras de suas contas conectadas, ordenadas 
      cronologicamente.
    end note
    
    ' Relacionamentos entre casos de uso
    UC05 ..> UC06 : <<include>>
}

' Subdiagrama: Casos de Uso para Gerenciamento Contas Bancárias
rectangle "Cadeia de Cases of Use para Gerenciamento de Contas" {
    usecase "UC07: Adicionar Nova Conta Bancária" as UC07
    usecase "UC08: Remover Conta Bancária" as UC08
    
    note right of UC07
      **Req. ID:** FR05, FR06
      **Descrição:** Permite ao usuário adicionar ou remover contas 
      bancárias de seus registros.
    end note
    
    ' Relacionamentos entre casos de use
    UC07 ..> UC08 : <<include>>
}

@enduml