@startuml "C4_UC_Transacoes"

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title "Sistema de Gestão Financeira Pessoal - Transações Financeiras - Casos de Uso"

' Atores
actor "Cliente Individual" as user #E069A3
actor "Sistema Bancário" as bank #999999

' Sistema e casos de uso
rectangle "Sistema de Gestão Financeira Pessoal" {
    usecase "UC01: Visualizar Lista de Transações" as UC01
    
    note right of UC01
      **Req. ID:** FR03, FR04  
      **Descrição:** Permite ao usuário visualizar todas as transações 
      financeiras de suas contas conectadas, ordenadas cronologicamente.
    end note
    
    usecase "UC02: Filtrar Transações" as UC02
    usecase "UC03: Categorizar Transação Manualmente" as UC03  
    usecase "UC04: Buscar Transações" as UC04
    usecase "UC05: Visualizar Detalhes da Transação" as UC05  
    usecase "UC06: Exportar Transações" as UC06  
    usecase "UC07: Receber Categorização Automática" as UC07  
    
    ' Relacionamentos entre casos de uso
    UC01 --> UC02 : <<include>>
    UC01 --> UC07 : <<include>>
    UC01 --> UC05 : <<extend>>
    UC01 --> UC06 : <<extend>>
    UC03 --> UC05 : <<include>>
  
  ' Generalização: Categorização de Transações
  usecase "UC08: Gestionar Categoria de Transação" as UC08
  UC08 <|-- UC03
}

' Relacionamentos ator-caso de uso
user --> UC01  
user --> UC02  
user --> UC03  
user --> UC04  
user --> UC05  
user --> UC06  
user --> UC07  
bank --> UC07  

@enduml