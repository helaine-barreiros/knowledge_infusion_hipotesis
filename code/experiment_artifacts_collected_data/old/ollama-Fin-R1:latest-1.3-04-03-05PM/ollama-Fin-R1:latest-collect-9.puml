@startuml "C4_UC"

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title "Sistema de Gestão Financeira Pessoal - Casos de Uso"

' Atores
actor "Cliente Individual" as user
actor "Agência Bancária" as bank
actor "Plataforma de Investimentos" as investments
actor "Serviço de Assistente Virtual" as assistant

' Sistema e casos de uso
rectangle "Sistema de Gestão Financeira Pessoal" {
    usecase "UC01: Cadastro de Usuário" as UC01
    usecase "UC02: Logon do Cliente" as UC02
    usecase "UC03: Exibir Saldo Disponível" as UC03
    usecase "UC04: Consultar Extrato Bancário" as UC04
    usecase "UC05: Solicitar Transferência Bancária" as UC05
    usecase "UC06: Realizar Pagamento com Cartão" as UC06
    usecase "UC07: Gerenciar Contas Correntes" as UC07
    usecase "UC08: Consultar Cartões Associados" as UC08
    usecase "UC09: Visualizar Códigos de Segurança" as UC09
    usecase "UC10: Receber Notificações" as UC10
    usecase "UC11: Partilhar Transações com Conselheiros Financeiros" as UC11

    ' Relacionamentos entre casos de uso (exemplos)
    UC01 --> UC02 : <<extend>>
    UC03 ..> UC04 : <<include>>
    
    usecase "UC06: Agendar Pagamento Recorrente" as UC06a
    usecase "UC07: Editar Contas Correntes" as UC07a

    usecase "UC12: Gerenciar Investimentos" as UC12
    UC12 --> UC08 : <<extend>>
    
    usecase "UC13: Verificar Status de Transferência" as UC13
    UC14: "Atualizar Senha" as UC14

}

' Relacionamentos ator-caso de uso
user --> UC01
user --> UC02
user --> UC03
user --> UC05
user --> UC06
user --> UC07
user --> UC08
user --> UC09
user --> UC10
investments --> UC12

bank --> UC04
bank --> UC05
assistant --> UC03

@enduml