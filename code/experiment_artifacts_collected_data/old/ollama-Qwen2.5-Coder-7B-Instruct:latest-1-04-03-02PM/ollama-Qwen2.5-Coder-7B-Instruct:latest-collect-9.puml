@startuml "C4_UC_Financeiro"

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title "Sistema de Gestão Financeira Pessoal - Casos de Uso Financeiros"

' Atores
actor "Cliente Individual" as user
actor "Banco" as bank #999999

rectangle "Sistema de Gestão Financeira Pessoal" {
    usecase "UC01: Visualizar Saldo" as UC01
    usecase "UC02: Transferir Fundos" as UC02
    usecase "UC03: Solicitar Empréstimo" as UC03
    usecase "UC04: Requisitar Cartão de Crédito" as UC04
    usecase "UC05: Gerenciar Cartões de Crédito" as UC05
    usecase "UC06: Visualizar Histórico de Transações" as UC06

    note right of UC01
      **Req. ID:** FR03, FR04
      **Descrição:** Permite ao usuário visualizar o saldo atual de suas contas.
    end note
    
    usecase "UC07: Solicitar Cartão Pré-Pago" as UC07
    usecase "UC08: Gerenciar Conta Corrente" as UC08

    ' Relacionamentos entre casos de uso
    UC01 ..> UC02 : <<include>>
    UC02 ..> UC03 : <<extend>>
    UC02 ..> UC04 : <<extend>>
    UC04 ..> UC05 : <<include>>
    UC06 ..> UC07 : <<include>>
    UC08 ..> UC09 : <<include>>
}

' Relacionamentos ator-caso de uso
user --> UC01
user --> UC02
bank --> UC03
bank --> UC04

@enduml