@startuml "C4_UC_GestaoFinanceira"

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title "Sistema de Gestão Financeira Pessoal - Casos de Uso"

' Atores
actor "Cliente Individual" as user
actor "Sistema Bancário" as bank #999999
actor "Analista Financeiro" as analyst #999999

' Sistema e casos de uso
rectangle "Sistema de Gestão Financeira Pessoal" {
    usecase "UC01: Visualizar Extrato Bancario" as UC01
    
    note right of UC01
      **Req. ID:** FR03, FR04
      **Descrição:** Permite ao usuário visualizar todas as transações 
      financeiras de suas contas conectadas, ordenadas 
      cronologicamente.
    end note
    
    usecase "UC02: Filtrar Transacoes" as UC02
    usecase "UC03: Categorizar Transacao Manualmente" as UC03
    usecase "UC04: Buscar Transacoes" as UC04
    usecase "UC05: Visualizar Detalhes da Transacao" as UC05
    usecase "UC06: Exportar Transacoes" as UC06
    usecase "UC07: Receber Categorizacao Automática" as UC07
    usecase "UC08: Receber Alertas de Transacao" as UC08
    usecase "UC09: Visualizar Resumo Financeiro" as UC09
    usecase "UC10: Gerar Relatorios Financeiros" as UC10
    usecase "UC11: Compartilhar Extrato com Analista" as UC11
    usecase "UC12: Receber Categorizacao de Transacao de Analista" as UC12
    
    ' Relacionamentos entre casos de uso
    UC01 ..> UC02 : <<include>>
    UC01 ..> UC07 : <<include>>
    UC01 ..> UC05 : <<extend>>
    UC01 ..> UC06 : <<extend>>
    UC03 ..> UC05 : <<include>>
    UC08 ..> UC05 : <<include>>
    UC09 ..> UC05 : <<include>>
    UC10 ..> UC05 : <<include>>
    UC11 ..> UC05 : <<include>>
    UC12 ..> UC05 : <<include>>
}

' Relacionamentos ator-caso de uso
user --> UC01
user --> UC03
user --> UC04
bank --> UC07
analyst --> UC11
analyst --> UC12

@enduml