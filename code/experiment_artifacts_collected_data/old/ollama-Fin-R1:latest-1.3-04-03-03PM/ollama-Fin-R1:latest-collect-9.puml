@startuml "Sistema de Gestão Financeira Pessoal - Casos de Uso"

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title "Use Case Diagram for Personal Financial Management System"

' Define Actors
actor "Cliente Individual" as user #FF0000
actor "Sistema Bancário" as bank #9999ff
actor "Conselheiro Financeiro" as advisor #32CD32
actor "APIs de Terceiros" as third_party #FFFF00

' Define the System Boundary
rectangle "Sistema de Gestão Financeira Pessoal" {
    usecase "UC01: Logar na Conta" as UC01
    usecase "UC02: Criar Nova Conta" as UC02
    usecase "UC03: Exibir Resumo Financeiro Mensal" as UC03
    usecase "UC04: Planejamento Orçamentário" as UC04
    usecase "UC05: Solicitar Empréstimo/Financiamento" as UC05
    usecase "UC06: Compartilhar Dados com Conselheiro" as UC06
    usecase "UC07: Fazer Transferência Bancária" as UC07
    usecase "UC08: Cobrar Recarga do Cartão de Crédito" as UC08
    usecase "UC09: Gerenciar Contas Associadas" as UC09
    usecase "UC10: Monitorar Gastos em Tempo Real" as UC10

    ' Relationships between cases
    UC01 ..> UC03 : <<extend>> ("Deve acessar o resumo financeiro após entrar")
    UC02 -- UC01 : <<include>> ("Criar conta pode ser um novo cliente")
    UC03 -- UC04 : <<include>> ("Resumo mensal inclui orçamento")
    UC05 ..> UC06 : <<extend>> ("Plano de pagamento depende da ação do usuário")
    UC07 -- UC08 : <<generalize>> ("Transferências podem envolver recarga do cartão")
    UC09 --> UC10 : <<generalize>> ("Gerenciamento de contas pode implicar monitoramento")
}

' Relationships between actors and system
user --> UC01
bank --> UC07, UC08
advisor --> UC06
third_party --> UC05

@enduml