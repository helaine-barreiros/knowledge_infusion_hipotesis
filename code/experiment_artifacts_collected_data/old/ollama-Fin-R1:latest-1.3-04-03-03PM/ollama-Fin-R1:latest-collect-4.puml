@startuml "Sistema de Gestão Financeira Pessoal - Transações Financeiras"

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title "Use Case Diagram for Financial Transaction Management"

' Atores
actor "Cliente Individual" as user #00aaff
actor "Sistema Bancário" as bank #33cc99

' Casos de uso (use cases)
usecase "UC01: Visualizar Lista de Transações" as UC01

note right of UC01
  **Req. ID:** FR03, FR04  
  **Descrição:** Permite ao usuário visualizar todas as transações financeiras das contas conectadas, ordenadas cronologicamente.
end note

usecase "UC02: Filtrar Transações" as UC02
usecase "UC03: Categorizar Transação Manualmente" as UC03  
usecase "UC04: Buscar Transações" as UC04  
usecase "UC05: Visualizar Detalhes da Transação" as UC05  
usecase "UC06: Exportar Transações" as UC06  
usecase "UC07: Receber Categorização Automática" as UC07  

' Relacionamentos entre casos de uso
UC01 ..> UC02 : <<include>>  
UC01 ..> UC07 : <<include>>  
UC01 ..> UC05 : <<extend>>  
UC01 ..> UC06 : <<extend>>  
UC03 ..> UC05 : <<include>>  

' Relacionamentos ator-caso de uso
user --> UC01  
user --> UC03  
user --> UC04  
bank --> UC07

@enduml